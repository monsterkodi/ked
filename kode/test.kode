###
█████████  ████████   ███████  █████████
   ███     ███       ███          ███   
   ███     ███████   ███████      ███   
   ███     ███            ███     ███   
   ███     ████████  ███████      ███   
###

use ./kxk  ◆ nfs slash kstr
use ./kode ◆ tester

mods = ['kxk' 'kode' 'kolor' 'ked' 'konrad']

lastArg = process.argv[-1]
columns = 60

if lastArg == 'help'
    
    log """
    
        test runner
        
        usage

            kk -t                    run all tests
            kk -t brief|silent       set verbosity
            kk -t #{mods.join('|')}  test a single module
            kk -t .../file.js        run a single test file
    
    """
    process.exit 0

tests = {}; for m in mods ➜ tests[m] = true

fail = false

hdr = h -> log B5(y5(' ' + kstr.crop(h, columns) + ' '))

if 
    lastArg == 'brief'
    
        tester.logSections = false

    lastArg == 'silent'
    
        tester.logSections = false
        tester.logModules = false
    
    lastArg in mods
    
        for m in mods ➜ tests[m] = m == lastArg
    
    lastArg != ◆file
    
        for m in mods ➜ tests[m] = false
            
        hdr process.argv[-1]
        
        file = slash.path ◆dir '..' lastArg
        test =○ import(file)
        result =○ tester.test test.default
        fail = fail or not (result ? true)
    
for mod in mods
    
    if tests[mod]
        hdr mod
        files =○ nfs.list(slash.path(◆dir mod 'test'))
        for file in files
            continue if file.type == 'dir' # ignore subdirectories for now
            test =○ import(file.path) # shouldn't the file type be checked here?
            result =○ tester.test test.default
            fail = fail or not (result ? true)
        
tester.summarize()

if fail
    process.exitCode = 1
