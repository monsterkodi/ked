use ../../kxk ▪ kstr
use ..        ◆ kulur

ext = 'kode'

export
    lang: (l) -> ext = l
    ranges: (s) -> kulur.ranges s, ext
    dissect: (c) -> kulur.dissect kstr.lines(c), ext
    
    inc: (rgs, start, match) -> 
        for r in rgs ➜ if r.start == start and r.match == match ➜ ⮐ r.clss
        log "#{r6 noon(rgs)}\n#{r5 'expected'} #{g5 match} #{r5 'at index'} #{b7 start} "