
use ./util ▪ inc ranges dissect lang

lang 'md'

▸ md
    
    rgs = ranges "**bold**"
    inc rgs, 0 '*'          ▸ 'punct bold'
    inc rgs, 1 '*'          ▸ 'punct bold'
    inc rgs, 2 'bold'       ▸ 'text bold'
    inc rgs, 6 '*'          ▸ 'punct bold'
    inc rgs, 7 '*'          ▸ 'punct bold'
    
    rgs = ranges ",**b**,"
    inc rgs, 1 '*'          ▸ 'punct bold'
    inc rgs, 3 'b'          ▸ 'text bold'
    inc rgs, 4 '*'          ▸ 'punct bold'
            
    rgs = ranges "*it lic*"
    inc rgs, 0 '*'          ▸ 'punct italic'
    inc rgs, 1 'it'         ▸ 'text italic'
    inc rgs, 4 'lic'        ▸ 'text italic'
    inc rgs, 7 '*'          ▸ 'punct italic'
    
    rgs = ranges "*italic*"
    inc rgs, 0 '*'          ▸ 'punct italic'
    inc rgs, 1 'italic'     ▸ 'text italic'
    inc rgs, 7 '*'          ▸ 'punct italic'
 
    rgs = ranges "*`italic code`*"
    inc rgs, 0 '*'          ▸ 'punct italic'
    inc rgs, 1 '`'          ▸ 'punct italic code'
    inc rgs, 2 'italic'     ▸ 'text italic code'
    inc rgs, 9 'code'       ▸ 'text italic code'
    inc rgs, 14 '*'         ▸ 'punct italic'
    
    rgs = ranges "`a*b` c"
    inc rgs, 0 '`'          ▸ 'punct code'
    inc rgs, 1 'a'          ▸ 'text code'
    inc rgs, 2 '*'          ▸ 'punct code'
    inc rgs, 3 'b'          ▸ 'text code'
    inc rgs, 4 '`'          ▸ 'punct code'
    inc rgs, 6 'c'          ▸ 'text'

    rgs = ranges "`**x**` c"
    inc rgs, 1 '*'          ▸ 'punct code'
    inc rgs, 2 '*'          ▸ 'punct code'
    inc rgs, 3 'x'          ▸ 'text code'
    inc rgs, 5 '*'          ▸ 'punct code'
    inc rgs, 6 '`'          ▸ 'punct code'
    inc rgs, 8 'c'          ▸ 'text'

    rgs = ranges "- `a/*.k` c"
    inc rgs, 5 '*'          ▸ 'punct code'
    inc rgs, 8 '`'          ▸ 'punct code'
    inc rgs, 10 'c'         ▸ 'text'

    rgs = ranges "`konrad/test/knrd.kode` x"
    inc rgs, 0 '`'          ▸ 'punct code'
    inc rgs, 1 'konrad'     ▸ 'text dir'
    inc rgs, 7 '/'          ▸ 'punct dir'
    inc rgs, 8 'test'       ▸ 'text dir'
    inc rgs, 13 'knrd'      ▸ 'file_kode'
    inc rgs, 17 '.'         ▸ 'file_punct_kode'
    inc rgs, 18 'kode'      ▸ 'file_ext_kode'
    inc rgs, 22 '`'         ▸ 'punct code'
    inc rgs, 24 'x'         ▸ 'text'

    rgs = ranges "`knrd.kode`"
    inc rgs, 0 '`'          ▸ 'punct code'
    inc rgs, 1 'knrd'       ▸ 'file_kode'
    inc rgs, 5 '.'          ▸ 'file_punct_kode'
    inc rgs, 6 'kode'       ▸ 'file_ext_kode'
    inc rgs, 10 '`'         ▸ 'punct code'

    rgs = ranges "`Date.now()` `slash.home` `a.png`"
    inc rgs, 1 'Date'       ▸ 'text code'
    inc rgs, 5 '.'          ▸ 'punct code'
    inc rgs, 6 'now'        ▸ 'text code'
    inc rgs, 14 'slash'     ▸ 'text code'
    inc rgs, 20 'home'      ▸ 'text code'
    inc rgs, 27 'a'         ▸ 'file_png'
    inc rgs, 29 'png'       ▸ 'file_ext_png'

    rgs = ranges "**a/knrd.kode** x"
    inc rgs, 0 '*'          ▸ 'punct bold'
    inc rgs, 1 '*'          ▸ 'punct bold'
    inc rgs, 2 'a'          ▸ 'text dir'
    inc rgs, 3 '/'          ▸ 'punct dir'
    inc rgs, 4 'knrd'       ▸ 'file_kode'
    inc rgs, 8 '.'          ▸ 'file_punct_kode'
    inc rgs, 9 'kode'       ▸ 'file_ext_kode'
    inc rgs, 13 '*'         ▸ 'punct bold'
    inc rgs, 16 'x'         ▸ 'text'

    rgs = ranges '<img src="./img/kode.svg" />'
    inc rgs, 0 '<'          ▸ 'punct keyword'
    inc rgs, 1 'img'        ▸ 'keyword'
    inc rgs, 5 'src'        ▸ 'property'
    inc rgs, 16 'kode'      ▸ 'file_svg'
    inc rgs, 26 '/'         ▸ 'punct keyword'
    inc rgs, 27 '>'         ▸ 'punct keyword'

    rgs = ranges '<a href="x">a b</a>'
    inc rgs, 1 'a'          ▸ 'keyword'
    inc rgs, 3 'href'       ▸ 'property'
    inc rgs, 12 'a'         ▸ 'text'
    inc rgs, 14 'b'         ▸ 'text'
    inc rgs, 15 '<'         ▸ 'punct keyword'
    inc rgs, 16 '/'         ▸ 'punct keyword'
    inc rgs, 17 'a'         ▸ 'keyword'
    inc rgs, 18 '>'         ▸ 'punct keyword'

    rgs = ranges '`(a b) ->` and `x =>`'
    inc rgs, 7 '-'          ▸ 'punct function'
    inc rgs, 8 '>'          ▸ 'punct function'
    inc rgs, 9 '`'          ▸ 'punct code'
    inc rgs, 18 '='         ▸ 'punct function bound'
    inc rgs, 19 '>'         ▸ 'punct function bound'

    rgs = ranges '<!-- x -->'
    inc rgs, 8 '-'          ▸ 'punct'
    inc rgs, 9 '>'          ▸ 'punct keyword'

    rgs = ranges '<p align="center">'
    inc rgs, 9 '"'          ▸ 'punct string double'
    inc rgs, 10 'center'    ▸ 'string double'
    inc rgs, 16 '"'         ▸ 'punct string double'
    inc rgs, 17 '>'         ▸ 'punct keyword'

    rgs = ranges '<a href="https://github.com/a/ked">'
    inc rgs, 8 '"'          ▸ 'punct string double'
    inc rgs, 9 'https'      ▸ 'url protocol'
    inc rgs, 14 ':'         ▸ 'punct url'
    inc rgs, 15 '/'         ▸ 'punct url'
    inc rgs, 17 'github'    ▸ 'url domain'
    inc rgs, 24 'com'       ▸ 'url tld'
    inc rgs, 28 'a'         ▸ 'text dir'
    inc rgs, 30 'ked'       ▸ 'dir_leaf'
    inc rgs, 33 '"'         ▸ 'punct string double'
    inc rgs, 34 '>'         ▸ 'punct keyword'

    rgs = ranges 'see img/ked04.png and 1.5'
    inc rgs, 8 'ked04'      ▸ 'file_png'
    inc rgs, 13 '.'         ▸ 'file_punct_png'
    inc rgs, 14 'png'       ▸ 'file_ext_png'
    inc rgs, 22 '1'         ▸ 'number float'

    rgs = ranges "carry a 'wrap' flag"
    inc rgs, 8 "'"          ▸ 'punct string single'
    inc rgs, 9 'wrap'       ▸ 'string single'
    inc rgs, 13 "'"         ▸ 'punct string single'
    inc rgs, 15 'flag'      ▸ 'text'

    rgs = ranges 'say "hi there" now'
    inc rgs, 4 '"'          ▸ 'punct string double'
    inc rgs, 5 'hi'         ▸ 'string double'
    inc rgs, 8 'there'      ▸ 'string double'
    inc rgs, 13 '"'         ▸ 'punct string double'
    inc rgs, 15 'now'       ▸ 'text'

    rgs = ranges "the lines' end, don't 'stop"
    inc rgs, 9 "'"          ▸ 'punct'
    inc rgs, 11 'end'       ▸ 'text'
    inc rgs, 22 "'"         ▸ 'punct'
    inc rgs, 23 'stop'      ▸ 'text'

    rgs = ranges "(`'x'`)"
    inc rgs, 2 "'"          ▸ 'punct code'
    inc rgs, 3 'x'          ▸ 'text code'

    rgs = ranges '(I assume yes.)'
    inc rgs, 10 'yes'       ▸ 'text'
    inc rgs, 13 '.'         ▸ 'punct'

    rgs = ranges 'i.e. see readme.md'
    inc rgs, 0 'i'          ▸ 'text'
    inc rgs, 2 'e'          ▸ 'text'
    inc rgs, 9 'readme'     ▸ 'file_md'

    rgs = ranges 'like `~/a/files`, ok'
    inc rgs, 10 'files'     ▸ 'dir_leaf'
    inc rgs, 15 '`'         ▸ 'punct code'
    inc rgs, 18 'ok'        ▸ 'text'

    rgs = ranges 'see https://raw.example.com/x'
    inc rgs, 12 'raw'       ▸ 'url subdomain'
    inc rgs, 15 '.'         ▸ 'punct url'
    inc rgs, 16 'example'   ▸ 'url domain'
    inc rgs, 23 '.'         ▸ 'punct url tld'
    inc rgs, 24 'com'       ▸ 'url tld'
    inc rgs, 27 '/'         ▸ 'punct dir'
    inc rgs, 28 'x'         ▸ 'dir_leaf'

    rgs = ranges 'a < b and c > d'
    inc rgs, 0 'a'          ▸ 'text'
    inc rgs, 4 'b'          ▸ 'text'
    inc rgs, 10 'c'         ▸ 'text'

    rgs = ranges "it's good"
    inc rgs, 0 'it'         ▸ 'text'
    inc rgs, 2 "'"          ▸ 'punct'
    inc rgs, 3 's'          ▸ 'text'
    
    rgs = ranges "if is empty in then"
    inc rgs, 0  'if'        ▸ 'text'
    inc rgs, 3  'is'        ▸ 'text'
    inc rgs, 6  'empty'     ▸ 'text'
    inc rgs, 12 'in'        ▸ 'text'
    inc rgs, 15 'then'      ▸ 'text'

    rgs = ranges 'text files. bla'
    inc rgs, 0, 'text'  ▸ 'text'
    inc rgs, 10, '.'    ▸ 'punct'
    
    rgs = ranges '..bla'
    inc rgs, 0, '.'     ▸ 'punct'
    inc rgs, 1, '.'     ▸ 'punct'
    
    rgs = ranges '```coffeescript'
    inc rgs, 0 '`'      ▸ 'punct code triple'
    inc rgs, 3 'coffeescript' ▸ 'code lang'

    rgs = ranges '```kode'
    inc rgs, 2 '`'      ▸ 'punct code triple'
    inc rgs, 3 'kode'   ▸ 'code lang'

    rgs = ranges '```sh'
    inc rgs, 3 'sh'     ▸ 'code lang'
        
    rgs = ranges "- li"
    inc rgs, 0 '-'      ▸ 'punct li1 marker'
    inc rgs, 2 'li'     ▸ 'text'

    rgs = ranges "    - **bold**"
    inc rgs, 4 '-'      ▸ 'punct li2 marker'
    inc rgs, 8 'bold'   ▸ 'text bold'

    rgs = ranges "        - **bold**"
    inc rgs, 8 '-'      ▸ 'punct li3 marker'
    inc rgs, 12 'bold'  ▸ 'text bold'

    rgs = ranges "        * **bold**"
    inc rgs, 8 '*'      ▸ 'punct li3 marker'
    inc rgs, 12 'bold'  ▸ 'text bold'

    dss = dissect """
        - li1
        text
    """
    inc dss[0], 0  '-'    ▸ 'punct li1 marker'
    inc dss[1], 0  'text' ▸ 'text'

    dss = dissect """
        # h1
        ## h2
        ### h3
        #### h4
        ##### h5
    """
    inc dss[0], 0  "#"    ▸ 'punct h1'
    inc dss[0], 2  "h1"   ▸ 'text h1'
    inc dss[1], 0  "#"    ▸ 'punct h2'
    inc dss[1], 3  "h2"   ▸ 'text h2'
    inc dss[2], 0  "#"    ▸ 'punct h3'
    inc dss[2], 4  "h3"   ▸ 'text h3'
    inc dss[3], 0  "#"    ▸ 'punct h4'
    inc dss[3], 5  "h4"   ▸ 'text h4'
    inc dss[4], 0  "#"    ▸ 'punct h5'
    inc dss[4], 6  "h5"   ▸ 'text h5'

    dss = dissect """
        \`\`\`js
        \`\`\`
    """
    inc dss[1], 0 '`' ▸ 'punct code triple'
        dss = dissect """
            \`\`\`js
            \`\`\`
        """
        inc dss[1], 0 '`' ▸ 'punct code triple'
        