###
    ███   ███  ███   ███  ████████   ███████    
    ███  ███   ████  ███  ███   ███  ███   ███  
    ███████    ███ █ ███  ███████    ███   ███  
    ███  ███   ███  ████  ███   ███  ███   ███  
    ███   ███  ███   ███  ███   ███  ███████    

    transpiles kode and noon files
    
    assumes to be run from a cwd() that has a js|kode structure (see bundleDir)
###

use ../kode ◆ kode
use ../kxk  ◆ nfs slash noon
use crypto

# ████████   ███   ███  ███      ████████   ███████  
# ███   ███  ███   ███  ███      ███       ███       
# ███████    ███   ███  ███      ███████   ███████   
# ███   ███  ███   ███  ███      ███            ███  
# ███   ███   ███████   ███████  ████████  ███████   

rules =
    
    kode: 
        tgtExt:  'js'
        srcDir:  'kode'
        tgtDir:  'js'
        compile: srcText srcFile tgtFile opt -> 
            k0de = new kode header:false map:opt.map
            try 
                k0de.compile srcText srcFile tgtFile
            catch err
                log err
    noon:
        tgtExt:  'json'
        srcDir:  'kode'
        tgtDir:  'js'
        compile: srcText srcFile tgtFile opt -> JSON.stringify noon.parse(srcText) null '  '
        
    ignore: [
        'kolor/lang.noon'
        'kode/.kkache'
        ]
        
# ███   ███  █████████  ███  ███        
# ███   ███     ███     ███  ███        
# ███   ███     ███     ███  ███        
# ███   ███     ███     ███  ███        
#  ███████      ███     ███  ███████    
            
srcForFile = file ->
    
    srcFile = file
    if slash.isRelative srcFile
        srcFile = slash.path process.cwd() srcFile
    srcFile
    
tgtForSrc = srcFile rule ->
    
    slash.swapExt srcFile.replace(bundlePath(rule.srcDir) bundlePath(rule.tgtDir)) rule.tgtExt
    
bundlePath = p='' -> slash.path bundleDir() p
    
bundleDir = -> 
    # this is used by side-projects already.
    # make sure we execute relative to those.
    process.cwd()
  
#  ███████    ███████   █████████  ███   ███  ████████  ████████   
# ███        ███   ███     ███     ███   ███  ███       ███   ███  
# ███  ████  █████████     ███     █████████  ███████   ███████    
# ███   ███  ███   ███     ███     ███   ███  ███       ███   ███  
#  ███████   ███   ███     ███     ███   ███  ████████  ███   ███  

gatherFiles = ○->
    
    list  =○ nfs.list(bundlePath('kode'))
    list  = list.filter (item) -> item.type == 'file'
    
    files = list.map (item) -> item.path
    files = files.filter (file) -> 
        for ignore in rules.ignore
            ⮐ false if file.endsWith ignore
        true
    
#  ███████  █████████   ███████   ██     ██  ████████ 
# ███          ███     ███   ███  ███   ███  ███   ███
# ███████      ███     █████████  █████████  ████████ 
#      ███     ███     ███   ███  ███ █ ███  ███      
# ███████      ███     ███   ███  ███   ███  ███      
###
    
    the absolute path of the source a generated file was made from, or '' if
    kode did not make it. it is the only thing telling a generated file from
    a hand written one.
    
    there are two ways a compiled file says where it came from and they are
    measured from different places, so both are normalised here rather than
    at the call site:
    
      //# sourceURL=file://<path>   from the working directory. written
                                    whether or not there is a sourcemap
      the map's sources[0]          from the file carrying it, the way a
                                    stack frame is
###

stampSource = (text, file) =>

    lines = text.split '\n'
    from  = ''

    for line in lines

        rel = line.replace '//# sourceURL=file://' ''

        if rel != line
            from = slash.absolute slash.path(process.cwd(), rel)

    if from
        ⮐ from

    m = /sourceMappingURL=data:application\/json;base64,([A-Za-z0-9+\/=]*)/.exec text
    if not (m and valid m[1]) ➜ ⮐ ''

    b64 = Buffer.from(m[1],'base64')
    map = JSON.parse b64.toString('utf8')
    if not (valid map.sources and valid map.sources[0]) ➜ ⮐ ''

    slash.absolute slash.path(slash.dir(file), map.sources[0])

# ████████   ████████   ███████   ███████   ███   ███   ███████  ███  ███      ████████
# ███   ███  ███       ███       ███   ███  ████  ███  ███       ███  ███      ███     
# ███████    ███████   ███       ███   ███  ███ █ ███  ███       ███  ███      ███████ 
# ███   ███  ███       ███       ███   ███  ███  ████  ███       ███  ███      ███     
# ███   ███  ████████   ███████   ███████   ███   ███   ███████  ███  ███████  ████████

reconcile = dirs opt={} ○->

    srcDir = opt.srcDir
    if not srcDir
        srcDir = bundlePath 'kode'

    removed = []

    for dir in dirs

        here = ○ nfs.dirExists dir
        if not here ➜ continue

        list = ○ nfs.list dir

        for item in list

            if item.type != 'file' ➜ continue

            file = item.path
            text = ○ nfs.read file
            from = stampSource text, file
            if not from ➜ continue

            if not from.startsWith srcDir + '/' ➜ continue

            still = ○ nfs.isFile from
            if still ➜ continue

            ○ nfs.remove file
            removed.push file

            log r4('🗑 ') w3(slash.tilde(file)) if not opt.quiet

    removed
    
# ███   ███  ███   ███   ███████    ███████  ███   ███  ████████  
# ███  ███   ███  ███   ███   ███  ███       ███   ███  ███       
# ███████    ███████    █████████  ███       █████████  ███████   
# ███  ███   ███  ███   ███   ███  ███       ███   ███  ███       
# ███   ███  ███   ███  ███   ███   ███████  ███   ███  ████████  

cacheFile = 'kode/.kkache'

cachePath = -> bundlePath cacheFile

rel = p -> slash.relative p, bundleDir()

hash = text -> crypto.createHash('sha1').update(text).digest('hex')

fpDirs = ['kode' 'kxk' 'kolor'] # the modules whose source can reach the compiler.

# the compiler is the one next to this file. it is not the one in the tree
# being built: a side project has its own js directory and no compiler in
# it, and a fingerprint taken from there would be the hash of nothing -
# the same for every version of the compiler, which is the one thing a
# fingerprint must not be.

compilerDir = -> slash.path(◆dir, '..')

fingerprint = ○-> # generates the fingerprint for the kode compiler

    files = []

    for d in fpDirs

        dir = slash.path(compilerDir(), d)
        here = ○ nfs.isDir dir
        if not here ➜ continue

        for item in ○ nfs.list dir
            files.push item.path if item.type == 'file' and slash.ext(item.path) == 'js'

    files.sort()

    parts = []
    for f in files
        body = ○ nfs.read f
        parts.push "#{slash.relative f, compilerDir()}\0#{body}"

    joined = parts.join ''
    hash joined

loadCache = path ○->

    text = ○ nfs.read path

    if valid text

        try
            kache = noon.parse text
            ⮐ kache if kache is Object
        catch err
            ⮐ null
    ⮐ null

shaped = kache -> # checks for correct shape of the kache data

    ⮐ false if empty kache
    ⮐ false if not (kache is Object)
    ⮐ false if kache is Array
    ⮐ false if empty kache.kode
    ⮐ false if empty kache.srcmap
    ⮐ false if not (kache.source?)
    ⮐ false if not (kache.target?)
    true

usable = (kache, fp, srcmap) ->

    shaped(kache) and (kache.kode == fp) and (kache.srcmap == srcmap)

# the cache says which compiler built the tree. if that is not the one
# that would build it now, the tree is older than the compiler, and a
# test run against it is a test run against something else

stale = ○->

    path = cachePath()
    here = ○ nfs.isFile path
    ⮐ false if not here

    kache = ○ loadCache path
    ⮐ false if not kache
    ⮐ false if empty kache.kode

    kache.kode != (○ fingerprint())

isCurrent = (kache, srcFile, tgtFile, srcText) ○->

    ⮐ false if empty kache

    s = kache.source?[rel srcFile]
    t = kache.target?[rel tgtFile]

    ⮐ false if not (s? and t?)
    ⮐ false if s != hash(srcText)

    tgtText = ○ nfs.read tgtFile
    ⮐ hash(tgtText) == t

saveCache = (path, kache, fp, srcmap, srcs, tgts, whole=no) ○->

    ⮐ false if empty srcs

    # a partial build may not write over a cache belonging to another
    # compiler: it cannot vouch for the files it never looked at, and it
    # would leave them marked current under a fingerprint they were never
    # compiled with. since it is also the one that declines to write, the
    # cache would stay wrong until somebody deleted it by hand.
    #
    # a whole build is the one that can - it went over every file, and a
    # cache it finds void makes every one of them a miss, so it arrives here
    # having rewritten the lot anyway.
    #
    # what it may not do is replace. a build records only what it compiled,
    # and what it did not compile was not stale - it was already right, which
    # is what the cache it read said. replacing drops those entries, and the
    # next build finds every one of them a miss and rebuilds the tree to put
    # them back. so both kinds of build merge, and 'whole' waives nothing but
    # the guard above

    ⮐ false if not whole and shaped(kache) and not (usable(kache, fp, srcmap))

    if kache?
        source = Object.assign({}, kache.source, srcs)
        target = Object.assign({}, kache.target, tgts)
    else
        source = srcs
        target = tgts

    sorted = o ->
        out = {}
        for k in Object.keys(o).sort()
            out[k] = o[k]
        out
    
    source = sorted(source)
    target = sorted(target)

    out =
        kode:   fp
        srcmap: srcmap
        source: source
        target: target

    ○ nfs.write path, noon.stringify(out)
    true

# ███   ███  ███   ███  ████████   ███████    
# ███  ███   ████  ███  ███   ███  ███   ███  
# ███████    ███ █ ███  ███████    ███   ███  
# ███  ███   ███  ████  ███   ███  ███   ███  
# ███   ███  ███   ███  ███   ███  ███████    

knrd = files=[] opt={} ○->
    # log "files" files   
    if files is str
        if slash.ext(files) in ['kode' 'noon']
            files = [files]
        else
            files = []
            
    if files is arr and valid files
        if slash.ext(files[0]) not in ['kode' 'noon']
            log y5('✘ ') r5(slash.tilde(files[0])) r4('-- unknown file type!')
            ⮐ []
        
    opt.verbose        ?= opt.debug
    opt.map            ?= true
    log 'opt'    opt   if opt.verbose
    log 'files'  files if opt.debug
    
    # ● 🔨
            
    whole = empty files
    files =○ gatherFiles() if whole
    
    icon = opt.dryrun ? w4(' ') : '🔨'
        
    log icon w5(slash.name(bundleDir())) b5(files.length) if not opt.quiet
    
    kpath  = cachePath()
    loaded = ○ loadCache kpath
    fp     = ○ fingerprint()
    cache  = if usable loaded, fp, opt.map then loaded else null
    
    log w2('  ') w3('cache is for another compiler, ignoring it') if opt.verbose and loaded? and empty cache
    
    transpiled = 0
    dirs      = []
    srcs      = {}
    tgts      = {}
        
    for file in files
        
        skip = false
        for ignore in rules.ignore
            if file.endsWith ignore
                log w2('✘  ') w3(slash.tilde(file)) if opt.verbose
                skip = true
                break
                
        if skip ➜ continue
        
        if rule = rules[slash.ext file]
            
            srcFile  = srcForFile file
            tgtFile  = tgtForSrc  srcFile, rule
            
            dir = slash.dir tgtFile
            dirs.push dir if dir not in dirs
            
            srcText  =○ nfs.read srcFile
            
            # nothing to do is the common case, so it is worth not doing it
            # twice over: ask the cache first, and only compile on a miss
            
            if ○ isCurrent cache, srcFile, tgtFile, srcText
                log g2('▸') m3(slash.tilde(tgtFile)) w4('cached') if opt.verbose
                continue
            
            tgtText  =○ nfs.read tgtFile
            log g2('▸') m3(srcFile) m5(tgtFile) if opt.verbose
            compText = rule.compile srcText, srcFile, tgtFile, opt
            log g2('▸') m3(srcFile) m5(tgtFile) if opt.verbose
            
            log 'tgtText'  tgtFile, tgtText if opt.debug and opt.verbose
            log 'compText' compText         if opt.debug and opt.verbose
               
            if empty compText
                log y5('✘ ') r5(slash.tilde(srcFile)) r4('failed to transpile!')
            else
                log g2('🔧') m3(slash.tilde(srcFile)) if opt.verbose
                if tgtText != compText
                    transpiled++
                    ○ nfs.write tgtFile, compText if not opt.dryrun
                    log b5('✔ ') g5(slash.tilde(tgtFile))
                
                srcs[rel srcFile] = hash srcText
                tgts[rel tgtFile] = hash compText
                    
    if not opt.dryrun
        ○ saveCache kpath, loaded, fp, opt.map, srcs, tgts, whole
    
    opt.reconcile ?= true
    if opt.reconcile and not opt.dryrun
        ○ reconcile dirs, opt
    
    transpiled
        
knrd.bundlePath  = bundlePath
knrd.stampSource = stampSource
knrd.reconcile   = reconcile
knrd.cachePath   = cachePath
knrd.fingerprint = fingerprint
knrd.stale       = stale
knrd.hash        = hash
knrd.rel         = rel
knrd.usable      = usable
knrd.shaped      = shaped
knrd.loadCache   = loadCache
knrd.saveCache   = saveCache
knrd.isCurrent   = isCurrent
    
export knrd
