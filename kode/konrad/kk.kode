###
    ███   ███  ███   ███    
    ███  ███   ███  ███     
    ███████    ███████      
    ███  ███   ███  ███     
    ███   ███  ███   ███    
###

use ../kxk  ▪ sleep karg watch nfs util slash os
use ../kode ◆ tester kode
use         ◆ knrd
use           child_process

args = karg """
    kk
        files                                     **
        
        info       show build status              = false
        knrd       transpile kode and noon        = false
        build      bootstrap the compiler         = false
        watch      watch for file changes         = false
        test       run tests                      = false
        run        execute kode file              = false
        
        map        write inline source maps       = true
        
        quiet      log nothing                    = false
        debug      log debug                      = false -D
        verbose    log verbose                    = false -V
        version    log version                    = false
    """

class kk
    
    # ████████   ███   ███  ███   ███  
    # ███   ███  ███   ███  ████  ███  
    # ███████    ███   ███  ███ █ ███  
    # ███   ███  ███   ███  ███  ████  
    # ███   ███   ███████   ███   ███  
    
    @run: ○->
    
        files = args.files    
        if args.version ➜ ○ log w4(○ knrd.fingerprint()) g7(slash.name(slash.path(◆dir '../../'))) b7(process.cwd())
        if args.info    ➜ ○ knrd         [] util.defaults(args dryrun:true)
        if args.knrd    ➜ ○ knrd         files args 
        if args.build   ➜ ○ child_process.exec "pnpm build" {shell:true} (err stdout stderr) -> log stdout
        if args.test
            ok = ○ kk.test files
            if not ok
                process.exitCode = 1
        if args.watch   ➜ ○ kk.watch()                            
        if args.run     ➜ ○ kode.run files:files run:true
        
        if valid args.__ignored
            log 'ignored options' args.__ignored
                                                
    # ███   ███   ███████   █████████   ███████  ███   ███  
    # ███ █ ███  ███   ███     ███     ███       ███   ███  
    # █████████  █████████     ███     ███       █████████  
    # ███   ███  ███   ███     ███     ███       ███   ███  
    # ██     ██  ███   ███     ███      ███████  ███   ███  
    
    @watch: ○->
        
        log '👁 ' w5(kk.bundleDir())
        
        watch.watch kk.bundleDir() recursive:true cb: (watcher) ->
            watcher.on 'change' (info) ○-> 

                ⮐  if slash.contains info.path '.stash'
                
                if slash.ext(info.path) in ['kode' 'pug' 'styl' 'noon']
                    log b5('🔧') w3(info.path)
                    ○ knrd info.path
                    ○ kk.test args.files silent:true
    
    # █████████  ████████   ███████  █████████  
    #    ███     ███       ███          ███     
    #    ███     ███████   ███████      ███     
    #    ███     ███            ███     ███     
    #    ███     ████████  ███████      ███     
    
    @test: files opt ○->
        
        if ○ knrd.stale()
            log y5('⚠ ') r5('the tree is older than the compiler - run kk -k')
        
        ok = true
        
        if 
            ○ nfs.exists "js/test.js"
                
                cmd = "node js/test.js"
                cmd += ' ' + files.join(' ') if valid files
                cmd += ' silent' if opt?.silent
                opt = shell:true cwd:kk.bundleDir()
                
                ok = ○ new Promise (resolve reject) ->
                
                    child_process.exec cmd opt (err stdout stderr) -> 
                        
                        log stdout if valid stdout
                        log stderr if valid stderr
                        
                        resolve(not err)
            
            ○ nfs.isDir "js/test"

                if opt?.silent
                    tester.logSections = false
                    tester.logModules  = false
    
                files =○ nfs.list slash.path(process.cwd() 'js' 'test')
                
                for file in files
                    continue if file.type == 'dir' # ignore subdirectories for now
                    test =○ import(file.path) # shouldn't the file type be checked here?
                    result =○ tester.test test.default
                    ok = ok and (result ? true)
            
                tester.summarize()
        ok
                    
    @bundleDir: -> process.cwd()
        
global['kk'] = kk
    
export kk.run
