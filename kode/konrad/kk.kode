###
    ███   ███  ███   ███    
    ███  ███   ███  ███     
    ███████    ███████      
    ███  ███   ███  ███     
    ███   ███  ███   ███    
###

use ../kxk  ▪ sleep karg slash os
use ../kxk  ◆ watch nfs
use         ◆ knrd version
use ../kode ◆ tester kode

use child_process

import fs from 'fs/promises'

args = karg """
    kk
        files                                     **
        
        info       show build status              = false
        knrd       transpile kode and noon        = false
        build      transpile kode and noon        = false
        watch      watch for file changes         = false
        test       run tests                      = false
        run        execute kode file              = false
        
        map        write inline source maps       = true
        
        quiet      log nothing                    = false
        debug      log debug                      = false -D
        verbose    log verbose                    = false -V
        version    log version                    = false
    """

class kk
    
    # ████████   ███   ███  ███   ███  
    # ███   ███  ███   ███  ████  ███  
    # ███████    ███   ███  ███ █ ███  
    # ███   ███  ███   ███  ███  ████  
    # ███   ███   ███████   ███   ███  
    
    @run: ○->
    
        files = args.files    
        if args.version ➜ ○ log version slash.name(slash.path(◆dir '../../')) process.cwd()
        if args.info    ➜ ○ knrd         []    dryrun:true
        if args.knrd    ➜ ○ knrd         files args
        if args.build   ➜ ○ knrd         files args
        if args.test    ➜ ○ kk.test      files
        if args.watch   ➜ ○ kk.watch()                            
        if args.run
            ○ kode.run files:files run:true
            files = []
        
        if valid args.__ignored
            log 'ignored options' args.__ignored
        if valid files
            log 'leftover files' files
                                                
    # ███   ███   ███████   █████████   ███████  ███   ███  
    # ███ █ ███  ███   ███     ███     ███       ███   ███  
    # █████████  █████████     ███     ███       █████████  
    # ███   ███  ███   ███     ███     ███       ███   ███  
    # ██     ██  ███   ███     ███      ███████  ███   ███  
    
    @watch: ○->
        
        log '👁 ' w5(kk.bundleDir())
        
        watch.watch kk.bundleDir() recursive:true cb: (watcher) ->
            watcher.on 'change' (info) ○-> 

                ⮐  if slash.contains info.path '.stash'
                
                if slash.ext(info.path) in ['kode' 'pug' 'styl' 'noon']
                    log b5('🔧') w3(info.path)
                    ○ knrd info.path
                    ○ kk.test args.files
    
    # █████████  ████████   ███████  █████████  
    #    ███     ███       ███          ███     
    #    ███     ███████   ███████      ███     
    #    ███     ███            ███     ███     
    #    ███     ████████  ███████      ███     
    
    @test: options ○->
        
        if 
            ○ nfs.exists "js/test.js"
                
                cmd = "node js/test.js"
                cmd += ' ' + options.join(' ') if valid options
                opt = shell:true cwd:kk.bundleDir() # run tests inside the .app folder
                
                new Promise (resolve reject) ->
                
                    child_process.exec cmd opt (err stdout stderr) -> 
                        
                        if err
                            error 'ERROR' err
                            resolve() # don't reject here to keep test watch running
                        else
                            log stdout if valid stdout
                            resolve()
                            
            ○ nfs.isDir "js/test"

                files =○ nfs.list slash.path(process.cwd() 'js' 'test')
                for file in files
                    continue if file.type == 'dir' # ignore subdirectories for now
                    test =○ import(file.path) # shouldn't the file type be checked here?
                    tester.test test.default
            
                tester.summarize()
                    
    @bundleDir: -> process.cwd()
        
global['kk'] = kk
    
export kk.run
