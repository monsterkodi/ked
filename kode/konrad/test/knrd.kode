###
    ███   ███  ███   ███  ████████   ███████    
    ███  ███   ████  ███  ███   ███  ███   ███  
    ███████    ███ █ ███  ███████    ███   ███  
    ███  ███   ███  ████  ███   ███  ███   ███  
    ███   ███  ███   ███  ███   ███  ███████    
###

use ../knrd
use ../../kxk ◆ nfs slash

stamped = src -> "var a\n\n//# sourceURL=file://#{src}\n"

mapped = src ->

    json = JSON.stringify {sources:[src] mappings:''}
    b64  = Buffer.from(json,'utf8').toString('base64')
    "var a\n\n//# sourceMappingURL=data:application/json;base64,#{b64}\n"

root = '/tmp/opencode/kodeknrd'

jdir = slash.path(root, 'js')
kdir = slash.path(root, 'kode')

jp = name -> slash.path(jdir, name)
kp = name -> slash.path(kdir, name)

isFile = p ○->

    found = ○ nfs.isFile p
    found ? true : false

fromCwd = p -> slash.relative p, process.cwd()

hereText   = stamped (fromCwd(kp('here.kode')))
goneJsText = stamped (fromCwd(kp('gone.kode')))
goneNoText = stamped (fromCwd(kp('gone.noon')))

mapHereText = mapped '../kode/here.kode'

write = src text -> nfs.write jp(src) text

○ nfs.remove root
○ nfs.mkdir  jdir
○ nfs.mkdir  kdir
○ nfs.write  kp('here.kode') 'x = 1\n'

○ write 'kept.js' hereText
○ write 'stale.js' goneJsText
○ write 'hand.js' 'export default {}\n'
○ write 'stale.json' goneNoText

opt  = {srcDir:kdir quiet:true}
dirs = [jdir]

gone1 = ○ knrd.reconcile dirs opt

afterKept = ○ isFile jp('kept.js')
afterHand = ○ isFile jp('hand.js')

nothing = ○ knrd.reconcile dirs opt
nowhere = ○ knrd.reconcile [slash.path(root,'nowhere')] opt

away     = slash.path root 'elsewhere' 'here.kode'
relAway  = fromCwd away
strayText = stamped relAway
○ nfs.write jp('stray.js') strayText
○ knrd.reconcile dirs opt
afterStray = ○ isFile jp('stray.js')

dirText = stamped (fromCwd(kdir))
○ nfs.write jp('dirish.js') dirText
○ knrd.reconcile dirs opt
afterDirish = ○ isFile jp('dirish.js')

▸ stampSource

    ▸ a file kode did not write has no source

        knrd.stampSource 'var a = 1\n', jdir  ▸ ''

    ▸ a hand written file is not a candidate

        knrd.stampSource 'export default {}\n', jdir  ▸ ''

    ▸ the sourceURL is enough on its own

        knrd.stampSource hereText, jdir  ▸ kp('here.kode')

    ▸ and the sourcemap still works on its own

        knrd.stampSource mapHereText, jp('x.js')  ▸ kp('here.kode')

    ▸ a sourcemap that is not base64 is not a stamp

        knrd.stampSource '//# sourceMappingURL=data:application/json;base64,!!!\n', jdir  ▸ ''

    ▸ a map with no sources is not a stamp

        bad = '//# sourceMappingURL=data:application/json;base64,eyJmb28iOiJiYXIifQ==\n'
        knrd.stampSource bad, jdir  ▸ ''

▸ reconcile

    ▸ what has lost its source goes, and only that

        gone1.length  ▸ 2

    ▸ and it is the right two

        gone1.join ' '  ▸ "#{jp('stale.js')} #{jp('stale.json')}"

    ▸ a generated file whose source is still there stays

        afterKept  ▸ true

    ▸ a file nobody generated stays

        afterHand  ▸ true

    ▸ a second pass has nothing to do

        nothing  ▸ []

    ▸ a directory that is not there is not an error

        nowhere  ▸ []

    ▸ the source is resolved, not guessed

        afterStray  ▸ true

    ▸ a stamp naming a directory is not a source

        afterDirish  ▸ true


# ███   ███  ███   ███   ███████    ███████  ███   ███  ████████  
# ███  ███   ███  ███   ███   ███  ███       ███   ███  ███       
# ███████    ███████    █████████  ███       █████████  ███████   
# ███  ███   ███  ███   ███   ███  ███       ███   ███  ███       
# ███   ███  ███   ███  ███   ███   ███████  ███   ███  ████████  

cache = slash.path root, 'cache'

ckfile = slash.path cache, 'x.kode'
cjfile = slash.path cache, 'x.js'
ckache = slash.path cache, '.kkache'

cktext = 'x = 1\n'
cjtext = 'var x = 1;\n'

fpA = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
fpB = 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb'

cksrc = {}
cksrc[knrd.rel ckfile] = knrd.hash cktext

cktgt = {}
cktgt[knrd.rel cjfile] = knrd.hash cjtext

○ nfs.remove cache
○ nfs.mkdir  cache
○ nfs.write  ckfile cktext
○ nfs.write  cjfile cjtext
○ nfs.remove ckache

wrote   = ○ knrd.saveCache ckache, null, fpA, true, cksrc, cktgt
back    = ○ knrd.loadCache ckache
absent  = ○ knrd.loadCache slash.path(cache,'nowhere')

# noon is forgiving. these two are the ways a cache can be rubbish without
# failing to parse, and neither may be allowed to wedge the build.

○ nfs.write ckache, '- not a cache at all\n'
junkList = ○ knrd.loadCache ckache

○ nfs.write ckache, 'kode   not\n\tsource\n'
junkMap  = ○ knrd.loadCache ckache

○ nfs.remove ckache
○ knrd.saveCache ckache, null, fpA, true, cksrc, cktgt
back = ○ knrd.loadCache ckache

# the four ways a file can fail to be current

cur      = ○ knrd.isCurrent back, ckfile, cjfile, cktext
srcMoved = ○ knrd.isCurrent back, ckfile, cjfile, 'x = 2\n'

○ nfs.write cjfile, 'var x = 2;\n'
tgtMoved = ○ knrd.isCurrent back, ckfile, cjfile, cktext

○ nfs.write cjfile cjtext
○ nfs.remove cjfile
tgtGone  = ○ knrd.isCurrent back, ckfile, cjfile, cktext

○ nfs.write cjfile cjtext
noCache  = ○ knrd.isCurrent null,  ckfile, cjfile, cktext

# a build that compiled nothing, and a build that cannot speak for the files
# it did not compile

before     = ○ nfs.read ckache
compiledNo = ○ knrd.saveCache ckache, back, fpA, true, {}, {}
afterNo    = ○ nfs.read ckache

otherKode  = ○ knrd.saveCache ckache, back, fpB, true, cksrc, cktgt
stillA     = ○ knrd.loadCache ckache

# a build with a cache to merge into

more = {}
more[knrd.rel ckfile] = 'cccccccccccccccccccccccccccccccccccccccc'

mergedOk = ○ knrd.saveCache ckache, back, fpA, true, more, cktgt
merged   = ○ knrd.loadCache ckache

# a whole build may rewrite a cache from another compiler, because it can
# vouch for every file in it. a partial one may not, because it cannot - and
# if it writes anyway, the files it never looked at go on being marked current
# under a fingerprint they were never compiled with

wholesale = ○ knrd.saveCache ckache, merged, fpB, true, cksrc, cktgt, yes
wholeBack = ○ knrd.loadCache ckache

partial   = ○ knrd.saveCache ckache, wholeBack, fpA, true, cksrc, cktgt, no
stillB    = ○ knrd.loadCache ckache

# rubbish in the cache has to be replaced rather than respected, or it sits
# there refusing every write and nothing is ever cached again

○ nfs.write ckache, '- not a cache at all\n'
junk    = ○ knrd.loadCache ckache
healedOk = ○ knrd.saveCache ckache, junk, fpA, true, cksrc, cktgt
healed   = ○ knrd.loadCache ckache

fpOne = ○ knrd.fingerprint()
fpTwo = ○ knrd.fingerprint()

▸ cache

    ▸ it round trips through noon

        wrote   ▸ true
        back.kode ▸ fpA
        back.srcmap ▸ true
        back.source[knrd.rel ckfile] ▸ knrd.hash cktext
        back.target[knrd.rel cjfile] ▸ knrd.hash cjtext

    ▸ a file that is not there is not a cache

        absent  ▸ null

    ▸ rubbish that still parses is not a cache either

        knrd.shaped junkList  ▸ false
        knrd.shaped junkMap   ▸ false
        knrd.usable junkMap, fpA, true  ▸ false

    ▸ the header is the compiler and the sourcemap, and it needs both

        knrd.usable back, fpA, true   ▸ true
        knrd.usable back, fpB, true   ▸ false
        knrd.usable back, fpA, false  ▸ false
        knrd.usable null,  fpA, true   ▸ false
        knrd.usable {},   fpA, true   ▸ false

    ▸ current means the source and what is on disk both still match

        cur  ▸ true

    ▸ a source that has moved is a miss

        srcMoved  ▸ false

    ▸ a target that has moved is a miss

        tgtMoved  ▸ false

    ▸ a target that is not there is a miss

        tgtGone  ▸ false

    ▸ and no cache at all is a miss

        noCache  ▸ false

    ▸ a build that compiled nothing writes nothing

        compiledNo  ▸ false
        afterNo     ▸ before

    ▸ a partial build does not write over a cache from another compiler

        otherKode      ▸ false
        stillA.kode    ▸ fpA

    ▸ and one that can, merges rather than replaces

        mergedOk  ▸ true
        merged.source[knrd.rel ckfile]  ▸ more[knrd.rel ckfile]
        merged.target[knrd.rel cjfile] ▸ knrd.hash cjtext

    ▸ and a whole build can replace a cache from another compiler

        wholesale  ▸ true
        wholeBack.kode  ▸ fpB
        wholeBack.source[knrd.rel ckfile]  ▸ knrd.hash cktext

    ▸ but a partial one cannot, or the files it never looked at go on
    ▸ being marked current under a compiler they were never built with

        partial      ▸ false
        stillB.kode  ▸ fpB

    ▸ but rubbish is replaced, or it would wedge the build for good

        healedOk  ▸ true
        healed.kode  ▸ fpA
        healed.source[knrd.rel ckfile]  ▸ knrd.hash cktext

    ▸ the fingerprint is a digest of the compiler, and it does not move

        fpOne == fpTwo  ▸ true
        fpOne.length  ▸ 40

    ▸ the cache lives beside the sources it describes

        knrd.cachePath().endsWith 'kode/.kkache'  ▸ true

    ▸ hashing is hashing

        knrd.hash('x') == knrd.hash('x')  ▸ true
        knrd.hash('x') == knrd.hash('y')  ▸ false
        knrd.hash('').length  ▸ 40
