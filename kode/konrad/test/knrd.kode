###
    ███   ███  ███   ███  ████████   ███████    
    ███  ███   ████  ███  ███   ███  ███   ███  
    ███████    ███ █ ███  ███████    ███   ███  
    ███  ███   ███  ████  ███   ███  ███   ███  
    ███   ███  ███   ███  ███   ███  ███████    
###

use ../knrd
use ../../kxk ◆ nfs slash

stamped = src -> "var a\n\n//# sourceURL=file://#{src}\n"

mapped = src ->

    json = JSON.stringify {sources:[src] mappings:''}
    b64  = Buffer.from(json,'utf8').toString('base64')
    "var a\n\n//# sourceMappingURL=data:application/json;base64,#{b64}\n"

root = '/tmp/opencode/kodeknrd'

jdir = slash.path(root, 'js')
kdir = slash.path(root, 'kode')

jp = name -> slash.path(jdir, name)
kp = name -> slash.path(kdir, name)

isFile = p ○->

    found = ○ nfs.isFile p
    found ? true : false

fromCwd = p -> slash.relative p, process.cwd()

hereText   = stamped (fromCwd(kp('here.kode')))
goneJsText = stamped (fromCwd(kp('gone.kode')))
goneNoText = stamped (fromCwd(kp('gone.noon')))

mapHereText = mapped '../kode/here.kode'

write = src text -> nfs.write jp(src) text

opt  = {srcDir:kdir quiet:true}
dirs = [jdir]

# the js directory, from scratch: a file whose source is still there, one
# whose source is gone, one that nobody generated, and one whose source is
# gone and is not kode

setup = ○->
    
    ○ nfs.remove root
    ○ nfs.mkdir  jdir
    ○ nfs.mkdir  kdir
    ○ nfs.write  kp('here.kode') 'x = 1\n'
    
    ○ write 'kept.js' hereText
    ○ write 'stale.js' goneJsText
    ○ write 'hand.js' 'export default {}\n'
    ○ write 'stale.json' goneNoText

▸ stampSource

    ▸ a file kode did not write has no source

        knrd.stampSource 'var a = 1\n', jdir  ▸ ''

    ▸ a hand written file is not a candidate

        knrd.stampSource 'export default {}\n', jdir  ▸ ''

    ▸ the sourceURL is enough on its own

        knrd.stampSource hereText, jdir  ▸ kp('here.kode')

    ▸ and the sourcemap still works on its own

        knrd.stampSource mapHereText, jp('x.js')  ▸ kp('here.kode')

    ▸ a sourcemap that is not base64 is not a stamp

        knrd.stampSource '//# sourceMappingURL=data:application/json;base64,!!!\n', jdir  ▸ ''

    ▸ a map with no sources is not a stamp

        bad = '//# sourceMappingURL=data:application/json;base64,eyJmb28iOiJiYXIifQ==\n'
        knrd.stampSource bad, jdir  ▸ ''

▸ reconcile

    ▸ what has lost its source goes, and only that

        ○ setup()
        gone = ○ knrd.reconcile dirs opt

        gone.length  ▸ 2

    ▸ and it is the right two

        ○ setup()
        gone = ○ knrd.reconcile dirs opt

        gone.join ' '  ▸ "#{jp('stale.js')} #{jp('stale.json')}"

    ▸ a generated file whose source is still there stays

        ○ setup()
        ○ knrd.reconcile dirs opt

        isFile jp('kept.js') ○▸ true

    ▸ a file nobody generated stays

        ○ setup()
        ○ knrd.reconcile dirs opt

        isFile jp('hand.js') ○▸ true

    ▸ a second pass has nothing to do

        ○ setup()
        ○ knrd.reconcile dirs opt
        nothing = ○ knrd.reconcile dirs opt

        nothing  ▸ []

    ▸ a directory that is not there is not an error

        nowhere = ○ knrd.reconcile [slash.path(root,'nowhere')] opt

        nowhere  ▸ []

    ▸ the source is resolved, not guessed

        ○ setup()
        ○ knrd.reconcile dirs opt
        
        away = slash.path root 'elsewhere' 'here.kode'
        ○ nfs.write jp('stray.js') (stamped (fromCwd away))
        ○ knrd.reconcile dirs opt

        isFile jp('stray.js') ○▸ true

    ▸ a stamp naming a directory is not a source

        ○ setup()
        ○ knrd.reconcile dirs opt
        
        ○ nfs.write jp('dirish.js') (stamped (fromCwd kdir))
        ○ knrd.reconcile dirs opt

        isFile jp('dirish.js') ○▸ true


# ███   ███  ███   ███   ███████    ███████  ███   ███  ████████  
# ███  ███   ███  ███   ███   ███  ███       ███   ███  ███       
# ███████    ███████    █████████  ███       █████████  ███████   
# ███  ███   ███  ███   ███   ███  ███       ███   ███  ███       
# ███   ███  ███   ███  ███   ███   ███████  ███   ███  ████████  

cache = slash.path root, 'cache'

ckfile = slash.path cache, 'x.kode'
cjfile = slash.path cache, 'x.js'

# a second file, because the interesting cases are about the ones a build
# did not compile. one file cannot show that

ckfile2 = slash.path cache, 'y.kode'
cjfile2 = slash.path cache, 'y.js'

ckache = slash.path cache, '.kkache'

cktext = 'x = 1\n'
cjtext = 'var x = 1;\n'
cktext2 = 'y = 2\n'
cjtext2 = 'var y = 2;\n'

fpA = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
fpB = 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb'

cksrc = {}
cksrc[knrd.rel ckfile] = knrd.hash cktext
cksrc[knrd.rel ckfile2] = knrd.hash cktext2

cktgt = {}
cktgt[knrd.rel cjfile] = knrd.hash cjtext
cktgt[knrd.rel cjfile2] = knrd.hash cjtext2

more = {}
more[knrd.rel ckfile] = 'cccccccccccccccccccccccccccccccccccccccc'

# the entry for one file only, because the interesting cases are about the
# ones a build did not compile

oneSrc = {}
oneSrc[knrd.rel ckfile] = cksrc[knrd.rel ckfile]

oneTgt = {}
oneTgt[knrd.rel cjfile] = cktgt[knrd.rel cjfile]

# the cache directory, from scratch: the two files with their sources and
# their targets, and no cache file

setupCache = ○->
    
    ○ nfs.remove cache
    ○ nfs.mkdir  cache
    ○ nfs.write  ckfile cktext
    ○ nfs.write  cjfile cjtext
    ○ nfs.write  ckfile2 cktext2
    ○ nfs.write  cjfile2 cjtext2
    ○ nfs.remove ckache

# a build with the given fingerprint, over the cache that is already there.
# a whole build may write over a cache from another compiler; a partial one
# may not, because it cannot vouch for the files it never looked at

built = fp srcs tgts whole ○->
    
    back = ○ knrd.loadCache ckache
    ok = ○ knrd.saveCache ckache, back, fp, true, srcs, tgts, whole
    
    ⮐ {ok: ok, cache: ○ knrd.loadCache(ckache)}

# the two files and a cache for them, from scratch, and what came back off
# the disk

cached = fp ○->
    
    ○ setupCache()
    ○ knrd.saveCache ckache, null, fp, true, cksrc, cktgt, no
    
    ⮐ ○ knrd.loadCache ckache

▸ cache

    ▸ it round trips through noon

        ○ setupCache()
        wrote = ○ knrd.saveCache ckache, null, fpA, true, cksrc, cktgt
        back = ○ knrd.loadCache ckache

        wrote        ▸ true
        back.kode    ▸ fpA
        back.srcmap  ▸ true
        back.source[knrd.rel ckfile] ▸ knrd.hash cktext
        back.target[knrd.rel cjfile] ▸ knrd.hash cjtext

    ▸ a file that is not there is not a cache

        knrd.loadCache slash.path(cache,'nowhere')  ○▸ null

    ▸ rubbish that still parses is not a cache either

        # noon is forgiving. these two are the ways a cache can be rubbish
        # without failing to parse, and neither may be allowed to wedge the
        # build.

        ○ setupCache()
        
        ○ nfs.write ckache, '- not a cache at all\n'
        junkList = ○ knrd.loadCache ckache
        
        ○ nfs.write ckache, 'kode   not\n\tsource\n'
        junkMap  = ○ knrd.loadCache ckache

        knrd.shaped junkList  ▸ false
        knrd.shaped junkMap   ▸ false
        knrd.usable junkMap, fpA, true  ▸ false

    ▸ the header is the compiler and the sourcemap, and it needs both

        back = ○ cached fpA

        knrd.usable back, fpA, true   ▸ true
        knrd.usable back, fpB, true   ▸ false
        knrd.usable back, fpA, false  ▸ false
        knrd.usable null,  fpA, true   ▸ false
        knrd.usable {},   fpA, true   ▸ false

    ▸ current means the source and what is on disk both still match

        # the four ways a file can fail to be current

        back = ○ cached fpA

        knrd.isCurrent back, ckfile, cjfile, cktext  ○▸ true

    ▸ a source that has moved is a miss

        back = ○ cached fpA

        knrd.isCurrent back, ckfile, cjfile, 'x = 2\n'  ○▸ false

    ▸ a target that has moved is a miss

        back = ○ cached fpA
        ○ nfs.write cjfile, 'var x = 2;\n'

        knrd.isCurrent back, ckfile, cjfile, cktext  ○▸ false

    ▸ a target that is not there is a miss

        back = ○ cached fpA
        ○ nfs.remove cjfile

        knrd.isCurrent back, ckfile, cjfile, cktext  ○▸ false

    ▸ and no cache at all is a miss

        knrd.isCurrent null, ckfile, cjfile, cktext  ○▸ false

    ▸ a build that compiled nothing writes nothing

        first = ○ built fpA, cksrc, cktgt, no
        before = ○ nfs.read ckache
        compiledNo = ○ knrd.saveCache ckache, first.cache, fpA, true, {}, {}
        afterNo = ○ nfs.read ckache

        compiledNo  ▸ false
        afterNo     ▸ before

    ▸ a partial build does not write over a cache from another compiler

        ○ built fpA, cksrc, cktgt, no
        other = ○ built fpB, cksrc, cktgt, no

        other.ok          ▸ false
        other.cache.kode  ▸ fpA

    ▸ and one that can, merges rather than replaces

        ○ built fpA, cksrc, cktgt, no
        merged = ○ built fpA, more, cktgt, no

        merged.ok  ▸ true
        merged.cache.source[knrd.rel ckfile]  ▸ more[knrd.rel ckfile]
        merged.cache.target[knrd.rel cjfile] ▸ knrd.hash cjtext

    ▸ and a whole build can replace a cache from another compiler

        ○ built fpA, cksrc, cktgt, no
        ○ built fpA, more, cktgt, no
        whole = ○ built fpB, cksrc, cktgt, yes

        whole.ok  ▸ true
        whole.cache.kode  ▸ fpB
        whole.cache.source[knrd.rel ckfile]  ▸ knrd.hash cktext

    ▸ but a partial one cannot, or the files it never looked at go on
    ▸ being marked current under a compiler they were never built with

        ○ built fpA, cksrc, cktgt, no
        ○ built fpA, more, cktgt, no
        ○ built fpB, cksrc, cktgt, yes
        still = ○ built fpA, cksrc, cktgt, no

        still.ok  ▸ false
        still.cache.kode  ▸ fpB

    ▸ and a whole build adds to the cache rather than replacing it, or the
    ▸ files it did not compile lose their entry and the next build has to
    ▸ rebuild the tree to write them back

        # the shape that made every other build after it recompile the tree.
        # a build records only what it compiled, so replacing the cache with
        # that leaves the files it did not compile - which were not rebuilt
        # because they were already right, which is what the cache had said -
        # with no entry at all. the next build then finds 213 misses and
        # recompiles everything to write them back

        first = ○ built fpA, cksrc, cktgt, no
        merged = ○ built fpA, more, cktgt, no
        whole = ○ built fpB, cksrc, cktgt, yes
        still = ○ built fpA, cksrc, cktgt, no
        kept = ○ built fpB, oneSrc, oneTgt, yes
        
        kept.ok  ▸ true
        kept.cache.source[knrd.rel ckfile]  ▸ cksrc[knrd.rel ckfile]
        kept.cache.source[knrd.rel ckfile2] ▸ cksrc[knrd.rel ckfile2]
        kept.cache.target[knrd.rel cjfile]  ▸ cktgt[knrd.rel cjfile]
        kept.cache.target[knrd.rel cjfile2] ▸ cktgt[knrd.rel cjfile2]

    ▸ but rubbish is replaced, or it would wedge the build for good

        # rubbish in the cache has to be replaced rather than respected, or
        # it sits there refusing every write and nothing is ever cached again

        ○ setupCache()
        ○ nfs.write ckache, '- not a cache at all\n'
        junk = ○ knrd.loadCache ckache
        healedOk = ○ knrd.saveCache ckache, junk, fpA, true, cksrc, cktgt
        healed = ○ knrd.loadCache ckache

        healedOk  ▸ true
        healed.kode  ▸ fpA
        healed.source[knrd.rel ckfile]  ▸ knrd.hash cktext

    ▸ the fingerprint is a digest of the compiler, and it does not move

        fpOne = ○ knrd.fingerprint()
        fpTwo = ○ knrd.fingerprint()

        fpOne == fpTwo  ▸ true
        fpOne.length  ▸ 40
        
        # the hash of nothing is what a tree without a compiler in it gets,
        # and it is the same for every version of the compiler - which would
        # leave a side project building with a compiler it never saw change
        
        fpOne != knrd.hash('')  ▸ true

    ▸ the cache lives beside the sources it describes

        knrd.cachePath().endsWith 'kode/.kkache'  ▸ true

    ▸ hashing is hashing

        knrd.hash('x') == knrd.hash('x')  ▸ true
        knrd.hash('x') == knrd.hash('y')  ▸ false
        knrd.hash('').length  ▸ 40
