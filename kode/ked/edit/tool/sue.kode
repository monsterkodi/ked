
use ../../../kxk ▪ kseg
use ◆ colorspans

#  sue areas
#
#  a sue area is a rectangle of cells described by a payload hidden in the
#  text. the payload is placed before the text it describes.
#
#  the payload is written in the tag block U+E0021..U+E007E, which is plain
#  ascii plus 0xE0000, so it is invisible and harmless everywhere else:
#
#      '!' four decimal length digits json body
#
#  the length is the number of symbols of the body, which makes the body
#  opaque: it needs no escaping and a run can hold several payloads in a row.
#  the digits are plain decimal, so the ascii view of a payload reads as
#  '!0007{"a":1}' and the length needs no mental arithmetic.
#
#      desue    text       -> { text, sue }
#      ensue    text sue   -> text
#      sueAscii symbols    -> ascii, for looking at a payload
#      sueEncode value     -> symbols
#
#  a sue area is { x, y, value } where x is the grapheme index inside the
#  line and y the line index, both counted in the text that follows the
#  payload. value is whatever JSON.parse makes of the body.

#  style areas carry flags, a string of b i u s
#  two areas over the same cells stack, so flags are joined, not replaced

addFlags = (have add) ->

    have ?= ''
    add  ?= ''

    for ch in Array.from(add)
        have += ch if not have.includes ch

    have

#  the codes of the features that use sue
#  a value is [code, data], the code says which feature it belongs to

FG_COLOR    = 31
BG_COLOR    = 32
FG_BG_COLOR = 33
STYLE       = 34
LINE_SCALE  = 40
SCALE       = 41
CLOSE       = 99

TAG   = 0xE0000
MAGIC = 0x21
DIGIT = 0x30
LO    = 0xE0021
HI    = 0xE007E
LEN   = 4
MAX   = 9999

isTag = (ch) ->
    cp = ch.codePointAt(0)
    LO <= cp and cp <= HI

tagOf = (ch) -> String.fromCodePoint(TAG + ch.codePointAt(0))

plainOf = (ch) -> String.fromCodePoint(ch.codePointAt(0) - TAG)

textOf = (symbols) ->
    out = ''
    for ch in Array.from(symbols)
        out += plainOf ch
    out

fromString = (text) ->
    out = ''
    for ch in Array.from(text)
        out += tagOf ch
    out

hex4 = (n) ->
    s = n.toString(16)
    while s.length < 4
        s = '0' + s
    s

#  the body is ascii, a space or anything above 0x7E is written as an
#  escape so that the symbol alphabet stays free of whitespace

escape = (body) ->
    out = ''
    for i in 0...body.length
        c = body.charCodeAt(i)
        if c > 0x20 and c < 0x7F
            out += body[i]
        else
            out += '\\u' + hex4(c)
    out

digits = (n) ->
    n = clamp(0 MAX n)
    out = ''
    for k in 0...LEN
        out = String.fromCharCode(DIGIT + n % 10) + out
        n = floor(n / 10)
    out

#  total number of symbols of the payload starting at arr[i], zero if there
#  is no payload there

payloadTotal = (arr i) ->
    ⮐ 0 if i + 1 + LEN > arr.length
    ⮐ 0 if arr[i].codePointAt(0) - TAG != MAGIC
    n = 0
    for k in 1..LEN
        d = arr[i+k].codePointAt(0) - TAG - DIGIT
        ⮐ 0 if d < 0 or d > 9
        n = n*10 + d
    1 + LEN + n

#  a grapheme is a visible base plus the tag characters that attached to it

splitTags = (seg) ->
    cps = Array.from(seg)
    i = cps.length
    while i > 0 and isTag(cps[i-1])
        i -= 1
    [cps[0...i].join('') cps[i...cps.length].join('')]

#  collect the payloads of one line
#
#  pending holds the tag symbols seen so far, the anchor is the position of
#  the next visible grapheme, which is exactly the index of the payload

collect = (pending y x areas) ->
    arr = Array.from(pending)
    i = 0
    while i < arr.length
        total = payloadTotal(arr i)
        if total == 0
            i += 1
            continue
        break if i + total > arr.length
        body = textOf arr[i+1+LEN...i+total]
        value = null
        try
            value = JSON.parse body
        catch err
            value = null
        areas.push({x: x y: y value: value}) if value != null
        i += total

■sue

    @FG_COLOR:    FG_COLOR
    @BG_COLOR:    BG_COLOR
    @FG_BG_COLOR: FG_BG_COLOR
    @STYLE:       STYLE
    @LINE_SCALE:  LINE_SCALE
    @SCALE:       SCALE
    @CLOSE:       CLOSE

    @addFlags: (have add) -> addFlags(have add)

    #  the values of a style area are [flags] or [ul, flags]

    @styleOfValues: values ->

        values ?= []

        if values.length > 1
            [values[0] values[1]]
        else
            [values[0] null]

    #  the flags and underline color in effect at a cell, from all areas

    @styleFlagsAt: (areas lines x y) ->

        flags = ''
        ul    = null

        for area in areas

            continue if area.value[0] != STYLE

            box = @boxForAreaAndLines(area lines)
            continue if not box?

            continue if y < box.y or y >= box.y + box.h
            continue if x < box.x or x >= box.x + box.w

            [f u] = @styleOfValues(box.values)

            flags = addFlags(flags f)
            ul    = u if u?

        [flags ul]

    #  toggle one flag over the ranges
    #
    #  the style areas are cut out of the ranges first and the range is
    #  then covered by a single area with the joined flags, so applying a
    #  flag a second time takes it away again

    @rangesWithToggledFlag: (ranges areas lines flag) ->

        styles = []
        keep   = []

        for area in areas
            if area.value[0] == STYLE
                styles.push area
            else
                keep.push area

        styles = @rangesCutFromAreasInLines(ranges styles lines)

        add = []

        for rng in ranges

            [flags ul] = @styleFlagsAt(areas lines rng[0] rng[1])

            if flags.includes flag
                flags = flags.replace(flag, '')
            else
                flags += flag

            continue if empty flags

            w = max 1 (rng[2] - rng[0])
            h = rng[3] - rng[1] + 1

            values = [flags]
            values = [ul flags] if ul?

            add.push {x: rng[0] y: rng[1] value: [STYLE values.concat([w h])]}

        next = keep.concat(styles)
        next.concat(add)

    #  scale runs
    #
    #  [SCALE, [n]] opens a run of n times scaled characters, [CLOSE, [SCALE]]
    #  closes it. a close without an open is ignored, an open without a close
    #  runs to the end of the line, an open inside an open is ignored.

    @runsForLine: (areas lines y) ->

        ⮐ [] if y < 0 or y >= lines.length

        marks = []

        for area in areas
            continue if area.y != y
            code = area.value[0]
            continue if code != SCALE and code != CLOSE
            marks.push area

        ⮐ [] if empty marks

        marks.sort (a b) -> a.x - b.x

        width = (lines[y] ? []).length
        runs  = []
        open  = null

        for mark in marks

            if mark.value[0] == SCALE
                open = mark if not open?
                continue

            data = mark.value[1] ? []
            continue if valid data[0] and data[0] != SCALE
            continue if not open?

            scale = clamp(1 7 int((open.value[1] ? [])[0] ? 2))
            runs.push [open.x mark.x scale] if mark.x > open.x and scale > 1
            open = null

        if open?
            scale = clamp(1 7 int((open.value[1] ? [])[0] ? 2))
            runs.push [open.x width scale] if width > open.x and scale > 1

        runs

    #  the cell column each grapheme of a line starts at
    #  a run makes its graphemes take scale cells, the rest takes their width

    @cellPositionsForLine: (lines y runs) ->

        line  = lines[y] ? []
        cells = [0]
        cell  = 0
        scale = 1
        ri    = 0

        for gi in 0...line.length

            if ri < runs.length and gi == runs[ri][0]
                scale = runs[ri][2]

            cw = kseg.segWidth(line[gi])
            cw = max(1 cw)

            cell += cw*scale
            cells.push cell

            if ri < runs.length and gi + 1 == runs[ri][1]
                scale = 1
                ri += 1

        cells

    @sueAscii: symbols ->
        out = ''
        for ch in Array.from(symbols)
            if isTag(ch)
                out += plainOf(ch)
            else
                out += ch
        out

    @sueEncode: value ->
        body = escape(JSON.stringify(value))
        fromString('!' + digits(body.length) + body)

    @sueDecode: symbols ->
        arr = Array.from(symbols)
        ⮐ null if empty arr
        total = payloadTotal arr 0
        ⮐ null if total == 0 or total != arr.length
        try
            ⮐ JSON.parse(textOf(arr[1+LEN...total]))
        catch err
            ⮐ null

    #  keep the anchors of areas attached to the text
    #  a one cell span is enough to find the new x and y, the value is
    #  never rewritten, so open ended areas stay open ended

    #  a color span is [x1 y x2 color], the sue form is a fixed width area

    @areasForColors: colors ->

        areas = []

        ⮐ areas if not colors?

        for span in (colors.fg ? [])
            areas.push {x: span[0] y: span[1] value: [FG_COLOR [span[3] span[2]-span[0] 1]]}

        for span in (colors.bg ? [])
            areas.push {x: span[0] y: span[1] value: [BG_COLOR [span[3] span[2]-span[0] 1]]}

        areas

    @adjust: areas oldLines newLines ->
        ⮐ areas if empty areas

        map = colorspans.lineMap oldLines newLines
        result = []

        for area in areas

            ny = map[area.y]
            continue if not valid ny or ny < 0

            oldLine = oldLines[area.y] ? []
            newLine = newLines[ny] ? []

            x = area.x

            if not (oldLine eql newLine)
                adj = colorspans.adjustSegment [area.x area.y area.x+1 area] oldLine newLine
                continue if not adj?
                x = adj[0]

            result.push {x: x y: ny value: area.value}

        result

    #  geometry
    #
    #  the leading values of a value's data are the feature's own, the
    #  trailing numbers are geometry: width in cells, then height in rows.
    #  a null width means the box reaches to the end of its line.
    #
    #  data that starts with a number has no way to tell values from
    #  geometry, so such an area has no box and is never cut.

    @boxForAreaAndLines: (area lines) ->

        data = area.value[1] ? []

        n = 0
        while n < data.length and not (data[n] is num) and data[n] != null
            n += 1

        ⮐ null if n == 0 and not empty data

        w = data[n]
        h = data[n+1] ? 1

        if not valid w
            line = lines[area.y] ? []
            w    = max 0 (line.length - area.x)
            open = true
        else
            open = false

        {x: area.x y: area.y w: w h: h values: data[0...n] open: open}

    @areaWithBoxGeometry: (area box) ->
        w = box.open ? null : box.w
        {x: box.x y: box.y value: [area.value[0] box.values.concat([w box.h])]}

    #  the parts of a box that a range does not cover
    #  a range is [x1 y1 x2 y2] with x2 exclusive and y2 inclusive

    @boxMinusRange: (box rng) ->

        [rx1 ry1 rx2 ry2] = rng

        x1 = box.x
        x2 = box.x + box.w
        y1 = box.y
        y2 = box.y + box.h - 1

        ⮐ [box] if rx2 <= x1 or rx1 >= x2 or ry2 < y1 or ry1 > y2

        parts = []

        if ry1 > y1
            parts.push {x: x1 y: y1 w: box.w h: ry1-y1 values: box.values open: box.open}

        if ry2 < y2
            parts.push {x: x1 y: ry2+1 w: box.w h: y2-ry2 values: box.values open: box.open}

        my1 = max(y1 ry1)
        my2 = min(y2 ry2)

        if my2 >= my1
            mh = my2 - my1 + 1
            if rx1 > x1
                parts.push {x: x1 y: my1 w: rx1-x1 h: mh values: box.values open: false}
            if rx2 < x2
                parts.push {x: rx2 y: my1 w: x2-rx2 h: mh values: box.values open: box.open}

        parts

    @rangesCutFromAreasInLines: (ranges areas lines) ->

        result = []

        for area in areas

            box = @boxForAreaAndLines(area lines)

            if not box?
                result.push area
                continue

            parts = [box]

            for rng in ranges
                next = []
                for part in parts
                    next = next.concat(@boxMinusRange(part rng))
                parts = next
                break if empty parts

            for part in parts
                result.push @areaWithBoxGeometry(area part)

        result

    @desue: text ->
        lines = text.split('\n')
        clean = []
        areas = []
        for y in 0...lines.length
            line    = []
            pending = ''
            for seg in kseg(lines[y])
                [visible tags] = splitTags seg
                if not empty visible
                    collect(pending y line.length areas) if not empty pending
                    pending = ''
                    line.push visible
                pending += tags
            collect(pending y line.length areas) if not empty pending
            clean.push(line.join(''))
        {text: clean.join('\n') sue: areas}

    @ensue: text sue ->
        ⮐ text if empty sue
        lines = text.split('\n')
        for y in 0...lines.length
            mine = []
            for area in sue
                mine.push(area) if area.y == y
            continue if empty mine
            mine.sort (a b) -> a.x - b.x
            segs = kseg(lines[y])
            out = ''
            i = 0
            for x in 0..segs.length
                while i < mine.length and mine[i].x <= x
                    out += @sueEncode(mine[i].value)
                    i += 1
                out += segs[x] if x < segs.length
            while i < mine.length
                out += @sueEncode(mine[i].value)
                i += 1
            lines[y] = out
        lines.join('\n')

export sue
