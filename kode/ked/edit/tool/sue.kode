
use ../../../kxk ▪ kseg
use ◆ colorspans

#!sue

#  a sue area is a rectangle of cells described by a payload hidden in the
#  text. the payload is placed before the text it describes.
#
#  the payload is written in the tag block U+E0021..U+E007E, which is plain
#  ascii plus 0xE0000, so it is invisible and harmless everywhere else:
#
#      '!' four decimal length digits json body
#
#  the length is the number of symbols of the body, which makes the body
#  opaque: it needs no escaping and a run can hold several payloads in a row.
#  the digits are plain decimal, so the ascii view of a payload reads as
#  '!0007{"a":1}' and the length needs no mental arithmetic.
#
#      desue    text       -> { text, sue }
#      ensue    text sue   -> text
#      sueAscii symbols    -> ascii, for looking at a payload
#      sueEncode value     -> symbols
#
#  a sue area is { x, y, value } where x is the grapheme index inside the
#  line and y the line index, both counted in the text that follows the
#  payload. value is [code, cols, lines, data...]: the code says which
#  feature the area belongs to, cols and lines are its box in graphemes and
#  rows, and data is whatever that feature needs.

#  style areas carry flags, a string of b i u s
#  flags are joined, so styles stack

addFlags = (have add) ->

    have ?= ''
    add  ?= ''

    for ch in Array.from(add)
        have += ch if not have.includes ch

    have

FG_COLOR    = 31
BG_COLOR    = 32
FG_BG_COLOR = 33
STYLE       = 34
LINE_SCALE  = 40
SCALE       = 41
WRAP        = 42
CLOSE       = 99

isMark = (value) -> value[0] in [LINE_SCALE SCALE WRAP CLOSE]

TAG   = 0xE0000
MAGIC = 0x21
DIGIT = 0x30
LO    = 0xE0021
HI    = 0xE007E
LEN   = 4
MAX   = 9999

isTag = (ch) ->
    cp = ch.codePointAt(0)
    LO <= cp and cp <= HI

tagOf = (ch) -> String.fromCodePoint(TAG + ch.codePointAt(0))

plainOf = (ch) -> String.fromCodePoint(ch.codePointAt(0) - TAG)

textOf = (symbols) ->
    out = ''
    for ch in Array.from(symbols)
        out += plainOf ch
    out

fromString = (text) ->
    out = ''
    for ch in Array.from(text)
        out += tagOf ch
    out

hex4 = (n) ->
    s = n.toString(16)
    while s.length < 4
        s = '0' + s
    s

escape = (body) ->
    out = ''
    for i in 0...body.length
        c = body.charCodeAt(i)
        if c > 0x20 and c < 0x7F
            out += body[i]
        else
            out += '\\u' + hex4(c)
    out

digits = (n) ->
    n = clamp(0 MAX n)
    out = ''
    for k in 0...LEN
        out = String.fromCharCode(DIGIT + n % 10) + out
        n = floor(n / 10)
    out

payloadTotal = (arr i) ->
    ⮐ 0 if i + 1 + LEN > arr.length
    ⮐ 0 if arr[i].codePointAt(0) - TAG != MAGIC
    n = 0
    for k in 1..LEN
        d = arr[i+k].codePointAt(0) - TAG - DIGIT
        ⮐ 0 if d < 0 or d > 9
        n = n*10 + d
    1 + LEN + n

splitTags = (seg) ->
    cps = Array.from(seg)
    i = cps.length
    while i > 0 and isTag(cps[i-1])
        i -= 1
    [cps[0...i].join('') cps[i...cps.length].join('')]

collect = (pending y x areas) ->
    arr = Array.from(pending)
    i = 0
    while i < arr.length
        total = payloadTotal(arr i)
        if total == 0
            i += 1
            continue
        break if i + total > arr.length
        body = textOf arr[i+1+LEN...i+total]
        value = null
        try
            value = JSON.parse body
        catch err
            value = null
        areas.push({x: x y: y value: value}) if value != null
        i += total

insertionIndex = (oldLine newLine) ->

    oldLen = oldLine.length
    newLen = newLine.length

    ⮐ -1 if newLen <= oldLen

    p = 0
    while p < oldLen and oldLine[p] == newLine[p]
        p += 1

    s = 0
    while s < oldLen-p and newLine[newLen-1-s] == oldLine[oldLen-1-s]
        s += 1

    ⮐ -1 if oldLen - s != p

    p

#  a changed line keeps its wrap where it starts the changed block,
#  so the base of a join or a split stays wrapped and new lines don't

wrapLineIndex = (map y oldLines newLines) ->

    ny = map[y]
    ⮐ ny if ny? and ny >= 0

    oldLen = oldLines.length
    newLen = newLines.length

    pre = 0
    while pre < oldLen and pre < newLen and oldLines[pre] eql newLines[pre]
        pre += 1

    suf = 0
    while suf < oldLen-pre and suf < newLen-pre and oldLines[oldLen-1-suf] eql newLines[newLen-1-suf]
        suf += 1

    ⮐ y if pre <= y and y < newLen-suf

■sue

    @FG_COLOR:    FG_COLOR
    @BG_COLOR:    BG_COLOR
    @FG_BG_COLOR: FG_BG_COLOR
    @STYLE:       STYLE
    @LINE_SCALE:  LINE_SCALE
    @SCALE:       SCALE
    @WRAP:        WRAP
    @CLOSE:       CLOSE

    @addFlags: (have add) -> addFlags(have add)

    @styleOfValues: values ->

        values ?= []

        if values.length > 1
            [values[1] values[0]]
        else
            [values[0] null]

    @styleFlagsAt: (areas lines x y) ->

        flags = ''
        ul    = null

        for area in areas

            continue if area.value[0] != STYLE

            box = @boxForAreaAndLines(area lines)
            continue if not box?

            continue if y < box.y or y >= box.y + box.h
            continue if x < box.x or x >= box.x + box.w

            [f u] = @styleOfValues(box.values)

            flags = addFlags(flags f)
            ul    = u if u?

        [flags ul]

    @rangesWithToggledFlag: (ranges areas lines flag) ->

        styles = []
        keep   = []

        for area in areas
            if area.value[0] == STYLE
                styles.push area
            else
                keep.push area

        styles = @rangesCutFromAreasInLines(ranges styles lines)

        add = []

        for rng in ranges

            [flags ul] = @styleFlagsAt(areas lines rng[0] rng[1])

            if flags.includes flag
                flags = flags.replace(flag, '')
            else
                flags += flag

            continue if empty flags

            w = max 1 (rng[2] - rng[0])
            h = rng[3] - rng[1] + 1

            values = [flags]
            values = [ul flags] if ul?

            add.push {x: rng[0] y: rng[1] value: [STYLE w h].concat(values)}

        next = keep.concat(styles)
        next.concat(add)

    #  scale runs
    #
    #  [SCALE, -1, 1, n] opens a run of n times scaled characters,
    #  [CLOSE, -1, 1, SCALE] closes it. a close without an open is ignored,
    #  an open without a close runs to the end of the line, an open inside
    #  an open is ignored.

    @runsForLine: (areas lines y) ->

        ⮐ [] if y < 0 or y >= lines.length

        marks = []

        for area in areas
            continue if area.y != y
            code = area.value[0]
            continue if code != SCALE and code != CLOSE
            marks.push area

        ⮐ [] if empty marks

        marks.sort (a b) -> a.x - b.x

        width = (lines[y] ? []).length
        runs  = []
        open  = null

        for mark in marks

            if mark.value[0] == SCALE
                open = mark if not open?
                continue

            data = @dataOf(mark.value ? [])
            continue if valid data[0] and data[0] != SCALE
            continue if not open?

            scale = clamp(1 7 int(open.value[3] ? 2))
            runs.push [open.x mark.x scale] if mark.x > open.x and scale > 1
            open = null

        if open?
            scale = clamp(1 7 int(open.value[3] ? 2))
            runs.push [open.x width scale] if width > open.x and scale > 1

        runs

    @cellPositionsForLine: (lines y runs) ->

        line  = lines[y] ? []
        cells = [0]
        cell  = 0
        scale = 1
        ri    = 0

        for gi in 0...line.length

            if ri < runs.length and gi == runs[ri][0]
                scale = runs[ri][2]

            cw = kseg.segWidth(line[gi])
            cw = max(1 cw)

            cell += cw*scale
            cells.push cell

            if ri < runs.length and gi + 1 == runs[ri][1]
                scale = 1
                ri += 1

        cells

    @dataOf: value ->
        value.slice(3)

    @sueAscii: symbols ->
        out = ''
        for ch in Array.from(symbols)
            if isTag(ch)
                out += plainOf(ch)
            else
                out += ch
        out

    @sueEncode: value ->
        body = escape(JSON.stringify(value))
        fromString('!' + digits(body.length) + body)

    @sueDecode: symbols ->
        arr = Array.from(symbols)
        ⮐ if empty arr
        total = payloadTotal arr 0
        ⮐ if total == 0 or total != arr.length
        try
            ⮐ JSON.parse(textOf(arr[1+LEN...total]))
        catch err
            ⮐ 

    @adjust: areas oldLines newLines ->
        ⮐ areas if empty areas

        map = colorspans.lineMap oldLines newLines
        result = []

        for area in areas

            if area.value[0] == WRAP
                ny = wrapLineIndex map area.y oldLines newLines
                result.push {x: 0 y: ny value: area.value} if ny?
                continue

            ny = map[area.y]
            continue if not valid ny or ny < 0

            oldLine = oldLines[area.y] ? []
            newLine = newLines[ny] ? []

            x = area.x

            if not (oldLine eql newLine)
                if area.value[0] == SCALE and insertionIndex(oldLine newLine) == area.x
                    result.push {x: x y: ny value: area.value}
                    continue
                adj = colorspans.adjustSegment [area.x area.y area.x+1 area] oldLine newLine
                continue if not adj?
                x = adj[0]

            result.push {x: x y: ny value: area.value}

        result
        
    @boxForAreaAndLines: (area lines) ->

        value = area.value

        ⮐ if not (value is arr)
        ⮐ if value.length < 3
        ⮐ if not (value[1] is num)
        ⮐ if isMark value

        cols = value[1]
        h    = value[2] ? 1

        if cols < 0
            line = lines[area.y] ? []
            w    = max 0 (line.length - area.x)
            open = true
        else
            w    = cols
            open = false

        {x: area.x y: area.y w: w h: h values: @dataOf(value) open: open}

    @boxMinusRange: (box rng) ->

        [rx1 ry1 rx2 ry2] = rng

        x1 = box.x
        x2 = box.x + box.w
        y1 = box.y
        y2 = box.y + box.h - 1

        ⮐ [box] if rx2 <= x1 or rx1 >= x2 or ry2 < y1 or ry1 > y2

        parts = []

        if ry1 > y1
            parts.push {x: x1 y: y1 w: box.w h: ry1-y1 values: box.values open: box.open}

        if ry2 < y2
            parts.push {x: x1 y: ry2+1 w: box.w h: y2-ry2 values: box.values open: box.open}

        my1 = max(y1 ry1)
        my2 = min(y2 ry2)

        if my2 >= my1
            mh = my2 - my1 + 1
            if rx1 > x1
                parts.push {x: x1 y: my1 w: rx1-x1 h: mh values: box.values open: false}
            if rx2 < x2
                parts.push {x: rx2 y: my1 w: x2-rx2 h: mh values: box.values open: box.open}

        parts

    @rangesCutFromAreasInLines: (ranges areas lines) ->

        result = []

        for area in areas

            box = @boxForAreaAndLines(area lines)

            if not box?
                result.push area
                continue

            parts = [box]

            for rng in ranges
                next = []
                for part in parts
                    next = next.concat(@boxMinusRange(part rng))
                parts = next
                break if empty parts

            for part in parts
                result.push @areaWithBoxGeometry(area part)

        result

    @areaWithBoxGeometry: (area box) ->
        
        cols = box.open ? -1 : box.w
        {x: box.x y: box.y value: [area.value[0] cols box.h].concat(box.values)}
        
    @areasWithoutLineScales: (areas indices) ->

        keep = []

        for area in areas
            continue if area.y in indices and area.value[0] == sue.LINE_SCALE
            keep.push area

        keep

    @areasForColors: colors ->

        areas = []

        ⮐ areas if not colors?

        for span in (colors.fg ? [])
            areas.push {x: span[0] y: span[1] value: [FG_COLOR (span[2]-span[0]) 1 span[3]]}

        for span in (colors.bg ? [])
            areas.push {x: span[0] y: span[1] value: [BG_COLOR (span[2]-span[0]) 1 span[3]]}

        areas

    @areasWithRun: (areas y x1 x2 scale) ->

        open  = {x: x1 y: y value: [sue.SCALE -1 1 scale]}
        close = {x: x2 y: y value: [sue.CLOSE -1 1 sue.SCALE]}

        areas.concat([open close])

    @areasWithRunScale: (areas y x1 scale) ->

        out = []

        for area in areas
            if area.y == y and area.x == x1 and area.value[0] == sue.SCALE
                out.push {x: area.x y: area.y value: [sue.SCALE -1 1 scale]}
            else
                out.push area

        out

    @areasWithoutRun: (areas y x1 x2) ->

        out = []

        for area in areas

            if area.y == y and area.x == x1 and area.value[0] == sue.SCALE
                continue

            if area.y == y and area.x == x2 and area.value[0] == sue.CLOSE
                data = sue.dataOf(area.value)
                continue if empty data or data[0] == sue.SCALE

            out.push area

        out

    @areasWithSteppedRunsInLines: (areas pieces delta lines) ->

        for piece in pieces

            [x1 y x2] = piece

            continue if x1 >= x2

            run = null

            for r in sue.runsForLine(areas lines y)
                if r[0] <= x1 and x2 <= r[1]
                    run = r
                    break

            if run?
                scale = clamp(1 7 (run[2] + delta))
                if scale <= 1
                    areas = sue.areasWithoutRun(areas y run[0] run[1])
                else
                    areas = sue.areasWithRunScale(areas y run[0] scale)
            else if delta > 0
                scale = clamp(1 7 (1 + delta))
                areas = sue.areasWithRun(areas y x1 x2 scale) if scale > 1

        areas
        
    @areasWithSteppedLineScales: (areas indices delta lineHeight) ->

        ⮐ areas if empty indices

        scales = []

        for y in indices
            scales.push clamp(1 7 (lineHeight(y) + delta))

        keep = sue.areasWithoutLineScales(areas indices)

        for y,i in indices
            if scales[i] > 1
                keep.push {x: 0 y: y value: [sue.LINE_SCALE -1 1 scales[i]]}
        keep

    @isWrapLine: (areas y) ->

        for area in (areas ? [])
            ⮐ true if area.y == y and area.value[0] == WRAP
        false

    @areasWithWraps: (areas indices wrap) ->

        keep = []

        for area in areas
            continue if area.y in indices and area.value[0] == WRAP
            keep.push area

        if wrap
            for y in indices
                keep.push {x: 0 y: y value: [WRAP -1 1]}
        keep

    #  the grapheme indices where the rows of a wrapped line start
    #  word wrap breaks after a space, a word wider than the row breaks anywhere
    #  the rows after the first are indent cells narrower
    #  cols may be a function that gives the width of row k, indent is ignored then

    @wrapStarts: (line cols word indent=0) ->

        rowWidth = cols is func ? cols : (k) -> k == 0 ? cols : max(1 cols-indent)

        starts = [0]
        width  = 0
        brk    = -1
        limit  = rowWidth 0

        for gi in 0...line.length

            cw = max(1 kseg.segWidth(line[gi]))

            if width + cw > limit and gi > starts[-1]

                limit = rowWidth starts.length
                start = gi
                start = brk if word and brk > starts[-1]

                width = 0
                for i in start...gi
                    width += max(1 kseg.segWidth(line[i]))

                if width + cw > limit and gi > start
                    start = gi
                    width = 0

                starts.push start
                brk = -1

            width += cw
            brk = gi+1 if word and line[gi] in [' ' '\t']

        starts

    #  the cells the rows after the first of a wrapped line are indented by:
    #  the width of its leading whitespace and of the markers that follow it,
    #  so the rows line up with the text, but at most half the row (if cols is given)
    #  clss gives the syntax class of a grapheme, md adds the markdown markers

    @wrapIndent: (line cols clss md) ->

        gi = @skipBlanks line 0

        if clss
            while true
                n = @markerLength line gi clss md
                break if n == 0
                gi = @skipBlanks line gi+n

        indent = 0
        for i in 0...gi
            indent += max(1 kseg.segWidth(line[i]))
        ⮐ indent if not cols?
        min indent int(cols/2)

    @skipBlanks: (line gi) ->

        while gi < line.length and line[gi] in [' ' '\t']
            gi += 1
        gi

    #  the number of graphemes of the marker at gi that the text of a line follows:
    #  list bullets, headings and comment starters by their syntax class,
    #  the star of a block comment line, and in markdown quotes, bullets
    #  the highlighter leaves out (in quotes), checkboxes and numbered items

    @markerLength: (line gi clss md) ->

        ⮐ 0 if gi >= line.length

        c = clss(gi) ? ''
        words = c.split ' '

        if 'punct' in words and words.some((w) -> w == 'comment' or /^(li|h)\d$/.test(w))
            n = 1
            while gi+n < line.length and clss(gi+n) == c
                n += 1
            ⮐ n

        ⮐ 1 if 'comment' in words and line[gi] == '*'

        ⮐ 0 if not md

        ⮐ 1 if line[gi] == '>' and 'punct' in words
        ⮐ 1 if line[gi] in ['-' '*' '+'] and line[gi+1] == ' '
        ⮐ 3 if line[gi] == '[' and line[gi+1] in [' ' 'x' 'X'] and line[gi+2] == ']'

        if 'number' in words
            n = 1
            while gi+n < line.length and (clss(gi+n) ? '').split(' ').includes('number')
                n += 1
            ⮐ n+1 if line[gi+n] in ['.' ')'] and line[gi+n+1] == ' '

        0

    @desue: text ->
        lines = text.split('\n')
        clean = []
        areas = []
        for y in 0...lines.length
            line    = []
            pending = ''
            for seg in kseg(lines[y])
                [visible tags] = splitTags seg
                if not empty visible
                    collect(pending y line.length areas) if not empty pending
                    pending = ''
                    line.push visible
                pending += tags
            collect(pending y line.length areas) if not empty pending
            clean.push(line.join(''))
        {text: clean.join('\n') sue: areas}

    @ensue: text sue ->
        ⮐ text if empty sue
        lines = text.split('\n')
        for y in 0...lines.length
            mine = []
            for area in sue
                mine.push(area) if area.y == y
            continue if empty mine
            mine.sort (a b) -> a.x - b.x
            segs = kseg(lines[y])
            out = ''
            i = 0
            for x in 0..segs.length
                while i < mine.length and mine[i].x <= x
                    out += @sueEncode(mine[i].value)
                    i += 1
                out += segs[x] if x < segs.length
            while i < mine.length
                out += @sueEncode(mine[i].value)
                i += 1
            lines[y] = out
        lines.join('\n')

export sue
