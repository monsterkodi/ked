###
000000000  00000000  000   000  000000000
   000     000        000 000      000   
   000     0000000     00000       000   
   000     000        000 000      000   
   000     00000000  000   000     000   
###

use ../../../kxk ▪ kstr kutil kseg pepe
use              ◆ belt

function pair

    # ███   ███  ███   ███  ███████     ███████   ███       ███████   ███   ███   ███████  ████████  ███████  
    # ███   ███  ████  ███  ███   ███  ███   ███  ███      ███   ███  ████  ███  ███       ███       ███   ███
    # ███   ███  ███ █ ███  ███████    █████████  ███      █████████  ███ █ ███  ███       ███████   ███   ███
    # ███   ███  ███  ████  ███   ███  ███   ███  ███      ███   ███  ███  ████  ███       ███       ███   ███
    #  ███████   ███   ███  ███████    ███   ███  ███████  ███   ███  ███   ███   ███████  ████████  ███████  

    @isUnbalancedPosition: lines pos char ->
    
        revs =
            ']': '[' 
            '}': '{' 
            ')': '('
            '"': '"'
            "'": "'"

        p = pepe kseg.str(lines[pos[1]])
        start = p.unbalanced?[1..].map (s) -> s.start
        valid start and revs[char] in start
        
    #  0000000  000000000  00000000   000  000   000   0000000   
    # 000          000     000   000  000  0000  000  000        
    # 0000000      000     0000000    000  000 0 000  000  0000  
    #      000     000     000   000  000  000  0000  000   000  
    # 0000000      000     000   000  000  000   000   0000000   
    
    @isRangeInString: lines rng -> @rangeOfStringSurroundingRange(lines rng)?

    @rangeOfStringSurroundingRange: lines rng ->

        if ir = @rangeOfInnerStringSurroundingRange lines rng
            @rangeGrownBy ir 1

    @rangeOfInnerStringSurroundingRange: lines rng ->
        
        ⮐  if @isInvalidLineIndex lines rng[1]

        rgs = @rangesOfStringsInText lines[rng[1]] rng[1] 
        rgs = @rangesShrunkenBy rgs 1
        for r in rgs
            ⮐  r if @rangeContainsRange r rng
            
    @rangesOfStringsInText: text li=0 -> # todo: handle #{}
        
        rngs = []
        ss = -1
        cc = null
        for i in 0...text.length
            c = text[i]
            if not cc and c in "'\""
                cc = c
                ss = i
            else if c == cc
                if (text[i-1] != '\\') or (i>2 and text[i-2] == '\\')
                    rngs.push [ss li i+1 li]
                    cc = null
                    ss = -1
        rngs
        
    #  0000000   000   000  000000000   0000000  000  0000000    00000000      0000000  000000000  00000000   
    # 000   000  000   000     000     000       000  000   000  000          000          000     000   000  
    # 000   000  000   000     000     0000000   000  000   000  0000000      0000000      000     0000000    
    # 000   000  000   000     000          000  000  000   000  000               000     000     000   000  
    #  0000000    0000000      000     0000000   000  0000000    00000000     0000000      000     000   000  
    
    @positionsAndRangesOutsideStrings: lines rngs posl ->
        
        found = []
        
        for rng in rngs
            if not belt.isRangeInString(lines rng)
                found.push rng
                
        for pos in posl
            if not belt.isRangeInString(lines belt.rangeForPos(pos))
                found.push pos
        found
        
    # 00000000    0000000   000  00000000    0000000         0000000  000   000  00000000   00000000   0000000     0000000   
    # 000   000  000   000  000  000   000  000             000       000   000  000   000  000   000  000   000  000        
    # 00000000   000000000  000  0000000    0000000         0000000   000   000  0000000    0000000    000   000  000  0000  
    # 000        000   000  000  000   000       000             000  000   000  000   000  000   000  000   000  000   000  
    # 000        000   000  000  000   000  0000000         0000000    0000000   000   000  000   000  0000000     0000000   
    
    #  positions are display columns but pepe works on string indices, so
    #  convert between the two before and after asking pepe about a line

    @codeunitIndexForColumn: line col ->
        
        segi = kseg.segiAtWidth line col
        kseg.str(line[0...segi]).length
        
    @columnForCodeunitIndex: line cu ->
        
        n = 0
        c = 0
        for g in line
            ⮐  c if n >= cu
            n += g.length
            c += kseg.segWidth g
        c

    @rangesOfNestedPairsAtPositions: lines posl ->
        
        rngs = []
        for pos in posl
            continue if @isInvalidLineIndex lines pos[1]
            line = lines[pos[1]]
            for pair in pepe.pairsAtCol(kseg.str(line) @codeunitIndexForColumn(line pos[0]))
                rngs.push [@columnForCodeunitIndex(line pair.rng[0]) pos[1] @columnForCodeunitIndex(line pair.rng[1]) pos[1]]
        rngs

    @spansOfNestedPairsAtPositions: lines posl ->
        
        spans    = []
        brackets = []
        strings  = []
        
        for pos in posl
            continue if @isInvalidLineIndex lines pos[1]
            line = lines[pos[1]]
            for pair in pepe.pairsAtCol(kseg.str(line) @codeunitIndexForColumn(line pos[0]))
                c0 = @columnForCodeunitIndex line pair.rng[0]
                c1 = @columnForCodeunitIndex line pair.rng[1]
                open  = [c0 pos[1] c0+pair.start.length]
                close = [c1 pos[1] c1+pair.end.length]
                spans.push open
                spans.push close
                
                if pair.start in '"\''
                    strings.push open
                    strings.push close
                else
                    brackets.push open
                    brackets.push close
                
        [spans brackets strings]

    @rangesOfPairsSurroundingPositions: lines pairs posl ->
        
        rngs = []
        for pos in posl
            for pair in pairs
                if @chunkBeforePos(lines pos).endsWith(pair[0]) and @chunkAfterPos(lines pos).startsWith(pair[1])
                    rngs.push [pos[0] - pair[0].length pos[1] pos[0] + pair[1].length pos[1]]
        rngs
        
    @stringDelimiterSpansForPositions: lines posl ->
        
        spans = []
        for pos in posl
        
            if srng = @rangeOfStringSurroundingRange lines [pos[0] pos[1] pos[0] pos[1]]
                spans.push [srng[0] srng[1] srng[0]+1]
                spans.push [srng[2]-1 srng[3] srng[2]]
            else if lines[pos[1]][pos[0]] in "\"'"
                if srng = @rangeOfStringSurroundingRange lines [pos[0]+1 pos[1] pos[0]+1 pos[1]]
                    spans.push [srng[0] srng[1] srng[0]+1]
                    spans.push [srng[2]-1 srng[3] srng[2]]
        spans
        
    # 0000000    00000000    0000000    0000000  000   000  00000000  000000000  000  000   000  0000000    00000000  000   000
    # 000   000  000   000  000   000  000       000  000   000          000     000  0000  000  000   000  000        000 000
    # 0000000    0000000    000000000  000       0000000    0000000      000     000  000 0 000  000   000  0000000     00000
    # 000   000  000   000  000   000  000       000  000   000          000     000  000  0000  000   000  000        000 000
    # 0000000    000   000  000   000  0000000  000   000  00000000     000     000  000   000  0000000    00000000  000   000

    #  every bracket in the file, as [line segindex char], in ascending
    #  order.  the scans below hop between these entries instead of walking
    #  the text, which is what made the miss case cost O(filesize) per
    #  cursor per keystroke.  brackets inside strings are included - telling
    #  them apart is the caller's business.

    @bracketIndex: lines ->

        brckts = '([{}])'

        idx = []
        for line, l in lines
            for c, s in line
                idx.push [l s c] if c in brckts
        idx

    #  index of the first entry at or after (l s), or idx.length

    @indexOfBracketAtOrAfter: idx l s ->

        lo = 0
        hi = idx.length

        while lo < hi
            mid = (lo + hi) >> 1
            e = idx[mid]
            if e[0] > l or (e[0] == l and e[1] >= s)
                hi = mid
            else
                lo = mid + 1

        lo

    #  ███████   ████████   ████████  ███   ███         ███████  ███       ███████    ███████  ████████
    # ███   ███  ███   ███  ███       ████  ███        ███       ███      ███   ███  ███       ███     
    # ███   ███  ████████   ███████   ███ █ ███        ███       ███      ███   ███  ███████   ███████ 
    # ███   ███  ███        ███       ███  ████        ███       ███      ███   ███       ███  ███     
    #  ███████   ███        ████████  ███   ███         ███████  ███████   ███████   ███████   ████████

    @openCloseSpansForPositions: lines posl ->

        idx = @bracketIndex lines

        spans = []
        for pos in posl
            if sps = @openCloseSpansForPosition lines idx pos
                spans = spans.concat sps
        spans
        
    @openCloseSpansForPosition: lines idx pos ->
                
        open =
            '[': ']'
            '{': '}'
            '(': ')'
        revs =
            ']': '['
            '}': '{'
            ')': '('
            
        opns = '[{(' 
        clos = ']})' 
        
        ⮐  if @isInvalidLineIndex lines pos[1]
        
        line = lines[pos[1]]
        
        #  positions are display columns but lines are lists of graphemes,
        #  find the grapheme the cursor sits on before scanning
        
        si = kseg.segiAtWidth line pos[0]
        
        stack = []
        openEncounters = ''
        
        lastOpen      = undefined
        lastOpenLine  = pos[1]
        lastOpenIndex = -1
        
        if line[si] in opns
        
            lastOpen      = line[si]
            lastOpenLine  = pos[1]
            lastOpenIndex = si
            
            j = -1 # the cursor sits on its own opener, nothing to scan back over
            
        else
        
            j = @indexOfBracketAtOrAfter idx pos[1] si
            j -= 1
            
            while j >= 0 # find last open bracket before
                
                e = idx[j]
                prev = e[2]
                
                if prev in opns
                    if stack.length
                        if open[prev] == last(stack)
                            openEncounters += prev
                            stack.pop()
                            j -= 1
                            continue
                        else
                            ⮐  # stack mismatch
                    lastOpen      = prev
                    lastOpenLine  = e[0]
                    lastOpenIndex = e[1]
                    break
                else
                    stack.push prev
                j -= 1
        
        firstClose      = undefined
        firstCloseLine  = pos[1]
        firstCloseIndex = -1
        
        stack = []
        
        ai = si
        if line[si] in opns
            ai = si+1
        
        j = @indexOfBracketAtOrAfter idx pos[1] ai
        
        while j < idx.length # find first close bracket after
            
            e = idx[j]
            next = e[2]
            
            if next in clos
                if stack.length
                    if open[last(stack)] == next
                        stack.pop()
                    else
                        ⮐  # stack mismatch
                else
                    firstClose      = next
                    firstCloseLine  = e[0]
                    firstCloseIndex = e[1]
                    break
            else
                stack.push next

            j += 1
        
        if not lastOpen? or not firstClose?
            
            #  a cursor sitting just after a closing bracket should still
            #  highlight that pair - retry from one grapheme to the left
            
            if si-1 >= 0 and line[si-1] in clos and revs[line[si-1]] in openEncounters
                ⮐  @openCloseSpansForPosition lines idx [kseg.widthAtSegi(line si-1) pos[1]]
            ⮐
        
        if open[lastOpen] == firstClose
            oline = lines[lastOpenLine]
            cline = lines[firstCloseLine]
            oc = kseg.widthAtSegi oline lastOpenIndex
            cc = kseg.widthAtSegi cline firstCloseIndex
            ⮐  [[oc lastOpenLine oc+1] [cc firstCloseLine cc+1]]

export pair
