■jumplist
###
    remembers cursor positions before jumps
###
    @: ->

        @max     = 100
        @keep    = 0
        @entries = []
        @index   = @entries.length

    sameLine: a b ->

        ⮐ false if not valid a or not valid b

        a.file == b.file and a.y == b.y

    removeLine: entry ->

        for e,i in @entries
            if @sameLine e entry
                @entries.splice i 1
                ⮐ i

        -1

    trim: ->

        if @entries.length > @max
            @entries.splice 0 @entries.length-@max

    record: entry ->

        ⮐ false if not valid entry

        @entries = @entries[0..@index] if @index < @entries.length

        @removeLine entry

        @entries.push entry
        @trim()

        @index = @entries.length

        true

    older: current ->

        ⮐ if empty @entries

        if @index >= @entries.length
            @removeLine current
            @entries.push current
            @trim()
            @index = @entries.length - 2
            ⮐ if @index < 0
            ⮐ @entries[@index]

        ⮐ if @index <= 0

        @index -= 1

        @entries[@index]

    newer: ->

        ⮐ if @index >= @entries.length-1

        @index += 1

        @entries[@index]

export jumplist
