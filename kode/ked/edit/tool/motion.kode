###
    motions

    a motion is a plain value like {kind:'word', count:3}

    range turns one into a line range [startX startY endX endY]
    for a given position, without touching the editor state

    kinds

        char charBack   count characters after or before the cursor
        word            to the start of the count-th word after
        wend            to the end of the count-th word after
        drow            to the start of the count-th word before
        WORD WEND DROW  as above, but skips punctuation
        charFind        to the count-th occurrence of a character in the buffer,
                        or just before it, forwards or backwards
        bol eol         to the start or end of the line
        line            count lines, starting with the current one
        lineDown        current line and count lines below
        lineUp          count lines above and the current one
        textObject      an inner or around word, quoted string or bracket pair
###

use ../../../kxk ▪ kseg
use              ◆ belt

function motion

    @isLinewise: spec -> spec.kind in ['line' 'lineDown' 'lineUp']

    @mergeRanges: rngs ->

        ⮐  [] if empty rngs

        rngs.sort (a b) -> if a[1] == b[1] then a[0]-b[0] else a[1]-b[1]

        merged = []

        for rng in rngs

            if empty merged
                merged.push rng
                continue

            tail = merged[-1]

            sameLine = rng[1] == tail[3]
            overlaps = rng[1] < tail[3] or (sameLine and rng[0] < tail[2])
            touches  = sameLine and rng[0] == tail[2]

            if overlaps or touches
                if rng[3] > tail[3] or (rng[3] == tail[3] and rng[2] > tail[2])
                    tail[2] = rng[2]
                    tail[3] = rng[3]
            else
                merged.push rng

        merged

    @range: lines pos spec ->
    
        ⮐  null if empty lines

        [x y] = pos

        y     = clamp 0 lines.length-1 y
        x     = clamp 0 kseg.width(lines[y]) x
        count = max 1 (spec.count ? 1)

        switch spec.kind
            'char'          ➜ @rangeForChars        lines x y count
            'charBack'      ➜ @rangeForCharsBack    lines x y count
            'word'          ➜ @rangeForWord         lines x y count false spec.cursors
            'wend'          ➜ @rangeForWordEnd      lines x y count
            'drow'          ➜ @rangeForWordBack     lines x y count
            'WORD'          ➜ @rangeForWord         lines x y count true  spec.cursors
            'WEND'          ➜ @rangeForWordEnd      lines x y count true
            'DROW'          ➜ @rangeForWordBack     lines x y count true
            'charFind'      ➜ @rangeForCharFind     lines x y spec
            'bol'           ➜ @rangeForBol          lines x y
            'eol'           ➜ @rangeForEol          lines x y
            'line'          ➜ @rangeForLines        lines y y+count-1
            'lineDown'      ➜ @rangeForLines        lines y y+count
            'lineUp'        ➜ @rangeForLines        lines y-count y
            'textObject'    ➜ @rangeForTextObject   lines x y spec

    @rangeForChars: lines x y count ->
        width = kseg.width lines[y]
        x     = min x width
        [x y min(x+count width) y]

    @rangeForCharsBack: lines x y count ->
        x = min x kseg.width(lines[y])
        [max(0 x-count) y x y]

    @rangeForBol: lines x y ->
        [0 y min(x kseg.width(lines[y])) y]

    @rangeForEol: lines x y ->
        width = kseg.width lines[y]
        [min(x width) y width y]

    @rangeForLines: lines startLine endLine ->
        startLine = clamp 0 lines.length-1 startLine
        endLine   = clamp 0 lines.length-1 endLine
        [0 startLine kseg.width(lines[endLine]) endLine]

    @rangeForWord: lines x y count big cursors ->

        pos = [x y]

        for n in 0...count

            eol = cursors > 1
            pos = @wordStartAfter lines pos eol big

        [x y pos[0] pos[1]]

    @rangeForWordEnd: lines x y count big=false ->

        pos = [x y]

        for n in 0...count
            pos = @wordEndAfter lines pos big

        [x y pos[0] pos[1]]

    @rangeForWordBack: lines x y count big=false ->

        pos = [x y]

        for n in 0...count
            pos = @wordStartBefore lines pos big

        [pos[0] pos[1] x y]

    @charFindMatches: lines target ->

        matches = []

        for segs, y in lines
            for seg, i in segs
                if seg == target
                    matches.push [@widthAt(segs i) y]

        matches

    @charFindLanding: lines pos till forward ->

        [x y] = pos

        ⮐  [x y] if not till

        segs = lines[y]
        i    = kseg.indexAtWidth segs x

        if forward
            ⮐  null if i <= 0
            [kseg.widthAtSegi(segs, i-1) y]
        else
            [kseg.widthAtSegi(segs, i+1) y]

    @charFindLandings: lines target till forward ->

        landings = []

        for m in @charFindMatches lines target
            p = @charFindLanding lines m till forward
            landings.push p if p

        landings

    @charFindPosition: lines pos target count till forward=true ->

        [x y] = pos

        found = []

        for m in @charFindMatches lines target

            if forward
                continue if m[1] < y or (m[1] == y and m[0] <= x)
            else
                continue if m[1] > y or (m[1] == y and m[0] >= x)

            p = @charFindLanding lines m till forward

            found.push(p) if p

        ⮐  null if found.length < count

        if forward
            found[count-1]
        else
            found[found.length-count]

    @rangeForCharFind: lines x y spec ->

        target  = spec.target
        count   = max 1 (spec.count ? 1)
        till    = spec.till
        forward = spec.forward != false

        pos = @charFindPosition lines [x y] target count till forward

        ⮐  null if pos == null

        msegs = lines[pos[1]]
        mi    = kseg.indexAtWidth msegs pos[0]

        mi += 1 if forward and till
        mi -= 1 if not forward and till

        if forward
            if till
                [x y kseg.widthAtSegi(msegs, mi) pos[1]]
            else
                [x y kseg.widthAtSegi(msegs, mi+1) pos[1]]
        else
            if till
                [kseg.widthAtSegi(msegs, mi+1) pos[1] x y]
            else
                [kseg.widthAtSegi(msegs, mi) pos[1] x y]

    @category: seg ->

        if empty seg       ➜ ⮐ 'empty'
        if /\s+/.test seg  ➜ ⮐ 'ws'
        if /\w+/.test seg  ➜ ⮐ 'word'
        'punct'

    @wordCategory: seg big ->

        ⮐  'empty' if empty seg
        ⮐  'ws'    if /\s+/.test seg
        ⮐  'word'  if big
        ⮐  'word'  if /\w+/.test seg
        'punct'

    @widthAt: segs i -> kseg.widthAtSegi segs i

    @wordStartAfter: lines pos eol=false big=false ->

        [x y] = pos

        segs = lines[y]
        i    = kseg.indexAtWidth segs x

        if i < segs.length

            cat = @wordCategory segs[i] big

            if cat != 'ws'
                while i < segs.length and @wordCategory(segs[i], big) == cat
                    i += 1

            while i < segs.length and @wordCategory(segs[i], big) == 'ws'
                i += 1

            ⮐  [@widthAt(segs i) y] if i < segs.length

        ⮐  [kseg.width(segs) y] if eol

        for yy in (y+1)...lines.length

            line = lines[yy]
            j    = 0

            while j < line.length and @wordCategory(line[j], big) == 'ws'
                j += 1

            ⮐  [@widthAt(line j) yy] if j < line.length

        [kseg.width(segs) y]

    @wordEndAfter: lines pos big=false ->

        [x y] = pos

        segs = lines[y]
        i    = kseg.indexAtWidth segs x

        while true

            if i >= segs.length
                if y+1 >= lines.length
                    ⮐  [kseg.width(segs) y]
                y   += 1
                segs = lines[y]
                i    = 0
                continue

            cat = @wordCategory segs[i] big

            if cat == 'ws'
                i += 1
                continue

            j = i

            while j+1 < segs.length and @wordCategory(segs[j+1], big) == cat
                j += 1

            ⮐  [@widthAt(segs j+1) y] if j > i

            i = j+1

    @wordStartBefore: lines pos big=false ->

        [x y] = pos

        segs = lines[y]
        i    = kseg.indexAtWidth segs x

        while true

            if i <= 0
                ⮐  [0 0] if y <= 0
                y   -= 1
                segs = lines[y]
                i    = segs.length
                continue

            i -= 1

            cat = @wordCategory segs[i] big

            continue if cat == 'ws'

            while i > 0 and @wordCategory(segs[i-1], big) == cat
                i -= 1

            ⮐  [@widthAt(segs i) y]

    @objectX: lines y x ->
        segs  = lines[y]
        width = kseg.width segs
        if width > 0 and x >= width
            ⮐  @widthAt(segs segs.length-1)
        clamp 0 width x

    @widthAtOrEnd: segs i ->
        if i >= segs.length
            ⮐  kseg.width segs
        @widthAt(segs i)

    @isEscaped: segs i ->
        n = 0
        j = i-1
        while j >= 0 and segs[j] == '\\'
            n += 1
            j -= 1
        n % 2 == 1

    @rangeForTextObject: lines x y spec ->

        count = max 1 (spec.count ? 1)
        area  = spec.area ? 'inner'
        x     = @objectX lines y x

        switch spec.target
            'word' ➜ @rangeForWordObject lines x y count (area == 'inner') false
            'WORD' ➜ @rangeForWordObject lines x y count (area == 'inner') true
            else   ➜ @rangeForPairObject lines x y spec.target (area == 'inner')

    @wordBoundsAt: segs i big=false ->

        cat = @wordCategory segs[i] big
        s   = i
        e   = i

        while s > 0 and @wordCategory(segs[s-1], big) == cat
            s -= 1

        while e+1 < segs.length and @wordCategory(segs[e+1], big) == cat
            e += 1

        [s e+1]

    @trailingWsEnd: segs i ->
        e = i
        while e < segs.length and @category(segs[e]) == 'ws'
            e += 1
        e

    @leadingWsStart: segs i ->
        s = i
        while s > 0 and @category(segs[s-1]) == 'ws'
            s -= 1
        s

    @nextWordAfterIndex: lines y i big=false ->

        while true

            segs = lines[y]

            while i < segs.length and @wordCategory(segs[i], big) == 'ws'
                i += 1

            if i < segs.length
                [s e] = @wordBoundsAt segs i big
                ⮐  [y s e]

            if y+1 >= lines.length
                ⮐  null

            y += 1
            i  = 0

    @rangeForWordObject: lines x y count inner big=false ->

        segs = lines[y]

        ⮐  if empty segs

        i = kseg.indexAtWidth segs x
        i = segs.length-1 if i >= segs.length

        if @wordCategory(segs[i], big) == 'ws'

            if inner
                s = @leadingWsStart segs i
                e = @trailingWsEnd segs i
                ⮐  [@widthAt(segs s) y @widthAtOrEnd(segs e) y]

            next = @nextWordAfterIndex lines y i big

            if not next
                s = @leadingWsStart segs i
                e = @trailingWsEnd segs i
                ⮐  [@widthAt(segs s) y @widthAtOrEnd(segs e) y]

            [wy ws we] = next
            ⮐  @rangeForWords lines wy ws we count true big

        [s e] = @wordBoundsAt segs i big

        @rangeForWords lines y s e count (not inner) big

    @rangeForWords: lines y s e count around big=false ->

        firstLine  = y
        firstStart = s
        lastLine   = y
        lastEnd    = e

        for n in 1...count
            next = @nextWordAfterIndex lines lastLine lastEnd big
            break if not next
            [nl ns ne] = next
            lastLine = nl
            lastEnd  = ne

        if not around
            ⮐  [@widthAt(lines[firstLine] firstStart) firstLine @widthAt(lines[lastLine] lastEnd) lastLine]

        lastSegs = lines[lastLine]
        tEnd     = @trailingWsEnd lastSegs lastEnd

        if tEnd > lastEnd
            ⮐  [@widthAt(lines[firstLine] firstStart) firstLine @widthAtOrEnd(lastSegs tEnd) lastLine]

        firstSegs = lines[firstLine]
        lStart    = @leadingWsStart firstSegs firstStart

        [@widthAt(firstSegs lStart) firstLine @widthAtOrEnd(lastSegs lastEnd) lastLine]

    @rangeForPairObject: lines x y target inner ->

        opens =
            ')': '('
            ']': '['
            '}': '{'
            'b': '('
            'B': '{'

        closes =
            '(': ')'
            '[': ']'
            '{': '}'

        open  = opens[target] ? target

        if open == '"' or open == "'"
            ⮐  @rangeForQuoteObject lines x y open inner

        ⮐  null if not closes[open]

        @rangeForBracketObject lines x y open inner

    @rangeForQuoteObject: lines x y quote inner ->

        segs = lines[y]

        ⮐  null if empty segs

        xi = kseg.indexAtWidth segs x
        xi = segs.length-1 if xi >= segs.length

        pairs = []
        open  = -1

        for seg, i in segs

            continue if seg != quote
            continue if @isEscaped segs i

            if open < 0
                open = i
            else
                pairs.push [open i]
                open = -1

        ⮐  null if empty pairs

        chosen = null

        for pair in pairs
            if pair[0] <= xi and xi <= pair[1]
                chosen = pair
                break

        if not chosen
            for pair in pairs
                if pair[0] > xi
                    chosen = pair
                    break

        ⮐  null if not chosen

        [o c] = chosen

        if inner
            ⮐  [@widthAt(segs o+1) y @widthAt(segs c) y]

        tEnd = @trailingWsEnd segs c+1

        if tEnd > c+1
            ⮐  [@widthAt(segs o) y @widthAtOrEnd(segs tEnd) y]

        lStart = @leadingWsStart segs o

        [@widthAt(segs lStart) y @widthAtOrEnd(segs c+1) y]

    @flatChars: lines ->

        chars = []

        for line, li in lines
            w = 0
            for seg in line
                chars.push [seg li w]
                w += kseg.segWidth seg

        chars

    @pairSpansForPosition: lines x y open ->

        spans = belt.pairSpansAtPosition lines [x y] open

        ⮐  spans if spans

        for ch in @flatChars lines
            [c li w] = ch

            continue if li < y or (li == y and w < x)
            continue if c != open
            continue if belt.isRangeInString lines [w li w+1 li]

            spans = belt.pairSpansAtPosition lines [w li] open

            if spans and spans[0][0] == w and spans[0][1] == li
                ⮐  spans

        null

    @rangeForBracketObject: lines x y open inner ->

        spans = @pairSpansForPosition lines x y open

        ⮐  null if not spans

        [osp csp] = spans

        if inner
            [osp[2] osp[1] csp[0] csp[1]]
        else
            [osp[0] osp[1] csp[2] csp[1]]

export motion
