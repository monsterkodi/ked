■changelist
###
    remembers the cursor positions of text changes

    older and newer walk the list for g; and g,

    changes close to each other on the same line keep only the last position.
    a third element names the sheet text node the position is in
###
    @: ->

        @max      = 100
        @distance = 79
        @entries  = []
        @index    = @entries.length

    tooClose: a b ->

        ⮐ false if not valid a or not valid b

        a[2] == b[2] and a[1] == b[1] and abs(a[0]-b[0]) < @distance

    record: pos ->

        ⮐ false if not valid pos

        previous = @entries[-1]

        if @tooClose previous pos
            previous[0] = pos[0]
            previous[1] = pos[1]
        else
            entry = [pos[0] pos[1]]
            entry.push pos[2] if pos[2]?
            @entries.push entry
            @entries.splice 0 @entries.length-@max if @entries.length > @max

        @index = @entries.length

        true

    #  drops the entries fn doesn't keep, the index stays at its entry

    retain: fn ->

        before = @entries.filter((e,i) => i < @index and not fn(e)).length
        @entries = @entries.filter fn
        @index = max 0 @index-before

    older: ->

        ⮐ if @index <= 0

        @index -= 1

        @entries[@index]

    newer: ->

        ⮐ if @index >= @entries.length-1

        @index += 1

        @entries[@index]

    reset: ->

        @entries = []
        @index   = 0

        true

export changelist
