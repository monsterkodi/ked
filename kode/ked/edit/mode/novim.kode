###
███   ███   ███████   ██     ██  ███  ███   ███
████  ███  ███   ███  ███   ███  ███  ████ ████
███ █ ███  ███   ███  █████████  ███  ███ █ ███
███  ████  ███   ███  ███ █ ███  ███  ███  ████
███   ███   ███████   ███   ███  ███  ███   ███

vi style commands
swallows text input while active and maps keys to actions
actions are logged for now, the buffer is not modified
###

use ../../theme ◆ color

function novim

    # operators start a pending command, d is delete
    @operators:
        d: 'delete'

    # standalone delete commands
    @commands:
        x: (n) -> novim.plural n 'character' 'characters'
        X: (n) -> novim.plural(n 'character' 'characters') + ' before'
        D: -> 'to end of line'

    # motions complete a pending operator
    # each motion receives the count and returns the action description
    @motions:
        d: (n) -> novim.plural n 'line' 'lines'
        w: (n) -> novim.plural n 'word' 'words'
        e: (n) -> 'to end of ' + novim.plural(n 'word' 'words')
        b: (n) -> novim.plural(n 'word' 'words') + ' back'
        '0': -> 'to start of line'
        '$': -> 'to end of line'
        j: (n) -> novim.plural(n 'line' 'lines') + ' down'
        k: (n) -> novim.plural(n 'line' 'lines') + ' up'

    @plural: n one many -> if n == 1 then one else "#{n} #{many}"

    @: @state ->

        @name = 'novim'
        @reset()

    reset: ->

        @count = ''
        @operator = null

    countNumber: -> if empty @count then 1 else parseInt @count

    logPending: ->

        count = @count ? ''
        count += ' ' if count
        log "#{novim.operators[@operator]} #{count}..."

    complete: motion ->

        n = @countNumber()
        log "#{novim.operators[@operator]} #{motion(n)}"
        @reset()

    # ███   ███  ████████  ███   ███
    # ███  ███   ███        ███ ███
    # ███████    ███████     █████
    # ███  ███   ███          ███
    # ███   ███  ████████     ███

    handleKey: key event ->

        combo = event.combo ? key
        char  = valid(event.char) ? event.char : combo

        # let global shortcuts through, at least the one that leaves this mode
        if combo.includes('alt+') or combo.includes('ctrl+') or combo.includes('cmd+')
            ⮐  'unhandled'

        if combo in ['esc' 'escape']
            @reset()
            ⮐  true

        # swallow every other non text key
        ⮐  true if char.length != 1

        if @operator

            if motion = novim.motions[char]
                @complete motion
            else if char in '0123456789'
                @count += char
                @logPending()
            else
                @reset()

        else if novim.operators[char]

            @operator = char
            @logPending()

        else if command = novim.commands[char]

            log "delete #{command(@countNumber())}"
            @reset()

        else if char in '0123456789'

            @count += char

        # swallow all other input until more commands are implemented
        true

    #  ███████   ███████   ███       ███████   ████████
    # ███       ███   ███  ███      ███   ███  ███   ███
    # ███       ███   ███  ███      ███   ███  ███████
    # ███       ███   ███  ███      ███   ███  ███   ███
    #  ███████   ███████   ███████   ███████   ███   ███

    themeColor: colorName defaultColor ->

        switch colorName
            'cursor.multi' ➜ ⮐  color.values '#c00000' # medium red
            'cursor.main'  ➜ ⮐  color.values '#ff3030' # bright red

        defaultColor

export novim
