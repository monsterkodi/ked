###
███   ███   ███████   ██     ██  ███  ███   ███
████  ███  ███   ███  ███   ███  ███  ████ ████
███ █ ███  ███   ███  █████████  ███  ███ █ ███
███  ████  ███   ███  ███ █ ███  ███  ███  ████
███   ███   ███████   ███   ███  ███  ███   ███

vi style commands
swallows text input while active and maps keys to actions
an action is a command value executed by edit▸act▸novim
###

use ../../theme ◆ color

function novim

    # operators start a pending command, d is delete
    @operators:
        d: 'delete'

    # standalone commands
    # deletes carry an implicit motion, the others move or undo
    @commands:
        x: (n) -> { operator: 'delete', motion: { kind: 'char'     count: n } }
        X: (n) -> { operator: 'delete', motion: { kind: 'charBack' count: n } }
        D: -> { operator: 'delete', motion: { kind: 'eol' } }
        h: (n) -> { operator: 'move',   motion: { kind: 'left'  count: n } }
        j: (n) -> { operator: 'move',   motion: { kind: 'down'  count: n } }
        k: (n) -> { operator: 'move',   motion: { kind: 'up'    count: n } }
        l: (n) -> { operator: 'move',   motion: { kind: 'right' count: n } }
        u: (n) -> { operator: 'undo',   count: n }

    # motions complete a pending operator
    # each receives the count and returns a motion value
    @motions:
        d: (n) -> { kind: 'line'     count: n }
        w: (n) -> { kind: 'word'     count: n }
        e: (n) -> { kind: 'wordEnd'  count: n }
        b: (n) -> { kind: 'wordBack' count: n }
        '0': -> { kind: 'bol' }
        '$': -> { kind: 'eol' }
        j: (n) -> { kind: 'lineDown' count: n }
        k: (n) -> { kind: 'lineUp'   count: n }

    @: @state ->

        @name = 'novim'
        @reset false

    reset: announce=true ->

        @count = ''
        @operator = null
        log 'novim reset' if announce

    resetOrExit: ->

        if @operator or @count
            @reset()
        else
            log 'novim exit'
            @state.stopMode 'novim'

    countNumber: -> if empty @count then 1 else parseInt @count

    logPending: ->

        log 'novim pending ▸' @operator @count

    complete: spec ->

        operator = novim.operators[@operator]

        @execute { operator: operator, motion: spec(@countNumber()) }
        @reset false

    execute: cmd -> @state.executeNovim cmd

    # ███   ███  ████████  ███   ███
    # ███  ███   ███        ███ ███
    # ███████    ███████     █████
    # ███  ███   ███          ███
    # ███   ███  ████████     ███

    handleKey: key event ->

        combo = event.combo ? key
        char  = valid(event.char) ? event.char : combo

        # let global shortcuts through, at least the one that leaves this mode
        if combo.includes('alt+') or combo.includes('ctrl+') or combo.includes('cmd+')
            ⮐  'unhandled'

        if combo in ['esc' 'escape']
            @resetOrExit()
            ⮐  true

        # arrow keys move the cursor, unless an operator is pending
        if char in ['left' 'right' 'up' 'down']
            if @operator
                @reset()
            else
                @execute { operator: 'move', motion: { kind: char, count: @countNumber() } }
                @reset false
            ⮐  true

        # swallow every other non text key
        ⮐  true if char.length != 1

        if @operator

            if build = novim.motions[char]
                @complete build
            else if char in '0123456789'
                @count += char
                @logPending()
            else
                @reset()

        else if novim.operators[char]

            @operator = char
            @logPending()

        else if command = novim.commands[char]

            @execute command(@countNumber())
            @reset false

        else if char in '0123456789'

            @count += char

        # swallow all other input until more commands are implemented
        true

    #  ███████   ███████   ███       ███████   ████████
    # ███       ███   ███  ███      ███   ███  ███   ███
    # ███       ███   ███  ███      ███   ███  ███████
    # ███       ███   ███  ███      ███   ███  ███   ███
    #  ███████   ███████   ███████   ███████   ███   ███

    themeColor: colorName defaultColor ->

        switch colorName
            'cursor.multi' ➜ ⮐  color.values '#c00000' # medium red
            'cursor.main'  ➜ ⮐  color.values '#ff3030' # bright red

        defaultColor

export novim
