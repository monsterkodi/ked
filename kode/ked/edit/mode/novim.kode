###
███   ███   ███████   ██     ██  ███  ███   ███
████  ███  ███   ███  ███   ███  ███  ████ ████
███ █ ███  ███   ███  █████████  ███  ███ █ ███
███  ████  ███   ███  ███ █ ███  ███  ███  ████
███   ███   ███████   ███   ███  ███  ███   ███

vi style commands
swallows text input while active and maps keys to actions
an action is a command value executed by edit▸act▸novim
###

use ../../theme ◆ color

function novim

    # operators start a pending command
    @operators:
        d: 'delete'
        y: 'yank'

    # arrow keys mean the same as these
    @arrows:
        left:  'h'
        right: 'l'
        up:    'k'
        down:  'j'

    # i and a start a text object, these are the objects they know
    @areas:
        i: 'inner'
        a: 'around'

    @textObjects:
        w: 'word'
        '"': '"'
        "'": "'"
        '(': '('
        ')': '('
        b: '('
        '[': '['
        ']': '['
        '{': '{'
        '}': '{'
        B: '{'

    # standalone commands
    # deletes carry an implicit motion, the others move, undo or repeat
    @commands:
        x: (n) -> { operator: 'delete', motion: { kind: 'char'     count: n } }
        X: (n) -> { operator: 'delete', motion: { kind: 'charBack' count: n } }
        D: -> { operator: 'delete', motion: { kind: 'eol' } }
        h: (n) -> { operator: 'move',   motion: { kind: 'left'  count: n } }
        j: (n) -> { operator: 'move',   motion: { kind: 'down'  count: n } }
        k: (n) -> { operator: 'move',   motion: { kind: 'up'    count: n } }
        l: (n) -> { operator: 'move',   motion: { kind: 'right' count: n } }
        '$': (n) -> { operator: 'move', motion: { kind: 'eol'   count: n } }
        G:   (n) -> { operator: 'move', motion: { kind: 'eof'   count: n } }
        p:   (n) -> { operator: 'put',  count: n, after: true  }
        P:   (n) -> { operator: 'put',  count: n, after: false }
        u: (n) -> { operator: 'undo',   count: n }
        '.': (n) -> { operator: 'repeat', count: n }

    # motions complete a pending operator
    # each receives the count and returns a motion value
    @motions:
        d: (n) -> { kind: 'line'     count: n }
        y: (n) -> { kind: 'line'     count: n }
        w: (n) -> { kind: 'word'     count: n }
        e: (n) -> { kind: 'wordEnd'  count: n }
        b: (n) -> { kind: 'wordBack' count: n }
        '0': -> { kind: 'bol' }
        '$': -> { kind: 'eol' }
        h: (n) -> { kind: 'charBack' count: n }
        l: (n) -> { kind: 'char'     count: n }
        j: (n) -> { kind: 'lineDown' count: n }
        k: (n) -> { kind: 'lineUp'   count: n }

    @: @state ->

        @name = 'novim'
        @reset false

    reset: announce=true ->

        @count    = ''
        @operator = null
        @area     = null
        @prefix   = null
        log 'novim reset' if announce

    resetOrExit: ->

        if @operator or @count or @prefix
            @reset()
        else
            log 'novim exit'
            @state.stopMode 'novim'

    countNumber: -> if empty @count then 1 else parseInt @count

    logPending: ->

        log 'novim pending ▸' @operator @area @prefix @count

    complete: build ->

        operator = novim.operators[@operator]

        @execute { operator: operator, motion: build(@countNumber()) }
        @reset false

    completeTextObject: target ->

        area     = @area
        operator = novim.operators[@operator]

        @execute { operator: operator, motion: { kind: 'textObject', area: area, target: target, count: @countNumber() } }
        @reset false

    execute: cmd -> @state.executeNovim cmd

    # ███   ███  ████████  ███   ███
    # ███  ███   ███        ███ ███
    # ███████    ███████     █████
    # ███  ███   ███          ███
    # ███   ███  ████████     ███

    handleKey: key event ->

        combo = event.combo ? key
        char  = valid(event.char) ? event.char : combo

        # let global shortcuts through, at least the one that leaves this mode
        if combo.includes('alt+') or combo.includes('ctrl+') or combo.includes('cmd+')
            ⮐  'unhandled'

        if combo in ['esc' 'escape']
            @resetOrExit()
            ⮐  true

        # arrows mean the same as h j k l
        if arrow = novim.arrows[char]
            char = arrow

        # swallow every other non text key
        ⮐  true if char.length != 1

        # gg is two keys, the first one only remembers itself
        if @prefix

            prefix  = @prefix
            @prefix = null

            if prefix == 'g' and char == 'g'
                @execute { operator: 'move', motion: { kind: 'bof', count: @countNumber() } }
                @reset false
            else
                @reset()

            ⮐  true

        if @area

            if target = novim.textObjects[char]
                @completeTextObject target
            else
                @reset()

        else if @operator

            if build = novim.motions[char]
                @complete build
            else if area = novim.areas[char]
                @area = area
                @logPending()
            else if char in '0123456789'
                @count += char
                @logPending()
            else
                @reset()

        else if novim.operators[char]

            @operator = char
            @logPending()

        else if char == 'g'

            @prefix = 'g'
            @logPending()

        else if command = novim.commands[char]

            @execute command(@countNumber())
            @reset false

        else if char in '0123456789'

            # a lone 0 is a motion, after a count it is a digit
            if char == '0' and empty @count
                @execute { operator: 'move', motion: { kind: 'bol' } }
                @reset false
            else
                @count += char

        # swallow all other input until more commands are implemented
        true

    #  ███████   ███████   ███       ███████   ████████
    # ███       ███   ███  ███      ███   ███  ███   ███
    # ███       ███   ███  ███      ███   ███  ███████
    # ███       ███   ███  ███      ███   ███  ███   ███
    #  ███████   ███████   ███████   ███████   ███   ███

    themeColor: colorName defaultColor ->

        switch colorName
            'cursor.multi' ➜ ⮐  color.values '#c00000' # medium red
            'cursor.main'  ➜ ⮐  color.values '#ff3030' # bright red

        defaultColor

export novim
