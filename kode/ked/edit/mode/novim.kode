###
███   ███   ███████   ███   ███  ███  ██     ██
████  ███  ███   ███  ███   ███  ███  ███   ███
███ █ ███  ███   ███   ███ ███   ███  █████████
███  ████  ███   ███     ███     ███  ███ █ ███
███   ███   ███████       █      ███  ███   ███

swallows text input while active and maps keys 
to actions which are executed by edit▸act▸novim
###

use ../../../kxk ◆ post keyinfo
use ../../theme  ◆ theme

function novim

    @operators:
        c: 'change'
        d: 'delete'
        y: 'yank'
        '>': 'indent'
        '<': 'deindent'

    @arrows:
        left:  'h'
        right: 'l'
        up:    'k'
        down:  'j'

    @areas:
        i:      'inner'
        a:      'around'

    @textObjects:
        'w':    'word'
        'W':    'WORD'
        '"':    '"'
        "'":    "'"
        '(':    '('
        ')':    '('
        'b':    '('
        '[':    '['
        ']':    '['
        '{':    '{'
        '}':    '{'
        'B':    '{'

    @commands: {
        'C':      -> { operator: 'change'                    motion: { kind: 'eol'      } }
        'D':      -> { operator: 'delete'                    motion: { kind: 'eol'      } }
        's':    n -> { operator: 'change'       count: n     motion: { kind: 'char'     } }
        'S':    n -> { operator: 'change'       count: n     motion: { kind: 'line'     } }
        'x':    n -> { operator: 'delete'       count: n     motion: { kind: 'char'     } }
        'X':    n -> { operator: 'delete'       count: n     motion: { kind: 'charBack' } }
        'h':    n -> { operator: 'move'         count: n     motion: { kind: 'left'     } }
        'j':    n -> { operator: 'move'         count: n     motion: { kind: 'down'     } }
        'k':    n -> { operator: 'move'         count: n     motion: { kind: 'up'       } }
        'l':    n -> { operator: 'move'         count: n     motion: { kind: 'right'    } }
        '(':    n -> { operator: 'move'         count: n     motion: { kind: 'sentenceBack' } }
        ')':    n -> { operator: 'move'         count: n     motion: { kind: 'sentence' } }
        '{':    n -> { operator: 'move'         count: n     motion: { kind: 'paragraphBack' } }
        '}':    n -> { operator: 'move'         count: n     motion: { kind: 'paragraph' } }
        '+':    n -> { operator: 'move'         count: n     motion: { kind: 'lineFirstDown' } }
        '-':    n -> { operator: 'move'         count: n     motion: { kind: 'lineFirstUp' } }
        '_':    n -> { operator: 'move'         count: n     motion: { kind: 'lineFirst' } }
        'w':    n -> { operator: 'move'         count: n     motion: { kind: 'word'     } }
        'b':    n -> { operator: 'move'         count: n     motion: { kind: 'drow'     } }
        'e':    n -> { operator: 'move'         count: n     motion: { kind: 'wend'     } }
        'W':    n -> { operator: 'move'         count: n     motion: { kind: 'WORD'     } }
        'B':    n -> { operator: 'move'         count: n     motion: { kind: 'DROW'     } }
        'E':    n -> { operator: 'move'         count: n     motion: { kind: 'WEND'     } }
        '$':    n -> { operator: 'move'         count: n     motion: { kind: 'eol'      } }
        'G':    n -> { operator: 'move'         count: n     motion: { kind: 'eof'      } }
        'n':    n -> { operator: 'searchNext'   count: n     text:  novim.lastVind }
        'N':    n -> { operator: 'searchPrev'   count: n     text:  novim.lastVind }
        'p':    n -> { operator: 'put'          count: n     after: true  }
        'P':    n -> { operator: 'put'          count: n     after: false }
        'u':    n -> { operator: 'undo'         count: n }
        '.':    n -> { operator: 'repeat'       count: n } 
        'Y':    n -> { operator: 'yank'         motion: { kind: 'line', count: n } }
        'o':    n -> { operator: 'openLine'     count: n  after: true  }
        'O':    n -> { operator: 'openLine'     count: n  after: false }
        'I':      -> { operator: 'insertAtIndent' }
        '~':    n -> { operator: 'toggleCase'   count: n }
        'J':    n -> { operator: 'joinLinesVim' count: n }
        '%':      -> { operator: 'matchBracket' }
        '*':    n -> { operator: 'searchWord'   count: n  forward: true  }
        '#':    n -> { operator: 'searchWord'   count: n  forward: false }
        'r':  n c -> { operator: 'replace'      count: n  char: c ? '' }
        }

    @exCommands: {
        'q':   { desc: 'quit, fail if there are pending changes'       run: 'exQuit'      arg: false }
        'q!':  { desc: 'quit discarding pending changes'               run: 'exQuitForce' arg: false }
        'w':   { desc: 'write the buffer'                              run: 'exWrite' }
        'w!':  { desc: 'write the buffer, overriding a refusal'        run: 'exWrite' }
        'wa':  { desc: 'write all buffers with pending changes'        run: 'exWriteAll'  arg: false }
        'wq':  { desc: 'write the buffer and quit'                     run: 'exWriteAndQuit' }
        'wq!': { desc: 'write the buffer and quit, overriding a refusal' run: 'exWriteAndQuit' }
        'x':   { desc: 'write if changed, then quit'                   run: 'exWriteIfChangedAndQuit' }
        'x!':  { desc: 'write if changed, then quit, overriding a refusal' run: 'exWriteIfChangedAndQuit' }
        }

    @motions: {
        '0':      -> { kind: 'bol' }
        '$':      -> { kind: 'eol' }
        '>':    n -> { kind: 'line'             count: n }
        '<':    n -> { kind: 'line'             count: n }
        'c':    n -> { kind: 'line'             count: n }
        'd':    n -> { kind: 'line'             count: n }
        'y':    n -> { kind: 'line'             count: n }
        'w':    n -> { kind: 'word'             count: n }
        'e':    n -> { kind: 'wend'             count: n }
        'b':    n -> { kind: 'drow'             count: n }
        'W':    n -> { kind: 'WORD'             count: n }
        'E':    n -> { kind: 'WEND'             count: n }
        'B':    n -> { kind: 'DROW'             count: n }
        'h':    n -> { kind: 'charBack'         count: n }
        'l':    n -> { kind: 'char'             count: n }
        'j':    n -> { kind: 'lineDown'         count: n }
        'k':    n -> { kind: 'lineUp'           count: n }
        '(':    n -> { kind: 'sentenceBack'     count: n }
        ')':    n -> { kind: 'sentence'         count: n }
        '{':    n -> { kind: 'paragraphBack'    count: n }
        '}':    n -> { kind: 'paragraph'        count: n }
        '+':    n -> { kind: 'lineFirstDown'    count: n }
        '-':    n -> { kind: 'lineFirstUp'      count: n }
        '_':    n -> { kind: 'lineFirst'        count: n }
        }

    @lastVind: ''
    
    @: @state ->

        @name     = 'novim'
        @lastFind = null
        @reset()
        
        post.on 'vinder.text' (text) => novim.lastVind = text

    @clipboardSync: null # on in ked, off in a headless editor

    @isHeadless: ->

        screen = global.ked_screen

        ⮐ true if not screen
        ⮐ true if screen.t and screen.t.headless
        false

    @clipboardEnabled: ->

        if novim.clipboardSync == null
            ⮐  not novim.isHeadless()

        novim.clipboardSync

    @toggleClipboard: ->

        enabled = not novim.clipboardEnabled()

        novim.clipboardSync = enabled

        enabled

    reset: ->

        @count           = ''
        @operator        = null
        @area            = null
        @prefix          = null
        @register        = null
        @registerPending = false
        @find            = null
        @replace         = null
        @ex              = null
        @logPending()
        true

    exitNovim: ->
        
        @state.stopMode 'novim'
        true

    countNumber: -> empty @count ? 1 : parseInt(@count)

    logPending: ->
    
        t = ''
        t += @operator if @operator 
        t += @area[0] if @area 
        t += @prefix if @prefix 
        t += @count if @count 
        t += @register if @register 
        t += @find if @find 
        t += 'r' if @replace
        t += ':' + @ex if @ex?
    
        post.emit 'title.novim' t
        true

    complete: build ->

        operator = novim.operators[@operator]

        @execute { operator: operator, motion: build(@countNumber()) }

    completeTextObject: target ->

        area     = @area
        operator = novim.operators[@operator]

        @execute { operator: operator, motion: { kind: 'textObject', area: area, target: target, count: @countNumber() } }

    completeFind: target ->

        till    = @find in ['t' 'T']
        forward = @find in ['f' 't']

        @lastFind = { target: target, till: till, forward: forward }

        motion = { kind: 'charFind', target: target, till: till, forward: forward, count: @countNumber() }

        if @operator
            @execute { operator: novim.operators[@operator], motion: motion }
        else
            @execute { operator: 'move', motion: motion }

    completeReplace: char ->

        @execute novim.commands['r'](@countNumber() char)

    repeatFind: reverse=false ->

        ⮐  if not @lastFind

        forward = reverse ? not @lastFind.forward : @lastFind.forward

        motion = { kind: 'charFind', target: @lastFind.target, till: @lastFind.till, forward: forward, count: @countNumber(), repeat: true }

        if @operator
            @execute { operator: novim.operators[@operator], motion: motion }
        else
            @execute { operator: 'move', motion: motion }

    execute: cmd ->

        if @register
            cmd.register = @register

        @state.executeNovim cmd
        @reset()

    runEx: ->

        line = @ex

        @reset()

        ⮐  true if empty line

        [name file] = novim.splitEx line

        cmd = novim.exCommands[name]

        if not cmd
            post.emit 'title.novim' "E492: #{name}"
            ⮐  false

        if cmd.arg == false and file?
            post.emit 'title.novim' "E488: Trailing characters: #{file}"
            ⮐  false

        @[cmd.run] file

        true

    @splitEx: (line) ->

        line = line.trim()
        idx  = line.search /\s/

        ⮐ [line null] if idx < 0

        [line[0...idx] line[idx..].trim()]

    exQuit: ->

        if @state.isDirty()
            post.emit 'title.novim' 'E37: No write since last change (add ! to override)'
            ⮐  false

        post.emit 'quit'
        true

    exQuitForce: ->

        post.emit 'quit'
        true

    exWrite: file ->

        ⮐  false if not @exFileIsPath file

        post.emit 'file.save', file
        true

    exWriteAll: ->

        post.emit 'file.save' if @state.isDirty()
        true

    exWriteAndQuit: file ->

        ⮐  false if not @exFileIsPath file

        post.emit 'file.saveAndQuit', file
        true

    exWriteIfChangedAndQuit: file ->

        ⮐  false if not @exFileIsPath file

        if @state.isDirty()
            post.emit 'file.saveAndQuit', file
        else
            post.emit 'quit'
        true

    #  a leading ! means 'pipe to a shell command', which is not supported
    #  yet. refuse instead of writing a file whose name starts with !
    
    exFileIsPath: file ->

        ⮐  true if not file?.startsWith '!'

        post.emit 'title.novim' 'E492: shell commands are not supported'
        false

    handleExKey: combo char ->

        if combo in ['esc' 'escape']
            ⮐ @reset()

        if combo in ['return' 'enter']
            @runEx()
            ⮐ true

        if combo in ['backspace' 'delete' 'ctrl+h']
            @ex = @ex[0...-1] if @ex.length
            ⮐ @logPending()

        if char.length == 1 and char not in ['\n' '\r' '\t']
            @ex += char
            @logPending()

        true

    # ███   ███  ████████  ███   ███
    # ███  ███   ███        ███ ███
    # ███████    ███████     █████
    # ███  ███   ███          ███
    # ███   ███  ████████     ███

    handleKey: key event ->

        combo = event.combo ? key
        char  = valid(event.char) ? event.char : combo

        if combo == 'ctrl+v'
            if not @operator and not @area
                @state.startVisual 'block'
            ⮐ @reset()

        # let global shortcuts through, at least the one that leaves this mode
        if combo.includes('alt+') or combo.includes('ctrl+') or combo.includes('cmd+')
            ⮐ 'unhandled'

        if @ex?
            @handleExKey combo char
            ⮐ true

        if combo in ['esc' 'escape']
            @reset()
            if @state.visual
                @state.stopVisual()
            else if @state.hasCursorsHighlightsOrSelections()
                @state.clearCursorsHighlightsAndSelections()
            else
                @exitNovim()
            ⮐ true

        if not @find and char not in ',;nN0123456789' and key not in keyinfo.modifierNames
            @state.setHighlights [] 

        if @find
            # log "novim.find #{char} -- #{event.char} #{combo} #{key}" 
            if char.length == 1
                @completeFind char
            else if key != 'shift'
                @reset()
            ⮐ true

        if @replace
            if char.length == 1
                ⮐ @completeReplace char
            else if key != 'shift'
                ⮐ @reset()
            ⮐ true

        if arrow = novim.arrows[char]
            char = arrow

        if @registerPending
            @registerPending = false

            # " selects the next register, + and * mean the system clipboard
            if char in ['+' '*']
                @register = 'clipboard'
            else if char in ['"' '0']
                @register = null
            else
                ⮐ @reset()

            ⮐ @logPending()

        ⮐ 'unhandled' if char.length != 1 # ignore every other non text key

        if @state.visual and not @operator and not @area

            switch char
                'v'     ➜ @state.startVisual 'char' ; ⮐ @reset()
                'V'     ➜ @state.startVisual 'line' ; ⮐ @reset()
                'd' 'x' ➜ ⮐ @execute { operator: 'visualDelete' }
                'y'     ➜ ⮐ @execute { operator: 'visualYank' }
                'c' 's' ➜ ⮐ @execute { operator: 'visualChange' }
                'o'     ➜ ⮐ @execute { operator: 'visualSwap' }
                '>'     ➜ ⮐ @execute { operator: 'visualIndent',   count: @countNumber() }
                '<'     ➜ ⮐ @execute { operator: 'visualDeindent', count: @countNumber() }
                'I'     ➜ ⮐ @execute { operator: 'visualBlockPrepend' } if @state.visual == 'block'
                'A'     ➜ ⮐ @execute { operator: 'visualBlockAppend' }  if @state.visual == 'block'
                    
            if area = novim.areas[char]
                @area = area
                ⮐ @logPending()

        if not @operator and not @area

            if char == 'v'
                @state.startVisual 'char'
                ⮐ @reset()

            if char == 'V'
                @state.startVisual 'line'
                ⮐ @reset()

            if char == ':' and not @state.visual
                @reset()
                @ex = ''
                ⮐ @logPending()

        if 
            @prefix # gg 
            
                prefix  = @prefix
                @prefix = null
                if prefix == 'g' and char == 'g'
                    ⮐ @execute { operator: 'move', motion: { kind: 'bof', count: @countNumber() } }
                # @reset()
 
            @area
    
                if target = novim.textObjects[char]
                    if @state.visual
                        ⮐ @execute { operator: 'visualTextObject', motion: { kind: 'textObject', area: @area, target: target, count: @countNumber() } }
                    else
                        @completeTextObject target
                else
                    @reset() # needed?
    
            @operator
    
                if  
                    build = novim.motions[char]
                        @complete build
                    char in ['f' 't' 'F' 'T']
                        @find = char
                        ⮐ @logPending()
                    char == ';'
                        ⮐ @repeatFind false
                    char == ','
                        ⮐ @repeatFind true
                    area = novim.areas[char]
                        @area = area
                        ⮐ @logPending()
                    char in '0123456789'
                        @count += char
                        ⮐ @logPending()
                    ➜ 
                        ⮐ @reset()
                    
            char in ['f' 't' 'F' 'T']
    
                @find = char
                ⮐ @logPending()
    
            char == 'i'
            
                @state.startNovimInsert { kind: 'insert' }
                ⮐ @exitNovim()

            char == 'a'
            
                @state.startNovimInsert { kind: 'append' }
                @state.moveCursors 'right'
                ⮐ @exitNovim()
                
            char == 'A'
            
                @state.startNovimInsert { kind: 'appendEol' }
                @state.moveCursors 'eol'
                ⮐ @exitNovim()
    
            char == ';'
    
                ⮐ @repeatFind false
    
            char == ','
    
                ⮐ @repeatFind true
    
            char == 'r'
    
                @replace = true
                ⮐ @logPending()
    
            novim.operators[char]
    
                @operator = char
                ⮐ @logPending()
    
            char == '"'
    
                @registerPending = true
                ⮐ @logPending()
    
            char == 'g'
    
                @prefix = 'g'
                ⮐ @logPending()
    
            char == '/'
            
                post.emit 'vinder.show' 
                ⮐ @reset()
    
            command = novim.commands[char]
    
                ⮐ @execute command(@countNumber())
    
            char in '0123456789'
    
                if char == '0' and empty @count
                    ⮐ @execute { operator: 'move', motion: { kind: 'bol' } }
                else
                    @count += char
                    ⮐ @logPending()
                
        'unhandled'

    #  ███████   ███████   ███       ███████   ████████
    # ███       ███   ███  ███      ███   ███  ███   ███
    # ███       ███   ███  ███      ███   ███  ███████
    # ███       ███   ███  ███      ███   ███  ███   ███
    #  ███████   ███████   ███████   ███████   ███   ███

    themeColor: colorName defaultColor ->

        switch colorName
            'cursor.multi' ➜ ⮐ theme.novim.cursor.multi
            'cursor.main'  ➜ ⮐ theme.novim.cursor.main

        defaultColor

export novim
