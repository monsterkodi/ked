###
███   ███   ███████   ███   ███  ███  ██     ██
████  ███  ███   ███  ███   ███  ███  ███   ███
███ █ ███  ███   ███   ███ ███   ███  █████████
███  ████  ███   ███     ███     ███  ███ █ ███
███   ███   ███████       █      ███  ███   ███

swallows text input while active and maps keys 
to actions which are executed by edit▸act▸novim
###

use ../../theme  ◆ color
use ../../../kxk ◆ post keyinfo
use ../../theme  ◆ theme

function novim

    @operators:
        c: 'change'
        d: 'delete'
        y: 'yank'
        '>': 'indent'
        '<': 'deindent'

    @arrows:
        left:  'h'
        right: 'l'
        up:    'k'
        down:  'j'

    @areas:
        i:      'inner'
        a:      'around'

    @textObjects:
        'w':    'word'
        'W':    'WORD'
        '"':    '"'
        "'":    "'"
        '(':    '('
        ')':    '('
        'b':    '('
        '[':    '['
        ']':    '['
        '{':    '{'
        '}':    '{'
        'B':    '{'

    @commands: {
        'C':      -> { operator: 'change'                    motion: { kind: 'eol'      } }
        'D':      -> { operator: 'delete'                    motion: { kind: 'eol'      } }
        's':    n -> { operator: 'change'       count: n     motion: { kind: 'char'     } }
        'S':    n -> { operator: 'change'       count: n     motion: { kind: 'line'     } }
        'x':    n -> { operator: 'delete'       count: n     motion: { kind: 'char'     } }
        'X':    n -> { operator: 'delete'       count: n     motion: { kind: 'charBack' } }
        'h':    n -> { operator: 'move'         count: n     motion: { kind: 'left'     } }
        'j':    n -> { operator: 'move'         count: n     motion: { kind: 'down'     } }
        'k':    n -> { operator: 'move'         count: n     motion: { kind: 'up'       } }
        'l':    n -> { operator: 'move'         count: n     motion: { kind: 'right'    } }
        'w':    n -> { operator: 'move'         count: n     motion: { kind: 'word'     } }
        'b':    n -> { operator: 'move'         count: n     motion: { kind: 'drow'     } }
        'e':    n -> { operator: 'move'         count: n     motion: { kind: 'wend'     } }
        'W':    n -> { operator: 'move'         count: n     motion: { kind: 'WORD'     } }
        'B':    n -> { operator: 'move'         count: n     motion: { kind: 'DROW'     } }
        'E':    n -> { operator: 'move'         count: n     motion: { kind: 'WEND'     } }
        '$':    n -> { operator: 'move'         count: n     motion: { kind: 'eol'      } }
        'G':    n -> { operator: 'move'         count: n     motion: { kind: 'eof'      } }
        'n':    n -> { operator: 'searchNext'   count: n     text:  novim.lastVind }
        'N':    n -> { operator: 'searchPrev'   count: n     text:  novim.lastVind }
        'p':    n -> { operator: 'put'          count: n     after: true  }
        'P':    n -> { operator: 'put'          count: n     after: false }
        'u':    n -> { operator: 'undo'         count: n }
        '.':    n -> { operator: 'repeat'       count: n } 
        'Y':    n -> { operator: 'yank'         motion: { kind: 'line', count: n } }
        'o':    n -> { operator: 'openLine'     count: n  after: true  }
        'O':    n -> { operator: 'openLine'     count: n  after: false }
        'I':      -> { operator: 'insertAtIndent' }
        '~':    n -> { operator: 'toggleCase'   count: n }
        'J':    n -> { operator: 'joinLinesVim' count: n }
        '%':      -> { operator: 'matchBracket' }
        '*':    n -> { operator: 'searchWord'   count: n  forward: true  }
        '#':    n -> { operator: 'searchWord'   count: n  forward: false }
        }

    @motions: {
        '0':      -> { kind: 'bol' }
        '$':      -> { kind: 'eol' }
        '>':    n -> { kind: 'line'             count: n }
        '<':    n -> { kind: 'line'             count: n }
        'c':    n -> { kind: 'line'             count: n }
        'd':    n -> { kind: 'line'             count: n }
        'y':    n -> { kind: 'line'             count: n }
        'w':    n -> { kind: 'word'             count: n }
        'e':    n -> { kind: 'wend'             count: n }
        'b':    n -> { kind: 'drow'             count: n }
        'W':    n -> { kind: 'WORD'             count: n }
        'E':    n -> { kind: 'WEND'             count: n }
        'B':    n -> { kind: 'DROW'             count: n }
        'h':    n -> { kind: 'charBack'         count: n }
        'l':    n -> { kind: 'char'             count: n }
        'j':    n -> { kind: 'lineDown'         count: n }
        'k':    n -> { kind: 'lineUp'           count: n }
        }

    @lastVind: ''
    
    @: @state ->

        @name     = 'novim'
        @lastFind = null
        @reset()
        
        post.on 'vinder.text' (text) => novim.lastVind = text

    @clipboardSync: null # on in ked, off in a headless editor

    @isHeadless: ->

        screen = global.ked_screen

        ⮐ true if not screen
        ⮐ true if screen.t and screen.t.headless
        false

    @clipboardEnabled: ->

        if novim.clipboardSync == null
            ⮐  not novim.isHeadless()

        novim.clipboardSync

    @toggleClipboard: ->

        enabled = not novim.clipboardEnabled()

        novim.clipboardSync = enabled

        enabled

    reset: ->

        @count           = ''
        @operator        = null
        @area            = null
        @prefix          = null
        @register        = null
        @registerPending = false
        @find            = null
        @replace         = null
        @logPending()

    resetOrExit: ->

        if @operator or @count or @prefix or @registerPending or @register or @find or @replace
            @reset()
        else
            @exitNovim()
            
    exitNovim: ->
        
        @state.stopMode 'novim'

    countNumber: -> if empty @count then 1 else parseInt @count

    logPending: ->
    
        t = ''
        t += @operator if @operator 
        t += @area[0] if @area 
        t += @prefix if @prefix 
        t += @count if @count 
        t += @register if @register 
        t += @find if @find 
        t += 'r' if @replace
    
        post.emit 'title.novim' t

    complete: build ->

        operator = novim.operators[@operator]

        @execute { operator: operator, motion: build(@countNumber()) }
        @reset()

    completeTextObject: target ->

        area     = @area
        operator = novim.operators[@operator]

        @execute { operator: operator, motion: { kind: 'textObject', area: area, target: target, count: @countNumber() } }
        @reset()

    completeFind: target ->

        till    = @find in ['t' 'T']
        forward = @find in ['f' 't']

        @lastFind = { target: target, till: till, forward: forward }

        motion = { kind: 'charFind', target: target, till: till, forward: forward, count: @countNumber() }

        if @operator
            @execute { operator: novim.operators[@operator], motion: motion }
        else
            @execute { operator: 'move', motion: motion }

        @reset()

    completeReplace: char ->

        @execute { operator: 'replace', char: char, count: @countNumber() }
        @reset()

    repeatFind: reverse=false ->

        ⮐  if not @lastFind

        forward = reverse ? not @lastFind.forward : @lastFind.forward

        motion = { kind: 'charFind', target: @lastFind.target, till: @lastFind.till, forward: forward, count: @countNumber(), repeat: true }

        if @operator
            @execute { operator: novim.operators[@operator], motion: motion }
        else
            @execute { operator: 'move', motion: motion }

        @reset()

    execute: cmd ->

        if @register
            cmd.register = @register

        @state.executeNovim cmd

    # ███   ███  ████████  ███   ███
    # ███  ███   ███        ███ ███
    # ███████    ███████     █████
    # ███  ███   ███          ███
    # ███   ███  ████████     ███

    handleKey: key event ->

        combo = event.combo ? key
        char  = valid(event.char) ? event.char : combo

        # let global shortcuts through, at least the one that leaves this mode
        if combo.includes('alt+') or combo.includes('ctrl+') or combo.includes('cmd+')
            ⮐  'unhandled'

        if combo in ['esc' 'escape']
            @reset()
            if @state.visual
                @state.stopVisual()
            else if @state.hasCursorsHighlightsOrSelections()
                @state.clearCursorsHighlightsAndSelections()
            else
                @exitNovim()
            ⮐ true

        if not @find and char not in ',;nN0123456789' and key not in keyinfo.modifierNames
            @state.setHighlights [] 

        if @find
            # log "novim.find #{char} -- #{event.char} #{combo} #{key}" 
            if char.length == 1
                @completeFind char
            else if key != 'shift'
                @reset()
            ⮐ true

        if @replace
            if char.length == 1
                @completeReplace char
            else if key != 'shift'
                @reset()
            ⮐ true

        if arrow = novim.arrows[char]
            char = arrow

        if @registerPending
            @registerPending = false

            # " selects the next register, + and * mean the system clipboard
            if char in ['+' '*']
                @register = 'clipboard'
            else if char in ['"' '0']
                @register = null
            else
                @reset()
                ⮐  true

            @logPending()
            ⮐  true

        ⮐  true if char.length != 1 # swallow every other non text key

        if @state.visual and not @operator and not @area

            if char == 'v'
                @state.startVisual 'char'
                @reset()
                ⮐  true

            if char == 'V'
                @state.startVisual 'line'
                @reset()
                ⮐  true

            if char in ['d' 'x']
                @execute { operator: 'visualDelete' }
                @reset()
                ⮐  true

            if char == 'y'
                @execute { operator: 'visualYank' }
                @reset()
                ⮐  true

            if char in ['c' 's']
                @execute { operator: 'visualChange' }
                @reset()
                ⮐  true

            if char == 'o'
                @execute { operator: 'visualSwap' }
                @reset()
                ⮐  true

            if char in ['>' '<']
                operator = char == '>' ? 'visualIndent' : 'visualDeindent'
                @execute { operator: operator, count: @countNumber() }
                @reset()
                ⮐  true

            if area = novim.areas[char]
                @area = area
                @logPending()
                ⮐  true

        if not @operator and not @area

            if char == 'v'
                @state.startVisual 'char'
                @reset()
                ⮐  true

            if char == 'V'
                @state.startVisual 'line'
                @reset()
                ⮐  true

        if @prefix # gg 
            prefix  = @prefix
            @prefix = null

            if prefix == 'g' and char == 'g'
                @execute { operator: 'move', motion: { kind: 'bof', count: @countNumber() } }
            @reset()

            ⮐  true

        if 
            @area
    
                if target = novim.textObjects[char]
                    if @state.visual
                        @execute { operator: 'visualTextObject', motion: { kind: 'textObject', area: @area, target: target, count: @countNumber() } }
                        @reset()
                    else
                        @completeTextObject target
                else
                    @reset()
    
            @operator
    
                if  
                    build = novim.motions[char]
                        @complete build
                    char in ['f' 't' 'F' 'T']
                        @find = char
                        @logPending()
                    char == ';'
                        @repeatFind()
                    char == ','
                        @repeatFind true
                    area = novim.areas[char]
                        @area = area
                        @logPending()
                    char in '0123456789'
                        @count += char
                        @logPending()
                    ➜ 
                        @reset()
                    
            char in ['f' 't' 'F' 'T']
    
                @find = char
                @logPending()
    
            char == 'i'
            
                @state.startNovimInsert { kind: 'insert' }
                @exitNovim()

            char == 'a'
            
                @state.startNovimInsert { kind: 'append' }
                @state.moveCursors 'right'
                @exitNovim()
                
            char == 'A'
            
                @state.startNovimInsert { kind: 'appendEol' }
                @state.moveCursors 'eol'
                @exitNovim()
    
            char == ';'
    
                @repeatFind()
    
            char == ','
    
                @repeatFind true
    
            char == 'r'
    
                @replace = true
                @logPending()
    
            novim.operators[char]
    
                @operator = char
                @logPending()
    
            char == '"'
    
                @registerPending = true
                @logPending()
    
            char == 'g'
    
                @prefix = 'g'
                @logPending()
    
            char == '/'
            
                post.emit 'vinder.show' 
                @reset()
    
            command = novim.commands[char]
    
                @execute command(@countNumber())
                @reset()
    
            char in '0123456789'
    
                if char == '0' and empty @count
                    @execute { operator: 'move', motion: { kind: 'bol' } }
                    @reset()
                else
                    @count += char
                    @logPending()

        # swallow all other input until more commands are implemented
        true

    #  ███████   ███████   ███       ███████   ████████
    # ███       ███   ███  ███      ███   ███  ███   ███
    # ███       ███   ███  ███      ███   ███  ███████
    # ███       ███   ███  ███      ███   ███  ███   ███
    #  ███████   ███████   ███████   ███████   ███   ███

    themeColor: colorName defaultColor ->

        switch colorName
            'cursor.multi' ➜ ⮐ theme.novim.cursor.multi
            'cursor.main'  ➜ ⮐ theme.novim.cursor.main

        defaultColor

export novim
