use ../../kxk ▪ kseg
use ../theme     ◆ color

FG_COLOR    = 31
BG_COLOR    = 32
FG_BG_COLOR = 33

■susan
    ###
        renders sue areas into the cells of an editor

        an area is { x, y, value } where value is [code, data]
        the code says which feature the area belongs to, the data is
        whatever that feature needs. trailing numbers of the data are
        geometry: width in cells, then height in rows, both optional.
        an area without a width reaches to the end of its line, one
        without a height is one row tall.

        the codes live here because susan is the one who has to know them.
        a code susan does not know is left alone, so a file written by a
        newer ked still loads.

        not yet: overlapping areas, areas in views other than the editor
    ###

    @FG_COLOR:    FG_COLOR
    @BG_COLOR:    BG_COLOR
    @FG_BG_COLOR: FG_BG_COLOR

    #  a color span is [x1 y x2 color], the sue form is a fixed width area

    @fromColors: colors ->

        areas = []

        ⮐ areas if not colors?

        for span in (colors.fg ? [])
            areas.push {x: span[0] y: span[1] value: [FG_COLOR [span[3] span[2]-span[0] 1]]}

        for span in (colors.bg ? [])
            areas.push {x: span[0] y: span[1] value: [BG_COLOR [span[3] span[2]-span[0] 1]]}

        areas

    #  cutting
    #
    #  the leading values of an area are the feature's own, the trailing
    #  numbers are geometry. a box is an area with its geometry pulled out:
    #  { x, y, w, h, colors, open } where open means the box reaches to the
    #  end of its line and therefore has no width of its own.
    #
    #  an area of a code susan does not know has no box and is never cut.

    @ncolors: code ->
        ⮐ 2 if code == FG_BG_COLOR
        ⮐ 1 if code == FG_COLOR or code == BG_COLOR
        0

    @box: (area lines) ->

        code = area.value[0]
        n    = @ncolors code

        ⮐ null if n == 0

        data = area.value[1] ? []
        w    = data[n]
        h    = data[n+1] ? 1

        if not valid w
            line = lines[area.y] ? []
            w    = max 0 (kseg.width(line) - area.x)
            open = true
        else
            open = false

        {x: area.x y: area.y w: w h: h colors: data[0...n] open: open}

    @rebox: (area box) ->
        [code data] = area.value
        w = box.open ? null : box.w
        {x: box.x y: box.y value: [code box.colors.concat([w box.h])]}

    #  the parts of a box that a range does not cover
    #  a range is [x1 y1 x2 y2] with x2 exclusive and y2 inclusive

    @subtract: (box rng) ->

        [rx1 ry1 rx2 ry2] = rng

        x1 = box.x
        x2 = box.x + box.w
        y1 = box.y
        y2 = box.y + box.h - 1

        ⮐ [box] if rx2 <= x1 or rx1 >= x2 or ry2 < y1 or ry1 > y2

        parts = []

        if ry1 > y1
            parts.push {x: x1 y: y1 w: box.w h: ry1-y1 colors: box.colors open: box.open}

        if ry2 < y2
            parts.push {x: x1 y: ry2+1 w: box.w h: y2-ry2 colors: box.colors open: box.open}

        my1 = max(y1 ry1)
        my2 = min(y2 ry2)

        if my2 >= my1
            mh = my2 - my1 + 1
            if rx1 > x1
                parts.push {x: x1 y: my1 w: rx1-x1 h: mh colors: box.colors open: false}
            if rx2 < x2
                parts.push {x: rx2 y: my1 w: x2-rx2 h: mh colors: box.colors open: box.open}

        parts

    @cut: (areas ranges lines) ->

        result = []

        for area in areas

            box = @box(area lines)

            if not box?
                result.push area
                continue

            parts = [box]

            for rng in ranges
                next = []
                for part in parts
                    next = next.concat(@subtract(part rng))
                parts = next
                break if empty parts

            for part in parts
                result.push @rebox(area part)

        result

    @: @cells @state ->

    draw: =>

        areas = @state.s.sue ? []
        ⮐ if empty areas

        view  = @state.s.view
        lines = @state.s.lines

        for area in areas

            y = area.y
            continue if y < 0 or y >= lines.length

            row = @state.rowOfLine y
            continue if row < 0

            scale = @state.lineHeight y
            continue if row + scale > @cells.rows

            [code data] = area.value
            data ?= []

            fg = null
            bg = null
            w  = null
            h  = null

            if code == FG_COLOR
                fg = data[0]
                w  = data[1]
                h  = data[2]
            else if code == BG_COLOR
                bg = data[0]
                w  = data[1]
                h  = data[2]
            else if code == FG_BG_COLOR
                fg = data[0]
                bg = data[1]
                w  = data[2]
                h  = data[3]
            else
                continue

            if not valid w
                w = max 0 (kseg.width(lines[y]) - area.x)

            h ?= 1

            x1 = max 0 (area.x*scale - view[0])
            x2 = min @cells.cols ((area.x + w)*scale - view[0])
            continue if x1 >= x2

            fg = color.values fg if fg?
            bg = color.values bg if bg?

            for r in row...min(@cells.rows row + h*scale)
                @cells.bg_rect x1 r (x2-1) r bg if bg?
                if fg?
                    for x in x1...x2
                        @cells.set_fg x r fg

export susan
