use ../theme ◆ color
use ./tool  ◆ sue

■susan
    ###
        renders sue areas into the cells of an editor

        an area is { x, y, value } where value is [code, data]
        the code says which feature the area belongs to, the data is
        whatever that feature needs. trailing numbers of the data are
        geometry: width in cells, then height in rows, both optional.
        an area without a width reaches to the end of its line, one
        without a height is one row tall.

        susan renders the codes it knows and leaves the rest alone, so a
        file written by a newer ked still loads. the codes themselves
        live in sue.

        style areas stack: their flags are joined per cell, so a bold
        area and an underlined area over the same text give both.

        not yet: overlapping areas, areas in views other than the editor
    ###

    @FG_COLOR:    sue.FG_COLOR
    @BG_COLOR:    sue.BG_COLOR
    @FG_BG_COLOR: sue.FG_BG_COLOR
    @STYLE:       sue.STYLE
    @LINE_SCALE:  sue.LINE_SCALE

    #  a color span is [x1 y x2 color], the sue form is a fixed width area

    @fromColors: colors ->

        areas = []

        ⮐ areas if not colors?

        for span in (colors.fg ? [])
            areas.push {x: span[0] y: span[1] value: [sue.FG_COLOR [span[3] span[2]-span[0] 1]]}

        for span in (colors.bg ? [])
            areas.push {x: span[0] y: span[1] value: [sue.BG_COLOR [span[3] span[2]-span[0] 1]]}

        areas

    @: @cells @state ->

    draw: =>

        areas = @state.s.sue ? []
        ⮐ if empty areas

        view  = @state.s.view
        lines = @state.s.lines

        for area in areas

            box = sue.boxForAreaAndLines(area lines)
            continue if not box?

            y = box.y
            continue if y < 0 or y >= lines.length

            row = @state.rowOfLine y
            continue if row < 0

            scale = @state.lineHeight y
            continue if row + scale > @cells.rows

            code = area.value[0]

            fg   = null
            bg   = null
            attr = null
            ul   = null

            if code == sue.FG_COLOR
                fg = box.values[0]
            else if code == sue.BG_COLOR
                bg = box.values[0]
            else if code == sue.FG_BG_COLOR
                fg = box.values[0]
                bg = box.values[1]
            else if code == sue.STYLE
                [attr ul] = sue.styleOfValues(box.values)
            else
                continue

            x1 = max 0 (box.x*scale - view[0])
            x2 = min @cells.cols ((box.x + box.w)*scale - view[0])
            continue if x1 >= x2

            fg = color.values fg if fg?
            bg = color.values bg if bg?
            ul = color.values ul if ul?

            for r in row...min(@cells.rows row + box.h*scale)
                @cells.bg_rect x1 r (x2-1) r bg if bg?
                if fg?
                    for x in x1...x2
                        @cells.set_fg x r fg
                if attr? or ul?
                    for x in x1...x2
                        [have hul] = @cells.get_attr x r
                        @cells.set_attr x r (sue.addFlags(have attr)) (ul ? hul)

export susan
