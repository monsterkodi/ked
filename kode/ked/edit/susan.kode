use ../theme ◆ color
use ./tool  ◆ sue

■󠀡󠀰󠀰󠀱󠀲󠁛󠀳󠀴󠀬󠀱󠀬󠀱󠀬󠀢󠁩󠀢󠁝s󠀡󠀰󠀰󠀲󠀸󠁛󠀳󠀳󠀬󠀱󠀬󠀱󠀬󠀢󠀣󠀶󠀶󠀰󠀰󠁣󠁣󠀢󠀬󠀢󠀣󠀰󠀰󠀰󠀰󠀰󠀰󠀢󠁝󠀡󠀰󠀰󠀱󠀳󠁛󠀳󠀴󠀬󠀱󠀬󠀱󠀬󠀢󠁳󠁢󠀢󠁝u󠀡󠀰󠀰󠀱󠀳󠁛󠀳󠀴󠀬󠀱󠀬󠀱󠀬󠀢󠁵󠁩󠀢󠁝s󠀡󠀰󠀰󠀲󠀸󠁛󠀳󠀳󠀬󠀲󠀬󠀱󠀬󠀢󠀣󠀸󠀸󠀹󠀱󠀰󠀰󠀢󠀬󠀢󠀣󠀰󠀰󠀰󠀰󠀰󠀰󠀢󠁝󠀡󠀰󠀰󠀲󠀸󠁛󠀳󠀳󠀬󠀱󠀬󠀱󠀬󠀢󠀣󠀹󠀱󠀰󠀰󠀰󠀰󠀢󠀬󠀢󠀣󠀰󠀰󠀰󠀰󠀰󠀰󠀢󠁝an
    ###
        renders sue areas into the cells of an editor

        an area is { x, y, value } where value is [code, cols, lines, data...]
        the code says which feature the area belongs to, cols and lines are
        its box in graphemes and rows, and a negative cols reaches to the
        end of its line. the data after the geometry is the feature's own.

        susan renders the codes it knows and leaves the rest alone, so a
        file written by a newer ked still loads. the codes themselves
        live in sue.

        style areas stack: their flags are joined per cell, so a bold
        area and an underlined area over the same text give both.

        not yet: overlapping areas, areas in views other than the editor
    ###

    @FG_COLOR:    sue.FG_COLOR
    @BG_COLOR:    sue.BG_COLOR
    @FG_BG_COLOR: sue.FG_BG_COLOR
    @STYLE:       sue.STYLE
    @LINE_SCALE:  sue.LINE_SCALE

    #  runs are only honoured on unscaled lines of a terminal with text sizing

    runsForLine: y =>

        ⮐ [] if not @cells.screen.t.textSizing
        ⮐ [] if @state.lineHeight(y) != 1

        @state.scaleRunsForLine y

    @: @cells @state ->

    draw: =>

        areas = @state.s.sue ? []
        ⮐ if empty areas

        view  = @state.s.view
        lines = @state.s.lines

        for area in areas

            box = sue.boxForAreaAndLines(area lines)
            continue if not box?

            y = box.y
            continue if y < 0 or y >= lines.length

            row = @state.rowOfLine y
            continue if row < 0

            scale = @state.lineHeight y
            continue if row + scale > @cells.rows

            code = area.value[0]

            fg   = null
            bg   = null
            attr = null
            ul   = null

            if code == sue.FG_COLOR
                fg = box.values[0]
            else if code == sue.BG_COLOR
                bg = box.values[0]
            else if code == sue.FG_BG_COLOR
                fg = box.values[0]
                bg = box.values[1]
            else if code == sue.STYLE
                [attr ul] = sue.styleOfValues(box.values)
            else
                continue

            runs  = @runsForLine y
            cells = sue.cellPositionsForLine(lines y runs)
            last  = cells.length-1

            x1 = max 0 (cells[min(box.x last)]*scale - view[0])
            x2 = min @cells.cols (cells[min(box.x + box.w last)]*scale - view[0])
            continue if x1 >= x2

            fg = color.values fg if fg?
            bg = color.values bg if bg?
            ul = color.values ul if ul?

            for r in row...min(@cells.rows row + box.h*scale)
                for x in x1...x2
                    continue if @cells.isScaled(x r)
                    @cells.set_bg x r bg if bg?
                    @cells.set_fg x r fg if fg?
                    if attr? or ul?
                        [have hul] = @cells.get_attr x r
                        @cells.set_attr x r (sue.addFlags(have attr)) (ul ? hul)

export susan
