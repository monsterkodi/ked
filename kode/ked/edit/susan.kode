use ../theme ◆ color
use ./tool  ◆ sue

■󠀡󠀰󠀰󠀱󠀲󠁛󠀳󠀴󠀬󠀱󠀬󠀱󠀬󠀢󠁩󠀢󠁝s󠀡󠀰󠀰󠀲󠀸󠁛󠀳󠀳󠀬󠀱󠀬󠀱󠀬󠀢󠀣󠀶󠀶󠀰󠀰󠁣󠁣󠀢󠀬󠀢󠀣󠀰󠀰󠀰󠀰󠀰󠀰󠀢󠁝󠀡󠀰󠀰󠀱󠀳󠁛󠀳󠀴󠀬󠀱󠀬󠀱󠀬󠀢󠁳󠁢󠀢󠁝u󠀡󠀰󠀰󠀱󠀳󠁛󠀳󠀴󠀬󠀱󠀬󠀱󠀬󠀢󠁵󠁩󠀢󠁝s󠀡󠀰󠀰󠀲󠀸󠁛󠀳󠀳󠀬󠀲󠀬󠀱󠀬󠀢󠀣󠀸󠀸󠀹󠀱󠀰󠀰󠀢󠀬󠀢󠀣󠀰󠀰󠀰󠀰󠀰󠀰󠀢󠁝󠀡󠀰󠀰󠀲󠀸󠁛󠀳󠀳󠀬󠀱󠀬󠀱󠀬󠀢󠀣󠀹󠀱󠀰󠀰󠀰󠀰󠀢󠀬󠀢󠀣󠀰󠀰󠀰󠀰󠀰󠀰󠀢󠁝an
    ###
        renders sue areas into the cells of an editor

        { x, y, [code, cols, lines, data...] } 
    ###

    @FG_COLOR:    sue.FG_COLOR
    @BG_COLOR:    sue.BG_COLOR
    @FG_BG_COLOR: sue.FG_BG_COLOR
    @STYLE:       sue.STYLE
    @LINE_SCALE:  sue.LINE_SCALE

    @: @editor -> @state = @editor.state

    draw: =>

        areas = @state.s.sue ? []
        ⮐ if empty areas

        view  = @state.s.view
        lines = @state.s.lines

        for area in areas

            box = sue.boxForAreaAndLines(area lines)
            continue if not box?

            y = box.y
            continue if y < 0 or y >= lines.length

            row = @state.rowOfLine y
            continue if row < 0

            scale = @state.lineHeight y
            continue if row + scale > @editor.cells.rows

            code = area.value[0]

            fg   = null
            bg   = null
            attr = null
            ul   = null

            if code == sue.FG_COLOR
                fg = box.values[0]
            else if code == sue.BG_COLOR
                bg = box.values[0]
            else if code == sue.FG_BG_COLOR
                fg = box.values[0]
                bg = box.values[1]
            else if code == sue.STYLE
                [attr ul] = sue.styleOfValues(box.values)
            else
                continue

            runs = @editor.runsForLine y
            cpos = sue.cellPositionsForLine(lines y runs)
            lastIndex = cpos.length-1

            x1 = max 0 (cpos[min(box.x lastIndex)]*scale - view[0])
            x2 = min @editor.cells.cols (cpos[min(box.x + box.w lastIndex)]*scale - view[0])
            continue if x1 >= x2

            fg = color.values fg if fg?
            bg = color.values bg if bg?
            ul = color.values ul if ul?

            seen = {}

            for r in row...min(@editor.cells.rows row + box.h*scale)

                for x in x1...x2

                    block = @editor.cells.blockAt(x r)

                    if block?
                        continue if block[4] != y
                        key = "#{block[0]},#{block[1]}"
                        continue if seen[key]
                        seen[key] = true
                        @editor.cells.bg_block block bg if bg?
                        @editor.cells.set_fg block[0] block[1] fg if fg?
                        if attr? or ul?
                            [have hul] = @editor.cells.get_attr block[0] block[1]
                            @editor.cells.set_attr block[0] block[1] (sue.addFlags(have attr)) (ul ? hul)
                        continue

                    @editor.cells.set_bg x r bg if bg?
                    @editor.cells.set_fg x r fg if fg?
                    if attr? or ul?
                        [have hul] = @editor.cells.get_attr x r
                        @editor.cells.set_attr x r (sue.addFlags(have attr)) (ul ? hul)

export susan
