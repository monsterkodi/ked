###
     ███████  █████████   ███████   █████████  ████████  
    ███          ███     ███   ███     ███     ███       
    ███████      ███     █████████     ███     ███████   
         ███     ███     ███   ███     ███     ███       
    ███████      ███     ███   ███     ███     ████████  

    handles basic text editing for the editor
    wraps text and editor state like cursors and selections 
        in an immutable to simplify undo
    delegates almost all text manipulation to pure functions
        in tool▸belt to simplify testing
###

use ../../kxk ▪ immutable kstr kseg events absMin
use ../../kxk ◆ clip
use ../util   ◆ syntax config
use ./act     ◆ del insert select join indent multi main novim
use ./tool    ◆ belt colorspans
use           ◆ keys mode

function state extends events

    @: @cells name ->

        @name = name + '.state'
        
        @allowedModes = {}

        for act in [del insert select join indent multi main novim]
            for k,v of act
                @[k] = v.bind @
                
        @handleKey = keys.bind @

        @syntax   = new syntax @name + '.syntax'
        @hasFocus = false

        #  the display scale of markdown headings: syntax class -> rows
        @scales     = {h1:3 h2:2}
        @scaledExts = ['md' 'markdown' 'kode']
        @scaling    = true

        @yankFlash      = null
        @yankFlashTimer = null

        @rowCache    = null
        @rowCacheExt = null
        @maxWidthCache = 0

        @clearSingle()

    toggleMode: name => mode.toggle @ name if @allowedModes[name]
    startMode:  name => mode.start  @ name if @allowedModes[name]
    stopMode:   name => mode.stop   @ name if @allowedModes[name]
        
    owner: => 
        
        if @name.endsWith '.state'
            @name[0...-6]
        else
            @name
        
    clearHistory: =>
    
        @h = [@s] # undo states (history)
        @r = []   # redo states

    #  ███████  ████████  █████████
    # ███       ███          ███
    # ███████   ███████      ███
    #      ███  ███          ███
    # ███████   ████████     ███

    set: item arg =>

        @s = @s.set item arg
        @swapState()
        @

    setSelections: selections => @set 'selections' belt.mergeLineRanges(@s.lines selections)
    setHighlights: highlights => @set 'highlights' belt.normalizeSpans(highlights)

    setColorsForRanges: (ranges fg bg voided=[]) =>

        colors = @s.colors
        colors ?= {fg: [], bg: []}

        fgSpans = colors.fg ? []
        bgSpans = colors.bg ? []

        if 'fg' in voided
            fgSpans = colorspans.clear fgSpans ranges
        else if valid fg and not empty fg
            fgSpans = colorspans.overlay fgSpans ranges fg @s.lines

        if 'bg' in voided
            bgSpans = colorspans.clear bgSpans ranges
        else if valid bg and not empty bg
            bgSpans = colorspans.overlay bgSpans ranges bg @s.lines

        next =
            fg: fgSpans
            bg: bgSpans

        ⮐  if @s.colors? and @s.colors eql next

        @s = @s.set 'colors' next
        @r = []
        @pushState()
        @emit 'colors.changed'

    clearColorsForRanges: ranges =>

        colors = @s.colors
        ⮐  if not colors?

        fgSpans = colorspans.clear (colors.fg ? []) ranges
        bgSpans = colorspans.clear (colors.bg ? []) ranges

        next =
            fg: fgSpans
            bg: bgSpans

        ⮐  if colors eql next

        @s = @s.set 'colors' next
        @r = []
        @pushState()
        @emit 'colors.changed'

    clearColorsAtCursorOrSelection: =>

        ranges = @s.selections

        if empty ranges
            if rng = belt.rangeOfClosestWordToPos @s.lines @mainCursor()
                ranges = [rng]

        @clearColorsForRanges ranges if not empty ranges

    colorAtPos: (pos layer) =>

        colors = @s.colors
        ⮐  null if not colors?

        colorspans.colorAtPos (colors[layer] ? []) pos

    loadColors: colors =>

        fgSpans = []
        bgSpans = []

        if colors?
            fgSpans = colors.fg ? []
            bgSpans = colors.bg ? []

        next =
            fg: fgSpans
            bg: bgSpans

        @s = @s.set 'colors' next
        @clearHistory()
        @emit 'colors.changed'

    #  ███████  ███   ███  ████████    ███████   ███████   ████████    ███████
    # ███       ███   ███  ███   ███  ███       ███   ███  ███   ███  ███
    # ███       ███   ███  ███████    ███████   ███   ███  ███████    ███████
    # ███       ███   ███  ███   ███       ███  ███   ███  ███   ███       ███
    #  ███████   ███████   ███   ███  ███████    ███████   ███   ███  ███████

    setCursors: cursors opt =>
        
        opt ?= {}
        opt.mc ?= @mainCursor()
        
        main = opt.main

        if not opt.keepAnchors
            delete @anchors

        if main is arr ➜ main = belt.indexOfPosInPositions main cursors
        if main is num and main < 0 ➜ main = cursors.length+main

        if main?
            mainCursor = copy cursors[clamp 0 cursors.length-1 main]
        else
            mainCursor = @mainCursor()
        
        cursors = belt.normalizePositions cursors @s.lines.length-1
        
        @s = @s.set 'cursors' cursors

        main = -1
        for cur,idx in cursors
            if cur eql mainCursor
                main = idx
                break

        main = @s.main if main < 0
        main = clamp 0 @s.cursors.length-1 main

        @s = @s.set 'main' main
        
        @adjustViewForMainCursor opt
        
        @swapState()
        
        mode.cursorsSet @
        @emit 'cursorsSet'
        @
            
    textOfSelectionOrWordAtCursor: => 
        
        if @s.selections.length
            ⮐  @textOfSelection()
        else
            ⮐  @wordAtCursor()

    # ███      ███  ███   ███  ████████   ███████
    # ███      ███  ████  ███  ███       ███
    # ███      ███  ███ █ ███  ███████   ███████
    # ███      ███  ███  ████  ███            ███
    # ███████  ███  ███   ███  ████████  ███████

    setText: text => 
    
        @setLines text.split(/\r?\n/)

    setLines: lines =>
        
        if empty lines ➜ lines = ['']
        
        @setSegls kseg.segls(lines)
        
    setSegls: @segls =>
        
        if empty @segls ➜ @segls = [[]]
        
        @syntax.setSegls @segls
                    
        @changeLinesSegls()
        
        @r = []
        
        @maxLineWidth = belt.widthOfLines @s.lines
        
        @pushState()
        
    loadLines: lines => 
    
        if valid lines and not lines[0] is str ➜ error "#{@name}.loadLines - first line not a string?" lines[0]
        
        @loadSegls kseg.segls(lines)
    
    loadSegls: segls =>
    
        @clearEmpty()
        @setSegls segls

    clearSingle: => @clearSegls [[]]
    clearEmpty:  => @clearSegls [  ]
    clearSegls: @segls =>
    
        @visual        = null
        @visualAnchors = []
        @novimInsert   = null

        clearTimeout @yankFlashTimer if @yankFlashTimer

        @yankFlash      = null
        @yankFlashTimer = null
    
        @s = immutable
            lines:       @segls
            selections:  []
            highlights:  []
            cursors:     [[0 0]]
            main:        0
            view:        [0 0]
            scrollOffset: 0
            colors:      {fg: [], bg: []}
            
        @syntax.clear()

        @rowCache = null
        
        @h = []
        @r = []
        
    addLine: line ext =>

        segl = kseg line
        @syntax.addSegl segl ext
        @segls ?= []
        @segls.push segl

        @changeLinesSegls()
        
    appendLines: lines ext =>

        segls = kseg.segls lines
        @syntax.appendSegls segls ext
        @segls ?= []
        @segls = @segls.concat segls

        @changeLinesSegls()
        
    #  ███████  ███   ███   ███████   ███   ███   ███████   ████████        ███      ███  ███   ███  ████████   ███████
    # ███       ███   ███  ███   ███  ████  ███  ███        ███             ███      ███  ████  ███  ███       ███     
    # ███       █████████  █████████  ███ █ ███  ███  ████  ███████         ███      ███  ███ █ ███  ███████   ███████ 
    # ███       ███   ███  ███   ███  ███  ████  ███   ███  ███             ███      ███  ███  ████  ███            ███
    #  ███████  ███   ███  ███   ███  ███   ███   ███████   ████████        ███████  ███  ███   ███  ████████  ███████ 

    changeLinesSegls: ->
    
        oldLines = @s.lines
    
        @s = @s.set 'lines' @segls
        @rowCache = null
        
        if oldLines != @s.lines

            colors = @s.colors

            if colors? and (not empty colors.fg or not empty colors.bg)

                fgSpans = colorspans.adjust (colors.fg ? []) oldLines @s.lines
                bgSpans = colorspans.adjust (colors.bg ? []) oldLines @s.lines

                next =
                    fg: fgSpans
                    bg: bgSpans

                @s = @s.set 'colors' next

            diff = belt.diffLines oldLines @s.lines            
            @emit 'lines.changed' diff

    linesInView: => @s.lines[@lineAtRow(0)...@lineAtRow(@cells.rows-1)+1]

    #  ████████    ███████   ███   ███        ██     ██   ███████   ████████ 
    #  ███   ███  ███   ███  ███ █ ███        ███   ███  ███   ███  ███   ███
    #  ███████    ███   ███  █████████        █████████  █████████  ████████ 
    #  ███   ███  ███   ███  ███   ███        ███ █ ███  ███   ███  ███      
    #  ███   ███   ███████   ██     ██        ███   ███  ███   ███  ███      

    #  the height of a line in rows. most lines are one row high,
    #  a markdown heading is drawn in a block of 2 or 3 rows.

    #  the config controls how markdown headings are scaled, or disables
    #  scaling altogether

    applyScales: conf =>

        @scaling = conf?.enabled != false
        @scales  = conf ? {}
        @rowCache = null

    scaleOfLine: li =>

        ⮐ 1 if not @scaling
        ⮐ 1 if @syntax.ext not in Object.keys @scales

        for clss,scale of @scales[@syntax.ext]
            s = clamp 1 7 scale
            ⮐ s if s > 1 and @syntax.hasClass li clss
        1

    lineHeight: li => @scaleOfLine li

    #  the height of the whole buffer in display rows

    rowPrefix: =>

        ⮐ @rowCache if @rowCache and @rowCacheExt == @syntax.ext

        rows = [0]
        maxWidth = 0

        for li in 0...@s.lines.length
            h = @lineHeight li
            rows.push (rows[li] + h)
            maxWidth = max maxWidth (kseg.width(@s.lines[li]) * h)

        @maxWidthCache = maxWidth
        @rowCacheExt   = @syntax.ext
        @rowCache      = rows

    totalRows: =>

        @rowPrefix()[@s.lines.length]

    #  the display row at which a line starts, relative to the buffer top

    rowsBeforeLine: li =>

        n = @s.lines.length
        li = clamp 0 n li

        @rowPrefix()[li]

    #  the line containing an absolute display row

    lineAtAbsoluteRow: row =>

        n = @s.lines.length
        ⮐ 0 if n == 0

        rows = @rowPrefix()
        row = clamp 0 rows[n]-1 row

        lo = 0
        hi = n-1

        while lo < hi
            mid = int((lo+hi+1)/2)
            if rows[mid] <= row
                lo = mid
            else
                hi = mid-1

        lo

    #  the display row of the first line in the view, relative to the buffer top

    viewTopRow: => @rowsBeforeLine(@s.view[1]) + @s.scrollOffset

    #  the display row of a line, relative to the top of the view

    rowOfLine: li => @rowsBeforeLine(li) - @viewTopRow()

    #  the line at a display row of the view

    lineAtRow: row =>

        @lineAtAbsoluteRow (@viewTopRow() + row)

    #  the line to show at the top so that line li starts at row target

    startForRow: li target =>

        target = max 0 target

        start = li
        rows  = 0

        while start > 0 and rows < target
            start -= 1
            rows += @lineHeight start

        start

    #  the largest line index that can be the top line

    maxViewLine: =>

        h  = 0
        li = @s.lines.length-1

        while li >= 0 and h + @lineHeight(li) <= @cells.rows
            h += @lineHeight li
            li -= 1

        li+1

    #  the largest display row that can sit at the top of the view

    maxTopRow: => @rowsBeforeLine @maxViewLine()

    #  a cursor margin from the config: a row count or a screen percentage

    marginValue: val fallback =>

        ⮐ fallback if not valid val

        if val is str and val.endsWith '%'
            pct = int val[0...-1]
            ⮐ int(@cells.rows * pct / 100)

        ⮐ int val if val is num

        fallback

    viewMargin: name fallback =>

        conf = config.data?.cursor
        ⮐ fallback if not valid conf

        @marginValue (conf[name]) fallback

    #  the logical position of a cell in the editor

    posForCell: x row =>

        li = @lineAtRow row
        h  = @lineHeight li

        [int((x+@s.view[0]) / h) li]

    clearLines: =>

        @setSegls [[]]
        @setMainCursor 0 0

    isValidLineIndex:   li => 0 <= li < @s.lines.length
    isInvalidLineIndex: li => not @isValidLineIndex li

    # ███   ███  ███   ███  ███████     ███████
    # ███   ███  ████  ███  ███   ███  ███   ███
    # ███   ███  ███ █ ███  ███   ███  ███   ███
    # ███   ███  ███  ████  ███   ███  ███   ███
    #  ███████   ███   ███  ███████     ███████

    undo: =>

        ⮐  if @h.length <= 1
        @r.push @h.pop()
        @s = @h[-1]
        @syntax.setSegls @s.lines
        @emit 'colors.changed'

    redo: =>

        ⮐  if empty @r
        @h.push @r.pop()
        @s = @h[-1]
        @syntax.setSegls @s.lines
        @emit 'colors.changed'

    begin: => @beginIndex = @h.length

    end: =>

        if valid @beginIndex

            @h.splice @beginIndex @h.length-@beginIndex-1

            delete @beginIndex
        @

    pushState: => @h.push @s ; @
    swapState: => @h.pop() ; @pushState()

    isDirty: => @h.length > 1
    hasRedo: => @r.length > 0

    gutterWidth: => max 4 2 + ceil(Math.log10(@s.lines.length+1))

    #  ███████  ███   ███  █████████
    # ███       ███   ███     ███
    # ███       ███   ███     ███
    # ███       ███   ███     ███
    #  ███████   ███████      ███

    cut: opt =>

        opt ?= {}

        @copy deselect:false
        
        if empty @s.selections
            @selectCursorLines()
        @deleteSelection()

    #  ███████   ███████   ████████   ███   ███
    # ███       ███   ███  ███   ███   ███ ███
    # ███       ███   ███  ████████     █████
    # ███       ███   ███  ███           ███
    #  ███████   ███████   ███           ███

    copy: opt =>

        opt ?= {}
        
        clip.copy @textOfSelectionOrCursorLines()

        @deselect() if opt.deselect != false

    # ████████    ███████    ███████  █████████  ████████
    # ███   ███  ███   ███  ███          ███     ███
    # ████████   █████████  ███████      ███     ███████
    # ███        ███   ███       ███     ███     ███
    # ███        ███   ███  ███████      ███     ████████

    paste: opt =>

        @insert clip.paste()

    #  ███████   ███████  ████████    ███████   ███      ███          ███   ███  ███  ████████  ███   ███  
    # ███       ███       ███   ███  ███   ███  ███      ███          ███   ███  ███  ███       ███ █ ███  
    # ███████   ███       ███████    ███   ███  ███      ███           ███ ███   ███  ███████   █████████  
    #      ███  ███       ███   ███  ███   ███  ███      ███             ███     ███  ███       ███   ███  
    # ███████    ███████  ███   ███   ███████   ███████  ███████          █      ███  ████████  ██     ██  

    scrollView: dir steps=1 =>

        sx = sy = 0

        switch dir
            'left'  ➜ sx = -1
            'right' ➜ sx =  1
            'up'    ➜ sy = -steps
            'down'  ➜ sy =  steps

        view = @s.view.asMutable()

        view[0] += sx

        topRow     = clamp 0 @maxTopRow() (@viewTopRow() + sy)
        view[1]    = @lineAtAbsoluteRow topRow
        scrollOffset = topRow - @rowsBeforeLine(view[1])

        @rowPrefix()

        cursor      = @mainCursor()
        cursorScale = @lineHeight cursor[1]
        cursorRight = cursor[0]*cursorScale + cursorScale

        maxOffsetX = max 0 @maxWidthCache-@cells.cols+2
        maxOffsetX = max maxOffsetX cursorRight-@cells.cols+2
        view[0] = clamp 0 maxOffsetX view[0]
        
        ⮐  if view eql @s.view and scrollOffset == @s.scrollOffset

        @setView view scrollOffset

    #  ███████   ███████          ███  ███   ███   ███████  █████████       ███   ███  ███  ████████  ███   ███  
    # ███   ███  ███   ███        ███  ███   ███  ███          ███          ███   ███  ███  ███       ███ █ ███  
    # █████████  ███   ███        ███  ███   ███  ███████      ███           ███ ███   ███  ███████   █████████  
    # ███   ███  ███   ███  ███   ███  ███   ███       ███     ███             ███     ███  ███       ███   ███  
    # ███   ███  ███████     ███████    ███████   ███████      ███              █      ███  ████████  ██     ██  
    
    adjustViewForMainCursor: opt =>
        
        opt ?= {}
        
        ⮐  if @cells.cols <= 0 or @cells.rows <= 0
        
        ⮐  if opt.adjust == false

        [x y] = @mainCursor()

        view = @s.view.asMutable()

        topFallback = 7
        botFallback = max topMargin int(@cells.rows/2)

        topMargin = @viewMargin 'topOffset' topFallback
        botMargin = @viewMargin 'bottomOffset' botFallback

        topMargin = clamp 0 @cells.rows topMargin
        botMargin = clamp 0 @cells.rows botMargin

        row     = @rowOfLine y
        height  = @lineHeight y
        topRow  = @viewTopRow()

        if opt.adjust == 'topDelta'

            topRow = @rowsBeforeLine(y) - topMargin

        else if opt.adjust == 'topBotDeltaGrow' and opt.mc

            if row < 0
                topRow = @rowsBeforeLine(y) - topMargin
            else if row + height > @cells.rows
                topRow = @rowsBeforeLine(y) - (@cells.rows - botMargin - height)
            else
                dir = y - opt.mc[1]
                if row < topMargin and dir < 0
                    topRow = @rowsBeforeLine(y) - topMargin
                else if row + height > @cells.rows - botMargin and dir > 0
                    topRow = @rowsBeforeLine(y) - (@cells.rows - botMargin - height)

        else

            topDelta = 0
            botDelta = 0

            if opt.adjust == 'topBotDelta'
                topDelta = topMargin
                botDelta = botMargin

            if row + height > @cells.rows - botDelta
                topRow = @rowsBeforeLine(y) - (@cells.rows - botDelta - height)
            else if row < topDelta
                topRow = @rowsBeforeLine(y) - topDelta

        if opt.adjust in ['topBotDeltaGrow' 'topBotDelta']
            current = @viewTopRow()
            delta = topRow - current

            if delta > 1
                topRow = current + 1
            else if delta < -1
                topRow = current - 1

        topRow = clamp 0 @maxTopRow() topRow

        # soft margins: never let the cursor block leave the viewport,
        # but do not jump the whole line when it can stay visible

        blockTop   = @rowsBeforeLine y
        visibleTop = blockTop + height - @cells.rows

        topRow = max visibleTop topRow
        topRow = min blockTop topRow
        topRow = clamp 0 @maxTopRow() topRow

        view[1] = @lineAtAbsoluteRow topRow
        scrollOffset = topRow - @rowsBeforeLine(view[1])

        if not @skipAdjustViewForMainCursor
            view[0] = max 0 x*height + height + 1 - @cells.cols
        
        ⮐  if view eql @s.view and scrollOffset == @s.scrollOffset
        
        @setView view scrollOffset

    initView: =>

        view = @s.view.asMutable()

        topRow = clamp 0 @maxTopRow() @viewTopRow()
        view[1] = @lineAtAbsoluteRow topRow
        view[0] = max 0 view[0]

        @setView view (topRow - @rowsBeforeLine(view[1]))

    setView: view scrollOffset=0 =>

        scrollOffset ?= 0

        ⮐  if @s.view eql view and @s.scrollOffset == scrollOffset

        @s = @s.set 'view' view
        @s = @s.set 'scrollOffset' scrollOffset
        @swapState()
        @emit 'view.changed' @s.view
        @

    #  put an absolute display row at the top of the view

    setScrollTop: row =>

        row = clamp 0 @maxTopRow() row
        li  = @lineAtAbsoluteRow row
        view = @s.view.asMutable()
        view[1] = li

        @setView view (row - @rowsBeforeLine(li))

    rangeForVisibleLines: =>

        [@s.view[0] @lineAtRow(0) @s.view[0]+@cells.cols-1 @lineAtRow(@cells.rows-1)]

export state
