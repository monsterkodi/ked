###
     ███████  █████████   ███████   █████████  ████████  
    ███          ███     ███   ███     ███     ███       
    ███████      ███     █████████     ███     ███████   
         ███     ███     ███   ███     ███     ███       
    ███████      ███     ███   ███     ███     ████████  

    handles basic text editing for the editor
    wraps text and editor state like cursors and selections 
        in an immutable to simplify undo
    delegates almost all text manipulation to pure functions
        in tool▸belt to simplify testing
###

use ../../kxk ▪ immutable kstr kseg events absMin
use ../../kxk ◆ clip
use ../util   ◆ syntax
use ./act     ◆ del insert select join indent multi main novim
use ./tool    ◆ belt colorspans
use           ◆ keys mode

function state extends events

    @: @cells name ->

        @name = name + '.state'
        
        @allowedModes = {}

        for act in [del insert select join indent multi main novim]
            for k,v of act
                @[k] = v.bind @
                
        @handleKey = keys.bind @

        @syntax   = new syntax @name + '.syntax'
        @hasFocus = false

        #  the display scale of markdown headings: syntax class -> rows
        @scales     = {h1:3 h2:2}
        @scaledExts = ['md' 'markdown' 'kode']
        @scaling    = true

        @yankFlash      = null
        @yankFlashTimer = null

        @clearSingle()

    toggleMode: name => mode.toggle @ name if @allowedModes[name]
    startMode:  name => mode.start  @ name if @allowedModes[name]
    stopMode:   name => mode.stop   @ name if @allowedModes[name]
        
    owner: => 
        
        if @name.endsWith '.state'
            @name[0...-6]
        else
            @name
        
    clearHistory: =>
    
        @h = [@s] # undo states (history)
        @r = []   # redo states

    #  ███████  ████████  █████████
    # ███       ███          ███
    # ███████   ███████      ███
    #      ███  ███          ███
    # ███████   ████████     ███

    set: item arg =>

        @s = @s.set item arg
        @swapState()
        @

    setSelections: selections => @set 'selections' belt.mergeLineRanges(@s.lines selections)
    setHighlights: highlights => @set 'highlights' belt.normalizeSpans(highlights)

    setColorsForRanges: (ranges fg bg voided=[]) =>

        colors = @s.colors
        colors ?= {fg: [], bg: []}

        fgSpans = colors.fg ? []
        bgSpans = colors.bg ? []

        if 'fg' in voided
            fgSpans = colorspans.clear fgSpans ranges
        else if valid fg and not empty fg
            fgSpans = colorspans.overlay fgSpans ranges fg @s.lines

        if 'bg' in voided
            bgSpans = colorspans.clear bgSpans ranges
        else if valid bg and not empty bg
            bgSpans = colorspans.overlay bgSpans ranges bg @s.lines

        next =
            fg: fgSpans
            bg: bgSpans

        ⮐  if @s.colors? and @s.colors eql next

        @s = @s.set 'colors' next
        @r = []
        @pushState()
        @emit 'colors.changed'

    clearColorsForRanges: ranges =>

        colors = @s.colors
        ⮐  if not colors?

        fgSpans = colorspans.clear (colors.fg ? []) ranges
        bgSpans = colorspans.clear (colors.bg ? []) ranges

        next =
            fg: fgSpans
            bg: bgSpans

        ⮐  if colors eql next

        @s = @s.set 'colors' next
        @r = []
        @pushState()
        @emit 'colors.changed'

    clearColorsAtCursorOrSelection: =>

        ranges = @s.selections

        if empty ranges
            if rng = belt.rangeOfClosestWordToPos @s.lines @mainCursor()
                ranges = [rng]

        @clearColorsForRanges ranges if not empty ranges

    colorAtPos: (pos layer) =>

        colors = @s.colors
        ⮐  null if not colors?

        colorspans.colorAtPos (colors[layer] ? []) pos

    loadColors: colors =>

        fgSpans = []
        bgSpans = []

        if colors?
            fgSpans = colors.fg ? []
            bgSpans = colors.bg ? []

        next =
            fg: fgSpans
            bg: bgSpans

        @s = @s.set 'colors' next
        @clearHistory()
        @emit 'colors.changed'

    #  ███████  ███   ███  ████████    ███████   ███████   ████████    ███████
    # ███       ███   ███  ███   ███  ███       ███   ███  ███   ███  ███
    # ███       ███   ███  ███████    ███████   ███   ███  ███████    ███████
    # ███       ███   ███  ███   ███       ███  ███   ███  ███   ███       ███
    #  ███████   ███████   ███   ███  ███████    ███████   ███   ███  ███████

    setCursors: cursors opt =>
        
        opt ?= {}
        opt.mc ?= @mainCursor()
        
        main = opt.main

        if not opt.keepAnchors
            delete @anchors

        if main is arr ➜ main = belt.indexOfPosInPositions main cursors
        if main is num and main < 0 ➜ main = cursors.length+main

        if main?
            mainCursor = copy cursors[clamp 0 cursors.length-1 main]
        else
            mainCursor = @mainCursor()
        
        cursors = belt.normalizePositions cursors @s.lines.length-1
        
        @s = @s.set 'cursors' cursors

        main = -1
        for cur,idx in cursors
            if cur eql mainCursor
                main = idx
                break

        main = @s.main if main < 0
        main = clamp 0 @s.cursors.length-1 main

        @s = @s.set 'main' main
        
        @adjustViewForMainCursor opt
        
        @swapState()
        
        mode.cursorsSet @
        @emit 'cursorsSet'
        @
            
    textOfSelectionOrWordAtCursor: => 
        
        if @s.selections.length
            ⮐  @textOfSelection()
        else
            ⮐  @wordAtCursor()

    # ███      ███  ███   ███  ████████   ███████
    # ███      ███  ████  ███  ███       ███
    # ███      ███  ███ █ ███  ███████   ███████
    # ███      ███  ███  ████  ███            ███
    # ███████  ███  ███   ███  ████████  ███████

    setText: text => 
    
        @setLines text.split(/\r?\n/)

    setLines: lines =>
        
        if empty lines ➜ lines = ['']
        
        @setSegls kseg.segls(lines)
        
    setSegls: @segls =>
        
        if empty @segls ➜ @segls = [[]]
        
        @syntax.setSegls @segls
                    
        @changeLinesSegls()
        
        @r = []
        
        @maxLineWidth = belt.widthOfLines @s.lines
        
        @pushState()
        
    loadLines: lines => 
    
        if valid lines and not lines[0] is str ➜ error "#{@name}.loadLines - first line not a string?" lines[0]
        
        @loadSegls kseg.segls(lines)
    
    loadSegls: segls =>
    
        @clearEmpty()
        @setSegls segls

    clearSingle: => @clearSegls [[]]
    clearEmpty:  => @clearSegls [  ]
    clearSegls: @segls =>
    
        @visual        = null
        @visualAnchors = []
        @novimInsert   = null

        clearTimeout @yankFlashTimer if @yankFlashTimer

        @yankFlash      = null
        @yankFlashTimer = null
    
        @s = immutable
            lines:       @segls
            selections:  []
            highlights:  []
            cursors:     [[0 0]]
            main:        0
            view:        [0 0]
            colors:      {fg: [], bg: []}
            
        @syntax.clear()
        
        @h = []
        @r = []
        
    addLine: line ext =>

        segl = kseg line
        @syntax.addSegl segl ext
        @segls ?= []
        @segls.push segl

        @changeLinesSegls()
        
    appendLines: lines ext =>

        segls = kseg.segls lines
        @syntax.appendSegls segls ext
        @segls ?= []
        @segls = @segls.concat segls

        @changeLinesSegls()
        
    #  ███████  ███   ███   ███████   ███   ███   ███████   ████████        ███      ███  ███   ███  ████████   ███████
    # ███       ███   ███  ███   ███  ████  ███  ███        ███             ███      ███  ████  ███  ███       ███     
    # ███       █████████  █████████  ███ █ ███  ███  ████  ███████         ███      ███  ███ █ ███  ███████   ███████ 
    # ███       ███   ███  ███   ███  ███  ████  ███   ███  ███             ███      ███  ███  ████  ███            ███
    #  ███████  ███   ███  ███   ███  ███   ███   ███████   ████████        ███████  ███  ███   ███  ████████  ███████ 

    changeLinesSegls: ->
    
        oldLines = @s.lines
    
        @s = @s.set 'lines' @segls
        
        if oldLines != @s.lines

            colors = @s.colors

            if colors? and (not empty colors.fg or not empty colors.bg)

                fgSpans = colorspans.adjust (colors.fg ? []) oldLines @s.lines
                bgSpans = colorspans.adjust (colors.bg ? []) oldLines @s.lines

                next =
                    fg: fgSpans
                    bg: bgSpans

                @s = @s.set 'colors' next

            diff = belt.diffLines oldLines @s.lines            
            @emit 'lines.changed' diff

    linesInView: => @s.lines[@s.view[1]...@lineAtRow(@cells.rows-1)+1]

    #  ████████    ███████   ███   ███        ██     ██   ███████   ████████ 
    #  ███   ███  ███   ███  ███ █ ███        ███   ███  ███   ███  ███   ███
    #  ███████    ███   ███  █████████        █████████  █████████  ████████ 
    #  ███   ███  ███   ███  ███   ███        ███ █ ███  ███   ███  ███      
    #  ███   ███   ███████   ██     ██        ███   ███  ███   ███  ███      

    #  the height of a line in rows. most lines are one row high,
    #  a markdown heading is drawn in a block of 2 or 3 rows.

    #  the config controls how markdown headings are scaled, or disables
    #  scaling altogether

    applyScales: conf =>

        @scaling = conf?.enabled != false

        if valid conf?.md
            @scales = conf.md
        else
            @scales = {h1:3 h2:2}

    scaleOfLine: li =>

        ⮐ 1 if not @scaling
        ⮐ 1 if @syntax.ext not in @scaledExts

        for clss,scale of @scales
            s = clamp 1 7 scale
            ⮐ s if s > 1 and @syntax.hasClass li clss

        1

    lineHeight: li => @scaleOfLine li

    #  the display row of a line, relative to the top of the view

    rowOfLine: li =>

        if li < @s.view[1]
            row = 0
            for y in li...@s.view[1]
                row -= @lineHeight y
            ⮐ row

        row = 0
        for y in @s.view[1]...li
            row += @lineHeight y
        row

    #  the line at a display row of the view

    lineAtRow: row =>

        r = 0
        for li in @s.view[1]...@s.lines.length
            h = @lineHeight li
            ⮐ li if row < r+h
            r += h

        max 0 @s.lines.length-1

    #  the line to show at the top so that line li starts at row target

    startForRow: li target =>

        target = max 0 target

        start = li
        rows  = 0

        while start > 0 and rows < target
            start -= 1
            rows += @lineHeight start

        start

    #  the largest line index that can be the top line

    maxViewLine: =>

        h  = 0
        li = @s.lines.length-1

        while li >= 0 and h + @lineHeight(li) <= @cells.rows
            h += @lineHeight li
            li -= 1

        li+1

    #  the logical position of a cell in the editor

    posForCell: x row =>

        li = @lineAtRow row

        [int(x / @lineHeight(li)) + @s.view[0] li]

    clearLines: =>

        @setSegls [[]]
        @setMainCursor 0 0

    isValidLineIndex:   li => 0 <= li < @s.lines.length
    isInvalidLineIndex: li => not @isValidLineIndex li

    # ███   ███  ███   ███  ███████     ███████
    # ███   ███  ████  ███  ███   ███  ███   ███
    # ███   ███  ███ █ ███  ███   ███  ███   ███
    # ███   ███  ███  ████  ███   ███  ███   ███
    #  ███████   ███   ███  ███████     ███████

    undo: =>

        ⮐  if @h.length <= 1
        @r.push @h.pop()
        @s = @h[-1]
        @syntax.setSegls @s.lines
        @emit 'colors.changed'

    redo: =>

        ⮐  if empty @r
        @h.push @r.pop()
        @s = @h[-1]
        @syntax.setSegls @s.lines
        @emit 'colors.changed'

    begin: => @beginIndex = @h.length

    end: =>

        if valid @beginIndex

            @h.splice @beginIndex @h.length-@beginIndex-1

            delete @beginIndex
        @

    pushState: => @h.push @s ; @
    swapState: => @h.pop() ; @pushState()

    isDirty: => @h.length > 1
    hasRedo: => @r.length > 0

    gutterWidth: => max 4 2 + ceil(Math.log10(@s.lines.length+1))

    #  ███████  ███   ███  █████████
    # ███       ███   ███     ███
    # ███       ███   ███     ███
    # ███       ███   ███     ███
    #  ███████   ███████      ███

    cut: opt =>

        opt ?= {}

        @copy deselect:false
        
        if empty @s.selections
            @selectCursorLines()
        @deleteSelection()

    #  ███████   ███████   ████████   ███   ███
    # ███       ███   ███  ███   ███   ███ ███
    # ███       ███   ███  ████████     █████
    # ███       ███   ███  ███           ███
    #  ███████   ███████   ███           ███

    copy: opt =>

        opt ?= {}
        
        clip.copy @textOfSelectionOrCursorLines()

        @deselect() if opt.deselect != false

    # ████████    ███████    ███████  █████████  ████████
    # ███   ███  ███   ███  ███          ███     ███
    # ████████   █████████  ███████      ███     ███████
    # ███        ███   ███       ███     ███     ███
    # ███        ███   ███  ███████      ███     ████████

    paste: opt =>

        @insert clip.paste()

    #  ███████   ███████  ████████    ███████   ███      ███          ███   ███  ███  ████████  ███   ███  
    # ███       ███       ███   ███  ███   ███  ███      ███          ███   ███  ███  ███       ███ █ ███  
    # ███████   ███       ███████    ███   ███  ███      ███           ███ ███   ███  ███████   █████████  
    #      ███  ███       ███   ███  ███   ███  ███      ███             ███     ███  ███       ███   ███  
    # ███████    ███████  ███   ███   ███████   ███████  ███████          █      ███  ████████  ██     ██  

    scrollView: dir steps=1 =>

        sx = sy = 0

        switch dir
            'left'  ➜ sx = -1
            'right' ➜ sx =  1
            'up'    ➜ sy = -steps
            'down'  ➜ sy =  steps

        view = @s.view.asMutable()

        view[0] += sx
        view[1] += sy

        view[1] = clamp 0 @maxViewLine() view[1]

        maxOffsetX = max 0 @maxLineWidth-int(@cells.cols/@lineHeight(@mainCursor()[1]))+2
        maxOffsetX = max maxOffsetX @mainCursor()[0]-int(@cells.cols/@lineHeight(@mainCursor()[1]))+2
        view[0] = clamp 0 maxOffsetX view[0]
        
        ⮐  if view eql @s.view

        @setView view

    #  ███████   ███████          ███  ███   ███   ███████  █████████       ███   ███  ███  ████████  ███   ███  
    # ███   ███  ███   ███        ███  ███   ███  ███          ███          ███   ███  ███  ███       ███ █ ███  
    # █████████  ███   ███        ███  ███   ███  ███████      ███           ███ ███   ███  ███████   █████████  
    # ███   ███  ███   ███  ███   ███  ███   ███       ███     ███             ███     ███  ███       ███   ███  
    # ███   ███  ███████     ███████    ███████   ███████      ███              █      ███  ████████  ██     ██  
    
    adjustViewForMainCursor: opt =>
        
        opt ?= {}
        
        ⮐  if @cells.cols <= 0 or @cells.rows <= 0
        
        ⮐  if opt.adjust == false

        [x y] = @mainCursor()

        view = @s.view.asMutable()
        
        topBotDelta = 7
        topDelta = 7
        botDelta = max topDelta int(@cells.rows/2)

        row    = @rowOfLine y
        height = @lineHeight y
        
        if opt.adjust == 'topDelta'

            view[1] = @startForRow y topDelta
            
        else if opt.adjust == 'topBotDeltaGrow' and opt.mc
        
            if row < 0
                view[1] = @startForRow y topDelta
            else if row + height > @cells.rows
                view[1] = @startForRow y (@cells.rows - botDelta - height)
            else
                dir = y - opt.mc[1]
                if row < topDelta and dir < 0
                    view[1] = @startForRow y topDelta
                else if row + height > @cells.rows - botDelta and dir > 0
                    view[1] = @startForRow y (@cells.rows - botDelta - height)
        else        
        
            if opt.adjust != 'topBotDelta'
                topBotDelta = 0
    
            if row + height > @cells.rows - topBotDelta
                view[1] = @startForRow y (@cells.rows - topBotDelta - height)
            else if row < topBotDelta
                view[1] = @startForRow y topBotDelta

        view[1] = min view[1] @maxViewLine()

        if not @skipAdjustViewForMainCursor
            cols = max 1 int(@cells.cols / height)
            view[0] = max 0 x - cols + 2 # adding one for wide graphemes
        
        ⮐  if view eql @s.view
        
        @setView view

    initView: =>

        view = @s.view.asMutable()
        
        view[1] = clamp 0 @maxViewLine() view[1]
        view[0] = max 0 view[0]

        @setView view

    setView: view =>
        
        ⮐  if @s.view eql view
        @set 'view' view
        @emit 'view.changed' @s.view
        @

    rangeForVisibleLines: =>

        [@s.view[0] @s.view[1] @s.view[0]+@cells.cols-1 @s.view[1]+@cells.rows-1]

export state
