
use ../../kxk ▪ immutable kstr kseg events absMin post
use ../../kxk ◆ clip
use ../util   ◆ syntax config
use ./act     ◆ del insert select join indent multi main novim sort count range macro
use ./tool    ◆ belt colorspans jumplist changelist motion sue register
use           ◆ keys mode

■state□events
    ###
  󠀡󠀰󠀰󠀱󠀱󠁛󠀴󠀰󠀬󠀭󠀱󠀬󠀱󠀬󠀲󠁝handles basic text editing for the 󠀡󠀰󠀰󠀲󠀸󠁛󠀳󠀳󠀬󠀶󠀬󠀱󠀬󠀢󠀣󠁦󠁦󠁦󠁦󠀰󠀰󠀢󠀬󠀢󠀣󠀰󠀰󠀰󠀰󠀰󠀰󠀢󠁝editor
    wraps text and editor state like cursors and selections in an immutable to simplify undo
    delegates almost all text manipulation to pure functions in tool▸belt to simplify testing
    ###

    @: @cells name ->

        @name = name + '.state'
        
        @novim = novim.novimState()

        @allowedModes   = {}

        for act in [del insert select join indent multi main novim sort count range macro]
            for k,v of act
                @[k] = v.bind @

        @keyHandler = keys.bind @
        @handleKey  = @handleKeyWithRecording

        @syntax   = new syntax @name + '.syntax'
        @hasFocus = false

        #  the display scale of markdown headings: syntax class -> rows
        @scales     = {h1:3 h2:2}
        @scaledExts = ['md' 'markdown' 'kode']
        @scaling    = true

        @rowCache       = null
        @rowCacheExt    = null
        @maxWidthCache  = 0
        @gutterWidthOverride = null

        @clearSingle()

    toggleMode: name => mode.toggle @ name if @allowedModes[name]
    startMode:  name => mode.start  @ name if @allowedModes[name]
    stopMode:   name => mode.stop   @ name if @allowedModes[name]
        
    owner: => 
        
        if @name.endsWith '.state'
            @name[0...-6]
        else
            @name
        
    clearHistory: =>
    
        @h = [@s] # undo states (history)
        @r = []   # redo states

#!set

    set: item arg =>

        @s = @s.set item arg
        @swapState()
        @

    setSelections: (selections keepEmpty) => @set 'selections' belt.mergeLineRanges(@s.lines selections keepEmpty)
    setHighlights: highlights => @set 'highlights' belt.normalizeSpans(highlights)

    colorAtPos: (pos layer) =>

        colors = @s.colors
        ⮐ if not colors?

        colorspans.colorAtPos (colors[layer] ? []) pos

#!sue

    sueAt: pos =>

        areas = @s.sue ? []
        ⮐ if empty areas

        [x y] = pos

        for i in areas.length-1..0
            area = areas[i]
            if area.y == y and area.x <= x
                ⮐ area

    setSue: (x y value) =>

        areas = @s.sue ? []
        @changeSue areas.concat([{x: x y: y value: value}])
        
    changeSue: areas =>

        @s = @s.set 'sue' areas
        @rowCache = null
        @r = []
        @pushState()
        @emit 'sue.changed'
        
    loadSue: areas =>

        @s = @s.set 'sue' (areas ? [])
        @rowCache = null
        @clearHistory()
        @emit 'sue.changed'
        
    applySueAreas: next =>

        areas = @s.sue ? []
        ⮐ if next eql areas

        @changeSue next

    clearSueForRanges: ranges =>

        areas = @s.sue ? []
        ⮐ if empty areas or empty ranges

        ranges = belt.splitLineRanges @s.lines ranges false

        cut = sue.rangesCutFromAreasInLines ranges areas @s.lines

        ⮐ if cut eql areas

        @changeSue cut

    toggleSueFlag: flag =>

        ranges = @selectionsOrCursorWordRanges()
        ⮐ if empty ranges

        ranges = belt.splitLineRanges @s.lines ranges false

        next = sue.rangesWithToggledFlag ranges (@s.sue ? []) @s.lines flag

        ⮐ if next eql @s.sue

        @changeSue next

    areasWithSteppedLineScales: (areas indices delta) =>

        ⮐ areas if empty indices

        scales = []

        for y in indices
            scales.push clamp(1 7 (@lineHeight(y) + delta))

        keep = @areasWithoutLineScales(areas indices)

        for y,i in indices
            if scales[i] > 1
                keep.push {x: 0 y: y value: [sue.LINE_SCALE -1 1 scales[i]]} 
        keep

    areasWithoutLineScales: (areas indices) =>

        keep = []

        for area in areas
            continue if area.y in indices and area.value[0] == sue.LINE_SCALE
            keep.push area

        keep

    areasWithRun: (areas y x1 x2 scale) =>

        open  = {x: x1 y: y value: [sue.SCALE -1 1 scale]}
        close = {x: x2 y: y value: [sue.CLOSE -1 1 sue.SCALE]}

        areas.concat([open close])

    areasWithRunScale: (areas y x1 scale) =>

        out = []

        for area in areas
            if area.y == y and area.x == x1 and area.value[0] == sue.SCALE
                out.push {x: area.x y: area.y value: [sue.SCALE -1 1 scale]}
            else
                out.push area

        out

    areasWithoutRun: (areas y x1 x2) =>

        out = []

        for area in areas

            if area.y == y and area.x == x1 and area.value[0] == sue.SCALE
                continue

            if area.y == y and area.x == x2 and area.value[0] == sue.CLOSE
                data = sue.dataOf(area.value)
                continue if empty data or data[0] == sue.SCALE

            out.push area

        out

    areasWithSteppedRuns: (areas pieces delta) =>

        for piece in pieces

            [x1 y x2] = piece

            continue if x1 >= x2

            run = null

            for r in sue.runsForLine(areas @s.lines y)
                if r[0] <= x1 and x2 <= r[1]
                    run = r
                    break

            if run?
                scale = clamp(1 7 (run[2] + delta))
                if scale <= 1
                    areas = @areasWithoutRun(areas y run[0] run[1])
                else
                    areas = @areasWithRunScale(areas y run[0] scale)
            else if delta > 0
                scale = clamp(1 7 (1 + delta))
                areas = @areasWithRun(areas y x1 x2 scale) if scale > 1

        areas

    stepScales: delta =>

        areas = @s.sue ? []
        next  = areas

        if empty @s.selections
            indices = belt.lineIndicesForPositions @s.cursors
            next = @areasWithSteppedLineScales(areas indices delta)
        else
            lines = []
            runs  = []

            for piece in belt.splitLineRanges(@s.lines @s.selections false)
                if belt.isFullLineRange @s.lines piece
                    lines.push piece[1] if piece[1] not in lines
                else
                    runs.push piece

            next = @areasWithSteppedLineScales(next lines delta)
            next = @areasWithSteppedRuns(next runs delta)

        @applySueAreas next

    clearScales: =>

        areas = @s.sue ? []
        indices = belt.lineIndicesForRangesOrPositions @s.selections @s.cursors

        next = @areasWithoutLineScales(areas indices)

        for piece in belt.splitLineRanges(@s.lines @s.selections false)
            continue if belt.isFullLineRange @s.lines piece
            for run in sue.runsForLine(next @s.lines piece[1])
                if run[0] <= piece[0] and piece[2] <= run[1]
                    next = @areasWithoutRun(next piece[1] run[0] run[1])
                    break

        @applySueAreas next

    scaleRunsForLine: y =>

        areas = @s.sue ? []
        ⮐ [] if empty areas

        sue.runsForLine(areas @s.lines y)

    clearSueAtCursorOrSelection: =>

        if ranges = @selectionsOrCursorWordRanges()
            @clearSueForRanges ranges

#!cursors

    setCursors: cursors opt =>
        
        opt ?= {}
        opt.mc ?= @mainCursor()
        
        main = opt.main

        if not opt.keepAnchors
            delete @anchors

        if main is arr ➜ main = belt.indexOfPosInPositions main cursors
        if main is num and main < 0 ➜ main = cursors.length+main

        if main?
            mainCursor = copy cursors[clamp 0 cursors.length-1 main]
        else
            mainCursor = @mainCursor()
        
        cursors = belt.normalizePositions cursors @s.lines.length-1
        
        @s = @s.set 'cursors' cursors

        main = -1
        for cur,idx in cursors
            if cur eql mainCursor
                main = idx
                break

        main = @s.main if main < 0
        main = clamp 0 @s.cursors.length-1 main

        @s = @s.set 'main' main
        
        @adjustViewForMainCursor opt
        
        @swapState()

        if not opt.silent
            mode.cursorsSet @
            @emit 'cursorsSet'
        @
            
    textOfSelectionOrWordAtCursor: => 
        
        if @s.selections.length
            ⮐ @textOfSelection()
        else
            ⮐ @wordAtCursor()

#!lines

    setText: text => 
    
        @setLines text.split(/\r?\n/)

    setLines: lines =>
        
        if empty lines ➜ lines = ['']
        
        @setSegls kseg.segls(lines)
        
    setSegls: @segls =>
        
        if empty @segls ➜ @segls = [[]]
        
        @changeLinesSegls()
        
        @syntax.setSegls @s.lines
        
        @r = []
        
        @pushState()
        
    loadLines: lines => 
    
        if valid lines and not lines[0] is str ➜ error "#{@name}.loadLines - first line not a string?" lines[0]
        
        @loadSegls kseg.segls(lines)
    
    loadSegls: segls =>
    
        @clearEmpty()
        @setSegls segls

    clearSingle: => @clearSegls [[]]
    clearEmpty:  => @clearSegls [  ]
    clearSegls: @segls =>
    
        clearTimeout @novim.yankFlashTimer if @novim.yankFlashTimer

        @novim.visualAnchors  = []
        @novim.visual         = null
        @novim.lastVisual     = null
        @novim.insert         = null
        @novim.yankFlash      = null
        @novim.yankFlashTimer = null
    
        @s = immutable
            lines:       @segls
            selections:  []
            highlights:  []
            cursors:     [[0 0]]
            main:        0
            view:        [0 0]
            scrollOffset: 0
            colors:      {fg: [], bg: []}
            sue:         []
            rectree:     null
            rectreeCols: null
            rectreeRows: null
            
        @syntax.clear()

        @rowCache = null
        
        @h = []
        @r = []

        @novim.changes.reset()

        @beginIndices = []
        delete @beginIndex
        
    addLine: line ext =>

        segl = kseg line
        @syntax.addSegl segl ext
        @segls ?= []
        @segls.push segl

        @changeLinesSegls()
        
    appendLines: lines ext =>

        segls = kseg.segls lines
        @syntax.appendSegls segls ext
        @segls ?= []
        @segls = @segls.concat segls

        @changeLinesSegls()
        
#!change lines

    changeLinesSegls: ->
    
        oldLines = @s.lines
    
        @s = @s.set 'lines' @segls
        @rowCache = null
        
        if oldLines != @s.lines

            @novim.changes.record @mainCursor() if @h.length

            colors = @s.colors

            if colors? and (not empty colors.fg or not empty colors.bg)

                fgSpans = colorspans.adjust (colors.fg ? []) oldLines @s.lines
                bgSpans = colorspans.adjust (colors.bg ? []) oldLines @s.lines

                next =
                    fg: fgSpans
                    bg: bgSpans

                @s = @s.set 'colors' next

            areas = @s.sue

            if not empty areas
                @s = @s.set 'sue' sue.adjust(areas oldLines @s.lines)

            diff = belt.diffLines oldLines @s.lines            
            @emit 'lines.changed' diff

    linesInView: => @s.lines[@lineAtRow(0)...@lineAtRow(@cells.rows-1)+1]

    applyScales: conf =>

        @scaling = conf?.enable != false
        @scales  = conf ? {}
        @rowCache = null

    lineHeight: li =>

        for area in (@s.sue ? [])
            if area.y == li and area.value[0] == sue.LINE_SCALE
                ⮐ clamp 1 7 int(area.value[3] ? 1)

        if @syntax.scaleOfLine is func
            ⮐ @syntax.scaleOfLine @scales @scaling li
        1    

    rowPrefix: =>

        ⮐ @rowCache if @rowCache and @rowCacheExt == @syntax.ext

        @lineWidths ?= new WeakMap()

        rows     = [0]
        maxWidth = 0

        for li in 0...@s.lines.length

            line   = @s.lines[li]
            height = @lineHeight li

            width = null

            if line is arr
                width = @lineWidths.get line

            if not width?
                width = kseg.width line
                @lineWidths.set line width if line is arr

            width = width * height
            maxWidth = width if width > maxWidth
            rows.push rows[li] + height

        @maxWidthCache = maxWidth
        @rowCacheExt   = @syntax.ext
        @rowCache      = rows

    totalRows: =>

        @rowPrefix()[@s.lines.length]

    rowsBeforeLine: li =>

        n = @s.lines.length
        li = clamp 0 n li

        @rowPrefix()[li]

    lineAtAbsoluteRow: row =>

        n = @s.lines.length
        ⮐ 0 if n == 0

        rows = @rowPrefix()
        row = clamp 0 rows[n]-1 row

        lo = 0
        hi = n-1

        while lo < hi
            mid = int((lo+hi+1)/2)
            if rows[mid] <= row
                lo = mid
            else
                hi = mid-1

        lo

    viewTopRow: => @rowsBeforeLine(@s.view[1]) + @s.scrollOffset

    rowOfLine: li => @rowsBeforeLine(li) - @viewTopRow()

    lineAtRow: row =>

        @lineAtAbsoluteRow (@viewTopRow() + row)

    startForRow: li target =>

        target = max 0 target

        start = li
        rows  = 0

        while start > 0 and rows < target
            start -= 1
            rows += @lineHeight start

        start

    maxViewLine: =>

        h  = 0
        li = @s.lines.length-1

        while li >= 0 and h + @lineHeight(li) <= @cells.rows
            h += @lineHeight li
            li -= 1

        li+1

    maxTopRow: => @rowsBeforeLine @maxViewLine()

    marginValue: val fallback =>

        ⮐ fallback if not valid val

        if val is str and val.endsWith '%'
            pct = int val[0...-1]
            ⮐ int(@cells.rows * pct / 100)

        ⮐ int val if val is num

        fallback

    viewMargin: name fallback =>

        conf = config.data?.cursor
        ⮐ fallback if not valid conf

        @marginValue (conf[name]) fallback

    posForCell: x row =>

        li = @lineAtRow row
        h  = @lineHeight li

        [int((x+@s.view[0]) / h) li]

    clearLines: =>

        @setSegls [[]]
        @setMainCursor 0 0

    isValidLineIndex:   li => 0 <= li < @s.lines.length
    isInvalidLineIndex: li => not @isValidLineIndex li

#!window

    windowLine: kind count=1 ->

        rows   = max 1 @cells.rows
        top    = @lineAtRow 0
        bottom = @lineAtRow rows-1
        n      = max 1 (count ? 1)

        switch kind
            'windowTop'    ➜ clamp top bottom (top+n-1)
            'windowBottom' ➜ clamp top bottom (bottom-n+1)
            ➜ @lineAtRow int((rows-1)/2)

    moveCursorsToWindowLine: kind count=1 ->

        line = @windowLine kind count
        x    = belt.lineIndentAtPos @s.lines [0 line]
        cursors = @allCursors()

        for c in cursors
            c[0] = x
            c[1] = line

        @setCursors cursors main:@s.main

    windowMotionRange: cursor spec ->

        line = @windowLine spec.kind (spec.count ? 1)
        y1   = min cursor[1] line
        y2   = max cursor[1] line

        [0 y1 kseg.width(@s.lines[y2]) y2]

    rangeForMotion: cursor spec ->

        if spec.kind in ['windowTop' 'windowMiddle' 'windowBottom']
            ⮐ @windowMotionRange cursor spec

        motion.range @s.lines cursor spec

#!changes

    jumpChangeOlder: (count=1) ->

        n = max 1 (count ? 1)
        moved = false

        for i in 0...n
            pos = @novim.changes.older()
            break if not pos
            @setMainCursor pos[0] pos[1]
            moved = true

        moved

    jumpChangeNewer: (count=1) ->

        n = max 1 (count ? 1)
        moved = false

        for i in 0...n
            pos = @novim.changes.newer()
            break if not pos
            @setMainCursor pos[0] pos[1]
            moved = true

        moved

#!jumps

    currentFile: ->

        session = global.ked_session

        ⮐ if not session?.get

        session.get 'editor▸file'

    jumpEntry: pos ->

        pos ?= @mainCursor()

        file: @currentFile()
        x:    pos[0]
        y:    pos[1]

    pushJump: pos ->

        ⮐ false if @novim.jumps.keep

        @novim.jumps.record(@jumpEntry(pos))

        true

    jumpOlder: (count=1) ->

        n = max 1 (count ? 1)
        moved = false

        for i in 0...n
            entry = @novim.jumps.older @jumpEntry()
            break if not entry
            @jumpToEntry entry
            moved = true

        moved

    jumpNewer: (count=1) ->

        n = max 1 (count ? 1)
        moved = false

        for i in 0...n
            entry = @novim.jumps.newer()
            break if not entry
            @jumpToEntry entry
            moved = true

        moved

    jumpToEntry: entry ->

        file = @currentFile()

        if valid entry.file and entry.file != file
            post.emit 'file.open' entry.file entry.x entry.y
        else
            @setMainCursor entry.x entry.y

        true

#!undo

    undo: =>

        ⮐ if @h.length <= 1
        @r.push @h.pop()
        @s = @h[-1]
        @segls = @s.lines.slice()
        @rowCache = null
        @syntax.setSegls @s.lines
        @restoreSheet()
        @emit 'colors.changed'

    redo: =>

        ⮐ if empty @r
        @h.push @r.pop()
        @s = @h[-1]
        @segls = @s.lines.slice()
        @rowCache = null
        @syntax.setSegls @s.lines
        @restoreSheet()
        @emit 'colors.changed'

    begin: =>
        @beginIndices ?= []
        @beginIndices.push @h.length
        @beginIndex = @beginIndices[-1]

    end: =>

        if @beginIndices?.length

            index = @beginIndices.pop()

            @h.splice index @h.length-index-1

            if @beginIndices.length
                @beginIndex = @beginIndices[-1]
            else
                delete @beginIndex
        @

    pushState: => @h.push @s ; @
    swapState: => @h.pop() ; @pushState()

    isDirty: => @h.length > 1
    hasRedo: => @r.length > 0

    gutterWidth: => 
        ⮐ @gutterWidthOverride if @gutterWidthOverride?
        max 4 2 + ceil(Math.log10(@s.lines.length+1))

#!cut

    cut: opt =>

        opt ?= {}

        @copy deselect:false
        
        if empty @s.selections
            @selectCursorLines()
        @deleteSelection()

    copy: opt =>

        opt ?= {}
        
        clip.copy @textOfSelectionOrCursorLines()

        @deselect() if opt.deselect != false

    paste: opt =>

        @insert clip.paste()

#!scroll

    scrollView: dir steps=1 =>

        sx = sy = 0

        switch dir
            'left'  ➜ sx = -1
            'right' ➜ sx =  1
            'up'    ➜ sy = -steps
            'down'  ➜ sy =  steps

        view = @s.view.asMutable()

        view[0] += sx

        topRow     = clamp 0 @maxTopRow() (@viewTopRow() + sy)
        view[1]    = @lineAtAbsoluteRow topRow
        scrollOffset = topRow - @rowsBeforeLine(view[1])

        @rowPrefix()

        cursor      = @mainCursor()
        cursorScale = @lineHeight cursor[1]
        cursorRight = cursor[0]*cursorScale + cursorScale

        maxOffsetX = max 0 @maxWidthCache-@cells.cols+2
        maxOffsetX = max maxOffsetX cursorRight-@cells.cols+2
        view[0] = clamp 0 maxOffsetX view[0]
        
        ⮐ if view eql @s.view and scrollOffset == @s.scrollOffset

        @setView view scrollOffset

#!adjust
    
    adjustViewForMainCursor: opt =>
        
        opt ?= {}
        
        ⮐ if @cells.cols <= 0 or @cells.rows <= 0
        
        ⮐ if opt.adjust == false

        [x y] = @mainCursor()

        view = @s.view.asMutable()

        topFallback = 7
        botFallback = max topMargin int(@cells.rows/2)

        topMargin = @viewMargin 'topOffset' topFallback
        botMargin = @viewMargin 'bottomOffset' botFallback

        topMargin = clamp 0 @cells.rows topMargin
        botMargin = clamp 0 @cells.rows botMargin

        row     = @rowOfLine y
        height  = @lineHeight y
        topRow  = @viewTopRow()

        if opt.adjust == 'topDelta'

            topRow = @rowsBeforeLine(y) - topMargin

        else if opt.adjust == 'topBotDeltaGrow' and opt.mc

            if row < 0
                topRow = @rowsBeforeLine(y) - topMargin
            else if row + height > @cells.rows
                topRow = @rowsBeforeLine(y) - (@cells.rows - botMargin - height)
            else
                dir = y - opt.mc[1]
                if row < topMargin and dir < 0
                    topRow = @rowsBeforeLine(y) - topMargin
                else if row + height > @cells.rows - botMargin and dir > 0
                    topRow = @rowsBeforeLine(y) - (@cells.rows - botMargin - height)

        else

            topDelta = 0
            botDelta = 0

            if opt.adjust == 'topBotDelta'
                topDelta = topMargin
                botDelta = botMargin

            if row + height > @cells.rows - botDelta
                topRow = @rowsBeforeLine(y) - (@cells.rows - botDelta - height)
            else if row < topDelta
                topRow = @rowsBeforeLine(y) - topDelta

        if opt.adjust in ['topBotDeltaGrow' 'topBotDelta']
            current = @viewTopRow()
            delta = topRow - current

            if delta > 1
                topRow = current + 1
            else if delta < -1
                topRow = current - 1

        topRow = clamp 0 @maxTopRow() topRow

        blockTop   = @rowsBeforeLine y
        visibleTop = blockTop + height - @cells.rows

        topRow = max visibleTop topRow
        topRow = min blockTop topRow
        topRow = clamp 0 @maxTopRow() topRow

        view[1] = @lineAtAbsoluteRow topRow
        scrollOffset = topRow - @rowsBeforeLine(view[1])

        if not @skipAdjustViewForMainCursor
            view[0] = max 0 x*height + height + 1 - @cells.cols
        
        ⮐ if view eql @s.view and scrollOffset == @s.scrollOffset
        
        @setView view scrollOffset

    initView: =>

        view = @s.view.asMutable()

        topRow = clamp 0 @maxTopRow() @viewTopRow()
        view[1] = @lineAtAbsoluteRow topRow
        view[0] = max 0 view[0]

        @setView view (topRow - @rowsBeforeLine(view[1]))

    setView: view scrollOffset=0 =>

        scrollOffset ?= 0

        ⮐ if @s.view eql view and @s.scrollOffset == scrollOffset

        @s = @s.set 'view' view
        @s = @s.set 'scrollOffset' scrollOffset
        @swapState()
        @emit 'view.changed' @s.view
        @

    setScrollTop: row =>

        row = clamp 0 @maxTopRow() row
        li  = @lineAtAbsoluteRow row
        view = @s.view.asMutable()
        view[1] = li

        @setView view (row - @rowsBeforeLine(li))

    rangeForVisibleLines: =>

        [@s.view[0] @lineAtRow(0) @s.view[0]+@cells.cols-1 @lineAtRow(@cells.rows-1)]

export state
