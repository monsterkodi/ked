
use ../../kxk ▪ immutable kstr kseg events absMin post
use ../../kxk ◆ clip
use ../util   ◆ syntax config
use ./act     ◆ del insert select join indent multi main novim sort count range macro jump sheet
use ./tool    ◆ belt colorspans jumplist changelist motion sue register
use           ◆ mode keys

import suact from './act/sue.js'

■state□events
    ###
  󠀡󠀰󠀰󠀱󠀱󠁛󠀴󠀰󠀬󠀭󠀱󠀬󠀱󠀬󠀲󠁝handles basic text editing for the 󠀡󠀰󠀰󠀲󠀸󠁛󠀳󠀳󠀬󠀶󠀬󠀱󠀬󠀢󠀣󠁦󠁦󠁦󠁦󠀰󠀰󠀢󠀬󠀢󠀣󠀰󠀰󠀰󠀰󠀰󠀰󠀢󠁝editor
    wraps text and editor state like cursors and selections in an immutable to simplify undo
    delegates almost all text manipulation to pure functions in tool▸belt to simplify testing
    ###

    @: @cells name ->

        @name = name + '.state'
        
        @novim = novim.novimState()

        @allowedModes   = {}

        for act in [del insert select join indent multi main jump novim sort count range macro sheet suact]
            for k,v of act
                @[k] = v.bind @
                
        @handleKey = keys
        @hasFocus  = false

        @syntax    = new syntax @name + '.syntax'

        @scaling    = true
        @scales     = h1:3 h2:2
        @scaledExts = ['md' 'markdown' 'kode']

        @wrap = all:false word:true

        @rowCache       = null
        @rowCacheExt    = null
        @maxWidthCache  = 0
        @gutterWidthOverride = null

        @clearSingle()

    toggleMode: name => mode.toggle @ name if @allowedModes[name]
    startMode:  name => mode.start  @ name if @allowedModes[name]
    stopMode:   name => mode.stop   @ name if @allowedModes[name]
        
    owner: => 
        
        if @name.endsWith '.state'
            @name[0...-6]
        else
            @name
        
    clearHistory: =>
    
        @h = [@s] # undo states (history)
        @r = []   # redo states

#!set

    set: item arg =>

        @s = @s.set item arg
        @swapState()
        @

    setSelections: (selections keepEmpty) => @set 'selections' belt.mergeLineRanges(@s.lines selections keepEmpty)
    setHighlights: highlights => @set 'highlights' belt.normalizeSpans(highlights)

    colorAtPos: (pos layer) =>

        colors = @s.colors
        ⮐ if not colors?

        colorspans.colorAtPos (colors[layer] ? []) pos

#!cursors

    setCursors: cursors opt =>
        
        opt ?= {}
        opt.mc ?= @mainCursor()
        
        main = opt.main

        if not opt.keepAnchors
            delete @anchors

        if main is arr ➜ main = belt.indexOfPosInPositions main cursors
        if main is num and main < 0 ➜ main = cursors.length+main

        cursors = @clampToWrap cursors

        if main?
            mainCursor = copy cursors[clamp 0 cursors.length-1 main]
        else
            mainCursor = @mainCursor()
        
        cursors = belt.normalizePositions cursors @s.lines.length-1
        
        @s = @s.set 'cursors' cursors

        main = -1
        for cur,idx in cursors
            if cur eql mainCursor
                main = idx
                break

        main = @s.main if main < 0
        main = clamp 0 @s.cursors.length-1 main

        @s = @s.set 'main' main
        
        @adjustViewForMainCursor opt
        
        @swapState()

        if not opt.silent
            mode.cursorsSet @
            @emit 'cursorsSet'
        @
            
    textOfSelectionOrWordAtCursor: => 
        
        if @s.selections.length
            ⮐ @textOfSelection()
        else
            ⮐ @wordAtCursor()

#!lines

    setText: text => 
    
        @setLines text.split(/\r?\n/)

    setLines: lines =>
        
        if empty lines ➜ lines = ['']
        
        @setSegls kseg.segls(lines)
        
    setSegls: @segls =>
        
        if empty @segls ➜ @segls = [[]]
        
        @changeLinesSegls()
        
        @syntax.setSegls @s.lines
        
        @r = []
        
        @pushState()
        
    loadLines: lines => 
    
        if valid lines and not lines[0] is str ➜ error "#{@name}.loadLines - first line not a string?" lines[0]
        
        @loadSegls kseg.segls(lines)
    
    loadSegls: segls =>
    
        @clearEmpty()
        @setSegls segls

    clearSingle: => @clearSegls [[]]
    clearEmpty:  => @clearSegls [  ]
    clearSegls: @segls =>
    
        clearTimeout @novim.yankFlashTimer if @novim.yankFlashTimer

        @novim.visualAnchors  = []
        @novim.visual         = null
        @novim.lastVisual     = null
        @novim.insert         = null
        @novim.yankFlash      = null
        @novim.yankFlashTimer = null
    
        @s = immutable
            lines:       @segls
            selections:  []
            highlights:  []
            cursors:     [[0 0]]
            main:        0
            view:        [0 0]
            scrollOffset: 0
            colors:      {fg: [], bg: []}
            sue:         []
            rectree:     null
            
        @syntax.clear()

        @rowCache = null
        
        @h = []
        @r = []

        @novim.changes.reset()

        @beginIndices = []
        delete @beginIndex
        
    addLine: line ext =>

        segl = kseg line
        @syntax.addSegl segl ext
        @segls ?= []
        @segls.push segl

        @changeLinesSegls()
        
    appendLines: lines ext =>

        segls = kseg.segls lines
        @syntax.appendSegls segls ext
        @segls ?= []
        @segls = @segls.concat segls

        @changeLinesSegls()
        
#!change lines

    changeLinesSegls: ->
    
        oldLines = @s.lines
    
        @s = @s.set 'lines' @segls
        @rowCache = null
        
        if oldLines != @s.lines

            @novim.changes.record @mainCursor() if @h.length

            colors = @s.colors

            if colors? and (not empty colors.fg or not empty colors.bg)

                fgSpans = colorspans.adjust (colors.fg ? []) oldLines @s.lines
                bgSpans = colorspans.adjust (colors.bg ? []) oldLines @s.lines

                next =
                    fg: fgSpans
                    bg: bgSpans

                @s = @s.set 'colors' next

            areas = @s.sue

            if not empty areas
                @s = @s.set 'sue' sue.adjust(areas oldLines @s.lines)

            diff = belt.diffLines oldLines @s.lines            
            @emit 'lines.changed' diff

    linesInView: => @s.lines[@lineAtRow(0)...@lineAtRow(@cells.rows-1)+1]

    applyScales: conf =>

        @scaling = conf?.enable != false
        @scales  = conf ? {}
        @rowCache = null

    lineScale: li =>

        for area in (@s.sue ? [])
            if area.y == li and area.value[0] == sue.LINE_SCALE
                ⮐ clamp 1 7 int(area.value[3] ? 1)

        if @syntax.scaleOfLine is func
            ⮐ @syntax.scaleOfLine @scales @scaling li
        1

    lineHeight: li =>

        ⮐ @lineScale li if not @isWrapped li

        @lineScale(li) * @wrapStarts(li).length

    rowPrefix: =>

        ⮐ @rowCache if @rowCache and @rowCacheExt == @syntax.ext and @rowCacheCols == @cells.cols

        @lineWidths ?= new WeakMap()

        rows     = [0]
        maxWidth = 0

        for li in 0...@s.lines.length

            line   = @s.lines[li]
            height = @lineHeight li

            width = null

            if line is arr
                width = @lineWidths.get line

            if not width?
                width = kseg.width line
                @lineWidths.set line width if line is arr

            if not @isWrapped li
                width = width * @lineScale(li)
                maxWidth = width if width > maxWidth

            rows.push rows[li] + height

        @maxWidthCache = maxWidth
        @rowCacheExt   = @syntax.ext
        @rowCacheCols  = @cells.cols
        @rowCache      = rows

    totalRows: =>

        @rowPrefix()[@s.lines.length]

    rowsBeforeLine: li =>

        n = @s.lines.length
        li = clamp 0 n li

        @rowPrefix()[li]

    lineAtAbsoluteRow: row =>

        n = @s.lines.length
        ⮐ 0 if n == 0

        rows = @rowPrefix()
        row = clamp 0 rows[n]-1 row

        lo = 0
        hi = n-1

        while lo < hi
            mid = int((lo+hi+1)/2)
            if rows[mid] <= row
                lo = mid
            else
                hi = mid-1

        lo

    viewTopRow: => @rowsBeforeLine(@s.view[1]) + @s.scrollOffset

    rowOfLine: li => @rowsBeforeLine(li) - @viewTopRow()

    lineAtRow: row =>

        @lineAtAbsoluteRow (@viewTopRow() + row)

    startForRow: li target =>

        target = max 0 target

        start = li
        rows  = 0

        while start > 0 and rows < target
            start -= 1
            rows += @lineHeight start

        start

    maxViewLine: =>

        h  = 0
        li = @s.lines.length-1

        while li >= 0 and h + @lineHeight(li) <= @cells.rows
            h += @lineHeight li
            li -= 1

        li+1

    maxTopRow: =>

        li = @maxViewLine()

        ⮐ max 0 @totalRows()-@cells.rows if li > 0 and @isWrapped(li-1) # a wrapped line may be cut by the top edge

        @rowsBeforeLine li

    marginValue: val fallback =>

        ⮐ fallback if not valid val

        if val is str and val.endsWith '%'
            pct = int val[0...-1]
            ⮐ int(@cells.rows * pct / 100)

        ⮐ int val if val is num

        fallback

    viewMargin: name fallback =>

        conf = config.data?.cursor
        ⮐ fallback if not valid conf

        @marginValue conf[name] fallback

    posForCell: x row =>

        if @rectree? ➜ ⮐ @sheetPosForCell [x+@s.view[0] @lineAtRow(row)]

        li    = @lineAtRow row
        scale = @lineScale li

        ⮐ [int((x+@s.view[0]) / scale) li] if not @isWrapped li

        starts = @wrapStarts li
        k      = int((@viewTopRow() + row - @rowsBeforeLine(li)) / scale)
        k      = clamp 0 starts.length-1 k
        cells  = sue.cellPositionsForLine @s.lines li []
        col    = max(0 int(x / scale) - @wrapIndent(li k)) + cells[starts[k]]
        stop   = @s.lines[li].length
        stop   = starts[k+1]-1 if k+1 < starts.length

        gi = starts[k]
        while gi < stop and cells[gi+1] <= col
            gi += 1

        gi += col - cells[gi] if gi == @s.lines[li].length

        [gi li]

    clearLines: =>

        @setSegls [[]]
        @setMainCursor 0 0

    isValidLineIndex:   li => 0 <= li < @s.lines.length
    isInvalidLineIndex: li => not @isValidLineIndex li

    currentFile: ->

        session = global.ked_session

        ⮐ if not session?.get

        session.get 'editor▸file'

#!undo

    undo: =>

        ⮐ if @h.length <= 1
        @r.push @h.pop()
        @s = @h[-1]
        @segls = @s.lines.slice()
        @rowCache = null
        @syntax.setSegls @s.lines
        @restoreSheet()
        @emit 'colors.changed'

    redo: =>

        ⮐ if empty @r
        @h.push @r.pop()
        @s = @h[-1]
        @segls = @s.lines.slice()
        @rowCache = null
        @syntax.setSegls @s.lines
        @restoreSheet()
        @emit 'colors.changed'

    begin: =>
        @beginIndices ?= []
        @beginIndices.push @h.length
        @beginIndex = @beginIndices[-1]

    end: =>

        if @beginIndices?.length

            index = @beginIndices.pop()

            @h.splice index @h.length-index-1

            if @beginIndices.length
                @beginIndex = @beginIndices[-1]
            else
                delete @beginIndex
        @

    pushState: => @h.push @s ; @
    swapState: => @h.pop() ; @pushState()

    isDirty: => @h.length > 1
    hasRedo: => @r.length > 0

    gutterWidth: => 
        ⮐ @gutterWidthOverride if @gutterWidthOverride?
        max 4 2 + ceil(Math.log10(@s.lines.length+1))

#!cut

    cut: opt =>

        opt ?= {}

        if @rectree?
            if text = @sheetSelectedText()
                clip.copy text
                @delete 'back'
            ⮐

        @copy deselect:false

        if empty @s.selections
            @selectCursorLines()
        @deleteSelection()

    copy: opt =>

        opt ?= {}

        if @rectree?
            if text = @sheetSelectedText() ➜ clip.copy text
            ⮐

        clip.copy @textOfSelectionOrCursorLines()

        @deselect() if opt.deselect != false

    paste: opt =>

        @insert clip.paste()

#!scroll

    scrollView: dir steps=1 =>

        sx = sy = 0

        switch dir
            'left'  ➜ sx = -1
            'right' ➜ sx =  1
            'up'    ➜ sy = -steps
            'down'  ➜ sy =  steps

        view = @s.view.asMutable()

        view[0] += sx

        topRow     = clamp 0 @maxTopRow() (@viewTopRow() + sy)
        view[1]    = @lineAtAbsoluteRow topRow
        scrollOffset = topRow - @rowsBeforeLine(view[1])

        @rowPrefix()

        cursor      = @mainCursor()
        cursorScale = @lineScale cursor[1]
        cursorRight = cursor[0]*cursorScale + cursorScale
        cursorRight = 0 if @isWrapped cursor[1]

        maxOffsetX = max 0 @maxWidthCache-@cells.cols+2
        maxOffsetX = max maxOffsetX cursorRight-@cells.cols+2
        view[0] = clamp 0 maxOffsetX view[0]
        
        ⮐ if view eql @s.view and scrollOffset == @s.scrollOffset

        @setView view scrollOffset

#!adjust
    
    adjustViewForMainCursor: opt =>
        
        opt ?= {}
        
        ⮐ if @cells.cols <= 0 or @cells.rows <= 0
        
        ⮐ if opt.adjust == false

        [x y] = @mainCursor()

        view = @s.view.asMutable()

        topFallback = 7
        botFallback = max topMargin int(@cells.rows/2)

        topMargin = @viewMargin 'topOffset' topFallback
        botMargin = @viewMargin 'bottomOffset' botFallback

        topMargin = clamp 0 @cells.rows topMargin
        botMargin = clamp 0 @cells.rows botMargin

        row      = @rowOfLine y
        height   = @lineHeight y
        topRow   = @viewTopRow()
        blockTop = @rowsBeforeLine y

        if @isWrapped y # the row of the cursor is kept in view, not the whole line
            dr        = @lineCell(x y)[1]
            row      += dr
            blockTop += dr
            height    = @lineScale y

        if opt.adjust == 'topDelta'

            topRow = blockTop - topMargin

        else if opt.adjust == 'topBotDeltaGrow' and opt.mc

            if row < 0
                topRow = blockTop - topMargin
            else if row + height > @cells.rows
                topRow = blockTop - (@cells.rows - botMargin - height)
            else
                dir = y - opt.mc[1]
                if row < topMargin and dir < 0
                    topRow = blockTop - topMargin
                else if row + height > @cells.rows - botMargin and dir > 0
                    topRow = blockTop - (@cells.rows - botMargin - height)

        else

            topDelta = 0
            botDelta = 0

            if opt.adjust == 'topBotDelta'
                topDelta = topMargin
                botDelta = botMargin

            if row + height > @cells.rows - botDelta
                topRow = blockTop - (@cells.rows - botDelta - height)
            else if row < topDelta
                topRow = blockTop - topDelta

        if opt.adjust in ['topBotDeltaGrow' 'topBotDelta']
            current = @viewTopRow()
            delta = topRow - current

            if delta > 1
                topRow = current + 1
            else if delta < -1
                topRow = current - 1

        topRow = clamp 0 @maxTopRow() topRow

        visibleTop = blockTop + height - @cells.rows

        topRow = max visibleTop topRow
        topRow = min blockTop topRow
        topRow = clamp 0 @maxTopRow() topRow

        view[1] = @lineAtAbsoluteRow topRow
        scrollOffset = topRow - @rowsBeforeLine(view[1])

        if not @skipAdjustViewForMainCursor
            if @isWrapped y
                view[0] = 0
            else
                scale = @lineScale y
                view[0] = max 0 x*scale + scale + 1 - @cells.cols
        
        ⮐ if view eql @s.view and scrollOffset == @s.scrollOffset
        
        @setView view scrollOffset

    initView: =>

        view = @s.view.asMutable()

        topRow = clamp 0 @maxTopRow() @viewTopRow()
        view[1] = @lineAtAbsoluteRow topRow
        view[0] = max 0 view[0]

        @setView view (topRow - @rowsBeforeLine(view[1]))

    setView: view scrollOffset=0 =>

        scrollOffset ?= 0

        ⮐ if @s.view eql view and @s.scrollOffset == scrollOffset

        @s = @s.set 'view' view
        @s = @s.set 'scrollOffset' scrollOffset
        @swapState()
        @emit 'view.changed' @s.view
        @

    setScrollTop: row =>

        row = clamp 0 @maxTopRow() row
        li  = @lineAtAbsoluteRow row
        view = @s.view.asMutable()
        view[1] = li

        @setView view (row - @rowsBeforeLine(li))

    rangeForVisibleLines: =>

        [@s.view[0] @lineAtRow(0) @s.view[0]+@cells.cols-1 @lineAtRow(@cells.rows-1)]

export state
