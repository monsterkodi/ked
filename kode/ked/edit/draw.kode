###
███████    ████████    ███████   ███   ███
███   ███  ███   ███  ███   ███  ███ █ ███
███   ███  ███████    █████████  █████████
███   ███  ███   ███  ███   ███  ███   ███
███████    ███   ███  ███   ███  ██     ██
###

use ../../kxk    ▪ kseg kstr 
use ../util      ◆ prof
use ../util/img  ◆ rounded
use ../theme     ◆ color theme 
use ../view/base ◆ view
use ./tool       ◆ belt colorspans
use              ◆ mode

function draw extends view

    @: screen name features ->
        
        super screen name features
        
        @setColor 'bg'        theme.editor.bg
        @setColor 'empty'     theme.editor.empty
                              
        @setColor 'cursor'    theme.cursor
        @setColor 'selection' theme.selection
        @setColor 'highlight' theme.highlight
        @setColor 'yank'      theme.novim.yank
        
    # ███████    ████████    ███████   ███   ███  
    # ███   ███  ███   ███  ███   ███  ███ █ ███  
    # ███   ███  ███████    █████████  █████████  
    # ███   ███  ███   ███  ███   ███  ███   ███  
    # ███████    ███   ███  ███   ███  ██     ██  
    
    draw: =>
        
        ⮐  if @hidden()
        
        # prof.start 'draw' if @name == 'editor'
        # ● draw
                
        view   = @state.s.view
        lines  = @state.s.lines
        lines  = @complete.preDrawLines lines if @complete?
        # lines  = mode.preDrawLines @state @state.s.lines
        
        y   = view[1]
        row = 0
        
        while y < lines.length and row < @cells.rows
            
            scale = @state.scaleOfLine y
            
            break if row + scale > @cells.rows # a tall line that does not fit is left out
            
            @drawLine lines[y] y row scale
            
            row += scale
            y   += 1
            
        @drawTrailingRows row        
        @drawHighlights()
        @drawSelections()
        @drawYank()
        
        @complete?.drawCompletion()
        @drawCursors()
        @complete?.drawPopup()
        
        @gutter?.draw()
        @mapscr?.draw()
        @scroll?.draw()
        
        # prof.end 'draw'   if @name == 'editor'
        
        mode.postDraw @state
        
        super()
        
    # ███      ███  ███   ███  ████████
    # ███      ███  ████  ███  ███     
    # ███      ███  ███ █ ███  ███████ 
    # ███      ███  ███  ████  ███     
    # ███████  ███  ███   ███  ████████

    drawLine: line y row scale=1, classes=null ->
    
        row   ?= @state.rowOfLine y
        scale ?= @state.scaleOfLine y
        bg = @color.bg
        
        checkColor = false
        headerClass = null
        
        syntax = @state.syntax
        view   = @state.s.view

        fgSpans = []
        bgSpans = []

        if @state.s.colors?
            for span in colorspans.spansForLine (@state.s.colors.fg ? []) y
                fgSpans.push [span[0] span[1] color.values(span[2])]
            for span in colorspans.spansForLine (@state.s.colors.bg ? []) y
                bgSpans.push [span[0] span[1] color.values(span[2])]
    
        classes ?= syntax.getClasses y # one scan per line, not per column
    
        linel = (kseg.width(line) - view[0]) * scale
        
        c = 0
        firstIndex = kseg.indexAtWidth line view[0] # check if leftmost grapheme is 
        firstSegi  = kseg.segiAtWidth line view[0]  # cut in half, if yes, start at
        c = 1 if firstIndex != firstSegi            # one column to the right 
        
        cols = max 1 int(@cells.cols / scale) # logical columns that fit
        x = 0
        si = 0
        sw = 0
        while x < cols
            
            ci = x+view[0]
            # advance the grapheme cursor instead of rescanning the line
            # from the start for every column - colorful long lines are
            # O(cols*linewidth) otherwise
            while sw < ci and si < line.length
                sw += kseg.segWidth line[si]
                si += 1
            
            # log "draw #{@name} #{ci} #{si} #{view} #{r3 kseg.str(line)} #{row} #{@cells.cols} #{@cells.rows} #{y} #{lines.length}"
            
            if si >= line.length
                # log "#{@name} #{r5 'break!'}"
                break 
            
            clss = classes[ci]
            clss ?= 'text'
            
            fg = syntax.getColor ci y clss

            for span in fgSpans
                if span[0] <= ci < span[1]
                    fg = span[2]
                    break
                
            ch = syntax.getChar ci y line[si] clss
            if ch == "#" ➜ checkColor = true
            else if ch in '0█' 
                if clss.endsWith('header') ➜ headerClass = clss

            cw = kseg.segWidth line[si]
            cw = max 1 cw # todo: this is to prevent endless loop with zero width characters, should be fixed eventually
            x += cw
            
            if x < cols
                # @cells.meta_clone c row # ϵ⌶⟙ℍϵℜ 𝛋𝚒⟅⟅ 𝚒𝜏 ⊚ℜ ⫐◯ 𝚒𝜏!
                @cells.add_scaled c*scale row ch fg bg scale
                c += cw
            
            if clss == 'invert_bg'
                bg = @color.bg
                
        @drawRowBackground y row linel scale
                
        @drawColorPills  line row linel scale       if checkColor
        @drawAsciiHeader line row headerClass y scale if headerClass
        @drawColorBackgrounds row bgSpans scale

    drawColorBackgrounds: row spans scale=1 ->

        view = @state.s.view

        for span in spans

            x1 = max 0 ((span[0]-view[0]) * scale)
            x2 = min @cells.cols ((span[1]-view[0]) * scale)

            continue if x1 >= x2

            for r in row...row+scale
                @cells.bg_rect x1 r (x2-1) r span[2]
        
    # ████████    ███████   ███   ███       ███████     ███████    ███████  ███   ███   ███████   ████████   ███████    
    # ███   ███  ███   ███  ███ █ ███       ███   ███  ███   ███  ███       ███  ███   ███        ███   ███  ███   ███  
    # ███████    ███   ███  █████████       ███████    █████████  ███       ███████    ███  ████  ███████    ███   ███  
    # ███   ███  ███   ███  ███   ███       ███   ███  ███   ███  ███       ███  ███   ███   ███  ███   ███  ███   ███  
    # ███   ███   ███████   ██     ██       ███████    ███   ███   ███████  ███   ███   ███████   ███   ███  ███████    
    
    drawRowBackground: y row linel scale=1 ->
        
        for r in row...min(@cells.rows, row+scale)
            if linel > 0
                @cells.bg_rect 0 r linel r @color.bg
            @cells.bg_fill max(0 linel) r -1 r @color.empty
            
    # █████████  ████████    ███████   ███  ███      ███  ███   ███   ███████   
    #    ███     ███   ███  ███   ███  ███  ███      ███  ████  ███  ███        
    #    ███     ███████    █████████  ███  ███      ███  ███ █ ███  ███  ████  
    #    ███     ███   ███  ███   ███  ███  ███      ███  ███  ████  ███   ███  
    #    ███     ███   ███  ███   ███  ███  ███████  ███  ███   ███   ███████   
    
    drawTrailingRows: row=0 -> # fill empty rows below last line
        
        for r in row...@cells.rows
            @cells.bg_fill 0 r -1 r @color.empty         
                
    # ███   ███  ███   ███████   ███   ███  ███      ███   ███████   ███   ███  █████████   ███████  
    # ███   ███  ███  ███        ███   ███  ███      ███  ███        ███   ███     ███     ███       
    # █████████  ███  ███  ████  █████████  ███      ███  ███  ████  █████████     ███     ███████   
    # ███   ███  ███  ███   ███  ███   ███  ███      ███  ███   ███  ███   ███     ███          ███  
    # ███   ███  ███   ███████   ███   ███  ███████  ███   ███████   ███   ███     ███     ███████   
    
    drawHighlights: ->
                            
        bg = @color.highlight.bg
        ul = @color.highlight.ul
        bg = color.darken bg if not @cells.screen.t.hasFocus
        
        [vx vy] = @state.s.view
        
        for highlight in @state.s.highlights

            li    = highlight[1]
            row   = @state.rowOfLine li
            scale = @state.scaleOfLine li
            cols  = max 1 int(@cells.cols / scale)
            
            break if row >= @cells.rows
            continue if row < 0
            continue if row + scale > @cells.rows
                
            # clip the span to the visible columns - a bracket pair spanning
            # a very long line must not redraw every column every frame
            xs = max highlight[0], vx
            xe = min highlight[2], vx+cols
            
            for x in xs...xe

                cx  = (x-vx)*scale
                hlc = @cells.get_char cx row

                switch hlc
                    '{' '[' '(' ')' ']' '}' ➜ ulc = @color.highlight.bracket_ul ; bgc = @color.highlight.bracket
                    "'" '"'                 ➜ ulc = @color.highlight.string_ul  ; bgc = @color.highlight.string
                                            ➜ ulc = ul ; bgc = bg
                
                for r in row...min(@cells.rows, row+scale)
                    for i in 0...scale
                        @cells.set_bg cx+i r bgc

                @cells.set_char cx row color.ul_rgb(ulc)+'\x1b[4:1m'+hlc+'\x1b[4:0m'
                @cells.adjustContrastForHighlight cx row bgc
                    
    #  ███████  ████████  ███      ████████   ███████  █████████  ███   ███████   ███   ███   ███████  
    # ███       ███       ███      ███       ███          ███     ███  ███   ███  ████  ███  ███       
    # ███████   ███████   ███      ███████   ███          ███     ███  ███   ███  ███ █ ███  ███████   
    #      ███  ███       ███      ███       ███          ███     ███  ███   ███  ███  ████       ███  
    # ███████   ████████  ███████  ████████   ███████     ███     ███   ███████   ███   ███  ███████   
    
    drawSelections: ->
        
        # prof.start 'selection'
        
        spanbg = @color.selection.span
        linebg = @color.selection.line
        
        if not @cells.screen.t.hasFocus
            spanbg = color.darken spanbg
            linebg = color.darken linebg
        
        for selection in @state.s.selections
                
            bg = belt.isSpanLineRange(@state.s.lines selection) ? spanbg : linebg
            
            start = max selection[1], @state.s.view[1]
            row   = @state.rowOfLine start

            continue if start > selection[3]

            for li in start..selection[3]
                
                scale = @state.scaleOfLine li
                cols  = max 1 int(@cells.cols / scale)
                
                break if row >= @cells.rows
                break if row + scale > @cells.rows
                
                if li == selection[1]
                    xs = selection[0]
                else
                    xs = 0
                    
                if li == selection[3]
                    xe = selection[2]
                else
                    xe = kseg.width(@state.s.lines[li])
                
                xs = max xs @state.s.view[0]
                xe = min xe @state.s.view[0]+cols
                
                for x in xs...xe
                    cx = (x-@state.s.view[0])*scale
                    for r in row...min(@cells.rows, row+scale)
                        for i in 0...scale
                            @cells.set_bg cx+i r bg 
                            @cells.adjustContrastForHighlight cx+i r bg

                row += scale
                    
        # prof.end 'selection'

    drawYank: ->

        ⮐  if empty @state.yankFlash

        bg = @color.yank

        [vx vy] = @state.s.view

        for rng in @state.yankFlash

            start = max rng[1], vy
            row   = @state.rowOfLine start

            continue if start > rng[3]

            for li in start..rng[3]

                scale = @state.scaleOfLine li
                cols  = max 1 int(@cells.cols / scale)

                break if row >= @cells.rows
                break if row + scale > @cells.rows

                if li == rng[1]
                    xs = rng[0]
                else
                    xs = 0

                if li == rng[3]
                    xe = rng[2]
                else
                    xe = kseg.width(@state.s.lines[li])

                xs = max xs vx
                xe = min xe vx+cols

                for x in xs...xe
                    cx = (x-vx)*scale
                    for r in row...min(@cells.rows, row+scale)
                        for i in 0...scale
                            @cells.set_bg cx+i r bg
                            @cells.adjustContrastForHighlight cx+i r bg

                row += scale

    #  ███████  ███   ███  ████████    ███████   ███████   ████████    ███████  
    # ███       ███   ███  ███   ███  ███       ███   ███  ███   ███  ███       
    # ███       ███   ███  ███████    ███████   ███   ███  ███████    ███████   
    # ███       ███   ███  ███   ███       ███  ███   ███  ███   ███       ███  
    #  ███████   ███████   ███   ███  ███████    ███████   ███   ███  ███████   
    
    drawCursors: ->
        
        s = @state.s
        mainCursor = @state.mainCursor()
        
        fg = @color.cursor.fg

        bg = mode.themeColor @state 'cursor.multi' @color.cursor.multi

        bg = color.darken(bg) if not @cells.screen.t.hasFocus
        
        for cursor in s.cursors
 
            continue if cursor eql mainCursor
            
            if @isCursorVisible cursor
             
                scale = @state.scaleOfLine cursor[1]
                cx = (cursor[0]-s.view[0])*scale
                @cells.draw_rounded_multi_cursor cx @state.rowOfLine(cursor[1]) bg scale
                        
        if @isCursorVisible mainCursor
             
            fg  = @color.cursor.fg
            
            bg = mode.themeColor @state 'cursor.main' @color.cursor.main

            if not @hasFocus() ➜ bg = color.darken bg 
             
            scale = @state.scaleOfLine mainCursor[1]
            [x y] = [ (mainCursor[0]-s.view[0])*scale, @state.rowOfLine(mainCursor[1]) ]
             
            if s.cursors.length <= 1
                if @isCursorInEmpty()
                    bg = color.darken bg 0.5
                else if ' ' == @cells.get_char(x y)
                    bg = color.darken bg 0.8
                     
            bg = color.darken bg if not @cells.screen.t.hasFocus
                 
            @cells.draw_rounded_cursor x y bg scale

    #  ███████   ███████   ███       ███████   ████████   ████████   ███  ███      ███       ███████  
    # ███       ███   ███  ███      ███   ███  ███   ███  ███   ███  ███  ███      ███      ███       
    # ███       ███   ███  ███      ███   ███  ███████    ████████   ███  ███      ███      ███████   
    # ███       ███   ███  ███      ███   ███  ███   ███  ███        ███  ███      ███           ███  
    #  ███████   ███████   ███████   ███████   ███   ███  ███        ███  ███████  ███████  ███████   
    
    drawColorPills: line row linel scale=1 ->
        
        if rngs = kstr.colorRanges kseg.str(line)
            cx = max(0 linel)+1
            for rng,idx in rngs
                dta = 4
                if idx == 0             ➜ @cells.set cx row '' rng.color @color.empty; cx += 1; dta--
                if idx == rngs.length-1 ➜ dta--
                @cells.bg_rect cx row cx+dta row rng.color; cx += dta
                if idx == rngs.length-1 ➜ @cells.set cx row '' rng.color @color.empty
                    
    drawAsciiHeader: line row clss y=null, scale=1 ->
        
        # █ █ █ █ █ █ █ █
        # █ ▉ ▊ ▋ ▌ ▍ ▏ ▕
        
        # log "▸ #{kseg.str line}"
        
        y ?= row + @state.s.view[1]

        fgSpans = []
        bgSpans = []

        if @state.s.colors?
            fgSpans = colorspans.spansForLine (@state.s.colors.fg ? []) y
            bgSpans = colorspans.spansForLine (@state.s.colors.bg ? []) y

        custom = (x) ->
            for span in fgSpans
                ⮐  true if span[0] <= x < span[1]
            for span in bgSpans
                ⮐  true if span[0] <= x < span[1]
            false

        chunks = kseg.chunks line
        for chunk in chunks

            continue if chunk.segl[0] not in '0█'

            ix0 = chunk.index

            if not custom ix0
                x = (ix0-@state.s.view[0])*scale
                @cells.set x row '▎' theme.syntax[clss+' highlight'] theme.syntax[clss]
            
            continue if chunk.segl.length <= 1

            ix1 = chunk.index + chunk.segl.length - 1

            if not custom ix1
                x = (ix1-@state.s.view[0])*scale
                @cells.set x row '▋' theme.syntax[clss] theme.syntax[clss+' shadow']

export draw
