
use ../../../kxk ▪ kseg post
use ../../popo   ◆ layout projector
use ../tool      ◆ sue belt
use ..           ◆ mode

#  keys that stay with the page while a sheet is loaded: the cursor moves across
#  the sheet and the history is the page's. all other keys go to the text node
#  at the cursor, if there is one

historyKeys = ['cmd+z' 'ctrl+z' 'shift+cmd+z' 'cmd+y' 'ctrl+y']

pageKeys = historyKeys.concat [
    'up' 'down' 'left' 'right' 'alt+left' 'alt+right'
    'pageup' 'pagedown' 'home' 'end' 'ctrl+h' 'ctrl+j'
    ]

#  the highlights of these keys spread to all text nodes

highlightKeys = ['alt+cmd+d' 'alt+ctrl+d']

#  novim: the key combos it handles, the keys that move the page cursor while
#  nothing is pending, its pending parts, and the commands that run on the page

novimCombos  = ['ctrl+v' 'ctrl+o' 'ctrl+i']
novimMotions = ['h' 'j' 'k' 'l' 'left' 'right' 'up' 'down']
novimParts   = ['count' 'operator' 'area' 'prefix' 'register' 'registerPending' 'macroPending' 'find' 'replace']
novimOnPage  = ['move' 'undo' 'matchBracket']

#!sheet
export

    #  multi mode: more than one cursor, in one or several text nodes. all keys but
    #  undo and redo run in each of those nodes then, the cursor motions too.
    #  esc goes back to the main cursor of the active node, and so does any change
    #  of the page cursors that didn't come from the nodes

    feedSheetKey: (key event) ->

        delete @sheetMulti if @sheetMulti? and @sheetMulti.cursors != @s.cursors

        if key == 'esc' and @sheetMulti
            @recordMacroKey key event
            node.state.finishNovimInsert() for node in @sheetMulti.nodes
            ⮐ @leaveSheetMulti()

        if nv = mode.get(@ 'novim')
            result = @feedSheetNovim nv key event
            ⮐ result if result != 'unhandled'

        ⮐ @feedKey(key event) if key in (@sheetMulti ? historyKeys : pageKeys)

        highlighted = valid @sheetActive()?.state.s.highlights

        if done = @inSheetNode((st) -> st.feedKey key event)
            @recordMacroKey key event
            @spreadHighlights highlighted if key in highlightKeys
            ⮐ done.result

        @feedKey key event

    #  the node the main cursor is in: the active node of multi mode, or the node
    #  the last change happened in, or the node at the cursor

    sheetActive: -> @sheetMulti?.active ? @sheetHome()?.node

    #  the page runs the only novim. its keys go to the text nodes at the cursors,
    #  the mode works on their states then. without a text node, and for plain
    #  motions of a single cursor, the keys go to the page. jumps the nodes ask
    #  for are made after the nodes are committed

    feedSheetNovim: (nv key event) ->

        combo = event?.combo ? key

        if combo not in novimCombos
            ⮐ 'unhandled' if combo.includes('alt+') or combo.includes('ctrl+') or combo.includes('cmd+')

        if not @sheetMulti
            home = @sheetHome()
            if not home? or (combo in novimMotions and not @novimPending(nv home.node.state))
                ⮐ @feedKey key event

        parts = {}
        parts[k] = nv[k] for k in novimParts

        prev    = nv.state
        feeding = @novimFeeding
        @novimFeeding = true
        result  = 'unhandled'

        try
            done = @inSheetNode (st) =>
                nv[k] = parts[k] for k in novimParts
                nv.state = st
                try
                    r = nv.handleKey key event
                    result = r if r != 'unhandled'
                finally
                    nv.state = prev
        finally
            @novimFeeding = feeding

        handled = done? and result != 'unhandled'

        @recordMacroKey key event if handled

        @runNovimLater()

        handled ? 'handled' : 'unhandled'

    #  runs fn with the novim mode working on the active text node, for the ex
    #  commands and the search that the command line sends to the mode. without a
    #  text node, quiet calls do nothing and the others report it

    novimInNode: (nv fn quiet) ->

        active = @sheetActive()

        if not active?
            ⮐ true if quiet
            post.emit 'novim.error' 'not in a text node'
            ⮐ false

        prev    = nv.state
        feeding = @novimFeeding
        @novimFeeding = true
        result  = null

        try
            @inTextNode active (st) =>
                nv.state = st
                try
                    result = fn()
                finally
                    nv.state = prev
        finally
            @novimFeeding = feeding

        @runNovimLater()

        result

    runNovimLater: ->

        ⮐ if @novimFeeding or not @novimAfter?

        jobs = @novimAfter
        delete @novimAfter
        job() for job in jobs

    #  jumps and macro replays that nodes ask for wait until the nodes are committed.
    #  true if fn was queued

    novimLater: fn ->

        ⮐ false if not @novimFeeding

        @novimAfter ?= []
        @novimAfter.push fn
        true

    novimPending: (nv st) ->

        ⮐ true if st.novim.visual
        for k in novimParts
            continue if k == 'count'
            ⮐ true if nv[k]
        false

    #  a node state starts, stops or toggles novim: the page's mode does it.
    #  an insert that began on the page ends with it

    novimFromNode: action ->

        @finishNovimInsert() if action != 'stop'

        switch action
            'start'  ➜ @startMode 'novim'
            'stop'   ➜ @stopMode  'novim'
            'toggle' ➜ @toggleMode 'novim'

    #  the main cursor goes to position x y of the text node with the state name,
    #  or of the page without a name. false if that node is gone

    sheetJump: (x y name) ->

        node = null

        if name?
            node = @sheetTextNodes().find (n) -> n.state.name == name
            ⮐ false if not node?

        ⮐ true if @novimLater => @sheetJump x y name

        @sheetClear()

        if node?
            @inTextNode node (st) -> st.setCursors [[x y]]
        else
            @setMainCursor x y
            @compositeSheet null

        true

    #  jump and change entries of text nodes that are gone are dropped

    pruneSheetJumps: ->

        live = new Set @sheetTextNodes().map((node) -> node.state.name)

        @novim.jumps.retain   (e) -> not e.node? or live.has(e.node)
        @novim.changes.retain (e) -> not e[2]? or live.has(e[2])

    #  node states use the page's register, jumps, changes and macros

    shareSheetNovim: st ->

        ⮐ if st.novim.page == @

        for k in ['register' 'jumps' 'changes' 'macroReplaying' 'macroLastRegister' 'macroSkipKey']
            @sharePart st.novim @novim k

        Object.defineProperty st.novim 'page' value:@ configurable:true
        Object.defineProperty st 'macroRecording' get:(=> @macroRecording) configurable:true

    sharePart: (obj src k) ->

        Object.defineProperty obj k,
            get: -> src[k]
            set: (v) -> src[k] = v
            configurable: true
            enumerable:   true

    #  novim commands on the page: motions and undo run, o and O start an
    #  insert in the row below or above, the rest doesn't change the page lines.
    #  true if the command was taken

    sheetNovim: cmd ->

        ⮐ false if cmd.operator in novimOnPage

        switch cmd.operator
            'openLine'
                pos = @sheetPosInDirection @mainCursor() (cmd.after ? 'down' : 'up')
                @setMainCursor pos[0] pos[1]
                @startNovimInsert kind:'insert'
            'insertAtIndent'
                @startNovimInsert kind:'insert'

        true

    leaveSheetMulti: ->

        active = @sheetMulti.active

        for node in @sheetMulti.nodes
            node.state.clearCursorsHighlightsAndSelections() if node.state.hasCursorsHighlightsOrSelections()

        delete @sheetMulti

        @commitSheetNodes active [active] [active.state.s]

        'handled'

    #  the first highlight key highlights the word of the active node in all text
    #  nodes, the next one selects all of them

    spreadHighlights: highlighted ->

        active = @sheetActive()

        ⮐ if not active?

        ast  = active.state
        span = ast.s.highlights[0]
        text = span? ? kseg.str(ast.s.lines[span[1]].slice(span[0] span[2])) : null
        all  = highlighted and valid ast.s.selections
        nodes = [active]

        walk = (node) =>
            if node.state? and node != active
                st = node.state
                if text? ➜ st.highlightText text else st.clearHighlights()
                if all and valid st.s.highlights
                    st.setCursors [belt.endOfSpan(st.s.highlights[0])]
                    st.selectAllHighlights()
                    nodes.push node
            for child in node.children ? []
                walk child

        walk @rectree

        if all
            @sheetMulti = active:active nodes:nodes

        @commitSheetNodes active nodes nodes.map((n) -> n.state.s)

    #  the text node at the main cursor and the position in its state the cursor
    #  is at. the position is left out while the page cursors are still the ones
    #  the last change of the node set, the node keeps its own cursors then.
    #  the cell behind the end of a line belongs to the text node of that line

    sheetHome: ->

        if m = @sheetMirror
            if m.cursors == @s.cursors and layout.pathOf(@rectree m.node)?
                ⮐ node:m.node

        @sheetNodeAt @sheetCellForPos(@mainCursor())

    #  the text node at a page cell and the position in its state

    sheetNodeAt: cell ->

        cells = @sheetSize()
        node  = layout.nodeForPos cells @rectree cell

        if node?.text?
            ⮐ node:node pos:(projector.posAt(node cell) ? projector.endOf(node))

        left = layout.nodeForPos cells @rectree [cell[0]-1 cell[1]]

        if left?.text?
            pos = projector.posAt left [cell[0]-1 cell[1]]
            if pos? and pos[0]+1 == left.state.s.lines[pos[1]].length
                ⮐ node:left pos:[pos[0]+1 pos[1]]

        null

    #  mouse events at page position pos. true if they were handled.
    #  a click clears the extra cursors, selections and highlights of all nodes,
    #  a drag selects in the text node it started in

    sheetMouse: (type pos event) ->

        ⮐ false if event.cmd or event.ctrl

        hit = @sheetNodeAt @sheetCellForPos(pos)

        switch type

            'press'

                count = event.count ? 1

                ⮐ @sheetAddCursor(hit) if count == 1 and event.alt and hit?

                if count == 1 and event.shift and hit? and hit.node == @sheetHome()?.node and not @sheetMulti
                    @inSheetNode (st) -> st.setMainCursorAndSelect hit.pos[0] hit.pos[1]
                    ⮐ true

                @sheetClear()

                if not hit?
                    @setMainCursor pos[0] pos[1]
                    @compositeSheet null
                    ⮐ true

                @inTextNode hit.node (st) ->
                    st.setCursors [hit.pos]
                    if count == 2
                        st.selectWord hit.pos[0] hit.pos[1]
                        st.highlightSelection()
                    else if count > 2
                        st.selectLine hit.pos[1]

                if count == 1
                    @sheetDrag = {node:hit.node pos:hit.pos}

            'drag'

                if d = @sheetDrag
                    if to = projector.posAt(d.node @sheetCellForPos(pos))
                        @inTextNode d.node (st) -> st.select d.pos to

            'release'

                delete @sheetDrag

        true

    #  all text nodes drop their extra cursors, selections and highlights

    sheetClear: ->

        delete @sheetMulti

        for node in @sheetTextNodes()
            st = node.state
            if st.hasCursorsHighlightsOrSelections()
                st.clearCursors()
                st.clearHighlights()
                st.deselect()

    #  alt+click adds a cursor to a text node, the node takes the main cursor

    sheetAddCursor: hit ->

        active = @sheetActive()

        if @sheetMulti
            nodes = @sheetMulti.nodes.slice()
        else if active?
            home = @sheetHome()
            active.state.setCursors [home.pos] if home?.pos?
            nodes = [active]
        else
            nodes = []

        joins = hit.node not in nodes

        nodes.push hit.node if joins

        befores = nodes.map (node) -> node.state.s

        if joins
            hit.node.state.setCursors [hit.pos]
        else
            hit.node.state.addCursor hit.pos[0] hit.pos[1]

        @sheetMulti = {active:hit.node nodes:nodes} if active?

        @commitSheetNodes hit.node nodes befores

        true

    #  runs fn with the state of one text node and shows what it changed

    inTextNode: (node fn) ->

        before = node.state.s
        @syncSheetModes node.state
        fn node.state
        @commitSheetNodes node [node] [before]

    #  the node states take the page's allowed modes and run the page's active
    #  brckts and unype. modes of node states that are gone are dropped

    syncSheetModes: st ->

        st.sheetPage    = @
        st.allowedModes = @allowedModes

        @shareSheetNovim st

        for name in ['brckts' 'unype']
            continue if not mode.modes[name]?
            if mode.isActive(@ name) and not mode.isActive(st name)
                mode.start st name
            else if mode.isActive(st name) and not mode.isActive(@ name)
                mode.stop st name

        live = new Set @sheetTextNodes().map((node) -> node.state.name)

        for key in Object.keys(mode.active)
            delete mode.active[key] if key.startsWith('popo_node') and not live.has(key)

    #  scrolls the views of nodes back to their first row. true if one was scrolled

    sheetResetViews: nodes ->

        reset = false

        for node in nodes ? @sheetTextNodes()
            st = node.state
            continue if not st?
            if st.s.view[1] != 0 or st.s.scrollOffset != 0
                st.setView [0 0] 0
                reset = true

        reset

    #  the page cursors were set from outside the nodes: a cursor that left the text
    #  nodes scrolls all node views back

    sheetCursorsSet: ->

        ⮐ if @sheetHome()?
        ⮐ if not @sheetResetViews()

        @renderSheet @rectree @sheetSize() null history:false silent:true

    #  runs fn with the state of the text node at the main cursor and shows what it
    #  changed. null if there is no text node at the cursor

    inSheetNode: fn ->

        ⮐ null if not @rectree?

        if @sheetMulti
            active = @sheetMulti.active
            nodes  = @sheetMulti.nodes
        else
            home = @sheetHome()
            ⮐ null if not home?
            active = home.node
            nodes  = [active]
            active.state.setCursors [home.pos] if home.pos?

        befores = nodes.map (node) -> node.state.s
        result  = null

        for node in nodes
            @syncSheetModes node.state
            r = fn node.state
            result = r if node == active

        @commitSheetNodes active nodes befores

        result:result

    #  shows what changed in the states of nodes. the active node keeps its main
    #  cursor in view. a second cursor in the active node starts multi mode, a
    #  single cursor in a single node ends it

    #  only text changes and scrolled node views paint the sheet again, cursors,
    #  selections and highlights are composited into the page as they are

    commitSheetNodes: (active nodes befores) ->

        changed = false
        resized = false

        for node,i in nodes
            if node.state.s.lines != befores[i].lines
                changed = true
                resized = true if @fitTextNode node befores[i]

        if @sheetMulti
            delete @sheetMulti if nodes.length == 1 and active.state.s.cursors.length == 1
        else if active.state.s.cursors.length > 1
            @sheetMulti = active:active nodes:[active]

        cells = @sheetSize()

        if changed
            layout.regionize cells @rectree
            projector.attach @rectree

        projector.scrollToCursor active

        #  the rows of the nodes whose glyphs changed are painted again,
        #  all of them if a node changed its size

        dirty = []

        for node,i in nodes
            st = node.state
            b  = befores[i]
            if st.s.lines != b.lines or st.s.view != b.view or st.s.scrollOffset != b.scrollOffset
                rect = node.rect.abs
                for y in rect.y...rect.y+rect.h
                    dirty.push y

        if valid dirty
            mc = projector.cellOf(active active.state.mainCursor())
            @renderSheet @rectree cells mc history:changed dirty:(resized ? null : dirty)
        else
            @compositeSheet active

        @sheetMirror = node:active cursors:@s.cursors
        @sheetMulti.cursors = @s.cursors if @sheetMulti

    #  the cursors, selections and highlights of the nodes on the unchanged page

    compositeSheet: active ->

        if @sheetMulti
            [cursors main] = @sheetCursors()
            main = max 0 belt.indexOfPosInPositions(main cursors)
        else if active? and cell = projector.cellOf(active active.state.mainCursor())
            cursors = [@sheetPosForCell(cell)]
            main    = 0

        if valid cursors
            @s = @s.set 'cursors' cursors
            @s = @s.set 'main' main

        @s = @s.set 'selections' @sheetSelections()
        @s = @s.set 'highlights' @sheetHighlights()
        @s = @s.set 'rectree' layout.plainNode(@rectree)

        @swapState()
        @adjustViewForMainCursor()

        mode.cursorsSet @
        @emit 'cursorsSet'

    #  a node whose width was made for its single line of text grows and shrinks with it

    fitTextNode: (node before) ->

        st = node.state

        ⮐ false if before.lines.length != 1 or st.s.lines.length != 1

        scale = projector.scaleOf node

        if node.w is num and int(node.h) == scale and not node.r? and not node.b?
            if node.w == (kseg.width(before.lines[0])+1)*scale
                w = (kseg.width(st.s.lines[0])+1)*scale
                ⮐ false if w == node.w
                node.w = w
                ⮐ true

        false

    #  page line ranges [x1 y x2 y] for the pieces [x1 li x2] of a node's lines

    sheetRangesOf: (node pieces) ->

        out   = []
        lines = node.state.s.lines

        for [x1 li x2] in pieces
            for x in x1...min(x2 lines[li].length)
                continue if not cell = projector.cellOf(node [x li])
                [px py] = @sheetPosForCell cell
                prev = out[-1]
                if prev? and prev[1] == py and prev[2] == px
                    prev[2] = px+1
                else
                    out.push [px py px+1 py]

        out

    sheetTextNodes: ->

        out  = []
        walk = (node) ->
            out.push node if node.state?
            for child in node.children ? []
                walk child
        walk @rectree if @rectree?
        out

    #  the selections and highlights of all text nodes, as ranges and spans of the page

    sheetSelections: ->

        out = []
        for node in @sheetTextNodes()
            st = node.state
            continue if empty st.s.selections
            pieces = belt.splitLineRanges(st.s.lines st.s.selections false).map (r) -> [r[0] r[1] r[2]]
            out = out.concat @sheetRangesOf(node pieces)
        out

    sheetHighlights: ->

        out = []
        for node in @sheetTextNodes()
            continue if empty node.state.s.highlights
            for rng in @sheetRangesOf(node node.state.s.highlights)
                out.push [rng[0] rng[1] rng[2]]
        out

    #  the cursors of the nodes in multi mode and the page position of the main cursor

    sheetCursors: ->

        cursors = []
        main    = null

        for node in @sheetMulti.nodes
            st = node.state
            for c,i in st.s.cursors
                continue if not cell = projector.cellOf(node c)
                pos = @sheetPosForCell cell
                cursors.push pos
                main = pos if node == @sheetMulti.active and i == st.s.main

        [belt.normalizePositions(cursors @s.lines.length-1) main]

    #  typing where no text node is creates one

    insertIntoSheet: text ->

        ⮐ true if @inSheetNode((st) -> st.insert text)

        cells = @sheetSize()
        cell  = @sheetCellForPos @mainCursor()
        node  = layout.addTextNode cells @rectree cell text

        ⮐ false if not node?

        layout.regionize cells @rectree
        projector.attach @rectree

        @renderSheet @rectree cells (projector.cellOf(node projector.endOf(node)) ? cell)

        true

    sheetSize: -> {cols:@cells.cols rows:@cells.rows}

    sheetCellsForLine: y -> sue.cellPositionsForLine(@s.lines y @scaleRunsForLine(y))

    sheetCellForPos: pos ->

        [x y] = pos

        cells = @sheetCellsForLine y
        lastIndex  = cells.length-1

        if x <= lastIndex ➜ ⮐ [cells[x] y]

        [cells[lastIndex] + x - lastIndex y]

    sheetPosInDirection: (pos dir count=1) ->

        [cx cy] = @sheetCellForPos pos

        for i in 0...count

            switch dir

                'left'

                    [cx cy] = @sheetCellForPos @sheetPosForCell([max(0 cx-1) cy])

                'right'

                    [x y]   = @sheetPosForCell [cx cy]
                    [nx ny] = @sheetCellForPos [x+1 y]

                    if @sheetSnapCell([nx ny])[0] <= cx # stuck in the fraction of scaled text
                        node = layout.nodeForPos @sheetSize() @rectree [cx ny]
                        nx = node.rect.abs.x + node.rect.abs.w if layout.scaleOf(node ? {}) > 1

                    cx = min nx @sheetSize().cols
                    cy = ny

                'up' 'down'

                    [top s] = @sheetBandAt cx cy

                    row = dir == 'up' ? top-1 : top+s
                    row = clamp 0 @s.lines.length-1 row

                    [top s] = @sheetBandAt cx row

                    cy = top + s-1

        @sheetPosForCell [cx cy]

    sheetBandAt: (cx cy) ->

        node  = layout.nodeForPos @sheetSize() @rectree [cx cy]
        scale = layout.scaleOf node ? {}

        if scale <= 1 ➜ ⮐ [cy 1]

        rect = node.rect.abs

        [rect.y + floor((cy - rect.y) / scale) * scale, scale]

    #  inside scaled text a cell snaps to the bottom left of its block,
    #  the fraction at the right edge of the rect snaps to the end of the last block

    sheetSnapCell: cell ->

        [cx cy] = cell

        node  = layout.nodeForPos @sheetSize() @rectree [cx cy]
        scale = layout.scaleOf node ? {}

        ⮐ cell if scale <= 1

        rect = node.rect.abs

        [rect.x + floor((cx - rect.x) / scale) * scale, rect.y + floor((cy - rect.y) / scale) * scale + scale-1]

    sheetPosForCell: cell ->

        [cx cy] = @sheetSnapCell cell

        below = min @s.lines.length cy+7

        for y in cy+1...below
            for run in @scaleRunsForLine y
                continue if y - cy >= run[2]
                cells = @sheetCellsForLine y
                if cells[run[0]] <= cx < cells[run[1]]
                    ⮐ @sheetPosOnLine cx y cells

        @sheetPosOnLine cx cy @sheetCellsForLine(cy)

    sheetPosOnLine: (cx y cells) ->

        lastIndex = cells.length-1

        if cx >= cells[lastIndex] ➜ ⮐ [lastIndex + cx - cells[lastIndex] y]

        for gi in 0...lastIndex
            if cx < cells[gi+1] ➜ ⮐ [gi y]

        [lastIndex y]

    sheetNodeAtCursor: ->

        ⮐ if not @rectree?

        layout.nodeForPos @sheetSize() @rectree @sheetCellForPos(@mainCursor())

    scaleSheetNode: delta ->

        ⮐ if not @rectree?

        cells = @sheetSize()
        layout.absolutize cells @rectree

        cell = @sheetCellForPos @mainCursor()
        node = layout.topmostIn @rectree cell

        ⮐ if not node?.text?

        old   = layout.scaleOf node
        scale = delta == 0 ? 1 : clamp(1 7 old+delta)

        ⮐ if scale == old

        pos = projector.posAt(node cell) ? projector.endOf(node)

        if scale > 1
            node.scale = scale
        else
            delete node.scale

        if @sheetCellsValue node.w ➜ node.w = max(1 floor(int(node.w) / old)) * scale
        if @sheetCellsValue node.h ➜ node.h = max(1 floor(int(node.h) / old)) * scale

        layout.regionize cells @rectree
        projector.attach @rectree

        @sheetResetViews [node]

        rect = node.rect.abs
        mc   = projector.cellOf(node pos)
        mc  ?= [clamp(rect.x max(rect.x rect.x+rect.w-1) cell[0]) clamp(rect.y max(rect.y rect.y+rect.h-1) cell[1])]

        @renderSheet @rectree cells mc

        node

    sheetCellsValue: value ->

        ⮐ false if not value?

        pct = value is str and value.endsWith '%'

        not pct

    deleteSheetNode: node ->

        ⮐ if not @rectree?

        cells = @sheetSize()
        cell  = @sheetCellForPos @mainCursor()
        node ?= layout.nodeForPos cells @rectree cell

        ⮐ if not layout.removeNode(@rectree node)?

        layout.regionize cells @rectree

        @renderSheet @rectree cells cell

        node

    shiftSheetNode: (node dir) ->

        ⮐ if not @rectree?

        cells = @sheetSize()

        layout.absolutize cells @rectree

        ⮐ if not layout.shiftNode @rectree node dir

        layout.regionize cells @rectree

        @renderSheet @rectree cells @sheetCellForPos(@mainCursor())

        node

    insertSheetNode: (node parent) ->

        ⮐ if not @rectree?

        cells = @sheetSize()

        layout.appendChild (parent ? @rectree) node
        layout.regionize cells @rectree

        @renderSheet @rectree cells @sheetCellForPos(@mainCursor())

        node

    setSheetTree: rectree ->

        @rectree = layout.pageOf rectree

        delete @sheetMirror
        delete @sheetMulti

        @s = @s.set 'rectree' layout.plainNode(@rectree)
        @

    clearSheet: ->

        delete @rectree
        delete @sheetMirror
        delete @sheetMulti

        @s = @s.set 'rectree' null
        @

    #  undo and redo: the live tree is rebuilt from the snapshot, its text nodes get
    #  states with the snapshot's s

    restoreSheet: ->

        ⮐ @clearSheet() if not @s.rectree?

        cell = @sheetCellForPos @mainCursor()

        @rectree = layout.liveNode @s.rectree

        delete @sheetMirror
        delete @sheetMulti

        @renderSheet @rectree @sheetSize() cell history:false silent:true

    fitSheet: ->

        ⮐ if not @rectree?
        ⮐ if @cells.cols < 1 or @cells.rows < 1
        ⮐ if @rectree.rendered eql @sheetSize()

        @renderSheet @rectree @sheetSize() @sheetCellForPos(@mainCursor()) history:false silent:true

    commitSheet: ->

        ⮐ if not @rectree?

        @renderSheet @rectree @sheetSize() @sheetCellForPos(@mainCursor()) silent:true

    renderSheet: (rectree cells mc opt) ->

        # render a sheet rectree and commit it in one undoable step

        opt ?= {}

        data = layout.sheetData {cols:cells.cols rows:cells.rows} rectree opt.dirty
        old  = @s.lines

        # unchanged rows keep their line, so the syntax and the line diff skip them

        @segls = data.text.split('\n').map (text,i) ->
            (old[i]? and kseg.str(old[i]) == text) ? old[i] : kseg(text)

        @changeLinesSegls()

        @syntax.setSegls @s.lines
        @syntax.setOverlay data.classes

        @rectree = rectree

        @s = @s.set 'sue' data.sue
        @s = @s.set 'rectree' layout.plainNode(rectree)

        if mc?
            pos = @sheetPosForCell mc
            @s = @s.set 'cursors' [pos]
            @s = @s.set 'main' 0

        if @sheetMulti
            [cursors main] = @sheetCursors()
            if valid cursors
                @s = @s.set 'cursors' cursors
                @s = @s.set 'main' max(0 belt.indexOfPosInPositions(main cursors))

        @s = @s.set 'selections' @sheetSelections()
        @s = @s.set 'highlights' @sheetHighlights()

        @segls = @s.lines.slice()
        @rowCache = null
        @r = [] if opt.history != false

        @emit 'sue.changed'

        if opt.history == false
            @swapState()
        else
            @pushState()

        if pos?
            @adjustViewForMainCursor()
            if not opt.silent
                mode.cursorsSet @
                @emit 'cursorsSet'

        post.emit 'sheet.edited'

        @

    moveSheetNode: (dir) ->

        ⮐ if not @rectree?

        cells = @sheetSize()
        layout.absolutize cells @rectree

        cursor = @sheetCellForPos @mainCursor()
        node   = layout.topmostIn @rectree cursor

        ⮐ if not node?

        oldRect = clone node.rect.abs
        moved   = layout.moveNode cells @rectree node dir

        ⮐ if not moved?

        rect = moved.rect.abs

        maxX = max rect.x (rect.x + rect.w - 1)
        maxY = max rect.y (rect.y + rect.h - 1)

        x = clamp rect.x maxX (rect.x + cursor[0] - oldRect.x)
        y = clamp rect.y maxY (rect.y + cursor[1] - oldRect.y)

        @renderSheet @rectree cells [x y]

        moved

    resizeSheetNode: (dir) ->

        ⮐ if not @rectree?

        cells = @sheetSize()
        layout.absolutize cells @rectree

        cursor = @sheetCellForPos @mainCursor()
        node   = layout.topmostIn @rectree cursor

        ⮐ if not node?

        oldRect = clone node.rect.abs
        moved   = layout.resizeNode cells @rectree node dir

        ⮐ if not moved?

        rect = moved.rect.abs

        maxX = max rect.x (rect.x + rect.w - 1)
        maxY = max rect.y (rect.y + rect.h - 1)

        x = clamp rect.x maxX (rect.x + cursor[0] - oldRect.x)
        y = clamp rect.y maxY (rect.y + cursor[1] - oldRect.y)

        @sheetResetViews [moved]

        @renderSheet @rectree cells [x y]

        moved
