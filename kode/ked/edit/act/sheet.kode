
use ../../../kxk ▪ kseg post
use ../../popo   ◆ layout
use ../tool      ◆ sue
use ..           ◆ mode
#!sheet
export
    
    insertIntoSheet: text ->

        cells = @sheetSize()
        cell  = @sheetCellForPos @mainCursor()

        if sel = @sheetSelection()
            @sheetCutText sel
            cell = layout.cellForTextOffset sel.node sel.from

        inserted = layout.insertTextAt cells @rectree cell text

        ⮐ false if not inserted?

        layout.regionize cells @rectree

        @renderSheet @rectree cells layout.cellForTextOffset(inserted.node inserted.offset)

        true

    sheetSize: -> {cols:@cells.cols rows:@cells.rows}

    sheetCellsForLine: y -> sue.cellPositionsForLine(@s.lines y @scaleRunsForLine(y))

    sheetCellForPos: pos ->

        [x y] = pos

        cells = @sheetCellsForLine y
        lastIndex  = cells.length-1

        if x <= lastIndex ➜ ⮐ [cells[x] y]

        [cells[lastIndex] + x - lastIndex y]

    sheetPosInDirection: (pos dir count=1) ->

        [cx cy] = @sheetCellForPos pos

        for i in 0...count

            switch dir

                'left'

                    [cx cy] = @sheetCellForPos @sheetPosForCell([max(0 cx-1) cy])

                'right'

                    [x y]   = @sheetPosForCell [cx cy]
                    [nx ny] = @sheetCellForPos [x+1 y]

                    if @sheetSnapCell([nx ny])[0] <= cx # stuck in the fraction of scaled text
                        node = layout.nodeForPos @sheetSize() @rectree [cx ny]
                        nx = node.rect.abs.x + node.rect.abs.w if layout.scaleOf(node ? {}) > 1

                    cx = min nx @sheetSize().cols
                    cy = ny

                'up' 'down'

                    [top s] = @sheetBandAt cx cy

                    row = dir == 'up' ? top-1 : top+s
                    row = clamp 0 @s.lines.length-1 row

                    [top s] = @sheetBandAt cx row

                    cy = top + s-1

        @sheetPosForCell [cx cy]

    sheetBandAt: (cx cy) ->

        node  = layout.nodeForPos @sheetSize() @rectree [cx cy]
        scale = layout.scaleOf node ? {}

        if scale <= 1 ➜ ⮐ [cy 1]

        rect = node.rect.abs

        [rect.y + floor((cy - rect.y) / scale) * scale, scale]

    #  inside scaled text a cell snaps to the bottom left of its block,
    #  the fraction at the right edge of the rect snaps to the end of the last block

    sheetSnapCell: cell ->

        [cx cy] = cell

        node  = layout.nodeForPos @sheetSize() @rectree [cx cy]
        scale = layout.scaleOf node ? {}

        ⮐ cell if scale <= 1

        rect = node.rect.abs

        [rect.x + floor((cx - rect.x) / scale) * scale, rect.y + floor((cy - rect.y) / scale) * scale + scale-1]

    sheetPosForCell: cell ->

        [cx cy] = @sheetSnapCell cell

        below = min @s.lines.length cy+7

        for y in cy+1...below
            for run in @scaleRunsForLine y
                continue if y - cy >= run[2]
                cells = @sheetCellsForLine y
                if cells[run[0]] <= cx < cells[run[1]]
                    ⮐ @sheetPosOnLine cx y cells

        @sheetPosOnLine cx cy @sheetCellsForLine(cy)

    sheetPosOnLine: (cx y cells) ->

        lastIndex = cells.length-1

        if cx >= cells[lastIndex] ➜ ⮐ [lastIndex + cx - cells[lastIndex] y]

        for gi in 0...lastIndex
            if cx < cells[gi+1] ➜ ⮐ [gi y]

        [lastIndex y]
        
    sheetNodeAtCursor: ->

        ⮐ if not @rectree?

        layout.nodeForPos @sheetSize() @rectree @sheetCellForPos(@mainCursor())

    scaleSheetNode: delta ->

        ⮐ if not @rectree?

        cells = @sheetSize()
        layout.absolutize cells @rectree

        cell = @sheetCellForPos @mainCursor()
        node = layout.topmostIn @rectree cell

        ⮐ if not valid node?.text

        old   = layout.scaleOf node
        scale = delta == 0 ? 1 : clamp(1 7 old+delta)

        ⮐ if scale == old

        offset = layout.textOffsetAt node cell

        if scale > 1
            node.scale = scale
        else
            delete node.scale

        if @sheetCellsValue node.w ➜ node.w = max(1 floor(int(node.w) / old)) * scale
        if @sheetCellsValue node.h ➜ node.h = max(1 floor(int(node.h) / old)) * scale

        layout.regionize cells @rectree

        @renderSheet @rectree cells layout.cellForTextOffset(node offset)

        node

    sheetCellsValue: value ->

        ⮐ false if not value?

        pct = value is str and value.endsWith '%'

        not pct

    deleteSheetNode: node ->

        ⮐ if not @rectree?

        cells = @sheetSize()
        cell  = @sheetCellForPos @mainCursor()
        node ?= layout.nodeForPos cells @rectree cell

        ⮐ if not layout.removeNode(@rectree node)?

        layout.regionize cells @rectree

        @renderSheet @rectree cells cell

        node

    shiftSheetNode: (node dir) ->

        ⮐ if not @rectree?

        cells = @sheetSize()

        layout.absolutize cells @rectree

        ⮐ if not layout.shiftNode @rectree node dir

        layout.regionize cells @rectree

        @renderSheet @rectree cells @sheetCellForPos(@mainCursor())

        node

    insertSheetNode: (node parent) ->

        ⮐ if not @rectree?

        cells = @sheetSize()

        layout.appendChild (parent ? @rectree) node
        layout.regionize cells @rectree

        @renderSheet @rectree cells @sheetCellForPos(@mainCursor())

        node

    #  back removes the glyph before the cursor, next the one behind it
    #  a selection is removed as a whole

    sheetDelete: type ->

        if sel = @sheetSelection()
            @sheetCutText sel
            @renderSheet @rectree @sheetSize() layout.cellForTextOffset(sel.node sel.from)
            ⮐

        cell = @sheetCellForPos @mainCursor()
        node = @sheetTextNodeAt cell

        ⮐ if not node?

        offset = layout.textOffsetAt node cell
        from   = type == 'back' ? offset-1 : offset

        ⮐ if from < 0 or from >= Array.from(node.text).length

        @sheetCutText node:node from:from to:from+1
        @renderSheet @rectree @sheetSize() layout.cellForTextOffset(node from)

    sheetCutText: sel ->

        chars = Array.from sel.node.text
        chars.splice sel.from sel.to-sel.from
        sel.node.text = chars.join ''

        layout.regionize @sheetSize() @rectree

    sheetTextNodeAt: cell -> layout.textNodeAt @sheetSize() @rectree cell

    #  a sheet selection is a range of text offsets in the text node at the main cursor.
    #  it is kept as line ranges over the glyphs of the range, so it draws like any selection,
    #  and read back from whatever line ranges select glyphs of that node

    sheetSelection: ->

        ⮐ if empty @s.selections

        node = @sheetTextNodeAt @sheetCellForPos(@mainCursor())

        ⮐ if not node?

        inside = (x y r) -> (y > r[1] or y == r[1] and x >= r[0]) and (y < r[3] or y == r[3] and x < r[2])

        from = to = null

        for slot in layout.textSlots node
            continue if not slot[2]?
            [x y] = @sheetPosForCell [slot[0] slot[1]]
            for rng in @s.selections
                if inside x y rng
                    from = min (from ? slot[3]) slot[3]
                    to   = max (to ? slot[3]+1) slot[3]+1
                    break

        ⮐ if not from?

        node:node from:from to:to

    sheetRangesForText: (node from to) ->

        ranges = []

        for slot in layout.textSlots node
            continue if not slot[2]? or slot[3] < from or slot[3] >= to
            [x y] = @sheetPosForCell [slot[0] slot[1]]
            prev  = last ranges
            if prev? and prev[1] == y and prev[2] == x
                prev[2] = x+1
            else
                ranges.push [x y x+1 y]

        ranges

    sheetSelectedText: ->

        if sel = @sheetSelection()
            Array.from(sel.node.text).slice(sel.from sel.to).join ''

    #  selects all text of the text node at the cursor, a second time deselects

    sheetSelectAll: ->

        node = @sheetTextNodeAt @sheetCellForPos(@mainCursor())

        ⮐ if not node?

        len    = Array.from(node.text).length
        ranges = @sheetRangesForText node 0 len

        if empty(ranges) or ranges eql @s.selections
            @deselect()
            ⮐

        @setSelections ranges
        @setCursors [@sheetPosForCell(layout.cellForTextOffset(node len))]

    #  moves the main cursor through the text of its node and selects from the anchor:
    #  the end of the selection the cursor is not at, or where the cursor was.
    #  left and right step through the text, up and down through the rows,
    #  moving out of the node selects to its start or end

    sheetMoveAndSelect: dir ->

        cell = @sheetCellForPos @mainCursor()
        sel  = @sheetSelection()
        node = sel?.node ? @sheetTextNodeAt(cell)

        ⮐ if not node? or dir not in ['left' 'right' 'up' 'down']

        at     = layout.textOffsetAt node cell
        anchor = at
        anchor = (at == sel.from ? sel.to : sel.from) if sel?

        len = Array.from(node.text).length

        if dir in ['left' 'right']
            to = clamp 0 len (dir == 'left' ? at-1 : at+1)
        else
            next = @sheetCellForPos @sheetPosInDirection(@mainCursor() dir)
            if layout.holds(node next) or @sheetTextNodeAt(next) == node
                to = layout.textOffsetAt node next
            else
                to = dir == 'up' ? 0 : len

        @setSelections @sheetRangesForText(node min(anchor to) max(anchor to))
        @setCursors [@sheetPosForCell(layout.cellForTextOffset(node to))]

    setSheetTree: rectree ->

        @rectree = layout.pageOf rectree

        @s = @s.set 'rectree' layout.plainNode(@rectree)
        @

    clearSheet: ->

        delete @rectree

        @s = @s.set 'rectree' null
        @

    restoreSheet: ->

        ⮐ @clearSheet() if not @s.rectree?

        cell = @sheetCellForPos @mainCursor()

        @rectree = @s.rectree.asMutable()

        @renderSheet @rectree @sheetSize() cell history:false silent:true

    fitSheet: ->

        ⮐ if not @rectree?
        ⮐ if @cells.cols < 1 or @cells.rows < 1
        ⮐ if @rectree.rendered eql @sheetSize()

        @renderSheet @rectree @sheetSize() @sheetCellForPos(@mainCursor()) history:false silent:true

    commitSheet: ->

        ⮐ if not @rectree?

        @renderSheet @rectree @sheetSize() @sheetCellForPos(@mainCursor()) silent:true

    renderSheet: (rectree cells mc opt) ->

        # render a sheet rectree and commit it in one undoable step

        opt ?= {}

        data  = sue.desue layout.sueify({cols:cells.cols rows:cells.rows} rectree)
        lines = kseg.segls data.text.split('\n')

        @segls = lines

        @changeLinesSegls()

        @syntax.setSegls @s.lines

        @s = @s.set 'sue' data.sue
        @s = @s.set 'rectree' layout.plainNode(rectree)

        if mc?
            pos = @sheetPosForCell mc
            @s = @s.set 'cursors' [pos]
            @s = @s.set 'main' 0

        @s = @s.set 'selections' [] if opt.history != false # line ranges don't survive a new layout

        @rectree = rectree

        @segls = @s.lines.slice()
        @rowCache = null
        @r = [] if opt.history != false

        @emit 'sue.changed'

        if opt.history == false
            @swapState()
        else
            @pushState()

        if pos?
            @adjustViewForMainCursor()
            if not opt.silent
                mode.cursorsSet @
                @emit 'cursorsSet'

        post.emit 'sheet.edited'

        @

    moveSheetNode: (dir) ->

        ⮐ if not @rectree?

        cells = @sheetSize()
        layout.absolutize cells @rectree

        cursor = @sheetCellForPos @mainCursor()
        node   = layout.topmostIn @rectree cursor

        ⮐ if not node?

        oldRect = clone node.rect.abs
        moved   = layout.moveNode cells @rectree node dir

        ⮐ if not moved?

        rect = moved.rect.abs

        maxX = max rect.x (rect.x + rect.w - 1)
        maxY = max rect.y (rect.y + rect.h - 1)

        x = clamp rect.x maxX (rect.x + cursor[0] - oldRect.x)
        y = clamp rect.y maxY (rect.y + cursor[1] - oldRect.y)

        @renderSheet @rectree cells [x y]

        moved

    resizeSheetNode: (dir) ->

        ⮐ if not @rectree?

        cells = @sheetSize()
        layout.absolutize cells @rectree

        cursor = @sheetCellForPos @mainCursor()
        node   = layout.topmostIn @rectree cursor

        ⮐ if not node?

        oldRect = clone node.rect.abs
        moved   = layout.resizeNode cells @rectree node dir

        ⮐ if not moved?

        rect = moved.rect.abs

        maxX = max rect.x (rect.x + rect.w - 1)
        maxY = max rect.y (rect.y + rect.h - 1)

        x = clamp rect.x maxX (rect.x + cursor[0] - oldRect.x)
        y = clamp rect.y maxY (rect.y + cursor[1] - oldRect.y)

        @renderSheet @rectree cells [x y]

        moved
