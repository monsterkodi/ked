
use ../../../kxk ▪ kseg post
use ../../popo   ◆ layout
use ../tool      ◆ belt sue
use ..           ◆ mode
#!sheet
export
    
    insertIntoSheet: text ->

        cells   = @sheetSize()
        rectree = @rectree
        cell    = @sheetCellForPos @mainCursor()
        advance = layout.insertTextAt cells rectree cell text

        ⮐ 0 if not advance

        @renderSheet rectree cells [cell[0]+advance cell[1]]

        advance

    sheetSize: -> {cols:(@rectreeCols ? @cells.cols) rows:(@rectreeRows ? @cells.rows)}

    sheetCellsForLine: y -> sue.cellPositionsForLine(@s.lines y @scaleRunsForLine(y))

    sheetCellForPos: pos ->

        [x y] = pos

        cells = @sheetCellsForLine y
        lastIndex  = cells.length-1

        if x <= lastIndex ➜ ⮐ [cells[x] y]

        [cells[lastIndex] + x - lastIndex y]

    sheetPosInDirection: (pos dir count=1) ->

        [cx cy] = @sheetCellForPos pos

        for i in 0...count

            switch dir

                'left'

                    [cx cy] = @sheetCellForPos @sheetPosForCell([max(0 cx-1) cy])

                'right'

                    [x y]   = @sheetPosForCell [cx cy]
                    [cx cy] = @sheetCellForPos [x+1 y]
                    cx      = min cx @sheetSize().cols

                'up' 'down'

                    [top s] = @sheetBandAt cx cy

                    row = dir == 'up' ? top-1 : top+s
                    row = clamp 0 @s.lines.length-1 row

                    [top s] = @sheetBandAt cx row

                    cy = top + s-1

        @sheetPosForCell [cx cy]

    sheetBandAt: (cx cy) ->

        node  = layout.nodeForPos @sheetSize() @rectree [cx cy]
        scale = layout.scaleOf node ? {}

        if scale <= 1 ➜ ⮐ [cy 1]

        rect = node.rect.abs

        [rect.y + floor((cy - rect.y) / scale) * scale, scale]

    sheetPosForCell: cell ->

        [cx cy] = cell

        [top s] = @sheetBandAt cx cy
        cy = top + s-1

        below = min @s.lines.length cy+7

        for y in cy+1...below
            break if y >= below # ranges count down when empty
            for run in @scaleRunsForLine y
                continue if y - cy >= run[2]
                cells = @sheetCellsForLine y
                if cells[run[0]] <= cx < cells[run[1]]
                    ⮐ @sheetPosOnLine cx y cells

        @sheetPosOnLine cx cy @sheetCellsForLine(cy)

    sheetPosOnLine: (cx y cells) ->

        lastIndex = cells.length-1

        if cx >= cells[lastIndex] ➜ ⮐ [lastIndex + cx - cells[lastIndex] y]

        for gi in 0...lastIndex
            if cx < cells[gi+1] ➜ ⮐ [gi y]

        [lastIndex y]
        
    sheetNodeAtCursor: ->

        ⮐ if not @rectree?

        layout.nodeForPos @sheetSize() @rectree @sheetCellForPos(@mainCursor())

    scaleSheetNode: delta ->

        ⮐ if not @rectree?

        cells = @sheetSize()
        layout.absolutize cells @rectree

        cell = @sheetCellForPos @mainCursor()
        node = layout.topmostIn @rectree cell

        ⮐ if not valid node?.text

        old   = layout.scaleOf node
        scale = delta == 0 ? 1 : clamp(1 7 old+delta)

        ⮐ if scale == old

        offset = layout.textOffsetIn node cell node.text.length
        lines  = max 1 int(node.rect.abs.h / old)

        if scale > 1
            node.scale = scale
        else
            delete node.scale

        pct = node.h is str and node.h.endsWith '%'

        if node.h? and not pct
            node.h = lines * scale

        layout.absolutize cells @rectree

        @renderSheet @rectree cells layout.cellForTextOffset(node offset)

        node

    setSheetTree: (rectree cols rows) ->

        @rectree = rectree
        @rectreeCols = cols
        @rectreeRows = rows

        @s = @s.set 'rectree' layout.plainNode(rectree)
        @

    clearSheet: ->

        delete @rectree
        delete @rectreeCols
        delete @rectreeRows

        @s = @s.set 'rectree' null
        @

    restoreSheet: ->

        if @s.rectree?

            @rectree = @s.rectree.asMutable()
            @rectreeCols = @cells.cols
            @rectreeRows = @cells.rows

            layout.absolutize {cols:@rectreeCols rows:@rectreeRows} @rectree

            post.emit 'sheet.edited'

        else
            @clearSheet()

        @

    renderSheet: (rectree cells mc opt) ->

        # render a sheet rectree and commit it in one undoable step

        opt ?= {}

        data  = sue.desue layout.sueify({cols:cells.cols rows:cells.rows} rectree)
        lines = kseg.segls data.text.split('\n')

        @segls = lines

        @changeLinesSegls()

        @syntax.setSegls @s.lines

        @s = @s.set 'sue' data.sue
        @s = @s.set 'rectree' layout.plainNode(rectree)

        if mc?
            pos = @sheetPosForCell mc
            @s = @s.set 'cursors' [pos]
            @s = @s.set 'main' 0

        @rectree = rectree
        @rectreeCols = cells.cols
        @rectreeRows = cells.rows

        @segls = @s.lines.slice()
        @rowCache = null
        @r = []

        @emit 'sue.changed'

        if opt.history == false
            @swapState()
        else
            @pushState()

        if pos?
            @adjustViewForMainCursor()
            if not opt.silent
                mode.cursorsSet @
                @emit 'cursorsSet'

        post.emit 'sheet.edited'

        @

    moveSheetNode: (dir) ->

        ⮐ if not @rectree?

        layout.absolutize @cells @rectree

        cursor = @sheetCellForPos @mainCursor()
        node   = layout.topmostIn @rectree cursor

        ⮐ if not node?

        oldRect = clone node.rect.abs
        moved   = layout.moveNode @cells @rectree node dir

        ⮐ if not moved?

        rect = moved.rect.abs

        maxX = max rect.x (rect.x + rect.w - 1)
        maxY = max rect.y (rect.y + rect.h - 1)

        x = clamp rect.x maxX (rect.x + cursor[0] - oldRect.x)
        y = clamp rect.y maxY (rect.y + cursor[1] - oldRect.y)

        @renderSheet @rectree @cells [x y]

        moved

    resizeSheetNode: (dir) ->

        ⮐ if not @rectree?

        cursor = @sheetCellForPos @mainCursor()
        node   = layout.topmostIn @rectree cursor

        ⮐ if not node?

        oldRect = clone node.rect.abs
        moved   = layout.resizeNode @cells @rectree node dir

        ⮐ if not moved?

        rect = moved.rect.abs

        maxX = max rect.x (rect.x + rect.w - 1)
        maxY = max rect.y (rect.y + rect.h - 1)

        x = clamp rect.x maxX (rect.x + cursor[0] - oldRect.x)
        y = clamp rect.y maxY (rect.y + cursor[1] - oldRect.y)

        @renderSheet @rectree @cells [x y]

        moved

        
#!sue
    sueAt: pos ->

        areas = @s.sue ? []
        ⮐ if empty areas

        [x y] = pos

        for i in areas.length-1..0
            area = areas[i]
            if area.y == y and area.x <= x
                ⮐ area

    setSue: (x y value) ->

        areas = @s.sue ? []
        @changeSue areas.concat([{x: x y: y value: value}])
        
    changeSue: areas ->

        @s = @s.set 'sue' areas
        @rowCache = null
        @r = []
        @pushState()
        @emit 'sue.changed'
        
    loadSue: areas ->

        @s = @s.set 'sue' (areas ? [])
        @rowCache = null
        @clearHistory()
        @emit 'sue.changed'
        
    applySueAreas: next ->

        areas = @s.sue ? []
        ⮐ if next eql areas

        @changeSue next

    clearSueForRanges: ranges ->

        ⮐ if @rectree?

        areas = @s.sue ? []
        ⮐ if empty areas or empty ranges

        ranges = belt.splitLineRanges @s.lines ranges false

        cut = sue.rangesCutFromAreasInLines ranges areas @s.lines

        ⮐ if cut eql areas

        @changeSue cut

    toggleSueFlag: flag ->

        ⮐ if @rectree?

        ranges = @selectionsOrCursorWordRanges()
        ⮐ if empty ranges

        ranges = belt.splitLineRanges @s.lines ranges false

        next = sue.rangesWithToggledFlag ranges (@s.sue ? []) @s.lines flag

        ⮐ if next eql @s.sue

        @changeSue next
##scale
    stepScales: delta ->

        ⮐ if @rectree?

        areas = @s.sue ? []
        next  = areas

        if empty @s.selections
            indices = belt.lineIndicesForPositions @s.cursors
            next = sue.areasWithSteppedLineScales(areas indices delta @lineHeight)
        else
            lines = []
            runs  = []

            for piece in belt.splitLineRanges(@s.lines @s.selections false)
                if belt.isFullLineRange @s.lines piece
                    lines.push piece[1] if piece[1] not in lines
                else
                    runs.push piece

            next = sue.areasWithSteppedLineScales(next lines delta @lineHeight)
            next = sue.areasWithSteppedRunsInLines(next runs delta @s.lines)

        @applySueAreas next

    clearScales: ->

        ⮐ if @rectree?

        areas = @s.sue ? []
        indices = belt.lineIndicesForRangesOrPositions @s.selections @s.cursors

        next = sue.areasWithoutLineScales(areas indices)

        for piece in belt.splitLineRanges(@s.lines @s.selections false)
            continue if belt.isFullLineRange @s.lines piece
            for run in sue.runsForLine(next @s.lines piece[1])
                if run[0] <= piece[0] and piece[2] <= run[1]
                    next = sue.areasWithoutRun(next piece[1] run[0] run[1])
                    break

        @applySueAreas next

    scaleRunsForLine: y ->

        areas = @s.sue ? []
        ⮐ [] if empty areas

        sue.runsForLine(areas @s.lines y)

    clearSueAtCursorOrSelection: ->

        if ranges = @selectionsOrCursorWordRanges()
            @clearSueForRanges ranges

    sueColorAtSelection: layer ->

        fg = layer == 'fg'

        for rng in @s.selections
            if area = @sueAt [rng[0] rng[1]]
                [code] = area.value
                if code == sue.FG_BG_COLOR
                    ⮐ area.value[fg ? 3 : 4]
                if fg and code == sue.FG_COLOR
                    ⮐ area.value[3]
                if not fg and code == sue.BG_COLOR
                    ⮐ area.value[3]

        null
