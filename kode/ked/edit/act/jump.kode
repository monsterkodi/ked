use ../../../kxk ▪ post
#!jump


export

    #  in a sheet text node the entry names the node, its position is in the node

    jumpEntry: pos ->

        pos ?= @mainCursor()

        entry =
            file: (@sheetPage ? @).currentFile()
            x:    pos[0]
            y:    pos[1]

        entry.node = @name if @sheetPage?

        entry

    pushJump: pos ->

        ⮐ false if @novim.jumps.keep

        @novim.jumps.record(@jumpEntry(pos))

        true

    jumpOlder: (count=1) ->

        n = max 1 (count ? 1)
        moved = false

        @pruneJumps()

        for i in 0...n
            entry = @novim.jumps.older @jumpEntry()
            break if not entry
            @jumpToEntry entry
            moved = true

        moved

    jumpNewer: (count=1) ->

        n = max 1 (count ? 1)
        moved = false

        @pruneJumps()

        for i in 0...n
            entry = @novim.jumps.newer()
            break if not entry
            @jumpToEntry entry
            moved = true

        moved

    jumpToEntry: entry ->

        page = @sheetPage ? @

        if valid entry.file and entry.file != page.currentFile()
            post.emit 'file.open' entry.file entry.x entry.y
        else
            @jumpTo entry.x entry.y entry.node

        true

    jumpChangeOlder: (count=1) ->

        n = max 1 (count ? 1)
        moved = false

        @pruneJumps()

        for i in 0...n
            pos = @novim.changes.older()
            break if not pos
            @jumpTo pos[0] pos[1] pos[2]
            moved = true

        moved

    jumpChangeNewer: (count=1) ->

        n = max 1 (count ? 1)
        moved = false

        @pruneJumps()

        for i in 0...n
            pos = @novim.changes.newer()
            break if not pos
            @jumpTo pos[0] pos[1] pos[2]
            moved = true

        moved

    #  sheets jump into the named text node, or on the page without a node

    jumpTo: (x y node) ->

        page = @sheetPage ? @

        if page.rectree?
            page.sheetJump x y node
        else
            @setMainCursor x y

    pruneJumps: ->

        page = @sheetPage ? @

        page.pruneSheetJumps() if page.rectree?

