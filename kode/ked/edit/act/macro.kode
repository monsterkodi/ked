use ../../../kxk ▪ post
#!macro
export

    macroEvent: (key event) ->

        combo = event?.combo ? key
        char  = event?.char

        { key: key  combo: combo  char: char }

    markMacroControlKey: -> @novim.macroSkipKey = true

    #  the states of sheet text nodes leave recording and replay to the page

    startMacroRecording: register append ->

        ⮐ @sheetPage.startMacroRecording(register append) if @sheetPage?
        ⮐ false if not register

        name = register.toLowerCase()

        ⮐ false if name.length != 1
        ⮐ false if name not in 'abcdefghijklmnopqrstuvwxyz'

        @macroRecording =
            register: name
            append:   append
            keys:     []

        post.emit 'novim.macro.start' state:@name register:name append:append

        true

    stopMacroRecording: ->

        ⮐ @sheetPage.stopMacroRecording() if @sheetPage?

        recording = @macroRecording

        ⮐ false if not recording

        delete @macroRecording

        name = recording.register
        name = name.toUpperCase() if recording.append

        @novim.register.setMacro name recording.keys

        post.emit 'novim.macro.stop' state:@name register:recording.register

        true

    macroError: text ->

        post.emit 'novim.error' text

        false

    playLastMacro: count ->

        ⮐ @macroError('no previous macro') if not @novim.macroLastRegister

        @playMacro @novim.macroLastRegister count

    playMacro: register count ->

        ⮐ @macroError('invalid register') if not register

        value = @novim.register.read register

        ⮐ @macroError("register #{register} is empty") if not value

        keys = value.keys

        keys ?= @novim.register.keysForText(@novim.register.textForValue(value))

        ⮐ @macroError("register #{register} is empty") if empty keys

        @novim.macroLastRegister = register

        n = max 1 (count ? 1)

        for i in 0...n
            @replayMacroKeys keys

        true

    #  a sheet replays the keys like typed ones, through its text nodes

    replayMacroKeys: events ->

        ⮐ @sheetPage.replayMacroKeys(events) if @sheetPage?
        ⮐ true if @rectree? and @novimLater(=> @replayMacroKeys events)

        if @novim.macroReplaying >= 100
            ⮐ @macroError('macro recursion too deep')

        @novim.macroReplaying += 1

        try
            for event in events
                if @rectree?
                    @feedSheetKey event.key event
                else
                    @feedKey event.key event
        catch err
            @macroError "macro failed: #{err.message}"
        finally
            @novim.macroReplaying -= 1

        true

    recordMacroKey: (key event) ->

        ⮐ false if @sheetPage?

        if @novim.macroSkipKey
            @novim.macroSkipKey = false
            ⮐ false

        ⮐ false if @novim.macroReplaying > 0
        ⮐ false if not @macroRecording

        @macroRecording.keys.push @macroEvent(key event)

        true

    feedKey: (key event) ->

        result = @handleKey key event

        @recordMacroKey key event

        ⮐ 'handled' if result != 'unhandled'
        ⮐ 'unhandled' if not event

        char  = event.char
        combo = event.combo ? key

        if valid char and \
                (char == combo or \
                combo in ['space' 'shift+space' 'return' 'tab'] or \
                combo[0..-2] == 'shift+')
            @insert char
            ⮐ 'inserted'

        'unhandled'

