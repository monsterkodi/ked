
use ../tool ◆ belt sue
#!sue
export

    sueAt: pos ->

        areas = @s.sue ? []
        ⮐ if empty areas

        [x y] = pos

        for i in areas.length-1..0 by -1
            area = areas[i]
            if area.y == y and area.x <= x
                ⮐ area

    setSue: (x y value) ->

        areas = @s.sue ? []
        @changeSue areas.concat([{x: x y: y value: value}])

    changeSue: areas ->

        @s = @s.set 'sue' areas
        @rowCache = null
        @r = []
        @pushState()
        @emit 'sue.changed'

    loadSue: areas ->

        @s = @s.set 'sue' (areas ? [])
        @rowCache = null
        @clearHistory()
        @emit 'sue.changed'

    applySueAreas: next ->

        areas = @s.sue ? []
        ⮐ if next eql areas

        @changeSue next

    clearSueForRanges: ranges ->

        ⮐ if @rectree?

        areas = @s.sue ? []
        ⮐ if empty areas or empty ranges

        ranges = belt.splitLineRanges @s.lines ranges false

        cut = sue.rangesCutFromAreasInLines ranges areas @s.lines

        ⮐ if cut eql areas

        @changeSue cut

    toggleSueFlag: flag ->

        ⮐ if @rectree?

        ranges = @selectionsOrCursorWordRanges()
        ⮐ if empty ranges

        ranges = belt.splitLineRanges @s.lines ranges false

        next = sue.rangesWithToggledFlag ranges (@s.sue ? []) @s.lines flag

        ⮐ if next eql @s.sue

        @changeSue next
##scale
    stepScales: delta ->

        ⮐ if @rectree?

        areas = @s.sue ? []
        next  = areas

        if empty @s.selections
            indices = belt.lineIndicesForPositions @s.cursors
            next = sue.areasWithSteppedLineScales(areas indices delta @lineScale)
        else
            lines = []
            runs  = []

            for piece in belt.splitLineRanges(@s.lines @s.selections false)
                if belt.isFullLineRange @s.lines piece
                    lines.push piece[1] if piece[1] not in lines
                else
                    runs.push piece

            next = sue.areasWithSteppedLineScales(next lines delta @lineScale)
            next = sue.areasWithSteppedRunsInLines(next runs delta @s.lines)

        @applySueAreas next

    clearScales: ->

        ⮐ if @rectree?

        areas = @s.sue ? []
        indices = belt.lineIndicesForRangesOrPositions @s.selections @s.cursors

        next = sue.areasWithoutLineScales(areas indices)

        for piece in belt.splitLineRanges(@s.lines @s.selections false)
            continue if belt.isFullLineRange @s.lines piece
            for run in sue.runsForLine(next @s.lines piece[1])
                if run[0] <= piece[0] and piece[2] <= run[1]
                    next = sue.areasWithoutRun(next piece[1] run[0] run[1])
                    break

        @applySueAreas next

##wrap
    toggleWrap: ->

        ⮐ if @rectree? or @wrap.all

        indices = belt.lineIndicesForRangesAndPositions @s.selections @s.cursors
        ⮐ if empty indices

        areas = @s.sue ? []
        wrap  = not sue.isWrapLine(areas @mainCursor()[1])

        @applySueAreas sue.areasWithWraps(areas indices wrap)
        @adjustViewForMainCursor()

    toggleWrapAll:  -> @setWrap all:not @wrap.all
    toggleWrapWord: -> @setWrap word:not @wrap.word

    setWrap: wrap ->

        @wrap = Object.assign {} @wrap wrap
        @rowCache = null
        @adjustViewForMainCursor()

    #  the page of a sheet is never wrapped, its lines are the rows of the grid

    isWrapped: li ->

        ⮐ false if @rectree? or not @isValidLineIndex li
        @wrap.all or sue.isWrapLine(@s.sue li)

    wrapCols: li -> max 1 int(@cells.cols / @lineScale(li))

    #  row widths replace the editor width: the rows of all lines flow through
    #  them one after the other, the last width holds for all rows past the end

    setRowWidths: widths ->

        @rowWidths = widths
        @rowCache  = null

    rowWidthAt: i -> max 1 @rowWidths[clamp(0 @rowWidths.length-1 i)]

    #  the cells row k of line li can hold, unscaled

    rowCols: (li k=0) ->

        ⮐ @wrapCols(li) if not valid @rowWidths

        @rowWidthAt @flowLayout().tops[li]+k

    #  the starts of all lines and the flow row each line begins at.
    #  the view decides which row takes the first width: the row scrollOffset of
    #  line view[1]. rows above it take the first width, their tops are negative

    flowLayout: ->

        lines = @s.lines
        view  = clamp 0 lines.length-1 @s.view[1]
        off   = @s.scrollOffset
        f     = @flowCache

        ⮐ f if f? and f.lines == lines and f.widths == @rowWidths and f.word == @wrap.word and f.ext == @syntax.ext and f.view == view and f.off == off

        starts = []
        tops   = []

        startsAt = (li row) =>
            ⮐ [0] if not @isWrapped li
            indent = @wrapLineIndent li
            width  = (k) =>
                w = @rowWidthAt row+k
                k == 0 ? w : max(1 w-min(indent int(w/2)))
            sue.wrapStarts lines[li] width @wrap.word

        row = -off
        for li in view...lines.length
            tops[li]   = row
            starts[li] = startsAt li row
            row += starts[li].length

        row = -off
        for li in view-1..0 by -1
            starts[li] = startsAt li 0
            row -= starts[li].length
            tops[li] = row

        @flowCache = lines:lines widths:@rowWidths word:@wrap.word ext:@syntax.ext view:view off:off starts:starts tops:tops

    wrapStarts: li ->

        ⮐ [0] if not @isWrapped li

        ⮐ @flowLayout().starts[li] if valid @rowWidths

        line   = @s.lines[li]
        cols   = @wrapCols li
        indent = @wrapIndent li 1
        key    = "#{cols} #{@wrap.word} #{indent}"

        @wrapCache ?= new WeakMap()

        if line is arr
            cached = @wrapCache.get line
            ⮐ cached.starts if cached?.key == key

        starts = sue.wrapStarts line cols @wrap.word indent
        @wrapCache.set line {key:key starts:starts} if line is arr
        starts

    #  the cells row k of line li is indented by, unscaled
    #  the indent follows the syntax: it lines up with the text after list
    #  bullets, headings and comment starters, but at most half the row

    wrapIndent: (li k) ->

        ⮐ 0 if k == 0 or not @isWrapped li
        min @wrapLineIndent(li) int(@rowCols(li k)/2)

    wrapLineIndent: li ->

        md   = @syntax.ext in ['md' 'markdown']
        clss = (x) => @syntax.getClass x li
        sue.wrapIndent @s.lines[li] null clss md

    wrapRow: (x li) ->

        starts = @wrapStarts li
        k = starts.length-1
        while k > 0 and starts[k] > x
            k -= 1
        k

    #  the cell of grapheme x relative to the top left of line li, view ignored
    #  cells are the grapheme cell positions of the line, plain if not given

    lineCell: (x li cells) ->

        scale   = @lineScale li
        [k cx]  = @rowCol x li cells
        cx = min cx @rowCols(li k)-1 if @isWrapped li

        [cx*scale k*scale]

    #  the row of grapheme x in line li and its cell in that row:
    #  unscaled, the indent included, not clamped to the row

    rowCol: (x li cells) ->

        cells ?= sue.cellPositionsForLine @s.lines li []
        lastIndex = cells.length-1

        cx = x <= lastIndex ? cells[x] : cells[lastIndex] + x - lastIndex

        ⮐ [0 cx] if not @isWrapped li

        k = @wrapRow x li

        [k cx - cells[@wrapStarts(li)[k]] + @wrapIndent(li k)]

    #  the grapheme at cell col of row k of line li, past the end of the last row
    #  it goes on into the empty space

    posInRow: (li k col) ->

        starts = @wrapStarts li
        cells  = sue.cellPositionsForLine @s.lines li []
        end    = @s.lines[li].length
        c      = max(0 col-@wrapIndent(li k)) + cells[starts[k]]
        stop   = (k+1 < starts.length) ? starts[k+1]-1 : end

        gi = starts[k]
        while gi < stop and cells[gi+1] <= c
            gi += 1

        gi += c - cells[gi] if gi == end

        gi

    viewX: li -> @isWrapped(li) ? 0 : @s.view[0]

    #  the last column a cursor can take in a wrapped line:
    #  the last cell of its last row, or the end of the line if that row is full

    wrapMaxX: li ->

        end    = @s.lines[li].length
        starts = @wrapStarts li
        k      = starts.length-1
        cells  = sue.cellPositionsForLine @s.lines li []
        lastIndex = cells.length-1
        cend   = end <= lastIndex ? cells[end] : cells[lastIndex] + end - lastIndex
        used   = cend - cells[starts[k]] + @wrapIndent(li k)

        max end end + @rowCols(li k)-1-used

    #  cursors in wrapped lines don't move on into the empty space past the last row

    clampToWrap: cursors ->

        out = []
        for c in cursors
            if c[1] >= 0 and @isWrapped(c[1]) and c[0] > @wrapMaxX(c[1])
                out.push [@wrapMaxX(c[1]) c[1]]
            else
                out.push c
        out

    #  a horizontal step of delta graphemes, kept inside the visual row of the
    #  wrapped line pos is in: cursors never change their row when moving sideways

    rowDelta: (pos delta) ->

        [x li] = pos

        ⮐ delta if not @isWrapped li

        starts = @wrapStarts li
        k      = @wrapRow x li
        hi     = (k+1 < starts.length) ? starts[k+1]-1 : Infinity

        clamp(starts[k] hi x+delta) - x

    hasWrap: ->

        ⮐ false if @rectree?
        ⮐ true if @wrap.all
        (@s.sue ? []).some (area) -> area.value[0] == sue.WRAP

    #  up and down move by visual rows while lines are wrapped:
    #  to the next row of the line, or into the nearest row of the next line.
    #  the cell column is kept as a goal, so short rows don't lose it

    rowStep: (pos dir goal) ->

        [x y]   = pos
        [k col] = @rowCol x y
        col     = goal if goal?
        dy      = dir == 'up' ? -1 : 1

        k += dy

        if k < 0 or k >= @wrapStarts(y).length
            y += dy
            ⮐ [[x pos[1]] col] if not @isValidLineIndex y
            k = dy < 0 ? @wrapStarts(y).length-1 : 0

        nx = @posInRow y k col
        nx = min nx @wrapMaxX(y) if @isWrapped y

        [[nx y] col]

    rowSteps: (pos dir count goal) ->

        for i in 0...count
            [pos goal] = @rowStep pos dir goal
        [pos goal]

    rowGoals: ->

        g = @rowGoalCache
        ⮐ {} if not g? or g.cursors != @s.cursors
        g.goals

    keepRowGoals: goals -> @rowGoalCache = cursors:@s.cursors goals:goals

    moveRowsAndSelect: dir ->

        @anchors = @allCursors() if empty @anchors

        after   = (a b) -> a[1] > b[1] or a[1] == b[1] and a[0] > b[0]
        between = (a b) -> after(a b) ? [b[0] b[1] a[0] a[1]] : [a[0] a[1] b[0] b[1]]

        rngs    = @s.selections.asMutable deep:true
        goals   = @rowGoals()
        next    = {}
        cursors = []

        for pos,idx in @allCursors()

            anch = @anchors[idx] ? pos
            [np goal] = @rowStep pos dir goals["#{pos[0]} #{pos[1]}"]
            next["#{np[0]} #{np[1]}"] = goal
            cursors.push np

            if dir == 'up' ? after(pos anch) : after(anch pos)
                rngs = belt.removeFromLineRangesBetweenPositions rngs pos np
                rngs.push between(anch np)
            else
                rngs.push between(pos np)

        @setSelections belt.clampLineRanges(@s.lines rngs)
        @setCursors cursors adjust:'topBotDelta' keepAnchors:true
        @keepRowGoals next

    scaleRunsForLine: y ->

        areas = @s.sue ? []
        ⮐ [] if empty areas

        sue.runsForLine(areas @s.lines y)

    clearSueAtCursorOrSelection: ->

        if ranges = @selectionsOrCursorWordRanges()
            @clearSueForRanges ranges

    sueColorAtSelection: layer ->

        fg = layer == 'fg'

        for rng in @s.selections
            if area = @sueAt [rng[0] rng[1]]
                [code] = area.value
                if code == sue.FG_BG_COLOR
                    ⮐ area.value[fg ? 3 : 4]
                if fg and code == sue.FG_COLOR
                    ⮐ area.value[3]
                if not fg and code == sue.BG_COLOR
                    ⮐ area.value[3]

        null
