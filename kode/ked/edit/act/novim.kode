
use ../../../kxk ▪ kseg post
use ../mode      ◆ novim
use ../tool      ◆ belt motion
use ../../util   ◆ config
#!novim
export

    executeNovim: cmd ->

        # log 'novim command ▸' cmd

        if cmd.motion
            cmd.motion.count ?= cmd.count

        if @visual and cmd.operator not in ['move' 'matchBracket' 'visualDelete' 'visualYank' 'visualChange' 'visualSwap' 'visualTextObject' 'visualIndent' 'visualDeindent' 'visualReplace' 'visualCase' 'visualBlockPrepend' 'visualBlockAppend']
            @stopVisual()

        switch cmd.operator
            'change'                ➜ @changeByMotion       cmd.motion  cmd.register
            'delete'                ➜ @applyChange          cmd
            'yank'                  ➜ @yankByMotion         cmd.motion  cmd.register
            'put'                   ➜ @putRegister          cmd.count   cmd.after cmd.register
            'move'                  ➜ @moveByMotion         cmd.motion  cmd.count
            'searchNext'            ➜ @jumpByHighlight      cmd.count   cmd.text (valid cmd.forward ? cmd.forward : novim.lastVindForward)
            'searchPrev'            ➜ @jumpByHighlight      cmd.count   cmd.text (valid cmd.forward ? cmd.forward : not novim.lastVindForward)
            'searchWord'            ➜ @searchWord           cmd.count   cmd.forward
            'matchBracket'          ➜ @matchBracket()
            'openLine'              ➜ @openLine             cmd.count   cmd.after
            'insertAtIndent'        ➜ @insertAtIndent()
            'replace'               ➜ @replaceChars         cmd.char    cmd.count
            'visualReplace'         ➜ @visualReplace        cmd.char
            'lowercase'             ➜ @caseByMotion         cmd.motion 'lower'
            'uppercase'             ➜ @caseByMotion         cmd.motion 'upper'
            'toggleCaseMotion'      ➜ @caseByMotion         cmd.motion 'toggle'
            'visualCase'            ➜ @visualCase           cmd.kind
            'toggleCase'            ➜ @toggleCase           cmd.count
            'joinLinesVim'          ➜ @joinLinesVim         cmd.count
            'visualDelete'          ➜ @visualDelete         cmd.register
            'visualYank'            ➜ @visualYank           cmd.register
            'visualChange'          ➜ @visualChange()
            'visualSwap'            ➜ @visualSwap()
            'visualTextObject'      ➜ @visualTextObject     cmd.motion
            'indent'                ➜ @indentByMotion       cmd.motion  false
            'deindent'              ➜ @indentByMotion       cmd.motion  true
            'visualIndent'          ➜ @indentVisual         cmd.count   false
            'visualDeindent'        ➜ @indentVisual         cmd.count   true
            'visualBlockPrepend'    ➜ @visualBlockInsert    false
            'visualBlockAppend'     ➜ @visualBlockInsert    true
            'undo'                  ➜ @undoCommand          cmd.count
            'repeat'                ➜ @repeatChange         cmd.count
                                    ➜ log 'novim unknown operator ▸' cmd.operator

    searchPosition: ->

        spans = @s.highlights

        ⮐ null if empty spans

        pos = @mainCursor()

        for span, index in spans
            if span[0] == pos[0] and span[1] == pos[1]
                ⮐ [index+1 spans.length]

        [0 spans.length]

    jumpByHighlight: count text forward ->

        if empty @s.highlights
            if valid text
                @highlightText text
            else
                ⮐ 

        pos = @mainCursor()

        for i in 0...count

            target = null

            for span in @s.highlights

                sameStart = span[1] == pos[1] and span[0] == pos[0]
                if sameStart ➜ continue # the cursor is already on this highlight

                after  = span[1]  > pos[1] or (span[1] == pos[1] and span[0] > pos[0])
                before = span[1]  < pos[1] or (span[1] == pos[1] and span[0] < pos[0])

                if  forward and after
                    target = span
                    break
                if not forward and before
                    target = span

            if not target
                break

            pos = [target[0] target[1]]

        @setMainCursor pos

    wordSpansForText: text ->

        spans = []

        for span in belt.lineSpansForText(@s.lines, text)

            [x1 y x2] = span
            line      = kseg.str @s.lines[y]
            before    = x1 > 0 ? line[x1-1] : ''
            after     = x2 < line.length ? line[x2] : ''

            continue if /\w/.test(text[0]) and /\w/.test(before)
            continue if /\w/.test(text[text.length-1]) and /\w/.test(after)

            spans.push span

        spans

    searchWord: count forward ->

        text = @wordAtCursor()

        ⮐ if empty text

        novim.lastVind = text
        novim.lastVindForward = forward

        spans = @wordSpansForText text

        @setHighlights spans

        rng = belt.rangeOfClosestWordToPos @s.lines @mainCursor()

        ⮐ if not rng

        start = [rng[0] rng[1]]
        end   = [rng[2] rng[3]]
        pos   = @mainCursor()
        moved = false

        for i in 0...max(1, count ? 1)

            target = null

            for span in spans

                after  = span[1] > end[1] or (span[1] == end[1] and span[0] > end[0])
                before = span[1] < start[1] or (span[1] == start[1] and span[0] < start[0])

                if forward and after
                    target = span
                    break
                if not forward and before
                    target = span

            break if not target

            start = [target[0] target[1]]
            end   = [target[0]+text.length target[1]]
            pos   = [target[0] target[1]]
            moved = true

        @setMainCursor pos[0] pos[1] if moved

    matchBracket: ->

        lines      = @s.lines
        cursors    = @allCursors()
        newCursors = []
        moved      = false

        for c in cursors

            line = lines[c[1]]
            segi = kseg.indexAtWidth line c[0]
            found = null

            while segi < line.length

                ch = line[segi]

                if ch in ['(' ')' '[' ']' '{' '}']
                    found = [kseg.widthAtSegi(line, segi), c[1], ch]
                    break

                segi += 1

            if not found
                newCursors.push c
                continue

            ch = found[2]
            open = switch ch
                '(' '[' '{' ➜ ch
                ')' ➜ '('
                ']' ➜ '['
                '}' ➜ '{'

            spans = motion.pairSpansForPosition lines found[0] found[1] open

            if not spans
                newCursors.push c
                continue

            target = open == ch ? [spans[1][0] spans[1][1]] : [spans[0][0] spans[0][1]]

            newCursors.push target
            moved = true

        if moved
            @setCursors newCursors main:@s.main
            
        @updateVisual() if @visual

    startVisual: kind ->

        if @visual == kind
            ⮐ @stopVisual()

        if not @visual
            @visualAnchors = @allCursors().map (c) -> [c[0] c[1]]

        @visual = kind

        @updateVisual()

    stopVisual: (keepSelections=false remember=true) ->

        @rememberVisual() if remember

        @visual        = null
        @visualAnchors = []

        if not keepSelections
            @setSelections []

    rememberVisual: ->

        ⮐ false if not @visual

        pairs = @visualPairs()

        ⮐ false if empty pairs

        main = @mainCursor()

        @lastVisual =
            kind:  @visual
            pairs: pairs
            main:  [main[0] main[1]]
            lines: @s.lines

        true

    startLastVisual: ->

        lv = @lastVisual

        ⮐ false if not lv or empty lv.pairs

        lines   = @s.lines
        lineMap = belt.lineIndexMap lv.lines lines

        mapped = (pos) ->
            y = clamp 0 lines.length-1 (lineMap[pos[1]] ? pos[1])
            x = clamp 0 kseg.width(lines[y]) pos[0]
            [x y]

        pairs  = lv.pairs.map (p) -> [mapped(p[0]) mapped(p[1])]
        main   = mapped lv.main
        starts = pairs.map (p) -> [p[1][0] p[1][1]]

        @visual        = lv.kind
        @visualAnchors = pairs.map (p) -> [p[0][0] p[0][1]]

        @setCursors starts main:main
        @updateVisual()

        true

    visualPairs: ->

        cursors = @allCursors()
        anchors = @visualAnchors
        pairs   = []

        for cursor, i in cursors

            anchor = anchors[i] ? [cursor[0] cursor[1]]

            pairs.push [[anchor[0] anchor[1]] [cursor[0] cursor[1]]]

        pairs.sort (a b) ->
            if a[1][1] == b[1][1]
                a[1][0] - b[1][0]
            else
                a[1][1] - b[1][1]

        unique = []

        for pair in pairs
            continue if unique.length and belt.samePos unique[-1][1] pair[1]
            unique.push pair

        unique

    visualRangeForPair: anchor cursor ->

        if @visual == 'line'

            y1 = min anchor[1] cursor[1]
            y2 = max anchor[1] cursor[1]

            ⮐ [0 y1 kseg.width(@s.lines[y2]) y2]

        a = [anchor[0] anchor[1]]
        b = [cursor[0] cursor[1]]

        if b[1] < a[1] or b[1] == a[1] and b[0] < a[0]
            [a b] = [b a]

        [a[0] a[1] b[0] b[1]]

    visualBlockRanges: anchor cursor ->

        y1 = min anchor[1] cursor[1]
        y2 = max anchor[1] cursor[1]
        x1 = min anchor[0] cursor[0]
        x2 = max anchor[0] cursor[0]

        ⮐ [] if x1 == x2
        
        @blockRangesForRect @s.lines x1 y1 x2 y2
        
    blockRangesForShape: shape cursor ->

        ⮐ [] if empty @s.lines

        y1 = min cursor[1] @s.lines.length-1
        y2 = min cursor[1]+shape.y2 @s.lines.length-1
        x1 = cursor[0]
        x2 = x1+shape.x2
        
        @blockRangesForRect @s.lines x1 y1 x2 y2

    blockRangesForRect: lines x1 y1 x2 y2 ->
    
        rngs = []
        for y in y1..y2
        
            continue if y >= lines.length

            width = kseg.width lines[y]

            continue if x1 >= width
                       
            xe = min x2 width

            continue if xe <= x1

            rngs.push [x1 y xe y]

        rngs

    updateVisual: ->

        ⮐ if not @visual

        pairs   = @visualPairs()
        cursors = pairs.map (p) -> [p[1][0] p[1][1]]
        anchors = pairs.map (p) -> [p[0][0] p[0][1]]

        @visualAnchors = anchors

        same = cursors.length == @s.cursors.length

        if same
            for cursor, i in cursors
                same = false if not belt.samePos cursor @s.cursors[i]

        if not same
            @setCursors cursors main:@mainCursor()

        rngs = []
        for pair in pairs
            if @visual == 'block'
                rngs = rngs.concat @visualBlockRanges(pair[0] pair[1])
            else
                rngs.push @visualRangeForPair(pair[0] pair[1])

        @setSelections rngs

    visualDelete: register ->

        rngs = @s.selections.asMutable()

        ⮐ if empty rngs

        linewise = @visual == 'line'

        blockStarts = null

        if @visual == 'block'
            blockStarts = @visualPairs().map (p) -> [min(p[0][0] p[1][0]) min(p[0][1] p[1][1])]

        @setNovimRegister rngs linewise register 'delete'

        @rememberVisual()

        @lastChange = { operator: 'visualDelete', linewise: linewise, register: register, shapes: @visualRepeatShapes() }

        @begin()

        @deleteRanges rngs @allCursors() linewise

        @end()

        @setCursors(blockStarts main:@s.main) if blockStarts

        @stopVisual false false

    visualYank: register ->

        rngs = @s.selections.asMutable()

        ⮐ if empty rngs

        linewise = @visual == 'line'

        @setNovimRegister rngs linewise register 'yank'
        @flashYank rngs

        if @visual == 'block'
            pairs  = @visualPairs()
            starts = pairs.map (p) -> [min(p[0][0] p[1][0]) min(p[0][1] p[1][1])]
        else
            starts = rngs.map (r) -> [r[0] r[1]]

        @rememberVisual()

        @setCursors starts main:@mainCursor()

        @stopVisual false false

    visualChange: ->

        rngs = @s.selections.asMutable()

        ⮐ if empty rngs

        @rememberVisual()

        @startNovimInsert { kind: 'visual', linewise: @visual == 'line', shapes: @visualRepeatShapes() }

        @setCursors belt.endPositionsOfRanges(rngs) main:@mainCursor()

        @visual        = null
        @visualAnchors = []

    visualReplace: text ->

        rngs = @s.selections.asMutable()

        ⮐ if empty rngs

        if @visual == 'block'
            pairs  = @visualPairs()
            starts = pairs.map (p) -> [min(p[0][0] p[1][0]) min(p[0][1] p[1][1])]
        else
            starts = rngs.map (r) -> [r[0] r[1]]

        shapes = @visualRepeatShapes()

        @rememberVisual()

        @begin()

        changed = @replaceRanges rngs text

        @end()

        ⮐ if not changed

        lines  = @s.lines
        starts = starts.map (p) -> [min(p[0] kseg.width(lines[p[1]])) p[1]]

        @setCursors starts main:@s.main
        @stopVisual false false

        @lastChange = { operator: 'visualReplace', char: text, shapes: shapes }

    visualBlockInsert: after ->

        rngs = @s.selections

        ⮐ if empty rngs

        cursors = rngs.map (r) -> [after ? r[2] : r[0] r[1]]

        @rememberVisual()

        @startNovimInsert { kind: after ? 'blockAppend' : 'blockPrepend', shapes: @visualRepeatShapes() }

        @stopVisual false false

        @setCursors cursors main:@s.main

    visualRepeatShapes: ->

        shapes = []

        if @visual == 'line'

            y1 = Infinity
            y2 = -1

            for rng in @s.selections
                y1 = min y1 rng[1]
                y2 = max y2 rng[3]

            shapes.push { linewise: true, count: y2-y1+1 }

        else if @visual == 'block'

            if not empty @s.selections

                x1 = Infinity
                x2 = -1
                y1 = Infinity
                y2 = -1

                for rng in @s.selections
                    x1 = min x1 rng[0]
                    x2 = max x2 rng[2]
                    y1 = min y1 rng[1]
                    y2 = max y2 rng[3]

                shapes.push { block: true, x1: 0, y1: 0, x2: x2-x1, y2: y2-y1 }

        else

            for rng in @s.selections
                shapes.push { linewise: false, x1: 0, y1: 0, x2: rng[2]-rng[0], y2: rng[3]-rng[1] }

        shapes

    visualSwap: ->

        ⮐ if not @visual

        cursors = @allCursors()
        anchors = @visualAnchors

        for cursor, i in cursors

            continue if not anchors[i]

            anchor     = anchors[i]
            anchors[i] = [cursor[0] cursor[1]]
            cursors[i] = [anchor[0] anchor[1]]

        @visualAnchors = anchors

        @setCursors cursors main:@mainCursor()

        @updateVisual()

    visualTextObject: spec ->

        ⮐ if not @visual

        rngs = []

        for cursor in @allCursors()

            rng = motion.range @s.lines cursor spec

            continue if not rng
            continue if belt.isEmptyRange rng

            rngs.push rng

        ⮐ if empty rngs

        @visualAnchors = rngs.map (r) -> [r[0] r[1]]

        cursors = rngs.map (r) -> [max(r[0] r[2]-1) r[3]]

        @setCursors cursors main:@mainCursor()

        @updateVisual()

    indentByMotion: spec deindent=false ->

        indices = []

        for cursor in @allCursors()

            rng = motion.range @s.lines cursor spec

            continue if not rng

            indices = indices.concat belt.lineIndicesForRange(rng)

        ⮐ if empty indices

        @indentAtIndices indices deindent

        @lastChange = { operator: deindent ? 'deindent' : 'indent', motion: copy(spec) }

    indentVisual: count deindent=false ->

        indices = belt.lineIndicesForRanges @s.selections

        ⮐ if empty indices

        indices = Array.from new Set(indices)
        indents = {}

        for index in indices
            indents[index] = belt.numIndent @s.lines[index]

        @indentAtIndices indices deindent (count ? 1)

        anchors = []

        for anchor in @visualAnchors

            oldIndent = indents[anchor[1]]

            if oldIndent?
                shift = belt.numIndent(@s.lines[anchor[1]]) - oldIndent
                anchors.push [max(0 anchor[0]+shift) anchor[1]]
            else
                anchors.push [anchor[0] anchor[1]]

        @visualAnchors = anchors

        @lastChange = { operator: deindent ? 'deindent' : 'indent', motion: { kind: 'line', count: indices.length } }

        @updateVisual()

    indentAtIndices: indices deindent=false times=1 ->

        indices = Array.from new Set(indices)

        indices.sort (a b) -> a - b

        ⮐ if empty indices

        n = max 1 (times ? 1)

        @begin()

        for i in 0...n

            if deindent
                [lines selections cursors] = belt.deindentLineRangesAndPositionsAtIndices @s.lines @s.selections @s.cursors indices
            else
                [lines selections cursors] = belt.indentLineRangesAndPositionsAtIndices @s.lines @s.selections @s.cursors indices

            @setLines lines
            @setSelections selections
            @setCursors cursors main:@mainCursor()

        @end()

    applyChange: cmd ->

        @lastChange = cmd
        @deleteByMotion cmd.motion cmd.register

    startNovimInsert: spec ->

        @novimInsert = copy spec

        @novimInsert.text ?= ''
        
        switch spec.kind
            'append'         ➜ @moveCursors 'right'
            'appendEol'      ➜ @moveCursors 'eol'
            'insertAtIndent' ➜ @moveCursors 'ind'
        
        @stopMode 'novim'
        @novimInsert

    startNovimReplace: count ->

        n = max 1 (count ? 1)

        @novimInsert = { kind: 'replace', text: '', count: n, undo: [] }

        for i in 0...@s.cursors.length
            @novimInsert.undo.push []

        @novimInsert

    replaceNovimChar: text ->

        ni = @novimInsert

        ⮐ false if not ni or ni.kind != 'replace'

        lines   = @s.lines.map (l) -> l
        cursors = @allCursors()
        changed = false

        for c, i in cursors

            if not ni.undo[i]
                ni.undo[i] = []

            line  = lines[c[1]]
            width = kseg.width line
            x     = min c[0] width
            si    = kseg.indexAtWidth line x

            old = null
            old = line[si] if si < line.length

            if old?
                newLine = line[0...si].concat([text]).concat(line[si+1..])
            else
                newLine = line[0...si].concat([text])

            lines[c[1]] = newLine
            ni.undo[i].push { x: x, y: c[1], old: old }

            c[0]    = kseg.width newLine[0...si+1]
            changed = true

        ⮐ false if not changed

        @setLines lines
        @setCursors cursors main:@s.main

        @recordNovimInsert text

        true

    replaceNovimBackspace: ->

        ni = @novimInsert

        ⮐ false if not ni or ni.kind != 'replace'

        lines   = @s.lines.map (l) -> l
        cursors = @allCursors()
        changed = false

        for c, i in cursors

            hist = ni.undo[i]

            continue if empty hist

            rec = hist.pop()

            continue if not rec
            continue if rec.y < 0 or rec.y >= lines.length

            line = lines[rec.y]
            si   = kseg.indexAtWidth line rec.x

            continue if si >= line.length

            if rec.old?
                newLine = line[0...si].concat([rec.old]).concat(line[si+1..])
            else
                newLine = line[0...si].concat(line[si+1..])

            lines[rec.y] = newLine
            c[0] = rec.x
            c[1] = rec.y
            changed = true

        ⮐ false if not changed

        @setLines lines
        @setCursors cursors main:@s.main

        @recordNovimBackspace()

        true

    recordNovimInsert: text ->

        ⮐ if not @novimInsert or @novimReplaying

        if @novimInsert.kind == 'replace' and '\n' in text
            @novimInsert.undo = @novimInsert.undo.map (h) -> []

        @novimInsert.text += text

    recordNovimBackspace: ->

        ⮐ if not @novimInsert or @novimReplaying

        text = @novimInsert.text

        @novimInsert.text = text[0...-1] if text.length

    finishNovimInsert: ->

        ⮐ if not @novimInsert

        insert = @novimInsert

        @novimInsert = null

        if insert.kind == 'replace'
            n = max 1 (insert.count ? 1)
            if n > 1 and not empty insert.text and '\n' not in insert.text
                @replaceTextAtCursors insert.text (n-1)
            text = ''
            for i in 0...n
                text += insert.text
            @lastChange = { operator: 'replaceMode', text: text }
        else
            @lastChange = { operator: 'insert', insert: insert }

    repeatChange: count ->

        ⮐ if not @lastChange

        switch @lastChange.operator
            'replace'     ➜ @replaceChars     @lastChange.char     (count > 1 ? count : @lastChange.count)
            'toggleCase'  ➜ @toggleCase       (count > 1 ? count : @lastChange.count)
            'joinLinesVim'➜ @joinLinesVim     (count > 1 ? count : @lastChange.count)
            'indent'      ➜ @repeatIndent     count false
            'deindent'    ➜ @repeatIndent     count true
            'insert'      ➜ @repeatInsert     count
            'put'         ➜ @repeatPut        count
            'visualDelete'➜ @repeatVisual     count 'delete'
            'visualReplace'➜ @repeatVisual    count 'replace'
            'visualCase'  ➜ @repeatVisual     count 'case'
            'replaceMode'➜ @repeatReplaceMode  count
            'case'        ➜ @repeatCase        count
            else
                spec = copy @lastChange.motion

                spec.count = count if count > 1

                @deleteByMotion spec @lastChange.register

    repeatIndent: count deindent ->

        spec = copy (@lastChange.motion ? { kind: 'line', count: 1 })

        spec.count = count if count > 1

        @indentByMotion spec deindent

    repeatCase: count ->

        spec = copy @lastChange.motion

        spec.count = count if count > 1

        @caseByMotion spec @lastChange.kind

    repeatReplaceMode: count ->

        text = @lastChange.text

        ⮐ if empty text
        ⮐ if '\n' in text

        n = max 1 (count ? 1)

        @replaceTextAtCursors text n

    replaceTextAtCursors: text times ->

        graphemes = kseg text

        ⮐ if empty graphemes

        n       = max 1 (times ? 1)
        lines   = @s.lines.map (l) -> l
        cursors = @allCursors()
        changed = false

        for c in cursors

            for k in 0...n

                line  = lines[c[1]]
                width = kseg.width line
                x     = min c[0] width
                si    = kseg.indexAtWidth line x
                gone  = min graphemes.length line.length-si

                newLine = line[0...si].concat(graphemes).concat(line[si+gone..])

                lines[c[1]] = newLine
                c[0]        = kseg.width newLine[0...si+graphemes.length]
                changed     = true

        ⮐ if not changed

        @setLines lines
        @setCursors cursors main:@s.main

        true

    repeatPut: count ->

        n = max 1 (count > 1 ? count : @lastChange.count)

        @putRegLines @lastChange.reg n @lastChange.after

    repeatInsert: count ->

        insert = @lastChange.insert

        n = max 1 (count ? 1)

        for i in 0...n
            @replayInsert insert

    replayInsert: insert ->

        switch insert.kind
            'insert'         ➜ @insertForRepeat insert.text
            'append'         ➜ @moveCursors('right'); @insertForRepeat insert.text
            'appendEol'      ➜ @moveCursors('eol');   @insertForRepeat insert.text
            'insertAtIndent' ➜ @moveCursors('ind');   @insertForRepeat insert.text
            'openLineAfter'  ➜ @putOpenLines(insert, true);  @insertForRepeat insert.text
            'openLineBefore' ➜ @putOpenLines(insert, false); @insertForRepeat insert.text
            'blockPrepend'   ➜ @replayBlockInsert insert false
            'blockAppend'    ➜ @replayBlockInsert insert true
            'change'         ➜ @replayChange insert
            'visual'         ➜ @replayVisual insert 'change'
            else             ➜ log 'novim unknown insert ▸' insert.kind

    replayChange: insert ->

        spec = copy insert.motion

        rngs = @selectByMotion spec

        ⮐ if empty rngs

        @setCursors belt.endPositionsOfRanges(rngs) main:@s.main

        @insertForRepeat insert.text

    putOpenLines: insert after ->

        n = max 1 (insert.count ? 1)

        @begin()

        for i in 0...n
            @putLines [''] after

        @end()

    replayBlockInsert: insert after ->

        shape = insert.shapes[0]

        ⮐ if not shape

        rngs = @blockRangesForShape shape @mainCursor()

        ⮐ if empty rngs

        cursors = rngs.map (r) -> [after ? r[2] : r[0] r[1]]

        @setCursors cursors main:@s.main

        @insertForRepeat insert.text

    insertForRepeat: text ->

        @novimReplaying = true

        @insert text

        @novimReplaying = false

    repeatVisual: count action ->

        n = max 1 (count ? 1)

        for i in 0...n
            @replayVisual @lastChange action

    replayVisual: change action ->

        rngs = []

        cursors = @allCursors()

        cursors = [@mainCursor()] if change.shapes.length and change.shapes[0].block

        for cursor, i in cursors

            shape = change.shapes[min(i, change.shapes.length-1)] ? change.shapes[0]

            continue if not shape

            if shape.block
                for rng in @blockRangesForShape(shape, cursor)
                    rngs.push rng
                continue

            rng = @rangeForVisualShape shape cursor

            continue if not rng
            continue if belt.isEmptyRange rng

            rngs.push rng

        ⮐ if empty rngs

        if action == 'delete'

            @setNovimRegister rngs change.linewise change.register 'delete'

            @begin()

            @deleteRanges rngs @allCursors() change.linewise

            @end()

        else if action == 'replace'

            @begin()

            changed = @replaceRanges rngs change.char

            @end()

            ⮐ if not changed

            if change.shapes.length and change.shapes[0].block
                x = Infinity
                y = Infinity
                for rng in rngs
                    x = min x rng[0]
                    y = min y rng[1]
                starts = [[x y]]
            else
                starts = rngs.map (r) -> [r[0] r[1]]

            lines  = @s.lines
            starts = starts.map (p) -> [min(p[0] kseg.width(lines[p[1]])) p[1]]

            @setCursors starts main:@s.main

        else if action == 'case'

            @begin()

            @changeCaseInRanges rngs change.kind

            @end()

            if change.shapes.length and change.shapes[0].block
                x = Infinity
                y = Infinity
                for rng in rngs
                    x = min x rng[0]
                    y = min y rng[1]
                starts = [[x y]]
            else
                starts = rngs.map (r) -> [r[0] r[1]]

            lines  = @s.lines
            starts = starts.map (p) -> [min(p[0] kseg.width(lines[p[1]])) p[1]]

            @setCursors starts main:@s.main

        else

            @setSelections rngs

            @setCursors belt.endPositionsOfRanges(rngs) main:@s.main

            @insertForRepeat change.text

    rangeForVisualShape: shape cursor ->

        lines = @s.lines

        ⮐ if empty lines

        if shape.linewise

            y1 = min cursor[1] lines.length-1
            y2 = min cursor[1]+shape.count-1 lines.length-1

            ⮐ [0 y1 kseg.width(lines[y2]) y2]

        y1 = min cursor[1] lines.length-1
        y2 = min cursor[1]+shape.y2 lines.length-1

        x1 = min cursor[0] kseg.width(lines[y1])
        x2 = min cursor[0]+shape.x2 kseg.width(lines[y2])

        [x1 y1 x2 y2]

    usesClipboard: register ->

        register = '+' if register == 'clipboard'

        ⮐ true  if register in ['+' '*']
        ⮐ false if register

        novim.clipboardEnabled()

    copyRegisterToClipboard: reg ->

        @registers.writeClipboard reg

    registerFromClipboard: ->

        @registers.readClipboard()

    selectByMotion: spec ->

        lines = @s.lines
        rngs  = []

        for cursor in @allCursors()

            rng = motion.range lines cursor spec
            continue if not rng

            continue if belt.isEmptyRange(rng) and not motion.isLinewise(spec)

            rngs.push rng

        ⮐ if empty rngs

        rngs = motion.mergeRanges rngs

        @setSelections rngs

        rngs

    setNovimRegister: rngs linewise register operation='yank' ->

        texts = []

        for rng in rngs
            texts.push belt.textForLineRange(@s.lines, rng)

        value = { lines: texts.join('\n').split('\n'), linewise: linewise }

        @novimRegister = value if register != '_'

        @registers.write register value operation

        @copyRegisterToClipboard value if @usesClipboard(register) and not register

    deleteByMotion: spec register ->

        rngs = @selectByMotion spec

        ⮐ if empty rngs

        linewise = motion.isLinewise spec

        @setNovimRegister rngs linewise register 'delete'

        @begin()

        @deleteRanges rngs @allCursors() linewise

        @end()

    changeByMotion: spec register ->

        rngs = @selectByMotion spec

        ⮐ if empty rngs

        @setCursors belt.endPositionsOfRanges(rngs)

        @startNovimInsert { kind: 'change', motion: copy(spec) }

    yankByMotion: spec register ->

        linewise = motion.isLinewise spec
        cursors  = @allCursors()
        rngs = []
        for cursor,idx in cursors

            rng = motion.range @s.lines cursor spec
            continue if not rng
            continue if belt.isEmptyRange(rng) and not linewise
            rngs.push rng
            cursors[idx] = [rng[0] rng[1]] if not linewise

        ⮐ if empty rngs
        
        @setNovimRegister rngs linewise register 'yank'
        @flashYank rngs

        if not linewise
            @setCursors cursors main:@s.main
            @clampCursorsToLines()

    flashYank: rngs ->

        ⮐ if empty rngs

        clearTimeout @yankFlashTimer if @yankFlashTimer

        flashMs = config.data?.novim?.yankFlashMs ? 500
        @yankFlash      = rngs
        @yankFlashTimer = setTimeout (=> @clearYankFlash()) flashMs

    clearYankFlash: ->

        clearTimeout @yankFlashTimer if @yankFlashTimer

        @yankFlashTimer = null

        ⮐ if not @yankFlash

        @yankFlash = null

        post.emit 'redraw'

    registerForPut: register ->

        ⮐ @registers.read('+') if @usesClipboard(register)
        ⮐ @registers.read(register) if register

        @novimRegister

    putRegister: count after register ->

        reg = @registerForPut register

        ⮐ if not reg or empty reg.lines

        n = max 1 (count ? 1)

        @putRegLines reg n after

        @lastChange = { operator: 'put', after: after, count: n, register: register, reg: { lines: copy(reg.lines), linewise: reg.linewise } }

    putRegLines: reg count after ->

        @begin()

        for i in 0...count
            if reg.linewise
                @putLines reg.lines after
            else
                @putText reg.lines.join('\n') after

        @end()

    putLines: insertLines after ->

        segls   = kseg.segls insertLines
        lines   = @s.lines.map (l) -> l
        cursors = @allCursors()
        order   = []

        for c, idx in cursors
            order.push idx

        order.sort (a b) ->
            if cursors[a][1] == cursors[b][1]
                cursors[a][0] - cursors[b][0]
            else
                cursors[a][1] - cursors[b][1]

        newCursors = []
        offset     = 0

        for idx in order

            y  = cursors[idx][1] + offset
            at = after ? y+1 : y

            lines = lines[0...at].concat(segls).concat(lines[at..])

            first = segls[0]
            x     = min belt.numIndent(first) max(0 kseg.width(first)-1)

            newCursors.push [x at]
            offset += segls.length

        @setLines lines
        @setCursors newCursors

    putText: text after ->

        lines   = @s.lines
        cursors = @allCursors()
        posl    = []

        for c in cursors
            width = kseg.width lines[c[1]]
            x     = min(c[0] width)
            x     = max(0 x-1) if not after
            posl.push [x c[1]]

        [newLines newPosl] = belt.insertTextAtPositions lines text posl

        @setLines newLines
        @setCursors newPosl

    openLine: count after ->

        @putOpenLines { count:count } after

        @startNovimInsert { kind: after ? 'openLineAfter' : 'openLineBefore', count:count }

    insertAtIndent: ->

        @startNovimInsert kind: 'insertAtIndent'

    replaceRanges: rngs text ->

        lines   = @s.lines.map (l) -> l
        changed = false

        for rng in rngs

            [x1 y1 x2 y2] = rng

            for y in y1..y2

                continue if y < 0 or y >= lines.length

                line  = lines[y]
                width = kseg.width line

                from = y == y1 ? x1 : 0
                to   = y == y2 ? x2 : width

                from = clamp 0 width from
                to   = clamp 0 width to

                continue if to <= from

                si = kseg.indexAtWidth line from
                ei = kseg.indexAtWidth line to

                continue if ei <= si

                repl = []
                for i in 0...ei-si
                    repl.push text

                lines[y] = line[0...si].concat(repl).concat(line[ei..])
                changed   = true

        ⮐ false if not changed

        @setLines lines

        true

    replaceChars: text count ->

        n       = max 1 (count ? 1)
        lines   = @s.lines.map (l) -> l
        cursors = @allCursors()
        changed = false

        for c in cursors

            line = lines[c[1]].asMutable()
            segi = kseg.indexAtWidth line c[0]

            continue if segi+n > line.length

            repl = []
            for i in 0...n
                repl.push text

            newLine = line[0...segi].concat(repl).concat(line[segi+n..])

            lines[c[1]] = newLine
            c[0]        = kseg.width newLine[0...segi+n]
            changed     = true

        ⮐ if not changed

        @begin()

        @setLines lines
        @setCursors cursors main:@s.main

        @end()

        @lastChange = { operator: 'replace', char: text, count: n }

    changeCaseInRanges: rngs kind ->

        lines   = @s.lines.map (l) -> l
        changed = false

        for rng in rngs

            [x1 y1 x2 y2] = rng

            for y in y1..y2

                continue if y < 0 or y >= lines.length

                line  = lines[y].asMutable()
                width = kseg.width line

                from = y == y1 ? x1 : 0
                to   = y == y2 ? x2 : width

                from = clamp 0 width from
                to   = clamp 0 width to

                continue if to <= from

                si = kseg.indexAtWidth line from
                ei = kseg.indexAtWidth line to

                continue if ei <= si

                for i in si...ei

                    seg   = line[i]
                    upper = seg.toUpperCase()
                    lower = seg.toLowerCase()

                    if kind == 'lower'
                        newSeg = lower
                    else if kind == 'upper'
                        newSeg = upper
                    else
                        newSeg = upper != seg ? upper : lower

                    if newSeg != seg
                        line[i] = newSeg
                        changed = true

                lines[y] = line

        ⮐ false if not changed

        @setLines lines

        true

    caseByMotion: spec kind ->

        rngs = []

        for cursor in @allCursors()

            rng = motion.range @s.lines cursor spec

            continue if not rng
            continue if belt.isEmptyRange rng

            rngs.push rng

        ⮐ if empty rngs

        @begin()

        @changeCaseInRanges rngs kind

        starts = rngs.map (r) -> [r[0] r[1]]

        @setCursors starts main:@s.main

        @end()

        @lastChange = { operator: 'case', kind: kind, motion: copy(spec) }

    visualCase: kind ->

        rngs = @s.selections.asMutable()

        ⮐ if empty rngs

        if @visual == 'block'
            pairs  = @visualPairs()
            starts = pairs.map (p) -> [min(p[0][0] p[1][0]) min(p[0][1] p[1][1])]
        else
            starts = rngs.map (r) -> [r[0] r[1]]

        shapes = @visualRepeatShapes()

        @rememberVisual()

        @begin()

        @changeCaseInRanges rngs kind

        @end()

        lines  = @s.lines
        starts = starts.map (p) -> [min(p[0] kseg.width(lines[p[1]])) p[1]]

        @setCursors starts main:@s.main
        @stopVisual false false

        @lastChange = { operator: 'visualCase', kind: kind, shapes: shapes }

    toggleCase: count ->

        n       = max 1 (count ? 1)
        lines   = @s.lines.map (l) -> l
        cursors = @allCursors()
        changed = false

        for c in cursors

            line = lines[c[1]].asMutable()
            segi = kseg.indexAtWidth line c[0]

            continue if segi >= line.length

            lasti = min line.length-1 segi+n-1

            for i in segi..lasti

                seg  = line[i]
                upper = seg.toUpperCase()

                line[i] = upper != seg ? upper : seg.toLowerCase()

            lines[c[1]] = line
            c[0]        = kseg.width line[0...min(lasti+1, line.length-1)]
            changed     = true

        ⮐ if not changed

        @begin()

        @setLines lines
        @setCursors cursors main:@s.main

        @end()

        @lastChange = { operator: 'toggleCase', count: n }

    joinLinesVim: count ->

        n       = max 2 (count ? 1)
        lines   = @s.lines.map (l) -> l
        cursors = @allCursors()

        starts = []
        for c in cursors
            starts.push c[1] if c[1] < lines.length-1 and c[1] not in starts

        ⮐ if empty starts

        starts.sort (a b) -> a - b

        blocks = []
        for y in starts
            continue if blocks.length and y < blocks[-1][0] + blocks[-1][1]
            blocks.push [y min(n, lines.length-y) 0]

        for block in blocks

            [y take] = block
            first    = kseg.str(lines[y]).replace(/\s+$/ '')
            parts    = [first]

            for j in 1...take
                text = kseg.str(lines[y+j]).replace(/^\s+/ '').replace(/\s+$/ '')
                parts.push text

            joined = ''
            for part in parts
                continue if empty part
                joined = empty(joined) ? part : joined + ' ' + part

            block[2] = kseg.width first

            lines.splice y take (kseg joined)

        newCursors = []

        for c in cursors

            [x y] = c
            ny    = y
            nx    = x

            for block in blocks

                [by take seam] = block

                if by <= y < by+take
                    ny = by
                    nx = seam
                    break

                if by+take <= y
                    ny -= take-1

            newCursors.push [nx ny]

        @begin()

        @setLines lines
        @setCursors newCursors main:@s.main

        @end()

        @lastChange = { operator: 'joinLinesVim', count: n }

    moveByMotion: spec count=1->
    
        n = spec.count ? count

        if spec.kind == 'charFind'
            @moveByCharFind spec n
        else if spec.kind == 'lineFirst'
            @moveCursors 'down', { count: n-1 } if n > 1
            @moveCursors 'ind'
        else
            for i in 1..n
                @moveCursors spec.kind
                
        @updateVisual() if @visual

    moveByCharFind: spec n ->

        lines   = @s.lines
        cursors = @allCursors()
        forward = spec.forward != false

        for cursor, idx in cursors

            pos = motion.charFindPosition lines cursor spec.target n spec.till forward

            if pos and spec.repeat and spec.till and pos[0] == cursor[0] and pos[1] == cursor[1]
                pos = motion.charFindPosition lines cursor spec.target n+1 spec.till forward

            if pos
                cursors[idx] = pos

        @setCursors cursors main:@s.main

        @highlightCharFind spec

    highlightCharFind: spec ->

        spans   = []
        forward = spec.forward != false

        for p in motion.charFindLandings @s.lines spec.target spec.till forward

            width = kseg.width @s.lines[p[1]]

            if p[0] < width
                spans.push [p[0] p[1] p[0]+1 p[1]]

        @setHighlights spans

    clampCursorsToLines: ->

        cursors = @allCursors()
        changed = false

        for c in cursors

            width = kseg.width @s.lines[c[1]]
            x     = clamp 0 width c[0]

            if x != c[0]
                c[0]    = x
                changed = true

        if changed
            @setCursors cursors main:@s.main

    undoCommand: count ->

        n = max 1 (count ? 1)

        for i in 0...n
            @undo()

    collectSubstitutions: y1 y2 spec ->

        entries = []

        for y in y1..y2

            continue if y < 0 or y >= @s.lines.length

            line = kseg.str @s.lines[y]
            res  = belt.substituteLine line spec

            continue if empty res.matches

            entries.push { y:y line:line matches:res.matches }

        entries

    selectSubstitutions: entries ->

        rngs    = []
        cursors = []

        for entry in entries
            for m in entry.matches
                rngs.push    [m.x1 entry.y m.x2 entry.y]
                cursors.push [m.x2 entry.y]

        ⮐ false if empty rngs

        @setSelections rngs
        @setCursors cursors main:0

        true

    applySubstitutions: entries spec ->

        lines = @s.lines.map (l) -> kseg.str l
        total = 0
        last  = null

        for entry in entries

            lines[entry.y] = belt.joinSubstitution entry.line entry.matches spec.tokens

            for m in entry.matches
                total += 1
                last = [m.x1 entry.y]

        ⮐ 0 if not total

        @begin()
        @setLines lines
        @setCursors [last]
        @end()

        total

    applySubstitutionAt: y match spec ->

        ⮐ false if y < 0 or y >= @s.lines.length

        lines = @s.lines.map (l) -> kseg.str l
        lines[y] = belt.joinSubstitution lines[y] [match] spec.tokens

        @setLines lines

        true

