# ███   ███   ███████   ███   ███  ███  ██     ██  
# ████  ███  ███   ███  ███   ███  ███  ███   ███  
# ███ █ ███  ███   ███   ███ ███   ███  █████████  
# ███  ████  ███   ███     ███     ███  ███ █ ███  
# ███   ███   ███████       █      ███  ███   ███  

use ../../../kxk ▪ kseg clip post
use ../mode      ◆ novim
use ../tool      ◆ belt motion
use ../../util   ◆ config

export

    executeNovim: cmd ->

        # log 'novim command ▸' cmd

        if cmd.motion
            cmd.motion.count ?= cmd.count

        if @visual and cmd.operator not in ['move' 'matchBracket' 'visualDelete' 'visualYank' 'visualChange' 'visualSwap' 'visualTextObject' 'visualIndent' 'visualDeindent' 'visualBlockPrepend' 'visualBlockAppend']
            @stopVisual()

        switch cmd.operator
            'change'                ➜ @changeByMotion       cmd.motion  cmd.register
            'delete'                ➜ @applyChange          cmd
            'yank'                  ➜ @yankByMotion         cmd.motion  cmd.register
            'put'                   ➜ @putRegister          cmd.count   cmd.after cmd.register
            'move'                  ➜ @moveByMotion         cmd.motion  cmd.count
            'searchNext'            ➜ @jumpByHighlight      cmd.count   cmd.text true
            'searchPrev'            ➜ @jumpByHighlight      cmd.count   cmd.text false
            'searchWord'            ➜ @searchWord           cmd.count   cmd.forward
            'matchBracket'          ➜ @matchBracket()
            'openLine'              ➜ @openLine             cmd.count   cmd.after
            'insertAtIndent'        ➜ @insertAtIndent()
            'replace'               ➜ @replaceChars         cmd.char    cmd.count
            'toggleCase'            ➜ @toggleCase           cmd.count
            'joinLinesVim'          ➜ @joinLinesVim         cmd.count
            'visualDelete'          ➜ @visualDelete         cmd.register
            'visualYank'            ➜ @visualYank           cmd.register
            'visualChange'          ➜ @visualChange()
            'visualSwap'            ➜ @visualSwap()
            'visualTextObject'      ➜ @visualTextObject     cmd.motion
            'indent'                ➜ @indentByMotion       cmd.motion  false
            'deindent'              ➜ @indentByMotion       cmd.motion  true
            'visualIndent'          ➜ @indentVisual         cmd.count   false
            'visualDeindent'        ➜ @indentVisual         cmd.count   true
            'visualBlockPrepend'    ➜ @visualBlockInsert    false
            'visualBlockAppend'     ➜ @visualBlockInsert    true
            'undo'                  ➜ @undoCommand          cmd.count
            'repeat'                ➜ @repeatChange         cmd.count
                                    ➜ log 'novim unknown operator ▸' cmd.operator

    jumpByHighlight: count text forward ->

        if empty @s.highlights
            if valid text
                @highlightText text
            else
                ⮐ 

        pos = @mainCursor()

        for i in 0...count

            target = null

            for span in @s.highlights

                sameStart = span[1] == pos[1] and span[0] == pos[0]
                if sameStart ➜ continue # the cursor is already on this highlight

                after  = span[1]  > pos[1] or (span[1] == pos[1] and span[0] > pos[0])
                before = span[1]  < pos[1] or (span[1] == pos[1] and span[0] < pos[0])

                if  forward and after
                    target = span
                    break
                if not forward and before
                    target = span

            if not target
                break

            pos = [target[0] target[1]]

        @setMainCursor pos

    wordSpansForText: text ->

        spans = []

        for span in belt.lineSpansForText(@s.lines, text)

            [x1 y x2] = span
            line      = kseg.str @s.lines[y]
            before    = x1 > 0 ? line[x1-1] : ''
            after     = x2 < line.length ? line[x2] : ''

            continue if /\w/.test(text[0]) and /\w/.test(before)
            continue if /\w/.test(text[text.length-1]) and /\w/.test(after)

            spans.push span

        spans

    searchWord: count forward ->

        text = @wordAtCursor()

        ⮐  if empty text

        novim.lastVind = text

        spans = @wordSpansForText text

        @setHighlights spans

        rng = belt.rangeOfClosestWordToPos @s.lines @mainCursor()

        ⮐  if not rng

        start = [rng[0] rng[1]]
        end   = [rng[2] rng[3]]
        pos   = @mainCursor()
        moved = false

        for i in 0...max(1, count ? 1)

            target = null

            for span in spans

                after  = span[1] > end[1] or (span[1] == end[1] and span[0] > end[0])
                before = span[1] < start[1] or (span[1] == start[1] and span[0] < start[0])

                if forward and after
                    target = span
                    break
                if not forward and before
                    target = span

            break if not target

            start = [target[0] target[1]]
            end   = [target[0]+text.length target[1]]
            pos   = [target[0] target[1]]
            moved = true

        @setMainCursor pos[0] pos[1] if moved

    matchBracket: ->

        lines      = @s.lines
        cursors    = @allCursors()
        newCursors = []
        moved      = false

        for c in cursors

            line = lines[c[1]]
            segi = kseg.indexAtWidth line c[0]
            found = null

            while segi < line.length

                ch = line[segi]

                if ch in ['(' ')' '[' ']' '{' '}']
                    found = [kseg.widthAtSegi(line, segi), c[1], ch]
                    break

                segi += 1

            if not found
                newCursors.push c
                continue

            ch = found[2]
            open = switch ch
                '(' '[' '{' ➜ ch
                ')' ➜ '('
                ']' ➜ '['
                '}' ➜ '{'

            spans = motion.pairSpansForPosition lines found[0] found[1] open

            if not spans
                newCursors.push c
                continue

            target = open == ch ? [spans[1][0] spans[1][1]] : [spans[0][0] spans[0][1]]

            newCursors.push target
            moved = true

        if moved
            @setCursors newCursors main:@s.main
            
        @updateVisual() if @visual

    startVisual: kind ->

        if @visual == kind
            ⮐  @stopVisual()

        if not @visual
            @visualAnchors = @allCursors().map (c) -> [c[0] c[1]]

        @visual = kind

        @updateVisual()

    stopVisual: keepSelections=false ->

        @visual        = null
        @visualAnchors = []

        if not keepSelections
            @setSelections []

    visualPairs: ->

        cursors = @allCursors()
        anchors = @visualAnchors
        pairs   = []

        for cursor, i in cursors

            anchor = anchors[i] ? [cursor[0] cursor[1]]

            pairs.push [[anchor[0] anchor[1]] [cursor[0] cursor[1]]]

        pairs.sort (a b) ->
            if a[1][1] == b[1][1]
                a[1][0] - b[1][0]
            else
                a[1][1] - b[1][1]

        unique = []

        for pair in pairs
            continue if unique.length and belt.samePos unique[-1][1] pair[1]
            unique.push pair

        unique

    visualRangeForPair: anchor cursor ->

        if @visual == 'line'

            y1 = min anchor[1] cursor[1]
            y2 = max anchor[1] cursor[1]

            ⮐  [0 y1 kseg.width(@s.lines[y2]) y2]

        a = [anchor[0] anchor[1]]
        b = [cursor[0] cursor[1]]

        if b[1] < a[1] or b[1] == a[1] and b[0] < a[0]
            [a b] = [b a]

        [a[0] a[1] b[0] b[1]]

    visualBlockRanges: anchor cursor ->

        y1 = min anchor[1] cursor[1]
        y2 = max anchor[1] cursor[1]
        x1 = min anchor[0] cursor[0]
        x2 = max anchor[0] cursor[0]

        ⮐ [] if x1 == x2
        
        @blockRangesForRect @s.lines x1 y1 x2 y2
        
    blockRangesForShape: shape cursor ->

        ⮐ [] if empty @s.lines

        y1 = min cursor[1] @s.lines.length-1
        y2 = min cursor[1]+shape.y2 @s.lines.length-1
        x1 = cursor[0]
        x2 = x1+shape.x2
        
        @blockRangesForRect @s.lines x1 y1 x2 y2

    blockRangesForRect: lines x1 y1 x2 y2 ->
    
        rngs = []
        for y in y1..y2
        
            continue if y >= lines.length

            width = kseg.width lines[y]

            continue if x1 >= width
                       
            xe = min x2 width

            continue if xe <= x1

            rngs.push [x1 y xe y]

        rngs

    updateVisual: ->

        ⮐  if not @visual

        pairs   = @visualPairs()
        cursors = pairs.map (p) -> [p[1][0] p[1][1]]
        anchors = pairs.map (p) -> [p[0][0] p[0][1]]

        @visualAnchors = anchors

        same = cursors.length == @s.cursors.length

        if same
            for cursor, i in cursors
                same = false if not belt.samePos cursor @s.cursors[i]

        if not same
            @setCursors cursors main:@mainCursor()

        rngs = []
        for pair in pairs
            if @visual == 'block'
                rngs = rngs.concat @visualBlockRanges(pair[0] pair[1])
            else
                rngs.push @visualRangeForPair(pair[0] pair[1])

        @setSelections rngs

    visualDelete: register ->

        rngs = @s.selections.asMutable()

        ⮐  if empty rngs

        linewise = @visual == 'line'

        blockStarts = null

        if @visual == 'block'
            blockStarts = @visualPairs().map (p) -> [min(p[0][0] p[1][0]) min(p[0][1] p[1][1])]

        @setNovimRegister rngs linewise register

        @lastChange = { operator: 'visualDelete', linewise: linewise, register: register, shapes: @visualRepeatShapes() }

        @begin()

        @deleteRanges rngs @allCursors() linewise

        @end()

        @setCursors(blockStarts main:@s.main) if blockStarts

        @stopVisual()

    visualYank: register ->

        rngs = @s.selections.asMutable()

        ⮐  if empty rngs

        linewise = @visual == 'line'

        @setNovimRegister rngs linewise register
        @flashYank rngs

        if @visual == 'block'
            pairs  = @visualPairs()
            starts = pairs.map (p) -> [min(p[0][0] p[1][0]) min(p[0][1] p[1][1])]
        else
            starts = rngs.map (r) -> [r[0] r[1]]

        @setCursors starts main:@mainCursor()

        @stopVisual()

    visualChange: ->

        rngs = @s.selections.asMutable()

        ⮐  if empty rngs

        @startNovimInsert { kind: 'visual', linewise: @visual == 'line', shapes: @visualRepeatShapes() }

        @setCursors belt.endPositionsOfRanges(rngs) main:@mainCursor()

        @visual        = null
        @visualAnchors = []

        @stopMode 'novim'

    visualBlockInsert: after ->

        rngs = @s.selections

        ⮐  if empty rngs

        cursors = rngs.map (r) -> [after ? r[2] : r[0] r[1]]

        @startNovimInsert { kind: after ? 'blockAppend' : 'blockPrepend', shapes: @visualRepeatShapes() }

        @stopVisual()

        @setCursors cursors main:@s.main

        @stopMode 'novim'

    visualRepeatShapes: ->

        shapes = []

        if @visual == 'line'

            y1 = Infinity
            y2 = -1

            for rng in @s.selections
                y1 = min y1 rng[1]
                y2 = max y2 rng[3]

            shapes.push { linewise: true, count: y2-y1+1 }

        else if @visual == 'block'

            if not empty @s.selections

                x1 = Infinity
                x2 = -1
                y1 = Infinity
                y2 = -1

                for rng in @s.selections
                    x1 = min x1 rng[0]
                    x2 = max x2 rng[2]
                    y1 = min y1 rng[1]
                    y2 = max y2 rng[3]

                shapes.push { block: true, x1: 0, y1: 0, x2: x2-x1, y2: y2-y1 }

        else

            for rng in @s.selections
                shapes.push { linewise: false, x1: 0, y1: 0, x2: rng[2]-rng[0], y2: rng[3]-rng[1] }

        shapes

    visualSwap: ->

        ⮐  if not @visual

        cursors = @allCursors()
        anchors = @visualAnchors

        for cursor, i in cursors

            continue if not anchors[i]

            anchor     = anchors[i]
            anchors[i] = [cursor[0] cursor[1]]
            cursors[i] = [anchor[0] anchor[1]]

        @visualAnchors = anchors

        @setCursors cursors main:@mainCursor()

        @updateVisual()

    visualTextObject: spec ->

        ⮐  if not @visual

        rngs = []

        for cursor in @allCursors()

            rng = motion.range @s.lines cursor spec

            continue if not rng
            continue if belt.isEmptyRange rng

            rngs.push rng

        ⮐  if empty rngs

        @visualAnchors = rngs.map (r) -> [r[0] r[1]]

        cursors = rngs.map (r) -> [max(r[0] r[2]-1) r[3]]

        @setCursors cursors main:@mainCursor()

        @updateVisual()

    indentByMotion: spec deindent=false ->

        indices = []

        for cursor in @allCursors()

            rng = motion.range @s.lines cursor spec

            continue if not rng

            indices = indices.concat belt.lineIndicesForRange(rng)

        ⮐  if empty indices

        @indentAtIndices indices deindent

        @lastChange = { operator: deindent ? 'deindent' : 'indent', motion: copy(spec) }

    indentVisual: count deindent=false ->

        indices = belt.lineIndicesForRanges @s.selections

        ⮐  if empty indices

        indices = Array.from new Set(indices)
        indents = {}

        for index in indices
            indents[index] = belt.numIndent @s.lines[index]

        @indentAtIndices indices deindent (count ? 1)

        anchors = []

        for anchor in @visualAnchors

            oldIndent = indents[anchor[1]]

            if oldIndent?
                shift = belt.numIndent(@s.lines[anchor[1]]) - oldIndent
                anchors.push [max(0 anchor[0]+shift) anchor[1]]
            else
                anchors.push [anchor[0] anchor[1]]

        @visualAnchors = anchors

        @lastChange = { operator: deindent ? 'deindent' : 'indent', motion: { kind: 'line', count: indices.length } }

        @updateVisual()

    indentAtIndices: indices deindent=false times=1 ->

        indices = Array.from new Set(indices)

        indices.sort (a b) -> a - b

        ⮐  if empty indices

        n = max 1 (times ? 1)

        @begin()

        for i in 0...n

            if deindent
                [lines selections cursors] = belt.deindentLineRangesAndPositionsAtIndices @s.lines @s.selections @s.cursors indices
            else
                [lines selections cursors] = belt.indentLineRangesAndPositionsAtIndices @s.lines @s.selections @s.cursors indices

            @setLines lines
            @setSelections selections
            @setCursors cursors main:@mainCursor()

        @end()

    applyChange: cmd ->

        @lastChange = cmd
        @deleteByMotion cmd.motion cmd.register

    startNovimInsert: spec ->

        @novimInsert = copy(spec)

        @novimInsert.text ?= ''

        @novimInsert

    recordNovimInsert: text ->

        ⮐  if not @novimInsert or @novimReplaying

        @novimInsert.text += text

    recordNovimBackspace: ->

        ⮐  if not @novimInsert or @novimReplaying

        text = @novimInsert.text

        @novimInsert.text = text[0...-1] if text.length

    finishNovimInsert: ->

        ⮐  if not @novimInsert

        insert = @novimInsert

        @novimInsert = null

        @lastChange = { operator: 'insert', insert: insert }

    repeatChange: count ->

        ⮐  if not @lastChange

        switch @lastChange.operator
            'replace'     ➜ @replaceChars     @lastChange.char     (count > 1 ? count : @lastChange.count)
            'toggleCase'  ➜ @toggleCase       (count > 1 ? count : @lastChange.count)
            'joinLinesVim'➜ @joinLinesVim     (count > 1 ? count : @lastChange.count)
            'indent'      ➜ @repeatIndent     count false
            'deindent'    ➜ @repeatIndent     count true
            'insert'      ➜ @repeatInsert     count
            'put'         ➜ @repeatPut        count
            'visualDelete'➜ @repeatVisual     count 'delete'
            else
                spec = copy @lastChange.motion

                spec.count = count if count > 1

                @deleteByMotion spec @lastChange.register

    repeatIndent: count deindent ->

        spec = copy (@lastChange.motion ? { kind: 'line', count: 1 })

        spec.count = count if count > 1

        @indentByMotion spec deindent

    repeatPut: count ->

        n = max 1 (count > 1 ? count : @lastChange.count)

        @putRegLines @lastChange.reg n @lastChange.after

    repeatInsert: count ->

        insert = @lastChange.insert

        n = max 1 (count ? 1)

        for i in 0...n
            @replayInsert insert

    replayInsert: insert ->

        switch insert.kind
            'insert'         ➜ @insertForRepeat insert.text
            'append'         ➜ @moveCursors('right'); @insertForRepeat insert.text
            'appendEol'      ➜ @moveCursors('eol');   @insertForRepeat insert.text
            'insertAtIndent' ➜ @moveCursors('ind');   @insertForRepeat insert.text
            'openLineAfter'  ➜ @putOpenLines(insert, true);  @insertForRepeat insert.text
            'openLineBefore' ➜ @putOpenLines(insert, false); @insertForRepeat insert.text
            'blockPrepend'   ➜ @replayBlockInsert insert false
            'blockAppend'    ➜ @replayBlockInsert insert true
            'change'         ➜ @replayChange insert
            'visual'         ➜ @replayVisual insert 'change'
            else             ➜ log 'novim unknown insert ▸' insert.kind

    replayChange: insert ->

        spec = copy insert.motion

        rngs = @selectByMotion spec

        ⮐  if empty rngs

        @setCursors belt.endPositionsOfRanges(rngs) main:@s.main

        @insertForRepeat insert.text

    putOpenLines: insert after ->

        n = max 1 (insert.count ? 1)

        @begin()

        for i in 0...n
            @putLines [''] after

        @end()

    replayBlockInsert: insert after ->

        shape = insert.shapes[0]

        ⮐  if not shape

        rngs = @blockRangesForShape shape @mainCursor()

        ⮐  if empty rngs

        cursors = rngs.map (r) -> [after ? r[2] : r[0] r[1]]

        @setCursors cursors main:@s.main

        @insertForRepeat insert.text

    insertForRepeat: text ->

        @novimReplaying = true

        @insert text

        @novimReplaying = false

    repeatVisual: count action ->

        n = max 1 (count ? 1)

        for i in 0...n
            @replayVisual @lastChange action

    replayVisual: change action ->

        rngs = []

        cursors = @allCursors()

        cursors = [@mainCursor()] if change.shapes.length and change.shapes[0].block

        for cursor, i in cursors

            shape = change.shapes[min(i, change.shapes.length-1)] ? change.shapes[0]

            continue if not shape

            if shape.block
                for rng in @blockRangesForShape(shape, cursor)
                    rngs.push rng
                continue

            rng = @rangeForVisualShape shape cursor

            continue if not rng
            continue if belt.isEmptyRange rng

            rngs.push rng

        ⮐  if empty rngs

        if action == 'delete'

            @setNovimRegister rngs change.linewise change.register

            @begin()

            @deleteRanges rngs @allCursors() change.linewise

            @end()

        else

            @setSelections rngs

            @setCursors belt.endPositionsOfRanges(rngs) main:@s.main

            @insertForRepeat change.text

    rangeForVisualShape: shape cursor ->

        lines = @s.lines

        ⮐  if empty lines

        if shape.linewise

            y1 = min cursor[1] lines.length-1
            y2 = min cursor[1]+shape.count-1 lines.length-1

            ⮐  [0 y1 kseg.width(lines[y2]) y2]

        y1 = min cursor[1] lines.length-1
        y2 = min cursor[1]+shape.y2 lines.length-1

        x1 = min cursor[0] kseg.width(lines[y1])
        x2 = min cursor[0]+shape.x2 kseg.width(lines[y2])

        [x1 y1 x2 y2]

    usesClipboard: register ->

        ⮐ true  if register == 'clipboard'
        ⮐ false if register

        novim.clipboardEnabled()

    copyRegisterToClipboard: reg ->

        text = reg.lines.join '\n'
        text += '\n' if reg.linewise

        if clip.detect() == 'none'
            clip.text = text
        else
            clip.copy text

    registerFromClipboard: ->

        text = clip.detect() == 'none' ? clip.text : clip.paste()

        ⮐  null if empty text

        linewise = text.endsWith '\n'
        lines    = text.split '\n'

        lines.pop() if linewise

        { lines: lines, linewise: linewise }

    selectByMotion: spec ->

        lines = @s.lines
        rngs  = []

        for cursor in @allCursors()

            rng = motion.range lines cursor spec
            continue if not rng

            continue if belt.isEmptyRange(rng) and not motion.isLinewise(spec)

            rngs.push rng

        ⮐  if empty rngs

        rngs = motion.mergeRanges rngs

        @setSelections rngs

        rngs

    setNovimRegister: rngs linewise register ->

        texts = []

        for rng in rngs
            texts.push belt.textForLineRange(@s.lines, rng)

        @novimRegister = { lines: texts.join('\n').split('\n'), linewise: linewise }

        @copyRegisterToClipboard @novimRegister if @usesClipboard(register)

    deleteByMotion: spec register ->

        rngs = @selectByMotion spec

        ⮐  if empty rngs

        linewise = motion.isLinewise spec

        @setNovimRegister rngs linewise register

        @begin()

        @deleteRanges rngs @allCursors() linewise

        @end()

    changeByMotion: spec register ->

        rngs = @selectByMotion spec

        ⮐  if empty rngs

        @setCursors belt.endPositionsOfRanges(rngs)

        @startNovimInsert { kind: 'change', motion: copy(spec) }

        @stopMode 'novim'

    yankByMotion: spec register ->

        linewise = motion.isLinewise spec
        cursors  = @allCursors()
        rngs = []
        for cursor,idx in cursors

            rng = motion.range @s.lines cursor spec
            continue if not rng
            continue if belt.isEmptyRange(rng) and not linewise
            rngs.push rng
            cursors[idx] = [rng[0] rng[1]] if not linewise

        ⮐ if empty rngs
        
        @setNovimRegister rngs linewise register
        @flashYank rngs

        if not linewise
            @setCursors cursors main:@s.main
            @clampCursorsToLines()

    flashYank: rngs ->

        ⮐  if empty rngs

        clearTimeout @yankFlashTimer if @yankFlashTimer

        flashMs = config.data?.novim?.yankFlashMs ? 500
        @yankFlash      = rngs
        @yankFlashTimer = setTimeout (=> @clearYankFlash()) flashMs

    clearYankFlash: ->

        clearTimeout @yankFlashTimer if @yankFlashTimer

        @yankFlashTimer = null

        ⮐  if not @yankFlash

        @yankFlash = null

        post.emit 'redraw'

    putRegister: count after register ->

        reg = @novimRegister

        reg = @registerFromClipboard() if @usesClipboard(register)

        ⮐  if not reg or empty reg.lines

        n = max 1 (count ? 1)

        @putRegLines reg n after

        @lastChange = { operator: 'put', after: after, count: n, register: register, reg: { lines: copy(reg.lines), linewise: reg.linewise } }

    putRegLines: reg count after ->

        @begin()

        for i in 0...count
            if reg.linewise
                @putLines reg.lines after
            else
                @putText reg.lines.join('\n') after

        @end()

    putLines: insertLines after ->

        segls   = kseg.segls insertLines
        lines   = @s.lines.map (l) -> l
        cursors = @allCursors()
        order   = []

        for c, idx in cursors
            order.push idx

        order.sort (a b) ->
            if cursors[a][1] == cursors[b][1]
                cursors[a][0] - cursors[b][0]
            else
                cursors[a][1] - cursors[b][1]

        newCursors = []
        offset     = 0

        for idx in order

            y  = cursors[idx][1] + offset
            at = after ? y+1 : y

            lines = lines[0...at].concat(segls).concat(lines[at..])

            first = segls[0]
            x     = min belt.numIndent(first) max(0 kseg.width(first)-1)

            newCursors.push [x at]
            offset += segls.length

        @setLines lines
        @setCursors newCursors

    putText: text after ->

        lines   = @s.lines
        cursors = @allCursors()
        posl    = []

        for c in cursors
            width = kseg.width lines[c[1]]
            x     = min(c[0] width)
            x     = max(0 x-1) if not after
            posl.push [x c[1]]

        [newLines newPosl] = belt.insertTextAtPositions lines text posl

        @setLines newLines
        @setCursors newPosl

    openLine: count after ->

        @putOpenLines { count:count } after

        @startNovimInsert { kind: after ? 'openLineAfter' : 'openLineBefore', count:count }

        @stopMode 'novim'

    insertAtIndent: ->

        @moveCursors 'ind'

        @startNovimInsert { kind: 'insertAtIndent' }

        @stopMode 'novim'

    replaceChars: text count ->

        n       = max 1 (count ? 1)
        lines   = @s.lines.map (l) -> l
        cursors = @allCursors()
        changed = false

        for c in cursors

            line = lines[c[1]].asMutable()
            segi = kseg.indexAtWidth line c[0]

            continue if segi+n > line.length

            repl = []
            for i in 0...n
                repl.push text

            newLine = line[0...segi].concat(repl).concat(line[segi+n..])

            lines[c[1]] = newLine
            c[0]        = kseg.width newLine[0...segi+n]
            changed     = true

        ⮐  if not changed

        @begin()

        @setLines lines
        @setCursors cursors main:@s.main

        @end()

        @lastChange = { operator: 'replace', char: text, count: n }

    toggleCase: count ->

        n       = max 1 (count ? 1)
        lines   = @s.lines.map (l) -> l
        cursors = @allCursors()
        changed = false

        for c in cursors

            line = lines[c[1]].asMutable()
            segi = kseg.indexAtWidth line c[0]

            continue if segi >= line.length

            lasti = min line.length-1 segi+n-1

            for i in segi..lasti

                seg  = line[i]
                upper = seg.toUpperCase()

                line[i] = upper != seg ? upper : seg.toLowerCase()

            lines[c[1]] = line
            c[0]        = kseg.width line[0...min(lasti+1, line.length-1)]
            changed     = true

        ⮐  if not changed

        @begin()

        @setLines lines
        @setCursors cursors main:@s.main

        @end()

        @lastChange = { operator: 'toggleCase', count: n }

    joinLinesVim: count ->

        n       = max 2 (count ? 1)
        lines   = @s.lines.map (l) -> l
        cursors = @allCursors()

        starts = []
        for c in cursors
            starts.push c[1] if c[1] < lines.length-1 and c[1] not in starts

        ⮐  if empty starts

        starts.sort (a b) -> a - b

        blocks = []
        for y in starts
            continue if blocks.length and y < blocks[-1][0] + blocks[-1][1]
            blocks.push [y min(n, lines.length-y) 0]

        for block in blocks

            [y take] = block
            first    = kseg.str(lines[y]).replace(/\s+$/ '')
            parts    = [first]

            for j in 1...take
                text = kseg.str(lines[y+j]).replace(/^\s+/ '').replace(/\s+$/ '')
                parts.push text

            joined = ''
            for part in parts
                continue if empty part
                joined = empty(joined) ? part : joined + ' ' + part

            block[2] = kseg.width first

            lines.splice y take (kseg joined)

        newCursors = []

        for c in cursors

            [x y] = c
            ny    = y
            nx    = x

            for block in blocks

                [by take seam] = block

                if by <= y < by+take
                    ny = by
                    nx = seam
                    break

                if by+take <= y
                    ny -= take-1

            newCursors.push [nx ny]

        @begin()

        @setLines lines
        @setCursors newCursors main:@s.main

        @end()

        @lastChange = { operator: 'joinLinesVim', count: n }

    moveByMotion: spec count=1->
    
        n = spec.count ? count

        if spec.kind == 'charFind'
            @moveByCharFind spec n
        else if spec.kind == 'lineFirst'
            @moveCursors 'down', { count: n-1 } if n > 1
            @moveCursors 'ind'
        else
            for i in 1..n
                @moveCursors spec.kind
                
        @updateVisual() if @visual

    moveByCharFind: spec n ->

        lines   = @s.lines
        cursors = @allCursors()
        forward = spec.forward != false

        for cursor, idx in cursors

            pos = motion.charFindPosition lines cursor spec.target n spec.till forward

            if pos and spec.repeat and spec.till and pos[0] == cursor[0] and pos[1] == cursor[1]
                pos = motion.charFindPosition lines cursor spec.target n+1 spec.till forward

            if pos
                cursors[idx] = pos

        @setCursors cursors main:@s.main

        @highlightCharFind spec

    highlightCharFind: spec ->

        spans   = []
        forward = spec.forward != false

        for p in motion.charFindLandings @s.lines spec.target spec.till forward

            width = kseg.width @s.lines[p[1]]

            if p[0] < width
                spans.push [p[0] p[1] p[0]+1 p[1]]

        @setHighlights spans

    clampCursorsToLines: ->

        cursors = @allCursors()
        changed = false

        for c in cursors

            width = kseg.width @s.lines[c[1]]
            x     = clamp 0 width c[0]

            if x != c[0]
                c[0]    = x
                changed = true

        if changed
            @setCursors cursors main:@s.main

    undoCommand: count ->

        n = max 1 (count ? 1)

        for i in 0...n
            @undo()
