###
    novim commands

    a novim command is a plain value

        { operator: 'delete', motion: { kind: 'word', count: 3 } }
        { operator: 'yank',   motion: { kind: 'line', count: 1 } }
        { operator: 'put',    count: 2, after: true }
        { operator: 'move',   motion: { kind: 'left', count: 2 } }
        { operator: 'undo',   count: 3 }
        { operator: 'repeat', count: 2 }

    the mode decodes keys into such a value
    this module turns the value into buffer edits

    the last change is remembered so that . can repeat it
###

use ../../../kxk ▪ kseg
use ../../../kxk ◆ clip
use ../mode    ◆ novim
use ../tool    ◆ belt motion

export

    executeNovim: cmd ->

        log 'novim command ▸' cmd

        switch cmd.operator
            'delete' ➜ @applyChange cmd
            'yank'   ➜ @yankByMotion cmd.motion cmd.register
            'put'    ➜ @putRegister cmd.count cmd.after cmd.register
            'move'   ➜ @moveByMotion cmd.motion
            'undo'   ➜ @undoCommand cmd.count
            'repeat' ➜ @repeatChange cmd.count
            else     ➜ log 'novim unknown operator ▸' cmd.operator

    applyChange: cmd ->

        @lastChange = cmd
        @deleteByMotion cmd.motion cmd.register

    repeatChange: count ->

        ⮐  if not @lastChange

        spec = copy @lastChange.motion

        # a count on . replaces the count of the change,
        # one means the count of the change is used again
        spec.count = count if count > 1

        @deleteByMotion spec @lastChange.register

    # an explicit register is the clipboard one, a plain operator uses
    # the clipboard only when the clipboard sync is on
    usesClipboard: register ->

        ⮐ true  if register == 'clipboard'
        ⮐ false if register

        novim.clipboardEnabled()

    copyRegisterToClipboard: reg ->

        text = reg.lines.join '\n'
        text += '\n' if reg.linewise

        # no tool means no system clipboard: keep the text in the
        # fallback buffer without logging a tool error on every yank
        if clip.detect() == 'none'
            clip.text = text
        else
            clip.copy text

    registerFromClipboard: ->

        text = clip.detect() == 'none' ? clip.text : clip.paste()

        ⮐  null if empty text

        # a trailing newline marks linewise text, the clipboard is plain text
        # and cannot carry the register type any other way
        linewise = text.endsWith '\n'
        lines    = text.split '\n'

        lines.pop() if linewise

        { lines: lines, linewise: linewise }

    deleteByMotion: spec register ->

        lines = @s.lines
        rngs  = []

        for cursor in @allCursors()

            rng = motion.range lines cursor spec
            continue if not rng

            # a linewise motion on an empty line is an empty range,
            # but there is still a line to remove
            continue if belt.isEmptyRange(rng) and not motion.isLinewise(spec)

            rngs.push rng

        log 'novim ranges ▸' rngs

        ⮐  if empty rngs

        # cursors can share a line, so ranges can overlap
        rngs = motion.mergeRanges rngs

        linewise = motion.isLinewise spec
        texts    = []

        for rng in rngs
            texts.push belt.textForLineRange(lines, rng)

        @novimRegister = { lines: texts.join('\n').split('\n'), linewise: linewise }

        @copyRegisterToClipboard @novimRegister if @usesClipboard(register)

        @begin()

        @deleteRanges rngs @allCursors() linewise

        @end()

    # the last yanked text is kept here so that p and P can put it.
    # linewise text is a list of lines, charwise text is joined by newlines
    yankByMotion: spec register ->

        lines    = @s.lines
        linewise = motion.isLinewise spec
        cursors  = @allCursors()
        texts    = []

        for cursor, idx in cursors

            rng = motion.range lines cursor spec
            continue if not rng
            continue if belt.isEmptyRange(rng) and not linewise

            texts.push belt.textForLineRange(lines, rng)
            cursors[idx] = [rng[0] rng[1]] if not linewise

        ⮐  if empty texts

        @novimRegister = { lines: texts.join('\n').split('\n'), linewise: linewise }

        @copyRegisterToClipboard @novimRegister if @usesClipboard(register)

        if not linewise
            @setCursors cursors main:@s.main
            @clampCursorsToLines()

    putRegister: count after register ->

        reg = @novimRegister

        reg = @registerFromClipboard() if @usesClipboard(register)

        ⮐  if not reg or empty reg.lines

        n = max 1 (count ? 1)

        @begin()

        for i in 0...n
            if reg.linewise
                @putLines reg.lines after
            else
                @putText reg.lines.join('\n') after

        @end()

    putLines: insertLines after ->

        segls   = kseg.segls insertLines
        lines   = @s.lines.map (l) -> l
        cursors = @allCursors()
        order   = []

        for c, idx in cursors
            order.push idx

        # insert from the top, so the offset stays simple
        order.sort (a b) ->
            if cursors[a][1] == cursors[b][1]
                cursors[a][0] - cursors[b][0]
            else
                cursors[a][1] - cursors[b][1]

        newCursors = []
        offset     = 0

        for idx in order

            y  = cursors[idx][1] + offset
            at = after ? y+1 : y

            lines = lines[0...at].concat(segls).concat(lines[at..])

            # as in vim the cursor lands on the first non-blank
            first = segls[0]
            x     = min belt.numIndent(first) max(0 kseg.width(first)-1)

            newCursors.push [x at]
            offset += segls.length

        @setLines lines
        @setCursors newCursors

    putText: text after ->

        lines   = @s.lines
        cursors = @allCursors()
        posl    = []

        for c in cursors
            width = kseg.width lines[c[1]]
            x     = after ? min(c[0]+1 width) : min(c[0] width)
            posl.push [x c[1]]

        [newLines newPosl] = belt.insertTextAtPositions lines text posl

        # the insert helper returns the end of the inserted text
        # the cursor goes behind the pasted text, not onto its last character
        @setLines newLines
        @setCursors newPosl

    moveByMotion: spec ->

        n = max 1 (spec.count ? 1)

        # a horizontal move never wraps to the next line,
        # so a count is a number of single steps
        if spec.kind in ['left' 'right']
            for i in 0...n
                @moveCursors spec.kind
        else if spec.kind == 'eol'

            # as in vim a count on $ goes down count-1 lines first
            if n > 1
                @moveCursors 'down' count:n-1

            @moveCursors 'eol'
        else if spec.kind in ['word' 'wordBack' 'wordEnd']
            @moveByWordMotion spec.kind n
        else if spec.kind in ['bof' 'eof']
            @moveCursorsToLine spec.kind n
        else
            @moveCursors spec.kind count:n

        @clampCursorsToLines()

    # standalone word movement, unlike an operator it may cross lines
    # and does not stop at the end of the current line
    moveByWordMotion: kind count ->

        n       = max 1 (count ? 1)
        lines   = @s.lines
        cursors = @allCursors()

        for cursor, idx in cursors

            pos = [cursor[0] cursor[1]]

            for i in 0...n

                if kind == 'word'
                    pos = motion.wordStartAfter lines pos
                else if kind == 'wordBack'
                    pos = motion.wordStartBefore lines pos
                else
                    pos = motion.wordEndAfter lines pos

            if kind == 'word'

                # with no next word the scan ends behind the last character,
                # the cursor goes back onto it, as at the end of a buffer
                width = kseg.width lines[pos[1]]

                if width > 0 and pos[0] >= width
                    pos[0] = width-1

            else if kind == 'wordEnd'

                # wordEndAfter returns the position after the last character,
                # e lands on the character itself
                pos = @widthBefore lines pos

            cursors[idx] = pos

        @setCursors cursors main:@s.main

    widthBefore: lines pos ->

        segs = lines[pos[1]]
        i    = kseg.indexAtWidth segs pos[0]

        i = max 0 i-1

        [kseg.widthAtSegi(segs, i) pos[1]]

    # bof and eof take a count as the line number to go to,
    # a count of one means the first or the last line
    moveCursorsToLine: kind n ->

        lines  = @s.lines
        target = n > 1 ? n-1 : 0
        target = lines.length-1 if kind == 'eof' and n <= 1
        target = clamp 0 lines.length-1 target

        width = kseg.width lines[target]

        cursors = @allCursors()

        for c in cursors
            c[1] = target
            c[0] = min belt.numIndent(lines[target]) max(0 width-1)

        @setCursors cursors main:@s.main

    clampCursorsToLines: ->

        cursors = @allCursors()
        changed = false

        for c in cursors

            width = kseg.width @s.lines[c[1]]
            x     = clamp 0 width c[0]

            if x != c[0]
                c[0]    = x
                changed = true

        if changed
            @setCursors cursors main:@s.main

    undoCommand: count ->

        n = max 1 (count ? 1)

        for i in 0...n
            @undo()
