
use ../../../kxk ▪ kstr post
use ../../util   ◆ prof
use ../../popo   ◆ layout
use ../tool      ◆ belt sue
use ..           ◆ mode
#!insert
export
    insert: text ->

        text = mode.insert @ text

        ⮐ if @rectree? and @insertIntoSheet text

        if valid @s.selections
            ⮐ @indentSelectedLines() if text == '\t'
            @deleteSelection()
            
        [lines cursors] = belt.insertTextAtPositions @s.lines text @s.cursors

        @recordNovimInsert text

        @clearHighlights()
        @setLines   lines
        @setCursors cursors
        
        mode.postInsert @

    insertIntoSheet: text ->

        cells   = {cols:(@rectreeCols ? @cells.cols) rows:(@rectreeRows ? @cells.rows)}
        rectree = @rectree
        pos     = @mainCursor()
        advance = layout.insertTextAt cells rectree pos text

        ⮐ 0 if not advance

        @renderSheet rectree cells [pos[0]+advance pos[1]]

        advance

    renderSheet: (rectree cells pos opt) ->

        # render a sheet rectree into the editor

        opt ?= {}

        post.emit 'sheet.edited'

        data = sue.desue layout.sueify({cols:cells.cols rows:cells.rows} rectree)

        @loadLines data.text.split('\n')
        @loadSue   data.sue

        if pos?
            if opt.silent
                @setCursors [pos] silent:true
            else
                @setCursors [pos]

        @rectreeCols = cells.cols
        @rectreeRows = cells.rows

    moveSheetNode: (dir) ->

        ⮐ null if not @rectree?

        cells = {cols:@cells.cols rows:@cells.rows}

        layout.absolutize cells @rectree

        cursor = @mainCursor()
        node   = layout.topmostIn @rectree cursor

        ⮐ null if not node?

        oldRect = clone node.rect.abs
        moved   = layout.moveNodeAt cells @rectree cursor dir

        ⮐ null if not moved?

        rect = moved.rect.abs

        maxX = max rect.x (rect.x + rect.w - 1)
        maxY = max rect.y (rect.y + rect.h - 1)

        x = clamp rect.x maxX (rect.x + cursor[0] - oldRect.x)
        y = clamp rect.y maxY (rect.y + cursor[1] - oldRect.y)

        @renderSheet @rectree cells [x y] silent:true

        moved

    insertAsciiHeaderForSelectionOrWordAtCursor: ->

        [lines cursors selections] = belt.insertAsciiHeaderForPositionsAndRanges @s.lines @s.cursors @s.selections
        
        @clearHighlights()
        @setLines      lines
        @setSelections selections
        @setCursors    cursors
        
    surroundSelection: trigger pair ->
        
        [lines posl] = belt.insertSurroundAtRanges @s.lines @s.selections trigger pair

        @setLines      lines
        @setSelections []
        @setCursors    posl
        