
use ../../../kxk ▪ kstr kseg post
use ../../util   ◆ prof
use ../../popo   ◆ layout
use ../tool      ◆ belt sue
use ..           ◆ mode
#!insert
export
    insert: text ->

        text = mode.insert @ text

        ⮐ if @rectree? and @insertIntoSheet text

        if valid @s.selections
            ⮐ @indentSelectedLines() if text == '\t'
            @deleteSelection()
            
        [lines cursors] = belt.insertTextAtPositions @s.lines text @s.cursors

        @recordNovimInsert text

        @clearHighlights()
        @setLines   lines
        @setCursors cursors
        
        mode.postInsert @

    insertIntoSheet: text ->

        cells   = {cols:(@rectreeCols ? @cells.cols) rows:(@rectreeRows ? @cells.rows)}
        rectree = @rectree
        pos     = @mainCursor()
        advance = layout.insertTextAt cells rectree pos text

        ⮐ 0 if not advance

        @renderSheet rectree cells [pos[0]+advance pos[1]]

        advance

    setSheetTree: (rectree cols rows) ->

        @rectree = rectree
        @rectreeCols = cols
        @rectreeRows = rows

        @s = @s.set 'rectree' layout.plainNode(rectree)
        @

    clearSheet: ->

        delete @rectree
        delete @rectreeCols
        delete @rectreeRows

        @s = @s.set 'rectree' null
        @

    restoreSheet: ->

        if @s.rectree?

            @rectree = @s.rectree.asMutable()
            @rectreeCols = @cells.cols
            @rectreeRows = @cells.rows

            layout.absolutize {cols:@rectreeCols rows:@rectreeRows} @rectree

            post.emit 'sheet.edited'

        else
            @clearSheet()

        @

    renderSheet: (rectree cells pos opt) ->

        # render a sheet rectree and commit it in one undoable step

        opt ?= {}

        data  = sue.desue layout.sueify({cols:cells.cols rows:cells.rows} rectree)
        lines = kseg.segls data.text.split('\n')

        @segls = lines

        @changeLinesSegls()

        @syntax.setSegls @s.lines

        @s = @s.set 'sue' data.sue
        @s = @s.set 'rectree' layout.plainNode(rectree)

        if pos?
            @s = @s.set 'cursors' [pos]
            @s = @s.set 'main' 0

        @rectree = rectree
        @rectreeCols = cells.cols
        @rectreeRows = cells.rows

        @segls = @s.lines.slice()
        @rowCache = null
        @r = []

        @emit 'sue.changed'

        if opt.history == false
            @swapState()
        else
            @pushState()

        if pos?
            @adjustViewForMainCursor()
            if not opt.silent
                mode.cursorsSet @
                @emit 'cursorsSet'

        post.emit 'sheet.edited'

        @

    moveSheetNode: (dir) ->

        ⮐ null if not @rectree?

        cells = {cols:@cells.cols rows:@cells.rows}

        layout.absolutize cells @rectree

        cursor = @mainCursor()
        node   = layout.topmostIn @rectree cursor

        ⮐ null if not node?

        oldRect = clone node.rect.abs
        moved   = layout.moveNodeAt cells @rectree cursor dir

        ⮐ null if not moved?

        rect = moved.rect.abs

        maxX = max rect.x (rect.x + rect.w - 1)
        maxY = max rect.y (rect.y + rect.h - 1)

        x = clamp rect.x maxX (rect.x + cursor[0] - oldRect.x)
        y = clamp rect.y maxY (rect.y + cursor[1] - oldRect.y)

        @renderSheet @rectree cells [x y]

        moved

    insertAsciiHeaderForSelectionOrWordAtCursor: ->

        [lines cursors selections] = belt.insertAsciiHeaderForPositionsAndRanges @s.lines @s.cursors @s.selections
        
        @clearHighlights()
        @setLines      lines
        @setSelections selections
        @setCursors    cursors
        
    surroundSelection: trigger pair ->
        
        [lines posl] = belt.insertSurroundAtRanges @s.lines @s.selections trigger pair

        @setLines      lines
        @setSelections []
        @setCursors    posl
        