
use ../../../kxk ▪ kseg
use ../tool      ◆ belt motion
use ../../util   ◆ config
#!multi
export

    allCursors: -> @s.cursors.asMutable()
    
    scaleAdjustedColumn: pos dir -> 
        
        if config.get 'cursor.scaleAdjustCol'
            oline = pos[1] - dir
            if oline
                ocol = @lineScale(oline) * pos[0]
                ⮐ int(ocol / @lineScale(pos[1]))
        pos[0]
    
    expandCursors: dir ->
        
        cursors = @allCursors()

        dy = dir == 'up' ? -1 : 1
        
        rows = @hasWrap()

        newCursors = []
        for c in cursors
            newCursors.push c
            if rows
                newCursors.push @rowStep(c dir)[0]
            else
                cn = @scaleAdjustedColumn [c[0] c[1]+dy] dy
                newCursors.push [cn c[1]+dy]

        mc = belt.traversePositionsInDirection newCursors @mainCursor() dir
        @setCursors newCursors main:mc adjust:'topBotDelta'
        
    contractCursors: dir ->
        
        cursors = @allCursors()

        newCursors = []
        for c in cursors
            nbup = belt.positionsContain cursors belt.positionInDirection(c 'down')
            nbdn = belt.positionsContain cursors belt.positionInDirection(c 'up')
            solo = not (nbup or nbdn)
            add = switch dir
                'up'   ➜ nbup or solo
                'down' ➜ nbdn or solo
            
            newCursors.push c if add

        @setCursors newCursors
        
    addCursor: x y ->
        
        pos = belt.pos x y
        cursors = @allCursors()
        cursors.push pos
        @setCursors cursors main:-1
        
    addCursors: cursors ->
        
        @setCursors @allCursors().concat(cursors)
        
    delCursorsInRange: rng ->
        
        outside = belt.positionsOutsideRange @allCursors() rng
        outside.push belt.endOfRange(rng)
        @setCursors outside main:-1
                
    moveCursors: dir opt ->

        if dir is arr

            switch dir[0]
                'bos' ➜ ⮐ if @moveCursorsToStartOfSelections(); dir = dir[1..]
                'eos' ➜ ⮐ if @moveCursorsToEndOfSelections();   dir = dir[1..]
                    
            dir = dir[0]
        
        opt ?= {}
        opt.count ?= 1
        opt.jumpWords ?= false
        
        if @s.highlights.length
            @deselect()
        
        cursors = @allCursors()
        lines   = @s.lines

        if dir in ['up' 'down'] and not @rectree? and @hasWrap()
            goals = @rowGoals()
            rows  = {}

        for c in cursors

            line = lines[c[1]]

            switch dir
                'left' 'right'
                    if @rectree? and not opt.jump
                        pos = @sheetPosInDirection c dir opt.count; c[0] = pos[0]; c[1] = pos[1]
                    else
                        c[0] += belt.numCharsFromPosToWordOrPunctInDirection(lines c dir opt)
                'up' 'down'
                    if @rectree?
                        pos = @sheetPosInDirection c dir opt.count; c[0] = pos[0]; c[1] = pos[1]
                    else if rows
                        [pos goal] = @rowSteps c dir opt.count goals["#{c[0]} #{c[1]}"]
                        c[0] = pos[0]; c[1] = pos[1]
                        rows["#{c[0]} #{c[1]}"] = goal
                    else if dir == 'up'
                        c[1] -= opt.count; c[0] = @scaleAdjustedColumn(c -opt.count)
                    else
                        c[1] += opt.count; c[0] = @scaleAdjustedColumn(c  opt.count)
                'eol'       ➜ c[0] = kseg.width(@s.lines[c[1]])
                'bol'       ➜ c[0] = 0
                'bof'       ➜ c[0] = 0; c[1] = 0
                'eof'       ➜ c[1] = @s.lines.length-1; c[0] = kseg.width(line)
                'ind'       ➜ c[0] = belt.numIndent(line)
                'ind_eol'   ➜ ind  = belt.numIndent(line); c[0] = c[0] < ind ? ind : kseg.width(line)
                'ind_bol'   ➜ ind  = belt.numIndent(line); c[0] = c[0] > ind ? ind : 0
                'lineFirstDown' ➜ c[1] = min(c[1]+opt.count, lines.length-1); c[0] = belt.numIndent(lines[c[1]])
                'lineFirstUp'   ➜ c[1] = max(c[1]-opt.count, 0); c[0] = belt.numIndent(lines[c[1]])
                'paragraph'     ➜ pos = motion.paragraphPositionAfter  lines c 1; c[0] = pos[0]; c[1] = pos[1]
                'paragraphBack' ➜ pos = motion.paragraphPositionBefore lines c 1; c[0] = pos[0]; c[1] = pos[1]
                'sentence' 'sentenceBack'
                    r = motion.range(lines c {kind:dir count:opt.count})
                    if r
                        back = dir == 'sentenceBack'
                        c[0] = back ? r[0] : r[2]
                        c[1] = back ? r[1] : r[3]
                'word' 'wend'
                'WORD' 'WEND'
                    r = motion.range(lines c {kind:dir count:opt.count cursors:cursors.length})
                    c[0] = r[2]
                    c[1] = r[3]
                'drow' 'DROW'    
                    r = motion.range(lines c {kind:dir count:opt.count cursors:cursors.length})
                    c[0] = r[0]
                    c[1] = r[1]

        main   = @s.main
        adjust = opt.adjust ? 'topBotDelta'
        
        switch dir
            'up' 'down' 'left' 'right' 
                main = belt.indexOfExtremePositionInDirection cursors dir main
                adjust = 'topBotDeltaGrow'
                
        @setCursors cursors main:main adjust:adjust
        @keepRowGoals rows if rows

        true

    moveCursorsToStartOfSelections: ->
        
        selections = @allSelections()
        
        ⮐ if empty selections
        
        rngs = belt.splitLineRanges @s.lines selections false

        @setCursors belt.startPositionsOfRanges(rngs)
        
        true
        
    moveCursorsToEndOfSelections: ->
        
        selections = @allSelections()
         
        ⮐ if empty selections
         
        rngs = belt.splitLineRanges @s.lines selections false

        @setCursors belt.endPositionsOfRanges(rngs)
        
        true
        
    moveCursorsToEndOfLines: ->
        
        cursors = @allCursors()
        
        for cur in cursors
            cur[0] = belt.lineRangeAtPos(@s.lines cur)[2]
        
        @setCursors cursors
        
        true
                
    isAnyCursorInLine: y ->
        
        for c in @allCursors()
            ⮐ true if c[1] == y
            
    chunksBeforeCursors: -> @s.cursors.map (c) => belt.chunkBeforePos(@s.lines c)
            
    moveCursorsAndSelect: dir opt ->

        ⮐ @inSheetNode((st) -> st.moveCursorsAndSelect dir opt) if @rectree?
        ⮐ @moveRowsAndSelect(dir) if dir in ['up' 'down'] and @hasWrap()

        if empty @anchors
            @anchors = @allCursors()
        
        [selections cursors] = belt.extendLineRangesByMovingPositionsInDirection @s.lines @s.selections @s.cursors dir opt @anchors
        
        @setSelections selections
        @setCursors cursors adjust:'topBotDelta' keepAnchors:true

