###
    ███      ████████   ███████   ███   ███  
    ███      ███       ███   ███  ███  ███   
    ███      ███████   █████████  ███████    
    ███      ███       ███   ███  ███  ███   
    ███████  ████████  ███   ███  ███   ███  
###

use v8

function leak

    @interval: 10000
    @timer:    null
    @began:    null
    @peak:     null
    @previous: null

    @start: (opt) ->

        ⮐  if opt?.headless or opt?.colors

        leak.stop()

        leak.began    = Date.now()
        leak.previous = null
        leak.peak     = null

        head  = "leak ▸ sampling every #{leak.interval}ms"
        head += " ▸ heap limit #{leak.size(leak.memory().limit)}"
        log head

        leak.sample()

        leak.timer = setInterval (=> leak.sample()) leak.interval
        leak.timer.unref?()

        leak

    @stop: ->

        clearInterval leak.timer if leak.timer
        leak.timer = null

    @size: bytes ->

        ⮐ lpad 9 '' if not bytes

        units = [ 'b' 'k' 'M' 'G' 'T' ]
        n = bytes
        i = 0

        while n >= 1000 and i < units.length - 1
            n /= 1000
            i += 1

        if i == 0 ➜ b7(lpad(7 "#{int n}")) + w3(" #{units[i]}")
        else      ➜ b7(lpad(7 "#{n.toFixed(1)}")) + w3(" #{units[i]}")

    @sign: bytes ->

        ⮐ '' if not bytes

        prefix = '+'
        prefix = '-' if bytes < 0

        prefix + leak.size(Math.abs(bytes))

    @spaces: ->

        used = {}

        for stat in v8.getHeapSpaceStatistics()
            used[stat.space_name] = stat.space_used_size

        used

    @memory: ->

        mem   = process.memoryUsage()
        heap  = v8.getHeapStatistics()
        space = leak.spaces()

        result =
            rss:          mem.rss
            heapTotal:    mem.heapTotal
            heapUsed:     mem.heapUsed
            external:     mem.external
            arrayBuffers: mem.arrayBuffers
            limit:        heap.heap_size_limit
            old:          space.old_space ? 0
            large:        space.large_object_space ? 0

        result

    @sample: ->

        mem    = leak.memory()
        before = leak.previous ? mem
        peak   = leak.peak ? mem

        leak.previous = mem

        peak.rss      = Math.max peak.rss mem.rss
        peak.heapUsed = Math.max peak.heapUsed mem.heapUsed
        leak.peak     = peak

        percent = 100 * mem.heapUsed / mem.limit

        line  = "#{leak.size(mem.rss)} #{lpad(10 leak.sign(mem.rss - before.rss))}"
        line += "#{leak.size(mem.heapUsed)} #{g4(lpad(5 percent.toFixed(1)))}#{g2('%')} #{lpad(10 leak.sign(mem.heapUsed - before.heapUsed) )}"
        line += "#{leak.size(mem.heapTotal)}"
        line += "#{leak.size(mem.old)}"
        line += "#{leak.size(peak.rss)}"
        line += "#{leak.size(peak.heapUsed)}"

        log line

        mem

export leak
