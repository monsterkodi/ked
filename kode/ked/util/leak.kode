###
    ███      ████████   ███████   ███   ███  
    ███      ███       ███   ███  ███  ███   
    ███      ███████   █████████  ███████    
    ███      ███       ███   ███  ███  ███   
    ███████  ████████  ███   ███  ███   ███  
###

use v8

function leak

    @interval: 10000
    @timer:    null
    @peak:     null
    @previous: null

    @start: (opt) ->

        ⮐ if opt?.headless

        head  = "leak ▸ sampling every #{leak.interval}ms"
        head += " ▸ heap limit #{leak.size(leak.memory().limit)}"
        log head

        leak.sample()

        leak.timer = setInterval (=> leak.sample()) leak.interval
        leak.timer.unref?()

    @size: bytes ->

        n = bytes / 1000000
        b7(lpad(7 "#{n.toFixed(1)}")))

    @sign: bytes ->
        s = lpad(7 (Math.abs(bytes)/1000000).toFixed(1))
        if bytes < 0
            g3 s
        else
            r6 s
            
    @spaces: ->

        used = {}
        for stat in v8.getHeapSpaceStatistics()
            used[stat.space_name] = stat.space_used_size
        used

    @memory: ->

        mem   = process.memoryUsage()
        heap  = v8.getHeapStatistics()
        space = leak.spaces()

        result =
            rss:          mem.rss
            heapTotal:    mem.heapTotal
            heapUsed:     mem.heapUsed
            external:     mem.external
            arrayBuffers: mem.arrayBuffers
            limit:        heap.heap_size_limit
            old:          space.old_space ? 0

        result

    @sample: ->

        mem    = leak.memory()
        before = leak.previous ? mem
        peak   = leak.peak ? mem

        leak.previous = mem

        peak.rss      = Math.max peak.rss mem.rss
        peak.heapUsed = Math.max peak.heapUsed mem.heapUsed
        leak.peak     = peak

        percent = 100 * mem.heapUsed / mem.limit

        line  = "#{leak.size(mem.rss)}"
        line += "#{leak.sign(mem.rss - before.rss)}"
        line += "#{leak.size(mem.heapUsed)}"
        line += "#{g4(lpad(5 percent.toFixed(1)))}#{g2('%')}"
        line += "#{leak.sign(mem.heapUsed - before.heapUsed)}"
        line += "#{leak.size(mem.heapTotal)}"
        line += "#{leak.size(mem.old)}"
        line += "#{leak.size(peak.rss)}"
        line += "#{leak.size(peak.heapUsed)}"

        log line

        mem

export leak
