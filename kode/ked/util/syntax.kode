
use ../../kxk   ◆ matchr kstr kseg
use ../../kolor ◆ kulur
use ../theme    ◆ theme
■syntax
    @: @name -> 
        
        @ext  = 'txt' 
        @clear()
        
    clear: => 
        
        @diss = []  
        @hash = {}  
        @liha = {}
        @seen = null
        
    setExt: @ext => @ansi = false
    
    setRgxs: rgxs => @config = matchr.config rgxs 'u'
    
    setLines: lines => @setSegls kseg.segls(lines) 
    
    setColors: @colors => @ansi = true
        
    setSegls: (segls oldSegls=null) =>
        
        if valid @config
            @clear()
            @diss = []
            for segs in segls
                dss = matchr.ranges(@config kseg.str(segs) 'u')
                for ds in dss
                    if ds.clss is arr
                        ds.clss = trim ds.clss.map(kstr.trim).join(' ') 
                @diss.push dss
        else
            if @partialUpdate segls oldSegls
                @seen = segls
                ⮐
        
            @clear()
            
            @diss = kulur.dissect segls @ext
            for segl,idx in segls
                hsh = kseg.hash(segl)
                @hash[hsh] = @diss[idx]
                @liha[idx] = hsh
                
        @seen = segls
            
    partialUpdate: (segls oldSegls) =>
        
        ⮐ if @diss.length != segls.length
        ⮐ if empty @hash
        
        newHash = {}
        
        for segl,idx in segls
        
            #  a line keeps its dissection when it is unchanged both in the
            #  document and in the lines we dissected last
            
            if oldSegls and @seen and oldSegls[idx] == segl and @seen[idx] == segl
                hsh = @liha[idx]
                newHash[hsh] = @diss[idx]
                continue
            
            hsh = kseg.hash segl
            if @hash[hsh]
                newHash[hsh] = @hash[hsh]
            else
                newHash[hsh] = kulur.dissect([segl] @ext)[0]
            
            if @liha[idx] != hsh
                @diss.splice idx 1 newHash[hsh]
                @liha[idx] = hsh

        @hash = newHash
            
    addSegl: segl ext =>
    
        @seen = null
        @diss = @diss.concat kulur.dissect([segl] ext)
        
    appendSegls: segls ext =>
    
        for segl in segls
            @addSegl segl ext
            
    getClass: x y =>
        
        for dss in @diss[y]
            if dss.start <= x < dss.start+dss.length
                ⮐ dss.clss
        'text'
        
    getClasses: y =>
        
        classes = []
        for dss in @diss[y]
            for x in dss.start...dss.start+dss.length
                classes[x] = dss.clss
        classes
        
    hasPureClass: y clss =>
        pclss = [clss "text "+clss "punct "+clss "comment "+clss]
        for dss in @diss[y] ? []
            ⮐ true if dss.clss in pclss
        false

    hasClass: y clss =>
        
        for dss in @diss[y] ? []
            ⮐ true if dss.clss?.split(' ').includes clss
        false
        
    getColor: x y clss =>
        
        if @ansi ➜ ⮐ @getAnsiColor x y
        
        if not clss?
            if x is num
                clss = @getClass x y
            else
                clss = x
        
        theme.syntax[clss] ? [255 0 0]
        
    getAnsiColor: x y =>
        
        for clr in @colors[y]
            if clr.x <= x
                if clr.w? 
                    if x < clr.x + clr.w
                        ⮐ clr.fg
                else
                    ⮐ clr.fg
                
        [256 0 256]
        
    getChar: x y char clss =>
        
        clss ?= @getClass x y
        ⮐ '█' if 'header' in clss
        char
        
export syntax
