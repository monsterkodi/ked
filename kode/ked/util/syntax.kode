
use ../../kxk   ◆ matchr kstr kseg
use ../../kolor ◆ kulur
use ../theme    ◆ theme

UNIKEY = new RegExp "^text unicode (#{Object.keys(kulur.UNICODE).join('|')})\\b"

toIndices = segl dss -> # kulur chunks count display columns, ked indexes graphemes

    idx = [] # grapheme index of every column
    for seg,i in segl
        for c in 0...kseg.segWidth(seg)
            idx.push i
    ⮐ dss if idx.length == segl.length # every grapheme is one column wide

    for ds in dss
        end = ds.start + ds.length
        s   = idx[ds.start] ? segl.length
        e   = (idx[end-1] ? segl.length-1) + 1
        ds.start  = s
        ds.length = e - s
    dss

■syntax
    @: @name -> 
        
        @ext  = 'txt' 
        @clear()
        
    clear: => 
        
        @diss = []  
        @lineDiss = new Map()
        
    setExt: @ext => @ansi = false
    
    setRgxs: rgxs => @config = matchr.config rgxs 'u'
    
    setLines: lines => @setSegls kseg.segls(lines) 
    
    setColors: @colors => @ansi = true
        
    setSegls: segls =>
        
        if valid @config
            @clear()
            @diss = []
            for segs in segls
                dss = matchr.ranges(@config kseg.str(segs) 'u')
                for ds in dss
                    if ds.clss is arr
                        ds.clss = trim ds.clss.map(kstr.trim).join(' ') 
                @diss.push dss
        else
            ⮐ if @partialUpdate segls
        
            @clear()
            
            @diss = kulur.dissect segls @ext

            for segl,idx in segls
                toIndices segl, @diss[idx]
                @lineDiss.set segl @diss[idx]
        
    partialUpdate: segls =>
        
        ⮐ if @lineDiss.size == 0
        
        diss = []
        
        for segl,idx in segls
            
            dss = @lineDiss.get segl
            
            if not dss?
                dss = toIndices segl, kulur.dissect([segl] @ext)[0]
                @lineDiss.set segl dss
                
                @pruneLineDiss segls if @lineDiss.size > 2*segls.length + 100
                
            diss.push dss
            
        @diss = diss
        
    pruneLineDiss: segls =>
        
        keep = new Map()
        
        for line,idx in segls
            dss = @lineDiss.get line
            keep.set line dss if dss?
            
        @lineDiss = keep
            
    addSegl: segl ext =>
    
        dss = toIndices segl, kulur.dissect([segl] ext)[0]
        @diss = @diss.concat [dss]
        @lineDiss.set segl dss
        
    appendSegls: segls ext =>
    
        for segl in segls
            @addSegl segl ext
            
    getClass: x y =>
        
        for dss in @diss[y]
            if dss.start <= x < dss.start+dss.length
                ⮐ dss.clss
        'text'
        
    getClasses: y =>
        
        classes = []
        for dss in @diss[y]
            for x in dss.start...dss.start+dss.length
                classes[x] = dss.clss
        classes
        
    hasPureClass: y clss =>
        pclss = [clss "text "+clss "punct "+clss "comment "+clss]
        for dss in @diss[y] ? []
            ⮐ true if dss.clss in pclss
        false

    hasClass: y clss =>
        
        for dss in @diss[y] ? []
            ⮐ true if dss.clss?.split(' ').includes clss
        false
        
    getColor: x y clss =>
        
        if @ansi ➜ ⮐ @getAnsiColor x y
        
        if not clss?
            if x is num
                clss = @getClass x y
            else
                clss = x
        
        syntax.themeColor(clss) ? [255 0 0]

    @themeColor: clss -> # theme color of clss; 'text unicode <key> …' falls back to 'text unicode …'

        ⮐ theme.syntax[clss] if theme.syntax[clss]
        if m = UNIKEY.exec clss
            ⮐ theme.syntax['text unicode' + clss[m[0].length..]]

    getAnsiColor: x y =>
        
        for clr in @colors[y]
            if clr.x <= x
                if clr.w? 
                    if x < clr.x + clr.w
                        ⮐ clr.fg
                else
                    ⮐ clr.fg
                
        [256 0 256]
        
    getChar: x y char clss =>
        
        clss ?= @getClass x y
        ⮐ '█' if 'header' in clss
        char
        
    scaleOfLine: scales scaling li =>

        ⮐ 1 if not scaling or empty scales
        ⮐ 1 if @ext not in Object.keys(scales)

        for clss,scale of scales[@ext]
            s = clamp 1 7 scale
            if s > 1 and @hasPureClass(li clss)
                ⮐ s
        1
        
export syntax
