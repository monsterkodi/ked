###
    glyphs

    decoded coverage masks from fontmap.json

    the maps are generated by fontmap.kode, one entry per pixel size
    that a scaled map line occupies: 2 by 4 pixels per scale step
###

import fontmap from './fontmap.json' with { type: "json" }

function glyphs

    @cache: {}

    @forScale: scale ->
        @forSize((scale*2), (scale*4))

    @forSize: w h ->

        key = "#{w}x#{h}"

        if @cache[key]?
            ⮐ @cache[key]

        raw = fontmap[key]
        ⮐  null if not raw

        masks = {}

        for ch,rows of raw.glyphs

            mask = new Uint8Array new ArrayBuffer(w*h)

            for y in 0...h
                row = rows[y] # 0x-prefixed hex, one byte per pixel
                for x in 0...w
                    mask[y*w+x] = parseInt(row.substr(2+x*2, 2), 16)

            masks[ch] = mask

        @cache[key] = masks

    @hasScale: scale ->

        w = scale*2
        h = scale*4

        fontmap["#{w}x#{h}"]?

export glyphs
