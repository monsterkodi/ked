
use fs os
use child_process ▪ spawnSync
use ../../../kxk  ▪ noon slash

■fontmap
    ###
        node js/ked/util/img/fontmap.js
    ###
    
    @extra:   " !?-+_=/><^[](){}\"'#*$@%&:;.,◆●■◇◯□△▸▴◂➜✔✘"
    @chars:   Array.from("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789" + fontmap.extra)

    @font:    'JetBrainsMono NFM ExtraBold'

    @sizes:   [[8 16] [10 20] [12 24] [14 28]]

    @out:     slash.path(◆dir '../../../../img')
    @mapFile: slash.path(◆dir '../../../../kode/ked/util/img/fontmap.noon')

    @tmp: name -> slash.path(os.tmpdir(), "ked-fontmap-#{name}.png")

    @exec: cmd args ->
        
        result = child_process.spawnSync cmd args maxBuffer:0x10000000
        
        if result.status != 0
            error "fontmap: #{cmd} failed with #{result.status}"
            error String(result.stderr)
            ⮐ null
        
        result

    @render: text px file ->

        @exec 'pango-view' ['-q' '--pixels' "--font=#{@font} #{px}" '--background=black' '--foreground=white' '--margin=0' "--text=#{text}" '-o' file]
        
        result = @exec 'magick' ['identify' '-format' '%wx%h' file]
        ⮐ if not result

        [w h] = String(result.stdout).trim().split 'x'
        [int(w) int(h)]

    @grayscale: file w h ->

        result = @exec 'magick' [file '-filter' 'Triangle' '-resize' "#{w}x#{h}!" '-depth' '8' 'gray:-']
        ⮐ if not result

        result.stdout

    @buildMap: w h ->
        
        sequence = @chars.join(' ')
        result = @render(sequence, h, @tmp('glyphs'))
        ⮐ if not result
        
        total = w * (@chars.length*2 - 1)
        data  = @grayscale(@tmp('glyphs'), total, h)
        ⮐ if not data
        
        glyphs = {}
        
        for ch,i in @chars
            cov = new Uint8Array new ArrayBuffer(w*h)
            for y in 0...h
                for x in 0...w
                    cov[y*w+x] = data[y*total+(i*2)*w+x]
            glyphs[ch] = cov
            
        glyphs

    @rowsFor: cov w h ->

        rows = []
        
        for y in 0...h
            
            row = '0x'
            for x in 0...w
                row += cov[y*w+x].toString(16).padStart(2 '0')
            rows.push row
            
        rows

    @noonFor: maps ->

        data = {}

        for key,map of maps

            gl = {}

            for ch in @chars
                gl[ch] = @rowsFor(map.glyphs[ch], map.width, map.height)

            data[key] = width:map.width height:map.height font:map.font file:map.file glyphs:gl

        noon.stringify(data, {indent:4 maxalign:8}) + '\n'

    @savePNG: file image ->

        result = child_process.spawnSync 'magick' ['-size' "#{image.w}x#{image.h}" '-depth' '8' 'rgba:-' '-strip' file] input:image.rgba maxBuffer:0x10000000

        if result.status != 0
            error "fontmap: magick could not write #{file}"
            error String(result.stderr)

    @preview: glyphs w h ->

        gz   = 4
        cols = 13
        gap  = 1
        rows = ceil @chars.length/cols
        
        pw = cols*w*gz + (cols-1)*gap
        ph = rows*h*gz + (rows-1)*gap
        
        pixels = new Uint32Array new ArrayBuffer(pw*ph*4)
        pixels.fill 0xff000000
        
        for ch,i in @chars
            
            cx = (i%cols)*(w*gz+gap)
            cy = int(i/cols)*(h*gz+gap)
            cov = glyphs[ch]
            
            for y in 0...h
                for x in 0...w
                    c = cov[y*w+x]
                    v = c | c<<8 | c<<16 | 0xff000000
                    for yy in 0...gz
                        for xx in 0...gz
                            pixels[(cy+y*gz+yy)*pw+cx+x*gz+xx] = v
        
        w:pw h:ph rgba:pixels

    @generate: ->

        fs.mkdirSync @out recursive:true

        log "#{@font}"

        maps = {}

        for [w h] in @sizes
            
            glyphs = @buildMap w h
            ⮐ if not glyphs

            size = "#{w}x#{h}"
            log size
            
            maps[size] = width:w height:h font:@font glyphs:glyphs

            pngFile = slash.path @out "fontmap-#{size}.png"
            @savePNG pngFile @preview(glyphs w h)
            
        fs.writeFileSync(@mapFile @noonFor(maps))

◆main

    fontmap.generate()

export fontmap
