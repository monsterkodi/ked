
use fs

■logfile

    @: @name headless=false capture=false ->

        @headless = headless
        @lines    = []

        #  a headless run has no log file. ked's headless dumps capture
        #  the console instead, to show it below each dump

        if @headless
            if capture
                console.log   = args... => @capture args
                console.warn  = args... => @capture args
                console.error = args... => @capture args
            ⮐
        
        logfile = ◆dir + '/../../../ked.log'

        @stream = fs.createWriteStream logfile flags:'w' autoClose:false
        console.log = args... => 
            
            if args.length and args[0] is str
                if args.length > 2
                    obj = args[1..]
                else if args.length == 2
                    obj = args[1]
                @write w2("▸ ") + y8(args[0])
                @write noon(obj) if args.length > 1
            else        
                @write "▾\n"+noon(args)

        console.warn = args... => 
            
            @write m6(args.map((a) -> r5("▴ ")+noon(a)).join(' '))
                
        console.error = args... => 
            
            @write r5(args.map((a) -> r5("▴ ")+noon(a)).join(' '))
        
    capture: args ->

        txt = args.map((a) -> a is str ? a : noon(a)).join ' '
        txt = txt.replace /\x1b\[[0-9;]*m/g ''
        @lines = @lines.concat txt.split('\n').filter((l) -> l.trim().length)

    take: ->

        lines = @lines
        @lines = []
        lines

    write: txt ->
        
        ⮐ if @headless or @stream.closed or not @stream.writable

        @stream.write txt + '\n'
        
    close: cb ->
        
        if @headless
            lines = @take()
            if valid lines
                process.on 'exit' -> process.stderr.write lines.join('\n') + '\n'
            cb()
            ⮐
        
        @stream.end r4('▪\n')
        @stream.close cb
        
export logfile
