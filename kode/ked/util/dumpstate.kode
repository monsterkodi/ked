
use ../edit ◆ mode
use ../edit/tool ◆ sue
use ../popo ◆ layout
■dumpstate
    @tags: (state file focus) ->

        tags = []

        tags.push "focus: #{focus}" if valid focus

        names = (mode.active[state.name] ? []).map((m) -> m.name).sort()
        tags.push "modes: #{names.join ' '}" if valid names
        
        novim = mode.get state 'novim'
        tags.push "pending: :#{novim.ex}" if novim?.ex?
        
        tags.push 'dirty' if state.isDirty()
        tags.push "undo #{state.h.length-1}" if state.h.length > 1
        tags.push "redo #{state.r.length}" if valid state.r
        tags.push "file: #{file}" if valid file

        wrap = []
        if state.wrap?.all
            wrap.push 'all'
        else
            for area in (state.s.sue ? [])
                wrap.push area.y if area.value[0] == sue.WRAP
        wrap.push 'word' if state.wrap?.word
        tags.push "wrap: #{wrap.join ' '}" if valid wrap
        
        tags.map((tag) -> "[#{tag}]").join ' '

    @ROWS: 10

    #  info: label state cells file images names focus selected logs
    #  rows limits the lines: the newest log lines that fit are kept

    @section: info rows ->

        state = info.state
        out   = ["=== #{info.label}"]
        tags  = @tags state info.file info.focus

        out.push "    #{tags}" if valid tags

        cursors = state.s.cursors.map (c) -> "#{c[0]}:#{c[1]}"

        if cursors.length == 1
            out.push "    cursor #{cursors[0]}"
        else
            out.push "    cursors #{cursors.join ' '} main #{state.s.main}"

        if valid state.s.selections
            ranges = state.s.selections.map (r) -> "#{r[0]}:#{r[1]}-#{r[2]}:#{r[3]}"
            out.push "    select #{ranges.join ' '}"

        if rect = info.cells?.cellRect
            out.push "    rect #{rect.x}:#{rect.y} #{rect.w}x#{rect.h}"

        if state.rectree?
            selected = @nodeText state.rectree info.selected
            atCursor = @nodeText state.rectree state.sheetNodeAtCursor()
            line = "    node #{selected}"
            line += " · at cursor #{atCursor}" if atCursor != selected
            out.push line

        if valid info.images
            out.push "    images #{@imageBoxes(info.images info.names info.cellh).join '  '}"

        logs = info.logs ? []
        if rows?
            logs = logs.slice max(0 logs.length - (rows - out.length))
            logs = [] if out.length >= rows
        out = out.concat logs.map((l) -> "    log #{l}")

        out

    @nodeText: rectree node ->

        ⮐ '-' if not node?

        path = layout.pathOf(rectree node) ? []
        text = "#{path.join('.')} #{layout.roleOf(node)}"
        if rect = node.rect?.abs
            text += " #{rect.x}:#{rect.y} #{rect.w}x#{rect.h}"
        text

    #  placements of one named image (e.g. the tiles of a scrollbar) as one cell box:
    #  name x:y-x:y×count hN
    #  hN: scaled cursors span N rows, boxed per height

    @imageBoxes: images names cellh ->

        boxes = {}
        for img in images
            name = names?[img.i] ? img.i
            rows = 1
            if name in ['cursor' 'multi'] and cellh and img.h > cellh
                rows = round(img.h / cellh)
            key  = "#{name} #{rows}"
            if box = boxes[key]
                box.x1 = min box.x1 img.x
                box.y1 = min box.y1 img.y
                box.x2 = max box.x2 img.x
                box.y2 = max box.y2 img.y
                box.n += 1
            else
                boxes[key] = name:name x1:img.x y1:img.y x2:img.x y2:img.y n:1 rows:rows

        Object.values(boxes).map (b) ->
            s = "#{b.name} #{b.x1}:#{b.y1}"
            s += "-#{b.x2}:#{b.y2}" if b.x2 != b.x1 or b.y2 != b.y1
            s += "×#{b.n}" if b.n > 1
            s += " h#{b.rows}" if b.rows > 1
            s

export dumpstate
