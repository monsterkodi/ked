###
    ███   ███  ████████  ███   ███   ███████   ███████  ████████   ███  ████████   █████████  
    ███  ███   ███        ███ ███   ███       ███       ███   ███  ███  ███   ███     ███     
    ███████    ███████     █████    ███████   ███       ███████    ███  ████████      ███     
    ███  ███   ███          ███          ███  ███       ███   ███  ███  ███           ███     
    ███   ███  ████████     ███     ███████    ███████  ███   ███  ███  ███           ███     
###

function keyscript

    @keys:
        'up':        '\x1b[A'
        'down':      '\x1b[B'
        'right':     '\x1b[C'
        'left':      '\x1b[D'
        'home':      '\x1b[H'
        'end':       '\x1b[F'
        'pageup':    '\x1b[5~'
        'pagedown':  '\x1b[6~'
        'insert':    '\x1b[2~'
        'delete':    '\x1b[3~'
        'enter':     '\r'
        'return':    '\r'
        'tab':       '\t'
        'esc':       '\x1b[27u'
        'space':     ' '
        'backspace': '\x7f'
        'f1':        '\x1bOP'
        'f2':        '\x1bOQ'
        'f3':        '\x1bOR'
        'f4':        '\x1bOS'
        
    @csi:
        'up':    'A'
        'down':  'B'
        'right': 'C'
        'left':  'D'
        'home':  'H'
        'end':   'F'
        
    @kitty:
        'tab':       9
        'return':    13
        'enter':     13
        'esc':       27
        'space':     32
        'backspace': 127
        
    @modbits:
        'shift': 1
        'alt':   2
        'ctrl':  4
        'cmd':   8
        'super': 8
        'meta':  8
        
    @bytes: word =>
        
        ⮐  if empty word
        
        if word.startsWith '\x1b'
            ⮐  word
        
        if known = @keys[word]
            ⮐  known
        
        if combo = keyscript.combo word
            ⮐  combo
        
        chars = ''
        
        for ch in word.split ''
            chars += ch
        
        chars
    
    @combo: word =>
        
        parts = word.split '+'
        
        ⮐  if parts.length < 2
        
        mod = 0
        
        for part in parts[0...-1]
            m = @modbits[part]
            ⮐  if not m
            mod += m
        
        base = parts[-1]
        
        ⮐  if empty base
        
        if code = @kitty[base]
            ⮐  "\x1b[#{code};#{mod+1}u"
        
        if c = @csi[base]
            ⮐  "\x1b[1;#{mod+1}#{c}"
        
        ⮐  if base.length != 1
        
        code = base.charCodeAt 0
        
        ⮐  if not code
        
        "\x1b[#{code};#{mod+1}u"
    
    @script: text =>
        
        out = ''
        
        for word in text.split(/\s+/).filter((w) -> w.length)
            out += keyscript.bytes word
        out
    
    @steps: text =>
        
        out = []
        
        for word in text.split(/\s+/).filter((w) -> w.length)
            
            if known = @keys[word]
                out.push [word known]
                continue
            
            if combo = keyscript.combo word
                out.push [word combo]
                continue
            
            if word.startsWith '\x1b'
                out.push [word word]
                continue
            
            for ch in word.split ''
                out.push [ch ch]
        
        out

export keyscript
