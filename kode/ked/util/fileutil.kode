
use ../../kxk           ▪ post slash nfs
use ../../kxk           ◆ salter
use ../../kolor/extlang ▪ exts lang

■fileutil

    # move these to some config! 𝖘𝜏⊚𝔭 ⫙⊚⩗𝚒∩𝚐 𝜏𝖍𝚒𝖘 𝕒ɼ𝕒⊚𝓊∩⫐, 𝒹𝕒⫙⫙𝚒𝜏!
    @indexFileExtensions:  [ 'kode' 'mm' 'zig' 'cc' 'c' 'h' 'hpp' 'cpp' 'nim' 'kim' 'lua' 'kua'] 
    @dotFileExtensions:    [ 'bashrc' 'bash_history' 'gitconfig' 'gitignore_global' 'lesshst' 'npmrc' 'nvimrc' 'profile' 'zprofile' 'zsh_history' 'zshrc' ]
    @sourceFileExtensions: fileutil.indexFileExtensions.concat(fileutil.dotFileExtensions [ 'ts' 'js' 'mjs' 'swift' 'styl' 'css' 'pug' 'html' 'md' 'noon' 'json' 'txt' 'log' 'sh' 'fish' 'py' 'frag' 'vert' 'config' 'toml' 'conf' 'gitignore' 'plist' ]) 
    @imageExtensions:      ['png' 'jpg' 'jpeg' 'gif' 'tiff' 'pxm' 'icns' 'webp']

    @counterparts: # todo: move this to a config file?
        mm:      ['h']
        cpp:     ['hpp' 'h']
        cc:      ['hpp' 'h']
        h:       ['cpp' 'c' 'mm']
        hpp:     ['cpp' 'c']
        coffee:  ['js' 'mjs']
        kode:    ['js' 'mjs']
        kim:     ['nim']
        nim:     ['kim']
        kua:     ['lua']
        lua:     ['kua']
        js:      ['coffee' 'kode']
        mjs:     ['coffee' 'kode']
        pug:     ['html']
        noon:    ['json']
        json:    ['noon']
        html:    ['pug']
        css:     ['styl']
        styl:    ['css']

    @detectClassWeights:
        keyword:            1
        'keyword function': 1
        'keyword type':     1
        require:            0.9
        define:             0.9
        punct:              0.8
        type:               0.7
        function:           0.5
        'function call':    0.5
        method:             0.5
        module:             0.35
        property:           0.2
        'property color':   0.2
        'property special': 0.2
        argument:           0.35
        important:          0.4
        nil:                0.3

    # punctuation and token shapes that are characteristic for a language

    @kodeSignals: [
        ['[◆▪■□➜⮐▸]' 6]
        ['(^|\\n)\\s*(log|use)\\s+' 3]
        ['(^|\\n)\\s*@\\w*\\s*:' 2]
    ]

    @coffeeSignals: [
        ['(^|\\n)\\s*unless\\b' 3]
        ['\\b(isnt|yes|no)\\b' 1.5]
        ['(^|\\n)\\s*@\\w+\\s*=' 1.5]
        ['->' 1.5]
    ]

    @jsSignals: [
        ['\\bconsole\\.(log|error|warn|info|debug)\\b' 4]
        ['\\b(document|window|globalThis)\\.' 3]
        ['\\b(require|module\\.exports|exports\\.)' 3]
        ['(^|\\n)\\s*(const|let)\\s+[A-Za-z_$]' 2]
        ['=>' 2]
        ['===|!==' 2]
        ['(^|\\n)\\s*(async\\s+)?function\\s+\\w*\\s*\\(' 3]
        ['\\bexport\\s+(default|const|function|class)\\b' 3]
        ['\\.then\\s*\\(|new\\s+Promise\\b' 2]
        ['\\?\\?|\\?\\.' 1]
        ['\\bnew\\s+[A-Z]\\w*\\s*\\(' 1]
    ]

    @tsSignals: [
        ['\\b(interface|type)\\s+[A-Za-z_$]\\w*' 3]
        ['\\b(readonly|implements|namespace|declare|enum)\\b' 2]
        ['\\b(public|private|protected)\\s+\\w+' 2]
        ['\\bimport\\s+type\\b' 3]
        ['\\bas\\s+(const|string|number|boolean|any)\\b' 2]
        ['\\w+\\?:\\s*\\w+' 1]
        ['<\\w+(\\[\\])?>\\s*[=(]' 1]
    ]

    @pySignals: [
        ['(^|\\n)\\s*def\\s+\\w+\\s*\\([^\\n]*\\)\\s*:' 5]
        ['(^|\\n)\\s*class\\s+\\w+([^\\n]*)?:' 4]
        ['(^|\\n)\\s*(elif|except)\\b' 4]
        ['\\bself\\.\\w+' 3]
        ['__init__|__name__' 4]
        ['\\blambda\\s+\\w+\\s*:' 3]
        ['(^|\\n)\\s*@\\w+(\\.\\w+)*\\s*$' 2]
        ['\\b(None|True|False)\\b' 2]
        ['\\b(range|len)\\s*\\(' 1.5]
        ["\"\"\"|'''" 3]
        ['(^|\\n)\\s*(if|elif|else|for|while|try|except|finally|with|import|from|return|yield|raise|pass|break|continue)\\b[^\\n]*:' 2]
        ['\\bprint\\s*\\(' 1.5]
    ]

    @shellSignals: [
        ['^#!.*\\b(ba|z|k|da|fi)?sh\\b' 6]
        ['\\$\\{?[A-Za-z_]\\w*\\}?' 2]
        ['\\$\\([^)\\n]*\\)' 3]
        ['\\b(fi|done|esac|then|elif)\\b' 2]
        ['\\|\\s*(grep|sed|awk|head|tail|sort|cat|cut|xargs|tee)\\b' 3]
        ['\\b(grep|sed|awk|curl|wget|chmod|sudo|mkdir|rm|cp|mv|cat|echo)\\s' 2]
        ['2>&1|>\\s*/dev/null' 3]
        ['\\[\\[?\\s*-[a-z]\\s' 3]
        ['(^|\\n)\\s*(export|source|alias)\\s+' 2]
        [';\\s*do\\b' 1.5]
    ]

    @fishSignals: [
        ['^#!.*\\bfish\\b' 6]
        ['(^|\\n)\\s*(set|function|status|string|math|test)\\b' 2]
        ['\\$\\w+\\[' 2]
        ['\\bcommand\\s+-[a-z]' 2]
    ]

    @luaSignals: [
        ['(^|\\n)\\s*--' 4]
        ['(^|\\n)\\s*local\\s+\\w+' 4]
        ['(^|\\n)\\s*function\\s+[\\w.:]+\\s*\\(' 3]
        ['\\b(then|elseif)\\b' 2]
        ['\\bnil\\b' 1.5]
        ['~=' 2]
        ['\\.\\.(?!\\.)' 2]
        ['\\b(ipairs|pairs|require|setmetatable|getmetatable)\\s*\\(' 2]
    ]

    @zigSignals: [
        ['@import\\s*\\(' 5]
        ['(^|\\n)\\s*(pub\\s+)?fn\\s+\\w+' 4]
        ['!void|!u\\d+|!\\[\\]' 3]
        ['\\b(orelse|defer)\\b' 3]
        ['\\.\\{' 2]
        ['\\[\\]const\\s+\\w+' 3]
        ['@\\w+\\s*\\(' 2]
        ['(^|\\n)\\s*(const|var)\\s+\\w+\\s*=\\s*' 1]
        ['\\bcatch\\b' 1]
    ]

    @nimSignals: [
        ['(^|\\n)\\s*proc\\s+\\w+' 5]
        ['(^|\\n)\\s*(method|template|macro|iterator|converter)\\s+\\w+' 4]
        ['(^|\\n)\\s*func\\s+\\w+' 2]
        ['\\becho\\s+' 3]
        ['\\b(discard|newSeq|result)\\b' 2]
        ['(^|\\n)\\s*import\\s+[\\w, ]+' 2]
        ['\\b(var|let|const)\\s+\\w+\\s*:' 2]
        ['@\\[' 3]
        ['(^|\\n)\\s*#[^\\n]*' 0.5]
    ]

    @cFamilySignals: [
        ['#include\\s*<[\\w./]+>' 3]
        ['#define\\s+\\w+' 3]
        ['#pragma\\s+' 3]
        ['\\b(struct|enum|union)\\s+\\w+\\s*\\{' 2]
        ['\\b(int|void|char|float|double|long|unsigned|short)\\s+\\w+\\s*\\(' 2]
        ['\\breturn\\s+[\\w.]+\\s*;' 1]
        ['->\\s*\\w+' 1]
    ]

    @cppSignals: [
        ['#include\\s*<(iostream|vector|string|map|memory|algorithm|utility|thread|mutex|fstream|sstream)>' 4]
        ['\\bstd::' 3]
        ['\\b(cout|cin|cerr|endl)\\b' 3]
        ['\\b(template\\s*<|typename|using\\s+namespace)' 3]
        ['\\b(public|private|protected)\\s*:' 2]
        ['\\bnew\\s+[A-Za-z_]\\w*|\\bdelete\\b' 1]
        ['::' 1.5]
    ]

    @cSignals: [
        ['#include\\s*<(stdio|stdlib|string|math|unistd|stdint|stdbool|assert|ctype|time|sys/\\w+)' 4]
        ['\\b(printf|scanf|malloc|calloc|realloc|free|fopen|fclose|strlen|memcpy)\\s*\\(' 2]
        ['(^|\\n)\\s*(int|void)\\s+main\\s*\\(' 2]
    ]

    @mmSignals: [
        ['@(interface|implementation|protocol|property|synthesize|end)\\b' 5]
        ['#import\\s' 4]
        ['\\bNS[A-Z]\\w+' 3]
        ['\\b(self|super|alloc|release|autorelease)\\b' 1.5]
        ['\\b(YES|NO|BOOL)\\b' 1]
    ]

    @csSignals: [
        ['\\busing\\s+System\\b' 4]
        ['\\bConsole\\.(Write|Read|Error)\\w*' 4]
        ['\\b(public|private|protected)\\s+static\\s+void\\s+Main\\b' 4]
        ['\\bnamespace\\s+\\w+' 2]
        ['\\b(string\\[\\]|List<|IEnumerable<|Dictionary<)' 2]
        ['\\bvar\\s+\\w+\\s*=\\s*new\\b' 2]
    ]

    @htmlSignals: [
        ['</?[a-zA-Z][\\w-]*(\\s|>|/)' 2]
        ['<!DOCTYPE|<!--|-->' 3]
        ["\\b(class|id|href|src|style)\\s*=\\s*[\"']" 2]
        ['</\\w+\\s*>' 2]
        ['<\\w+[^>]*/>' 2]
    ]

    @svgSignals: [
        ['<svg\\b|</svg>|viewBox|xmlns=' 4]
        ['<(path|rect|circle|ellipse|polygon|polyline|line|text|g|defs)\\b' 1.5]
    ]

    @mdSignals: [
        ['(^|\\n)#{1,6}\\s+\\S' 3]
        ['\\*\\*[^*\\n]+\\*\\*|__[^_\\n]+__' 2]
        ['\\[[^\\]\\n]+\\]\\([^)\\n]+\\)' 3]
        ['(^|\\n)\\s*[-*+]\\s+\\S' 1]
        ['(^|\\n)>\\s+\\S' 1.5]
        ['(^|\\n)```' 3]
        ['`[^`\\n]+`' 1]
    ]

    @cssSignals: [
        ['[\\w-]+\\s*:\\s*[^;{\\n]+;' 2]
        ['[.#][\\w-]+\\s*([,{:])' 2]
        ['@(media|import|font-face|keyframes|supports|charset)\\b' 3]
        ['#[0-9a-fA-F]{3,8}\\b' 1.5]
        ['\\b\\d+(px|em|rem|vh|vw|vmin|vmax|%|s|ms)\\b' 1]
        ['!important' 2]
        ['\\b(color|background|margin|padding|font|display|border|width|height|position|flex|grid|transform|transition)\\s*:' 1.5]
    ]

    @cssBracedSignals: [
        ['\\{[^{}]*[\\w-]+\\s*:\\s*[^;{}]+;' 3]
        [';\\s*\\}' 2]
    ]

    @scssSignals: [
        ['\\$[A-Za-z_]\\w*\\s*:' 3]
        ['@(mixin|include|extend|each|if|else|for|while|function)\\b' 2]
        ['&:?[\\w-]+' 1]
    ]

    @stylSignals: [
        ['(^|\\n)\\s*[\\w-]+\\s+[#\\d][^\\n]*$' 2]
    ]

    @jsonSignals: [
        ['(^|\\n)\\s*"[^"\\n]+"\\s*:' 2]
        ['(^|\\n)\\s*[\\[{]\\s*(\\n|$)' 1]
        ['[:\\[,]\\s*(true|false|null)\\b' 1.5]
    ]

    @yamlSignals: [
        ['(^|\\n)\\s*[\\w.-]+\\s*:\\s*(\\n|$|\\S)' 2]
        ['(^|\\n)\\s*-\\s+\\S' 1.5]
        ['(^|\\n)---\\s*$' 3]
        ['(^|\\n)\\s*#\\s' 0.5]
    ]

    @iniSignals: [
        ['(^|\\n)\\s*\\[[^\\]\\n]+\\]\\s*$' 3]
        ['(^|\\n)\\s*[\\w.-]+\\s*=\\s*\\S' 1.5]
        ['(^|\\n)\\s*[;#]\\s' 0.5]
    ]

    @plistSignals: [
        ['<key>|<dict>|<array>|<string>|<plist' 4]
        ['<\\?xml' 1]
    ]

    @swiftSignals: [
        ['(^|\\n)\\s*import\\s+(Foundation|UIKit|SwiftUI|AppKit)\\b' 5]
        ['(^|\\n)\\s*func\\s+\\w+\\s*\\(' 4]
        ['\\b(guard|if)\\s+let\\b' 3]
        ['->\\s*[A-Z]\\w*' 2]
        ['\\b(let|var)\\s+\\w+\\s*:\\s*[A-Z]\\w*' 3]
        ['@(IBOutlet|IBAction|objc|escaping|available)\\b' 3]
        ['\\b(String|Int|Bool|Double|Float|Array|Dictionary|Optional)\\b' 1.5]
        ['\\boverride\\s+func\\b' 2]
    ]

    @signalRegex: pattern ->

        fileutil.signalRegexes ?= {}
        fileutil.signalRegexes[pattern] ?= new RegExp(pattern, 'gm')
        fileutil.signalRegexes[pattern]

    @signalsFor: ext ->

        fileutil.signalsCache ?= {}
        ⮐ fileutil.signalsCache[ext] if fileutil.signalsCache[ext]

        sigs = []

        if ext == 'kode' ➜ sigs = sigs.concat fileutil.kodeSignals
        if ext == 'coffee' ➜ sigs = sigs.concat fileutil.coffeeSignals
        if ext in ['js' 'ts'] ➜ sigs = sigs.concat fileutil.jsSignals
        if ext == 'ts' ➜ sigs = sigs.concat fileutil.tsSignals
        if ext == 'py' ➜ sigs = sigs.concat fileutil.pySignals
        if ext in ['sh' 'bash'] ➜ sigs = sigs.concat fileutil.shellSignals
        if ext == 'fish' ➜ sigs = sigs.concat fileutil.fishSignals
        if ext in ['lua' 'kua'] ➜ sigs = sigs.concat fileutil.luaSignals
        if ext == 'zig' ➜ sigs = sigs.concat fileutil.zigSignals
        if ext in ['nim' 'kim'] ➜ sigs = sigs.concat fileutil.nimSignals
        if ext in ['cpp' 'hpp' 'cxx' 'mm' 'c' 'h' 'cs' 'frag' 'vert'] ➜ sigs = sigs.concat fileutil.cFamilySignals
        if ext in ['cpp' 'hpp' 'cxx'] ➜ sigs = sigs.concat fileutil.cppSignals
        if ext == 'c' ➜ sigs = sigs.concat fileutil.cSignals
        if ext == 'cs' ➜ sigs = sigs.concat fileutil.csSignals
        if ext == 'mm' ➜ sigs = sigs.concat fileutil.mmSignals
        if ext in ['html' 'htm'] ➜ sigs = sigs.concat fileutil.htmlSignals
        if ext == 'svg' ➜ sigs = sigs.concat(fileutil.htmlSignals).concat(fileutil.svgSignals)
        if ext == 'md' ➜ sigs = sigs.concat fileutil.mdSignals
        if ext in ['css' 'scss' 'sass' 'styl'] ➜ sigs = sigs.concat fileutil.cssSignals
        if ext in ['css' 'scss'] ➜ sigs = sigs.concat fileutil.cssBracedSignals
        if ext in ['scss' 'sass'] ➜ sigs = sigs.concat fileutil.scssSignals
        if ext == 'styl' ➜ sigs = sigs.concat fileutil.stylSignals
        if ext == 'json' ➜ sigs = sigs.concat fileutil.jsonSignals
        if ext in ['yml' 'yaml'] ➜ sigs = sigs.concat fileutil.yamlSignals
        if ext == 'ini' ➜ sigs = sigs.concat fileutil.iniSignals
        if ext == 'plist' ➜ sigs = sigs.concat fileutil.plistSignals
        if ext == 'swift' ➜ sigs = sigs.concat fileutil.swiftSignals

        fileutil.signalsCache[ext] = sigs
        sigs

    @looksLikeKode: text ->

        for marker in ['⮐' '◆' '▪' '■' '□' '➜']
            ⮐ true if text.includes marker

        ⮐ true if /(^|\n)\s*log\s+/.test text
        ⮐ true if /(^|\n)\s*use\s+/.test text
        ⮐ true if /(^|\n)\s*@\w*\s*:/.test text

        false

    @looksLikeJSON: text ->

        s = trim text
        ⮐ false if empty s
        ⮐ false if s[0] not in ['{' '[']

        try
            JSON.parse s
            ⮐ true
        catch err
            ⮐ false

    @detectTokens: text ->

        tokens = []
        seen   = {}
        i      = 0
        n      = text.length

        while i < n

            c = text[i]

            if c in ['"' "'" '`']

                quote = c
                i += 1

                while i < n
                    if text[i] == '\\'
                        i += 2
                    else if text[i] == quote
                        i += 1
                        break
                    else
                        i += 1

                continue

            if c == '/' and text[i+1] == '/'
                while i < n and text[i] != '\n'
                    i += 1
                continue

            if c == '/' and text[i+1] == '*'
                i += 2
                while i < n and not (text[i] == '*' and text[i+1] == '/')
                    i += 1
                i += 2
                continue

            if c == '#'
                while i < n and text[i] != '\n'
                    i += 1
                continue

            if c == '@' and i+1 < n and /[A-Za-z_]/.test(text[i+1])

                j = i+2
                while j < n and /[A-Za-z0-9_]/.test(text[j])
                    j += 1

                word = text[i...j]

                if not seen[word]
                    seen[word] = true
                    tokens.push word

                i = j
                continue

            if /[A-Za-z_$]/.test(c)

                j = i+1

                while j < n and /[A-Za-z0-9_$]/.test(text[j])
                    j += 1

                word   = text[i...j]
                before = i > 0 ? text[i-1] : ''

                if word.length > 1 and before != '.' and not seen[word]
                    seen[word] = true
                    tokens.push word

                i = j
                continue

            i += 1

        tokens

    @detectExt: text ->

        ⮐ 'kode' if empty text
        ⮐ 'kode' if @looksLikeKode text
        ⮐ 'json' if @looksLikeJSON text

        tokens = @detectTokens text

        detectedExts = exts.filter (ext) -> ext not in ['txt' 'log']
        n            = detectedExts.length
        scores       = {}
        wordCounts   = {}
        signalCounts = {}

        for token in tokens

            owners = []

            for ext in detectedExts
                words = lang[ext]
                owners.push ext if words and words.hasOwnProperty token

            continue if empty owners

            weight = Math.log((n+1)/owners.length)

            for ext in owners
                cls = lang[ext][token]
                classWeight = fileutil.detectClassWeights[cls] ? 0.5
                scores[ext] ?= 0
                scores[ext] += weight * classWeight
                wordCounts[ext] ?= 0
                wordCounts[ext] += 1

        for ext in detectedExts

            for sig in fileutil.signalsFor ext
                matches = text.match(fileutil.signalRegex(sig[0]))
                continue if not matches
                scores[ext] ?= 0
                scores[ext] += sig[1] * min(matches.length 3)
                signalCounts[ext] ?= 0
                signalCounts[ext] += 1

        bestScore  = 0
        candidates = []

        for ext in detectedExts

            score       = scores[ext] ? 0
            wordCount   = wordCounts[ext] ? 0
            signalCount = signalCounts[ext] ? 0

            continue if wordCount <= 1 and signalCount == 0

            if score > bestScore + 0.000001
                bestScore = score
                candidates = [ext]
            else if score > 0 and Math.abs(score-bestScore) <= 0.000001
                candidates.push ext

        ⮐ 'kode' if bestScore < 1
        ⮐ candidates[0] if candidates.length

        'kode'

    @swapLastDir: path from to ->

        lastIndex = path.lastIndexOf "/#{from}/"
        if lastIndex >= 0
            path = path[..lastIndex] + to + path[lastIndex+("/#{from}").length..]
        path
        
    # paths that exist as files, made absolute, symlinks resolved, duplicates removed
    @existingFiles: paths cwd ◯->

        cwd ?= process.cwd()

        files = []

        for path in paths

            absFile = slash.absolute path cwd

            continue if absFile in files

            exists =◯ nfs.fileExists absFile
            continue if not exists

            absFile =◯ nfs.resolveSymlink absFile
            continue if empty absFile

            continue if absFile in files

            files.push absFile

        files

    @trash: path ◯->
    
        ◯ nfs.trash path
        
    @class: name ◯->
    
        currentDir = slash.dir ked_session.get('editor▸file')
        currentDir ?= process.cwd()
        file       = slash.path currentDir "#{name}.kode"
        
        ◯ nfs.write file """
            ###
            #{salter(name prepend:'    ')}
            ###
            
            function #{name}
            
                @: ->
                
            export #{name}
            
            """ 
            
        post.emit 'file.open' file 6 'eol'
        
    @newFolder: parent ◯->
    
        dir = slash.path parent 'new_folder'
        res =◯ nfs.mkdir dir
        if res == dir
            post.emit 'redraw'
        
    @rename: oldPath newPath ◯->
        
        ⮐ if oldPath == newPath
        
        res =◯ nfs.move oldPath newPath
        if res != newPath
            error "rename failed! #{res}"
    
    @duplicate: path ◯->
        
        res =◯ nfs.duplicate path
        if res
            post.emit 'redraw'
        
post.on 'file.trash'      fileutil.trash
post.on 'file.class'      fileutil.class
post.on 'file.rename'     fileutil.rename
post.on 'file.duplicate'  fileutil.duplicate
post.on 'file.new_folder' fileutil.newFolder

export fileutil
