###
    ███   ███  ████████  ███████    
    ███  ███   ███       ███   ███  
    ███████    ███████   ███   ███  
    ███  ███   ███       ███   ███  
    ███   ███  ████████  ███████    
###

use ../kxk        ▪ karg kstr kseg slash post nfs sleep
use ./index       ◆ prjcts indexer
use ./util        ◆ logfile session help frecent watcher git config
use ./util/img    ◆ rounded squares sircels
use ./edit/tool   ◆ belt
use ./edit        ◆ mode
use ./edit/mode   ◆ filepos
use ./view/base   ◆ view input
use ./view/title  ◆ title 
use ./view/editor ◆ fileeditor
use ./view/screen ◆ screen ttio
use ./view/menu   ◆ context menu macro finder searcher differ vinder
use ./view/colmns ◆ browse dircol funcol quicky droop saveas
use child_process ▪ spawn exec

function KED

    @: ->

        @version = '0.9.0'
        @args = karg """
            
            ked [file]
                options                                       **
                new        start with empty buffer          = false
                fresh      don't load previous session      = false
                timeout    session save timeout in ms       = 1000
                version    log version                      = false
                headless   run without a terminal           = false -H
                colors     headless with terminal colors    = false -C
                
            """ preHelp:help.header() version:@version
        
        process.on 'uncaughtException' @quit
        @session = new session @args
        @logfile = new logfile @session.name (@args.headless or @args.colors)
        
        log w2("┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ #{b8 @session.name} ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓")
        
        config.load()

        global.ked_session = @session
        
        @t = new ttio headless:(@args.headless or @args.colors)
        
        @screen   = new screen @t
        
        global.ked_screen = @screen
        @indexer  = new indexer
        @git      = new git
        
        @menu     = new menu       @screen        
        @macro    = new macro      @screen        
        @quicky   = new quicky     @screen 
        @browse   = new browse     @screen 
        @saveas   = new saveas     @screen 
        @editor   = new fileeditor @screen 'editor'
        @droop    = new droop      @screen @editor 
        @dircol   = new dircol     @screen @editor  ['scroll' 'knob']
        @funcol   = new funcol     @screen @editor  ['scroll' 'knob']
        @finder   = new finder     @screen @editor
        @searcher = new searcher   @screen @editor
        @vinder   = new vinder     @screen @editor
        @differ   = new differ     @screen @editor
        @title    = new title      @screen @editor
        @context  = new context    @screen
        @input    = new input      @screen 'ked_input'

        @input.on 'action' @onInputAction
        
        @editor.state.hasFocus = true
        @editor.funtree = @funcol.funtree
        
        post.on 'redraw'        @redraw
        post.on 'window.focus'  @redraw
        post.on 'window.blur'   @redraw
        post.on 'input.popup'   @onInputPopup
        post.on 'view.size'     @onViewSize
        post.on 'quicky'        @onQuicky
        post.on 'file.new'      @newFile
        post.on 'file.reload'   @reloadFile
        post.on 'file.open'     @openFile
        post.on 'file.save'     @saveFile
        post.on 'file.saveAndQuit' @saveAndQuit
        post.on 'file.saveas'   @onSaveAs
        post.on 'quit'          @quit
        post.on 'file.change'   @onFileChange
        post.on 'git.status'    @onGitStatus
        # post.on 'focus'         (name) -> log "focus: '#{name}'"
        
        @contextHandlers = [                                                                                               @editor         @dircol @funcol ]
        @mouseHandlers   = [ @input @context @finder @searcher @vinder @differ @quicky @browse @saveas @droop @menu @macro @editor @title  @dircol @funcol ]
        @wheelHandlers   = [                 @finder @searcher @vinder @differ @quicky @browse @saveas @droop       @macro @editor         @dircol @funcol ]
        @keyHandlers     = [ @input @context @finder @searcher @vinder @differ @quicky @browse @saveas @droop @menu @macro @editor         @dircol @funcol ]
        
        @t.on 'key'    @onKey
        @t.on 'mouse'  @onMouse
        @t.on 'resize' @onResize
        @t.on 'paste'  @onPaste
                                    
        log 'ked cwd:'  process.cwd()
        log 'ked args:' @args
        
        ked_session.set 'ked▸args' @args
        
        if valid @args.options
            [file line column] = slash.splitFileLine @args.options[0]
            if line
               post.emit 'file.open' file line-1 column-1
            else
                @currentLoad = @loadFile file
        else if @args.fresh
            @hideEditor()
            @menu.show true
        else if @args.new
            @newFile()
            
        @startup()
            
    showEditor: -> 
    
        @editor.show()
        @title.show()
        @dircol.show()
        @funcol.show()

    hideEditor: -> 
    
        @editor.hide()
        @title.hide()
        @dircol.hide()
        @funcol.hide()
        
    # ████████   ███   ███  ███   ███  
    # ███   ███  ███   ███  ████  ███  
    # ███████    ███   ███  ███ █ ███  
    # ███   ███  ███   ███  ███  ████  
    # ███   ███   ███████   ███   ███  
    
    @run: ○->
        
        ked = new KED
        
        ○ ked.runHeadless() if ked.args.headless or ked.args.colors
        
        ked

    restart: =>
        
        cmd  = slash.path ◆dir '../../bin/ked_restart'
        args = [process.pid process.execPath].concat process.argv.slice(1)
        proc = spawn cmd args {stdio:"inherit" detached:true shell:true}
        proc.unref()
        
    # ███   ███  ████████   ███████   ███████    ███      ████████   ███████   ███████
    # ███   ███  ███       ███   ███  ███   ███  ███      ███       ███       ███     
    # █████████  ███████   █████████  ███   ███  ███      ███████   ███████   ███████ 
    # ███   ███  ███       ███   ███  ███   ███  ███      ███            ███       ███
    # ███   ███  ████████  ███   ███  ███████    ███████  ████████  ███████   ███████ 
    
    #  the headless mode: the editor runs without a terminal
    #  input keys come from the standard input, and the screen is dumped for each key
    
    runHeadless: ○=>
        
        ended = new Promise (resolve) =>
            @t.on 'end' resolve
        
        ○ @currentLoad if @currentLoad
        
        if @t.input
            ○ ended
        
        #  wait for the startup work the editor needs, instead of guessing
        #  how long it takes
        
        ○ config.loaded if config.loaded
        ○ mode.loaded
        
        @dump 'start'
        
        for step in @t.steps()
            
            @t.play step[1]
            
            ○ @currentLoad if @currentLoad
            ○ sleep 50
            
            @dump step[0]
        
        @quit()
    
    dump: label =>
        
        @draw()
        
        process.stdout.write "\n=== #{label}\n"
        
        if @args.colors
            process.stdout.write @screen.textColored().join('\n') + '\n'
        else
            process.stdout.write @screen.textMarked().join('\n') + '\n'

    #  ███████  ████████   ███████   ███████  ███   ███████   ███   ███
    # ███       ███       ███       ███       ███  ███   ███  ████  ███
    # ███████   ███████   ███████   ███████   ███  ███   ███  ███ █ ███
    #      ███  ███            ███       ███  ███  ███   ███  ███  ████
    # ███████   ████████  ███████   ███████   ███   ███████   ███   ███

    startup: ○=>
        
        ○ config.loaded if config.loaded
        ○ @session.loaded
        
        ⮐  if @args.fresh
        ⮐  if @args.new
        
        if empty @currentFile and empty @loadingFile
            if file = ked_session.get "editor▸file"
                log "no current or loading file ... loading last session #{file}"
                @loadFile file
            else
                @hideEditor()
                @menu.show true
                
    #  ███████   ████████   ████████    ███████   ███   ███   ███████   ████████
    # ███   ███  ███   ███  ███   ███  ███   ███  ████  ███  ███        ███     
    # █████████  ███████    ███████    █████████  ███ █ ███  ███  ████  ███████ 
    # ███   ███  ███   ███  ███   ███  ███   ███  ███  ████  ███   ███  ███     
    # ███   ███  ███   ███  ███   ███  ███   ███  ███   ███   ███████   ████████

    arrange: =>
        
        w = @t.cols()
        h = @t.rows()
        
        dcw = @dircol.cells.cols
        fcw = @funcol.cells.cols
        
        dcw = 0 if @dircol.hidden() or not @dircol.active
        fcw = 0 if @funcol.hidden() or not @funcol.active
        
        if @viewSizeDelta
            switch @viewSizeDelta.name
                @dircol.name ➜ dcw = @dircol.cells.cols + @viewSizeDelta.delta
                @funcol.name ➜ fcw = @funcol.cells.cols + @viewSizeDelta.delta
            delete @viewSizeDelta
        
        @dircol.layout  0     0  dcw        h    if @dircol.visible() and @dircol.active
        @funcol.layout  w-fcw 1  fcw        h-1  if @funcol.visible() and @funcol.active
        @title.layout  dcw   0  w-dcw      1
        @editor.layout  dcw   1  w-dcw-fcw  h-1
    
    #  ███████   ███   ███  ███  █████████
    # ███   ███  ███   ███  ███     ███   
    # ███ ██ ██  ███   ███  ███     ███   
    # ███ ████   ███   ███  ███     ███   
    #  █████ ██   ███████   ███     ███   

    quit: msg ○=>
        
        watcher.close()
        clearImmediate @redrawId
        @quitting = true
        
        ○ @session.save()
        
        log w2("┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ #{b8 @session.name} ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛")

        if msg?
            error msg.stack if msg.stack
            error "#{y5 msg}"
        
        @t?.detach()
        
        @logfile.close =>
            
            # process.stderr.write "#{r4 msg.stack}\n" if msg?.stack
            # process.stderr.write "#{y5 msg}" if msg?
            process.exit msg? ? 1 : 0
            
    # ███   ███  ████████  ███   ███  
    # ████  ███  ███       ███ █ ███  
    # ███ █ ███  ███████   █████████  
    # ███  ████  ███       ███   ███  
    # ███   ███  ████████  ██     ██  
    
    newFile: =>
        
        delete @currentFile

        @title.setFile ''
    
        @editor.state.syntax.ext = 'txt'
        @editor.state.loadLines ['']

#         @editor.cells.meta_pre 0 0 '\x1b]66;n=1:d=5:w=1;'
#         @editor.cells.meta_pst 0 0 '\x07'
#         
#         @editor.cells.meta_pre 1 0 '\x1b]66;n=3:d=4:w=1;'
#         @editor.cells.meta_pst 1 0 '\x07'
        
        @t.setCursor 0 0
        @t.setTitle 'kėd'
        
        @editor.mapscr?.reload()
        
        post.emit 'file.loaded' null

        @showEditor()
        
        @editor.grabFocus()
        
        @redraw()
            
    # ████████  ███  ███      ████████   ███████  ███   ███   ███████   ███   ███   ███████   ████████
    # ███       ███  ███      ███       ███       ███   ███  ███   ███  ████  ███  ███        ███     
    # ██████    ███  ███      ███████   ███       █████████  █████████  ███ █ ███  ███  ████  ███████ 
    # ███       ███  ███      ███       ███       ███   ███  ███   ███  ███  ████  ███   ███  ███     
    # ███       ███  ███████  ████████   ███████  ███   ███  ███   ███  ███   ███   ███████   ████████

    onFileChange: event =>
    
        if event.path == @currentFile
            switch event.change
                'delete' ➜ @newFile() # todo: load current text into new file
                'change'
                'rename' ➜ @reloadFile()
                
        ⮐ if KED.building
        ⮐ if @args.headless
        
        if event.change == 'rename' and slash.ext(event.path) == 'kode'        
            # log "src change?" event
            if event.path.startsWith slash.path(◆dir '../../kode/ked')
                KED.building = true
                # log "building"
                kk = slash.path ◆dir '../../kk'
                # exec "#{kk} -k" {shell:true} (err stdout stderr) => 
                exec "#{kk} -k" {} (err stdout stderr) => 
                    if empty err
                        exec "#{kk} -t ked" {} (err stdout stderr) => 
                            if empty err
                                @restart()
                                @quit()
                            else
                                log err stdout stderr
                                KED.building = false
                    else
                        log err stdout stderr
                        KED.building = false
            
    onGitStatus: => git.diff @currentFile
        
    # ████████   ████████  ███       ███████    ███████   ███████  
    # ███   ███  ███       ███      ███   ███  ███   ███  ███   ███
    # ███████    ███████   ███      ███   ███  █████████  ███   ███
    # ███   ███  ███       ███      ███   ███  ███   ███  ███   ███
    # ███   ███  ████████  ███████   ███████   ███   ███  ███████  

    reloadFile: => 
        
        if valid @currentFile
            @loadFile @currentFile
        else
            @newFile()
            
    #  ███████   ████████   ████████  ███   ███  
    # ███   ███  ███   ███  ███       ████  ███  
    # ███   ███  ████████   ███████   ███ █ ███  
    # ███   ███  ███        ███       ███  ████  
    #  ███████   ███        ████████  ███   ███  
    
    openFile: path row col view =>
        
        @currentLoad = @loadFile path row col view
        @editor.grabFocus()
        
    #  ███████   ███   ███  ███   ███████  ███   ███  ███   ███  
    # ███   ███  ███   ███  ███  ███       ███  ███    ███ ███   
    # ███ ██ ██  ███   ███  ███  ███       ███████      █████    
    # ███ ████   ███   ███  ███  ███       ███  ███      ███     
    #  █████ ██   ███████   ███   ███████  ███   ███     ███     
    
    onQuicky: path ○=>
        
        ⮐  if valid @loadingFile
        
        if slash.isAbsolute path
            file = path
        else
            file = slash.absolute path slash.dir(@currentFile)
        
        ⮐  if slash.samePath(file @currentFile)
        
        ○ @loadFile file
                                
    # ███       ███████    ███████   ███████          ████████  ███  ███      ████████
    # ███      ███   ███  ███   ███  ███   ███        ███       ███  ███      ███     
    # ███      ███   ███  █████████  ███   ███        ██████    ███  ███      ███████ 
    # ███      ███   ███  ███   ███  ███   ███        ███       ███  ███      ███     
    # ███████   ███████   ███   ███  ███████          ███       ███  ███████  ████████

    loadFile: p row col view ○=>
    
        # log "ked.loadFile #{p} #{row} #{col} #{@loadingFile}"
        
        start = process.hrtime()
        
        if slash.isAbsolute p
            absFile = slash.absolute p
        else
            absFile = slash.path process.cwd() p

        #  a reload keeps what is on screen instead of what was last stored in the session
        reload = valid @currentFile and not row? and slash.samePath absFile @currentFile

        if reload
            reloadCursor = @editor.state.mainCursor()
            reloadView   = @editor.state.s.view.asMutable()

        ⮐  if slash.samePath absFile @loadingFile
        
        # log "ked.loadFile absFile #{absFile}"
        
        @loadingFile = absFile
        
        #  the file is opened once the config and the modes are there:
        #  both decide what happens to it, and neither is loaded yet
        
        ○ config.loaded if config.loaded
        ○ mode.loaded
        
        exists =○ nfs.fileExists @loadingFile
        
        if not exists
            warn "ked.loadFile - file doesn't exist! #{@loadingFile}"
            delete @loadingFile
            ⮐ 
        
        @loadingFile =○ nfs.resolveSymlink @loadingFile
        
        if empty @loadingFile
            warn "ked.loadFile - #{absFile} resolved to empty!"
            ⮐  
        
        ▴ 'loadingFile' @loadingFile
        
        readingFile = @loadingFile
        
        text =○ nfs.readText @loadingFile
        
        if @loadingFile != readingFile
            # warn 'another file started loading, skip editor update'
            ⮐  
        
        @currentFile = @loadingFile
        
        ▴ 'currentFile' @currentFile
        
        delete @loadingFile
        
        @title.setFile slash.tilde(@currentFile)
                
        if text == undefined
            text = '○ binary ○'
        
        [colors segls] = belt.colorSeglsForText text
        
        if valid colors
            @editor.state.syntax.setColors colors
        else
            ext = config.data.filetypes[slash.file(@currentFile)]
            ext ?= slash.ext(@currentFile)
            @editor.state.syntax.setExt ext
        
        @editor.state.loadSegls segls
        @editor.setCurrentFile @currentFile     
        ked_session.set "editor▸file" @currentFile
        
        @title.time = process.hrtime(start)[1]
        
        if reload
            @editor.state.setView reloadView
            @editor.state.setCursors [reloadCursor] adjust:false
        else
            mode.fileLoaded @editor.state @currentFile row col view
        
        post.emit 'file.loaded' @currentFile
        
        if config.data?.novim?.autoStart
            if not mode.isActive @editor.state 'novim'
                @editor.state.toggleMode 'novim'
        
        @showEditor()
        @redraw()
        
        @indexer.index @currentFile
        prjcts.index   @currentFile
        git.diff       @currentFile
        
        watcher.watch  @currentFile
                
        @t.setTitle slash.file(@title.file)
        
        @saveSessionFile @currentFile 'loaded'        
        
        if gitDir =○ git.dir @currentFile
            watcher.watch slash.path(gitDir '.git/refs/heads') recursive:false
            
        @
                    
    #  ███████   ███████   ███   ███  ████████  
    # ███       ███   ███  ███   ███  ███       
    # ███████   █████████   ███ ███   ███████   
    #      ███  ███   ███     ███     ███       
    # ███████   ███   ███      █      ████████  
    
    saveFile: ○=>
        
        text = kseg.str @editor.state.s.lines
        
        if valid @currentFile
            ○ nfs.write @currentFile text
            @editor.state.clearHistory() # lazy way to 'undirty' :> no undo after save :(
            @redraw()
            @saveSessionFile @currentFile 'saved'
            
    saveAndQuit: ○=>

        ○ @saveFile()

        @quit()
            
    saveSessionFile: file type =>
        
        frecent.fileAction file type
                
        @session.set 'files▸recent' frecent.store('file')
            
    saveAs: =>
        
        dir = process.cwd()
        file = ''
        
        if valid @currentFile
            dir = slash.dir @currentFile
            file = slash.file @currentFile
        
        @saveas.showDialog dir file
    
    onSaveAs: path ○=>
        
        text = kseg.str @editor.state.s.lines
        
        ○ nfs.write path text
        
        @editor.state.clearHistory()
        
        @currentFile = path
        
        @title.setFile slash.tilde(path)
        @t.setTitle slash.file(path)
        
        ked_session.set 'editor▸file' path
        @editor.setCurrentFile path
        
        @editor.state.syntax.setExt slash.ext(path)
        @editor.state.syntax.clear()
        @editor.state.syntax.setSegls @editor.state.s.lines
        
        @indexer.index path
        prjcts.index path
        git.diff path
        
        watcher.watch path
        
        @saveSessionFile path 'saved'
        
        @redraw()
    
    # ████████    ███████    ███████  █████████  ████████  
    # ███   ███  ███   ███  ███          ███     ███       
    # ████████   █████████  ███████      ███     ███████   
    # ███        ███   ███       ███     ███     ███       
    # ███        ███   ███  ███████      ███     ████████  
    
    onPaste: text => 
    
        @editor.state.insert text
        @redraw()
                                    
    # ██     ██   ███████   ███   ███   ███████  ████████  
    # ███   ███  ███   ███  ███   ███  ███       ███       
    # █████████  ███   ███  ███   ███  ███████   ███████   
    # ███ █ ███  ███   ███  ███   ███       ███  ███       
    # ███   ███   ███████    ███████   ███████   ████████  
    
    onMouse: event =>

        if event.type == 'wheel'

            for handler in @wheelHandlers
                if ret = handler.onWheel event
                    if ret.redraw == true
                        @redraw()
                    ⮐ 
            ⮐ 

        redraw = false
        
        for handler in @mouseHandlers
        
            if ret = handler.onMouse event
                event.handled = true
                if ret.redraw == true
                    redraw = true
                break if event.type != 'move' or handler.isPopup

        if event.button == 'right' and event.type == 'press' and event.count == 1
            
            for handler in @contextHandlers
                continue if not handler.hover
                if ret = handler.onContext event
                    if ret.redraw == true
                        redraw = true
                    break

        @redraw() if redraw
        
    showFinderOrSearcher: =>
    
        if @finder.visible() and valid @finder.input.current()
            @searcher.show @finder.input.current()
        else
            @finder.show()
            
    showFileposHistory: =>
    
        if filepos.fileposl.length > 1

            files = filepos.fileposl.map (fp) -> fp[0]
            files = files.reverse()
            files.shift() if filepos.offset == 0
            scx = int @screen.cols/2
            scy = int @screen.rows/2
            post.emit 'droop.show' files:files pos:[scx scy-6]
                
    # ███   ███  ████████  ███   ███  
    # ███  ███   ███        ███ ███   
    # ███████    ███████     █████    
    # ███  ███   ███          ███     
    # ███   ███  ████████     ███     
    
    onKey: key event =>
    
        # log 'ked.onKey' event
            
        switch key
            
            'alt+1'                      ➜ ⮐  post.emit 'filepos.goBackward'  
            'alt+2'                      ➜ ⮐  post.emit 'filepos.goForward'   
            'cmd+1' 'ctrl+1'             ➜ ⮐  post.emit 'filepos.swapPrevious'
            'alt+h'                      ➜ ⮐  @showFileposHistory()
            'alt+q' 'ctrl+q' 'cmd+q'     ➜ ⮐  @quit()
            'ctrl+r' 'cmd+r'             ➜ ⮐  @reloadFile()
            'ctrl+s' 'cmd+s'             ➜ ⮐  @saveFile()
            'shift+cmd+s' 'shift+ctrl+s' ➜ ⮐  @saveAs()
            'cmd+n' 'ctrl+n'             ➜ ⮐  @newFile()
            'alt+m'                      ➜ ⮐  @menu.show()
            'cmd+p' 'ctrl+p'             ➜ ⮐  @quicky.showProjectFiles @currentFile
            'shift+cmd+p' 'shift+ctrl+p' ➜ ⮐  @quicky.showRecentFiles @currentFile
            'cmd+f' 'ctrl+f'             ➜ ⮐  @showFinderOrSearcher()
            'shift+cmd+f' 'shift+ctrl+f' ➜ ⮐  @searcher.show()
            'alt+o'                      ➜ ⮐  @editor.jumpToCounterpart()
            'alt+,'                      ➜ ⮐  @editor.singleCursorAtLine @funcol.funtree.lineIndexOfPrevFunc()
            'alt+.'                      ➜ ⮐  @editor.singleCursorAtLine @funcol.funtree.lineIndexOfNextFunc()
            'cmd+m' 'cmd+;' 'ctrl+;'     ➜ ⮐  @macro.show()
            'cmd+.' 'ctrl+.'             ➜ ⮐  @browse.gotoDir slash.dir(@currentFile)
            'cmd+o' 'ctrl+o'             ➜ ⮐  post.emit 'browse.dir' process.cwd()
            'cmd+i'                      ➜ ⮐  post.emit 'differ.status'
            'alt+r'                      ➜ ⮐  post.emit 'dircol.reveal' @currentFile
            'cmd+\\' 'ctrl+\\'           ➜ ⮐  post.emit 'dircol.toggle'
            "cmd+'" "ctrl+'"             ➜ ⮐  post.emit 'funcol.toggle'
            "alt+\\"                     ➜ ⮐  post.emit 'dircol.focus'
            "alt+'"                      ➜ ⮐  post.emit 'funcol.focus'
            
        for handler in @keyHandlers
            # ●▸ on key
            continue if handler.hidden()
            break if result = handler.onKey key event
            # ●▪ on key
                
        @redraw() if result?.redraw != false
        
    #  ███████  ███  ███████  ████████  
    # ███       ███     ███   ███       
    # ███████   ███    ███    ███████   
    #      ███  ███   ███     ███       
    # ███████   ███  ███████  ████████  
    
    onViewSize: name side delta =>
        
        @viewSizeDelta = name:name side:side delta:delta
        @redraw()
        
    onResize: cols rows size cellsz => 
    
        mcw = int cols/6
        
        rounded.cache = {}
        
        if mcw >= 16
            @dircol.cells.cols = mcw
            @funcol.cells.cols = mcw
            @dircol.show()
            @funcol.show()
        else
            @dircol.hide()
            @funcol.hide()
        
        squares.onResize cols rows size cellsz
        sircels.onResize cols rows size cellsz
        @redraw()
        @editor.mapscr?.onResize()
        
    # ███  ███   ███  ████████   ███   ███  █████████       ████████    ███████   ████████   ███   ███  ████████ 
    # ███  ████  ███  ███   ███  ███   ███     ███          ███   ███  ███   ███  ███   ███  ███   ███  ███   ███
    # ███  ███ █ ███  ████████   ███   ███     ███          ████████   ███   ███  ████████   ███   ███  ████████ 
    # ███  ███  ████  ███        ███   ███     ███          ███        ███   ███  ███        ███   ███  ███      
    # ███  ███   ███  ███         ███████      ███          ███         ███████   ███         ███████   ███      

    onInputPopup: opt =>
    
        @input.set opt.text
        @input.state.moveCursors 'eol'
        @input.layout opt.x opt.y opt.w 1
        @input.grabFocus()
        @input.orig = opt.text
        @input.cb = opt.cb
        @redraw()
        
    onInputAction: action event =>
    
        # log "ked.onInputAction #{action} #{event}"
        switch action
            'submit'
                if @input.cb is func
                    @input.cb @input.current()
                @input.hide()
            'cancel'
                if @input.cb is func
                    @input.cb @input.orig
                @input.hide()
    
    # ███████    ████████    ███████   ███   ███
    # ███   ███  ███   ███  ███   ███  ███ █ ███
    # ███   ███  ███████    █████████  █████████
    # ███   ███  ███   ███  ███   ███  ███   ███
    # ███████    ███   ███  ███   ███  ██     ██

    redraw: =>    
        
        ⮐  if @quitting

        clearImmediate @redrawId
        @redrawId = setImmediate @draw
                                      
    draw: =>
            
        ⮐  if @quitting
        
        # ● sum
        
        start = process.hrtime()
        
        @title.gutter = @editor.state.gutterWidth()
        
        @screen.init()
        
        @arrange()
        
        # ●▸ draw
        if @menu.greet.hidden()
            @editor.draw() if not @differ.visible()
            @title.draw()
            @dircol.draw()
            @funcol.draw()
            
        @menu.draw()
        @macro.draw()
        @quicky.draw()
        @browse.draw()
        @saveas.draw()
        @droop.draw()
        @finder.draw()
        @searcher.draw()
        @vinder.draw()
        @differ.draw()
        @context.draw()
        @input.draw()
        # ●▪ draw
        # ●▸ render
        @screen.render()
        @t.removeImgs()
        # ●▪ render
        
        @title.time = process.hrtime(start)[1]
        
export KED.run

◆main
    KED.run()

