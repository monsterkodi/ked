■fill

    @pattern: conf region ->

        cells = Array.from(conf.pattern ? '')
        ⮐ @blanks(region) if empty cells

        n = cells.length
        out = []

        for rng in region

            width = rng[2] - rng[0]

            if width <= 0
                out.push ''
                continue

            row = ''
            for i in 0...width
                row += cells[((rng[0] + i) % n + n) % n]

            out.push row

        out

    #  [y x1 x2] of every span a block of conf.scale rows fits into, in flow order

    @bands: conf region rect ->

        scale = max 1 int(conf.scale ? 1)
        rows  = {}

        for rng in region
            rows[rng[1]] = [] if not rows[rng[1]]?
            rows[rng[1]].push [rng[0] rng[2]]

        out = []

        for b in 0...floor(rect.h / scale)

            y     = rect.y + b*scale
            spans = rows[y] ? []

            for k in 1...scale
                spans = @intersect spans (rows[y+k] ? [])

            for [x1 x2] in spans
                out.push [y x1 x2] if x2 - x1 >= scale

        out


    @intersect: a b ->

        out = []

        for [a1 a2] in a
            for [b1 b2] in b
                x1 = max a1 b1
                x2 = min a2 b2
                out.push [x1 x2] if x1 < x2

        out.sort (p q) -> p[0] - q[0]

    @blank: width ->

        row = []
        while row.length < width
            row.push ' '
        row.join('')

    @blanks: region ->

        out = []
        for rng in region
            out.push ''
        out

export fill
