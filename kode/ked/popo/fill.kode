■fill

    @pattern: conf region ->

        cells = Array.from(conf.pattern ? '')
        ⮐ @blanks(region) if empty cells

        n = cells.length
        out = []

        for rng in region

            width = rng[2] - rng[0]

            if width <= 0
                out.push ''
                continue

            row = ''
            for i in 0...width
                row += cells[((rng[0] + i) % n + n) % n]

            out.push row

        out

    @text: conf region ->

        cells = Array.from(conf.text ? '')
        scale = max 1 int(conf.scale ? 1)
        out   = []
        i     = 0
        lineY = null

        for rng in region

            width = rng[2] - rng[0]

            if width <= 0
                out.push ''
                continue

            y = rng[1]

            if valid lineY and y > lineY and y < lineY + scale
                out.push(@blank(width))
                continue

            lineY = y
            row   = []

            while row.length + scale <= width and i < cells.length

                if cells[i] == '\n'
                    i += 1
                    break

                row.push cells[i]
                i += 1

                for k in 1...scale
                    row.push ' '

            while row.length < width
                row.push ' '

            out.push(row.join(''))

        out

    @blank: width ->

        row = []
        while row.length < width
            row.push ' '
        row.join('')

    @blanks: region ->

        out = []
        for rng in region
            out.push ''
        out

export fill
