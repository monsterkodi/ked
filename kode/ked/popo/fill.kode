■fill

    @pattern: conf region ->

        cells = Array.from(conf.pattern ? '')
        ⮐ @blanks(region) if empty cells

        n = cells.length
        out = []

        for rng in region

            width = rng[2] - rng[0]

            if width <= 0
                out.push ''
                continue

            row = ''
            for i in 0...width
                row += cells[((rng[0] + i) % n + n) % n]

            out.push row

        out

    @text: conf region ->

        ⮐ [] if empty region

        ys    = region.map (rng) -> rng[1]
        chars = {}

        for [x y ch] in @flow(conf region {y:min(ys) h:max(ys)-min(ys)+1})
            chars["#{x},#{y}"] = ch if ch?

        out = []

        for rng in region
            row = ''
            for x in rng[0]...rng[2]
                row += chars["#{x},#{rng[1]}"] ? ' '
            out.push row

        out

    @scaled: conf region rect ->

        out = []

        for [x y ch] in @flow(conf region rect)
            out.push [x y ch] if ch?

        out

    #  [x y char offset] for every glyph, [x y null offset] behind the last glyph of a span

    @flow: conf region rect ->

        cells = Array.from(conf.text ? '')
        scale = max 1 int(conf.scale ? 1)
        rows  = {}

        for rng in region
            rows[rng[1]] = [] if not rows[rng[1]]?
            rows[rng[1]].push [rng[0] rng[2]]

        out  = []
        i    = 0
        tail = false

        for b in 0...floor(rect.h / scale)

            break if tail

            y     = rect.y + b*scale
            spans = rows[y] ? []

            for k in 1...scale
                spans = @intersect spans (rows[y+k] ? [])

            for [x1 x2] in spans

                continue if x2 - x1 < scale

                x  = x1
                nl = false

                while x + scale <= x2 and i < cells.length

                    if cells[i] == '\n'
                        nl = true
                        break

                    out.push [x y cells[i] i]
                    i += 1
                    x += scale

                out.push [x y null i]

                if nl
                    i += 1
                else if i >= cells.length
                    tail = true
                    break

        out

    @intersect: a b ->

        out = []

        for [a1 a2] in a
            for [b1 b2] in b
                x1 = max a1 b1
                x2 = min a2 b2
                out.push [x1 x2] if x1 < x2

        out.sort (p q) -> p[0] - q[0]

    @blank: width ->

        row = []
        while row.length < width
            row.push ' '
        row.join('')

    @blanks: region ->

        out = []
        for rng in region
            out.push ''
        out

export fill
