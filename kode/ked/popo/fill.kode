■fill

    @pattern: conf region ->

        cells = Array.from(conf.pattern ? '')
        ⮐ @blanks(region) if empty cells

        n = cells.length
        out = []

        for rng in region

            width = rng[2] - rng[0]

            if width <= 0
                out.push ''
                continue

            row = ''
            for i in 0...width
                row += cells[((rng[0] + i) % n + n) % n]

            out.push row

        out

    @text: conf region -> # unscaled text, one string per region

        cells = Array.from(conf.text ? '')
        out   = []
        i     = 0

        for rng in region

            width = rng[2] - rng[0]

            if width <= 0
                out.push ''
                continue

            row = []

            while row.length < width and i < cells.length

                if cells[i] == '\n'
                    i += 1
                    break

                row.push cells[i]
                i += 1

            while row.length < width
                row.push ' '

            out.push(row.join(''))

        out

    #  scaled text is laid out in logical lines of scale rows each
    #  a logical line may only use the columns that are free in all of its rows
    #  every glyph takes scale×scale cells, spaces included
    #  returns the top left cell of every glyph: [[x y char] ...]

    @scaled: conf region rect ->

        cells = Array.from(conf.text ? '')
        scale = max 1 int(conf.scale ? 1)
        rows  = {}

        for rng in region
            rows[rng[1]] = [] if not rows[rng[1]]?
            rows[rng[1]].push [rng[0] rng[2]]

        out = []
        i   = 0

        for b in 0...floor(rect.h / scale)

            y     = rect.y + b*scale
            spans = rows[y] ? []

            for k in 1...scale
                spans = @intersect spans (rows[y+k] ? [])

            for [x1 x2] in spans

                x = x1

                while x + scale <= x2 and i < cells.length

                    if cells[i] == '\n'
                        i += 1
                        break

                    out.push [x y cells[i]]
                    i += 1
                    x += scale

        out

    @intersect: a b ->

        out = []

        for [a1 a2] in a
            for [b1 b2] in b
                x1 = max a1 b1
                x2 = min a2 b2
                out.push [x1 x2] if x1 < x2

        out.sort (p q) -> p[0] - q[0]

    @blank: width ->

        row = []
        while row.length < width
            row.push ' '
        row.join('')

    @blanks: region ->

        out = []
        for rng in region
            out.push ''
        out

export fill
