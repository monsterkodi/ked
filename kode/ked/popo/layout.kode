■layout

    #  absolutize a rectree against the cells of its view
    #
    #  a rectree node is { x, y, w, h, r, b, children } with every value
    #  either in cells or a percentage of the containing box:
    #
    #      x y   offset from the top left corner of the box
    #      w h   extent
    #      r b   offset from the right or bottom edge of the box
    #
    #  w and h win over r and b, a node with neither fills the box.
    #  the result is clipped to the box and has no percentages or offsets
    #  left, its children are resolved inside the new box.

    @absolutize: cells rectree ->

        box = {x:0 y:0 w:cells.cols h:cells.rows}

        @inBox box rectree

    #  resolve one node inside box, then the children inside the result

    @inBox: box node ->

        ⮐ node if not node?

        x = clamp 0 box.w (@offset(box.w node.x))
        y = clamp 0 box.h (@offset(box.h node.y))

        w = clamp 0 (box.w-x) (@extent(box.w x node.w node.r))
        h = clamp 0 (box.h-y) (@extent(box.h y node.h node.b))

        out = @withoutGeometry node

        out.x = box.x + x
        out.y = box.y + y
        out.w = w
        out.h = h

        if node.children?
            inner = {x:out.x y:out.y w:w h:h}
            out.children = []
            for child in node.children
                out.children.push @inBox(inner child)

        out

    #  a value in cells: a number is cells, '20%' is percent of extent

    @offset: extent value ->

        ⮐ 0 if not valid value

        if value is str
            if value.endsWith '%'
                ⮐ int(extent * int(value[0...-1]) / 100)
            ⮐ int value

        value

    #  the extent of a node: w wins over r, a node with neither fills

    @extent: total start w r ->

        ⮐ @offset(total w) if valid w

        ⮐ total - start - (@offset(total r)) if valid r

        total - start

    #  a copy of node without the geometry keys, the caller sets those

    @withoutGeometry: node ->

        out = {}

        for key,value of node
            continue if key in ['x' 'y' 'w' 'h' 'r' 'b' 'children']
            out[key] = value

        out

export layout
