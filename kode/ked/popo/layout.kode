use ◆ fill
use ../edit/tool ◆ sue

■layout

    #  absolutize a rectree against the cells of its view
    #
    #  a rectree node is { x, y, w, h, r, b, children } with every value
    #  either in cells or a percentage of the containing box:
    #
    #      x y   offset from the top left corner of the box
    #      w h   extent
    #      r b   offset from the right or bottom edge of the box
    #
    #  a node gives x and y, one of w or r, one of h or b. a node with
    #  neither w nor r fills the box in width, the same holds for height.
    #  giving both w and r (or h and b) is an error, not a silent choice.
    #  the result is clipped to the box and has no percentages or offsets
    #  left, its children are resolved inside the new box.

    @absolutize: cells rectree ->

        box = {x:0 y:0 w:cells.cols h:cells.rows}

        @inBox box rectree

    #  resolve one node inside box, then the children inside the result

    @inBox: box node ->

        ⮐ node if not node?

        if node.w? and node.r?
            throw new Error "layout: w and r are both given"

        if node.h? and node.b?
            throw new Error "layout: h and b are both given"

        x = clamp 0 box.w (@offset(box.w node.x))
        y = clamp 0 box.h (@offset(box.h node.y))

        w = clamp 0 (box.w-x) (@extent(box.w x node.w node.r))
        h = clamp 0 (box.h-y) (@extent(box.h y node.h node.b))

        out = @withoutGeometry node

        out.x = box.x + x
        out.y = box.y + y
        out.w = w
        out.h = h

        if node.children?
            inner = {x:out.x y:out.y w:w h:h}
            out.children = []
            for child in node.children
                out.children.push @inBox(inner child)

        out

    #  a value in cells: a number is cells, '20%' is percent of extent

    @offset: extent value ->

        ⮐ 0 if not valid value

        if value is str
            if value.endsWith '%'
                ⮐ int(extent * int(value[0...-1]) / 100)
            ⮐ int value

        value

    #  the extent of a node: w or r, a node with neither fills

    @extent: total start w r ->

        ⮐ @offset(total w) if valid w

        ⮐ total - start - (@offset(total r)) if valid r

        total - start

    #  a copy of node without the geometry keys, the caller sets those

    @withoutGeometry: node ->

        out = {}

        for key,value of node
            continue if key in ['x' 'y' 'w' 'h' 'r' 'b' 'children']
            out[key] = value

        out
        
    #  resolve the rects and give every node the cells its content may use:
    #  its rect, minus the blockers that overlap it.
    #
    #  a node with content (text, pattern, image) is a flow and is cut by
    #  blockers, a node that only paints colours keeps its whole rect, and
    #  flows:false opts any node out.
    #
    #  a blocker is a node with blocks:true. it cuts every flow it overlaps,
    #  except the flows it is nested in: text inside an image draws on the
    #  image instead of flowing around it. the test uses rects, not regions:
    #  a region that depended on the blockers it intersects could not be
    #  resolved without a cycle.

    @regionize: cells rectree ->

        ⮐ null if not rectree?

        root = @absolutize cells rectree

        @addRegions(root (@blockersIn(root)) [])
        
        # log @dumpRegions(root)

        root

    @blockersIn: node ->

        found = []

        found.push node if node.blocks and node.w > 0 and node.h > 0

        for child in node.children ? []
            for entry in @blockersIn child
                found.push entry

        found

    @addRegions: node blockers ancestors ->

        node.regions = @intervalsOf node

        if @flows node
            for blocker in blockers
                continue if blocker == node
                continue if blocker in ancestors
                node.regions = @cutBy(node.regions blocker)

        for child in node.children ? []
            @addRegions(child blockers ancestors.concat([node]))

    #  a node flows when it has content that is placed cell by cell

    @flows: node ->

        ⮐ false if node.flows == false

        valid node.text or valid node.pattern or valid node.image

    #  a rect as one interval per row, in reading order

    @intervalsOf: rect ->

        top = rect.y
        bot = rect.y + rect.h

        out = []
        for y in top...bot
            out.push [rect.x y rect.x+rect.w]
        out

    #  remove the cells of a blocker from intervals of one region

    @cutBy: intervals blocker ->

        bx1 = blocker.x
        bx2 = blocker.x + blocker.w
        by1 = blocker.y
        by2 = blocker.y + blocker.h

        out = []

        for rng in intervals

            x1 = rng[0]
            y  = rng[1]
            x2 = rng[2]

            if y < by1 or y >= by2 or bx2 <= x1 or bx1 >= x2
                out.push rng
                continue

            out.push [x1 y bx1] if x1 < bx1
            out.push [bx2 y x2] if bx2 < x2

        out

    #  paint the regionized tree into a grid of characters and return it as
    #  text. the dump only knows characters: colours, attributes and the
    #  vertical part of scaled text do not show. it is a view for tests and
    #  for looking at a layout, not part of the renderer.
    #
    #  nodes paint in document order, so a later node is on top. a child with
    #  erase masks its parent: it writes nothing itself, it only stops the
    #  parent from writing the named channels in its region.

    @dumpRegions: rectree ->

        grid = @gridOf rectree

        ⮐ '' if not grid?

        lines = []
        for row in grid
            chars = []
            for cell in row
                if cell.char == ''
                    chars.push ' '
                else
                    chars.push cell.char
            lines.push(chars.join(''))

        lines.join '\n'

    #  the same picture, but as a text the editor can show: the characters
    #  are the text, the colours are hidden in sue payloads that susan turns
    #  back into fg and bg cells. size the cells to the editor you want to
    #  show it in, the rectree is resolved against them.

    @sueify: cells rectree ->

        root = @regionize(cells rectree)

        ⮐ '' if not root?

        grid  = @gridOf root
        lines = []
        areas = []

        for y in 0...grid.length

            row = @lineOfRow(grid y)

            lines.push row.line

            for area in row.areas
                areas.push area

        sue.ensue(lines.join('\n') areas)

    #  one text line for one row of the grid.
    #
    #  a scaled glyph lives in a block of scale by scale cells, and a sue
    #  run grows upwards from the line it is on, so the glyph is written on
    #  the bottom row of its block and the rows above get a space in its
    #  place, which the block paints over.
    #
    #  the x of a sue area is a grapheme index, not a cell column: a run of
    #  scale n makes n cells out of one grapheme, so the two differ as soon
    #  as anything is scaled.

    @lineOfRow: (grid y) ->

        row    = grid[y]
        glyphs = []
        x      = 0

        while x < row.length

            cell  = row[x]
            block = cell.block

            if valid block

                bottom = block.y + block.scale - 1

                if bottom == y

                    if block.x == x
                        glyphs.push {char:block.char fg:cell.fg bg:cell.bg scale:block.scale}
                        x += block.scale
                    else
                        x += 1

                    continue

                glyphs.push {char:' ' fg:cell.fg bg:cell.bg scale:1}
                x += 1
                continue

            glyphs.push {char:cell.char fg:cell.fg bg:cell.bg scale:1}
            x += 1

        line = []
        for glyph in glyphs
            line.push glyph.char

        {line:line.join('') areas:@areasOfGlyphs(glyphs y)}

    #  colour runs count graphemes, a scaled glyph gets a run of its own

    @areasOfGlyphs: (glyphs y) ->

        areas = []

        for [code channel] in [[sue.FG_COLOR 'fg'] [sue.BG_COLOR 'bg']]

            i = 0

            while i < glyphs.length

                value = glyphs[i][channel]
                width = 1

                while i+width < glyphs.length and glyphs[i+width][channel] == value
                    width += 1

                areas.push {x:i y:y value:[code width 1 value]} if valid value

                i += width

        for i in 0...glyphs.length
            if glyphs[i].scale > 1
                areas.push {x:i y:y value:[sue.SCALE -1 1 glyphs[i].scale]}
                areas.push {x:i+1 y:y value:[sue.CLOSE -1 1 sue.SCALE]}

        areas

    #  a grid of cells { char fg bg block } the size of the rectree, painted

    @gridOf: rectree ->

        ⮐ null if not rectree?

        grid = []

        for y in 0...rectree.h
            row = []
            for x in 0...rectree.w
                row.push {char:' ' fg:null bg:null block:null}
            grid.push row
        @paintTree rectree grid

        grid

    @paintTree: node grid ->

        ⮐ if not node?

        @paintNode(node grid) if not node.erase?

        for child in node.children ? []
            @paintTree child grid

    @paintNode: node grid ->

        ⮐ if not node.regions?

        strings = null

        if valid node.pattern
            strings = fill.pattern(node node.regions)
        else if valid node.text
            strings = fill.text(node node.regions)

        scale  = 1
        scale  = max(1 int(node.scale ? 1)) if valid node.text

        masked = @channelMaskOf node

        for i in 0...node.regions.length

            rng   = node.regions[i]
            width = rng[2] - rng[0]
            chars = Array.from(strings?[i] ? '')

            for j in 0...width

                x = rng[0] + j
                y = rng[1]

                continue if x < 0 or y < 0 or y >= grid.length or x >= grid[y].length

                cell = grid[y][x]
                gone = masked["#{x},#{y}"] ? {}

                if valid strings and not gone.char
                    cell.char = chars[j] ? ' '

                cell.fg = node.fg if valid node.fg and not gone.fg
                cell.bg = node.bg if valid node.bg and not gone.bg

                continue if not (valid strings and scale > 1 and j % scale == 0)
                continue if not cell.char? or cell.char == ' '

                @markBlock(grid x y scale cell.char node)

    #  reserve the block of a scaled glyph: the glyph keeps the top left
    #  cell, every other cell of the block is emptied so that what was
    #  painted there before is covered.
    #
    #  a block only exists when it fits inside the node it belongs to: a
    #  glyph that cannot grow keeps its one cell and is not scaled at all,
    #  so a node can never paint outside the rect it was given.

    @markBlock: (grid x y scale char node) ->

        ⮐ if x + scale > node.x + node.w
        ⮐ if y + scale > node.y + node.h

        for r in y...min(grid.length y+scale)
            for c in x...min(grid[r].length x+scale)

                cell = grid[r][c]

                cell.block = {x:x y:y scale:scale char:char}
                cell.char  = '' if c != x or r != y

    #  the channels a node's eraser children keep it from writing

    @channelMaskOf: node ->

        masked = {}

        for child in node.children ? []

            continue if not child.erase?

            channels = child.erase
            channels = [channels] if channels is str

            for rng in child.regions ? []
                for x in rng[0]...rng[2]

                    key   = "#{x},#{rng[1]}"
                    entry = masked[key]

                    if not entry?
                        entry = {}
                        masked[key] = entry

                    for channel in channels
                        entry[channel] = true

        masked

export layout
