use ◆ fill projector
use ../../kxk ▪ noon
use ../edit/tool ◆ sue

■layout

    #  rectree node
    #
    #      x y   offset from the top left corner of the box
    #      w h   extent
    #      r b   offset from the right or bottom edge of the box
    #
    #  a node without w or r fills the box horizontally.
    #  a node without h or b fills the box vertically.
    #
    #  absolutize adds a rect to every node:
    #
    #      rect.abs   absolute rect in cell coordinates
    #      rect.rel   rect relative to the parent node

    @absolutize: cells rectree ->

        @inBox {x:0 y:0 w:cells.cols h:cells.rows} rectree

        rectree

    @inBox: box node ->

        ⮐ node if not node?

        ▴ "layout: w and r are both given" not (node.w? and node.r?)
        ▴ "layout: h and b are both given" not (node.h? and node.b?)

        x = clamp 0 box.w (@offset(box.w node.x))
        y = clamp 0 box.h (@offset(box.h node.y))

        w = clamp 0 (box.w-x) (@extent(box.w x node.w node.r))
        h = clamp 0 (box.h-y) (@extent(box.h y node.h node.b))
        h = @linesHeight node h box.h-y

        node.rect = {abs:{x:box.x+x y:box.y+y w:w h:h} rel:{x:x y:y w:w h:h}}

        if node.children?
            inner = {x:box.x+x y:box.y+y w:w h:h}
            for child in node.children
                @inBox inner child

        node

    #  the height of scaled text is a whole number of logical lines
    #  an explicit height holds at least one line, if it fits

    @linesHeight: node h room ->

        scale = @scaleOf node

        ⮐ h if scale <= 1

        h = max scale h if node.h?
        h = min h room
        h - h % scale

    #  the height field of a node joins height and scale:
    #
    #      12     height 12, unscaled
    #      3x2    3 lines of scale 2, height 6
    #      x3     1 line of scale 3, height 3
    #      50%x2  half of the parent, in lines of scale 2

    @parseHeight: text ->

        m = /^\s*(\d*%?)\s*(?:x\s*(\d*))?\s*$/i.exec String(text ? '')

        ⮐ if not m?
        ⮐ if empty m[1] and empty m[2]

        scale = clamp 1 7 (valid(m[2]) ? int(m[2]) : 1)

        if m[1].endsWith '%'
            ⮐ {h:m[1] scale:scale}

        lines = valid(m[1]) ? int(m[1]) : 1

        {h:lines*scale scale:scale}

    @heightText: node ->

        ⮐ '' if not node?.h?

        scale = max 1 int(node.scale ? 1)

        ⮐ String(node.h) if scale <= 1

        ⮐ "#{node.h}x#{scale}" if node.h is str and node.h.endsWith '%'

        "#{max(1 floor(int(node.h) / scale))}x#{scale}"

    @offset: extent value ->

        ⮐ 0 if not valid value

        if value is str
            if value.endsWith '%'
                value = extent * int(value) / 100
            ⮐ int value

        value

    @extent: total start w r ->

        ⮐ @offset(total w) if valid w

        ⮐ total - start - (@offset(total r)) if valid r

        total - start

    @regionize: cells rectree ->

        ⮐ if not rectree?

        @absolutize cells rectree

        @addRegions rectree (@blockersIn(rectree)) []
        
        rectree

    @blockersIn: node ->

        found = []

        found.push node if node.blocks and node.rect.abs.w > 0 and node.rect.abs.h > 0

        for child in node.children ? []
            for entry in @blockersIn child
                found.push entry

        found

    @addRegions: node blockers ancestors ->

        node.regions = @intervalsOf node

        if @flows node
            for blocker in blockers
                continue if blocker == node
                continue if blocker in ancestors
                node.regions = @cutBy(node.regions blocker)

        for child in node.children ? []
            @addRegions(child blockers ancestors.concat([node]))

    @flows: node ->

        ⮐ false if node.flows == false

        node.text? or valid node.pattern or valid node.image

    @intervalsOf: node ->

        rect = node.rect.abs

        top = rect.y
        bot = rect.y + rect.h

        out = []
        for y in top...bot
            out.push [rect.x y rect.x+rect.w]
        out

    @cutBy: intervals blocker ->

        rect = blocker.rect.abs

        bx1 = rect.x
        bx2 = rect.x + rect.w
        by1 = rect.y
        by2 = rect.y + rect.h

        out = []

        for rng in intervals

            x1 = rng[0]
            y  = rng[1]
            x2 = rng[2]

            if y < by1 or y >= by2 or bx2 <= x1 or bx1 >= x2
                out.push rng
                continue

            out.push [x1 y bx1] if x1 < bx1
            out.push [bx2 y x2] if bx2 < x2

        out

    @dumpRegions: rectree ->

        grid = @gridOf rectree

        ⮐ '' if not grid?

        lines = []
        for row in grid
            chars = []
            for cell in row
                if cell.char == ''
                    chars.push ' '
                else
                    chars.push cell.char
            lines.push(chars.join(''))

        lines.join '\n'

    @pageOf: tree ->

        ⮐ tree if not tree?

        for key of tree
            ⮐ {children:[tree]} if key != 'children'

        tree

    @titlify: cells page ->

        @absolutize cells page

        delete page.title

        for child in page.children ? []
            @titleIn child 0

        page

    @titleIn: node depth ->

        ⮐ if not node?

        node.title = lpad(depth+2) + @roleOf(node)

        for child in node.children ? []
            @titleIn child depth+2

    @roleOf: node -> @typeOf(node) ? (valid(node.children) ? 'box' : 'rect')

    @typeOf: node ->

        for type in ['text''erase''pattern''bg''fg']
            ⮐ type if node[type]?

        null

    @argOf: node ->

        type = @typeOf node

        ⮐ node[type] if type?

    @sourceOf: rectree ->

        ⮐ '' if not rectree?

        noon.stringify @dataNode(rectree)

    #  a copy of the tree without the runtime properties, for undo snapshots:
    #  text nodes keep the s and the name of their state

    @plainNode: node ->

        out = {}

        for key,value of node
            continue if key in ['rect' 'title' 'index' 'regions' 'rendered' 'grid' 'rows' 'state']
            if key == 'children'
                out.children = value.map (child) => @plainNode child
            else
                out[key] = value

        if node.state?
            out.s = node.state.s
            out.stateName = node.state.name

        out

    #  a copy of the tree as it is saved or copied: text nodes have their lines

    @dataNode: node ->

        out = {}

        for key,value of node
            continue if key in ['rect' 'title' 'index' 'regions' 'rendered' 'grid' 'rows' 'state' 's' 'stateName' 'lines']
            if key == 'children'
                out.children = value.map (child) => @dataNode child
            else
                out[key] = value
            out.lines = projector.linesOf(node) if key == 'text'

        out

    #  a mutable tree from an undo snapshot, the states are created from the s on attach

    @liveNode: plain ->

        out = {}

        for key,value of plain
            if key == 'children'
                out.children = []
                for child in value
                    out.children.push @liveNode(child)
            else
                out[key] = value

        out

    @nodeForPos: cells rectree pos ->

        @absolutize cells rectree
        @topmostIn rectree pos

    @moveNode: cells rectree node dir ->

        box  = @parentOf(rectree node)?.rect.abs ? {x:0 y:0 w:cells.cols h:cells.rows}
        rect = node.rect.abs

        switch dir
            'left'  ➜ dx = -1
            'right' ➜ dx =  1
            'up'    ➜ dy = -1
            'down'  ➜ dy =  1

        if dx and (node.w? or node.r?)

            maxRel = max 0 (box.w - rect.w)

            if node.w?
                value = @incrValue node.x (rect.x - box.x) dx 0 maxRel 
                if value? ➜ node.x = value
            else
                oldRel = rect.x - box.x
                oldEnd = maxRel - oldRel

                if node.x?
                    value = @incrValue node.x oldRel dx 0 maxRel 
                    if value?
                        newRel = @offset box.w value
                        node.x = value
                        node.r = oldEnd - (newRel - oldRel)
                else
                    value = @incrValue node.r oldEnd -dx 0 maxRel 
                    if value?
                        newEnd = @offset box.w value
                        node.r = value
                        node.x = maxRel - newEnd

        if dy and (node.h? or node.b?)

            maxRel = max 0 (box.h - rect.h)

            if node.h?
                value = @incrValue node.y (rect.y - box.y) dy 0 maxRel  
                if value? ➜ node.y = value
            else
                oldRel = rect.y - box.y
                oldEnd = maxRel - oldRel

                if node.y?
                    value = @incrValue node.y oldRel dy 0 maxRel  
                    if value?
                        newRel = @offset box.h value
                        node.y = value
                        node.b = oldEnd - (newRel - oldRel)
                else
                    value = @incrValue node.b oldEnd -dy 0 maxRel 
                    if value?
                        newEnd = @offset box.h value
                        node.b = value
                        node.y = maxRel - newEnd

        if valid value

            @absolutize cells rectree
            ⮐ node

    @resizeNode: cells rectree node dir ->

        box  = @parentOf(rectree node)?.rect.abs ? {x:0 y:0 w:cells.cols h:cells.rows}
        rect = node.rect.abs
        step = @scaleOf node
        roomW = box.w - (rect.x - box.x)
        roomH = box.h - (rect.y - box.y)

        switch dir
            'less cols' ➜ dw = -step
            'more cols' ➜ dw =  step
            'less rows' ➜ dh = -step
            'more rows' ➜ dh =  step

        before = {w:node.w r:node.r h:node.h b:node.b}

        if dw

            if node.w?
                value = @stepWidth node rect.w dw step roomW
                if value? ➜ node.w = value
            else
                value = @incrValue node.r roomW-rect.w -dw 0 roomW-step
                if value? ➜ node.r = value

        if dh

            if node.h?
                value = @incrValue node.h rect.h dh step roomH
                if value? ➜ node.h = value
            else
                value = @incrValue node.b roomH-rect.h -dh 0 roomH-step
                if value? ➜ node.b = value

        ⮐ if not valid value

        @absolutize cells rectree

        if node.rect.abs.w < step or node.rect.abs.h < step

            for key,val of before
                if val? ➜ node[key] = val else delete node[key]

            @absolutize cells rectree
            ⮐

        node

    #  the logical width of scaled text steps along multiples of the scale
    #  it may grow one step past the room, the visible rect is cropped there

    @stepWidth: node old dir step room ->

        ⮐ @incrValue(node.w old dir step room) if node.w is str and node.w.endsWith '%'

        w = dir > 0 ? (floor(old / step) + 1) * step : (ceil(old / step) - 1) * step
        w = clamp step ceil(room / step)*step w

        ⮐ w if w != old and w != int(node.w)

    @incrValue: field old dir minv maxv ->

        if field is str and field.endsWith '%'
            rep = int(field) + (dir > 0 ? 1 : -1)
            ⮐ "#{rep}%" if 0 <= rep <= 100
        else
            res = clamp minv maxv old+dir
            ⮐ res if res != old

    @removeNode: rectree node ->

        parent = @parentOf rectree node

        ⮐ if not parent?

        parent.children.splice parent.children.indexOf(node) 1
        delete parent.children if empty parent.children

        parent

    @pathOf: rectree node ->

        ⮐ [] if node == rectree

        parent = @parentOf rectree node

        ⮐ if not parent?

        path = @pathOf rectree parent

        ⮐ if not path?

        path.concat [parent.children.indexOf(node)]

    @nodeAtPath: rectree path ->

        node = rectree

        for index in path
            node = node?.children?[index]

        node

    @ownProps: node ->

        props = @dataNode node
        delete props.children
        props

    @isNodeData: data ->

        ⮐ false if not data? or data is arr or typeof(data) != 'object'
        ⮐ false if empty data

        for key,value of data
            ⮐ false if key not in ['x' 'y' 'w' 'h' 'r' 'b' 'text' 'lines' 'pattern' 'image' 'erase' 'bg' 'fg' 'scale' 'flows' 'blocks' 'type' 'children']

        if data.children?
            ⮐ false if not (data.children is arr)
            for child in data.children
                ⮐ false if not @isNodeData child

        true

    @appendChild: parent node ->

        parent.children ?= []
        parent.children.push node

        node

    @shiftNode: rectree node dir ->

        parent = @parentOf rectree node

        ⮐ false if not parent?

        siblings = parent.children
        index    = siblings.indexOf node
        target   = dir == 'up' ? index-1 : index+1

        if 0 <= target < siblings.length

            other = siblings[target]

            if valid other.children
                @reframe node parent.rect.abs other.rect.abs
                siblings.splice index 1
                if dir == 'up' ➜ other.children.push node else other.children.unshift node
            else
                siblings.splice index 1
                siblings.splice target 0 node

            ⮐ true

        grand = @parentOf rectree parent

        ⮐ false if not grand?

        @reframe node parent.rect.abs grand.rect.abs

        siblings.splice index 1
        delete parent.children if empty siblings

        at = grand.children.indexOf parent
        grand.children.splice (dir == 'up' ? at : at+1) 0 node

        true

    @reframe: node from to ->

        dx = from.x - to.x
        dy = from.y - to.y
        dr = (to.x + to.w) - (from.x + from.w)
        db = (to.y + to.h) - (from.y + from.h)

        cells = (value) -> value? and not (value is str)

        node.x = node.x + dx if cells node.x
        node.y = node.y + dy if cells node.y
        node.r = node.r + dr if cells node.r
        node.b = node.b + db if cells node.b

        node.x ?= dx
        node.y ?= dy
        node.r  = dr if not node.w? and not node.r?
        node.b  = db if not node.h? and not node.b?

    @parentOf: node target ->

        for child in node.children ? []
            ⮐ node if child == target

        for child in node.children ? []
            if found = @parentOf child target
                ⮐ found
        null

    #  a new text node at pos, one cell wider than the first line of its text

    @addTextNode: cells rectree pos text ->

        ⮐ if not rectree?

        node  = @nodeForPos(cells rectree pos) ? rectree
        lines = text.split '\n'
        rect  = node.rect.abs
        child = {text:'md' lines:lines x:pos[0]-rect.x y:pos[1]-rect.y w:Array.from(lines[0]).length+1 h:1}

        @appendChild node child

    @topmostIn: node pos ->

        ⮐ if not node?

        found = node if @holds(node pos)

        for child in node.children ? []
            if hit = @topmostIn child pos
                found = hit

        found

    @scaleOf: node ->

        ⮐ 1 if not node.text?

        max 1 int(node.scale ? 1)

    @holds: node pos ->

        rect = node.rect.abs
        x    = pos[0]
        y    = pos[1]

        ⮐ x >= rect.x and x < rect.x+rect.w and y >= rect.y and y < rect.y+rect.h

    @sueify: cells rectree ->

        ⮐ '' if not rectree?

        data = @sheetData cells rectree

        sue.ensue data.text data.sue

    #  the text and sue areas of the painted sheet. the root keeps its grid and rows:
    #  with dirty rows given, and the layout painted at this size before, only those
    #  rows are painted again. the caller knows that no rect changed since

    @sheetData: cells rectree dirty ->

        root = @regionize cells rectree

        ⮐ {text:'' sue:[]} if not root?

        projector.attach root

        size = {cols:cells.cols rows:cells.rows}

        if dirty? and root.grid? and root.rendered eql size
            @repaintRows root dirty
        else
            root.grid = @gridOf root
            root.rows = []
            for y in 0...root.grid.length
                root.rows.push @lineOfRow(root.grid y)

        root.rendered = size

        areas = []
        for row in root.rows
            for area in row.areas
                areas.push area

        text    = root.rows.map((row) -> row.line).join('\n')
        classes = root.rows.map((row) -> row.classes)

        {text:text sue:areas classes:classes}

    #  paints the rows of the grid again, widened to whole bands of the scaled text
    #  they touch, because a block is never cut

    @repaintRows: root dirty ->

        grid = root.grid
        rows = new Set dirty.filter((y) -> 0 <= y < grid.length)

        widen = (node) =>
            if @scaleOf(node) > 1 and node.regions?.some((rng) -> rows.has rng[1])
                rect = node.rect.abs
                for y in rect.y...min(grid.length rect.y+rect.h)
                    if not rows.has y
                        rows.add y
                        grown = true
            for child in node.children ? []
                widen child

        grown = true
        while grown
            grown = false
            widen root

        ys = Array.from rows

        for y in ys
            for cell in grid[y]
                cell.char  = ' '
                cell.fg    = null
                cell.bg    = null
                cell.block = null
                cell.clss  = null

        @paintTree root grid rows

        for y in ys
            root.rows[y] = @lineOfRow grid y

    @lineOfRow: (grid y) ->

        row    = grid[y]
        glyphs = []
        x      = 0

        while x < row.length

            cell  = row[x]
            block = cell.block

            if valid block

                bottom = block.y + block.scale - 1

                if bottom == y

                    if block.x == x
                        glyphs.push {char:block.char fg:cell.fg bg:cell.bg scale:block.scale node:block.node clss:block.clss}
                        x += block.scale
                    else
                        x += 1

                    continue

                glyphs.push {char:' ' fg:cell.fg bg:cell.bg scale:1}
                x += 1
                continue

            glyphs.push {char:cell.char fg:cell.fg bg:cell.bg scale:1 clss:cell.clss}
            x += 1

        line    = []
        classes = []
        for glyph in glyphs
            line.push glyph.char
            classes.push glyph.clss ? null

        {line:line.join('') areas:@areasOfGlyphs(glyphs y) classes:classes}

    @areasOfGlyphs: (glyphs y) ->

        areas = []

        for [code channel] in [[sue.FG_COLOR 'fg'] [sue.BG_COLOR 'bg']]

            i = 0

            while i < glyphs.length

                value = glyphs[i][channel]
                width = 1

                while i+width < glyphs.length and glyphs[i+width][channel] == value
                    width += 1

                areas.push {x:i y:y value:[code width 1 value]} if valid value

                i += width

        i = 0

        while i < glyphs.length

            scale = glyphs[i].scale

            if scale <= 1
                i += 1
                continue

            j = i+1
            while j < glyphs.length and glyphs[j].scale == scale and glyphs[j].node == glyphs[i].node
                j += 1

            areas.push {x:i y:y value:[sue.SCALE -1 1 scale]}
            areas.push {x:j y:y value:[sue.CLOSE -1 1 sue.SCALE]}

            i = j

        areas

    @gridOf: rectree ->

        ⮐ if not rectree?

        grid = []
        rect = rectree.rect.abs

        for y in 0...rect.h
            row = []
            for x in 0...rect.w
                row.push {char:' ' fg:null bg:null block:null clss:null}
            grid.push row
        @paintTree rectree grid

        grid

    #  rows: the set of grid rows to paint, all if not given.
    #  erase nodes only mask their parent, text nodes with erase paint their text too

    @paintTree: node grid rows ->

        ⮐ if not node?

        @paintNode(node grid rows) if not node.erase? or node.text?

        for child in node.children ? []
            @paintTree child grid rows

    @paintNode: node grid rows ->

        ⮐ if not node.regions?

        masked = @channelMaskOf node

        strings = null
        classes = null

        if valid node.pattern
            strings = fill.pattern(node node.regions)
        else if node.text? and @scaleOf(node) == 1
            [strings classes] = @textRows node
        else if node.text?
            strings = node.regions.map (rng) -> fill.blank(rng[2] - rng[0])

        for i in 0...node.regions.length

            rng   = node.regions[i]

            continue if rows? and not rows.has rng[1]

            chars = Array.from(strings?[i] ? '')

            for j in 0...(rng[2] - rng[0])

                x = rng[0] + j
                y = rng[1]

                continue if x < 0 or y < 0 or y >= grid.length or x >= grid[y].length

                cell = grid[y][x]
                gone = masked["#{x},#{y}"] ? {}

                if valid strings and not gone.char
                    @unblock grid cell.block if cell.block?
                    cell.char = chars[j] ? ' '
                    cell.clss = classes?[i]?[j] ? null

                cell.fg = node.fg if valid node.fg and not gone.fg
                cell.bg = node.bg if valid node.bg and not gone.bg

        @paintScaled node grid masked rows if @scaleOf(node) > 1

    #  the rows of the regions of an unscaled text node, with the glyphs of its state,
    #  and the syntax classes of the glyphs per row

    @textRows: node ->

        chars   = {}
        classes = {}

        for [x y ch clss] in projector.glyphs(node)
            chars["#{x},#{y}"]   = ch
            classes["#{x},#{y}"] = clss

        rows = node.regions.map (rng) ->
            row = ''
            for x in rng[0]...rng[2]
                row += chars["#{x},#{rng[1]}"] ? ' '
            row

        clss = node.regions.map (rng) ->
            row = []
            for x in rng[0]...rng[2]
                row.push classes["#{x},#{rng[1]}"] ? null
            row

        [rows clss]

    #  every glyph of scaled text is a block of scale×scale cells
    #  the glyph lives in the top left cell, the other cells are reserved
    #  a block is never cut: whatever is painted later replaces it as a whole

    @paintScaled: node grid masked rows ->

        scale = @scaleOf node
        rect  = node.rect.abs
        chars = {}

        for [x y char clss] in projector.glyphs(node)
            chars["#{x},#{y}"] = [char clss]

        for [y x1 x2] in fill.bands(node node.regions rect)

            continue if rows? and not rows.has y

            x = x1

            while x + scale <= x2

                if not @charMaskedIn masked x y scale
                    [char clss] = chars["#{x},#{y}"] ? [' ' null]
                    @markBlock grid x y scale char node clss

                x += scale

    @charMaskedIn: masked x y scale ->

        for r in y...y+scale
            for c in x...x+scale
                ⮐ true if masked["#{c},#{r}"]?.char

        false

    @markBlock: (grid x y scale char node clss) ->

        block = {x:x y:y scale:scale char:char node:node clss:clss}

        for r in y...min(grid.length y+scale)
            for c in x...min(grid[r].length x+scale)

                cell = grid[r][c]

                @unblock grid cell.block if cell.block?

                cell.block = block
                cell.char  = (c == x and r == y) ? char : ''

    @unblock: grid block ->

        for r in block.y...min(grid.length block.y+block.scale)
            for c in block.x...min(grid[r].length block.x+block.scale)

                cell = grid[r][c]

                if cell.block == block
                    cell.block = null
                    cell.char  = ' '
                    cell.clss  = null

    @channelMaskOf: node ->

        masked = {}

        for child in node.children ? []

            continue if not child.erase?

            channels = child.erase
            channels = [channels] if channels is str

            for rng in child.regions ? []
                for x in rng[0]...rng[2]

                    key   = "#{x},#{rng[1]}"
                    entry = masked[key]

                    if not entry?
                        entry = {}
                        masked[key] = entry

                    for channel in channels
                        entry[channel] = true

        masked

export layout
