use ◆ fill
use ../edit/tool ◆ sue

■layout

    #  rectree node
    #
    #      x y   offset from the top left corner of the box
    #      w h   extent
    #      r b   offset from the right or bottom edge of the box
    #
    #  a node without w or r fills the box horizontally.
    #  a node without h or b fills the box vertically.

    @absolutize: cells rectree ->

        @inBox {x:0 y:0 w:cells.cols h:cells.rows} rectree

    @inBox: box node ->

        ⮐ node if not node?

        ▴ "layout: w and r are both given" not (node.w? and node.r?)
        ▴ "layout: h and b are both given" not (node.h? and node.b?)

        x = clamp 0 box.w (@offset(box.w node.x))
        y = clamp 0 box.h (@offset(box.h node.y))

        w = clamp 0 (box.w-x) (@extent(box.w x node.w node.r))
        h = clamp 0 (box.h-y) (@extent(box.h y node.h node.b))

        out = @withoutGeometry node

        out.x = box.x + x
        out.y = box.y + y
        out.w = w
        out.h = h

        if node.children?
            inner = {x:out.x y:out.y w:w h:h}
            out.children = []
            for child in node.children
                out.children.push @inBox(inner child)

        out

    @offset: extent value ->

        ⮐ 0 if not valid value

        if value is str
            if value.endsWith '%'
                ⮐ int(extent * int(value[0...-1]) / 100)
            ⮐ int value

        value

    @extent: total start w r ->

        ⮐ @offset(total w) if valid w

        ⮐ total - start - (@offset(total r)) if valid r

        total - start

    @withoutGeometry: node ->

        out = {}

        for key,value of node
            continue if key in ['x' 'y' 'w' 'h' 'r' 'b' 'children']
            out[key] = value

        out
        
    @regionize: cells rectree ->

        ⮐ null if not rectree?

        root = @absolutize cells rectree

        @addRegions(root (@blockersIn(root)) [])
        
        root

    @blockersIn: node ->

        found = []

        found.push node if node.blocks and node.w > 0 and node.h > 0

        for child in node.children ? []
            for entry in @blockersIn child
                found.push entry

        found

    @addRegions: node blockers ancestors ->

        node.regions = @intervalsOf node

        if @flows node
            for blocker in blockers
                continue if blocker == node
                continue if blocker in ancestors
                node.regions = @cutBy(node.regions blocker)

        for child in node.children ? []
            @addRegions(child blockers ancestors.concat([node]))

    @flows: node ->

        ⮐ false if node.flows == false

        valid node.text or valid node.pattern or valid node.image

    @intervalsOf: rect ->

        top = rect.y
        bot = rect.y + rect.h

        out = []
        for y in top...bot
            out.push [rect.x y rect.x+rect.w]
        out

    @cutBy: intervals blocker ->

        bx1 = blocker.x
        bx2 = blocker.x + blocker.w
        by1 = blocker.y
        by2 = blocker.y + blocker.h

        out = []

        for rng in intervals

            x1 = rng[0]
            y  = rng[1]
            x2 = rng[2]

            if y < by1 or y >= by2 or bx2 <= x1 or bx1 >= x2
                out.push rng
                continue

            out.push [x1 y bx1] if x1 < bx1
            out.push [bx2 y x2] if bx2 < x2

        out

    @dumpRegions: rectree ->

        grid = @gridOf rectree

        ⮐ '' if not grid?

        lines = []
        for row in grid
            chars = []
            for cell in row
                if cell.char == ''
                    chars.push ' '
                else
                    chars.push cell.char
            lines.push(chars.join(''))

        lines.join '\n'

    @titlify: cells rectree items=[] depth=0 -> # generate items for sheetree 
        
        abstree = @absolutize cells rectree
        
        rectree.index = items.length
        
        for type in ['erase''text''pattern''bg''fg']
            if rectree[type]? 
                rect = x:abstree.x y:abstree.y w:abstree.w h:abstree.h
                item = title:lpad(depth+2)+type rect:rect type:type arg:rectree[type] 
                for key in ['x''y''w''h''r''b''fg''bg']
                    if rectree[key]?
                        item[key] = rectree[key]
                break
                
        if item ➜ items.push item
        for child in rectree.children
            @titlify cells child items depth+2
            
        items
        
    @modifyTreeNode: rectree node ->
        
        if treeNode = @nodeAtIndex rectree node.index
            for key in ['x''y''w''h''r''b''fg''bg']
                if node[key]?
                    treeNode[key] = node[key]
                else
                    delete treeNode[key]

    @nodeForPos: cells rectree pos ->

        # return 'topmost' node containing pos

        pair = @topmostPairAt @absolutize(cells rectree) rectree pos

        ⮐ null if not pair?

        pair[0]

    @insertTextAt: cells rectree pos text ->

        # insert text into the text node at pos or create one under the topmost node at pos
        # returns the number of cells the cursor advances

        abs  = @absolutize cells rectree
        pair = @topmostPairAt abs rectree pos

        if pair?
            [node target] = pair
        else
            ⮐ 0 if not abs?
            node   = abs
            target = rectree

        if valid target.text
            scale = @scaleOf node
            spare = target.text.length * scale + scale
            offset = @textOffsetIn node pos target.text.length
            target.text = target.text[0...offset] + text + target.text[offset..]
            if int(target.w) == spare and int(target.h) == scale and not target.r? and not target.b?
                target.w = spare + text.split('\n')[0].length * scale
        else
            width = text.split('\n')[0].length
            target.children ?= []
            target.children.push {text:text x:pos[0]-node.x y:pos[1]-node.y w:width+1 h:1}
            scale = 1

        scale * text.split('\n')[0].length

    @topmostPairAt: abs raw pos ->

        # pair each absolutized node with its source node

        ⮐ null if not abs? or not raw?

        found = null
        found = [abs raw] if @holds(abs pos)

        for child,i in abs.children ? []
            if hit = @topmostPairAt child raw.children[i] pos
                found = hit

        found

    @textOffsetIn: node pos length ->

        scale   = @scaleOf node
        perLine = max 1 int(node.w / scale)
        offset  = (max(0 pos[1]-node.y) * perLine) + int(max(0 pos[0]-node.x) / scale)

        clamp 0 length offset

    @scaleOf: node ->

        ⮐ 1 if not valid node.text

        max 1 int(node.scale ? 1)

    @holds: node pos ->

        x = pos[0]
        y = pos[1]

        ⮐ x >= node.x and x < node.x+node.w and y >= node.y and y < node.y+node.h

    @nodeAtIndex: rectree index ->
    
        if rectree.index == index
            ⮐ rectree
        for child in rectree.children
            n = @nodeAtIndex child index
            ⮐ n if n

    @sueify: cells rectree ->

        root = @regionize cells rectree

        ⮐ '' if not root?

        grid  = @gridOf root
        lines = []
        areas = []

        for y in 0...grid.length

            row = @lineOfRow(grid y)

            lines.push row.line

            for area in row.areas
                areas.push area

        sue.ensue(lines.join('\n') areas)

    @lineOfRow: (grid y) ->

        row    = grid[y]
        glyphs = []
        x      = 0

        while x < row.length

            cell  = row[x]
            block = cell.block

            if valid block

                bottom = block.y + block.scale - 1

                if bottom == y

                    if block.x == x
                        glyphs.push {char:block.char fg:cell.fg bg:cell.bg scale:block.scale}
                        x += block.scale
                    else
                        x += 1

                    continue

                glyphs.push {char:' ' fg:cell.fg bg:cell.bg scale:1}
                x += 1
                continue

            glyphs.push {char:cell.char fg:cell.fg bg:cell.bg scale:1}
            x += 1

        line = []
        for glyph in glyphs
            line.push glyph.char

        {line:line.join('') areas:@areasOfGlyphs(glyphs y)}

    @areasOfGlyphs: (glyphs y) ->

        areas = []

        for [code channel] in [[sue.FG_COLOR 'fg'] [sue.BG_COLOR 'bg']]

            i = 0

            while i < glyphs.length

                value = glyphs[i][channel]
                width = 1

                while i+width < glyphs.length and glyphs[i+width][channel] == value
                    width += 1

                areas.push {x:i y:y value:[code width 1 value]} if valid value

                i += width

        for i in 0...glyphs.length
            if glyphs[i].scale > 1
                areas.push {x:i y:y value:[sue.SCALE -1 1 glyphs[i].scale]}
                areas.push {x:i+1 y:y value:[sue.CLOSE -1 1 sue.SCALE]}

        areas

    @gridOf: rectree ->

        ⮐ null if not rectree?

        grid = []

        for y in 0...rectree.h
            row = []
            for x in 0...rectree.w
                row.push {char:' ' fg:null bg:null block:null}
            grid.push row
        @paintTree rectree grid

        grid

    @paintTree: node grid ->

        ⮐ if not node?

        @paintNode(node grid) if not node.erase?

        for child in node.children ? []
            @paintTree child grid

    @paintNode: node grid ->

        ⮐ if not node.regions?

        strings = null

        if valid node.pattern
            strings = fill.pattern(node node.regions)
        else if valid node.text
            strings = fill.text(node node.regions)

        scale  = 1
        scale  = max(1 int(node.scale ? 1)) if valid node.text

        masked = @channelMaskOf node

        for i in 0...node.regions.length

            rng   = node.regions[i]
            width = rng[2] - rng[0]
            chars = Array.from(strings?[i] ? '')

            for j in 0...width

                x = rng[0] + j
                y = rng[1]

                continue if x < 0 or y < 0 or y >= grid.length or x >= grid[y].length

                cell = grid[y][x]
                gone = masked["#{x},#{y}"] ? {}

                if valid strings and not gone.char
                    cell.char = chars[j] ? ' '

                cell.fg = node.fg if valid node.fg and not gone.fg
                cell.bg = node.bg if valid node.bg and not gone.bg

                continue if not (valid strings and scale > 1 and j % scale == 0)
                continue if not cell.char? or cell.char == ' '

                @markBlock(grid x y scale cell.char node)

    @markBlock: (grid x y scale char node) ->

        ⮐ if x + scale > node.x + node.w
        ⮐ if y + scale > node.y + node.h

        for r in y...min(grid.length y+scale)
            for c in x...min(grid[r].length x+scale)

                cell = grid[r][c]

                cell.block = {x:x y:y scale:scale char:char}
                cell.char  = '' if c != x or r != y

    @channelMaskOf: node ->

        masked = {}

        for child in node.children ? []

            continue if not child.erase?

            channels = child.erase
            channels = [channels] if channels is str

            for rng in child.regions ? []
                for x in rng[0]...rng[2]

                    key   = "#{x},#{rng[1]}"
                    entry = masked[key]

                    if not entry?
                        entry = {}
                        masked[key] = entry

                    for channel in channels
                        entry[channel] = true

        masked

export layout
