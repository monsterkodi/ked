use ◆ fill
use ../../kxk    ▪ kseg
use ../edit/tool ◆ sue
use ../edit      ◆ state

■projector

    #  every text node gets an editor state, a runtime property like rect.
    #  the state holds the text, node.text is the syntax language of it.
    #  all lines are wrapped: their rows flow through the spans of the node, one row
    #  per span, starting at the row the node view begins with

    @attach: node ->

        ⮐ node if not node?

        if node.text?
            if node.regions? ➜ @spans node else @stateOf node

        for child in node.children ? []
            @attach child

        node

    #  the state of a text node. a new state takes the lines the node was loaded or
    #  pasted with, or the s of an undo snapshot

    @stateOf: node ->

        if not node.state?

            @count = (@count ? 0) + 1
            st = new state {cols:0 rows:0} "popo_node_#{@count}"
            st.wrap    = all:true word:true
            st.scaling = false
            st.syntax.setExt @extOf(node)

            if node.s?
                st.s = node.s
                st.segls = node.s.lines.slice()
                st.syntax.setSegls node.s.lines
                st.clearHistory()
            else
                st.loadLines node.lines ? ['']

            delete node.s
            delete node.lines

            node.state = st

        st = node.state

        if st.syntax.ext != @extOf(node)
            st.syntax.setExt @extOf(node)
            st.syntax.setSegls st.s.lines

        st

    @extOf: node -> (valid(node.text) and node.text is str) ? node.text : 'md'

    @linesOf: node -> @stateOf(node).s.lines.map (l) -> kseg.str l

    @textOf: node -> @linesOf(node).join '\n'

    @scaleOf: node -> max 1 int(node.scale ? 1)

    #  [y x1 x2] of every span in flow order. the state gets their widths as row widths

    @spans: node ->

        scale  = @scaleOf node
        spans  = fill.bands node node.regions node.rect.abs
        widths = spans.map (span) -> floor((span[2] - span[1]) / scale)
        st     = @stateOf node

        st.setRowWidths widths if not (widths eql st.rowWidths)

        spans

    #  [x y char] of every glyph that has a cell in a span, y is the top row of the band

    @glyphs: node ->

        spans = @spans node
        st    = node.state
        scale = @scaleOf node
        out   = []

        ⮐ out if empty spans

        tops  = st.flowLayout().tops
        lines = st.s.lines

        for li in 0...lines.length

            line   = lines[li]
            starts = st.wrapStarts li
            cells  = sue.cellPositionsForLine lines li []

            for k in 0...starts.length

                si = tops[li] + k

                continue if si < 0
                ⮐ out if si >= spans.length

                [y x1 x2] = spans[si]
                end    = (k+1 < starts.length) ? starts[k+1] : line.length
                indent = st.wrapIndent li k

                for gi in starts[k]...end
                    x = x1 + (cells[gi] - cells[starts[k]] + indent) * scale
                    out.push [x y line[gi]] if x + scale <= x2

        out

    #  the page cell of position [x li] in the node's state:
    #  the bottom left cell of its block, null if its row is outside the node view

    @cellOf: node pos ->

        spans = @spans node
        st    = node.state
        scale = @scaleOf node

        [x li]   = pos
        [col k]  = st.lineCell x li
        si       = st.flowLayout().tops[li] + k

        ⮐ null if si < 0 or si >= spans.length

        [y x1] = spans[si]

        [x1 + col*scale, y + scale-1]

    #  the position in the node's state at a page cell, null if no row of the text
    #  flows through the span at that cell

    @posAt: node cell ->

        spans = @spans node
        st    = node.state
        scale = @scaleOf node

        [cx cy] = cell

        si = spans.findIndex (span) -> span[0] <= cy < span[0]+scale and span[1] <= cx < span[2]

        ⮐ null if si < 0

        tops = st.flowLayout().tops
        li   = tops.length-1
        li  -= 1 while li > 0 and tops[li] > si
        k    = si - tops[li]

        ⮐ null if k < 0 or k >= st.wrapStarts(li).length

        [st.posInRow(li k floor((cx - spans[si][1]) / scale)) li]

    #  the end of the node's text

    @endOf: node ->

        lines = @stateOf(node).s.lines
        [lines[-1].length lines.length-1]

    #  scrolls the node view row by row until the main cursor's row has a span

    @scrollToCursor: node ->

        spans = @spans node
        st    = node.state

        ⮐ if empty spans

        [x li] = st.mainCursor()

        for i in 0...1000
            si = st.flowLayout().tops[li] + st.wrapRow(x li)
            if si < 0
                break if not @scrollRows st -1
            else if si >= spans.length
                break if not @scrollRows st 1
            else
                break

    @scrollRows: st dir ->

        view = st.s.view[1]
        off  = st.s.scrollOffset

        if dir > 0
            if off+1 < st.wrapStarts(view).length
                off += 1
            else if view+1 < st.s.lines.length
                view += 1
                off   = 0
            else
                ⮐ false
        else
            if off > 0
                off -= 1
            else if view > 0
                view -= 1
                off   = st.wrapStarts(view).length-1
            else
                ⮐ false

        st.setView [0 view] off

        true

export projector
