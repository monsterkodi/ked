
use ../../../kxk ▪ post
use ../../theme  ◆ theme
use              ◆ input

■rgbinput extends input
    # a three digit rgb input for the colorpicker
    
    @: screen name ->

        super screen name

        @setColor 'bg'       theme.colorpicker.bg
        @setColor 'bg_blur'  theme.colorpicker.bg
        @setColor 'bg_focus' theme.selection.line
        @setColor 'empty'    theme.colorpicker.bg

        @textColor = theme.colorpicker.fg
        @value     = 0
        @set '0'

        @state.skipAdjustViewForMainCursor = true

        @pointerType    = 'text'

    getValue: -> @value

    onWheel: event =>

        ⮐ if @hidden() or @collapsed()
        ⮐ if not @cells.isInsideEvent event

        dir = switch event.dir
            'up'    ➜  1
            'right' ➜  1
            'down'  ➜ -1
            'left'  ➜ -1
                    ➜ ⮐ 

        step = 1
        step = 10 if event.shift

        @changeValue @value + dir*step
        
        @state.moveCursors (dir > 0 ? 'eol' : 'bol')

        redraw:true

    changeValue: v =>
        
        v = clamp 0 255 int(v)
        if v != @value
            @setValue v
            @emit 'valueChange' @value

    setValue: v =>

        @value = clamp 0 255 int(v)
        if "#{@value}" != @current()
            @set "#{@value}"
            @state.moveCursors 'eol'

    draw: ->

        super()

        ⮐ if @hidden() or @collapsed()

        for ch, x in @current()
            @cells.set_fg x 0 @textColor

    drawCursors: =>

        ⮐ if not @hasFocus()
        super()

    onKey: key event =>

        ⮐ false if not @hasFocus()
        ⮐ false if @hidden() or @collapsed()

        switch event.combo
            'cmd+a' 'cmd+left' 'cmd+right' 'shift+left' 'shift+right'
            'left' 'right' 'delete' 'backspace'
            '1''2''3''4''5''6''7''8''9''0'
                super key event
                @changeValue parseInt(@current())
                ⮐ true
        false        
        
export rgbinput
