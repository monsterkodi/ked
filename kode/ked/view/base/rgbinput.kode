###
    rgbinput

    a three digit rgb input for the colorpicker
    built on the regular input field
###

use ../../../kxk ▪ post
use ../../theme ◆ theme
use              ◆ input

function rgbinput extends input

    @: screen name ->

        super screen name

        @setColor 'bg'       theme.colorpicker.bg
        @setColor 'bg_blur'  theme.colorpicker.bg
        @setColor 'bg_focus' theme.selection.line
        @setColor 'empty'    theme.colorpicker.bg

        @textColor = theme.colorpicker.fg
        @value     = 0
        @set '0'

        @state.skipAdjustViewForMainCursor = true

        @onFocusRequest = null
        @onInput        = null
        @pointerType    = 'text'

    getValue: -> @value

    onMouseEnter: event =>

        if @onFocusRequest is func
            @onFocusRequest()
            if @pointerType
                post.emit 'pointer' @pointerType
                post.emit 'redraw'
        else
            super event

    onMouseLeave: event =>

        post.emit 'pointer' 'default' if @pointerType
        super event

    onWheel: event =>

        ⮐  if @hidden() or @collapsed()
        ⮐  if not @cells.isInsideEvent event

        dir = switch event.dir
            'up'    ➜  1
            'right' ➜  1
            'down'  ➜ -1
            'left'  ➜ -1
            else    ➜  0

        ⮐  if not dir

        step = 1
        step = 10 if event.shift

        @onFocusRequest() if @onFocusRequest is func
        @setValue @value + dir*step
        @onInput() if @onInput is func

        redraw:true

    setValue: v =>

        v = clamp 0 255 int(v)
        @value = v

        text = "#{v}"
        if @current() != text
            @set text

    clampText: =>

        text   = @current()
        digits = ''

        for ch in text
            digits += ch if ch in '0123456789'

        v = clamp 0 255 (digits.length ? parseInt(digits) : 0)
        text = "#{v}"

        if @current() != text
            @set text
            @state.moveCursors 'eol'

        @value = v
        v

    draw: ->

        super()

        ⮐  if @hidden() or @collapsed()

        for ch, x in @current()
            @cells.set_fg x 0 @textColor

    drawCursors: =>

        ⮐  if not @hasFocus()
        super()

    onKey: key event =>

        ⮐  false if not @hasFocus()

        switch event.combo
            'up' 'down' 'tab' 'shift+tab' 'return' 'esc' ➜ ⮐  false

        if valid event.char and not (event.char in '0123456789')
            ⮐  true

        handled = super key event

        @clampText() if handled

        handled

export rgbinput
