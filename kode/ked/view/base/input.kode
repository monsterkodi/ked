
use ../../../kxk ▪ kseg
use ../../theme  ◆ theme
use ../../edit   ◆ editor
■input□editor
###
    simple text and number input field
    used in 
        - inputchoice to filter choices
        - colorpicker
        - sheenode
        - uniko
###
    @: @screen @name @opt={} ->
        
        super @screen @name ['brckts' 'replex' 'unype']
        
        @drawUnfocusedCursors = true
        
        @setColor 'selection_line'  @color.selection
        @setColor 'bg'              theme.quicky.bg
        @setColor 'bg_blur'         theme.quicky.bg
        @setColor 'bg_focus'        theme.editor.bg
        
    drawCursors: =>
    
        if @drawUnfocusedCursors or @hasFocus()
            super()
                
    onMouseLeave: event => 
    
        @emit 'action' 'cancel'
        super event
        
    current:  => kseg.str @state.s.lines[0]

    set: text ->

        @state.loadLines [text]

    selectAll: -> 
    
        @state.selectLine 0
        @state.moveCursors 'eol'
        
    clampValue: v =>
        
        ⮐ "#{@opt.min ? 0}" if empty v

        p = @opt.percent and v is str and v.endsWith('%')
        value = int v

        if p
            value = clamp 0 100 value
        else
            if valid @opt.min ➜ value = max @opt.min value
            if valid @opt.max ➜ value = min @opt.max value

        "#{value}" + (p ? '%' : '')
        
    changeValue: v =>
        
        ⮐ if not @opt.number

        if typeof v == 'number' and @opt.percent and @current().endsWith '%'
            v = "#{v}%"

        v = @clampValue v

        @setValue v if v != @getValue()
        @emit 'valueChange' @current() @name
            
    getValue: -> @current()
    int: -> int @current()
    
    setValue: v =>
        
        ⮐ if not @opt.number
        value = @clampValue v
        if value != @getValue()
            @set value
            if @int() == 0
                @selectAll()

    onWheel: event =>

        ⮐ if not @opt.number
        ⮐ if @hidden() or @collapsed()
        ⮐ if not @cells.isInsideEvent event
        
        dir = switch event.dir
            'up'    ➜  1
            'right' ➜  1
            'down'  ➜ -1
            'left'  ➜ -1
                    ➜ ⮐ 

        step = 1
        step = 10 if event.shift

        @changeValue @int() + dir*step
        
        @state.moveCursors (dir > 0 ? 'eol' : 'bol')

        redraw:true

    onKey: key event ->
        
        ⮐ false if not @hasFocus()
        
        switch event.combo
            
            'return'    
                
                @emit 'action' 'submit' @current()
                ⮐ true
                
            'up' 'down'
                
                @emit 'action' event.combo 
                ⮐ false
                
            'right'
                
                if @state.mainCursor()[0] >= @current().length
                    @emit 'action' 'right'
                    ⮐ true
                    
            'esc'
            
                @emit 'action' 'cancel'
                ⮐ true

        before = @current()

        sr = super key event
        
        if before != @current()
            @changeValue @current() if @opt.number
            @emit 'action' 'change' @current() 
            ⮐ true
        
        sr
        
    draw: ->
        
        ⮐ if @hidden() or @collapsed()

        @setColor 'bg' @hasFocus() ? @color.bg_focus : @color.bg_blur
        @setColor 'empty' @color.bg
        
        super()

export input
