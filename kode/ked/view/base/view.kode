
use ../../../kxk ▪ events post
use ../../theme  ◆ color
use ../screen    ◆ cells 
■view□events
###
    keeps track of
        ▪ screen cells
        ▪ visibility
        ▪ theme colors
        ▪ view features
        ▪ mouse enter and leave
        ▪ current popup
        ▪ focus
###

    @currentPopup: null

    @: @screen @name features ->
        
        @cells = new cells @screen
        @color = {}
        @feats = {}
        @feats[f] = true for f in features
        
        @isVisible = true
        @focusable = false
        @focused   = false
                                
    setColor: key clr => @color[key] = color.values(clr)
        
    show: -> 
    
        @isVisible = true
        
        if @isPopup
            if view.currentPopup and view.currentPopup != @
                popup = view.currentPopup
                view.currentPopup = null
                popup.hide()
            view.currentPopup = @
            # log "view popup.show #{@name}" 
            post.emit 'popup.show' @name
        
        @arrange()
        redraw:true
        
    hide: ->
    
        @isVisible = false 
        
        if @isPopup
            if @ == view.currentPopup
                view.currentPopup = null
                # log "view popup.hide #{@name}" 
                post.emit 'popup.hide' @name
        
        redraw:true
        
    arrange: ->    
    hidden:  -> not @visible()
    visible: -> @isVisible
    toggle:  -> if @hidden() then @show() else @hide()
         
    collapsed: -> @cells.rows <= 0 or @cells.cols <= 0
    
    eventPos: event -> @cells.posForEvent event
    
    onMouse: event => @handleHover event
    onWheel: event => #log "view.onWheel #{@name}"
    
    onMouseLeave: event => post.emit 'redraw'
    onMouseEnter: event => 
        if @focusable
            @grabFocus()
        
        if @pointerType 
            post.emit 'pointer' @pointerType
            post.emit 'redraw'
        
    handleHover: event =>
        
        # log "view.hover #{@name}"

        inside = not event.handled and @cells.isInsideEvent event
        if @hover and not inside
            @hover = false
            @onMouseLeave event
        else if inside and not @hover
            @hover = true
            @onMouseEnter event
        @hover

    setFocusable: f=true ->
     
        if f and not @focusable
            @focusable = true
            post.on 'focus' @onFocus
        else if @focusable and not f
            @focusable = false
            post.removeListener 'focus' @onFocus

    onFocus: name => 
        # log "view.onFocus #{name} #{@name}"
        @focused = (@name == name)
    hasFocus:  => @focused
    grabFocus: =>
        # log "view.grabFocus #{@name}"
        post.emit 'focus' @name
        post.emit 'redraw'
        
    onKey: key event => log "view.onKey #{@name}"
        
    layout: x y w h -> @cells.layout x y w h 
    
    erase: => @cells.erase_scaled 0 0 -1 -1
    
    draw: => 
        
export view
