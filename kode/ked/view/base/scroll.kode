
use ../../../kxk   ▪ post
use ../../theme    ◆ theme
use ../../util/img ◆ squares sircels
use                ◆ view

{pow} = Math
■scroll extends view
###
    scrolls a view
    used by any multiline editor
###
    @: screen @state @side='left' -> 
    
        super screen @state.owner() + '_scroll'
        
        @pointerType = 'pointer'
        
        @setColor 'bg'    theme.gutter.bg
        @setColor 'dot'   theme.scroll.dot
        @setColor 'knob'  theme.scroll.knob
        @setColor 'hover' theme.scroll.hover
            
    onMouse: event =>
        
        [col row] = @eventPos event
        
        super event
        
        switch event.type
            
            'press'
            
                if @hover
                    @doDrag = true
                    post.emit 'pointer''grabbing' 
                    ⮐  @scrollToPixel event.pixel
                    
            'drag'
            
                if @doDrag
                    @hover = true
                    post.emit 'pointer''grab' 
                    ⮐  @scrollToPixel event.pixel
                    
                @hover = false
                
            'release'
            
                if @doDrag
                    post.emit 'pointer''pointer' if @hover
                    delete @doDrag 
                    ⮐  true
        @hover
        
    isActive: ->

        @state.totalRows() > @cells.rows

    knobHeight: csz =>
        
        rows  = @cells.rows
        total = @state.totalRows()

        ⮐ 0 if total <= rows

        kh = int ((rows*rows) / total) * csz[1]
        clamp csz[1] rows*csz[1] kh

    knobOffset: csz =>

        rows  = @cells.rows
        total = @state.totalRows()

        ⮐ 0 if total <= rows

        kh     = @knobHeight csz
        maxTop = max 1 total-rows
        track  = max 0 rows*csz[1]-kh
        offset = int ((track * @state.viewTopRow()) / maxTop)

        clamp 0 track offset
        
    scrollToPixel: pixel =>
    
        ⮐  if empty (csz = @screen.t.cellsz)

        rows   = @cells.rows
        total  = @state.totalRows()
        maxTop = max 0 total-rows

        rowf = pixel[1]/csz[1]-@cells.y
        row  = floor(rowf * (maxTop+1) / max(1 rows-1))

        li     = @state.s.view[1]
        offset = @state.s.scrollOffset

        @state.setScrollTop row

        ⮐  true if @state.s.view[1] == li and @state.s.scrollOffset == offset

        redraw:true
        
    draw: =>

        ⮐  if empty (csz = @screen.t.cellsz)
        
        rows = @cells.rows
        
        @cells.fill_col 0 0 rows ' ' null @color.bg
        
        total = @state.totalRows()
        
        ⮐  if total <= rows
        
        kh = @knobHeight csz
        ky = @knobOffset csz

        fg = @hover ? @color.hover : @color.knob
        
        x  = @cells.x*csz[0]
        y  = int @cells.y*csz[1]+ky
        w  = int csz[0]/2
        h  = int kh
        
        squares.place x int(y+w/2) w h-w fg
        
        sircels.place x y     w (ky ? fg : @color.dot) 1111
        sircels.place x y+h-w w ((y+h < (@cells.y+rows)*csz[1]-1) ? fg : @color.dot) 1111

export scroll
