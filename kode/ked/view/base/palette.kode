
use ../../theme ◆ color
use             ◆ radio
■palette□radio
    # a row of color cells - used by the colorpicker to show and pick palette colors

    @: @screen @name ->

        super @screen @name

        @setFocusable()

    setColors: hexes =>

        @options = []

        for hex in hexes
            rgb = color.values hex
            @options.push {color: rgb label: hex} if rgb?

        if empty @options
            @active  = 0
            ⮐

    draw: =>

        ⮐ if @hidden() or @collapsed()

        w = @cells.cols
        ⮐ if w < 1

        n = @options.length
        ⮐ if n < 1

        @cells.fill_rect 0 0 -1 -1 ' ' null @color.bg

        starts = []
        ends   = []

        for idx in 0...n
            starts.push int(idx*w/n)
            ends.push   int((idx+1)*w/n)
            for x in starts[idx]...ends[idx]
                @cells.set_bg x 0 @options[idx].color

        @cells.set 0 0 '◖' @options[0].color  @color.bg
        
        for idx in 0...n
            @drawCell idx starts[idx] ends[idx]-starts[idx]
        
        @cells.set w-1 0 '◗' @options[-1].color @color.bg

    drawCell: idx start segw =>

        if @focused and idx == @active
            fg = color.subtle @options[idx].color 35
            x = start + max(0 int((segw - 1)/2))
            @cells.set x 0 '●' fg @options[idx].color

export palette
