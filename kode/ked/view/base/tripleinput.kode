
use ../../../kxk ▪ post
use ../../theme  ◆ theme
use              ◆ input view

■tripleinput□view
    @: @screen @name @fields @opt={} ->

        super @screen @name
        
        @focusable = true
        
        @inputs = []
        for field in @fields
            inp = new input @screen "#{@name}_#{field}" @opt
            inp.drawUnfocusedCursors = false
            @inputs.push inp

    onWheel: event =>

        ⮐ if @hidden() or @collapsed()
        ⮐ if not @cells.isInsideEvent event
        
        for input in @inputs
            if input.hasFocus() ➜ ⮐ input.onWheel event
        
    layout: x y w h ->
        
        @layout_hbox x y w h @inputs @opt
        
        super x y w h

    draw: ->
        
        ⮐ if @hidden() or @collapsed()

        super()
        
        for input in @inputs
            input.draw()

    hasFocus: => 
        
        for input in @inputs
            if input.hasFocus() ➜ ⮐ true
        false
    
    grabFocus: => @inputs[0].grabFocus()

    onKey: key event =>

        ⮐ false if not @hasFocus()
        ⮐ false if @hidden() or @collapsed()
        
        for input in @inputs
            if input.hasFocus() ➜ ⮐ input.onKey key event

        false        
        
export tripleinput
