
use ../../../kxk ▪ post
use ../../theme  ◆ theme
use              ◆ input view

■tripleinput□view
    @: @screen @name @fields ->

        super @screen @name
        
        @focusable = true
        
        @inputs = []
        for field in @fields
            inp = new input @screen "#{@name}_#{field}"
            inp.drawUnfocusedCursors = false
            @inputs.push inp

#         @setColor 'bg'       theme.colorpicker.bg
#         @setColor 'bg_blur'  theme.colorpicker.bg
#         @setColor 'bg_focus' theme.selection.line
#         @setColor 'empty'    theme.colorpicker.bg
# 
#         @textColor = theme.colorpicker.fg
#         @value     = 0
#         @set '0'
# 
#         @state.skipAdjustViewForMainCursor = true

        # @pointerType    = 'text'

    onWheel: event =>

        ⮐ if @hidden() or @collapsed()
        ⮐ if not @cells.isInsideEvent event

#         dir = switch event.dir
#             'up'    ➜  1
#             'right' ➜  1
#             'down'  ➜ -1
#             'left'  ➜ -1
#                     ➜ ⮐ 
# 
#         step = 1
#         step = 10 if event.shift
# 
#         @changeValue @value + dir*step
#         
#         @state.moveCursors (dir > 0 ? 'eol' : 'bol')

        redraw:true
        
    layout: x y w h ->
        
        xs = int w / 3
        wi = min xs-1 5
        xi = 0
        for input in @inputs
            input.layout x+xi y wi 1
            xi += xs
    
        super x y w h

    draw: ->
        
        log "#{@hidden()} #{@collapsed()}"
        ⮐ if @hidden() or @collapsed()

        super()
        
        for input in @inputs
            input.draw()

    onKey: key event =>

        ⮐ false if not @hasFocus()
        ⮐ false if @hidden() or @collapsed()
        
        for input in @inputs
            if input.hasFocus() ➜ ⮐ input.onKey key event

        false        
        
export tripleinput
