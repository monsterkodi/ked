###
    ███   ███   ███████   █████████  ████████  ███  ██     ██
    ████ ████  ███   ███     ███     ███   ███  ███   ███   ███
    ███ █ ███  █████████     ███     ███████    ███    █████
    ███   ███  ███   ███     ███     ███   ███  ███     ███
    ███   ███  ███   ███     ███     ███   ███  ███     ███

    a grid of characters
    one blank cell between the characters
    a selected cell with half circles on its left and right
    a scroll bar on the right when the grid overflows
    a double sized mode that uses the kitty text sizing protocol
###

use ../../../kxk    ▪ post
use ../../util/img  ◆ squares sircels
use                 ◆ view

function matrix extends view

    @: screen name ->

        super screen name

        @setColor 'bg'             [0 0 0]
        @setColor 'fg'             [200 200 200]
        @setColor 'selection'      [68 68 170]
        @setColor 'selection_blur' [60 60 60]
        @setColor 'scroll'         [26 26 26]
        @setColor 'scroll_dot'     [136 136 255]

        @items         = []
        @selectedIndex = 0
        @offset        = 0
        @focused       = false
        @double        = false

        post.on 'focus' @onFocus

    onFocus: name => @focused = (name == @name)

    hasFocus: -> @focused

    setItems: items =>

        @items         = items ? []
        @selectedIndex = 0
        @offset        = 0

    setDouble: on =>

        @double = on
        @ensureVisible()

        true

    numItems: -> @items.length

    #  a character is drawn at 2*col+1, so the selection has a cell for
    #  its left half circle even in the first column

    baseColumns: ->

        if @double
            ⮐  max 1 int((@cells.cols - 3) / 4)

        max 1 int((@cells.cols - 1) / 2)

    scrollBarVisible: ->

        ⮐  false if empty @items
        ⮐  false if @cells.rows < 1

        cols = @baseColumns()

        int((@items.length + cols - 1) / cols) > @viewportRows()

    columns: ->

        bar = @scrollBarVisible() ? 1 : 0

        if @double
            ⮐  max 1 int((@cells.cols - 3 - bar) / 4)

        max 1 int((@cells.cols - 1 - bar) / 2)

    rowHeight: -> @double ? 2 : 1

    viewportRows: -> max 0 int(@cells.rows / @rowHeight())

    numRows: ->

        ⮐  0 if empty @items

        cols = @columns()

        int((@items.length + cols - 1) / cols)

    itemText: item =>

        if item is obj
            if valid item.show
                ⮐  item.show
            ⮐  item.char ? ''
        item

    selected: -> @items[@selectedIndex]

    selectedText: => @itemText @selected()

    selectedPos: ->

        cols = @columns()

        [@selectedIndex % cols int(@selectedIndex / cols)]

    # ███████  ████████  ███      ████████   ███████  █████████  
    # ███      ███       ███      ███       ███          ███     
    # ███████  ███████   ███      ███████   ███          ███     
    #      ███ ███       ███      ███       ███          ███     
    # ███████  ████████  ███████  ████████   ███████     ███     

    selectFirst: =>

        @selectedIndex = 0
        @offset        = 0

    cellAtPos: x y =>

        if @double
            ⮐  [int((x-3)/4) int(y/2)]

        [int((x-1)/2) y]

    selectAt: col row =>

        cols = @columns()
        idx  = (@offset + row) * cols + col

        ⮐  false if idx < 0 or idx >= @items.length

        @selectedIndex = idx

        true

    ensureVisible: ->

        cols = @columns()
        rows = max 1 @viewportRows()
        row  = int(@selectedIndex / cols)

        @offset = row if row < @offset
        @offset = row - rows + 1 if row >= @offset + rows

        maxOffset = max 0 (@numRows() - rows)

        @offset = clamp 0 maxOffset @offset

    moveSelection: dir =>

        ⮐  false if empty @items

        cols   = @columns()
        rows   = max 1 @viewportRows()
        before = @selectedIndex
        lastIndex = @items.length - 1

        switch dir
            'left'     ➜ @selectedIndex = max 0 (@selectedIndex - 1)
            'right'    ➜ @selectedIndex = min lastIndex (@selectedIndex + 1)
            'up'       ➜ @selectedIndex = max 0 (@selectedIndex - cols)
            'down'     ➜ @selectedIndex = min lastIndex (@selectedIndex + cols)
            'pageup'   ➜ @selectedIndex = max 0 (@selectedIndex - cols * rows)
            'pagedown' ➜ @selectedIndex = min lastIndex (@selectedIndex + cols * rows)

        @ensureVisible()

        @selectedIndex != before

    grabFocus: =>

        post.emit 'focus' @name
        post.emit 'redraw'

    # ████████   ████████    ███████   ███   ███  
    # ███   ███  ███   ███  ███   ███  ███ █ ███  
    # ███   ███  ███████    █████████  █████████  
    # ███   ███  ███   ███  ███   ███  ███   ███  
    # ███████    ███   ███  ███   ███  ██     ██  

    draw: =>

        ⮐  if @hidden() or @collapsed()

        @cells.fill_rect 0 0 -1 -1 ' ' null @color.bg

        if not empty @items
            if @double
                @drawDouble()
            else
                @drawSingle()

        @drawScrollBar()

    drawSingle: ->

        cols = @columns()

        for row in 0...@viewportRows()

            for col in 0...cols

                idx = (@offset + row) * cols + col

                break if idx >= @items.length

                @cells.set col*2+1 row @itemText(@items[idx]) @color.fg @color.bg

        ⮐  if @selectedIndex < 0 or @selectedIndex >= @items.length

        [col row] = @selectedPos()

        y = row - @offset

        ⮐  if y < 0 or y >= @cells.rows

        x  = col*2 + 1
        fg = @focused ? @color.selection : @color.selection_blur

        @cells.set_bg x y fg

        @cells.adjustContrastForHighlight x y fg

        @cells.set_ch_fg x-1 y '' fg
        @cells.set_ch_fg x+1 y '' fg

    #  each character is a 2 by 2 block in kitty's text sizing protocol
    #  the cells in the second row are jumped over so the blocks do not
    #  shift the rest of the line

    drawDouble: ->

        cols = @columns()

        for row in 0...@viewportRows()

            for col in 0...cols

                idx = (@offset + row) * cols + col

                break if idx >= @items.length

                @doubleCell 3+col*4 row*2 @itemText(@items[idx]) @color.fg @color.bg

        ⮐  if @selectedIndex < 0 or @selectedIndex >= @items.length

        [col row] = @selectedPos()

        y = (row - @offset) * 2

        ⮐  if y < 0 or y >= @cells.rows

        x  = 3 + col*4
        fg = @focused ? @color.selection : @color.selection_blur

        @cells.set_bg x y fg

        @cells.adjustContrastForHighlight x y fg

        @doubleCell x-2 y '' fg @color.bg
        @doubleCell x+2 y '' fg @color.bg

    doubleCell: x y char fg bg ->

        if @cells.screen.t.headless
            @cells.set x   y   char fg bg
            @cells.set x+1 y   null null null
            @cells.set x   y+1 null null null
            @cells.set x+1 y+1 null null null
            ⮐

        @cells.set x   y   @doubleText(char) fg bg
        @cells.set x+1 y   null null null
        @cells.set x   y+1 @skipText() null null
        @cells.set x+1 y+1 null null

    doubleText: char -> '\x1b]66;s=2:w=1;' + char + '\x07'

    skipText: -> '\x1b[2C'

    drawScrollBar: ->

        ⮐  if not @scrollBarVisible()
        ⮐  if empty (csz = @screen.t.cellsz)

        rows = @viewportRows()

        ⮐  if rows < 1

        num = @numRows()

        ⮐  if num <= rows

        regionH = @cells.rows * csz[1]
        rowH    = csz[1] * @rowHeight()

        kh = ((rows*rows) / num) * rowH
        ky = ((regionH-kh) * @offset / (num-rows))

        fg = @color.scroll

        x = (@cells.x + @cells.cols - 1) * csz[0]
        y = int @cells.y*csz[1]+ky
        w = int csz[0]/2
        h = int kh

        squares.place x int(y+w/2) w h-w fg

        sircels.place x y     w (ky ? fg : @color.scroll_dot) 1111
        sircels.place x y+h-w w ((y+h < (@cells.y+@cells.rows)*csz[1]-1) ? fg : @color.scroll_dot) 1111

export matrix
