###
    ██     ██   ███████   █████████  ████████   ███  ███   ███  
    ███   ███  ███   ███     ███     ███   ███  ███   ███ ███   
    █████████  █████████     ███     ███████    ███    █████    
    ███ █ ███  ███   ███     ███     ███   ███  ███   ███ ███   
    ███   ███  ███   ███     ███     ███   ███  ███  ███   ███  

    a grid of characters
###

use ../../../kxk    ▪ post
use ../../util/img  ◆ squares sircels
use                 ◆ view

function matrix extends view

    @: screen name ->

        super screen name

        @setColor 'bg'             [0 0 0]
        @setColor 'fg'             [200 200 200]
        @setColor 'selection'      [68 68 170]
        @setColor 'selection_blur' [60 60 60]
        @setColor 'scroll'         [26 26 26]
        @setColor 'scroll_dot'     [136 136 255]

        @items         = []
        @selectedIndex = 0
        @offset        = 0
        @focused       = false
        @scale         = 1

        post.on 'focus' @onFocus

    onFocus: name => @focused = (name == @name)

    hasFocus: -> @focused

    setItems: items =>

        @items         = items ? []
        @selectedIndex = 0
        @offset        = 0

    incScale: delta =>

        before = @scale

        @scale += delta
        @scale = clamp 1 4 @scale

        #  the terminal keeps the multicell characters of the old scale
        #  around when the layout changes, so erase the matrix area
        #  whenever the scale really changes

        if @scale != before
            @clearArea()

        @ensureVisible()

        true

    clearArea: ->

        ⮐  if @cells.screen.t.headless

        t = @cells.screen.t

        for row in 0...@cells.rows
            t.setCursor @cells.x (@cells.y+row)
            t.write "\x1b[#{@cells.cols}X"

    numItems: -> @items.length

    #  the first character starts at @scale, leaving room for its left
    #  half circle. the half circles and the space between the characters
    #  are each @scale cells wide.

    baseColumns: ->

        s = @scale

        max 1 int((@cells.cols - s) / (s * 2))

    scrollBarVisible: ->

        ⮐  false if empty @items
        ⮐  false if @cells.rows < 1

        cols = @baseColumns()

        int((@items.length + cols - 1) / cols) > @viewportRows()

    columns: ->

        s   = @scale
        bar = @scrollBarVisible() ? 1 : 0

        max 1 int((@cells.cols - bar - s) / (s * 2))

    viewportRows: -> max 0 int(@cells.rows / @scale)

    numRows: ->

        ⮐ 0 if empty @items

        cols = @columns()

        Math.ceil(@items.length / cols)

    itemText: item =>

        if item is obj
            if valid item.show
                ⮐  item.show
            ⮐  item.char ? ''
        item

    selected: -> @items[@selectedIndex]

    selectedText: => @itemText @selected()

    selectedPos: ->

        cols = @columns()

        [@selectedIndex % cols int(@selectedIndex / cols)]

    # ███████  ████████  ███      ████████   ███████  █████████  
    # ███      ███       ███      ███       ███          ███     
    # ███████  ███████   ███      ███████   ███          ███     
    #      ███ ███       ███      ███       ███          ███     
    # ███████  ████████  ███████  ████████   ███████     ███     

    selectFirst: =>

        @selectedIndex = 0
        @offset        = 0

    cellAtPos: x y =>

        s = @scale

        [int((x-s)/(s*2)) int(y/s)]

    selectAt: col row =>

        cols = @columns()
        idx  = (@offset + row) * cols + col

        ⮐ false if idx < 0 or idx >= @items.length

        @selectedIndex = idx

        true

    ensureVisible: ->

        cols = @columns()
        rows = max 1 @viewportRows()
        row  = int(@selectedIndex / cols)

        @offset = row if row < @offset
        @offset = row - rows + 1 if row >= @offset + rows

        maxOffset = max 0 (@numRows() - rows)

        @offset = clamp 0 maxOffset @offset

    moveSelection: dir =>

        ⮐  false if empty @items

        cols   = @columns()
        rows   = max 1 @viewportRows()
        before = @selectedIndex
        lastIndex = @items.length - 1

        switch dir
            'left'     ➜ @selectedIndex = max 0 (@selectedIndex - 1)
            'right'    ➜ @selectedIndex = min lastIndex (@selectedIndex + 1)
            'up'       ➜ @selectedIndex = max 0 (@selectedIndex - cols)
            'down'     ➜ @selectedIndex = min lastIndex (@selectedIndex + cols)
            'pageup'   ➜ @selectedIndex = max 0 (@selectedIndex - cols * rows)
            'pagedown' ➜ @selectedIndex = min lastIndex (@selectedIndex + cols * rows)

        @ensureVisible()

        @selectedIndex != before

    grabFocus: =>

        post.emit 'focus' @name
        post.emit 'redraw'

    # ████████   ████████    ███████   ███   ███  
    # ███   ███  ███   ███  ███   ███  ███ █ ███  
    # ███   ███  ███████    █████████  █████████  
    # ███   ███  ███   ███  ███   ███  ███   ███  
    # ███████    ███   ███  ███   ███  ██     ██  

    draw: =>

        ⮐  if @hidden() or @collapsed()

        @cells.fill_rect 0 0 -1 -1 ' ' null @color.bg

        if not empty @items
            
            cols = @columns()
    
            for row in 0...@viewportRows()
    
                for col in 0...cols
    
                    idx = (@offset + row) * cols + col
    
                    break if idx >= @items.length
    
                    if @scale == 1
                        @cells.set col*2+1 row @itemText(@items[idx]) @color.fg @color.bg
                    else
                        @scaledCell @scale+col*@scale*2 row*@scale @itemText(@items[idx]) @color.fg @color.bg
    
            ⮐  if @selectedIndex < 0 or @selectedIndex >= @items.length
    
            [col row] = @selectedPos()

            y = (row - @offset) * @scale

            ⮐  if y < 0 or y >= @cells.rows
    
            x  = @scale + col*(@scale*2)
            fg = @focused ? @color.selection : @color.selection_blur
    
            @cells.set_bg x y fg
    
            @cells.adjustContrastForHighlight x y fg

            if @scale == 1
                @cells.set_ch_fg x-1 y '' fg
                @cells.set_ch_fg x+1 y '' fg
            else 
                @scaledCell x-@scale y '' fg @color.bg
                @scaledCell x+@scale y '' fg @color.bg

        @drawScrollBar()

    scaledCell: x y char fg bg ->
    
        if @cells.screen.t.headless
            @cells.set x y char fg bg
            for j in 0...@scale
                for i in 0...@scale
                    if i or j
                        @cells.set x+i y+j null null null
            ⮐

        @cells.set x y @scaleText(char) fg bg
        
        for j in 0...@scale
            for i in 0...@scale
                if i or j
                    @cells.set x+i y+j (i==0 ? @skipText() : null) null null
                    # @cells.set x+i y+j null null null

    scaleText: char -> "\x1b]66;s=#{@scale}:w=1;" + char + '\x07'

    skipText: -> "\x1b[#{@scale}C"

    drawScrollBar: ->

        ⮐  if not @scrollBarVisible()
        ⮐  if empty (csz = @screen.t.cellsz)

        rows = @viewportRows()

        ⮐  if rows < 1

        num = @numRows()

        ⮐  if num <= rows

        regionH = @cells.rows * csz[1]
        rowH    = csz[1] * @scale

        kh = ((rows*rows) / num) * rowH
        ky = ((regionH-kh) * @offset / (num-rows))

        fg = @color.scroll

        x = (@cells.x + @cells.cols - 1) * csz[0]
        y = int @cells.y*csz[1]+ky
        w = int csz[0]/2
        h = int kh

        squares.place x int(y+w/2) w h-w fg

        sircels.place x y     w (ky ? fg : @color.scroll_dot) 1111
        sircels.place x y+h-w w ((y+h < (@cells.y+@cells.rows)*csz[1]-1) ? fg : @color.scroll_dot) 1111

export matrix
