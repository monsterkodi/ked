###
    ██     ██   ███████   ████████    ███████   ███████  ████████   
    ███   ███  ███   ███  ███   ███  ███       ███       ███   ███  
    █████████  █████████  ████████   ███████   ███       ███████    
    ███ █ ███  ███   ███  ███             ███  ███       ███   ███  
    ███   ███  ███   ███  ███        ███████    ███████  ███   ███  

    scrollable source map to the right of the fileeditor
###

use ../../../kxk    ▪ post
use ../../theme     ◆ theme
use ../../util      ◆ config
use ../../util/img  ◆ squares
use ../../edit/tool ◆ belt
use                 ◆ mapview

function mapscr extends mapview

    @: @editor ->
        
        super @editor.screen @editor.state
        
        @state.on 'view.changed' @drawKnob
        
        @pointerType = 'pointer'
        
        @knobId = @imgId+0xeeee
        
        @topLine    = 0 # index of first visible line
        @botLine    = 0 # index of last visible line
        @topRow     = 0 # display row at the top of the map
        @knobHeight = 0 # height of the knob in pixels
        @mapWidth   = 0 # width of the map in pixels
        @mapHeight  = 0 # height of the map in pixels
        @linesInMap = 0 # number of display rows that fit into map
        
        @setColor 'bg'        theme.editor.mapscr
        @setColor 'highlight' theme.highlight.map
        @setColor 'selection' theme.selection.map
        @setColor 'fullysel'  theme.selection.mapfully
        
        @screen.t.on 'preResize' @clearImages
        
        post.on 'greet.show' @hide
        post.on 'greet.hide' @show
        post.on 'popup.hide' @show
        post.on 'popup.show' (name) =>
            @hide() if name in ['differ' 'searcher']
            @show() if name in ['finder' 'vinder']
        
        @editor.state.on 'lines.changed' @onLinesChanged
        @editor.state.on 'colors.changed' (=> @reload())
        
        @calcView()
        
    # ███      ███  ███   ███  ████████   ███████         ███████  ███   ███   ███████   ███   ███   ███████   ████████  ███████  
    # ███      ███  ████  ███  ███       ███             ███       ███   ███  ███   ███  ████  ███  ███        ███       ███   ███
    # ███      ███  ███ █ ███  ███████   ███████         ███       █████████  █████████  ███ █ ███  ███  ████  ███████   ███   ███
    # ███      ███  ███  ████  ███            ███        ███       ███   ███  ███   ███  ███  ████  ███   ███  ███       ███   ███
    # ███████  ███  ███   ███  ████████  ███████          ███████  ███   ███  ███   ███  ███   ███   ███████   ████████  ███████  

    onLinesChanged: diff =>
        
        if diff.del.length == 0 == diff.chg.length
            @reload()
        else
            if diff.chg.length and diff.del.length == 0 == diff.ins.length
                for cli in diff.chg
                    @updateLine cli
            else
                minLine = @state.s.lines.length
                minLine = min minLine diff.ins[0] if diff.ins.length
                minLine = min minLine diff.del[0] if diff.del.length
                for cli in diff.chg
                    break if cli >= minLine
                    @updateLine cli
                @updateFromLine minLine
        
    getSegls:  => @state.segls
    getSyntax: => @state.syntax
    getColors: => @state.s.colors
    
    # ██     ██   ███████   ███   ███   ███████  ████████  
    # ███   ███  ███   ███  ███   ███  ███       ███       
    # █████████  ███   ███  ███   ███  ███████   ███████   
    # ███ █ ███  ███   ███  ███   ███       ███  ███       
    # ███   ███   ███████    ███████   ███████   ████████  
    
    onMouse: event =>
        
        super event
        
        switch event.type
            
            'press'
            
                if @hover
                    @doDrag = true
                    post.emit 'pointer''grabbing'
                    ⮐  @scrollToPixel event.pixel
                    
            'drag'
            
                if @doDrag
                    post.emit 'pointer''grab'
                    ⮐  @scrollToPixel event.pixel
                    
                @hover = false
                
            'release'
            
                if @doDrag
                    delete @doDrag 
                    post.emit 'pointer''pointer' if @hover
                    ⮐  true
        @hover
    
    # ████████   ████████   ███████  ███  ███████  ████████  
    # ███   ███  ███       ███       ███     ███   ███       
    # ███████    ███████   ███████   ███    ███    ███████   
    # ███   ███  ███            ███  ███   ███     ███       
    # ███   ███  ████████  ███████   ███  ███████  ████████  
    
    onResize: =>
        
        csz = @cells.screen.t.cellsz
        
        ⮐  if empty csz
        
        @csz = csz
        
        @calcView()
        @redraw = true
        
    #  ███████   ███████  ████████    ███████   ███      ███      █████████   ███████   
    # ███       ███       ███   ███  ███   ███  ███      ███         ███     ███   ███  
    # ███████   ███       ███████    ███   ███  ███      ███         ███     ███   ███  
    #      ███  ███       ███   ███  ███   ███  ███      ███         ███     ███   ███  
    # ███████    ███████  ███   ███   ███████   ███████  ███████     ███      ███████   
    
    scrollToPixel: pixel =>
        
        view = @state.s.view.asMutable()
        
        clickOffset = config.data?.mapScroll?.clickOffset ? 0
        
        row  = @topRow + int((pixel[1] - clickOffset - @mapY) / @pixelsPerRow)
        crow = @topRow + int((pixel[1] + clickOffset * @pixelsPerRow - @mapY) / @pixelsPerRow)
        li   = @state.lineAtAbsoluteRow row
        cli  = @state.lineAtAbsoluteRow crow
        scrollOffset = row - @state.rowsBeforeLine(li)
        log "scrollToPixel #{li} #{cli} #{clickOffset}"
        view[1] = li
        # view[1] -= clickOffset # offset so that clicking inside a header scrolls it into view
        view[1] = clamp 0 @state.maxViewLine() view[1]
        
        mc = @state.mainCursor()
        
        if view eql @state.s.view and scrollOffset == @state.s.scrollOffset
            if cli != mc[1]
                # @state.setCursors [[mc[0] li+clickOffset]] main:0 adjust:false
                @state.setCursors [[mc[0] cli]] main:0 adjust:false
                ⮐  redraw:true
            ⮐  
        
        @state.setView view scrollOffset
        # @state.setCursors [[mc[0] li+clickOffset]] main:0 adjust:false
        @state.setCursors [[mc[0] cli]] main:0 adjust:false
        
        @drawKnob()
        redraw:true
        
    #  ███████   ███████   ███       ███████  ███   ███  ███  ████████  ███   ███
    # ███       ███   ███  ███      ███       ███   ███  ███  ███       ███ █ ███
    # ███       █████████  ███      ███        ███ ███   ███  ███████   █████████
    # ███       ███   ███  ███      ███          ███     ███  ███       ███   ███
    #  ███████  ███   ███  ███████   ███████      █      ███  ████████  ██     ██

    calcView: ->
    
        @mapX       = @cells.x*@csz[0]
        @mapY       = @cells.y*@csz[1]
        
        @mapHeight  = @cells.rows * @csz[1]
        @mapWidth   = @cells.cols * @csz[0]
        
        @mapBot     = @mapY + @mapHeight - @pixelsPerRow
        
        @linesInMap = max 1 int(@mapHeight / @pixelsPerRow)
        @knobHeight = @state.cells.rows * @pixelsPerRow

        totalRows  = @state.totalRows()
        viewTopRow = @state.viewTopRow()

        if totalRows > @linesInMap and viewTopRow > 0
            maxOffset  = max 0 totalRows - @linesInMap
            denom      = max 1 totalRows - @state.cells.rows
            viewFactor = clamp 0 1 (viewTopRow / denom)
            @topRow    = int(viewFactor * maxOffset)
        else
            @topRow = 0

        @topLine = @state.lineAtAbsoluteRow @topRow

        bottom = @topRow + @linesInMap
        li     = @topLine
        last   = @topLine-1

        while li < @state.s.lines.length and @state.rowsBeforeLine(li) < bottom
            last = li
            li  += 1

        @botLine = last

    lineRows: y => @state.lineHeight y

    lineOffsetPixels: y => @lineOffset y

    lineOffset: y -> (@state.rowsBeforeLine(y) - @topRow) * @pixelsPerRow
        
    pixelPos: pos -> 
       [
           @mapX + pos[0]*@pixelsPerCol*@lineRows(pos[1])
           @mapY + @lineOffset(pos[1])
       ]
    
    maxLinesToLoad: => 10000
    
    ###
    ███████    ████████    ███████   ███   ███
    ███   ███  ███   ███  ███   ███  ███ █ ███
    ███   ███  ███████    █████████  █████████
    ███   ███  ███   ███  ███   ███  ███   ███
    ███████    ███   ███  ███   ███  ██     ██
    ###
    
    draw: =>
    
        ⮐  if @hidden() or @collapsed()
        
        super()
        
        if not empty @csz
        
            @drawCursors()    
            @drawHighlights() 

    # ███  ██     ██   ███████    ███████   ████████   ███████
    # ███  ███   ███  ███   ███  ███        ███       ███     
    # ███  █████████  █████████  ███  ████  ███████   ███████ 
    # ███  ███ █ ███  ███   ███  ███   ███  ███            ███
    # ███  ███   ███  ███   ███   ███████   ████████  ███████ 

    drawImages: =>
        
        t = @cells.screen.t
        
        ⮐  if empty t.pixels or @hidden() or @collapsed()

        @calcView()

        if @botLine >= @topLine
            py = (@state.rowsBeforeLine(@topLine) - @topRow) * @pixelsPerRow

            for y in @topLine..@botLine
                id = @images[y]
                break if not valid id
                rh = @state.lineHeight(y) * @pixelsPerRow
                y1 = max 0 py
                y2 = min @mapHeight (py+rh)
                t.placeLineImage id @cells.x @cells.y y1 (y2-y1) if y2 > y1
                py += rh
            
        if @topLine > 0 and @topLine <= @images.length
            t.hideImagesInRange @images[0] @images[@topLine-1]
        if @botLine >= @topLine and @botLine+1 < @images.length
            t.hideImagesInRange @images[@botLine+1] @images[-1]
        
        @drawKnob()
                
    # ███   ███  ███   ███   ███████   ███████  
    # ███  ███   ████  ███  ███   ███  ███   ███
    # ███████    ███ █ ███  ███   ███  ███████  
    # ███  ███   ███  ████  ███   ███  ███   ███
    # ███   ███  ███   ███   ███████   ███████  

    drawKnob: =>
    
        ⮐  if empty @csz
        
        @calcView()
                
        ⮐  if @hidden() or @collapsed()
        
        maxKy = max 0 @mapHeight-@knobHeight
        offsetRow = (@state.viewTopRow() - @topRow) * @pixelsPerRow
        ky    = clamp 0 maxKy offsetRow
        
        @cells.screen.t.placeImageOverlay @knobId @cells.x @cells.y ky @mapWidth @knobHeight

    hide: =>
    
        ⮐  if @hidden()
        
        @cells.screen.t.hideImageOverlay @knobId
        
        super()
        
    #  ███████  ███   ███  ████████    ███████   ███████   ████████    ███████
    # ███       ███   ███  ███   ███  ███       ███   ███  ███   ███  ███     
    # ███       ███   ███  ███████    ███████   ███   ███  ███████    ███████ 
    # ███       ███   ███  ███   ███       ███  ███   ███  ███   ███       ███
    #  ███████   ███████   ███   ███  ███████    ███████   ███   ███  ███████ 

    drawCursors: =>
        
        for pos,idx in @state.s.cursors
        
            [sx sy] = @pixelPos pos 
            
            continue if sy < @mapY or sy >= @mapBot
            continue if sx < @mapX or sx >= @mapX + @mapWidth
        
            if idx == @state.s.main
                fg = theme.cursor.main
                sw = @pixelsPerCol*2
                sx -= int @pixelsPerCol/2
            else
                fg = theme.cursor.multi
                sw = @pixelsPerCol
                
            squares.place sx sy sw @pixelsPerRow fg
            
            if idx == @state.s.main
                squares.place @cells.x*@csz[0]+@mapWidth-@pixelsPerCol*4 sy @pixelsPerCol*4 @pixelsPerRow fg 2002

    # ███   ███  ███   ███████   ███   ███  ███      ███   ███████   ███   ███  █████████   ███████  
    # ███   ███  ███  ███        ███   ███  ███      ███  ███        ███   ███     ███     ███       
    # █████████  ███  ███  ████  █████████  ███      ███  ███  ████  █████████     ███     ███████   
    # ███   ███  ███  ███   ███  ███   ███  ███      ███  ███   ███  ███   ███     ███          ███  
    # ███   ███  ███   ███████   ███   ███  ███████  ███   ███████   ███   ███     ███     ███████   
    
    drawHighlights: =>
        
        mc = @state.mainCursor()
        
        xoff = @mapX + @mapWidth
        selw = @pixelsPerCol*16
        hlw  = @pixelsPerCol*8
    
        for li in belt.lineIndicesForRangesAndPositions @state.s.selections []
                
            sy = @mapY + @lineOffset(li) 
            continue if sy < @mapY or sy >= @mapBot
            
            if @state.isSpanSelectedLine li 
                clr = @color.selection
            else
                clr = @color.fullysel
                
            squares.place xoff-selw sy selw @pixelsPerRow clr 2000
    
        for li in belt.lineIndicesForSpans @state.s.highlights
        
            sy = @mapY + @lineOffset(li) 
            continue if sy < @mapY or sy >= @mapBot
            
            squares.place xoff-hlw sy hlw @pixelsPerRow @color.highlight 2001

export mapscr
