
use ../../../kxk ▪ post kseg
use ../../util/img ◆ squares
use ../../util     ◆ git gitblock
use ../../edit     ◆ mode 
use ../../theme    ◆ color theme 
use ../base        ◆ view

■gutter□view

###
    displays line numbers to the left of an editor
    used in fileeditor and searcher/finder 
    searcher/finder replaces lineno to display source line numbers 

    a click with a modifier on a git change block
    reverts the block in the buffer and keeps the working lines
    a second click on the same block restores them
###
    @: @editor ->
    
        @state = @editor.state
        
        super @editor.screen @state.owner() + '.gutter'
        
        @setColor 'fg'                theme.gutter.fg
        @setColor 'bg'                theme.gutter.bg
        @setColor 'bg_selected'       theme.gutter.bg_selected
        @setColor 'bg_fully_selected' theme.gutter.bg_fully_selected
        @setColor 'bg_git_mod'        theme.gutter.bg_git_mod
        @setColor 'bg_git_add'        theme.gutter.bg_git_add
        @setColor 'bg_git_del'        theme.gutter.bg_git_del
        @setColor 'bg_git_revert_mod' theme.gutter.bg_git_revert_mod
        @setColor 'bg_git_revert_add' theme.gutter.bg_git_revert_add
        @setColor 'bg_git_revert_del' theme.gutter.bg_git_revert_del
        @setColor 'bg_git_hover'      theme.gutter.bg_git_hover
        @setColor 'cursor_main'       theme.cursor.main
        @setColor 'cursor_multi'      theme.cursor.multi
        @setColor 'selection'         theme.selection.span
        @setColor 'selection_line'    theme.selection.line
        @setColor 'highlight'         theme.highlight.bg
        
        @blocks     = []
        @entries    = []
        @lineMarks  = {}
        @gitBlocks  = []
        @hoverBlock = null
        @gitFile    = null
        @canRevert  = true
        @busy       = false
        
        @state.on 'lines.changed'  @onLinesChanged
        @state.on 'colors.changed' @onColorsChanged
        
        post.on 'mode.start' @onModeStart
        post.on 'mode.stop'  @onModeStop
        
    onModeStart: state name =>
    
        ⮐ if state != @state
        if name == 'novim'
            @setColor 'cursor_main'     theme.novim.cursor.main
            @setColor 'cursor_multi'    theme.novim.cursor.multi

    onModeStop: state name =>
    
        ⮐ if state != @state
        if name == 'novim'
            @setColor 'cursor_main'     theme.cursor.main
            @setColor 'cursor_multi'    theme.cursor.multi

#!git

    clearChanges: =>
        
        @blocks     = []
        @entries    = []
        @lineMarks  = {}
        @gitBlocks  = []
        @hoverBlock = null
        @gitFile    = null
        @canRevert  = true
        
    onGitDiff: diff =>
        
        @gitFile   = diff.file
        @canRevert = not diff.newFile
        @hoverBlock = null
        
        @blocks = []
        @reattach()
        
        lines = @textLines()
        
        for block in gitblock.fromDiff diff
            continue if @isShadowed block
            block.before = lines[block.start-1]
            block.after  = lines[block.end]
            @blocks.push block
            
        @rebuildMarks()
            
        post.emit 'redraw'
        
    isShadowed: block ->
    
        for entry in @entries
            ⮐ true if gitblock.overlaps block entry
            
        for other in @blocks
            ⮐ true if gitblock.intervalOverlap block.start block.end other.start other.end
            
        false
        
    reattach: scanBlocks=false =>
    
        lines   = @textLines()
        blocks  = @blocks.slice()
        entries = []
        
        for entry in @entries
            
            moved = gitblock.reanchorEntry entry lines
            
            if moved
                entries.push moved
            else
                block = gitblock.undoneBlock entry lines
                blocks.push block if block
                
        if scanBlocks
            
            kept = []
            
            for block in blocks
                if gitblock.matchesNew block lines
                    kept.push block
                else
                    entry = gitblock.stashedBlock block lines
                    if entry
                        entries.push entry
                    else
                        kept.push block
                        
            blocks = kept
                
        @blocks  = blocks.sort (a b) -> a.start-b.start
        @entries = entries
        
    rebuildMarks: =>
    
        @lineMarks = {}
        @gitBlocks = []
        
        for block in @blocks
            for line,kind of block.marks
                @lineMarks[int line] = {kind:kind block:block reverted:false}
            @gitBlocks.push [block.start block.end-block.start block.mods false]
            
        for entry in @entries
            for line,kind of entry.marks
                @lineMarks[int line] = {kind:kind entry:entry reverted:true}
            @gitBlocks.push [entry.start entry.end-entry.start entry.block.mods true]
            
    onLinesChanged: =>
    
        ⮐ if @busy
        ⮐ if empty @entries
        @reattach(false)
        @rebuildMarks()
        post.emit 'redraw'
        
    onColorsChanged: =>
    
        ⮐ if @busy
        ⮐ if empty @entries and empty @blocks
        @reattach(true)
        @rebuildMarks()
        post.emit 'redraw'
        
    textLines: => @state.s.lines.map (l) -> kseg.str l
    
    changeColor: kind ->
    
        switch kind
            'mod' ➜ @color.bg_git_mod
            'add' ➜ @color.bg_git_add
            'del' ➜ @color.bg_git_del
            else  ➜ @color.bg_git_add
            
    revertColor: kind ->
    
        switch kind
            'mod' ➜ @color.bg_git_revert_mod
            'add' ➜ @color.bg_git_revert_add
            'del' ➜ @color.bg_git_revert_del
            else  ➜ @color.bg_git_revert_add

#!revert

    onMouse: event =>
        
        ⮐ if not @visible()

        if @cells.isOutsideEvent event
            if valid @hoverBlock
                @hoverBlock = null
                post.emit 'redraw'
            ⮐ 
                
        if not (event.cmd or event.ctrl or event.alt)
            if valid @hoverBlock
                @hoverBlock = null
                ⮐ redraw:true
            ⮐ 

        pos  = @eventPos event
        idx  = @state.lineAtRow pos[1]
        mark = @lineMarks[idx]

        if event.type == 'press'
        
            button = event.button ? 'left'
            ⮐ if button != 'left'
            
            if mark and @toggle mark
                @editor.grabFocus()
                
            ⮐ redraw:true
            
        if event.type == 'move'
        
            block = if mark? ➜ mark.reverted ? mark.entry : mark.block
            
            if block != @hoverBlock
                @hoverBlock = block
                ⮐ redraw:true
                
    toggle: mark =>
    
        if mark.reverted
            @restoreEntry mark.entry
        else
            @revertBlock mark.block
            
    toggleAtLine: line =>
    
        mark = @lineMarks[line]
        ⮐ false if not mark
        @toggle mark
            
    revertBlock: block =>
    
        if not @canRevert
            # log 'gutter: no committed version to revert to' @gitFile
            ⮐ false
            
        entry = gitblock.revert block @textLines()
        
        if not valid entry
            log 'gutter: stale diff, refreshing' @gitFile
            @refreshDiff()
            ⮐ false
            
        @applyEdits gitblock.revertEdits(entry)
        
        @blocks = @blocks.filter (b) -> b != block
        @shiftAfter block.end entry.end-block.end
        @entries.push entry
        
        @hoverBlock = null
        @rebuildMarks()
        @focusBlock entry
        true
        
    restoreEntry: entry =>
    
        block = gitblock.restore entry @textLines()
        
        if not valid block
            log 'gutter: reverted lines were changed, dropping the block'
            @entries = @entries.filter (e) -> e != entry
            @hoverBlock = null
            @rebuildMarks()
            ⮐ false
            
        @applyEdits gitblock.restoreEdits(entry)
        
        @entries = @entries.filter (e) -> e != entry
        @shiftAfter entry.end block.end-entry.end
        
        @blocks.push block
        @blocks.sort (a b) -> a.start-b.start
        
        @hoverBlock = null
        @rebuildMarks()
        @focusBlock block
        true
        
    focusBlock: block =>
    
        line = clamp 0 @state.s.lines.length-1 (gitblock.firstLine(block))
        @state.setCursors [[0 line]]
        
    applyEdits: edits =>
    
        segls = edits.map (edit) -> [edit[0] edit[1] edit[2].map((line) -> kseg(line))]
        
        @busy = true
        @state.replaceLineRanges segls
        @busy = false
        
    shiftAfter: from delta =>
    
        ⮐ if delta == 0
        
        @blocks  = @blocks.map  (b) -> (b.start >= from ? gitblock.shiftBlock(b delta) : b)
        @entries = @entries.map (e) -> (e.start >= from ? gitblock.shiftEntry(e delta) : e)
        
    refreshDiff: =>
    
        ⮐ if not valid @gitFile
        git.diff @gitFile

#!draw

    lineno: y ->
    
        mcy = @state.mainCursor()[1] 
        if mode.isActive(@state 'novim') and y != mcy
            y -= mcy + 1
        lineno = lpad @cells.cols-1 y+1
        lineno += ' '
        lineno
        
    fgcolor: x y ->

    drawGitScroll: ->
    
        ⮐ if empty @gitBlocks
        csz = @screen.t.cellsz
        ⮐ if empty csz
        
        sw = int csz[0]/2 
        sx = (@cells.x-1)*csz[0]
        oy = @cells.y*csz[1]
        pixelsPerRow = clamp 0 csz[1] csz[1] * @cells.rows / @state.s.lines.length
        
        for gb in @gitBlocks
        
            sy       = int gb[0]*pixelsPerRow + oy
            reverted = gb[3]
            
            modColor = reverted ? @color.bg_git_revert_mod : @color.bg_git_mod
            addColor = reverted ? @color.bg_git_revert_add : @color.bg_git_add
            delColor = reverted ? @color.bg_git_revert_del : @color.bg_git_del
            
            if gb[1] <= 0
                fg = delColor
                sh = int pixelsPerRow
            else
                fg = gb[2] ? modColor : addColor
                sh = int gb[1]*pixelsPerRow 
    
            if gb[2] and gb[2] < gb[1]
                mh = int gb[2]*pixelsPerRow 
                squares.place sx sy sw mh modColor
                sy += mh
                ah  = sh-mh
                squares.place sx sy sw ah addColor
            else
                squares.place sx sy sw sh fg
        
    draw: ->
        
        ⮐ if not @visible()
        
        mainCursor = @state.mainCursor()
        
        li  = @state.s.view[1]
        row = -@state.s.scrollOffset

        while row < @cells.rows and li < @state.s.lines.length

            scale = @state.lineHeight li

            if row < 0
                row += scale
                li  += 1
                continue

            break if row + scale > @cells.rows # a tall line that does not fit is left out

            y = li
            lineno = @lineno y
            
            hasCursor   = @state.isAnyCursorInLine  y
            selected    = @state.isSelectedLine     y
            highlighted = @state.isHighlightedLine  y
            spansel     = @state.isSpanSelectedLine y
            
            mark = @lineMarks[y]
            
            for c,i in lineno
                
                col = i
                if col < @cells.cols
                    
                    if sc = @fgcolor i y c
                        fg = sc
                    else
                        fg = if
                            y == mainCursor[1] ➜ color.darken(@color.cursor_main @state.hasFocus?1:0.5)
                            hasCursor          ➜ @color.cursor_multi
                            spansel            ➜ @color.selection
                            selected           ➜ @color.selection_line
                            highlighted        ➜ @color.highlight
                                               ➜ @color.fg
                                               
                        fg = color.darken fg if (selected or hasCursor or highlighted) and not @cells.screen.t.hasFocus
                    
                    bg = if 
                        mark? and @hoverBlock? and (mark.reverted ? mark.entry : mark.block) == @hoverBlock ➜ @color.bg_git_hover
                        mark?.reverted ➜ @revertColor mark.kind
                        mark?          ➜ @changeColor mark.kind
                        spansel        ➜ @color.bg_selected
                        selected       ➜ @color.bg_fully_selected
                                       ➜ @color.bg
                                 
                    bg = color.darken bg if selected and not @cells.screen.t.hasFocus
                    
                    @cells.set col row (y<@state.s.lines.length) ? c : ' ' fg bg

            for s in 1...scale
                row += 1
                for c,i in lineno
                    @cells.set i row ' ' fg bg

            row += 1
            li  += 1
                    
        @drawGitScroll()

export gutter
