
use ../../../kxk    ▪ kstr post
use ../../util      ◆ prof syntax 
use ../../util/img  ◆ glyphs
use ../../theme     ◆ color theme
use ../../edit/tool ◆ colorspans
use ../base         ◆ view
■mapview extends view
    ###
        the base of fileditor's mapscr 
        also used for browse and quicky previews
    ###

    @: screen @state ->
        
        super screen @state.owner() + '.mapview'
        
        @setColor 'bg' theme.quicky.bg
        
        @imgId  = kstr.hash(@state.name) & ~0xffff
        @rowOffset  = 0
        @images     = []
        @cells.cols = 12
        @colors     = null
        
        @csz          = []
        @pixelsPerRow = 4
        @pixelsPerCol = 2
        @textScale    = 4 
            
##show    
    reload: => 
    
        @createImages()
        @drawImages()
    
    show: => 
    
        super()
        
    hide: => 
        
        ⮐  if @hidden()
        
        @cells.screen.t.hideImagesInRange @images[0] @images[-1]
        
        super()
        
    clearImages: =>
        
        ⮐  if empty @images

        if process.env.TERM == 'xterm-kitty'
            @cells.screen.t.deleteImagesInRange @images[0] @images[-1]
        else
            for id in @images
                @cells.screen.t.deleteImage id

        @images = []
        
    layout: x y w h => 
    
        resized = x != @cells.x or y != @cells.y or w != @cells.cols or h != @cells.rows
        super x y w h

        ⮐  if @hidden()
        
        if @redraw or resized
            @createImages() if @redraw
            delete @redraw
            @drawImages()
                
    getSegls:  => @segls
    getSyntax: => @syntax
    getColors: => @colors ? @state.s.colors

    setColors: colors =>

        @colors = colors
        @redraw = true

    setSyntaxSegls: ext @segls => 
        
        @syntax = new syntax 
        @syntax.setExt ext 
        @syntax.setSegls @segls
        
        @redraw = true        
    
##images
    
    maxLinesToLoad: => (@cells.rows-@rowOffset) * @csz[1] / @pixelsPerRow
    
    createImages: =>
        
        t = @cells.screen.t
        ⮐  if empty t.cellsz
        
        @csz = t.cellsz
        
        @clearImages()

        # prof.start @state.name+'.map'
        
        w = @cells.cols * @csz[0]
        
        ⮐  if w <= 0
        
        lines = @getSegls()
        maxY  = @maxLinesToLoad()
        
        for line,y in lines
            
            h    = @imageHeight y
            data = Buffer.alloc w*h*3
            
            @imageForLine data line y h
            id = @imgId+y
            @images.push id
            t.sendImageData data id w h
            break if y > maxY
                
        # prof.end @state.name+'.map'
        
##update

    lineData: y =>
        
        csz = @cells.screen.t.cellsz
        
        ⮐  if empty csz
        
        w = @cells.cols * csz[0]
        bytes = w*@imageHeight(y)*3
        
        ⮐  if bytes <= 0
        
        Buffer.alloc bytes
    
    lineRows: y -> 1

    textLine: y -> @lineRows(y) >= @textScale and glyphs.hasScale(@lineRows(y))

    imageHeight: y -> @textLine(y) ? @lineRows(y)*@pixelsPerRow : 1

    lineOffsetPixels: y -> y*@pixelsPerRow

    updateLine: y data => 
    
        data ?= @lineData(y)        
        ⮐  if empty data

        csz = @cells.screen.t.cellsz
        ⮐  if empty csz
        @csz = csz

        id = @imgId+y
        h  = @imageHeight y
        @imageForLine data @getSegls()[y] y h
        w  = int(data.length/(3*h))
        t  = @cells.screen.t
        t.deleteImage id
        t.sendImageData data id w h

        py = @lineOffsetPixels y
        rh = @lineRows(y) * @pixelsPerRow

        if py >= 0 and py+rh <= @cells.rows*csz[1]
            if @textLine(y)
                t.placeImageSlice id @cells.x @cells.y+@rowOffset py 0 rh w
            else
                t.placeLineImage id @cells.x @cells.y+@rowOffset py rh
        
    updateFromLine: y =>
        
        for li in y...@state.s.lines.length
            @updateLine li
                
        while @images.length > @state.s.lines.length
            @cells.screen.t.deleteImage @images.pop()
            
    imageForLine: data line y h ->
    
        scale   = @lineRows y
        stride  = @pixelsPerCol * scale
        hgt     = h ? @imageHeight(y)
        w       = int(data.length/(3*hgt))
        maxX    = int(w/stride)
        syntax  = @getSyntax()
        classes = syntax.getClasses y

        fgSpans = []
        bgSpans = []
        colors  = @getColors()

        if colors?
            fgSpans = colorspans.spansForLine (colors.fg ? []) y
            bgSpans = colorspans.spansForLine (colors.bg ? []) y

        customColor = (spans x fallback) ->
            for span in spans
                if span[0] <= x < span[1]
                    ⮐  color.values span[2]
            fallback

        base = @color.bg

        for i in 0...(w*hgt)
            data[i*3+0] = base[0]
            data[i*3+1] = base[1]
            data[i*3+2] = base[2]

        masks = @textLine(y) ? glyphs.forScale(scale) : null

        for x in 0...maxX

            ch = line[x]
            bg = customColor bgSpans x base

            for py in 0...hgt
                for px in 0...stride
                    i = ((py*w)+(x*stride+px))*3
                    data[i+0] = bg[0]
                    data[i+1] = bg[1]
                    data[i+2] = bg[2]

            continue if not valid ch or ch == ' '

            f = 0.7  # darken character blocks
            f = 1 if scale >= @textScale # no darkening for lines that are rendered via fontmap
            clss = classes[x]
            clss ?= 'text'
            f = 2 if 'bang' in clss
            if ch in '0█'
                if 'header' in clss
                    f = 2.0
            fg = syntax.getColor x y clss
            fg = fg.map (v) -> clamp(0 255 int(f*v))
            fg = customColor fgSpans x fg

            mask = masks?[ch]

            if mask?
                for py in 0...hgt
                    for px in 0...stride
                        cov = mask[py*stride+px]
                        continue if cov == 0
                        i = ((py*w)+(x*stride+px))*3
                        if cov == 255
                            data[i+0] = fg[0]
                            data[i+1] = fg[1]
                            data[i+2] = fg[2]
                        else
                            a = cov/255
                            data[i+0] = int(fg[0]*a + bg[0]*(1-a))
                            data[i+1] = int(fg[1]*a + bg[1]*(1-a))
                            data[i+2] = int(fg[2]*a + bg[2]*(1-a))
            else
                for py in 0...hgt
                    for px in 0...stride
                        i = ((py*w)+(x*stride+px))*3
                        data[i+0] = fg[0]
                        data[i+1] = fg[1]
                        data[i+2] = fg[2]
            
##draw
    
    drawImages: =>
        
        t = @cells.screen.t
        
        ⮐  if empty t.pixels or @hidden() or @collapsed()
        
        # @csz = t.cellsz # should have been set in createImages 
        
        for id,y in @images
            t.placeLineImage id @cells.x @cells.y+@rowOffset (@lineOffsetPixels(y)) (@lineRows(y)*@pixelsPerRow)
        @
        
    draw: =>
        
        ⮐  if @hidden() or @collapsed()
        
        # @csz = @cells.screen.t.cellsz
                     
        @cells.fill_rect 0 0 @cells.cols-1 @cells.rows-1 ' ' null @color.bg
        
        @drawImages()
        
export mapview
