
use ../../../kxk ▪ post nfs
use ../../theme ◆ color theme
use ../../index ◆ kacher
use ../base     ◆ input
use             ◆ replacerfile searcher
■replacer□searcher
    # replaces in multiple files provided by index▸prjcts
    
    @: @screen @editor @name='replacer' ->

        super @screen @editor @name
        
        if @name == 'replacer'
            post.on 'replacer.show' @show
            post.on 'file.loaded'   @onFileLoaded
        
        @sfils = []
        @searchId = 0
        @excludedPaths = {}
        @applying = false
        
        @replaceInput = new input @screen "#{@name}_replace_input"
        @replaceInput.setColor 'bg_blur' @color.bg
        @replaceInput.on 'action' @onReplaceInputAction
        
        @setColor 'included' theme.replacer.included
        @setColor 'excluded' theme.replacer.excluded
        
        @choices.gutter.fgcolor = (x y c) =>
            if c == '✔'
                ⮐ @color.included
            if c == '✘'
                ⮐ @color.excluded

    show: text files ◯=>
    
        @searchId += 1
        @sfils = []
        @excludedPaths = {}
        
        searching = @search text files
        
        @replaceInput.grabFocus() if not empty @input.current()
        
        ◯ searching

    createFileHandler: @screen name ->

        new replacerfile @screen name @

    isExcluded: path -> @excludedPaths[path] ? false

    onFileToggled: path =>

        handler = null
        for sfil in @sfils
            if sfil.path == path
                handler = sfil
                break
        
        ⮐ if not handler
        
        @excludedPaths[path] = handler.excluded
        
        handler.headerItem.line = handler.marker
        
        items = @choices.items
        idx   = handler.lineIndex
        count = handler.resultItems.length
        
        if handler.excluded
            end   = idx + 1 + count
            items = items[0...idx+1].concat(items[end..])
        else
            items = items[0...idx+1].concat(handler.resultItems).concat(items[idx+1..])
        
        @choices.items  = items
        @choices.fuzzied = items
        
        lines = items.map (item) -> item.line
        @choices.state.setLines lines
        
        for sfil in @sfils
            hidx = items.indexOf sfil.headerItem
            sfil.lineIndex = hidx if hidx >= 0
        
        @choices.select handler.lineIndex
        @choices.state.highlightText @input.current()
        
        post.emit 'redraw'

    setColor: key clr =>

        super key clr
        
        if key == 'bg'
            @replaceInput?.setColor 'bg_blur' @color.bg

    arrange: =>

        super()
        
        [x y w h] = @arrangeRect()
        
        mid = int w/2
        
        @input.layout        x+2     y+1  mid-4   1
        @replaceInput.layout x+mid+2 y+1  w-mid-4 1

    drawChoices: =>

        @input.draw()
        @replaceInput.draw()
        @choices.draw()

    drawFrame: =>

        sy = 0
        
        if @input.visible()
        
            mid = int @cells.cols/2
            
            @drawInputFrame @input        0   mid-1
            @drawInputFrame @replaceInput mid -1
            
            sy = 2
        
        @cells.draw_rounded_border 0 sy -1 -1 fg:@color.bg zLayer: 1001

    drawInputFrame: input x1 x2 =>

        ⮐ if @cells.cols < 2
        
        outer = input.hasFocus() ? color.brighten(@color.bg) : @color.bg
        inner = input.hasFocus() ? input.color.bg_focus : input.color.bg_blur
        
        @cells.draw_rounded_border x1 0 x2 2 fg:outer
        
        @cells.draw_vertical_padding x1+1 1 outer inner
        @cells.draw_vertical_padding x2-1 1 inner outer

    moveFocus: =>

        if @input.hasFocus()
            @replaceInput.grabFocus()
            @replaceInput.selectAll()
        else if @replaceInput.hasFocus()
            @input.grabFocus()
            @input.selectAll()
        else
            @input.grabFocus()
            @input.selectAll()

    onKey: key event =>

        ⮐ if @hidden()

        switch event.combo
            'tab' 'shift+tab' ➜ ⮐ @moveFocus()
            'esc' ➜ ⮐ @onEscape()

        if @replaceInput.hasFocus()
            if result = @replaceInput.onKey key event
                @autoHide()
                ⮐ result
            if event.combo in ['up' 'down']
                @choices.grabFocus() if event.combo == 'down'
                @autoHide()
                ⮐ true
            ⮐ true

        ⮐ super key event

    onMouse: event =>

        ⮐ if @hidden()

        ret = @replaceInput.onMouse event
        ⮐ ret if ret?.redraw

        super event

    onChoicesAction: action choice =>

        if action in ['space' 'click']
            if choice?.type == 'file'
                ⮐ @toggleFile choice.path
            if choice?.row is num
                ⮐ @toggleLine choice
            ⮐ if action == 'click'

        super action choice

    toggleFile: path =>

        for sfil in @sfils
            if sfil.path == path
                ⮐ sfil.toggle()

    toggleLine: item =>

        item.excluded = not item.excluded
        
        if item.excluded
        
            idx  = @choices.items.indexOf item
            next = idx + 1
            
            while next < @choices.items.length
                nextItem = @choices.items[next]
                break if nextItem.type == 'file'
                if nextItem.row is num
                    @choices.select next
                    break
                next += 1
        
        post.emit 'redraw'

    onReplaceInputAction: action text =>

        switch action
            'submit' ➜ ⮐ @applyReplacement text
            'up'
            'down'   ➜ @choices.moveSelection action

    applyReplacement: replacement ◯=>

        ⮐ if @applying
        
        @applying = true
        
        try
            ◯ @runReplacement replacement
        finally
            @applying = false

    runReplacement: replacement ◯=>

        search = @lastSearchText ? @input.current()
        
        ⮐ if empty search
        
        changedLines = 0
        applied      = []
        errors       = []
        
        for sfil in @sfils
        
            continue if sfil.excluded
            
            text =◯ kacher.getText sfil.path
            
            continue if empty text
            
            lines   = text.split '\n'
            changes = []
            changed = false
            
            for item in sfil.resultItems
            
                continue if not item.row is num
                continue if item.excluded
                continue if item.row >= lines.length
                
                line  = lines[item.row]
                parts = line.split search
                
                replaced = parts.join replacement
                
                continue if replaced == line
                
                lines[item.row] = replaced
                changes.push line:item.row from:line to:replaced
                changed = true
                changedLines += 1
            
            continue if not changed
            
            newText = lines.join('\n')
            result  =◯ nfs.write sfil.path newText
            
            if result?.error
                errors.push result.error
                continue
            
            # kacher.invalidate sfil.path # this should not be necessary
            
            applied.push path:sfil.path changes:changes
            
            # post.emit 'file.change' path:sfil.path change:'modify' # this is the watchers job
        
        for err in errors
            log err
        
        ⮐ if not empty errors
        
        log "\nreplacing '#{search}' with '#{replacement}' in #{applied.length} files, #{changedLines} lines"
        
        for file in applied
        
            log "\n● #{file.path}\n"
            
            for change in file.changes
                log "#{change.line+1}:"
                log change.from
                log change.to
        
        log "\nreplaced #{applied.length} files, #{changedLines} lines"
        
        @hide()
        post.emit 'focus' 'editor'

    onFileLoaded: file =>
    
        ⮐ if @hidden()
    
        log "replacer.onFileLoaded (hide?) #{file}"
        # @hide()
        
export replacer
