
use ../../../kxk ▪ post
use ../../theme ◆ color
use ../base     ◆ input
use             ◆ replacerfile searcher
■replacer□searcher
    # replaces in multiple files provided by index▸prjcts
    
    @: @screen @editor @name='replacer' ->

        super @screen @editor @name
        
        if @name == 'replacer'
            post.on 'replacer.show' @show
            post.on 'file.loaded'   @onFileLoaded
        
        @sfils = []
        @searchId = 0
        @excludedPaths = {}
        
        @replaceInput = new input @screen "#{@name}_replace_input"
        @replaceInput.setColor 'bg_blur' @color.bg
        @replaceInput.on 'action' @onReplaceInputAction

    show: text files ○=>
    
        searching = @search text files
        
        @replaceInput.grabFocus() if not empty @input.current()
        
        ○ searching

    createFileHandler: @screen name ->

        new replacerfile @screen name @

    isExcluded: path -> @excludedPaths[path] ? false

    onFileToggled: path ○=>

        handler = null
        for sfil in @sfils
            if sfil.path == path
                handler = sfil
                break
        
        ⮐ if not handler
        
        @excludedPaths[path] = handler.excluded
        
        hadChoicesFocus = @choices.hasFocus()
        
        ○ @search @input.current() null false
        
        handler = null
        for sfil in @sfils
            if sfil.path == path
                handler = sfil
                break
        
        ⮐ if not handler
        ⮐ if not hadChoicesFocus
        
        @choices.select handler.lineIndex
        @choices.state.setView [0 handler.lineIndex]
        @choices.grabFocus()
        
        post.emit 'redraw'

    setColor: key clr =>

        super key clr
        
        if key == 'bg'
            @replaceInput?.setColor 'bg_blur' @color.bg

    arrange: =>

        super()
        
        [x y w h] = @arrangeRect()
        
        mid = int w/2
        
        @input.layout        x+2     y+1  mid-4   1
        @replaceInput.layout x+mid+2 y+1  w-mid-4 1

    drawChoices: =>

        @input.draw()
        @replaceInput.draw()
        @choices.draw()

    drawFrame: =>

        sy = 0
        
        if @input.visible()
        
            mid = int @cells.cols/2
            
            @drawInputFrame @input        0   mid-1
            @drawInputFrame @replaceInput mid -1
            
            sy = 2
        
        @cells.draw_rounded_border 0 sy -1 -1 fg:@color.bg zLayer: 1001

    drawInputFrame: input x1 x2 =>

        ⮐ if @cells.cols < 2
        
        outer = input.hasFocus() ? color.brighten(@color.bg) : @color.bg
        inner = input.hasFocus() ? input.color.bg_focus : input.color.bg_blur
        
        @cells.draw_rounded_border x1 0 x2 2 fg:outer
        
        @cells.draw_vertical_padding x1+1 1 outer inner
        @cells.draw_vertical_padding x2-1 1 inner outer

    moveFocus: =>

        if @input.hasFocus()
            @replaceInput.grabFocus()
            @replaceInput.selectAll()
        else if @replaceInput.hasFocus()
            @input.grabFocus()
            @input.selectAll()
        else
            @input.grabFocus()
            @input.selectAll()

    onKey: key event =>

        ⮐ if @hidden()

        switch event.combo
            'tab' 'shift+tab' ➜ ⮐ @moveFocus()
            'esc' ➜ ⮐ @onEscape()

        if @replaceInput.hasFocus()
            if result = @replaceInput.onKey key event
                @autoHide()
                ⮐ result
            if event.combo in ['up' 'down']
                @choices.grabFocus() if event.combo == 'down'
                @autoHide()
                ⮐ true
            ⮐ true

        ⮐ super key event

    onMouse: event =>

        ⮐ if @hidden()

        ret = @replaceInput.onMouse event
        ⮐ ret if ret?.redraw

        super event

    onChoicesAction: action choice =>

        if action == 'space' and choice?.type == 'file'
            ⮐ @toggleFile choice.path

        super action choice

    toggleFile: path =>

        for sfil in @sfils
            if sfil.path == path
                ⮐ sfil.toggle()

    onReplaceInputAction: action text =>

        switch action
            'submit' ➜ ⮐ @logReplacement text
            'up'
            'down'   ➜ @choices.moveSelection action

    logReplacement: replacement =>

        files = @sfils.filter (sfil) -> not sfil.excluded
        total = 0
        
        for sfil in files
            total += sfil.lineCount ? 0
        
        log "replacer would replace '#{@input.current()}' with '#{replacement}' in #{files.length} files, #{total} lines"
        
        for sfil in files
            count = sfil.lineCount ? 0
            log "  #{sfil.path}: #{count} lines"

    onFileLoaded: file =>
    
        ⮐ if @hidden()
    
        @hide()
        
    #     ⮐ if empty @fileToHighlight
    #     ⮐ if empty @textToHighlight
    #     ⮐ if empty file
    # 
    #     post.emit 'editor.highlight' @textToHighlight
    #     
    #     delete @fileToHighlight
    #     delete @textToHighlight

export replacer
