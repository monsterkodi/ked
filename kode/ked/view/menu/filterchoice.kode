
use ../../../kxk    ▪ post
use ../../theme     ◆ color theme
use ../base         ◆ input
use ../screen       ◆ cells
use ../menu         ◆ choices
■filterchoice□choices
###
    a choices view with an internal filter input
    the input is hidden until a plain alphanumeric key is pressed
    while visible it takes three rows from the choices area
###
    @: screen name features ->
        
        super screen name features
        
        @input       = new input @screen "#{@name}_input"
        @filterCells = new cells @screen
        
        @input.on 'action' @onInputAction
        
        @input.hide()
        
    setColor: key clr =>
        
        super key clr
        
        if key == 'bg' and @input
            @input.setColor 'bg_blur' @color.bg
        
    filterVisible: => @input.visible()
    
    showFilter: =>
        
        ⮐  if @filterVisible()
        
        @input.show()
        @input.grabFocus()
        
    hideFilter: =>
        
        ⮐  if not @filterVisible()
        
        @input.set ''
        @input.hide()
        
        @filter ''
        @state.selectLine 0
        @state.setMainCursor 0 0
        
        @grabFocus()
        
    onInputAction: action text =>
        
        if action == 'change'
            @filter text
            @state.selectLine 0
            @state.setMainCursor 0 0
        
    toggleFilter: =>
        
        if @filterVisible() ➜ @hideFilter()
                             ➜ @showFilter()
        
    hasFocus: => super() or (@input and @input.hasFocus())
    
    layout: x y w h =>
        
        if @filterVisible()
            
            fh = min 3 h
            
            @filterCells.layout x y w fh
            @input.layout       x+2 y+1 w-4 1
            
            super x y+fh w h-fh
            
        else
            
            super x y w h
            
    draw: =>
        
        ⮐  if @hidden()
        
        super()
        
        @drawFilter() if @filterVisible()
        
    drawFilter: =>
        
        cells = @filterCells
        
        ⮐  if cells.rows < 1 or cells.cols < 1
        
        cells.fill_rect 0 0 -1 -1 ' ' null @color.bg
        
        outer = @input.hasFocus() ? color.brighten(@color.bg) : @color.bg
        inner = @input.hasFocus() ? @input.color.bg_focus : @input.color.bg_blur
        
        cells.draw_rounded_border 0 0 -1 2 fg:outer
        
        cells.draw_vertical_padding 1 1 outer inner
        cells.draw_vertical_padding cells.cols-2 1 inner outer
        
        @input.draw()
        
    onKey: key event =>
        
        if @filterVisible()
            
            if event.combo == 'esc'
                @hideFilter()
                ⮐ true
                
            @input.grabFocus() if not @input.hasFocus()
            
            if @input.onKey key event
                ⮐ true
                
            ⮐ super key event
            
        if event.char
            
            @showFilter()
            @input.onKey key event
            ⮐ true
            
        super key event
        
    onMouse: event =>
        
        if @filterVisible() and @filterCells.isInsideEvent(event)
            
            @input.grabFocus() if event.type == 'press'
            
            ret = @input.onMouse event
            ⮐ ret if ret
            
            ⮐ redraw:true
            
        super event
        
export filterchoice
