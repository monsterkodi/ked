
use ../../../kxk    ▪ krzl
use ../../theme     ◆ color theme
use ../base         ◆ input
use ../screen       ◆ cells
use ../menu         ◆ choices
use ../../edit/tool ◆ belt
■filterchoice□choices
###
    a choices view with an internal filter input
    the input is hidden until a plain alphanumeric key is pressed
    while visible it takes three rows from the choices area
###
    @: screen name features ->
        
        super screen name features
        
        @input       = new input @screen "#{@name}_input"
        @filterCells = new cells @screen
        
        @input.on 'action' @onInputAction
        
        @input.hide()
        
    # setColor: key clr =>
    #     
    #     super key clr
    #     
    #     if key == 'bg' and @input
    #         @input.setColor 'bg_blur' @color.bg

    toggleFilter: =>
        
        if @input.visible() ➜ @hideFilter()
                            ➜ @showFilter()
        
    showFilter: =>
        
        ⮐ if @input.visible()
        @input.show()
        @input.grabFocus()
        true
        
    hideFilter: =>
        
        @state.clearHighlights()
        ⮐ if not @input.visible()
        @input.set ''
        @input.hide()
        @grabFocus()
        true
                
    onInputAction: action text =>
        
        switch action
            
            'change'
                
                if empty text 
                    @state.clearHighlights()
                    @state.setSelections []
                else
                    @state.highlightText text
                    if @state.s.highlights.length
                        @selectLineAndAdjust @state.s.highlights[0][1]
            'submit'
                
                @hideFilter()
                @emitAction 'return' @current()
                    
    selectLineAndAdjust: li =>
        
        @state.setSelections [belt.rangeOfLine(@state.s.lines li)]
        @state.setCursors [[0 li]] adjust:'topBotDelta'
        true
        
    hasFocus: => super() or @input.hasFocus()
    
    layout: x y w h =>
        
        if @input.visible()
            
            fh = min 3 h
            
            @filterCells.layout x y w fh
            @input.layout       x+2 y+1 w-4 1
            
            super x y+fh w h-fh
            
        else
            
            super x y w h
            
    draw: =>
        
        ⮐ if @hidden()
        
        super()
        
        if @input.visible()
        
            cells = @filterCells
            
            ⮐ if cells.rows < 1 or cells.cols < 1
            
            cells.fill_rect 0 0 -1 -1 ' ' null @color.bg
            
            outer = @input.hasFocus() ? color.brighten(@color.bg) : @color.bg
            inner = @input.hasFocus() ? @input.color.bg_focus : @input.color.bg_blur
            
            cells.draw_rounded_border 0 0 -1 2 fg:outer
            
            cells.draw_vertical_padding 1 1 outer inner
            cells.draw_vertical_padding cells.cols-2 1 inner outer
            
            @input.draw()
        
    onKey: key event =>

        if @input.visible()
            
            if event.combo == 'esc'
                ⮐ @hideFilter()
                
            if event.combo == 'tab'
                if @input.hasFocus()
                    @grabFocus()
                else
                    @input.grabFocus()
                ⮐ true
                
            if @input.hasFocus()
                
                if event.combo == 'up'
                    @state.selectPrevHighlight()
                    ⮐ @selectLineAndAdjust @state.s.selections[0][1]
                    
                if event.combo == 'down'
                    @state.selectNextHighlight() # 𝜏𝖍𝚒𝖘 ϝϵϵ⟅𝖘 𝕒 𝔟𝚒𝜏 𝖍𝕒⊂𝛋𝛾
                    @state.selectNextHighlight() # 𝔟𝓊𝜏 𝚒𝜏 𝖘ϵξ⫙𝖘 𝜏◯ ⟒⊚ℜ𝛋 ϝ◯ℜ ∩⊚⟒
                    ⮐ @selectLineAndAdjust @state.s.selections[0][1]
                    
                if @input.onKey key event
                    ⮐ true
                    
                ⮐ super key event
                
            if event.char
                @input.grabFocus()
                if @input.onKey key event
                    ⮐ true
                    
            ⮐ super key event
            
        if event.char
            
            if event.combo not in ['tab''return''space']
                @showFilter()
                @input.onKey key event
                ⮐ true
        
        super key event
        
    onMouse: event =>
        
        if @input.visible() and @filterCells.isInsideEvent(event)
            
            @input.grabFocus() if event.type == 'press'
            
            ret = @input.onMouse event
            ⮐ ret if ret
            
            ⮐ redraw:true
            
        super event
        
export filterchoice
