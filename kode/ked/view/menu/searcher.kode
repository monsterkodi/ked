
use ../../../kxk    ▪ post kseg slash
use ../../edit/tool ◆ belt
use ../../index     ◆ prjcts kacher
use ../base         ◆ view
use                 ◆ finder searcherfile
■searcher□finder
    # searches in multiple files provided by index▸prjcts
    
    @: @screen @editor name='searcher' ->

        super @screen @editor name
        
        if @name == 'searcher'
            post.on 'searcher.show' @show
            post.on 'file.loaded'   @onFileLoaded
        
        @sfils = []
        @searchId = 0

    show: text files ○=>
    
        ○ @search text files

    search: text files focus=true ○=>
    
        @choices.state.gutterWidthOverride = null
        @gutterMaxLine = 0
        
        # log "searcher show |#{text}|"
        
        text = @searchText text # to use selection or cursor word if text is empty
        
        @lastSearchText = text
        
        # log g4("#{r6 'searcher'} '#{text}'")
        
        if empty text
            @input.grabFocus() if focus
            ⮐ finder.prototype.show.call @
        
        editorFile = ked_session.get 'editor▸file'
        editorExt  = slash.ext editorFile 
        
        dir    = prjcts.dir   editorFile
        files ?= prjcts.files editorFile

        files = @filterFiles files [editorExt]
        files = @sortFiles files

        # log "searcher - search #{files.length} files in #{dir} for |#{text}|" #files
        
        view.prototype.show.call @ # bypass finder to avoid reading selection or cursor word again
        
        @input.grabFocus() if focus
        @choices.clearEmpty()        
        @sfils = []
        
        # ●▸ searcher
        
        items = []
        appended = 0
        flushed = false
        ext = editorExt
        maxRows = @maxResultRows()
        
        @searchId += 1
        searchId = @searchId
        
        for file,idx in files
                    
            filet =○ kacher.getText file
            
            ⮐ if searchId != @searchId
            
            segls = kseg.segls filet
            spans = belt.lineSpansForText segls text
            
            continue if empty spans
            
            front = belt.frontmostSpans spans
            
            sfil = @createFileHandler @screen "#{@name}_sfil_#{idx}"
            sfil.path = file
            sfil.lineIndex = appended + items.length + 1
            sfil.lineCount = front.length
            
            header =
                line:  sfil.marker
                type:  'file'
                path:  file
                row:   0
                col:   0
            
            results = []
            lastRow = 0
            
            for span in front
                if lastRow != span[1]-1
                    results.push line:''
                results.push
                    line:  ' ' + kseg.str(segls[span[1]])
                    path:  file
                    row:   span[1]
                    col:   span[2]
                lastRow = span[1]
            
            sfil.headerItem  = header
            sfil.resultItems = results
            
            sfil.set slash.relative(file dir)            
            @sfils.push sfil

            items.push line:'' 

            items.push header
            
            if not sfil.excluded
                for result in results
                    items.push result

            if not flushed and appended + items.length >= maxRows
                @choices.append items ext
                appended += items.length
                items = []
                flushed = true
                @highlightTextAndEmitRedraw text
                ○ new Promise (resolve) -> setImmediate resolve
                ⮐ if searchId != @searchId
            else if flushed and (idx+1) % 8 == 0
                ○ new Promise (resolve) -> setImmediate resolve
                ⮐ if searchId != @searchId
            
            break if @hidden()

        ⮐ if searchId != @searchId

        finalAppend = false

        if items.length
            @choices.append items ext
            finalAppend = true
            items = []

        ⮐ if @hidden()

        # log y6('▸▸▸ searcher done')
        @highlightTextAndEmitRedraw text if finalAppend or not flushed
                
        # ●▪ searcher

    createFileHandler: @screen name ->

        new searcherfile @screen name
            
    arrange: =>

        @updateGutterWidth()
        super()    
    
        for sfil in @sfils
            y = @choices.cells.y - @choices.state.s.view[1] + sfil.lineIndex
            sfil.layout @choices.cells.x y @choices.cells.cols 1

    arrangeRect: =>
    
        [
            int(@editor.cells.x-@editor.gutter.cells.cols-1)
            int(@editor.cells.y)
            int(@editor.cells.cols+@editor.gutter.cells.cols+1)
            int(@editor.cells.rows-3)
        ]
            
    draw: =>

        ⮐ if @hidden()

        super()
        
        for sfil in @sfils
            if @choices.state.s.view[1] <= sfil.lineIndex < @choices.state.s.view[1]+@choices.cells.rows
                sfil.draw()
            
    onMouse: event =>

        ⮐ if @hidden()
        
        for sfil in @sfils
            ret = sfil.onMouse event ; ⮐ ret if ret?.redraw
        
        super event
        
    onFileLoaded: file =>
    
        ⮐ if @hidden()
    
        @hide()
        
        ⮐ if empty @fileToHighlight
        ⮐ if empty @textToHighlight
        ⮐ if empty file
    
        post.emit 'editor.highlight' @textToHighlight
        
        delete @fileToHighlight
        delete @textToHighlight

    maxResultRows: -> max 1 int(@editor.cells.rows)

    updateGutterWidth: ->
    
        view = @choices.state.s.view
        lo   = view[1]
        hi   = min(@choices.items.length lo + @maxResultRows())
        
        for idx in lo...hi
            item = @choices.items[idx]
            if item.row is num
                @gutterMaxLine = max @gutterMaxLine item.row+1
                
        @choices.state.gutterWidthOverride = max 4 2 + ceil(Math.log10(@gutterMaxLine+1))
        
    fileHeaderIndex: dir ->
    
        current = @choices.currentIndex()
        found   = null
        
        for item,idx in @choices.items
            continue if item.type != 'file'
            if dir > 0
                ⮐ idx if idx > current
            else if idx < current
                found = idx
                
        found
        
    selectFileHeader: idx ->
    
        ⮐ false if not idx?
        
        hadInputFocus = @input.hasFocus()
        @choices.select idx
        @input.grabFocus() if hadInputFocus
        @choices.state.setView [0 idx]
        true
        
    selectNextFileHeader: -> @selectFileHeader(@fileHeaderIndex(1))
    selectPrevFileHeader: -> @selectFileHeader(@fileHeaderIndex(-1))
        
    emitFileOpen: choice ->
    
        # log 'emit file.open'
    
        @textToHighlight = @input.current()
        @fileToHighlight = choice.path
        
        post.emit 'file.open' choice.path choice.row choice.col
        
    highlightTextAndEmitRedraw: text ->
    
        @choices.state.highlightText text
        post.emit 'redraw'
    
    sortFiles: files ->
    
        files.sort (a b) ->
            weight = f -> 
                ext = slash.ext f
                switch ext 
                    'kode'  ➜ 1000
                    'noon'  ➜ 900
                    'md'    ➜ 800
                    'json'  ➜ 20
                    'js'    ➜ 10
                            ➜ 0
            weight(b) - weight(a)
        files
        
    filterFiles: files exts ->
    
        files.filter (f) -> slash.ext(f) in exts
                
    apply: choice ->
        
        ⮐ @emitFileOpen(choice) if choice?.path
        
        super choice
                                    
    onInputAction: action text ->
    
        # log "searcher.onInputAction #{action} #{text}"
    
        switch action
            
            'submit' ➜ ⮐ @show text
            'right'  ➜ ⮐ 
            'change' ➜ ⮐ 
            
        super action text

export searcher
