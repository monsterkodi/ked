
use ../../../kxk    ▪ post
use ../../edit/tool ◆ belt
use ../../theme     ◆ theme 
use                 ◆ inputchoice
■macro□inputchoice
    # menu for actions that don't have keyboard shortcuts
    
    @: @screen @editor ->
        
        super @screen 'macro'
        
    arrange: =>

        w = max 20 @width+2+1 # 2 for frame, 1 for right 
        c = @choices.numChoices()
        
        ih = @inputIsActive() ? 2 : 0
        iz = max 0 ih - 1
        
        h = c + 2 + ih
        scy = int @screen.rows/2
        y  = int scy-(c+2)/2
        y -= ih
        
        scx = int @screen.cols/2
        x  = int scx - w/2
        
        @input.layout    x+2   y+1      w-4  iz
        @choices.layout  x+1   y+1+ih   w-2  c
        @cells.layout    x     y        w    h

    show: =>
    
        items = belt.linesForText
            """
            status
            diff
            history
            mapscr
            scale
            zen
            """

        s = @editor.state.s
        indices = belt.lineIndicesForRangesOrPositions s.selections s.cursors

        if indices.length > 1
            items.push 'count'
            items.push 'sort'
                    
        items = items.map (i) -> ' ' + i # padding for  
            
        ccol = int(@screen.cols/2) - 5

        @width = belt.widthOfLines items
        
        @input.set ''
        @input.hide()
        @choices.set items
        @choices.select 0
        @choices.state.setView [0 0]
        
        super()
        
    hide: =>
    
        post.emit 'focus' 'editor'    
        super()
        
    applyChoice: choice ->
        
        if empty choice
            input = @input.current()
            # log "macro.applyChoice ◯#{input}◯"
            if 
                input == 'bof'  ➜ post.emit 'goto.bof'
                input == 'eof'  ➜ post.emit 'goto.eof'
                num = int input ➜ post.emit 'goto.line' num-1 'ind'
                
                input.startsWith 'vibrant ' 
                
                    sp = input.split /\s+/
                    sf = parseFloat sp[1]
                    lf = (sp.length > 2) ? parseFloat(sp[2]) : 1
                    post.emit 'theme.vibrant' sf lf
                    
                input.startsWith 'class '
                
                    sp = input.split /\s+/
                    if valid sp[1]
                        post.emit 'file.class' sp[1]
                        
                input.startsWith 'count'
                    
                    [start step] = trim(input[5..-1]).split(' ').map((s) -> parseInt(s))
                    @editor.state.countSelectionsOrCursorLines start step
        else
            # log "macro.applyChoice ▸#{choice}◂"
            switch choice
                'zen'     ➜ post.emit 'config.toggle' 'zen.enable'
                'scale'   ➜ post.emit 'config.toggle' 'scale.enable'
                'mapscr'  ➜ post.emit 'config.toggle' 'mapScroll.enable'
                'diff'    ➜ post.emit 'differ.file'
                'status'  ➜ post.emit 'differ.status'
                'history' ➜ post.emit 'differ.history'
                'sort'    ➜ @editor.state.sortSelectionsOrCursorLines()
                'count'   ➜ @editor.state.countSelectionsOrCursorLines()
                
        @hide()
        true
        
export macro
