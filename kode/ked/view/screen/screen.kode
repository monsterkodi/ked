
use ../../../kxk    ▪ kseg post
use ../../theme     ◆ color
use ../../edit/tool ◆ belt

■screen
    # an array of cells (background|foreground colors and character)
    
    @MAIN_MARK:   '\x1b[4:1m'
    @MULTI_MARK:  '\x1b[4:5m'
    @SELECT_MARK: '\x1b[7;4:3m'
    @HILGHT_MARK: '\x1b[7;4:4m'
    @END_MARK:    '\x1b[0m'

    @: @t -> 
    
        @init()        
    
    init: => # called by ked before every redraw
    
        @rows = @t.rows()
        @cols = @t.cols()
        
        @c = belt.cells @cols @rows

        @frameRuns   = []
        @frameBlocks = []
        @eraseRects  = []
    
    add: x y char fg bg =>
        
        w = kseg.segWidth char
        if w > 1
            if char.length > 4
                char = '\x1b]66;w=2;' + char + '\x07'
            @set x   y char fg bg
            @set x+1 y null fg bg
            2
        else
            @set x y char fg bg
            1

    addRun: x y scale w =>

        @frameRuns ?= []

        if run = @frameRuns[-1]
            if run[1] == y and run[2] == scale and run[0] + run[3]*scale == x
                run[3] = run[3] + w
                ⮐

        @frameRuns.push [x y scale w]

    scaled_char: char scale width -> "\x1b]66;s=#{scale}:w=#{width};#{char}\x07"

    add_scaled: x y char fg bg scale =>

        ⮐ @add x y char fg bg if scale <= 1

        w = max 1 kseg.segWidth(char)

        if @t.textSizing
            char = @scaled_char char scale w
            @addRun x y scale w
            @frameBlocks ?= []
            @frameBlocks.push [x y scale w]

        @set x y char fg bg

        for j in 0...scale
            for i in 0...scale*w
                if i or j
                    if j > 0 and i == 0 and @t.textSizing
                        @set x+i y+j "\x1b[#{scale*w}C" null null
                    else
                        @set x+i y+j null null null

        scale*w
        
    erase_scaled: x1 y1 x2 y2 bg=null =>

        x1 = max 0 x1
        y1 = max 0 y1
        x2 = min @cols-1 x2
        y2 = min @rows-1 y2

        ⮐ if x1 > x2 or y1 > y2

        @eraseRects ?= []
        @eraseRects.push [x1 y1 x2 y2]
        
        post.emit 'screen.erased' [x1 y1 x2 y2]

        for y in y1..y2
            for x in x1..x2
                @c[y][x].char = ' '
                @c[y][x].bg   = bg if bg?

        for [bx by scale w] in @frameBlocks ? []
            continue if bx > x2 or bx + scale*w - 1 < x1
            continue if by > y2 or by + scale   - 1 < y1
            for yy in by..min(@rows-1 by+scale-1)
                for xx in bx..min(@cols-1 bx+scale*w-1)
                    @c[yy][xx].char = ' '
    
    set: x y char fg bg =>
        
        if 0 <= x < @cols and 0 <= y < @rows
            @c[y][x].char = char
            @c[y][x].fg = fg ? []
            @c[y][x].bg = bg ? []
            
    set_char: x y char =>

        if 0 <= x < @cols and 0 <= y < @rows
            @c[y][x].char = char

    set_ch_fg: x y char fg =>

        if 0 <= x < @cols and 0 <= y < @rows
            @c[y][x].char = char
            @c[y][x].fg   = fg
            
    set_bg: x y bg =>
        
        if 0 <= x < @cols and 0 <= y < @rows
            ▴ valid @c[y][x]
            if @c[y][x]
                @c[y][x].bg = bg

    set_fg: x y fg =>
        
        if 0 <= x < @cols and 0 <= y < @rows
            @c[y][x].fg = fg

    set_fg_bg: x y fg bg =>
        
        if 0 <= x < @cols and 0 <= y < @rows
            @c[y][x].fg = fg
            @c[y][x].bg = bg
            
    #  fill the background of every cell of the screen
    
    fill_bg: bg =>
        
        for row in @c
            for cell in row
                cell.bg = bg
            
    get_char: x y =>

        if 0 <= x < @cols and 0 <= y < @rows
            ⮐ @c[y][x].char
        ''

    get_fg: x y =>
        
        if 0 <= x < @cols and 0 <= y < @rows
            ⮐ @c[y][x].fg
        []

    get_bg: x y =>
        
        if 0 <= x < @cols and 0 <= y < @rows
            ⮐ @c[y][x].bg
        []
        
    text: =>
        
        lines = []
        
        for y in 0...@rows
            
            line = ''
            
            for x in 0...@cols
                
                ch = @c[y][x].char
                ch = ' ' if not valid ch
                
                line += ch
            
            lines.push line.replace(/\s+$/ '')
        
        lines
    
    #  the buffer as uncolored text, with the cursors, selections and highlights marked
    
    textMarked: =>
        
        lines = []
        
        for y in 0...@rows
            
            line = ''
            
            for x in 0...@cols
                
                ch = @c[y][x].char
                ch = ' ' if not valid ch
                
                if mark = @c[y][x].mark
                    switch mark
                        'selection' ➜ line += screen.SELECT_MARK
                        'highlight' ➜ line += screen.HILGHT_MARK
                        'main'      ➜ line += screen.MAIN_MARK
                                    ➜ line += screen.MULTI_MARK
                    line += ch + screen.END_MARK
                else
                    line += ch
            
            lines.push line.replace(/\s+$/ '')
        
        lines
    
    #  the buffer as colored text, with the cursors, selections and highlights marked
    
    textColored: =>
        
        lines = []
        
        for y in 0...@rows
            
            line = ''
            pbg = ''
            pfg = ''
            
            for x in 0...@cols
                
                cell = @c[y][x]
                ch = cell.char
                ch = ' ' if not valid ch
                
                bg = color.bg_rgb cell.bg
                if bg != pbg
                    line += bg
                    pbg = bg
                
                fg = color.fg_rgb cell.fg
                if fg != pfg
                    line += fg
                    pfg = fg
                
                if mark = cell.mark
                    switch mark
                        'selection' ➜ line += screen.SELECT_MARK
                        'highlight' ➜ line += screen.HILGHT_MARK
                        'main'      ➜ line += screen.MAIN_MARK
                                    ➜ line += screen.MULTI_MARK
                    line += ch + screen.END_MARK
                    pbg = ''
                    pfg = ''
                else
                    line += ch
            
            lines.push line + screen.END_MARK
        
        lines
    
    set_mark: x y kind =>
        
        if 0 <= x < @cols and 0 <= y < @rows
            @c[y][x].mark = kind
        
    render: =>
        
        @t.write @renderString()

    #  the frame as it is written to the terminal
    
    renderString: =>

        s = ''
        pbg = ''
        pfg = ''

        for [bx by scale width] in @lastRuns ? []
            for r in by...by+scale
                s += "\x1b[#{r+1};#{bx+1}H\x1b[#{width*scale}X"

        for [x1 y1 x2 y2] in @eraseRects ? []
            for r in y1..y2
                s += "\x1b[#{r+1};#{x1+1}H\x1b[#{x2-x1+1}X"

        @lastRuns   = @frameRuns ? []
        @frameRuns   = []
        @frameBlocks = []
        @eraseRects  = []

        s += '\x1b[H'
        
        for y in 0...@rows
            for x in 0...@cols
            
                char = @c[y][x].char
                continue if char == null
                                    
                bg = color.bg_rgb @c[y][x].bg
                if bg != pbg
                    s += bg
                    pbg = bg
                fg = color.fg_rgb @c[y][x].fg
                if fg != pfg
                    s += fg
                    pfg = fg
                
                s += char
                
            s += '\n' if y != @rows-1

        s
        
export screen
