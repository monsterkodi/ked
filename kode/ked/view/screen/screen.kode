###
     ███████   ███████  ████████   ████████  ████████  ███   ███
    ███       ███       ███   ███  ███       ███       ████  ███
    ███████   ███       ███████    ███████   ███████   ███ █ ███
         ███  ███       ███   ███  ███       ███       ███  ████
    ███████    ███████  ███   ███  ████████  ████████  ███   ███

    an array of cells (background|foreground colors and character)
###

use ../../../kxk    ▪ kseg
use ../../theme     ◆ color
use ../../edit/tool ◆ belt

function screen

    @: @t -> 
    
        @init()        
    
    init: => # called by ked before every screen redraw
    
        @rows = @t.rows()
        @cols = @t.cols()
        
        @c = belt.cells @cols @rows
        # @meta_clear()

        @frameRuns  = []
        @eraseRects = []
        
    #  ███████  ████████  █████████  
    # ███       ███          ███     
    # ███████   ███████      ███     
    #      ███  ███          ███     
    # ███████   ████████     ███     
    
    add: x y char fg bg =>
        
        w = kseg.segWidth char
        if w > 1
            if char.length > 4
                char = '\x1b]66;w=2;' + char + '\x07'
            @set x   y char fg bg
            @set x+1 y null fg bg
            2
        else
            @set x y char fg bg
            1

    #  the blocks of a scaled line form a run of adjacent cells. a run is
    #  remembered so the next frame can erase its whole rectangle: erasing
    #  only the top left cell of a block leaves the row offsets of the cells
    #  below it behind, and the terminal shifts a new block right when it
    #  hits one of those

    addRun: x y scale w =>

        @frameRuns ?= []

        if run = @frameRuns[-1]
            if run[1] == y and run[2] == scale and run[0] + run[3]*scale == x
                run[3] = run[3] + w
                ⮐

        @frameRuns.push [x y scale w]

    #  a character in a block of scale by scale cells

    scaled_char: char scale width -> "\x1b]66;s=#{scale}:w=#{width};#{char}\x07"

    add_scaled: x y char fg bg scale =>

        ⮐ @add x y char fg bg if scale <= 1

        w = max 1 kseg.segWidth(char)

        if @t.textSizing
            char = @scaled_char char scale w
            @addRun x y scale w

        @set x y char fg bg

        for j in 0...scale
            for i in 0...scale*w
                if i or j
                    if j > 0 and i == 0 and @t.textSizing
                        @set x+i y+j "\x1b[#{scale*w}C" null null
                    else
                        @set x+i y+j null null null

        scale*w
    
    set: x y char fg bg =>
        
        if 0 <= x < @cols and 0 <= y < @rows
            @c[y][x].char = char
            @c[y][x].fg = fg ? []
            @c[y][x].bg = bg ? []
            
    set_char: x y char =>

        if 0 <= x < @cols and 0 <= y < @rows
            @c[y][x].char = char

    set_ch_fg: x y char fg =>

        if 0 <= x < @cols and 0 <= y < @rows
            @c[y][x].char = char
            @c[y][x].fg   = fg
            
    set_bg: x y bg =>
        
        if 0 <= x < @cols and 0 <= y < @rows
            ▴ valid @c[y][x]
            if @c[y][x]
                @c[y][x].bg = bg

    set_fg: x y fg =>
        
        if 0 <= x < @cols and 0 <= y < @rows
            @c[y][x].fg = fg

    set_fg_bg: x y fg bg =>
        
        if 0 <= x < @cols and 0 <= y < @rows
            @c[y][x].fg = fg
            @c[y][x].bg = bg
            
    #  fill the background of every cell of the screen
    
    fill_bg: bg =>
        
        for row in @c
            for cell in row
                cell.bg = bg
            
    # ██     ██  ████████  █████████   ███████ 
    # ███   ███  ███          ███     ███   ███
    # █████████  ███████      ███     █████████
    # ███ █ ███  ███          ███     ███   ███
    # ███   ███  ████████     ███     ███   ███
            
    # meta_set: x y m =>
    #     
    #     if 0 <= x < @cols and 0 <= y < @rows
    #         @m[y][x] = m
            
    # meta_clear: =>
    #     
    #     @m = belt.metas @cols @rows
            
    #  ███████   ████████  █████████  
    # ███        ███          ███     
    # ███  ████  ███████      ███     
    # ███   ███  ███          ███     
    #  ███████   ████████     ███     
    
    get_char: x y =>

        if 0 <= x < @cols and 0 <= y < @rows
            ⮐ @c[y][x].char
        ''

    get_fg: x y =>
        
        if 0 <= x < @cols and 0 <= y < @rows
            ⮐ @c[y][x].fg
        []

    get_bg: x y =>
        
        if 0 <= x < @cols and 0 <= y < @rows
            ⮐ @c[y][x].bg
        []
        
    #  the buffer as text, one line per row
    #  
    #  the trailing spaces are gone, so a line can be compared as it is
    #  a wide character takes two cells, and the second one is empty
    
    text: =>
        
        lines = []
        
        for y in 0...@rows
            
            line = ''
            
            for x in 0...@cols
                
                ch = @c[y][x].char
                ch = ' ' if not valid ch
                
                line += ch
            
            lines.push line.replace(/\s+$/ '')
        
        lines
    
    #  the buffer as text, with the cursors marked
    #  
    #  a cursor is a character with escape sequences around it: the main
    #  cursor is in the colors of the other way round and underlined, the
    #  other cursors are in the colors of the other way round
    
    textMarked: =>
        
        lines = []
        
        for y in 0...@rows
            
            line = ''
            
            for x in 0...@cols
                
                ch = @c[y][x].char
                ch = ' ' if not valid ch
                
                if mark = @c[y][x].mark
                    if mark == 'main'
                        line += '\x1b[7;4:3m'
                    else
                        line += '\x1b[7m'
                    line += ch + '\x1b[0m'
                else
                    line += ch
            
            lines.push line.replace(/\s+$/ '')
        
        lines
    
    #  the buffer as text, with the colors of the cells and the cursors
    #  
    #  a line ends with a reset, so its colors do not run into the text
    #  that follows it
    #  
    #  a cursor is a character with escape sequences around it, the same
    #  way it is marked in textMarked
    
    textColored: =>
        
        lines = []
        
        for y in 0...@rows
            
            line = ''
            pbg = ''
            pfg = ''
            
            for x in 0...@cols
                
                cell = @c[y][x]
                ch = cell.char
                ch = ' ' if not valid ch
                
                bg = color.bg_rgb cell.bg
                if bg != pbg
                    line += bg
                    pbg = bg
                
                fg = color.fg_rgb cell.fg
                if fg != pfg
                    line += fg
                    pfg = fg
                
                if mark = cell.mark
                    line += mark == 'main' ? '\x1b[7;4:3m' : '\x1b[7m'
                    line += ch + '\x1b[0m'
                    #  the reset also clears the colors, so they are set again
                    pbg = ''
                    pfg = ''
                else
                    line += ch
            
            lines.push line + '\x1b[0m'
        
        lines
    
    #  a cell that carries a cursor
    
    set_mark: x y kind =>
        
        if 0 <= x < @cols and 0 <= y < @rows
            @c[y][x].mark = kind
        
    # ████████   ████████  ███   ███  ███████    ████████  ████████   
    # ███   ███  ███       ████  ███  ███   ███  ███       ███   ███  
    # ███████    ███████   ███ █ ███  ███   ███  ███████   ███████    
    # ███   ███  ███       ███  ████  ███   ███  ███       ███   ███  
    # ███   ███  ████████  ███   ███  ███████    ████████  ███   ███  
    
    render: =>
        
        @t.write @renderString()

    #  erase a rectangle of cells, including any scaled text drawn there
    #  earlier in the frame
    #
    #  the terminal keeps the cells below the first row of a text sizing
    #  block after the block itself is overwritten, so the rectangle is
    #  erased on the terminal as well, before the frame is written. this is
    #  what lets a popup draw over a scaled line.

    erase_scaled: x1 y1 x2 y2 bg=null =>

        x1 = max 0 x1
        y1 = max 0 y1
        x2 = min @cols-1 x2
        y2 = min @rows-1 y2

        ⮐  if x1 > x2 or y1 > y2

        @eraseRects ?= []
        @eraseRects.push [x1 y1 x2 y2]

        for y in y1..y2
            for x in x1..x2
                @c[y][x].char = ' '
                @c[y][x].bg   = bg if bg?

    #  the frame as it is written to the terminal
    #
    #  the block runs of the previous frame are erased first. the erase must
    #  cover the whole rectangle of a run: the terminal keeps the row offset
    #  of the cells below a block's first row even after the block is gone

    renderString: =>

        s = ''
        pbg = ''
        pfg = ''

        for [bx by scale width] in @lastRuns ? []
            for r in by...by+scale
                s += "\x1b[#{r+1};#{bx+1}H\x1b[#{width*scale}X"

        for [x1 y1 x2 y2] in @eraseRects ? []
            for r in y1..y2
                s += "\x1b[#{r+1};#{x1+1}H\x1b[#{x2-x1+1}X"

        @lastRuns   = @frameRuns ? []
        @frameRuns  = []
        @eraseRects = []

        s += '\x1b[H'
        
        for y in 0...@rows
            for x in 0...@cols
            
                char = @c[y][x].char
                continue if char == null
                                    
                bg = color.bg_rgb @c[y][x].bg
                if bg != pbg
                    s += bg
                    pbg = bg
                fg = color.fg_rgb @c[y][x].fg
                if fg != pfg
                    s += fg
                    pfg = fg
                
                # for mp in @m[y][x].pre
                #     s += mp 
                    
                s += char
                
                # for mp in @m[y][x].pst
                #     s += mp 
                
            s += '\n' if y != @rows-1

        s
        
export screen
