
use ../../edit/tool ◆ belt
use ../../theme     ◆ color theme
use ../../util/img  ◆ rounded
■cells
###
    represents a rectangular subset of screen cells
    wraps screen cell manipulation functions with transformed coordinates
    provides some utilities to quickly fill cells
###
    @: @screen -> @x = @y = @cols = @rows = 0
    
    rect: -> [@x @y @x+@cols-1 @y+@rows-1]
    
    layout: @x @y @cols @rows =>
        
    wx: x -> x < 0 ? @x+@cols+x : @x+x
    wy: y -> y < 0 ? @y+@rows+y : @y+y
    
    inside:  x y -> 0 <= x < @cols and 0 <= y < @rows
    outside: x y -> not @inside x y
    
    add:        x y char fg bg => if @inside(x y) ➜ @screen.add       @wx(x) @wy(y) char fg bg else Infinity
    add_scaled: x y char fg bg scale line=null => if @inside(x y) ➜ @screen.add_scaled @wx(x) @wy(y) char fg bg scale line else Infinity
    erase_scaled: x1 y1 x2 y2 bg=null => @screen.erase_scaled @wx(x1) @wy(y1) @wx(x2) @wy(y2) bg
    set:        x y char fg bg => if @inside(x y) ➜ @screen.set       @wx(x) @wy(y) char fg bg
    set_unsafe: x y char fg bg =>                   @screen.set        @x+x   @y+y  char fg bg
    set_char:   x y char       => if @inside(x y) ➜ @screen.set_char  @wx(x) @wy(y) char
    set_ch_fg:  x y char fg    => if @inside(x y) ➜ @screen.set_ch_fg @wx(x) @wy(y) char fg
    set_bg:     x y bg         => if @inside(x y) ➜ @screen.set_bg    @wx(x) @wy(y) bg
    set_fg:     x y fg         => if @inside(x y) ➜ @screen.set_fg    @wx(x) @wy(y) fg
    set_fg_bg:  x y fg bg      => if @inside(x y) ➜ @screen.set_fg_bg @wx(x) @wy(y) fg bg
    set_attr:   x y attr ul    => if @inside(x y) ➜ @screen.set_attr  @wx(x) @wy(y) attr ul
    get_attr:   x y            => @screen.get_attr @wx(x) @wy(y)

    #  a cell of a scaled block belongs to the block, not to the text of the
    #  row it covers, so a decoration of another line must leave it alone

    isScaled: x y => @screen.isBlock @wx(x) @wy(y)

    #  the block a cell belongs to, in cells coordinates:
    #  [x y scale w line] of its top left cell, or null

    blockAt: x y =>

        block = @screen.blockAt @wx(x) @wy(y)

        ⮐ if not block?

        [block[0]-@x block[1]-@y block[2] block[3] block[4]]
    
    get_char: x y => @screen.get_char @wx(x) @wy(y)
    get_bg:   x y => @screen.get_bg   @wx(x) @wy(y)
    get_fg:   x y => @screen.get_fg   @wx(x) @wy(y)
        
    isInsidePos:     x y => [x y] = belt.pos(x y); (0 <= x < @cols) and (0 <= y < @rows)
    isOutsidePos:    x y => [x y] = belt.pos(x y); x < 0 or x >= @cols or y < 0 or y >= @rows
    
    isInsideScreen:  x y => @isInsidePos  @posForScreen(x y)
    isOutsideScreen: x y => @isOutsidePos @posForScreen(x y)
    
    isInsideEvent:   evt => @isInsidePos  @posForEvent(evt)
    isOutsideEvent:  evt => @isOutsidePos @posForEvent(evt)
    
    rectForScreen:   rct => p1 = @posForScreen(rct[0] rct[1]) ; p2 = @posForScreen(rct[2] rct[3]) ; [p1[0] p1[1] p2[0] p2[1]]
    posForScreen:    x y => [x y] = belt.pos(x y); [x-@x y-@y]
    screenForPos:    x y => [x y] = belt.pos(x y); [x+@x y+@y]
    posForEvent:     evt => @posForScreen evt.cell
        
    bg_rect: x1 y1 x2 y2 bg =>
    
        x1 = @cols + x1 if x1 < 0
        x2 = @cols + x2 if x2 < 0

        y1 = @rows + y1 if y1 < 0
        y2 = @rows + y2 if y2 < 0
        
        for row in y1..y2
            if row < @rows
                for col in x1..x2
                    if col < @cols
                        @set_bg col row bg

    #  fill the cells of a block, in cells coordinates, with a background
    #  a block is [x y scale w line], as returned by blockAt

    bg_block: block bg =>

        for r in block[1]...min(@rows, block[1]+block[2])
            for c in block[0]...min(@cols, block[0]+block[2]*block[3])
                @set_bg c r bg

    bg_fill: x1 y1 x2 y2 bg =>
    
        x1 = @cols + x1 if x1 < 0
        x2 = @cols + x2 if x2 < 0

        y1 = @rows + y1 if y1 < 0
        y2 = @rows + y2 if y2 < 0
        
        ⮐ if x1 > x2
        
        for row in y1..y2
            if row < @rows
                for col in x1..x2
                    if col < @cols
                        @set_bg   col row bg
                        @set_char col row ' '
                        
    fill_rect: x1 y1 x2 y2 char fg bg =>
        
        x1 = clamp 0 @cols-1 x1
        y1 = clamp 0 @rows-1 y1
        x2 = @cols + x2 if x2 < 0
        y2 = @rows + y2 if y2 < 0
        
        for row in y1..y2
            for col in x1..x2
                @set col row char fg bg
                
    fill_row: row x1 x2 char fg bg =>
        
        ⮐ if x1 < 0 and x2 < 0

        x1 = clamp 0 @cols-1 x1
        x2 = clamp 0 @cols-1 x2
        
        ⮐ if x2 < x1
        
        for col in x1..x2
            @set col row char fg bg

    fill_col: col y1 y2 char fg bg =>
        
        ⮐ if y1 < 0 and y2 < 0

        y1 = clamp 0 @rows-1 y1
        y2 = clamp 0 @rows-1 y2
        
        ⮐ if y2 < y1
        
        for row in y1..y2
            @set col row char fg bg
            
    draw_frame: x1 y1 x2 y2 opt =>

        ⮐ if x1 < 0 and x2 < 0
        ⮐ if y1 < 0 and y2 < 0
        
        x2 = @cols + x2 if x2 < 0
        y2 = @rows + y2 if y2 < 0
        
        opt ?= {}
        opt.pad ?= [1 0] # padding at left and right edge by default
        
        # ╭─┬─╮
        # │ │ │
        # ├─┼─┤ 
        # │ │ │
        # ╰─┴─╯
        
        fg = opt.fg ? '#888'
        bg = opt.bg ? null
        
        @set  x1  y1 '╭' fg bg
        @set  x2  y1 '╮' fg bg
        @set  x1  y2 '╰' fg bg
        @set  x2  y2 '╯' fg bg
        
        @fill_row y1 x1+1 x2-1 '─' fg bg
        @fill_row y2 x1+1 x2-1 '─' fg bg
        @fill_col x1 y1+1 y2-1 '│' fg bg
        @fill_col x2 y1+1 y2-1 '│' fg bg
        
        for x in 0...opt.pad[0] # horizontal padding
            @fill_col x1+1+x y1+1 y2-1 ' ' fg bg
            @fill_col x2-1-x y1+1 y2-1 ' ' fg bg
        
        for y in opt.hdiv ? []
            @set  x1  y '' fg bg
            @set  x2  y '' fg bg
            @fill_row y x1+1 x2-1 '─' fg bg
            
    draw_rounded_border: x1 y1 x2 y2 opt =>
    
        ⮐ if x1 < 0 and x2 < 0
        ⮐ if y1 < 0 and y2 < 0
        
        x2 = @cols + x2 if x2 < 0
        y2 = @rows + y2 if y2 < 0
        
        opt ?= {}
        fg     = opt.fg ? '#888'
        zLayer = opt.zLayer ? 1000
        
        if @screen.t.headless
            @draw_frame x1 y1 x2 y2 opt
            ⮐
        
        @img x1 y1 'rounded.border.tl' fg zLayer  
        @img x2 y1 'rounded.border.tr' fg zLayer  
        @img x1 y2 'rounded.border.bl' fg zLayer  
        @img x2 y2 'rounded.border.br' fg zLayer  
        
        @img x1+1 y1 'rounded.border.t'  fg zLayer x2-1 
        @img x1 y1+1 'rounded.border.l'  fg zLayer x1 y2-1  if y1+1 < y2
        @img x1+1 y2 'rounded.border.lb' fg zLayer          if x1+1 < x2
        @img x1+2 y2 'rounded.border.b'  fg zLayer x2-1
        @img x2 y1+1 'rounded.border.rt' fg zLayer x2       if y1+1 < y2
        @img x2 y1+2 'rounded.border.r'  fg zLayer x2 y2-1  if y1+2 < y2
        
    draw_vertical_padding: x y fg bg zLayer=1000 ->
    
        rounded.place @wx(x) @wy(y) 'rounded.vertical' fg null null zLayer bg

    draw_horizontal_padding: x y fg bg zLayer=1000 ->
    
        rounded.place @wx(x) @wy(y) 'rounded.horizontal' fg null null zLayer bg
        
    cellRectImageIdsFor: rect csz fg ->
        
        t = @screen.t
        
        key = "#{rect.w}x#{rect.h}:#{csz[0]}x#{csz[1]}:#{fg}"
        
        if @cellRectKey == key and @cellRectImageIds?
            ⮐ @cellRectImageIds
        
        if @cellRectImageIds?
            for imgId in @cellRectImageIds
                t.deleteImage imgId
        
        wpx = rect.w * csz[0]
        hpx = rect.h * csz[1]
        
        @cellRectImageIds = [
            t.sendImg(rounded.cellRect('top'    wpx    csz[1] fg))
            t.sendImg(rounded.cellRect('bottom' wpx    csz[1] fg))
            t.sendImg(rounded.cellRect('left'   csz[0] hpx    fg))
            t.sendImg(rounded.cellRect('right'  csz[0] hpx    fg))
            ]
        @cellRectKey = key
        
        @cellRectImageIds
        
    draw_cell_rect: rect ->
    
        t = @screen.t
        csz = t.cellsz

        if t.headless
            @cellRect = rect
            ⮐ []

        ⮐ [] if empty csz
        
        ids = @cellRectImageIdsFor rect csz theme.editor.cellrect
        
        x1 = @wx rect.x
        y1 = @wy rect.y
        x2 = @wx(rect.x + rect.w - 1)
        y2 = @wy(rect.y + rect.h - 1)
        
        @cellRectPid ?= 0
        @cellRectPid += 1
        pid = @cellRectPid
        
        pw = rect.w * csz[0]
        ph = rect.h * csz[1]
        
        t.placeOverlay ids[0] pid x1 y1 0 pw     csz[1]
        t.placeOverlay ids[1] pid x1 y2 0 pw     csz[1]
        t.placeOverlay ids[2] pid x1 y1 0 csz[0] ph
        t.placeOverlay ids[3] pid x2 y1 0 csz[0] ph
        
        [[ids[0] pid] [ids[1] pid] [ids[2] pid] [ids[3] pid]]
        
    del_cell_rect: rectid ->

        delete @cellRect

        ⮐ if empty rectid
        
        for [imgId pid] in rectid
            @screen.t.hideOverlay imgId pid

    draw_cell_rect_corners: =>

        # a headless dump has no images, so mark the rect with corner glyphs

        ⮐ if not @cellRect?

        rect = @cellRect

        @set_char rect.x              rect.y              '╭'
        @set_char rect.x+rect.w-1     rect.y+rect.h-1     '╯'
            
    draw_rounded_cursor: x y fg scale=1 =>
        
        if @screen.t.headless
            @set_mark x y 'main'
            @swap_fg_bg x y
            ⮐
            
        rounded.place @wx(x) @wy(y) "rounded.cursor" fg null null 1000 null scale
        
    draw_rounded_multi_cursor: x y fg scale=1 =>
        
        if @screen.t.headless
            @set_mark x y 'multi'
            @swap_fg_bg x y
            ⮐
            
        rounded.place @wx(x) @wy(y) "rounded.multi" fg null null 1000 null scale
        
    set_mark: x y kind =>
        
        if @inside(x y) ➜ @screen.set_mark @wx(x) @wy(y) kind
        
    swap_fg_bg: x y =>
        
        fg = @get_fg x y
        bg = @get_bg x y
        
        @set_fg_bg x y bg fg
        
    img: x y name fg zLayer=1000 xe ye =>
    
        ⮐ if @outside x y
        
        rounded.place @wx(x) @wy(y) name fg @wx(xe) @wy(ye) zLayer
        
    adjustContrastForHighlight: x y highlightColor =>
        
        ofg = @get_fg x y
        @set_fg x y color.adjustForBackground(ofg highlightColor)        
                        
export cells
