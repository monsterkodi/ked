
use ../../../kxk ◆ post
use ../../theme  ◆ theme
use ../base      ◆ view input tripleinput

■sheenode□view
    # editor for a single sheetree node
    
    @: @editor @name ->

        super @editor.screen @name

        @height = 7

        @setColor 'bg' theme.uniko.bg

        @typeArg  = new tripleinput @screen "#{@name}_typearg"  ['type' 'arg']
        @xwrInput = new tripleinput @screen "#{@name}_xwr"  ['x' 'w' 'r'] maxsize:5 number:true
        @yhbInput = new tripleinput @screen "#{@name}_yhb"  ['y' 'h' 'b'] maxsize:5 number:true
        
        @items      = [@typeArg @xwrInput @yhbInput]
        @focusRing  = @typeArg.inputs.concat(@xwrInput.inputs).concat(@yhbInput.inputs)
        @mouseItems = @items
        
        @isVisible = false
        
    onNode: node =>
    
        @typeArg.inputs[0].set String(node.type ? '')
        @typeArg.inputs[1].set String(node.arg ? '')

        @xwrInput.inputs[0].set String(node.x ? '')
        @xwrInput.inputs[1].set String(node.w ? '')
        @xwrInput.inputs[2].set String(node.r ? '')

        @yhbInput.inputs[0].set String(node.y ? '')
        @yhbInput.inputs[1].set String(node.h ? '')
        @yhbInput.inputs[2].set String(node.b ? '')
        
    show: =>

        super()

        post.emit 'redraw'

    hide: =>

        ⮐ if @hidden()

        super()

        post.emit 'redraw'

    layout: x y w h =>

        super x y w h
        
        @layout_vbox x y w h @items
        
    draw: =>

        ⮐ if @hidden() or @collapsed()

        @cells.fill_rect 0 0 -1 -1 ' ' null @color.bg
        
        for item in @items
            item.draw()

        super()

export sheenode
