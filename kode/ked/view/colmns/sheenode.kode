
use ../../../kxk ◆ post
use ../../theme  ◆ theme
use ../base      ◆ view input tripleinput
use ../../popo   ◆ layout

■sheenode□view
    # editor for a single sheetree node
    
    @: @editor @name ->

        super @editor.screen @name

        @height = 9

        @setColor 'bg' theme.uniko.bg

        @typeArg    = new tripleinput @screen "#{@name}_typearg"  ['type' 'arg']
        @xwrInput   = new tripleinput @screen "#{@name}_xwr"  ['x' 'w' 'r'] maxsize:5 number:true min:0 max:999
        @yhbInput   = new tripleinput @screen "#{@name}_yhb"  ['y' 'h' 'b'] maxsize:5 number:true min:0 max:999
        @scaleInput = new tripleinput @screen "#{@name}_scale" ['scale'] maxsize:5 number:true min:1 max:7
        
        @items      = [@typeArg @xwrInput @yhbInput @scaleInput]
        @focusRing  = @typeArg.inputs.concat(@xwrInput.inputs).concat(@yhbInput.inputs).concat(@scaleInput.inputs)
        @mouseItems = @items
        @wheelItems = [@xwrInput @yhbInput @scaleInput]
        
        for input in @focusRing
            input.on 'valueChange' @onInputChange

        @typeArg.inputs[0].on 'action' @onTypeAction
        @typeArg.inputs[1].on 'action' @onArgAction
        
        @isVisible = false
        
    onInputChange: input =>
        
        if 
            input.name.endsWith 'xwr_x' ➜ @node.x = input.value
            input.name.endsWith 'xwr_w' ➜ @node.w = input.value ; delete @node.r ; @xwrInput.inputs[2].set ''
            input.name.endsWith 'xwr_r' ➜ @node.r = input.value ; delete @node.w ; @xwrInput.inputs[1].set ''
            input.name.endsWith 'yhb_y' ➜ @node.y = input.value
            input.name.endsWith 'yhb_h' ➜ @node.h = input.value ; delete @node.b ; @yhbInput.inputs[2].set ''
            input.name.endsWith 'yhb_b' ➜ @node.b = input.value ; delete @node.h ; @yhbInput.inputs[1].set ''
            input.name.endsWith 'scale_scale' ➜ @node.scale = input.value
            
        @emit 'shee.node' @node

    onTypeAction: action text =>

        ⮐ if action != 'change'

        old = layout.typeOf @node

        if empty text
            delete @node[old] if old?
        else if text in ['erase''text''pattern''bg''fg']
            delete @node[old] if old? and old != text
            @node[text] = @typeArg.inputs[1].current()
        else
            ⮐

        @emit 'shee.node' @node

    onArgAction: action text =>

        ⮐ if action != 'change'

        type = layout.typeOf @node

        ⮐ if not type?

        @node[type] = text

        @emit 'shee.node' @node
            
    onMouseEnter: event =>
        
        if @node
            post.emit 'sheetree.select' @node.index
            
        super event
        
    onNode: @node =>
    
        type = layout.typeOf node
        arg  = layout.argOf node

        @typeArg.inputs[0].set String(type ? '')
        @typeArg.inputs[1].set String(arg ? '')

        @xwrInput.inputs[0].set String(node.x ? '')
        @xwrInput.inputs[1].set String(node.w ? '')
        @xwrInput.inputs[2].set String(node.r ? '')

        @yhbInput.inputs[0].set String(node.y ? '')
        @yhbInput.inputs[1].set String(node.h ? '')
        @yhbInput.inputs[2].set String(node.b ? '')

        @scaleInput.inputs[0].set String(node.scale ? '')
        
        idx = @node.bg and not @node.fg ? 1 : 0
        post.emit 'colorpicker.show' [@node.fg @node.bg] focus:false select:idx
        
    layout: x y w h =>

        super x y w h
        
        @layout_vbox x y w h @items
        
    draw: =>

        ⮐ if @hidden() or @collapsed()

        @cells.fill_rect 0 0 -1 -1 ' ' null @color.bg
        
        for item in @items
            item.draw()

        super()

export sheenode
