
use ../../../kxk ◆ post
use ../../theme  ◆ theme
use ../base      ◆ view input tripleinput

■sheenode□view
    # editor for a single sheetree node
    
    @: @editor @name ->

        super @editor.screen @name

        @height = 8

        @setColor 'bg' theme.uniko.bg

        @input    = new input       @screen "#{@name}_input"
        @xwrInput = new tripleinput @screen "#{@name}_xwr"  ['x' 'w' 'r']
        @yhbInput = new tripleinput @screen "#{@name}_yhb"  ['y' 'h' 'b']
        
        @items = [@input @xwrInput @yhbInput]
        @focusRing = [@input].concat(@xwrInput.inputs).concat(@yhbInput.inputs)
        
        @input.drawUnfocusedCursors = false

        @input.on 'action' @onInputAction

        @isVisible = false
        
    hasFocus: => 
        
        for item in @focusRing
            if item.hasFocus() ➜ ⮐ true
        false
    
    grabFocus: => @focusInput()
    
    focusDelta: delta =>
    
        for item,index in @focusRing
            if item.hasFocus()
                num = @focusRing.length
                if 0 <= index+delta < num
                    if @focusRing[index+delta].focusable
                        @focusRing[index+delta].grabFocus()
                        ⮐ true
                ⮐ false
        false
            
    focusNext: => @focusDelta 1
    focusPrev: => @focusDelta -1

    focusInput: =>

        @input.grabFocus()
        true

    show: =>

        @input.set ''

        super()

        post.emit 'redraw'

    hide: =>

        ⮐ if @hidden()

        super()

        @input.state.deselect()

        post.emit 'redraw'

    layout: x y w h =>

        super x y w h
        
        o = 1
        for item in @items
            item.layout x+1 y+o w-2 1
            o += 2

    draw: =>

        ⮐ if @hidden() or @collapsed()

        @cells.fill_rect 0 0 -1 -1 ' ' null @color.bg
        
        for item in @items
            item.draw()

        super()

    onInputAction: action text =>

    onMouse: event =>

        ⮐ if @hidden()
        
        for item in @items
            ret = item.onMouse event ; ⮐ ret if ret?.redraw
            
        super event

    onKey: key event =>

        ⮐ false if @hidden()
        
        switch event.combo
            'down''tab'      ➜ ⮐ @focusNext() 
            'up''shift+tab'  ➜ ⮐ @focusPrev()

        for item in @
            if item.hasFocus() ➜ ⮐ item.onKey key event

        false

export sheenode
