
use ../../../kxk    ▪ post slash nfs
use ../../theme     ◆ color theme icons
use ../../edit/tool ◆ belt
use ../../index     ◆ indexer
use ../../popo      ◆ layout
use ../menu         ◆ filterchoice

■sheetree□filterchoice

    @: @editor @name features ->
        
        super @editor.screen @name features
        
        @editor.state.on 'cursorsSet' @onCursorsSet
        
        post.on 'editor.resize'   @onEditorResize
        post.on 'sheetree.select' @select
        post.on 'sheet.edited'    @onSheetEdited
        post.on 'popup.show'      @hideRect
        post.on 'popup.hide'      @showRect
                
    hide: => 
        post.emit 'cells.rect'
        super()
        
    select: row => 

        super row
        @showRect()
        
    hideRect: => post.emit 'cells.rect'
    showRect: => if @editor.state.rectree and @current() ➜ post.emit 'cells.rect' @current().rect.abs
        
    grabFocus: =>
    
        ⮐ if @hidden() or @collapsed()
        super()
        
    onNode: node =>
    
        delete @editor.state.rectreeCols
        delete @editor.state.rectreeRows
        @onEditorResize()

    onEditorResize: =>
        
        ⮐ if @hidden() or @collapsed()

        row = @currentIndex()
        @reloadTree() 
        @highlight row
        @showRect()

    reloadTree: => 
        
        if @editor.state.rectree?
            layout.titlify @editor.cells @editor.state.rectree
            items = @itemsForTree @editor.state.rectree
            @set items 'title'
        else
            @hideRect()

    itemsForTree: node =>

        items = []

        @addItemsForTree node items

        items

    addItemsForTree: node items =>

        node.index = items.length

        items.push node if node.title?

        for child in node.children ? []
            @addItemsForTree child items

    onSheetEdited: =>

        @reloadTree()
        @showRect()
        
    onCursorsSet: =>

        if @editor.state.rectree?
            cell = @editor.state.sheetCellForPos @editor.state.mainCursor()
            if item = layout.nodeForPos(@editor.cells @editor.state.rectree cell)
                if item.index? and 0 <= item.index < @fuzzied.length
                    @highlight item.index
                    @showRect()
                    @emit 'tree.node' @current()
            
    jumpTo: choice => 
        
        state = @editor.state
        rect  = choice.rect.abs

        if not layout.holds choice, state.sheetCellForPos(state.mainCursor())
            pos = state.sheetPosForCell [rect.x rect.y+layout.scaleOf(choice)-1]
            post.emit 'goto.line' pos[1] pos[0]
        node = @current()
        node.index = @currentIndex()
        @emit 'tree.node' node
        
    deleteCurrent: =>

        row = @currentIndex()

        @editor.deleteSheetNode @current()

        ⮐ true if empty @fuzzied

        @highlight min(row @fuzzied.length-1)
        @showRect()

        node = @current()
        node.index = @currentIndex()
        @emit 'tree.node' node

        true

    selectNext: -> super(); @jumpTo @current()
    selectPrev: -> super(); @jumpTo @current()
                
    emitAction: action choice event  ->
    
        if empty choice
            error 'funtree.emitAction -- empty choice ▸ action:' action 
            error 'funtree.emitAction -- empty choice ▸ event:' event
            ⮐ 
        
        switch action
        
            'space'
            
                @jumpTo choice
                @grabFocus()
                ⮐ 
        
            'right'
            
                @selectNext()
                choice = @choiceAtRow @currentIndex()
                @jumpTo choice
                @grabFocus()
                ⮐ 
                
            'left'
            
                @selectPrev()
                choice = @choiceAtRow @currentIndex()
                @jumpTo choice
                @grabFocus()
                ⮐ 
                
            'click'
            'return'
            
                @jumpTo choice
                post.emit 'focus' 'editor'
                ⮐ 
                
            'drag'
            
                @jumpTo choice
                ⮐ 

            'delete' 'entf'

                ⮐ @deleteCurrent()
                
            # ➜ log 'unhandled action?' action
                 
        super action choice event
        
export sheetree
