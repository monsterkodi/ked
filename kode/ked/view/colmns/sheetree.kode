
use ../../../kxk    ▪ post slash nfs
use ../../theme     ◆ color theme icons
use ../../edit/tool ◆ belt
use ../../index     ◆ indexer
use ../../popo      ◆ layout
use ../menu         ◆ filterchoice

■sheetree□filterchoice

    @: @editor @name features ->
        
        super @editor.screen @name features
        
        @editor.state.on 'cursorsSet' @onCursorsSet
        
        post.on 'editor.resize'   @onEditorResize
        post.on 'sheetree.select' @select
        
    onEditorResize: =>
        
        ⮐ if @hidden() or @collapsed()

        row = @currentIndex()
        @reloadTree() 
        @select row
        
    hide: => 
        post.emit 'cells.rect'
        super()
        
    select: row => 

        super row
        post.emit 'cells.rect' @current().rect
        
    grabFocus: =>
    
        ⮐ if @hidden() or @collapsed()
        super()
        
    onNode: node =>
    
        layout.modifyTreeNode @editor.sheet.rectree node
        delete @editor.sheet.cols
        delete @editor.sheet.rows
        row = @currentIndex()
        @reloadTree()
        @highlight row
        # post.emit 'redraw'
        post.emit 'cells.rect' @current().rect
        
    reloadTree: => 
        
        if @editor.sheet?.rectree
            items = layout.titlify @editor.cells @editor.sheet.rectree
            @set items 'title'
        else
            post.emit 'cells.rect'
        
    onCursorsSet: =>

        if @editor.sheet?.rectree
            if item = layout.nodeForPos(@editor.sheet.rectree @editor.state.mainCursor())
                if item.index? and 0 <= item.index < @fuzzied.length
                    log "GOT ITEM #{item.index}/#{@fuzzied.length}"
                    @highlight item.index
                    post.emit 'cells.rect' @current().rect
            
    jumpTo: choice => 
        
        post.emit 'goto.line' choice.y choice.x
        node = @current()
        node.index = @currentIndex()
        @emit 'tree.node' node
        
    selectNext: -> super(); @jumpTo @current()
    selectPrev: -> super(); @jumpTo @current()
                
    emitAction: action choice event  ->
    
        if empty choice
            error 'funtree.emitAction -- empty choice ▸ action:' action 
            error 'funtree.emitAction -- empty choice ▸ event:' event
            ⮐ 
        
        switch action
        
            'space'
            
                @jumpTo choice
                @grabFocus()
                ⮐ 
        
            'right'
            
                @selectNext()
                choice = @choiceAtRow @currentIndex()
                @jumpTo choice
                @grabFocus()
                ⮐ 
                
            'left'
            
                @selectPrev()
                choice = @choiceAtRow @currentIndex()
                @jumpTo choice
                @grabFocus()
                ⮐ 
                
            'click'
            'return'
            
                @jumpTo choice
                post.emit 'focus' 'editor'
                ⮐ 
                
            'drag'
            
                @jumpTo choice
                ⮐ 
                
            # ➜ log 'unhandled action?' action
                 
        super action choice event
        
export sheetree
