
use ../../../kxk    ▪ post slash nfs
use ../../theme     ◆ color theme icons
use ../../edit/tool ◆ belt
use ../../index     ◆ indexer
use ../../popo      ◆ layout
use ../menu         ◆ filterchoice

■sheetree□filterchoice

    @: @editor @name features ->
        
        super @editor.screen @name features
        
        @editor.state.on 'cursorsSet' @onCursorsSet
        
        post.on 'editor.resize'   @onEditorResize
        post.on 'sheetree.select' @select
        post.on 'sheet.edited'    @onSheetEdited
        
    onEditorResize: =>
        
        ⮐ if @hidden() or @collapsed()

        row = @currentIndex()
        @reloadTree() 
        @highlight row
        
    hide: => 
        post.emit 'cells.rect'
        super()
        
    select: row => 

        super row
        post.emit 'cells.rect' @current().rect.abs
        
    grabFocus: =>
    
        ⮐ if @hidden() or @collapsed()
        super()
        
    onNode: node =>
    
        delete @editor.state.rectreeCols
        delete @editor.state.rectreeRows
        row = @currentIndex()
        @reloadTree()
        @highlight row
        post.emit 'cells.rect' @current().rect.abs
        
    reloadTree: => 
        
        if @editor.state.rectree?
            layout.titlify @editor.cells @editor.state.rectree
            items = @itemsForTree @editor.state.rectree
            @set items 'title'
        else
            post.emit 'cells.rect'

    itemsForTree: node =>

        items = []

        @addItemsForTree node items

        items

    addItemsForTree: node items =>

        node.index = items.length

        items.push node if node.title?

        for child in node.children ? []
            @addItemsForTree child items

    onSheetEdited: =>

        @reloadTree()
        
    onCursorsSet: =>

        if @editor.state.rectree?
            if item = layout.nodeForPos(@editor.cells @editor.state.rectree @editor.state.mainCursor())
                if item.index? and 0 <= item.index < @fuzzied.length
                    @highlight item.index
                    node = @current()
                    post.emit 'cells.rect' node.rect.abs
                    log 'CURSOR SET'
                    @emit 'tree.node' node
            
    jumpTo: choice => 
        
        rect = choice.rect.abs
        post.emit 'goto.line' rect.y rect.x
        node = @current()
        node.index = @currentIndex()
        @emit 'tree.node' node
        
    selectNext: -> super(); @jumpTo @current()
    selectPrev: -> super(); @jumpTo @current()
                
    emitAction: action choice event  ->
    
        if empty choice
            error 'funtree.emitAction -- empty choice ▸ action:' action 
            error 'funtree.emitAction -- empty choice ▸ event:' event
            ⮐ 
        
        switch action
        
            'space'
            
                @jumpTo choice
                @grabFocus()
                ⮐ 
        
            'right'
            
                @selectNext()
                choice = @choiceAtRow @currentIndex()
                @jumpTo choice
                @grabFocus()
                ⮐ 
                
            'left'
            
                @selectPrev()
                choice = @choiceAtRow @currentIndex()
                @jumpTo choice
                @grabFocus()
                ⮐ 
                
            'click'
            'return'
            
                @jumpTo choice
                post.emit 'focus' 'editor'
                ⮐ 
                
            'drag'
            
                @jumpTo choice
                ⮐ 
                
            # ➜ log 'unhandled action?' action
                 
        super action choice event
        
export sheetree
