
use ../../../kxk    ▪ post slash nfs
use ../../theme     ◆ color theme icons
use ../../edit/tool ◆ belt
use ../../index     ◆ indexer
use ../../popo      ◆ layout
use ../menu         ◆ filterchoice

■sheetree□filterchoice

    @: @editor @name features ->
        
        super @editor.screen @name features
        
        @editor.state.on 'cursorsSet' @onCursorsSet
        
        post.on 'editor.resize'  @onEditorResize
        
    onEditorResize: =>
        
        ⮐ if @hidden() or @collapsed()
        # log "RESIZE #{@visible()} #{@collapsed()}"
        row = @currentIndex()
        @reloadTree() 
        @select row
        
    hide: => 
        post.emit 'cells.rect'
        super()
        
    select: row -> 

        super row
        post.emit 'cells.rect' @current()
        
    grabFocus: =>
    
        log "FOGGUS #{@hidden()} #{@collapsed()} #{@cells.rows} #{@cells.cols}"
        ⮐ if @hidden() or @collapsed()
        super()
        
    reloadTree: => 
        
        if @editor.sheet?.rectree
            tree = layout.regionize @editor.cells @editor.sheet.rectree
            @set layout.titlify(tree) 'title'
        else
            post.emit 'cells.rect'
        
    onCursorsSet: =>
    
        # log 'cursor set'
        @selectItemForPos @editor.state.mainCursor()
        
    selectItemForPos: pos =>
        
        if item = @itemForPos pos
            log 'select item' item
            
    itemForPos: pos =>
        
        for item,idx in @items
            if false # check if item is topmost rect at pos
                ⮐ item
                
    jumpTo: choice => 
        
        post.emit 'goto.line' choice.y choice.x
                
    emitAction: action choice event  ->
    
        if empty choice
            error 'funtree.emitAction -- empty choice ▸ action:' action 
            error 'funtree.emitAction -- empty choice ▸ event:' event
            ⮐ 
        
        switch action
        
            'space'
            
                @jumpTo choice
                @grabFocus()
                ⮐ 
        
            'right'
            
                @selectNext()
                choice = @choiceAtRow @currentIndex()
                @jumpTo choice
                @grabFocus()
                ⮐ 
                
            'left'
            
                @selectPrev()
                choice = @choiceAtRow @currentIndex()
                @jumpTo choice
                @grabFocus()
                ⮐ 
                
            'click'
            'return'
            
                @jumpTo choice
                post.emit 'focus' 'editor'
                ⮐ 
                
            'drag'
            
                @jumpTo choice
                ⮐ 
                
            # ➜ log 'unhandled action?' action
                 
        super action choice event
        
export sheetree
