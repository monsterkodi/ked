
use ../../../kxk    ▪ post slash nfs
use ../../../kxk    ◆ clip
use ../../theme     ◆ color theme icons
use ../../edit/tool ◆ belt
use ../../index     ◆ indexer
use ../../popo      ◆ layout
use ../menu         ◆ filterchoice

■sheetree□filterchoice

    @: @editor @name features ->
        
        super @editor.screen @name features
        
        @editor.state.on 'cursorsSet' @onCursorsSet
        
        post.on 'editor.resize'   @onEditorResize
        post.on 'sheetree.select' @select
        post.on 'sheet.edited'    @onSheetEdited
        post.on 'popup.show'      @hideRect
        post.on 'popup.hide'      @showRect
                
    hide: => 
        post.emit 'cells.rect'
        super()
        
    select: row => 

        super row
        @showRect()
        
    hideRect: => post.emit 'cells.rect'
    showRect: => if @editor.state.rectree and @current() ➜ post.emit 'cells.rect' @current().rect.abs
        
    grabFocus: =>
    
        ⮐ if @hidden() or @collapsed()
        super()
        
    onNode: node =>
    
        delete @editor.state.rectreeCols
        delete @editor.state.rectreeRows
        @onEditorResize()

    onEditorResize: =>
        
        ⮐ if @hidden() or @collapsed()

        row = @currentIndex()
        @reloadTree() 
        @highlight row
        @showRect()

    reloadTree: => 
        
        if @editor.state.rectree?
            layout.titlify @editor.state.sheetSize() @editor.state.rectree
            items = @itemsForTree @editor.state.rectree
            @set items 'title'
        else
            @hideRect()

    itemsForTree: node =>

        items = []

        @addItemsForTree node items

        items

    addItemsForTree: node items =>

        node.index = items.length

        items.push node if node.title?

        for child in node.children ? []
            @addItemsForTree child items

    onSheetEdited: =>

        @reloadTree()
        @showRect()
        
    onCursorsSet: =>

        ⮐ if @jumping

        if @editor.state.rectree?
            cell = @editor.state.sheetCellForPos @editor.state.mainCursor()
            if item = layout.nodeForPos(@editor.state.sheetSize() @editor.state.rectree cell)
                if item.index? and 0 <= item.index < @fuzzied.length
                    @highlight item.index
                    @showRect()
                    @emit 'tree.node' @current()
            
    jumpTo: choice => 
        
        state = @editor.state
        rect  = choice.rect.abs

        if not layout.holds choice, state.sheetCellForPos(state.mainCursor())
            pos = state.sheetPosForCell [rect.x rect.y+layout.scaleOf(choice)-1]
            @jumping = true
            post.emit 'goto.line' pos[1] pos[0]
            @jumping = false
        node = @current()
        node.index = @currentIndex()
        @emit 'tree.node' node
        
    deleteCurrent: =>

        row = @currentIndex()

        @editor.deleteSheetNode @current()

        @jumpToRow min(row @fuzzied.length-1) if valid @fuzzied

        true

    keepSelection: fn =>

        old  = @current()
        path = layout.pathOf(@editor.state.rectree old) if old?

        fn()

        ⮐ if empty @fuzzied

        @jumpToRow @rowForRestore(old path ? [])

    rowForRestore: (old path) =>

        tree = @editor.state.rectree
        best = null
        most = -1

        if old?
            props = layout.ownProps old
            for item,row in @fuzzied
                continue if not (layout.ownProps(item) eql props)
                shared = @sharedPrefix layout.pathOf(tree item) ? [], path
                if shared > most
                    best = row
                    most = shared

        ⮐ best if best?

        path = path.slice()

        while true
            row = @fuzzied.indexOf layout.nodeAtPath(tree path)
            ⮐ row if row >= 0
            break if empty path
            path.pop()

        0

    sharedPrefix: (a b) ->

        n = 0
        n += 1 while n < a.length and n < b.length and a[n] == b[n]
        n

    copyCurrent: =>

        if node = @current()
            clip.copy JSON.stringify(layout.plainNode(node))

        true

    cutCurrent: =>

        @copyCurrent()
        @deleteCurrent()

    pasteNode: =>

        try
            data = JSON.parse clip.paste()
        catch err
            ⮐ true

        ⮐ true if not layout.isNodeData data

        node = @editor.state.insertSheetNode data @current()
        row  = @fuzzied.indexOf node

        @jumpToRow row if row >= 0

        true

    moveCurrent: dir =>

        node = @current()

        if node? and @editor.state.shiftSheetNode node dir
            row = @fuzzied.indexOf node
            @jumpToRow row if row >= 0

        true

    jumpToRow: row =>

        @select row
        @jumpTo @current()

    selectNext: -> @jumpToRow @nextRow()
    selectPrev: ->

        row = @prevRow()

        ⮐ super() if empty row

        @jumpToRow row
                
    emitAction: action choice event  ->
    
        if empty choice
            error 'funtree.emitAction -- empty choice ▸ action:' action 
            error 'funtree.emitAction -- empty choice ▸ event:' event
            ⮐ 
        
        switch action
        
            'space'
            
                @jumpTo choice
                @grabFocus()
                ⮐ 
        
            'right'
            
                @selectNext()
                choice = @choiceAtRow @currentIndex()
                @jumpTo choice
                @grabFocus()
                ⮐ 
                
            'left'
            
                @selectPrev()
                choice = @choiceAtRow @currentIndex()
                @jumpTo choice
                @grabFocus()
                ⮐ 
                
            'click'
            'return'
            
                @jumpTo choice
                post.emit 'focus' 'editor'
                ⮐ 
                
            'drag'
            
                @jumpTo choice
                ⮐ 

            'delete' 'entf'

                ⮐ @deleteCurrent()
                
            # ➜ log 'unhandled action?' action
                 
        super action choice event
        
export sheetree
