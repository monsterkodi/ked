###
     ███████   ███████   ███   ███  ████████   ███████    ███████  
    ███       ███   ███  ███   ███  ███       ███   ███  ███       
    ███████   █████████   ███ ███   ███████   █████████  ███████   
         ███  ███   ███     ███     ███       ███   ███       ███  
    ███████   ███   ███      █      ████████  ███   ███  ███████   
    
    the dialog to save the buffer under another name
###

use ../../../kxk ▪ slash post
use              ◆ browse

function saveas extends browse

    @: @screen @name='saveas' ->
        
        @autoHideInput = false
        
        super @screen @name

    inputIsActive: -> true
    
    autoHide: => 

    onInputAction: action text =>
        log "+++ onInputAction #{action} #{text}"
        switch action
            'up'          
            'down'   ➜ ⮐  @choices.moveSelection action

    onInputChange: text => log "swallow input change #{text}"
        
    moveFocus: -> # called on tab
        
        if @choices.hasFocus()
            @input.grabFocus()
        else
            @choices.grabFocus()
        
    showDialog: dir file ○=>
    
        ○ @gotoDir dir slash.path(dir file)
        
        @input.set file
        @input.state.moveCursors 'eol'
        if valid slash.ext file
            for i in 0..slash.ext(file).length
                @input.state.moveCursors 'left'
        @input.grabFocus()

    doSaveAs: =>
    
        ⮐ if empty @input.current()
        path = slash.path @crumbs.path @input.current()
        post.emit 'file.saveas' path
        @closeDialog()
        
    closeDialog: =>
    
        post.emit 'focus' 'editor'
        @hide()

    onChoicesAction: action choice =>
    
        switch action
            
            'right' 
            'space'            
            'return'
                if choice?.path and choice.type == 'file'
                    @input.set slash.file(choice.path)
                    @input.grabFocus()
                    ⮐ 
                    
        super action choice
        
    onKey: key event =>

        ⮐ if @hidden()

        switch event.combo
            'tab' 
                ⮐ @moveFocus()
            'esc'
                ⮐ @closeDialog()     

        if @input.hasFocus()
            if key == 'down'
                ⮐ @choices.grabFocus()
            if key in 'return'
                ⮐ @doSaveAs()
            if event.char not in '\t\n' 
                if result = @input.onKey key event
                    ⮐ result
            ⮐ 
        else
            if event.char and event.char not in ' \n\t'
                log "event with char swallowed '#{event.char}'"
                ⮐ 
            
        super key event
        
export saveas
