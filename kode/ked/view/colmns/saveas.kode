    the dialog to save the buffer under another name
###

use ../../../kxk ▪ slash post
use              ◆ browse

function saveas extends browse

    @: @screen @name='saveas' ->
        
        @autoHideInput = false
        
        super @screen @name

    inputIsActive: -> true
        
    showDialog: dir file =>
    
        log "saveas.showDialog" dir file
        
        @gotoDir dir slash.path(dir file)

    onChoicesAction: action choice =>
    
        log '--- onChoicesAction' action choice @currentDir
        
        switch action
            
            'right' 
            'space'            
                
                if choice?.path and choice.type == 'file'
                    log "SETSAVENAME" choice.path
                    ⮐  
                    
            'return'
                if choice?.path and choice.type == 'file'
                    log "RETURN" choice
                    ⮐ 
                    
        super action choice
        
export saveas
