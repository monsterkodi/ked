
use ../../../kxk    ▪ post slash nfs
use ../../theme     ◆ color theme icons
use ../../edit/tool ◆ belt
use ../../index     ◆ indexer
use ../menu         ◆ choices 

SYMBOL = 
    clss:          '■'  
    extends:       '□'
    unbound:       '->'
    bound:         '=>'
    async_unbound: '○→'
    async_bound:   '●→' 
        
■funSyntax

    @: @tree ->
    
        @color =
            class:          theme.funtree.class
            async:          theme.funtree.async
            bound:          theme.funtree.bound
            bound_async:    theme.funtree.bound_async
            func:           theme.funtree.func
            func_async:     theme.funtree.func_async
            test0:          theme.funtree.test0
            test1:          theme.funtree.test1
            test2:          theme.funtree.test2
            test3:          theme.funtree.test3
            h1:             theme.syntax['text h1']
            h2:             theme.syntax['text h2']
            h3:             theme.syntax['text h3']
            h4:             theme.syntax['text h4']
            h5:             theme.syntax['text h5']
        
    clear: =>

    setLines: lines => log 'setLines'
    setSegls: segls =>
        
    getClass: x y => ''
    getClasses: y => []
    getColor: x y =>
        
        item = @tree.items[y]
        name = item.name
        char = name[x]
        if char == ' ' ➜ ⮐  [0 0 0]

        if 
            item.divider    ➜ clr = color.darken @color.class 0.4
            item.clss       ➜ clr = @color.class
            item.md         ➜ clr = @color[item.md] 
            item.test       ➜ clr = @color['test' + int(belt.numIndent(item.name)/2)] 
            item.async      ➜ clr = item.bound ? @color.bound_async : @color.func_async
            item.bound      ➜ clr = @color.bound
                            ➜ clr = @color.func
        if 
            item.static     ➜ clr = color.brighten clr 0.2
            char == '@' and empty name[x+1]
                              clr = @color.class
        if 
            char == "#"            ➜ clr = color.darken clr 0.5
            char == '▸'            ➜ clr = color.darken clr 0.5
            char == '@'            ➜ clr = color.darken clr (clr == @color.class ? 0.75 : 0.5)
            char == SYMBOL.clss    ➜ clr = color.darken clr 0.2
            char in SYMBOL.bound   and item.bound ➜ clr = color.darken clr 0.5
            char in SYMBOL.unbound                ➜ clr = color.darken clr 0.7
        
        clr
        
    getChar: x y char => char

■funtree□choices

    @: @editor @name features ->
        
        super @editor.screen @name features
        
        @state.syntax = new funSyntax @
        
        @showBases  = true
        @baseItems  = []
        @dividerItem = null
        
        @editor.state.on 'cursorsSet' @onCursorsSet
        
        post.on 'file.loaded'  @clear
        post.on 'file.indexed' @onFileIndexed
        
    onCursorsSet: =>
    
        @selectItemForLineIndex @editor.state.mainCursor()[1]
        
    localItems: => @items.filter (item) -> not (item.inherited or item.divider)
    
    selectItemForLineIndex: li =>
    
        items = @localItems()
    
        for item,idx in items
            if item.line-1 <= li and (idx >= items.length-1 or items[idx+1].line-1 > li)
                @state.setSelections [belt.rangeOfLine(@state.s.lines idx)]
                @state.setMainCursor 0 idx
                ⮐  
                
    nameOfCurrentFunc:      => @current().name
    lineIndexOfCurrentFunc: => @current().line-1
    lineIndexOfNextFunc:    => 
    
        item = @localItems()[@currentIndex()+1]
        ⮐  if empty item
        item.line-1
        
    lineIndexOfPrevFunc:    => 
    
        item = @localItems()[@currentIndex()-1]
        ⮐  if empty item
        item.line-1
    
    lineIndexForFunc: func => 
    
        for item in @items
            if item.name == func.name and item.class == func.class
                ⮐  item.line-1 
                
        if func.name == "   -> #{func.class}" and func.line
            ⮐  @lineIndexForFunc class:func.class, name:'   -> @'
    
        if func.name == "   -> @" and func.line
            ⮐  @lineIndexForFunc class:func.class, name: "   -> #{func.class}"
                
        # log "can't find func: items:" @items
        log "can't find func:" func
        
    onFileIndexed: path info =>
        
        ⮐  if path != @editor.currentFile
        ⮐  if empty info.classes and empty info.funcs
    
        clssl = clone info.classes
        funcs = clone info.funcs
        # log "funtree.onFileIndexed #{path}" clssl
        
        for clss in clssl
            clss.file ?= path
            clss.name = ' ' + SYMBOL.clss + ' ' + clss.name
            
        for func in funcs
            if func.test
                func.name = ' ' + belt.reindent(4 2 func.name)
            else
                if func.async
                    if func.bound
                        symbol = SYMBOL.async_bound
                    else
                        symbol = SYMBOL.async_unbound
                else
                    if func.bound
                        symbol = SYMBOL.bound
                    else
                        if func.md
                            symbol = "#"
                        else
                            symbol = SYMBOL.unbound
                        
                name = func.name
                name = '@' + name if func.static
                indt = func.class ? '   ' : ' '
                func.name = indt + symbol + ' ' + name
        
        items = clssl.concat funcs
        items.sort (a b) -> a.line - b.line
        
        supr = clssl[-1]
        @baseItems = @itemsForBaseClass supr
        @dividerItem = null
        
        if not empty @baseItems
            @dividerItem = 
                divider: true
                name:    @baseDividerName(@baseItems)
                line:    (supr?.line ? 1)
                
            items.push @dividerItem
            items = items.concat @baseItems if @showBases
        
        @set items 'name'
        post.emit 'funtree.loaded'
        @onCursorsSet()
        post.emit 'redraw'
        
    itemsForBaseClass: supr =>
        
        ⮐ [] if empty supr
        ⮐ [] if empty supr.base
        ⮐ [] if empty indexer.singleton
        
        items = []
        
        for clss in indexer.singleton.baseClassesOf supr.base
            
            items.push
                clss:       true
                name:       ' ' + SYMBOL.clss + ' ' + clss.name
                line:       clss.line
                file:       clss.file
                inherited:  true
                
            funcs = clone indexer.singleton.methodsOfClass clss.name
            
            for func in funcs
                if func.test
                    func.name = ' ' + belt.reindent(4 2 func.name)
                else
                    if func.async
                        if func.bound
                            symbol = SYMBOL.async_bound
                        else
                            symbol = SYMBOL.async_unbound
                    else
                        if func.bound
                            symbol = SYMBOL.bound
                        else
                            if func.md
                                symbol = "#"
                            else
                                symbol = SYMBOL.unbound
                            
                    name = func.name
                    name = '@' + name if func.static
                    indt = func.class ? '   ' : ' '
                    func.name = indt + symbol + ' ' + name
                    
                func.file ?= clss.file
                func.inherited = true
                items.push func
                
        items
        
    baseDividerName: baseItems =>
        
        name = ' ' + SYMBOL.extends
        if not @showBases
            numClasses = baseItems.filter((item) -> item.clss).length
            name += ' ' + numClasses
        name
        
    toggleBases: =>
        
        ⮐  if empty @dividerItem
        
        @showBases = not @showBases
        @dividerItem.name = @baseDividerName @baseItems
        
        items = @localItems()
        items.push @dividerItem
        items = items.concat @baseItems if @showBases
        
        @set items 'name'
        @select items.indexOf(@dividerItem)
        post.emit 'redraw'
        
    jumpTo: choice =>
        
        if choice.inherited and not slash.samePath(choice.file @editor.currentFile)
            post.emit 'file.open' choice.file choice.line-1 'ind' 'topDelta'
        else
            post.emit 'goto.line' choice.line-1 'ind' 'topDelta'
        
    emitAction: action choice event  ->
    
        if empty choice
            error 'funtree.emitAction -- empty choice ▸ action:' action 
            error 'funtree.emitAction -- empty choice ▸ event:' event
            ⮐  
        
        switch action
        
            'space'
            
                if choice.divider
                    @toggleBases()
                else
                    @jumpTo choice
                    @grabFocus()
                ⮐  
        
            'right'
            
                ⮐ if choice.divider
                @selectNext()
                choice = @choiceAtRow @currentIndex()
                ⮐ if choice.divider
                @jumpTo choice
                @grabFocus()
                ⮐  
                
            'left'
            
                @selectPrev()
                choice = @choiceAtRow @currentIndex()
                @jumpTo choice
                @grabFocus()
                ⮐  
                
            'click'
            
                if choice.divider
                    @toggleBases()
                else
                    @jumpTo choice
                    post.emit 'focus' 'editor'
                ⮐  
                
            'return'
            
                if choice.divider
                    @toggleBases()
                else
                    @jumpTo choice
                    post.emit 'focus' 'editor'
                ⮐  
                
            'drag'
            
                ⮐  if choice.divider or choice.inherited
                
                @jumpTo choice
                ⮐  
                 
        super action choice event
        
export funtree
