
use ../../../kxk    ▪ post kseg kutil clip
use ../../theme     ◆ color theme
use ../../edit/tool ◆ belt
use ../base         ◆ view colorslider rgbinput radio
■colorpicker□view
    
    # #3c3cf0 #3ecc12 #8c6900

    @: @screen @editor @name ->

        super @screen @name

        @height = 9

        @colorReplace  = null
        @colorDecorate = null
        @bgChanged     = false
        @voided        = [false false]
        @colorStates   = []

        @hue    = new colorslider screen "#{@name}_hue" 360 (v) => color.hsvToRgb [v 100 100]
        @sat    = new colorslider screen "#{@name}_sat" 100 (v) => color.hsvToRgb [@h() v @v()]
        @val    = new colorslider screen "#{@name}_val" 100 (v) => color.hsvToRgb [@h() @s() v]

        @red    = new rgbinput screen "#{@name}_red"
        @green  = new rgbinput screen "#{@name}_green"
        @blue   = new rgbinput screen "#{@name}_blue"
                
        @radio  = new radio screen "#{@name}_radio"

        @sliders   = [@hue @sat @val]
        @inputs    = [@red @green @blue]
        @focusRing = [@radio @hue @sat @val @red @green @blue]

        @red.textColor   = theme.colorpicker.red
        @green.textColor = theme.colorpicker.green
        @blue.textColor  = theme.colorpicker.blue

        @radio.setColor 'bg' theme.colorpicker.bg
        @radio.setColor 'fg' theme.colorpicker.fg

        @hue.on    'valueChange' @sliderChanged
        @val.on    'valueChange' @sliderChanged
        @sat.on    'valueChange' @sliderChanged

        @red.on    'valueChange' @rgbChanged
        @green.on  'valueChange' @rgbChanged
        @blue.on   'valueChange' @rgbChanged
        
        @radio.on 'activeChange' @onRadioActiveChanged

        @setColor 'bg' theme.colorpicker.bg
        @setColor 'fg' theme.colorpicker.fg

        @isVisible = false

    focusDelta: delta =>
    
        for item,index in @focusRing
            if item.hasFocus()
                num = @focusRing.length
                if 0 <= index+delta < num
                    if @focusRing[index+delta].focusable
                        @focusRing[index+delta].grabFocus()
                        ⮐ true
                ⮐ false
        false
            
    focusNext: => @focusDelta 1
    focusPrev: => @focusDelta -1

    activeIndex: => @radio.active
    
    onRadioActiveChanged: => @syncAll()
    
    backgroundChanged: => @bgChanged

    colorVoided: idx => @voided[idx] ? false

    voidActiveColor: =>

        @voided[@activeIndex()] = true

        @syncRadio()

        post.emit 'redraw'

    rgb: => @colorStates[@activeIndex()]
    hex: => color.hex @rgb()
    hsv: => color.rgbToHsv @rgb()
    h: => @hsv()[0]
    s: => @hsv()[1]
    v: => @hsv()[2]

    colorHex: idx  => color.hex @colorStates[idx]
    foregroundHex: => @colorHex 0
    backgroundHex: => @colorHex 1
    
    swapColors: =>
        if @colorStates.length > 1
            @colorStates.push @colorStates.shift()
            @syncAll()

    syncAll: =>

        @syncRadio()
        @syncSliders()
        @syncInputs()

    syncRadio: =>

        opts = []

        for idx in 0...@colorStates.length
            col = @colorHex idx
            opts.push {color: color.values(col), label: (@voided[0] ? 'none' : col)} if col?

        @radio.setOptions opts
        @radio.setActive @activeIndex()
        @radio.setFocusable opts.length > 1

    syncSliders: =>

        @hue.setValue @h()
        @sat.setValue @s()
        @val.setValue @v()

    syncInputs: =>
        rgb = @rgb()
        for i in 0..2
            @inputs[i].setValue rgb[i]

    setHex: hex idx =>

        ⮐ if empty hex
        rgb = color.values hex
        ⮐ if empty rgb
        idx ?= @activeIndex()
        
        @colorStates[idx] = rgb
        
        @voided[idx] = false
        @bgChanged = true if idx == 1
        true

    setActiveColor: idx =>

        @radio.changeActive clamp(0 1 int(idx))
        
    sliderChanged: =>

        @colorStates[@activeIndex()] = color.hsvToRgb [@hue.getValue() @sat.getValue() @val.getValue()]

        @syncRadio()
        @syncInputs()
        @emitChanged()

    rgbChanged: =>

        @colorStates[@activeIndex()] = [@red.getValue() @green.getValue() @blue.getValue()]

        @syncRadio()
        @syncSliders()
        @emitChanged()
        
    emitChanged: =>

        @voided[@activeIndex()] = false
        @bgChanged = true if @activeIndex() == 1

        post.emit 'colorpicker.change' @hex()
        post.emit 'redraw'

    show: hex =>

        @bgChanged    = false
        @voided       = [false false]
        @colorStates  = []
        @radio.active = 0
        
        if hex?
            @setHex hex
        else
            if found = @hexAtCursor()
                hex = found.text
                @colorReplace = found
                @setHex hex
                @colorReplace.from = @hex()
                
            else if not empty @editor.state.s.selections
                
                @colorDecorate = ranges:clone(@editor.state.s.selections)
                
                @setHex (@colorAtSelection('fg') ? '#ff0000') 0 
                @setHex (@colorAtSelection('bg') ? '#000000') 1 
                
            else if syntax = @editor.syntaxColorAtMainCursor()
                @setHex syntax
                
            else
                @setHex "#ffffff"

        @syncAll()
        super()

        @hue.grabFocus()
        
    colorAtSelection: layer =>

        for rng in @editor.state.s.selections
            if c = @editor.state.colorAtPos [rng[0] rng[1]] layer
                ⮐ c
        null
        
    hexAtCursor: =>

        state = @editor.state
        mc    = state.mainCursor()
        lines = state.s.lines
        [x y] = mc

        ⮐ if y < 0 or y >= lines.length

        line = lines[y]
        ⮐ if empty line

        word = state.wordAtCursor()
        rng  = belt.rangeOfClosestWordToPos lines mc

        if empty word or empty rng
            if x < line.length and kseg.str(line[x...x+1]) == '#'
                word = belt.wordAtPos lines [x+1 y]
                rng  = belt.rangeOfClosestWordToPos lines [x+1 y]

        ⮐ if empty word or empty rng
        ⮐ if empty color.values(word)

        text = word

        if rng[0] > 0 and kseg.str(line[rng[0]-1...rng[0]]) == '#'
            text = '#' + text
            rng  = [rng[0]-1 rng[1] rng[2] rng[3]]

        text: text
        range: rng

    hide: =>

        ⮐ if @hidden()

        super()

        for input in @inputs
            input.state.deselect()

        post.emit 'focus' 'editor'
        post.emit 'redraw'

    submit: =>

        hex = @hex()
        if @colorReplace? and hex != @colorReplace.from
            @replaceColor hex

        else if @colorDecorate?

            ranges = @colorDecorate.ranges

            @colorDecorate = null

            fg = @foregroundHex()
            bg = null

            bg = @backgroundHex() if @backgroundChanged()

            voided = []
            voided.push 'fg' if @colorVoided 0
            voided.push 'bg' if @colorVoided 1

            @editor.state.setColorsForRanges ranges fg bg voided

        @hide()

    replaceColor: hex =>

        ⮐ if empty hex
        ⮐ if empty @colorReplace

        [x1 y x2] = @colorReplace.range

        state = @editor.state
        lines = state.s.lines.asMutable()

        ⮐ if y < 0 or y >= lines.length

        text = hex
        text = text[1..] if @colorReplace.text[0] != '#' and text[0] == '#'

        kutil.replace lines[y] x1 (x2-x1) kseg(text)
        state.setLines lines

        @colorReplace = null

    cancel: =>

        post.emit 'colorpicker.hide'
        @hide()

    onMouse: event =>

        ⮐ if @hidden() or @collapsed()

        ret = @radio.onMouse event     ; ⮐ ret if ret?.redraw

        for slider in @sliders
            ret = slider.onMouse event ; ⮐ ret if ret?.redraw

        for input in @inputs
            ret = input.onMouse event  ; ⮐ ret if ret?.redraw

        super event

    onWheel: event =>

        ⮐ if @hidden() or @collapsed()

        for slider in @sliders
            ret = slider.onWheel event ; ⮐ ret if ret?.redraw

        for input in @inputs
            ret = input.onWheel event  ; ⮐ ret if ret?.redraw

        if @cells.isInsideEvent event
            ⮐ redraw:false

    onKey: key event =>

        ⮐ false if @hidden()
            
        # log "colorpicker.onKey #{key}"
        ⮐ true if @red   .onKey key event
        ⮐ true if @green .onKey key event
        ⮐ true if @blue  .onKey key event

        ⮐ true if @hue   .onKey key event
        ⮐ true if @sat   .onKey key event
        ⮐ true if @val   .onKey key event
        
        ⮐ true if @radio .onKey key event

        switch event.combo
            'down''tab'      ➜ ⮐ @focusNext() 
            'up''shift+tab'  ➜ ⮐ @focusPrev()
            'esc'            ➜ ⮐ @cancel()
            'return'         ➜ ⮐ @submit()
            'delete'         
            'backspace'      ➜ ⮐ @voidActiveColor()
            'cmd+left'       
            'cmd+right'      ➜ ⮐ @swapColors()
            'ctrl+c' 'cmd+c' ➜   clip.copy @hex() ; ⮐ true
            'ctrl+v' 'cmd+v' ➜   @setHex(clip.paste()) ; @syncAll() ; ⮐ true

        false

    layout: x y w h =>

        super x y w h

        @radio.layout  x+1 y+1 w-2 1

        @hue.layout    x+1 y+3 w-2 1
        @sat.layout    x+1 y+4 w-2 1
        @val.layout    x+1 y+5 w-2 1

        aw = max 1 w-2
        iw = 4

        @red.layout   x+1                y+7 iw 1
        @green.layout x+1+int((aw-iw)/2) y+7 iw 1
        @blue.layout  x+1+aw-iw          y+7 iw 1

    draw: =>

        ⮐ if @hidden() or @collapsed()

        @cells.fill_rect 0 0 -1 -1 ' ' null @color.bg

        for child in @focusRing
            child.draw()

        super()

export colorpicker
