    ███       ███   ███  ███      ███   ███  ███   ███  ███   ███  ███  ███       ███  ███   ███       ███   ███
    ███       ███   ███  ███      ███   ███  ███████    ████████   ███  ███       ███████    ███████   ███████  
    ███       ███   ███  ███      ███   ███  ███   ███  ███        ███  ███       ███  ███   ███       ███   ███
     ███████   ███████   ███████   ███████   ███   ███  ███        ███   ███████  ███   ███  ████████  ███   ███
###

use ../../../kxk    ▪ post kseg kutil
use ../../theme     ◆ color theme
use ../../edit/tool ◆ belt
use ../base         ◆ view colorslider rgbinput radio

# #3c3cf0 #ABC #8c5900

function colorpicker extends view

    @: @screen @editor @name ->

        super @screen @name

        @height = 9

        @h = 0
        @s = 100
        @v = 100
        
        @colorReplace  = null
        @colorDecorate = null
        @twoColors     = false
        @activeColor   = 0
        @bgChanged     = false
        @voided        = [false false]
        @colorStates   = [{h: 0 s: 100 v: 100} {h: 0 s: 100 v: 100}]

        @hue    = new colorslider screen "#{@name}_hue"
        @bright = new colorslider screen "#{@name}_bright"
        @sat    = new colorslider screen "#{@name}_sat"

        @red    = new rgbinput screen "#{@name}_red"
        @green  = new rgbinput screen "#{@name}_green"
        @blue   = new rgbinput screen "#{@name}_blue"
                
        @radio  = new radio screen "#{@name}_radio"

        @sliders   = [@hue @bright @sat]
        @inputs    = [@red @green @blue]
        @focusRing = [@radio @hue @bright @sat @red @green @blue]

        @red.textColor   = theme.colorpicker.red
        @green.textColor = theme.colorpicker.green
        @blue.textColor  = theme.colorpicker.blue

        @radio.setColor 'bg' theme.colorpicker.bg
        @radio.setColor 'fg' theme.colorpicker.fg
        @radio.onSelect = (idx) => @setActiveColor idx

        @hue.min = 0
        @hue.max = 360

        @bright.min = 0
        @bright.max = 100

        @sat.min = 0
        @sat.max = 100

        @hue.gradient    = (v) => color.hsvToRgb [v 100 100]
        @bright.gradient = (v) => color.hsvToRgb [@h @s v]
        @sat.gradient    = (v) => color.hsvToRgb [@h v @v]

        @hue.on    'valueChange' @sliderChanged
        @bright.on 'valueChange' @sliderChanged
        @sat.on    'valueChange' @sliderChanged

        @red.on    'valueChange' @rgbChanged
        @green.on  'valueChange' @rgbChanged
        @blue.on   'valueChange' @rgbChanged

        @setColor 'bg' theme.colorpicker.bg
        @setColor 'fg' theme.colorpicker.fg

        @isVisible = false

        @syncAll()

    focusDelta: delta =>
    
        for item,index in @focusRing
            if item.hasFocus()
                num = @focusRing.length
                if 0 <= index+delta < num
                    if @focusRing[index+delta].focusable
                        @focusRing[index+delta].grabFocus()
                        ⮐ true
                ⮐ false
        false
            
    focusNext: => @focusDelta 1
    focusPrev: => @focusDelta -1

    selectionMode: => @twoColors

    backgroundChanged: => @bgChanged

    colorVoided: idx => @voided[idx] ? false

    voidActiveColor: =>

        ⮐ if not @twoColors

        @voided[@activeColor] = true

        @syncRadio()

        post.emit 'redraw'

    rgb: => color.hsvToRgb [@h @s @v]
    hex: => color.hex @rgb()

    colorHex: idx =>

        st = @colorStates[idx]
        ⮐ null if not st?

        color.hex color.hsvToRgb([st.h st.s st.v])

    foregroundHex: => @colorHex 0
    backgroundHex: => if @twoColors then @colorHex 1 else null

    saveColorState: => @colorStates[@activeColor] = {h: @h, s: @s, v: @v}

    syncSliders: =>

        @hue.setValue    @h
        @bright.setValue @v
        @sat.setValue    @s

    syncInputs: =>

        rgb = @rgb()

        for i in 0...3
            @inputs[i].setValue rgb[i]

    syncRadio: =>

        opts = []

        fg = @colorHex 0
        opts.push {color: color.values(fg), label: (@voided[0] ? 'none' : fg)} if fg?

        if @twoColors
            bg = @colorHex 1
            opts.push {color: color.values(bg), label: (@voided[1] ? 'none' : bg)} if bg?

        @radio.setOptions opts
        @radio.setActive @activeColor
        @radio.setFocusable @twoColors

    syncAll: =>

        @syncSliders()
        @syncInputs()
        @syncRadio()

    setColorStateFromHex: (idx hex) =>

        rgb = color.values hex
        ⮐ false if empty rgb

        [h s v] = color.rgbToHsv rgb

        @colorStates[idx] = {h: h, s: s, v: v}

        if idx == @activeColor
            @h = h
            @s = s
            @v = v
            @syncAll()

        true

    setHex: hex =>

        ⮐ if empty hex
        ⮐ if not @setColorStateFromHex @activeColor hex

        @voided[@activeColor] = false

        @bgChanged = true if @activeColor == 1

    loadActiveColor: =>

        st = @colorStates[@activeColor]

        @h = st.h
        @s = st.s
        @v = st.v

        @syncAll()

    setActiveColor: idx =>

        ⮐ if not @twoColors

        @saveColorState()

        @activeColor = clamp 0 1 int(idx)

        @loadActiveColor()

        post.emit 'redraw'
        true

    cycleColor: dir => @setActiveColor (@activeColor + dir + 2) % 2

    syncFromSliders: =>

        @h = @hue.getValue()
        @v = @bright.getValue()
        @s = @sat.getValue()

        @saveColorState()
        @syncInputs()
        @syncRadio()

        @voided[@activeColor] = false
        @bgChanged = true if @activeColor == 1

    syncFromRgb: =>

        rgb = [@red.getValue() @green.getValue() @blue.getValue()]
        [h s v] = color.rgbToHsv rgb

        h = @h if s == 0
        h = @h if v == 0
        s = @s if v == 0

        @h = h
        @s = s
        @v = v

        @saveColorState()
        @syncSliders()
        @syncRadio()

        @voided[@activeColor] = false
        @bgChanged = true if @activeColor == 1

    sliderChanged: =>

        before = @hex()
        @syncFromSliders()
        @emitChanged before

    rgbChanged: =>

        before = @hex()
        @syncFromRgb()
        @emitChanged before

    emitChanged: before =>

        after = @hex()

        ⮐ if after == before

        post.emit 'colorpicker.change' after
        post.emit 'redraw'

    show: hex =>

        @twoColors   = false
        @bgChanged   = false
        @activeColor = 0
        @voided      = [false false]

        @radio.setFocusable false

        if hex?
            @setHex hex
        else
            if found = @colorAtCursor()
                hex = found.text
                @colorReplace = found
                @setHex hex
                @colorReplace.from = @hex()
                
            else if not empty @editor.state.s.selections
                
                @twoColors = true
                @colorDecorate = ranges:clone(@editor.state.s.selections)
                @colorStates = [{h: 0 s: 100 v: 100} {h: 0 s: 100 v: 100}]
                
                fg = @colorAtSelection('fg') ? '#ff0000'
                bg = @colorAtSelection('bg') ? '#000000'

                @setColorStateFromHex 0 fg
                @setColorStateFromHex 1 bg
                
                @loadActiveColor()
                    
                @radio.setFocusable true

        super()

        @hue.grabFocus()
        
    colorAtSelection: layer =>

        color = @editor.state.colorAtPos @editor.state.mainCursor() layer

        ⮐ color if color?

        for rng in @editor.state.s.selections
            if c = @editor.state.colorAtPos [rng[0] rng[1]] layer
                ⮐ c
        null
        
    colorAtCursor: =>

        state = @editor.state
        mc    = state.mainCursor()
        lines = state.s.lines
        [x y] = mc

        ⮐ if y < 0 or y >= lines.length

        line = lines[y]
        ⮐ if empty line

        word = state.wordAtCursor()
        rng  = belt.rangeOfClosestWordToPos lines mc

        if empty word or empty rng
            if x < line.length and kseg.str(line[x...x+1]) == '#'
                word = belt.wordAtPos lines [x+1 y]
                rng  = belt.rangeOfClosestWordToPos lines [x+1 y]

        ⮐ if empty word or empty rng
        ⮐ if empty color.values(word)

        text = word

        if rng[0] > 0 and kseg.str(line[rng[0]-1...rng[0]]) == '#'
            text = '#' + text
            rng  = [rng[0]-1 rng[1] rng[2] rng[3]]

        text: text
        range: rng

    hide: =>

        ⮐ if @hidden()

        super()

        for input in @inputs
            input.state.deselect()

        post.emit 'focus' 'editor'
        post.emit 'redraw'

    submit: =>

        hex = @hex()
        if @colorReplace?
            if hex == @colorReplace.from
                @colorReplace = null
                ⮐
            @replaceColor hex

        else if @colorDecorate?

            ranges = @colorDecorate.ranges

            @colorDecorate = null

            fg = @foregroundHex()
            bg = null

            bg = @backgroundHex() if @backgroundChanged()

            voided = []
            voided.push 'fg' if @colorVoided 0
            voided.push 'bg' if @colorVoided 1

            @editor.state.setColorsForRanges ranges fg bg voided

        # post.emit 'redraw'
        
        @hide()

    replaceColor: hex =>

        ⮐ if empty hex
        ⮐ if empty @colorReplace

        [x1 y x2] = @colorReplace.range

        state = @editor.state
        lines = state.s.lines.asMutable()

        ⮐ if y < 0 or y >= lines.length

        text = hex
        text = text[1..] if @colorReplace.text[0] != '#' and text[0] == '#'

        kutil.replace lines[y] x1 (x2-x1) kseg(text)
        state.setLines lines

        @colorReplace = null

    cancel: =>

        post.emit 'colorpicker.hide'
        @hide()

    onMouse: event =>

        ⮐ if @hidden() or @collapsed()

        ret = @radio.onMouse event     ; ⮐ ret if ret?.redraw

        for slider in @sliders
            ret = slider.onMouse event ; ⮐ ret if ret?.redraw

        for input in @inputs
            ret = input.onMouse event  ; ⮐ ret if ret?.redraw

        super event

    onWheel: event =>

        ⮐ if @hidden() or @collapsed()

        for slider in @sliders
            ret = slider.onWheel event ; ⮐ ret if ret?.redraw

        for input in @inputs
            ret = input.onWheel event  ; ⮐ ret if ret?.redraw

        if @cells.isInsideEvent event
            ⮐ redraw:false

    onKey: key event =>

        ⮐ false if @hidden()

        switch event.combo
            'down''tab'     ➜ ⮐ @focusNext() 
            'up''shift+tab' ➜ ⮐ @focusPrev()
            'esc'           ➜ ⮐ @cancel()
            'return'        ➜ ⮐ @submit()
            
        # log "colorpicker.onKey #{key}"
        ⮐ true if @red  .onKey key event
        ⮐ true if @green.onKey key event
        ⮐ true if @blue .onKey key event

        ⮐ true if @hue   .onKey key event
        ⮐ true if @bright.onKey key event
        ⮐ true if @sat   .onKey key event

        if @radio.hasFocus() and @twoColors

            switch event.combo
                'delete' 
                'backspace' ➜ ⮐ @voidActiveColor()
                'left'      ➜ ⮐ @cycleColor -1
                'right'     ➜ ⮐ @cycleColor  1
                'down'      ➜ ⮐ @hue.grabFocus()
                            ➜ ⮐ false

        false

    layout: x y w h =>

        super x y w h

        @radio.layout  x+1 y+1 w-2 1

        @hue.layout    x+1 y+3 w-2 1
        @bright.layout x+1 y+4 w-2 1
        @sat.layout    x+1 y+5 w-2 1

        aw = max 1 w-2
        iw = 4

        @red.layout   x+1                y+7 iw 1
        @green.layout x+1+int((aw-iw)/2) y+7 iw 1
        @blue.layout  x+1+aw-iw          y+7 iw 1

    draw: =>

        ⮐ if @hidden() or @collapsed()

        @cells.fill_rect 0 0 -1 -1 ' ' null @color.bg

        @radio.draw()

        @hue.draw()
        @bright.draw()
        @sat.draw()

        @red.draw()
        @green.draw()
        @blue.draw()

        super()

export colorpicker
