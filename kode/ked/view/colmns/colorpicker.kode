###
    colorpicker

    a keyboard first color picker
    lives at the bottom of the funcol

    posts
        colorpicker.show    hex
        colorpicker.change  hex
        colorpicker.submit  hex
        colorpicker.hide
###

use ../../../kxk ▪ post
use ../../theme  ◆ color theme
use ../base      ◆ view colorslider rgbinput radio

PICKER_HEIGHT = 9
RADIO_FOCUS   = 6

function colorpicker extends view

    @: screen name ->

        super screen name

        @height     = PICKER_HEIGHT
        @focused    = false
        @focusIndex = 0

        @h = 0
        @s = 100
        @v = 100

        @twoColors   = false
        @activeColor = 0
        @bgChanged   = false
        @voided      = [false false]
        @colorStates = [{h: 0 s: 100 v: 100} {h: 0 s: 100 v: 100}]

        @hue    = new colorslider screen "#{@name}_hue"
        @bright = new colorslider screen "#{@name}_bright"
        @sat    = new colorslider screen "#{@name}_sat"

        @red   = new rgbinput screen "#{@name}_red"
        @green = new rgbinput screen "#{@name}_green"
        @blue  = new rgbinput screen "#{@name}_blue"

        @radio = new radio screen "#{@name}_radio"

        @sliders = [@hue @bright @sat]
        @inputs  = [@red @green @blue]

        @red.textColor   = theme.colorpicker.red
        @green.textColor = theme.colorpicker.green
        @blue.textColor  = theme.colorpicker.blue

        @radio.setColor 'bg' theme.colorpicker.bg
        @radio.setColor 'fg' theme.colorpicker.fg
        @radio.onFocusRequest = => @focusTo RADIO_FOCUS if @twoColors
        @radio.onSelect       = (idx) => @setActiveColor idx

        @childNames = [@name @red.name @green.name @blue.name]

        @hue.min = 0
        @hue.max = 360

        @bright.min = 0
        @bright.max = 100

        @sat.min = 0
        @sat.max = 100

        @hue.gradient    = (v) -> color.hsvToRgb [v 100 100]
        @bright.gradient = (v) => color.hsvToRgb [@h @s v]
        @sat.gradient    = (v) => color.hsvToRgb [@h v @v]

        @hue.onFocusRequest    = => @focusTo 0
        @bright.onFocusRequest = => @focusTo 1
        @sat.onFocusRequest    = => @focusTo 2

        @red.onFocusRequest   = => @focusTo 3
        @green.onFocusRequest = => @focusTo 4
        @blue.onFocusRequest  = => @focusTo 5

        @hue.onInput    = => @sliderChanged()
        @bright.onInput = => @sliderChanged()
        @sat.onInput    = => @sliderChanged()

        @red.onInput   = => @rgbChanged()
        @green.onInput = => @rgbChanged()
        @blue.onInput  = => @rgbChanged()

        @setColor 'bg' theme.colorpicker.bg
        @setColor 'fg' theme.colorpicker.fg

        @isVisible = false

        post.on 'focus' @onFocus

        @syncAll()

    hasFocus: => @focused

    onFocus: name =>

        @focused = name in @childNames

        for input, i in @inputs
            if name == input.name
                @focusIndex = i+3

        for slider, j in @sliders
            slider.focused = @focused and j == @focusIndex

        @radio.setFocused @focused and @focusIndex == RADIO_FOCUS and @twoColors

        post.emit 'redraw' if @focused

    selectionMode: => @twoColors

    backgroundChanged: => @bgChanged

    colorVoided: idx => @voided[idx] ? false

    voidActiveColor: =>

        ⮐  if not @twoColors

        @voided[@activeColor] = true

        @syncRadio()

        post.emit 'redraw'

    maxFocus: => @twoColors ? RADIO_FOCUS : 5

    rgb: => color.hsvToRgb [@h @s @v]

    hex: => color.hex @rgb()

    colorHex: idx =>

        st = @colorStates[idx]
        ⮐  null if not st?

        color.hex color.hsvToRgb([st.h st.s st.v])

    foregroundHex: => @colorHex 0

    backgroundHex: => if @twoColors then @colorHex 1 else null

    saveColorState: => @colorStates[@activeColor] = {h: @h, s: @s, v: @v}

    syncSliders: =>

        @hue.setValue    @h
        @bright.setValue @v
        @sat.setValue    @s

    syncInputs: =>

        rgb = @rgb()

        for i in 0...3
            @inputs[i].setValue rgb[i]

    syncRadio: =>

        opts = []

        fg = @colorHex 0
        opts.push {color: color.values(fg), label: (@voided[0] ? 'none' : fg)} if fg?

        if @twoColors
            bg = @colorHex 1
            opts.push {color: color.values(bg), label: (@voided[1] ? 'none' : bg)} if bg?

        @radio.setOptions opts
        @radio.setActive @activeColor
        @radio.setFocusable @twoColors
        @radio.setFocused @focused and @focusIndex == RADIO_FOCUS and @twoColors

    syncAll: =>

        @syncSliders()
        @syncInputs()
        @syncRadio()

    setColorStateFromHex: (idx hex) =>

        rgb = color.values hex
        ⮐  false if empty rgb

        [h s v] = color.rgbToHsv rgb

        @colorStates[idx] = {h: h, s: s, v: v}

        if idx == @activeColor
            @h = h
            @s = s
            @v = v
            @syncAll()

        true

    setHex: hex =>

        ⮐  if empty hex
        ⮐  if not @setColorStateFromHex @activeColor hex

        @voided[@activeColor] = false

        @bgChanged = true if @activeColor == 1

    loadActiveColor: =>

        st = @colorStates[@activeColor]

        @h = st.h
        @s = st.s
        @v = st.v

        @syncAll()

    setActiveColor: idx =>

        ⮐  if not @twoColors

        @saveColorState()

        @activeColor = clamp 0 1 int(idx)

        @loadActiveColor()

        post.emit 'redraw'

    cycleColor: dir => @setActiveColor (@activeColor + dir + 2) % 2

    syncFromSliders: =>

        @h = @hue.getValue()
        @v = @bright.getValue()
        @s = @sat.getValue()

        @saveColorState()
        @syncInputs()
        @syncRadio()

        @voided[@activeColor] = false
        @bgChanged = true if @activeColor == 1

    syncFromRgb: =>

        rgb = [@red.getValue() @green.getValue() @blue.getValue()]
        [h s v] = color.rgbToHsv rgb

        h = @h if s == 0
        h = @h if v == 0
        s = @s if v == 0

        @h = h
        @s = s
        @v = v

        @saveColorState()
        @syncSliders()
        @syncRadio()

        @voided[@activeColor] = false
        @bgChanged = true if @activeColor == 1

    sliderChanged: =>

        before = @hex()
        @syncFromSliders()
        @emitChanged before

    rgbChanged: =>

        before = @hex()
        @syncFromRgb()
        @emitChanged before

    emitChanged: before =>

        after = @hex()

        ⮐  if after == before

        post.emit 'colorpicker.change' after
        post.emit 'redraw'

    focusTo: i =>

        @focusIndex = clamp 0 @maxFocus() int(i)

        for input, j in @inputs
            if j+3 != @focusIndex
                input.state.deselect()

        if @focusIndex < 3
            post.emit 'focus' @name
        else if @focusIndex < RADIO_FOCUS
            input = @inputs[@focusIndex-3]
            input.grabFocus()
            input.selectAll()
        else
            post.emit 'focus' @name

        post.emit 'redraw'

    focusNext: dir =>

        n = @maxFocus()+1

        @focusTo (@focusIndex + dir + n) % n

    focusUp: =>

        if @focusIndex == 0
            @focusTo RADIO_FOCUS if @twoColors
            ⮐

        switch @focusIndex
            1 ➜ @focusTo 0
            2 ➜ @focusTo 1
            3 ➜ @focusTo 2
            4 ➜ @focusTo 2
            5 ➜ @focusTo 2
            6 ➜ @focusTo 5

    show: hex =>

        @twoColors   = false
        @bgChanged   = false
        @activeColor = 0
        @voided      = [false false]

        if hex?
            @setHex hex
        else
            @loadActiveColor()

        @radio.setFocusable false

        super()

        @focusTo 0

    showSelection: (fg bg) =>

        @twoColors   = true
        @bgChanged   = false
        @activeColor = 0
        @voided      = [false false]
        @colorStates = [{h: 0 s: 100 v: 100} {h: 0 s: 100 v: 100}]

        fg ?= '#ff0000'
        bg ?= '#000000'

        @setColorStateFromHex 0 fg
        @setColorStateFromHex 1 bg
        @loadActiveColor()

        @radio.setFocusable true

        @isVisible = true

        @focusTo 0

    hide: =>

        ⮐  if @hidden()

        super()

        @focused    = false
        @focusIndex = 0

        @radio.setFocused false
        @radio.setFocusable false

        for input in @inputs
            input.state.deselect()

        post.emit 'focus' 'editor'
        post.emit 'redraw'

    submit: =>

        post.emit 'colorpicker.submit' @hex()
        @hide()

    cancel: =>

        post.emit 'colorpicker.hide'
        @hide()

    onMouse: event =>

        ⮐  if @hidden() or @collapsed()

        ret = @radio.onMouse event
        ⮐  ret if ret?.redraw

        for slider in @sliders
            ret = slider.onMouse event
            ⮐  ret if ret?.redraw

        for input in @inputs
            ret = input.onMouse event
            ⮐  ret if ret?.redraw

        super event

    onWheel: event =>

        ⮐  if @hidden() or @collapsed()

        for slider in @sliders
            ret = slider.onWheel event
            ⮐  ret if ret?.redraw

        for input in @inputs
            ret = input.onWheel event
            ⮐  ret if ret?.redraw

        if @cells.isInsideEvent event
            ⮐  redraw:false

    onKey: key event =>

        ⮐  false if @hidden() or not @focused

        switch event.combo
            'tab'       ➜ @focusNext  1; ⮐  true
            'shift+tab' ➜ @focusNext -1; ⮐  true
            'down'      ➜ @focusNext  1; ⮐  true
            'esc'       ➜ @cancel();      ⮐  true
            'return'    ➜ @submit();      ⮐  true

        if (@focusIndex < 3 or @focusIndex == RADIO_FOCUS) and @twoColors and event.combo in ['delete' 'backspace']
            @voidActiveColor()
            ⮐  true

        if @focusIndex == RADIO_FOCUS and @twoColors

            switch event.combo
                'left'  ➜ @cycleColor -1; ⮐  true
                'right' ➜ @cycleColor  1; ⮐  true
                'up'    ➜ @focusUp();     ⮐  true
                else    ➜ ⮐  false

        before = @hex()

        if @focusIndex < 3

            slider = @sliders[@focusIndex]

            switch event.combo
                'left'        ➜ slider.setValue slider.value - 1
                'right'       ➜ slider.setValue slider.value + 1
                'shift+left'  ➜ slider.setValue slider.value - 10
                'shift+right' ➜ slider.setValue slider.value + 10
                'cmd+left'  'ctrl+left'  ➜ slider.setValue slider.min
                'cmd+right' 'ctrl+right' ➜ slider.setValue slider.max
                'up'          ➜ @focusUp();   ⮐  true
                else          ➜ ⮐  false

            @syncFromSliders()
            @emitChanged before

            ⮐  true

        input = @inputs[@focusIndex-3]

        switch event.combo
            'up' ➜ @focusTo 2; ⮐  true

        handled = input.onKey key event

        if handled
            @syncFromRgb()
            @emitChanged before

        handled

    layout: x y w h =>

        super x y w h

        @radio.layout  x+1 y+1 w-2 1

        @hue.layout    x+1 y+3 w-2 1
        @bright.layout x+1 y+4 w-2 1
        @sat.layout    x+1 y+5 w-2 1

        aw = max 1 w-2
        iw = max(3, min(5, int(aw/3)))
        gap = max 0 int((aw - 3*iw)/2)
        start = max 0 int((aw - (3*iw + 2*gap))/2)

        @red.layout   x+1+start            y+7 iw 1
        @green.layout x+1+start+iw+gap     y+7 iw 1
        @blue.layout  x+1+start+2*(iw+gap) y+7 iw 1

    draw: =>

        ⮐  if @hidden() or @collapsed()

        @cells.fill_rect 0 0 -1 -1 ' ' null @color.bg

        @radio.draw()

        @hue.draw()
        @bright.draw()
        @sat.draw()

        @red.draw()
        @green.draw()
        @blue.draw()

        super()

export colorpicker
