
use ../../../kxk    ▪ post kseg kutil clip
use ../../theme     ◆ color theme
use ../../edit      ◆ susan
use ../../edit/tool ◆ belt
use ../../popo      ◆ layout
use ../base         ◆ view colorslider rgbinput radio palette
■colorpicker□view
    
    # #3c3cf0 #3ecc12 #8c6900

    @: @screen @editor @name ->

        super @screen @name

        @height = 9

        @colorReplace  = null
        @colorDecorate = null
        @sheetNode     = null
        @sheetEdit     = false
        @bgChanged     = false
        @voided        = [false false]
        @colorStates   = []

        @palette    = []
        @paletteMax = 8

        @hue    = new colorslider @screen "#{@name}_hue" 360 (v) => color.hsvToRgb [v 100 100]
        @sat    = new colorslider @screen "#{@name}_sat" 100 (v) => color.hsvToRgb [@h() v @v()]
        @val    = new colorslider @screen "#{@name}_val" 100 (v) => color.hsvToRgb [@h() @s() v]

        @red    = new rgbinput @screen "#{@name}_red"
        @green  = new rgbinput @screen "#{@name}_green"
        @blue   = new rgbinput @screen "#{@name}_blue"
                
        @radio  = new radio @screen "#{@name}_radio"

        @paletteView = new palette @screen "#{@name}_palette"

        @sliders    = [@hue @sat @val]
        @inputs     = [@red @green @blue]
        @focusRing  = [@radio @hue @sat @val @red @green @blue]
        @mouseItems = [@radio @paletteView].concat(@sliders).concat(@inputs)
        @wheelItems = @sliders.concat @inputs

        @red.textColor   = theme.colorpicker.red
        @green.textColor = theme.colorpicker.green
        @blue.textColor  = theme.colorpicker.blue

        @radio.setColor 'bg' theme.colorpicker.bg
        @radio.setColor 'fg' theme.colorpicker.fg

        @hue.on    'valueChange' @sliderChanged
        @val.on    'valueChange' @sliderChanged
        @sat.on    'valueChange' @sliderChanged

        @red.on    'valueChange' @rgbChanged
        @green.on  'valueChange' @rgbChanged
        @blue.on   'valueChange' @rgbChanged
        
        @radio.on 'activeChange' @onRadioActiveChanged

        @setColor 'bg' theme.colorpicker.bg
        @setColor 'fg' theme.colorpicker.fg

        @isVisible = false

    activeIndex: => @radio.active
    
    onRadioActiveChanged: => @syncAll()
    
    backgroundChanged: => @bgChanged

    colorVoided: idx => @voided[idx] ? false

    voidActiveColor: =>

        @voided[@activeIndex()] = true

        @syncRadio()
        @updateSheet()

        post.emit 'redraw'

    paletteFocused: => @paletteView.hasFocus()

    pickerHeight: => @height + (@palette.length ? 2 : 0)

    syncPalette: =>

        @paletteView.setColors @palette

        @paletteView.setFocusable @palette.length > 0

        @focusRing = [@radio @hue @sat @val] 
        @focusRing.push @paletteView if @palette.length
        @focusRing = @focusRing.concat [@red @green @blue]

    addCurrentColor: =>

        hex = @hex()
        ⮐ if empty hex
        ⮐ if @palette.includes hex

        @palette.push hex

        @palette.shift() if @palette.length > @paletteMax

        @syncPalette()

        post.emit 'redraw'

        true

    removePaletteColor: =>

        idx = @paletteView.active
        ⮐ if idx < 0 or idx >= @palette.length

        @palette.splice idx 1

        @syncPalette()

        @paletteView.setActive clamp(0 @palette.length-1 idx) if @palette.length

        @blue.grabFocus() if empty @palette

        post.emit 'redraw'

        true

    applyPaletteColor: =>

        opt = @paletteView.options[@paletteView.active]
        ⮐ if empty opt

        @setHex opt.label

        @syncAll()
        @updateSheet()

        post.emit 'colorpicker.change' @hex()
        post.emit 'redraw'

        true

    rgb: => @colorStates[@activeIndex()]
    hex: => color.hex @rgb()
    hsv: => color.rgbToHsv @rgb()
    h: => @hsv()[0]
    s: => @hsv()[1]
    v: => @hsv()[2]

    colorHex: idx  => color.hex @colorStates[idx]
    foregroundHex: => @colorHex 0
    backgroundHex: => @colorHex 1
    
    swapColors: =>
        if @colorStates.length > 1
            @colorStates.push @colorStates.shift()
            @syncAll()

    syncAll: =>

        @syncRadio()
        @syncSliders()
        @syncInputs()

    syncRadio: =>

        opts = []

        for idx in 0...@colorStates.length
            col = @colorHex idx
            opts.push {color: color.values(col), label: (@voided[idx] ? 'none' : col)} if col?

        @radio.setOptions opts
        @radio.setActive @activeIndex()
        @radio.setFocusable opts.length > 1

    syncSliders: =>

        @hue.setValue @h()
        @sat.setValue @s()
        @val.setValue @v()

    syncInputs: =>
        rgb = @rgb()
        for i in 0..2
            @inputs[i].setValue rgb[i]

    setHex: hex idx =>

        hex ?= "#000"
        rgb = color.values hex
        ⮐ if empty rgb
        idx ?= @activeIndex()
        
        @colorStates[idx] = rgb
        
        @voided[idx] = false
        @bgChanged = true if idx == 1
        true

    setActiveColor: idx =>

        @radio.changeActive clamp(0 1 int(idx))
        
    sliderChanged: =>

        @colorStates[@activeIndex()] = color.hsvToRgb [@hue.getValue() @sat.getValue() @val.getValue()]

        @syncRadio()
        @syncInputs()
        @emitChanged()

    rgbChanged: =>

        @colorStates[@activeIndex()] = [@red.int() @green.int() @blue.int()]

        @syncRadio()
        @syncSliders()
        @emitChanged()
        
    emitChanged: =>

        @voided[@activeIndex()] = false
        @bgChanged = true if @activeIndex() == 1

        @updateSheet()

        post.emit 'colorpicker.change' @hex()
        post.emit 'redraw'

    updateSheet: =>

        # write the picked colors into the sheet node and render it in the editor

        ⮐ if not @sheetNode?

        if not @sheetEdit
            @editor.state.begin()
            @sheetEdit = true

        for [idx channel] in [[0 'fg'] [1 'bg']]
            if @colorVoided idx
                delete @sheetNode[channel]
            else if hex = @colorHex idx
                @sheetNode[channel] = hex

        @renderSheet()

    renderSheet: =>

        state = @editor.state
        ⮐ if not state.rectree?

        cells = {cols:(state.rectreeCols ? @editor.cells.cols) rows:(state.rectreeRows ? @editor.cells.rows)}

        state.renderSheet state.rectree cells state.mainCursor() silent:true

    show: hexl opt={focus:true} =>

        @bgChanged    = false
        @voided       = [false false]
        @colorStates  = []
        @sheetNode    = opt.node ? null
        @radio.active = opt.select ? 0
        
        if valid hexl
            if @sheetNode?
                @setSheetColors hexl
            else
                for hex,idx in hexl
                    @setHex hex idx
        else
            if found = @hexAtCursor()
                if found.node?
                    @sheetNode = found.node
                    @setSheetColors found.colors
                else
                    hex = found.text
                    @colorReplace = found
                    @setHex hex
                    @colorReplace.from = @hex()
                
            else if not empty @editor.state.s.selections
                
                @colorDecorate = ranges:clone(@editor.state.s.selections)
                
                @setHex (@colorAtSelection('fg') ? '#ff0000') 0 
                @setHex (@colorAtSelection('bg') ? '#000000') 1 
                
            else if syntax = @editor.syntaxColorAtMainCursor()
                @setHex syntax
                # log @editor.syntaxClassAtMainCursor()
            else
                @setHex "#ffffff"

        @syncAll()
        @syncPalette()
        
        super()
        
        if opt.focus ➜ @hue.grabFocus()

    setSheetColors: hexl =>

        # a missing sheet channel is voided, but seeded so the sliders stay usable

        for hex,idx in hexl
            if empty hex
                @voided[idx] = true
                @setHex (idx == 0 ? '#ffffff' : '#000000') idx
                @voided[idx] = true
            else
                @setHex hex idx

        @radio.active = 1 if @colorVoided 0 and not @colorVoided 1

    colorAtSelection: layer =>

        if c = @sueColorAtSelection layer
            ⮐ c

        for rng in @editor.state.s.selections
            if c = @editor.state.colorAtPos [rng[0] rng[1]] layer
                ⮐ c
        null

    sueColorAtSelection: layer =>

        fg = layer == 'fg'

        for rng in @editor.state.s.selections
            if area = @editor.state.sueAt [rng[0] rng[1]]
                [code] = area.value
                if code == susan.FG_BG_COLOR
                    ⮐ area.value[fg ? 3 : 4]
                if fg and code == susan.FG_COLOR
                    ⮐ area.value[3]
                if not fg and code == susan.BG_COLOR
                    ⮐ area.value[3]

        null
        
    sheetNodeAtCursor: =>

        state = @editor.state
        ⮐ if not state.rectree?

        layout.nodeForPos @editor.cells state.rectree state.mainCursor()

    hexAtCursor: =>

        state = @editor.state

        if state.rectree? and empty state.s.selections
            if node = @sheetNodeAtCursor()
                ⮐ {node:node colors:[node.fg node.bg]}

        mc    = state.mainCursor()
        lines = state.s.lines
        [x y] = mc

        ⮐ if y < 0 or y >= lines.length

        line = lines[y]
        ⮐ if empty line

        word = state.wordAtCursor()
        rng  = belt.rangeOfClosestWordToPos lines mc

        if empty word or empty rng
            if x < line.length and kseg.str(line[x...x+1]) == '#'
                word = belt.wordAtPos lines [x+1 y]
                rng  = belt.rangeOfClosestWordToPos lines [x+1 y]

        ⮐ if empty word or empty rng
        ⮐ if empty color.values(word)

        text = word

        if rng[0] > 0 and kseg.str(line[rng[0]-1...rng[0]]) == '#'
            text = '#' + text
            rng  = [rng[0]-1 rng[1] rng[2] rng[3]]

        text: text
        range: rng

    hide: =>

        ⮐ if @hidden()

        if @sheetEdit
            @editor.state.end()
            @sheetEdit = false

        super()

        for input in @inputs
            input.state.deselect()

        post.emit 'focus' 'editor'
        post.emit 'redraw'

    submit: =>

        if @sheetNode?
            @updateSheet()
        else
            hex = @hex()
            if @colorReplace? and hex != @colorReplace.from
                @replaceColor hex

            else if @colorDecorate?

                ranges = @colorDecorate.ranges

                @colorDecorate = null

                fg = @foregroundHex()
                bg = null

                bg = @backgroundHex() if @backgroundChanged()

                voided = []
                voided.push 'fg' if @colorVoided 0
                voided.push 'bg' if @colorVoided 1

                @submitSue ranges fg bg voided

        @hide()

    submitSue: (ranges fg bg voided) =>

        ranges = belt.splitLineRanges(@editor.state.s.lines ranges false)

        if not empty voided
            @editor.state.clearSueForRanges ranges

        if 'fg' in voided
            fg = null
            bg ?= @backgroundHex()

        if 'bg' in voided
            bg = null
            fg ?= @foregroundHex()

        for rng in ranges

            w = rng[2] - rng[0]
            h = rng[3] - rng[1] + 1

            value = null

            if fg? and bg?
                value = [susan.FG_BG_COLOR w h fg bg]
            else if fg?
                value = [susan.FG_COLOR w h fg]
            else if bg?
                value = [susan.BG_COLOR w h bg]

            @editor.state.setSue rng[0] rng[1] value if value?

    replaceColor: hex =>

        ⮐ if empty hex
        ⮐ if empty @colorReplace

        [x1 y x2] = @colorReplace.range

        state = @editor.state
        lines = state.s.lines.asMutable()

        ⮐ if y < 0 or y >= lines.length

        text = hex
        text = text[1..] if @colorReplace.text[0] != '#' and text[0] == '#'

        kutil.replace lines[y] x1 (x2-x1) kseg(text)
        state.setLines lines

        @colorReplace = null

    cancel: =>

        post.emit 'colorpicker.hide'
        @hide()

    onKey: key event =>

        ⮐ false if @hidden() or @collapsed()
        ⮐ false if not @hasFocus()
            
        switch event.combo
            'down''tab'      ➜ ⮐ @focusNext() 
            'up''shift+tab'  ➜ ⮐ @focusPrev()
            'esc'            ➜ ⮐ @cancel()
            'return'         ➜ ⮐ @onReturn()
            'cmd+delete'     
            'cmd+backspace'  ➜ ⮐ @onDelete()
            'cmd+left'       
            'cmd+right'      ➜ ⮐ @swapColors()
            'ctrl+c' 'cmd+c' ➜   clip.copy @hex() ; ⮐ true
            'ctrl+v' 'cmd+v' ➜   @setHex(clip.paste()) ; @syncAll() ; ⮐ true
            'ctrl+s' 'cmd+s' ➜ ⮐ @addCurrentColor()
        
        super key event

    onReturn: =>

        ⮐ @applyPaletteColor() if @paletteFocused()

        @submit()

    onDelete: =>

        ⮐ @removePaletteColor() if @paletteFocused()

        @voidActiveColor()

    layout: x y w h =>

        super x y w h

        @radio.layout  x+1 y+1 w-2 1

        @hue.layout    x+1 y+3 w-2 1
        @sat.layout    x+1 y+4 w-2 1
        @val.layout    x+1 y+5 w-2 1

        aw = max 1 w-2
        iw = 4

        if @palette.length > 0
            @paletteView.layout x+1 y+7 w-2 1
            p = 2
        else
            @paletteView.layout x y 0 0
            p = 0

        @red.layout   x+1                y+7+p iw 1
        @green.layout x+1+int((aw-iw)/2) y+7+p iw 1
        @blue.layout  x+1+aw-iw          y+7+p iw 1

    draw: =>

        ⮐ if @hidden() or @collapsed()

        @syncPalette()

        @cells.fill_rect 0 0 -1 -1 ' ' null @color.bg

        if @cells.cols >= 11
            for child in @focusRing
                child.draw()

        super()

        @cells.set -1 0 's' @color.fg @color.bg

export colorpicker
