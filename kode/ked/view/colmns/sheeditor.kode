
use ../../../kxk ◆ post
use ../base      ◆ view
use              ◆ sheetree sheenode
■sheeditor□view

    @: @screen @editor @name ->
        
        super @screen @name
        
        @isVisible = false
        
        @sheetree = new sheetree @editor "#{@name}_sheetree" ['scrllr']
        @sheenode = new sheenode @editor "#{@name}_sheenode" 
        
        @mouseItems = [@sheetree @sheenode]
        @wheelItems = @mouseItems
        
        @sheetree.on 'tree.node' @sheenode.onNode
        @sheenode.on 'shee.node' @sheetree.onNode
        
        post.on 'file.loaded' @onFileLoaded
                
    onFileLoaded: path =>
    
        if @editor.state.rectree?
            @sheetree.reloadTree()
            @show()
        else
            @hide()
            
    hide: =>
        
        @sheetree.hide()
        @sheenode.hide()
        super()

    show: =>
        
        @sheetree.show()
        @sheenode.show()
        super()
        
    layout: x y w h ->
        
        ⮐ if @hidden()
        
        snh = @sheenode.height
        sth = h-snh
        
        @sheetree.layout x y     w sth
        @sheenode.layout x y+sth w snh
        
        super x y w h

    draw: ->
        
        ⮐ if @hidden() or @collapsed()
        
        @sheetree.draw()
        @sheenode.draw()
    
        super()
        
    hasFocus:  => @sheetree.hasFocus() or @sheenode.hasFocus()
    grabFocus: => 
        
        ⮐ if @hidden() or @collapsed()
        @sheetree.grabFocus()
                    
    moveFocus: =>
        
        if @sheetree.hasFocus()
            @sheenode.grabFocus()
            post.emit 'redraw'
        else
            @sheetree.grabFocus()
            
        true
        
    onKey: key event =>

        ⮐ if @hidden() or @collapsed()

        combo = event.combo

        switch combo
            'tab' 'shift+tab'                 ➜ ⮐ @moveFocus()
            'ctrl+alt+delete' 'ctrl+alt+entf' ➜ ⮐ @sheetree.deleteCurrent()

        if @sheetree.hasFocus()

            switch combo
                'cmd+z' 'ctrl+z'                ➜ @sheetree.keepSelection(=> @editor.state.undo()) ; @editor.redraw() ; ⮐ true
                'shift+cmd+z' 'cmd+y' 'ctrl+y'  ➜ @sheetree.keepSelection(=> @editor.state.redo()) ; @editor.redraw() ; ⮐ true
                'alt+up'                        ➜ ⮐ @sheetree.moveCurrent 'up'
                'alt+down'                      ➜ ⮐ @sheetree.moveCurrent 'down'
                'cmd+x' 'ctrl+x'                ➜ ⮐ @sheetree.cutCurrent()
                'cmd+c' 'ctrl+c'                ➜ ⮐ @sheetree.copyCurrent()
                'cmd+v' 'ctrl+v'                ➜ ⮐ @sheetree.pasteNode()

            ⮐ @sheetree.onKey key event
        if @sheenode.hasFocus() ➜ ⮐ @sheenode.onKey key event
            
export sheeditor