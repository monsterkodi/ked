###
████████  ███   ███  ███   ███   ███████   ███████   ███    
███       ███   ███  ████  ███  ███       ███   ███  ███    
██████    ███   ███  ███ █ ███  ███       ███   ███  ███    
███       ███   ███  ███  ████  ███       ███   ███  ███    
███        ███████   ███   ███   ███████   ███████   ███████
###

use ../../../kxk ▪ post slash kseg kutil
use ../../theme  ◆ color theme
use ../../edit/tool ◆ belt
use ../base      ◆ view knob
use              ◆ funtree colorpicker

function funcol extends view

    @: screen @editor features ->
        
        super screen 'funcol' features
        
        @isVisible = false
        @active    = false
        @colorReplace  = null
        @colorDecorate = null
        
        @pointerType = 'pointer'
        
        @knob    = new knob    screen  "#{@name}_knob"
        @funtree = new funtree @editor "#{@name}_funtree" ['scrllr']       
        @colorpicker = new colorpicker screen "#{@name}_colorpicker"
        
        @knob.frameSide = 'left'
        
        @funtree.setColor 'bg'            theme.funtree.bg
        @funtree.setColor 'empty'         @funtree.color.bg
        @funtree.setColor 'cursor_main'   @funtree.color.bg
        @funtree.setColor 'cursor_empty'  @funtree.color.bg
        @funtree.scroll.setColor 'bg'     @funtree.color.bg
        
        @knob   .setColor 'bg'            @funtree.color.bg
        
        post.on 'funcol.resize' @onFuncolResize
        post.on 'funcol.toggle' @onFuncolToggle
        post.on 'session.merge' @onSessionMerge
        post.on 'funcol.focus'  => @funtree.grabFocus()
        post.on 'colorpicker.show' @onColorPickerShow
        post.on 'colorpicker.submit' @onColorPickerSubmit
        
    onSessionMerge: recent =>
    
        ⮐  if empty recent.funcol
        
        if recent.funcol.active
            @active = true
            @show()
            
        ked_session.set 'funcol' recent.funcol

    onColorPickerShow: hex =>

        @active = true
        @show() if @hidden()

        @colorReplace  = null
        @colorDecorate = null

        if empty hex

            if found = @colorAtCursor()
                hex = found.text
                @colorReplace = found
            else if not empty @editor.state.s.selections

                @colorDecorate =
                    ranges: clone @editor.state.s.selections

                @colorpicker.showSelection @colorForSelection('fg') @colorForSelection('bg')

                ked_session.set 'funcol▸active' @active
                post.emit 'redraw'
                ⮐

        @colorpicker.show hex

        @colorReplace.from = @colorpicker.hex() if @colorReplace?

        ked_session.set 'funcol▸active' @active
        post.emit 'redraw'

    onColorPickerSubmit: hex =>

        if @colorReplace?
            if hex == @colorReplace.from
                @colorReplace = null
                ⮐
            @replaceColor hex

        else if @colorDecorate?

            ranges = @colorDecorate.ranges

            @colorDecorate = null

            fg = @colorpicker.foregroundHex()
            bg = null

            bg = @colorpicker.backgroundHex() if @colorpicker.backgroundChanged()

            voided = []
            voided.push 'fg' if @colorpicker.colorVoided 0
            voided.push 'bg' if @colorpicker.colorVoided 1

            @editor.state.setColorsForRanges ranges fg bg voided

            post.emit 'redraw'

    colorForSelection: layer =>

        color = @editor.state.colorAtPos @editor.state.mainCursor() layer

        ⮐  color if color?

        for rng in @editor.state.s.selections
            if c = @editor.state.colorAtPos [rng[0] rng[1]] layer
                ⮐  c

        null

    colorAtCursor: =>

        state = @editor.state
        mc    = state.mainCursor()
        lines = state.s.lines
        [x y] = mc

        ⮐  if y < 0 or y >= lines.length

        line = lines[y]
        ⮐  if empty line

        word = state.wordAtCursor()
        rng  = belt.rangeOfClosestWordToPos lines mc

        if empty word or empty rng
            if x < line.length and kseg.str(line[x...x+1]) == '#'
                word = belt.wordAtPos lines [x+1 y]
                rng  = belt.rangeOfClosestWordToPos lines [x+1 y]

        ⮐  if empty word or empty rng
        ⮐  if empty color.values(word)

        text = word

        if rng[0] > 0 and kseg.str(line[rng[0]-1...rng[0]]) == '#'
            text = '#' + text
            rng  = [rng[0]-1 rng[1] rng[2] rng[3]]

        text: text
        range: rng

    replaceColor: hex =>

        ⮐  if empty hex
        ⮐  if empty @colorReplace

        [x1 y x2] = @colorReplace.range

        state = @editor.state
        lines = state.s.lines.asMutable()

        ⮐  if y < 0 or y >= lines.length

        text = hex
        text = text[1..] if @colorReplace.text[0] != '#' and text[0] == '#'

        kutil.replace lines[y] x1 (x2-x1) kseg(text)
        state.setLines lines

        @colorReplace = null
        
    # ███       ███████   ███   ███   ███████   ███   ███  █████████
    # ███      ███   ███   ███ ███   ███   ███  ███   ███     ███   
    # ███      █████████    █████    ███   ███  ███   ███     ███   
    # ███      ███   ███     ███     ███   ███  ███   ███     ███   
    # ███████  ███   ███     ███      ███████    ███████      ███   

    layout: x y w h ->
        
        ph = @colorpicker.visible() ? min(@colorpicker.height h-1) : 0
        ph = 0 if ph < 1

        @funtree.layout x y w h-ph
        @colorpicker.layout x y+h-ph w ph if ph
        @knob.layout    x y 1 h
                
        super x y w h
        
    # ███████    ████████    ███████   ███   ███
    # ███   ███  ███   ███  ███   ███  ███ █ ███
    # ███   ███  ███████    █████████  █████████
    # ███   ███  ███   ███  ███   ███  ███   ███
    # ███████    ███   ███  ███   ███  ██     ██

    draw: ->
        
        ⮐  if @hidden() or @collapsed() or not @active
        
        @cells.fill_rect 0 1 -1 -1 ' ' null theme.funtree.bg
        @cells.fill_rect 0 0 -1  0 ' ' null theme.gutter.bg
        
        @funtree.draw()
        @colorpicker.draw() if @colorpicker.visible()
        @knob.draw()
    
        super()
        
    #  ███████   ███████   ███   ███  █████████  ████████  ███   ███  █████████
    # ███       ███   ███  ████  ███     ███     ███        ███ ███      ███   
    # ███       ███   ███  ███ █ ███     ███     ███████     █████       ███   
    # ███       ███   ███  ███  ████     ███     ███        ███ ███      ███   
    #  ███████   ███████   ███   ███     ███     ████████  ███   ███     ███   

    onContext: event =>
    
        ⮐  if not @hover
    
        log "funcol.onContext: #{@hover}" event
        
    # █████████   ███████    ███████    ███████   ███      ████████
    #    ███     ███   ███  ███        ███        ███      ███     
    #    ███     ███   ███  ███  ████  ███  ████  ███      ███████ 
    #    ███     ███   ███  ███   ███  ███   ███  ███      ███     
    #    ███      ███████    ███████    ███████   ███████  ████████
    
    onFuncolResize: => @knob.doDrag = true
    onFuncolToggle: => 
    
        @toggle() if not (@visible() and @collapsed())
        @active = @visible()
        ked_session.set 'funcol▸active' @active
        cols = max 16 int(@cells.screen.cols / 6)
        post.emit 'view.size' @name 'left' (@hidden() ? -@cells.cols : cols-@cells.cols)
        
    # ██     ██   ███████   ███   ███   ███████  ████████  
    # ███   ███  ███   ███  ███   ███  ███       ███       
    # █████████  ███   ███  ███   ███  ███████   ███████   
    # ███ █ ███  ███   ███  ███   ███       ███  ███       
    # ███   ███   ███████    ███████   ███████   ████████  
  
    onMouse: event =>
    
        ⮐  if @hidden() or @collapsed() or not @active
        
        ret = super event            ; ⮐  ret if ret?.redraw
        ret = @knob.onMouse event    ; ⮐  ret if ret?.redraw
        if @colorpicker.visible()
            ret = @colorpicker.onMouse event
            ⮐  ret if ret?.redraw
        ret = @funtree.onMouse event ; ⮐  ret if ret?.redraw
        
    # ███   ███  ███   ███  ████████  ████████  ███      
    # ███ █ ███  ███   ███  ███       ███       ███      
    # █████████  █████████  ███████   ███████   ███      
    # ███   ███  ███   ███  ███       ███       ███      
    # ██     ██  ███   ███  ████████  ████████  ███████  
    
    onWheel: event =>
        
        ⮐  if @hidden() or @collapsed() or not @active

        if @colorpicker.visible()
            if ret = @colorpicker.onWheel event
                ⮐  ret

        @funtree.onWheel event
        
    # ███   ███  ████████  ███   ███  
    # ███  ███   ███        ███ ███   
    # ███████    ███████     █████    
    # ███  ███   ███          ███     
    # ███   ███  ████████     ███     
    
    onKey: key event =>
        
        ⮐  if @hidden() or @collapsed() or not @active

        if @colorpicker.visible() and @colorpicker.hasFocus()
            ⮐  @colorpicker.onKey key event

        ⮐  if not @funtree.hasFocus()
        
        @funtree.onKey key event

export funcol
