
use ../../../kxk    ▪ post slash kseg kutil
use ../../theme     ◆ color theme
use ../../edit/tool ◆ belt
use ../base         ◆ view knob
use                 ◆ funtree sheeditor colorpicker uniko
■funcol□view
    @: screen @editor features ->
        
        super screen 'funcol' features
        
        @isVisible     = false
        @active        = false
        @colorReplace  = null
        @colorDecorate = null
        
        @pointerType = 'pointer'
        
        @knob        = new knob        screen         "#{@name}_knob"
        @funtree     = new funtree            @editor "#{@name}_funtree" ['scrllr']
        @sheeditor   = new sheeditor   screen @editor "#{@name}_sheeditor"
        @colorpicker = new colorpicker screen @editor "#{@name}_colorpicker"
        @uniko       = new uniko       screen @editor "#{@name}_uniko"
        
        @knob.frameSide = 'left'
        
        @funtree.setColor 'bg'            theme.funtree.bg
        @funtree.setColor 'empty'         @funtree.color.bg
        @funtree.setColor 'cursor_main'   @funtree.color.bg
        @funtree.setColor 'cursor_empty'  @funtree.color.bg
        @funtree.scroll.setColor 'bg'     @funtree.color.bg
        
        @knob   .setColor 'bg'            @funtree.color.bg

        post.on 'session.merge'     @onSessionMerge
        post.on 'funcol.resize'     @onFuncolResize
        post.on 'funcol.toggle'     @onFuncolToggle
        post.on 'funcol.show'       @onFuncolShow
        post.on 'funcol.focus'      @focusTree
        post.on 'colorpicker.show'  @onColorPickerShow
        post.on 'uniko.show'        @onUnikoShow
        post.on 'file.loaded'       @onFileLoaded
        
    onFileLoaded: path =>
    
        if slash.ext(path) == 'sheet'
            @sheeditor.show()
            @funtree.hide()
        else
            @sheeditor.hide()
            @funtree.show()
        
    onSessionMerge: recent =>
    
        ⮐ if empty recent.funcol
        
        if recent.funcol.active
            @active = true
            @show()
            
        ked_session.set 'funcol' recent.funcol

    onColorPickerShow: hex =>

        @active = true

        @cells.cols = max 16 int(@cells.screen.cols / 6) if @cells.cols < 16

        @show() if @hidden()

        @colorpicker.show()

        ked_session.set 'funcol▸active' @active
        post.emit 'redraw'

    onUnikoShow: =>

        @active = true
        @show() if @hidden()

        @uniko.show()

        ked_session.set 'funcol▸active' @active
        post.emit 'redraw'

    colorpickerVisible: => @visible() and @active and @colorpicker.visible()

    layout: x y w h ->
        
        ph = @colorpicker.visible() ? min(@colorpicker.pickerHeight() h-1) : 0
        ph = 0 if ph < 1

        uh = @uniko.visible() ? min(@uniko.height h-ph-1) : 0
        uh = 0 if uh < 1

        @funtree.layout     x y w h-ph-uh
        @sheeditor.layout   x y w h-ph-uh
        @uniko.layout       x y+h-ph-uh w uh if uh
        @colorpicker.layout x y+h-ph w ph if ph
        @knob.layout        x y 1 h
                
        super x y w h
        
    draw: ->
        
        ⮐ if @hidden() or @collapsed() or not @active
        
        @cells.fill_rect 0 1 -1 -1 ' ' null theme.funtree.bg
        @cells.fill_rect 0 0 -1  0 ' ' null theme.gutter.bg
        
        @funtree.draw()
        @sheeditor.draw()    
        @uniko.draw()       if @uniko.visible()
        @colorpicker.draw() if @colorpicker.visible()
        @knob.draw()
    
        super()
        
    onContext: event =>
    
        ⮐ if not @hover
    
        log "funcol.onContext: #{@hover}" event
    
    focusTree: => 
        
        if @sheeditor.visible()
            @sheeditor.grabFocus()
        else
            @funtree.grabFocus()
        
    onFuncolResize: => @knob.doDrag = true
    onFuncolToggle: => 
    
        @toggle()
        @active = @visible()
        ked_session.set 'funcol▸active' @active
        cols = max 16 int(@cells.screen.cols / 6)
        post.emit 'view.size' @name 'left' (@hidden() ? -@cells.cols : cols-@cells.cols)
        if @hidden() ➜ post.emit 'focus' 'editor'
                     ➜ @focusTree()
        
    onFuncolShow: =>
    
        if @hidden() ➜ @onFuncolToggle()
                     ➜ @focusTree()
        
    onMouse: event =>
    
        ⮐ if @hidden() or @collapsed() or not @active
        
        ret = super event                ; ⮐ ret if ret?.redraw
        ret = @knob.onMouse event        ; ⮐ ret if ret?.redraw
        ret = @uniko.onMouse event       ; ⮐ ret if ret?.redraw
        ret = @colorpicker.onMouse event ; ⮐ ret if ret?.redraw
        ret = @funtree.onMouse event     ; ⮐ ret if ret?.redraw
        ret = @sheeditor.onMouse event   ; ⮐ ret if ret?.redraw
        
    onWheel: event =>
        
        ⮐ if @hidden() or @collapsed() or not @active

        if @uniko.visible()
            if ret = @uniko.onWheel event
                ⮐ ret

        if @colorpicker.visible()
            if ret = @colorpicker.onWheel event
                ⮐ ret

        @funtree.onWheel event
        @sheeditor.onWheel event
        
    onKey: key event =>
        
        ⮐ if @hidden() or @collapsed() or not @active

        switch key
            'shift+alt+cmd+[' ➜ ⮐ post.emit 'view.size' @name 'left'  1
            'shift+alt+cmd+]' ➜ ⮐ post.emit 'view.size' @name 'left' -1

        ⮐ true if @uniko.onKey key event
        ⮐ true if @colorpicker.onKey key event

        if @funtree.hasFocus()   ➜ ⮐ @funtree.onKey key event
        if @sheeditor.hasFocus() ➜ ⮐ @sheeditor.onKey key event
        
export funcol
