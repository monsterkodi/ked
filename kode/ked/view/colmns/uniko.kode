###
    ███   ███  ███   ███  ███  ███  ███   ███████
    ███   ███  ████  ███  ███  ███ ███   ███   ███
    ███   ███  ███ █ ███  ███  █████     ███   ███
    ███   ███  ███  ████  ███  ███ ███   ███   ███
     ███████   ███   ███  ███  ███  ███   ███████

    a unicode character picker
    lives below the funtree and above the colorpicker
###

use ../../../kxk ▪ kseg post
use ../../../kxk ◆ clip
use ../../theme  ◆ theme
use ../../edit   ◆ specs
use ../base      ◆ view input matrix

import julia from '../../util/julia.json' with { type: "json" }

function uniko extends view

    @: @screen @editor name ->

        super @screen name

        @height = 16
        @focus  = 'matrix'

        @setColor 'bg' theme.uniko.bg

        @input  = new input  @screen "#{@name}_input"
        @matrix = new matrix @screen "#{@name}_matrix"

        @matrix.setColor 'bg'             theme.uniko.bg
        @matrix.setColor 'fg'             theme.uniko.fg
        @matrix.setColor 'selection'      theme.uniko.selection
        @matrix.setColor 'selection_blur' theme.uniko.selection_blur
        @matrix.setColor 'scroll'         theme.scroll.knob
        @matrix.setColor 'scroll_dot'     theme.scroll.dot

        @input.on 'action' @onInputAction

        @allItems = []
        for char,comment of julia
            @allItems.push char:char search:trim(comment)
        @matrix.setItems @allItems

        @isVisible = false

    filter: text =>

        text = trim(text).toLowerCase()

        if empty text ➜ ⮐ @matrix.setItems @allItems

        matches = @allItems.filter (item) -> item.search.includes text

        @matrix.setItems matches

    # ███████  ████████  ███      ████████   ███████  █████████  
    # ███      ███       ███      ███       ███          ███     
    # ███████  ███████   ███      ███████   ███          ███     
    #      ███ ███       ███      ███       ███          ███     
    # ███████  ████████  ███████  ████████   ███████     ███     

    focusInput: =>

        @focus = 'input'
        @input.grabFocus()
        true

    focusMatrix: =>

        @focus = 'matrix'
        @matrix.selectFirst()
        @matrix.grabFocus()
        true

    incScale: delta =>

        @matrix.incScale delta
        post.emit 'redraw'
        true

    show: =>

        @input.set ''
        @filter ''
        @focus = 'matrix'

        super()

        @matrix.selectFirst()
        @matrix.grabFocus()

        post.emit 'redraw'

    hide: =>

        ⮐ if @hidden()

        super()

        @focus = 'matrix'
        @input.state.deselect()

        post.emit 'focus' @editor.name
        post.emit 'redraw'

    submit: =>

        char = @matrix.selectedText()

        ⮐ false if empty char

        @editor.state.insert char

        post.emit 'redraw'

        true

    copy: =>

        char = @matrix.selectedText()

        ⮐ false if empty char

        clip.copy char

        true

    # ███   ███  ████████  ███   ███  
    # ███  ███   ███        ███ ███   
    # ███████    ███████     █████    
    # ███  ███   ███          ███     
    # ███   ███  ████████     ███     

    onKey: key event =>

        ⮐ false if @hidden()

        switch event.combo
            'esc'      ➜ ⮐ @hide()
            'return'   ➜ ⮐ @submit()
            'cmd+c'    ➜ ⮐ @copy()
            'ctrl+c'   ➜ ⮐ @copy()
            'cmd+up'   ➜ ⮐ @incScale  1
            'cmd+down' ➜ ⮐ @incScale -1

        if event.combo == 'space'
            ⮐ @submit()

        if @focus == 'input'

            if event.combo == 'down'
                @focusMatrix()
                ⮐ true

            ⮐ @input.onKey key event

        if valid event.char and event.char.length == 1 and event.char in 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'
            @focusInput()
            ⮐ @input.onKey key event

        if event.combo in ['up''left''right''down']            
            @matrix.moveSelection event.combo

        false

    onInputAction: action text =>

        switch action
            'change' ➜ @filter text

    onMouse: event =>

        ⮐ false if @hidden()

        if @input.cells.isInsideEvent event
            @focusInput()
            ⮐ @input.onMouse event

        if @matrix.cells.isInsideEvent event

            if event.type == 'press'
                [x y] = @matrix.cells.posForEvent event
                [col row] = @matrix.cellAtPos x y
                @focus = 'matrix'
                @matrix.selectAt col row
                @matrix.grabFocus()
                @submit()

            ⮐ redraw:true

        false

    onWheel: event =>

        ⮐ false if @hidden()

        if @matrix.cells.isInsideEvent event
            switch event.dir
                'up'   ➜ @matrix.moveSelection 'up'
                'down' ➜ @matrix.moveSelection 'down'
            ⮐ redraw:true

        false

    # ███████    ████████    ███████   ███   ███  
    # ███   ███  ███   ███  ███   ███  ███ █ ███  
    # ███   ███  ███████    █████████  █████████  
    # ███   ███  ███   ███  ███   ███  ███   ███  
    # ███████    ███   ███  ███   ███  ██     ██  

    layout: x y w h =>

        super x y w h

        @input.layout x+1 y+1 w-2 1

        mh = max 0 (h-4)

        @matrix.layout x+1 y+3 w-2 mh

    draw: =>

        ⮐ if @hidden() or @collapsed()

        @cells.fill_rect 0 0 -1 -1 ' ' null @color.bg

        @input.draw()
        @matrix.draw()

        super()

export uniko
