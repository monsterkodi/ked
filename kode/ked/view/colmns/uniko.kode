
use ../../../kxk ◆ clip kseg post
use ../../theme  ◆ color theme
use ../../edit   ◆ specs
use ../base      ◆ view input matrix bubbles

import julia from '../../util/julia.json' with { type: "json" }
■uniko□view
    # a unicode character picker
    
    @: @screen @editor @name ->

        super @screen @name

        @height = 28

        @setColor 'bg'      theme.uniko.bg
        @setColor 'hex'     theme.uniko.hex
        @setColor 'hex_fg'  theme.uniko.hex_fg
        @setColor 'name'    theme.uniko.name
        @setColor 'name_fg' theme.uniko.name_fg

        @input  = new input   @screen "#{@name}_input"
        @matrix = new matrix  @screen "#{@name}_matrix"
        @info   = new bubbles @screen "#{@name}_info"

        @info.pointRight = true

        @matrix.setColor 'bg'             theme.uniko.bg
        @matrix.setColor 'fg'             theme.uniko.fg
        @matrix.setColor 'selection'      theme.uniko.selection
        @matrix.setColor 'selection_blur' theme.uniko.selection_blur
        @matrix.setColor 'scroll'         theme.scroll.knob
        @matrix.setColor 'scroll_dot'     theme.scroll.dot
        
        @input.drawUnfocusedCursors = false
        @input.on 'action' @onInputAction
        
        @matrix.on 'submit' @submit

        @allItems = []
        @charItem = {}
        for char,comment of julia
            @allItems.push char:char search:trim(comment)
            @charItem[char] = @allItems[-1]
        @matrix.setItems @allItems
        
        @mouseItems  = [@input @matrix]
        @focusRing   = [@input @matrix]
        @wheelItems  = [       @matrix]
        @focusUpDown = false
        @isVisible   = false

    @MAXCHARS: 0x10000

    # parses ranges and sets of characters: '◜◞◟◝' '◜+3' '◜-◟' '25ef 0x25cc' '0x25ef+3' '25ef-25fa'
    # hex numbers need a 0x prefix, or four digits with at least one decimal digit
    # literal characters must be non-ascii, so that names like 'less-than' can be searched
    # returns the characters, each once, or null if the text is something else

    @parse: text ->

        toks = []
        rgx  = /\s+|[+-]|0x[0-9a-f]+|[0-9a-f]+|[^\x00-\x7f]/iuy
        pos  = 0
        while pos < text.length
            rgx.lastIndex = pos
            m = rgx.exec text
            ⮐ null if not m
            pos += m[0].length
            t = m[0]
            if /^\s/.test t                     ➜ continue
            else if t in ['+' '-']              ➜ toks.push op:t
            else if t.codePointAt(0) > 0x7f     ➜ toks.push cp:t.codePointAt(0)
            else                                  toks.push num:t

        ⮐ null if empty toks

        code = (t) -> # code point of a literal char or a hex number
            ⮐ t.cp if t?.cp?
            ⮐ null if not t?.num?
            ⮐ parseInt(t.num[2..] 16) if /^0x[0-9a-f]+$/i.test t.num
            ⮐ parseInt(t.num 16) if t.num.length >= 4 and /[0-9]/.test t.num
            null

        chars = new Set
        add = (a b) ->
            for c in a..b
                break if chars.size >= uniko.MAXCHARS or c > 0x10ffff
                continue if c < 0x20 or 0x7f <= c <= 0x9f or 0xd800 <= c <= 0xdfff
                chars.add String.fromCodePoint(c)

        i = 0
        while i < toks.length
            a = code toks[i]
            ⮐ null if not a?
            op   = toks[i+1]?.op
            next = toks[i+2]
            if op and not next? # an operator without operand while typing
                add a a
                break
            switch op
                '+'
                    ⮐ null if not /^[0-9]+$/.test next.num ? ''
                    add a a+parseInt(next.num)
                    i += 3
                '-'
                    b = code next
                    ⮐ null if not b?
                    add min(a b) max(a b)
                    i += 3
                ➜
                    add a a
                    i += 1

        Array.from chars

    filter: text =>

        if chars = uniko.parse text
            ⮐ @matrix.setItems chars.map((c) => @charItem[c] ? char:c search:'')

        text = trim(text).toLowerCase()

        if empty text ➜ ⮐ @matrix.setItems @allItems

        words = text.split ' '
        
        matches = @allItems.filter (item) -> 
            for word in words
                ⮐ false if not item.search.includes word
            true

        @matrix.setItems matches

    focusInput: =>

        @input.grabFocus()
        true

    focusMatrix: =>

        @matrix.selectFirst()
        @matrix.grabFocus()
        true

    incScale: delta =>

        @matrix.incScale delta
        post.emit 'redraw'
        true

    show: =>

        @input.set ''
        @filter ''

        super()

        @matrix.selectFirst()
        @matrix.grabFocus()

        post.emit 'redraw'

    hide: =>

        ⮐ if @hidden()

        super()

        @input.state.deselect()

        post.emit 'focus' @editor.name
        post.emit 'redraw'

    submit: =>

        char = @matrix.selectedText()

        ⮐ false if empty char

        @editor.state.insert char

        post.emit 'redraw'

        true

    copy: =>

        char = @matrix.selectedText()

        ⮐ false if empty char

        clip.copy char

        true

    onKey: key event =>

        ⮐ false if @hidden()
        ⮐ false if not @hasFocus()

        if ret = super key event
            # log "view #{key}"
            ⮐ ret

        switch event.combo
            'esc'       ➜ ⮐ @hide()
            'cmd+up'    ➜ ⮐ @incScale  1
            'cmd+down'  ➜ ⮐ @incScale -1

        if @input.hasFocus()

            switch event.combo 
                'down'  ➜ ⮐ @focusMatrix()
                'tab'   ➜ ⮐ true

            ⮐ @input.onKey key event
        
        switch event.combo 
            'space'      ➜ ⮐ @submit()
            'return'     ➜ ⮐ @submit()
            'cmd+c'      ➜ ⮐ @copy()
            'ctrl+c'     ➜ ⮐ @copy()
            'up''right'
            'down''left' ➜ ⮐ @matrix.moveSelection event.combo
        
        if valid event.char and event.char.length == 1
            @focusInput()
            ⮐ true if event.char == '\t'
            ⮐ @input.onKey key event

    onInputAction: action text =>

        switch action
            'change' ➜ @filter text

    layout: x y w h =>

        super x y w h
        
        @input.layout x+1 y+1 w-2 1

        mh = max 0 (h-4)

        @matrix.layout x+1 y+3 w-2 mh

    draw: =>

        ⮐ if @hidden() or @collapsed()

        @cells.fill_rect 0 0 -1 -1 ' ' null @color.bg

        @input.draw()
        @drawInfo()
        @matrix.draw()

        super()

    infoBubbles: width => # names and hex of the selected char that fit into width columns

        item = @matrix.items[@matrix.selectedIndex]
        ⮐ [] if empty item?.char

        hex   = Array.from(item.char).map((c) -> c.codePointAt(0).toString(16)).join(' ')
        names = item.search.split(/\s+/).filter((n) -> valid n).map (name,i) =>
            text:name fg:@color.name_fg bg:color.darken(@color.name max(0.4 1-0.2*i))

        all = names.concat [text:hex fg:@color.hex_fg bg:@color.hex] # hex last, so it stays in place
        ⮐ all if bubbles.width(all) <= width

        # not enough room: the hex goes first, its absence hints that names are cropped
        names.pop() while names.length and bubbles.width(names) > width
        names

    drawInfo: => # right-aligned in the input row, left of it only the input's text and cursor

        right = @cells.cols - 1
        free  = right - 1 - kseg.width(@input.current()) - 2
        items = @infoBubbles free
        ⮐ if empty items

        w = bubbles.width items
        @info.layout @cells.x+right-w @cells.y+1 w 1
        @info.setColor 'empty' @input.color.bg
        @info.set items
        @info.draw()

export uniko
