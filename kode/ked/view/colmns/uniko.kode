###
    ███   ███  ███   ███  ███  ███  ███   ███████
    ███   ███  ████  ███  ███  ███ ███   ███   ███
    ███   ███  ███ █ ███  ███  █████     ███   ███
    ███   ███  ███  ████  ███  ███ ███   ███   ███
     ███████   ███   ███  ███  ███  ███   ███████

    a unicode character picker
###

use ../../../kxk ▪ kseg post
use ../../../kxk ◆ clip
use ../../theme  ◆ theme
use ../../edit   ◆ specs
use ../base      ◆ view input matrix

import julia from '../../util/julia.json' with { type: "json" }

function uniko extends view

    @: @screen @editor name ->

        super @screen name

        @height = 28
        @focus  = 'matrix'

        @setColor 'bg' theme.uniko.bg

        @input  = new input  @screen "#{@name}_input"
        @matrix = new matrix @screen "#{@name}_matrix"

        @matrix.setColor 'bg'             theme.uniko.bg
        @matrix.setColor 'fg'             theme.uniko.fg
        @matrix.setColor 'selection'      theme.uniko.selection
        @matrix.setColor 'selection_blur' theme.uniko.selection_blur
        @matrix.setColor 'scroll'         theme.scroll.knob
        @matrix.setColor 'scroll_dot'     theme.scroll.dot

        @input.on 'action' @onInputAction
        @matrix.on 'submit' @submit

        @allItems = []
        for char,comment of julia
            @allItems.push char:char search:trim(comment)
        @matrix.setItems @allItems

        @isVisible = false

    filter: text =>

        text = trim(text).toLowerCase()

        if empty text ➜ ⮐ @matrix.setItems @allItems

        words = text.split ' '
        
        matches = @allItems.filter (item) -> 
            for word in words
                ⮐ false if not item.search.includes word
            true

        @matrix.setItems matches

    # ███████  ████████  ███      ████████   ███████  █████████  
    # ███      ███       ███      ███       ███          ███     
    # ███████  ███████   ███      ███████   ███          ███     
    #      ███ ███       ███      ███       ███          ███     
    # ███████  ████████  ███████  ████████   ███████     ███     

    focusInput: =>

        @focus = 'input'
        @input.grabFocus()
        true

    focusMatrix: =>

        @focus = 'matrix'
        @matrix.selectFirst()
        @matrix.grabFocus()
        true

    incScale: delta =>

        @matrix.incScale delta
        post.emit 'redraw'
        true

    show: =>

        @input.set ''
        @filter ''
        @focus = 'matrix'

        super()

        @matrix.selectFirst()
        @matrix.grabFocus()

        post.emit 'redraw'

    hide: =>

        ⮐ if @hidden()

        super()

        @focus = 'matrix'
        @input.state.deselect()

        post.emit 'focus' @editor.name
        post.emit 'redraw'

    submit: =>

        char = @matrix.selectedText()

        ⮐ false if empty char

        @editor.state.insert char

        post.emit 'redraw'

        true

    copy: =>

        char = @matrix.selectedText()

        ⮐ false if empty char

        clip.copy char

        true

    # ███   ███  ████████  ███   ███  
    # ███  ███   ███        ███ ███   
    # ███████    ███████     █████    
    # ███  ███   ███          ███     
    # ███   ███  ████████     ███     

    onKey: key event =>

        ⮐ false if @hidden()

        switch event.combo
            'esc'       ➜ ⮐ @hide()
            'cmd+up'    ➜ ⮐ @incScale  1
            'cmd+down'  ➜ ⮐ @incScale -1

        if @focus == 'input'

            switch event.combo 
                'down'  ➜ ⮐ @focusMatrix()

            ⮐ @input.onKey key event

        switch event.combo 
            'space'     ➜ ⮐ @submit()
            'return'    ➜ ⮐ @submit()
            'cmd+c'     ➜ ⮐ @copy()
            'ctrl+c'    ➜ ⮐ @copy()
            'up''left''right''down'
                @matrix.moveSelection event.combo

        if valid event.char and event.char.length == 1
            @focusInput()
            ⮐ @input.onKey key event

        false

    onInputAction: action text =>

        switch action
            'change' ➜ @filter text

    onMouse: event =>

        ⮐ if @hidden()
        ret = @input.onMouse event   ; ⮐ ret if ret?.redraw
        ret = @matrix.onMouse event  ; ⮐ ret if ret?.redraw
        super event

    onWheel: event =>

        ⮐ false if @hidden()

        if @matrix.cells.isInsideEvent event
            switch event.dir
                'up'   ➜ @matrix.moveSelection 'up'
                'down' ➜ @matrix.moveSelection 'down'
            ⮐ redraw:true

        false

    # ███████    ████████    ███████   ███   ███  
    # ███   ███  ███   ███  ███   ███  ███ █ ███  
    # ███   ███  ███████    █████████  █████████  
    # ███   ███  ███   ███  ███   ███  ███   ███  
    # ███████    ███   ███  ███   ███  ██     ██  

    layout: x y w h =>

        super x y w h

        @input.layout x+1 y+1 w-2 1

        mh = max 0 (h-4)

        @matrix.layout x+1 y+3 w-2 mh

    draw: =>

        ⮐ if @hidden() or @collapsed()

        @cells.fill_rect 0 0 -1 -1 ' ' null @color.bg

        @input.draw()
        @matrix.draw()

        super()

export uniko
