
use ../../../kxk ◆ clip kseg post
use ../../theme  ◆ color theme
use ../../edit   ◆ specs
use ../base      ◆ view input matrix

import julia from '../../util/julia.json' with { type: "json" }
■uniko□view
    # a unicode character picker
    
    @: @screen @editor @name ->

        super @screen @name

        @height = 28

        @setColor 'bg'      theme.uniko.bg
        @setColor 'hex'     theme.uniko.hex
        @setColor 'hex_fg'  theme.uniko.hex_fg
        @setColor 'name'    theme.uniko.name
        @setColor 'name_fg' theme.uniko.name_fg

        @input  = new input  @screen "#{@name}_input"
        @matrix = new matrix @screen "#{@name}_matrix"

        @matrix.setColor 'bg'             theme.uniko.bg
        @matrix.setColor 'fg'             theme.uniko.fg
        @matrix.setColor 'selection'      theme.uniko.selection
        @matrix.setColor 'selection_blur' theme.uniko.selection_blur
        @matrix.setColor 'scroll'         theme.scroll.knob
        @matrix.setColor 'scroll_dot'     theme.scroll.dot
        
        @input.drawUnfocusedCursors = false
        @input.on 'action' @onInputAction
        
        @matrix.on 'submit' @submit

        @allItems = []
        for char,comment of julia
            @allItems.push char:char search:trim(comment)
        @matrix.setItems @allItems
        
        @mouseItems  = [@input @matrix]
        @focusRing   = [@input @matrix]
        @wheelItems  = [       @matrix]
        @focusUpDown = false
        @isVisible   = false

    filter: text =>

        text = trim(text).toLowerCase()

        if empty text ➜ ⮐ @matrix.setItems @allItems

        words = text.split ' '
        
        matches = @allItems.filter (item) -> 
            for word in words
                ⮐ false if not item.search.includes word
            true

        @matrix.setItems matches

    focusInput: =>

        @input.grabFocus()
        true

    focusMatrix: =>

        @matrix.selectFirst()
        @matrix.grabFocus()
        true

    incScale: delta =>

        @matrix.incScale delta
        post.emit 'redraw'
        true

    show: =>

        @input.set ''
        @filter ''

        super()

        @matrix.selectFirst()
        @matrix.grabFocus()

        post.emit 'redraw'

    hide: =>

        ⮐ if @hidden()

        super()

        @input.state.deselect()

        post.emit 'focus' @editor.name
        post.emit 'redraw'

    submit: =>

        char = @matrix.selectedText()

        ⮐ false if empty char

        @editor.state.insert char

        post.emit 'redraw'

        true

    copy: =>

        char = @matrix.selectedText()

        ⮐ false if empty char

        clip.copy char

        true

    onKey: key event =>

        ⮐ false if @hidden()
        ⮐ false if not @hasFocus()

        if ret = super key event
            # log "view #{key}"
            ⮐ ret

        switch event.combo
            'esc'       ➜ ⮐ @hide()
            'cmd+up'    ➜ ⮐ @incScale  1
            'cmd+down'  ➜ ⮐ @incScale -1

        if @input.hasFocus()

            switch event.combo 
                'down'  ➜ ⮐ @focusMatrix()
                'tab'   ➜ ⮐ true

            ⮐ @input.onKey key event
        
        switch event.combo 
            'space'      ➜ ⮐ @submit()
            'return'     ➜ ⮐ @submit()
            'cmd+c'      ➜ ⮐ @copy()
            'ctrl+c'     ➜ ⮐ @copy()
            'up''right'
            'down''left' ➜ ⮐ @matrix.moveSelection event.combo
        
        if valid event.char and event.char.length == 1
            @focusInput()
            ⮐ true if event.char == '\t'
            ⮐ @input.onKey key event

    onInputAction: action text =>

        switch action
            'change' ➜ @filter text

    layout: x y w h =>

        super x y w h
        
        @input.layout x+1 y+1 w-2 1

        mh = max 0 (h-4)

        @matrix.layout x+1 y+3 w-2 mh

    draw: =>

        ⮐ if @hidden() or @collapsed()

        @cells.fill_rect 0 0 -1 -1 ' ' null @color.bg

        @input.draw()
        @drawInfo()
        @matrix.draw()

        super()

    infoBubbles: width => # names and hex of the selected char, as many names as fit into width columns

        item = @matrix.items[@matrix.selectedIndex]
        ⮐ [] if empty item?.char

        hex  = Array.from(item.char).map((c) -> '0x' + c.codePointAt(0).toString(16)).join(' ')
        used = 2 + kseg.width(hex) # left cap, text, right cap
        ⮐ [] if used > width

        bubbles = []
        for name,i in item.search.split(/\s+/).filter((n) -> valid n)
            used += 1 + kseg.width(name)
            break if used > width
            bubbles.push text:name fg:@color.name_fg bg:color.darken(@color.name max(0.4 1-0.2*i))

        bubbles.push text:hex fg:@color.hex_fg bg:@color.hex # last, so it stays in place
        bubbles

    drawInfo: => # right-aligned in the input row, left of it only the input's text and cursor

        right = @cells.cols - 1
        free  = right - 1 - kseg.width(@input.current()) - 2
        bubbles = @infoBubbles free
        ⮐ if empty bubbles

        x = right - 1
        for b in bubbles
            x -= 1 + kseg.width(b.text)

        ibg  = @input.color.bg
        prev = ibg
        for b in bubbles
            @cells.set x 1 '' b.bg prev
            x += 1
            for seg in kseg(b.text)
                @cells.set x 1 kseg.str(seg) b.fg b.bg
                x += kseg.segWidth seg
            prev = b.bg
        @cells.set x 1 '' prev ibg

export uniko
