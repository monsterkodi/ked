###
    █████████  ███  █████████  ███      ████████  ████████  ███  ███      ████████  
       ███     ███     ███     ███      ███       ███       ███  ███      ███       
       ███     ███     ███     ███      ███████   ██████    ███  ███      ███████   
       ███     ███     ███     ███      ███       ███       ███  ███      ███       
       ███     ███     ███     ███████  ████████  ███       ███  ███████  ████████  

    used by title to display the currently edited file in the fileeditor
###

use ../../../kxk ▪ slash post
use ../../theme  ◆ color theme 
use ../../util   ◆ syntax
use ../base      ◆ view

function titlefile extends view

    @: screen name ->

        super screen name
        
        @setColor 'bg'     theme.title.bg
        @setColor 'empty'  theme.title.empty
        @setColor 'hover'  theme.hover.bg
        
        @pointerType = 'pointer'
        @syntax = new syntax
        @syntax.setExt 'noon'
        
        @rounded = ''
        
    # ███████    ████████    ███████   ███   ███  
    # ███   ███  ███   ███  ███   ███  ███ █ ███  
    # ███   ███  ███████    █████████  █████████  
    # ███   ███  ███   ███  ███   ███  ███   ███  
    # ███████    ███   ███  ███   ███  ██     ██  
    
    draw: -> 
        
        ⮐  if @hidden()
    
        super()
            
        bg = @hover ? @color.hover : @color.bg
        
        for ch,x in @rounded
            if ch in ''
                @cells.set x 0 ch bg @color.empty
            else
                fg = @syntax.getColor x 0
                @cells.set x 0 ch fg bg 
                @cells.adjustContrastForHighlight x 0 bg if @hover
                
    #  ███████   ███████          ███  ███   ███   ███████  █████████  
    # ███   ███  ███   ███        ███  ███   ███  ███          ███     
    # █████████  ███   ███        ███  ███   ███  ███████      ███     
    # ███   ███  ███   ███  ███   ███  ███   ███       ███     ███     
    # ███   ███  ███████     ███████    ███████   ███████      ███     
    
    adjustText: ->
    
        @file ?= ''
        @pars = slash.parse @file
        @syntax.clear()
        @syntax.setLines ['/'+@pars.file]
        @rounded = '' + @pars.file + ''
            
    set: file ->
    
        ⮐  if @file == trim file
        
        @file = trim file
        @adjustText()
        
    show: file => @set file; @cells.rows = 1
    
    # ██     ██   ███████   ███   ███   ███████  ████████  
    # ███   ███  ███   ███  ███   ███  ███       ███       
    # █████████  ███   ███  ███   ███  ███████   ███████   
    # ███ █ ███  ███   ███  ███   ███       ███  ███       
    # ███   ███   ███████    ███████   ███████   ████████  
    
    onMouse: event =>
        
        super event
        
        switch event.type
            
            'press' 
                
                if @hover
                    @emit 'action' 'click' @file
                    ⮐ redraw:true                
        @hover
    
export titlefile
