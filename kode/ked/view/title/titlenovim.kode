
use ../../../kxk ▪ slash post
use ../../theme  ◆ color theme 
use ../base      ◆ view input

■titlenovim□view
    # used by title to display the novim status
    
    @: screen name stateName ->
        
        super screen name

        @stateName = stateName
        @input     = new input @screen "#{name}_input"
        @vinder    = new input @screen "#{name}_vinder"

        @input.on  'action' @onInputAction
        @vinder.on 'action' @onVinderAction

        @input.hide()
        @vinder.hide()
        
        @setColor 'bg'     theme.novim.bg
        @setColor 'fg'     theme.novim.text
        @setColor 'empty'  theme.title.empty

        @input.setColor 'bg'       theme.novim.pending.bg
        @input.setColor 'bg_blur'  theme.novim.pending.bg
        @input.setColor 'bg_focus' theme.novim.pending.bg
        @input.setColor 'empty'    theme.novim.pending.bg

        @vinder.setColor 'bg'       theme.novim.pending.bg
        @vinder.setColor 'bg_blur'  theme.novim.pending.bg
        @vinder.setColor 'bg_focus' theme.novim.pending.bg
        @vinder.setColor 'empty'    theme.novim.pending.bg
        
        @pointerType = 'default'
        @novimText   = 'novim'
        
        post.on 'novim.execute'      @onExecute
        post.on 'novim.pending'      @onPending
        post.on 'novim.error'        @onError
        post.on 'novim.ex.start'     @onExStart
        post.on 'novim.search.start' @onSearchStart
        post.on 'novim.search.position' @onSearchPosition

    onExStart: start =>
        
        ⮐ if start.state != @stateName

        @vinder.hide() if @vinder.visible()

        @input.set start.text
        @input.state.moveCursors 'eol'

        @setColor 'bg' theme.novim.pending.bg
        @setColor 'fg' theme.novim.pending.fg

        @input.show()
        @input.grabFocus()

        @layoutInput @input
        post.emit 'redraw'

        true

    onSearchStart: start =>

        ⮐ if start.state != @stateName

        @input.hide() if @input.visible()

        @vinder.set start.text
        @vinder.selectAll()
        @vinder.state.moveCursors 'eol'

        @setColor 'bg' theme.novim.pending.bg
        @setColor 'fg' theme.novim.pending.fg

        @vinder.show()
        @vinder.grabFocus()

        @layoutInput @vinder
        post.emit 'redraw'

        true

    onInputAction: (action text) =>
        
        switch action
            'submit' 'cancel'
                @input.hide()
                @novimText = ''
                @emit 'action' action text
            'change'
                @emit 'action' 'change' text
        
        true

    onVinderAction: (action text) =>
        
        switch action
            'submit' 'cancel'
                @vinder.hide()
                @novimText = ''
                @emit 'vinder' action text
            'change'
                @emit 'vinder' 'change' text
        
        true

    onPending: pending => 
        # log 'PENDING' pending
        @setColor 'bg'  theme.novim.pending.bg
        @setColor 'fg'  theme.novim.pending.fg
        t  = pending.op ? ''
        t += ' '
        t += pending.count ? ''
        t += pending.area ? ''
        t += pending.prefix ? ''
        t += pending.register ? '' 
        @novimText = t
        
    onExecute: execute =>

        @setColor 'bg'  theme.novim.execute.bg
        @setColor 'fg'  theme.novim.execute.fg
        t = execute.operator
        t += ' ' + execute.count if execute.count
        if execute.motion
            if execute.motion.kind == 'textObject'
                t += ' ' + execute.motion.area   if execute.motion.area
                t += ' ' + execute.motion.target if execute.motion.target
            else 
                t += ' ' + execute.motion.kind        
        @novimText = t
 
    onSearchPosition: position =>

        ⮐ if position.state != @stateName

        @setColor 'bg' theme.novim.execute.bg
        @setColor 'fg' theme.novim.execute.fg
        @novimText = "#{position.current}/#{position.total}"

    onError: err => 

        @setColor 'bg' theme.novim.error.bg
        @setColor 'fg' theme.novim.error.fg
        @novimText = err

    onMouse: event =>

        ⮐ @vinder.onMouse(event) if @vinder.visible()
        ⮐ false if not @input.visible()

        @input.onMouse event

    onKey: (key event) =>

        ⮐ @vinder.onKey(key event) if @vinder.visible()

        @input.onKey key event

    layout: x y w h =>

        super x y w h
        @layoutInput @input
        @layoutInput @vinder

    layoutInput: input ->

        input.layout @cells.x+1 @cells.y max(0 @cells.cols-2) 1

    draw: x w -> 
        
        ⮐ if @hidden()
        
        super()
        
        @layout x 0 w 1

        if @vinder.visible()
            @layoutInput @vinder
            @vinder.draw()
            @drawFrame()
        else if @input.visible()
            @layoutInput @input
            @input.draw()
            @drawFrame()
        else
            @drawText()
        
    drawFrame: ->

        fg = @color.bg 
        bg = @color.empty

        @cells.set 0 0 '' fg bg
        @cells.set @cells.cols-1 0 '' fg bg

    drawText: ->

        @rounded = "#{rpad(@cells.cols-2 @novimText)}"
        
        bg = @color.bg
        fg = @color.fg 
        for ch,xo in @rounded
            if ch in ''
                @cells.set xo 0 ch bg @color.empty
            else
                @cells.set xo 0 ch fg bg 

export titlenovim
