###
    █████████  ███  █████████  ███      ████████  ███   ███   ███████   ███   ███  ███  ██     ██  
       ███     ███     ███     ███      ███       ████  ███  ███   ███  ███   ███  ███  ███   ███  
       ███     ███     ███     ███      ███████   ███ █ ███  ███   ███   ███ ███   ███  █████████  
       ███     ███     ███     ███      ███       ███  ████  ███   ███     ███     ███  ███ █ ███  
       ███     ███     ███     ███████  ████████  ███   ███   ███████       █      ███  ███   ███  

    used by title to display the novim status
###

use ../../../kxk ▪ slash post
use ../../theme  ◆ color theme 
use ../../edit   ◆ mode
use ../base      ◆ view

function titlenovim extends view

    @: screen name ->
        
        super screen name
        
        @setColor 'bg'     theme.novim.bg
        @setColor 'fg'     theme.novim.text
        @setColor 'empty'  theme.title.empty
        
        @pointerType = 'default'
        @novimText   = 'novim'
        
        post.on 'novim.execute' @onExecute
        post.on 'novim.pending' @onPending
        post.on 'novim.error'   @onError

    onPending: pending => 
        # log 'PENDING' pending
        @setColor 'bg'  theme.novim.pending.bg
        @setColor 'fg'  theme.novim.pending.fg
        t  = pending.op ? ''
        t += ' '
        t += pending.count ? ''
        t += pending.area ? ''
        t += pending.prefix ? ''
        t += pending.register ? '' 
        @novimText = t
        
    onExecute: execute =>
        # log 'EXECUTE' execute
        @setColor 'bg'  theme.novim.execute.bg
        @setColor 'fg'  theme.novim.execute.fg
        t = execute.operator
        t += ' ' + execute.count if execute.count
        if execute.motion
            if execute.motion.kind == 'textObject'
                t += ' ' + execute.motion.area   if execute.motion.area
                t += ' ' + execute.motion.target if execute.motion.target
            else 
                t += ' ' + execute.motion.kind        
        @novimText = t
 
    onError: err => 
        # log "ERROR" err
        @setColor 'bg' theme.novim.error.bg
        @setColor 'fg' theme.novim.error.fg
        @novimText = err

    # ███████    ████████    ███████   ███   ███  
    # ███   ███  ███   ███  ███   ███  ███ █ ███  
    # ███   ███  ███████    █████████  █████████  
    # ███   ███  ███   ███  ███   ███  ███   ███  
    # ███████    ███   ███  ███   ███  ██     ██  
    
    draw: x w -> 
        
        ⮐ if @hidden()
        
        super()
        
        @layout x 0 w 1
        @rounded = "#{rpad(w-2 @novimText)}"
        
        bg = @color.bg
        fg = @color.fg 
        for ch,xo in @rounded
            if ch in ''
                @cells.set xo 0 ch bg @color.empty
            else
                @cells.set xo 0 ch fg bg 

export titlenovim
