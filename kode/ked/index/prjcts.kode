
use ../../kxk ▪ post slash nfs pullIf
use ../util   ◆ walker config

■prjcts
        
    @queue:    []
    @projects: {}
    @allFiles: {}
    @indexing: null

    @files: path -> @projects[@dir(path)]?.files ? []
    
    @dir: path ->

        if valid path
            
            path = slash.absolute path process.cwd()
            
            if prjPath = @allFiles[path]
                ⮐ prjPath
            if prjcts.projects[path]
                ⮐ @projects[path].dir
            for prjPath,project of prjcts.projects
                if path.startsWith prjPath
                    ⮐ prjPath
        log 'missing prj?' path
        null
        
    @addFile: file ◯->
        
        file = slash.absolute file process.cwd()
        
        extensions = config.data?.sourceFileExtensions
        ⮐ if extensions and slash.ext(file) not in extensions
        
        prjPath =◯ nfs.prj file
        prjPath = null if prjPath == '/'
        prjPath ?= slash.dir file
        
        project = @projects[prjPath]
        ⮐ if not project
        ⮐ if file in project.files
        
        project.files.push file
        @allFiles[file] = prjPath
        
    @removeFile: file ->
        
        prjPath = @allFiles[file]
        ⮐ if not prjPath
        
        delete @allFiles[file]
        
        files = @projects[prjPath]?.files
        if files
            pullIf files (f) -> f == file
        
    @removePath: path ->
        
        if @allFiles[path]
            @removeFile path
            ⮐ 
        
        prefix = path + '/'
        
        for file in Object.keys(@allFiles)
            if file.startsWith prefix
                @removeFile file
        
    @renamePath: oldPath newPath ◯->
        
        if @allFiles[oldPath]
            @removeFile oldPath
            ◯ @addFile newPath
            ⮐ 
        
        prefix = oldPath + '/'
        moved  = []
        
        for file in Object.keys(@allFiles)
            if file.startsWith prefix
                moved.push [file, "#{newPath}#{file.slice(oldPath.length)}"]
        
        for pair in moved
            @removeFile pair[0]
            ◯ @addFile pair[1]
        
    @index: file ◯=>
        
        if not file is str
            error "prjcts.index - expected a string, got" file
            ⮐ 
            
        ⮐ if file.startsWith 'untitled-'
        
        file = slash.absolute file process.cwd()
        
        # log 'prjcts.index ●' file
        
        exists =◯ nfs.exists file
        
        ⮐ if not exists
        
        prjPath =◯ nfs.prj file
        
        # log 'prjcts.index ▪' prjPath
        
        prjPath = null if prjPath == '/'
        
        prjPath ?= slash.dir file
        
        # log 'prjcts.index ▸' prjPath
        
        if @indexing
            ⮐ if @indexing == prjPath
            @queue ?= []
            if prjPath not in @queue
                @queue.push prjPath
            ⮐ 
        
        ⮐ if valid @projects[prjPath]
            
        @indexing = prjPath
        
        walk = new walker
            root:       prjPath
            maxDepth:   config.data.project.maxDepth
            ignore:     config.data.project.ignore
            includeExt: config.data.sourceFileExtensions
            maxFiles:   10000
            # file:     (f) => post.emit 'prjcts.file.indexed' f
                  
        # log 'start walker'
        result =◯ walk.start()
        
        if result
            @projects[prjPath] = dir:prjPath files:result.files
            for file in result.files
                @allFiles[file] = prjPath
                
            # log 'prjcts.index ▪' prjcts.projects

            post.emit 'project.indexed' prjPath
        
        delete @indexing
        
        if valid @queue
            # log 'dequeue' @queue[0]
            ◯ @index @queue.shift()

post.on 'file.change' (info) ◯=>
    
    switch info.change
        'create'
            ◯ prjcts.addFile info.path
        'delete'
            prjcts.removePath info.path
        'rename'
            ◯ prjcts.renamePath info.oldPath info.path
            
export prjcts

