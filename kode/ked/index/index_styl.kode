███  ████  ███  ███   ███  ███        ███ ███         ███          ███      ███ ███   ███      
███  ███ █ ███  ███   ███  ███████     █████          ███████      ███       █████    ███      
███  ███  ████  ███   ███  ███        ███ ███              ███     ███        ███     ███      
███  ███   ███  ███████    ████████  ███   ███        ███████      ███        ███     ███████  
###

use ../../kxk ▪ kermit kstr

class index_styl

    # ████████    ███████   ████████    ███████  ████████       ███      ███  ███   ███  ████████
    # ███   ███  ███   ███  ███   ███  ███       ███            ███      ███  ████  ███  ███
    # ████████   █████████  ███████    ███████   ███████        ███      ███  ███ █ ███  ███████
    # ███        ███   ███  ███   ███       ███  ███            ███      ███  ███  ████  ███
    # ███        ███   ███  ███   ███  ███████   ████████       ███████  ███  ███   ███  ████████
    
    parseLine: index line ->
                
        ⮐  if line.startsWith ' '
            
        if line[0] in "@#."
            if trim(line[1..]).split(/[\s\.\:]/).length == 1
                @result.classes.push name:line[1..] line:index

    # ████████    ███████   ████████    ███████  ████████       █████████  ████████  ███   ███  █████████
    # ███   ███  ███   ███  ███   ███  ███       ███               ███     ███        ███ ███      ███
    # ████████   █████████  ███████    ███████   ███████           ███     ███████     █████       ███
    # ███        ███   ███  ███   ███       ███  ███               ███     ███        ███ ███      ███
    # ███        ███   ███  ███   ███  ███████   ████████          ███     ████████  ███   ███     ███

    parse: text ->
        
        lines = kstr.lines text

        @result = classes:[] funcs:[] lines:lines.length
        
        for line,index in lines
            @parseLine index line

        @result

export index_styl
