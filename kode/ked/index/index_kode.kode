
use ../../kxk ▪ kstr slash
use           ◆ index_utils

stringOrComment = /###[\s\S]*?###|#.*|"""[\s\S]*?"""|"(?:\\.|\#\{[^\}]*}|[^\n\\"])*"|'(?:\\['\\]|[^\n'])*'/g

maskStrings = (text) ->
    text.replace stringOrComment, (m) ->
        ⮐  m if m[0] == '#'
        m.replace /[^\n]/g, ' '

■index_kode

    @: ->
                        
    parse: text ->
        
        lines = kstr.lines text
        codeLines = kstr.lines(maskStrings(text))

        bound = {}
        result = 
            classes: [] 
            funcs:   [] 
            words:   new Set()
            lines:   lines.length
            
        funcStack = []
        currentClass = null
        
        addFuncInfo = funcName funcInfo ->
            
            ⮐  if not funcName
            
            if funcName.length > 1 and funcName.startsWith '@'
                funcName = funcName.slice 1
                funcInfo.static = true
                
            funcInfo.name = funcName
            funcInfo
            
        for line,li in lines

            code = codeLines[li]
            continue if empty trim code # ignore empty lines
        
            indent = line.search /\S/
    
            while funcStack.length and indent <= last(funcStack)[0]
                last(funcStack)[1].last = li - 1
                funcInfo = funcStack.pop()[1]
                result.funcs.push funcInfo 
    
            if currentClass? 
    
                if code.includes('->') or code.includes('=>')
                    
                    if methodName = index_utils.methodNameInLine code
                        unbndIndex = code.indexOf '->'
                        boundIndex = code.indexOf '=>'
                        bound = boundIndex > 0 and (unbndIndex < 0 or boundIndex < unbndIndex)
                        async = code.indexOf('○')>=0

                        funcInfo = 
                            line:   li
                            name:   methodName
                            class:  currentClass
                            async:  async
                            bound:  bound
                            
                        funcStack.push [indent funcInfo]
            else
    
                currentClass = null if indent < 2 
    
                if funcName = index_utils.funcNameInLine code
                    funcInfo = addFuncInfo funcName,
                        line: li
                        async: code.indexOf('○')>=0
    
                    funcStack.push [indent funcInfo]
    
                else if code.includes('post.on')
                    
                    if funcName = index_utils.postNameInLine line
                        funcInfo = addFuncInfo funcName,
                            line: li
                            post: true
        
                        funcStack.push [indent funcInfo]
                    
                else                    
                    m = line.match index_utils.testRegExp
                    if m?[0]?
                        # funcInfo = addFuncInfo m[0].replaceAll('▸ ' ''),
                        funcInfo = addFuncInfo m[0],
                            line: li
                            test: true #m[0].replaceAll('▸ ' '')
                    
                        funcStack.push [indent funcInfo]
    
            if className = index_utils.classNameInLine code

                firstClass  ?= className
                currentClass = className
                
                result.classes.push 
                    name: className
                    line: li
                    
                if base = @base code 
                    result.classes[-1].base = base

            words = code.split index_utils.splitRegExp
            for word in words
                result.words.add word
        
        while funcStack.length
            last(funcStack)[1].last = li - 1   
            funcInfo = funcStack.pop()[1]
            funcInfo.class ?= firstClass
            result.funcs.push funcInfo
            
        result.words = Array.from result.words    
        
        result
        
    base: code =>
        for s in [' extends ' '□']
            splt = code.split s
            if splt.length == 2                
                ⮐ trim splt[1]
    
export index_kode
