SPLITS = ['"' '.' ',' "'"]

class index_js

    @: ->
        
        @classPtn     = @tokenize('class ●name' [])
        @funcClassPtn = @tokenize('●name = (function ()' [])
        
        @classMethodPtns = [
            [@tokenize('●name ○args' SPLITS)               {}]
            [@tokenize('async ●name ○args' SPLITS)         {async:true}]
            [@tokenize('static ●name ○args' SPLITS)        {static:true}]
            [@tokenize('static async ●name ○args' SPLITS)  {static:true async:true}]
        ]
        
        @classBoundPtn = @tokenize('this.●name = this.●bound.bind(this)' SPLITS)
        @funcBoundPtn  = @tokenize("""this["●name"] = this["●bound"].bind(this)""" SPLITS)
        
        @topPtns = [
            [@tokenize('●name = function ○args' SPLITS)        {}]
            [@tokenize('●name = async function ○args' SPLITS)  {async:true}]
        ]
        
        @funcClassName = null
        @funcClassPtns = null

    splitWords: (words splitBy) ->
        
        out = []
        
        for word in words
            parts = word.split splitBy
            for part,idx in parts
                out.push part
                out.push splitBy if idx < parts.length-1
        
        out

    tokenize: (line splits) ->
        
        tokens = trim(line).split /\s+/
        
        for splitBy in splits
            tokens = @splitWords tokens splitBy
        
        tokens

    matchTokens: (tokens ptn) ->
        
        ⮐  if empty tokens
        
        strongMatch = false
        weakMatch = false
        varName = null
        
        ci = 0
        si = 0
        rslt = {}
        
        while ci < ptn.length
            
            cp = ptn[ci]
            
            if cp == tokens[si]
                strongMatch = true
                varName = null
                si++
                ci++
                continue
                
            if cp?[0] in '●○'
                weakMatch = true
                varName = cp[1..]
                switch cp[0]
                    '●' 
                        rslt[varName] = tokens[si]
                        si++
                        ci++
                        continue
                    '○' 
                        if ci == ptn.length-1
                            rslt[varName] = tokens[si..].join ' '
                            ⮐  rslt
                        else
                            if ptn[ci+1] == tokens[si]
                                weakMatch = false
                                ci += 1
                                continue
                
            if weakMatch and varName
                if valid rslt[varName]
                    rslt[varName] += ' ' + tokens[si]
                else
                    rslt[varName] = tokens[si]
                if si < tokens.length-1
                    si++
                    continue
                else
                    break

            ⮐ 
        
        ⮐  if ci < ptn.length
        
        if ci == ptn.length and varName and si < tokens.length
            rslt[varName] += ' ' + tokens[si..].join(' ')
        
        ⮐  rslt if strongMatch or weakMatch

    validFuncName: (name) -> name not in ['if' 'for' 'while' 'switch' 'return' 'catch']
    validFuncArgs: (args) -> args[0] == '(' and args[-1] == ')'
    validFuncMatch: (match) -> match and @validFuncArgs(match.args) and @validFuncName(match.name)

    funcClassPatterns: className ->
        
        if @funcClassName != className
            
            @funcClassName = className
            
            @funcClassPtns = [
                [@tokenize("function #{className} ○args" SPLITS)                                {name:className}]
                [@tokenize("""#{className}["●name"] = function ○args""" SPLITS)                 {static:true}]
                [@tokenize("""#{className}["●name"] = async function ○args""" SPLITS)           {static:true async:true}]
                [@tokenize("""#{className}.prototype["●name"] = function ○args""" SPLITS)       {}]
                [@tokenize("""#{className}.prototype["●name"] = async function ○args""" SPLITS) {async:true}]
            ]
            
        @funcClassPtns

    parseLine: index line ->
        
        t = trim line
        ⮐  if empty t
        
        top = not line.startsWith ' '
        tokens = null
        
        if top
            
            if match = @matchTokens(t.split(/\s+/), @classPtn)
                match.type = 'class'
                match.line = index
                @result.classes.push match
                ⮐ 
                
            if match = @matchTokens(t.split(/\s+/), @funcClassPtn)
                match.type = 'function'
                match.line = index
                @result.classes.push match
                ⮐ 
        
        if @result.classes.length
            
            className = @result.classes[-1].name
            classType = @result.classes[-1].type
            
            if (t.includes('(') and t.endsWith(')')) or t.includes('.bind(this)')
                
                tokens ?= @tokenize t, SPLITS
                
                ptns = classType == 'class' ? @classMethodPtns : @funcClassPatterns(className)
                
                for [ptn opt] in ptns
                    
                    if match = @matchTokens(tokens, ptn)
                        
                        if @validFuncMatch match
                            
                            name = opt.name ? match.name
                            
                            fnc = method:name line:index class:className
                            fnc.static = true if opt.static
                            fnc.async  = true if opt.async
                            fnc.bound  = true if @bound[name] and name != 'constructor'
                            
                            @result.funcs.push fnc
                            ⮐ 
                
                if match = @matchTokens(tokens, classType == 'class' ? @classBoundPtn : @funcBoundPtn)
                    @bound[match.name] = true
        
        if top and t.includes('function') and t.endsWith(')')
            
            tokens ?= @tokenize t, SPLITS
            
            for [ptn opt] in @topPtns
                
                if match = @matchTokens(tokens, ptn)
                    
                    if @validFuncMatch match
                        
                        fnc = name:match.name line:index
                        fnc.async = true if opt.async
                        
                        @result.funcs.push fnc
                        ⮐

    parse: text ->
        
        lines = text.split '\n'

        @bound = {}
        @result = classes:[] funcs:[] lines:lines.length
        
        for lineText,lineIndex in lines
            @parseLine lineIndex lineText
        
        @result

export index_js
