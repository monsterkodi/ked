            e.draw()
        
            h.screen.get_bg 1 0 ▸ theme.novim.yank
            h.screen.get_bg 4 0 ▸ theme.editor.bg
        
            e.state.clearYankFlash()
            e.draw()
        
            h.screen.get_bg 1 0 ▸ theme.editor.bg
            
