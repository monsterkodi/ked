            s.startVisual 'char'
            s.setMainCursor 2 0
            s.updateVisual()
        
            s.executeNovim {operator:'visualYank'}
            s.novim.yankFlash ▸ [[0 0 2 0]]
            s.novim.visual ▸ null
        
            s.clearYankFlash()
            s.novim.yankFlash ▸ null
        
