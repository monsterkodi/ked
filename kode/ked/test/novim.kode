    mode.modes.novim = novim
    mode.start s 'novim'

    key 'v'
    key 'esc'

    s.visual ▸ null
    s.s.selections ▸ []
    mode.isActive s 'novim' ▸ true

    mode.stop s 'novim'
    delete s.allowedModes.novim

