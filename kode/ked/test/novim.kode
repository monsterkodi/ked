▸ keys

    text = """
        alpha beta
        gamma delta
        """

    s.loadLines belt.linesForText(text)

    m = new novim s

    key = c -> m.handleKey c {combo:c, char:c}
    keys = s x y -> 
        for c in s
            key c
        cur x y if x?

    keys 'd2w'
    txt """
        gamma delta
        """

    s.loadLines belt.linesForText(text)
    s.setMainCursor 0 0

    key 'd'
    m.handleKey 'esc' {combo:'esc'}

    txt text
    m.operator ▸ null

    key 'x'

    txt """
        lpha beta
        gamma delta
        """

    s.loadLines belt.linesForText(text)
    s.setMainCursor 0 0

    keys 'dw'
    txt """
        beta
        gamma delta
        """

    key 'u'
    txt text

    s.loadLines belt.linesForText("abc def")
    s.setMainCursor 4 0

    key 'd'
    m.handleKey 'left' {combo:'left'}
    txt "abcdef"

    s.loadLines belt.linesForText("abc def")
    s.setMainCursor 4 0

    key 'd'
    m.handleKey 'right' {combo:'right'}
    txt "abc ef"

    s.loadLines belt.linesForText("abc\ndef\nghi")
    s.setMainCursor 0 1

    key 'd'
    m.handleKey 'down' {combo:'down'}
    txt "abc"

    s.loadLines belt.linesForText("abc\ndef\nghi")
    s.setMainCursor 0 1

    key 'd'
    m.handleKey 'up' {combo:'up'}
    txt "ghi"

    s.loadLines belt.linesForText("alpha")
    s.setMainCursor 3 0

    keys 'dh'
    txt "alha"

    s.loadLines belt.linesForText("alpha")
    s.setMainCursor 0 0

    keys 'dl'
    txt "lpha"

    s.loadLines belt.linesForText("one two three")
    s.setMainCursor 5 0

    keys 'diw'
    txt "one  three"
    m.operator ▸ null

    s.loadLines belt.linesForText('say "hello there" ok')
    s.setMainCursor 7 0

    keys 'da"'
    txt "say ok"

    s.loadLines belt.linesForText("if seg not in ['', undefined, ' ', '}', ']', ')']")
    s.setMainCursor 21 0

    keys 'di['
    txt "if seg not in []"

    s.loadLines belt.linesForText("one two three")
    s.setMainCursor 0 0

    keys 'd2iw'
    txt " three"

    s.loadLines belt.linesForText("abc")

    keys 'di'
    m.handleKey 'esc' {combo:'esc'}
