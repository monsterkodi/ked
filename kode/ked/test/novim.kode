  ▸ reverse search

        nav = new state cells 'revsearch'

        startNovim nav

        nmv       = mode.get nav 'novim'
        press = pressFor nav
        positions = []

        post.on 'novim.search.position' (p) -> positions.push p

        loadTextOn nav "foo\nbar\nfoo\nbar\nfoo" 0 1

        nmv.startSearch true
        nmv.searchChanged 'foo'
        nmv.commitSearch()

        nav.mainCursor() ▸ [0 2]

        nav.setMainCursor 0 1

        nmv.startSearch false
        nmv.searchChanged 'foo'
        nmv.commitSearch()

        nav.mainCursor() ▸ [0 0]

        positions[-1] ▸ {state:'revsearch.state' current:1 total:3}

        nav.setMainCursor 0 4

        press 'n'

        nav.mainCursor() ▸ [0 2]
        positions[-1] ▸ {state:'revsearch.state' current:2 total:3}

        press 'n'

        nav.mainCursor() ▸ [0 0]
        positions[-1] ▸ {state:'revsearch.state' current:1 total:3}

        press 'N'

        nav.mainCursor() ▸ [0 2]
        positions[-1] ▸ {state:'revsearch.state' current:2 total:3}

        nav.setMainCursor 0 0

        nmv.startSearch true
        nmv.searchChanged 'foo'
        nmv.commitSearch()

        nav.mainCursor() ▸ [0 0]
        positions[-1] ▸ {state:'revsearch.state' current:1 total:3}

        stopNovim nav
    
  ▸ ex commands
    
        m = new novim s

        starts = []
        quits  = 0
        saves  = []
        writes = []
        errors = []
    
        clean = -> s.clearHistory()
        dirty = ->
            s.clearHistory()
            s.pushState()
    
        post.on 'novim.ex.start' (start) -> starts.push start
        post.on 'novim.error'    (err)   -> errors.push err
        post.on 'quit'                    -> quits += 1
        post.on 'file.saveAndQuit' (file) -> saves.push file ? null
        post.on 'file.save'        (file) -> writes.push file ? null
    
        clean()
    
        m.runEx 'q'

        s.novim.register.read(':').lines ▸ ['q']

        quits  ▸ 1
        writes ▸ []
        saves  ▸ []
        m.ex   ▸ null
    
        dirty()
    
        m.runEx 'q'
        
        quits ▸ 1
        errors[-1] ▸ 'unsaved changes'
    
        m.runEx 'q!'
    
        quits  ▸ 2
        writes ▸ []
        saves  ▸ []
    
        clean()
    
        m.runEx 'w'
    
        writes ▸ [null]
        saves  ▸ []
        quits  ▸ 2
        m.ex   ▸ null

        m.runEx 'w out.txt'
        writes ▸ [null 'out.txt']

        m.runEx 'wq out.txt'
        saves ▸ ['out.txt']

        m.runEx 'foo'
        errors[-1] ▸ 'not an editor command: foo'

        clean()
        m.startEx()
        starts[-1] ▸ {state:'test.state' text:''}
        m.ex       ▸ ''
        m.cancelEx()
        m.ex       ▸ null

        s.loadLines belt.linesForText("a\nb")
        s.startVisual 'line'
        m.startEx()
        starts[-1] ▸ {state:'test.state' text:"'<,'>"}
        m.cancelEx()
        s.stopVisual()
        s.novim.visual   ▸ null

        m.runEx "'<,'>s/a/b/"
        errors[-1] ▸ 'no visual selection'

