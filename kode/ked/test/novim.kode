▸ change exits novim

    s.loadLines belt.linesForText("one two three")
    s.setMainCursor 5 0

    s.allowedModes.novim = true
    mode.modes.novim = novim
    mode.start s 'novim'

    mode.isActive s 'novim' ▸ true

    s.executeNovim {operator:'change', motion:{kind:'textObject', area:'inner', target:'word', count:1}}

    mode.isActive s 'novim' ▸ false
    txt "one two three"
    s.s.selections ▸ [[4 0 7 0]]
    cur 7 0

    delete s.allowedModes.novim

▸ repeat command

    s.loadLines belt.linesForText("abcdef")
    s.setMainCursor 0 0

    s.executeNovim {operator:'delete', motion:{kind:'char', count:1}}
    txt "bcdef"

    s.executeNovim {operator:'repeat', count:1}
    txt "cdef"

    s.executeNovim {operator:'repeat', count:2}
    txt "ef"

    s.loadLines belt.linesForText("abcdef")
    s.setMainCursor 0 0

    s.executeNovim {operator:'delete', motion:{kind:'char', count:2}}
    txt "cdef"

    s.executeNovim {operator:'repeat', count:1}
    txt "ef"

    s.loadLines belt.linesForText("abcdef")
    s.setMainCursor 0 0

    s.executeNovim {operator:'delete', motion:{kind:'char', count:1}}
    s.executeNovim {operator:'move', motion:{kind:'right', count:1}}
    s.executeNovim {operator:'repeat', count:1}
    txt "bdef"

    s.loadLines belt.linesForText("abcdef")
    s.setMainCursor 0 0

    s.executeNovim {operator:'delete', motion:{kind:'char', count:1}}
    s.executeNovim {operator:'undo', count:1}
    txt "abcdef"

    s.executeNovim {operator:'repeat', count:1}
    txt "bcdef"

    s.loadLines belt.linesForText("one two three")
    s.setMainCursor 0 0

    s.executeNovim {operator:'delete', motion:{kind:'textObject', area:'around', target:'word', count:1}}
    txt "two three"

    s.executeNovim {operator:'repeat', count:1}
    txt "three"

    s.lastChange = null
    s.loadLines belt.linesForText("abc")
    s.setMainCursor 0 0

    s.executeNovim {operator:'repeat', count:1}
    txt "abc"

▸ keys

    text = """
        alpha beta
        gamma delta
        """

    s.loadLines belt.linesForText(text)

    m = new novim s

    key = c -> m.handleKey c {combo:c, char:c}
    keys = s x y -> 
        for c in s
            key c
        cur x y if x?

    keys 'd2w'
    txt """
        gamma delta
        """

    s.loadLines belt.linesForText(text)
    s.setMainCursor 0 0

    key 'd'
    m.handleKey 'esc' {combo:'esc'}

    txt text
    m.operator ▸ null

    key 'x'

    txt """
        lpha beta
        gamma delta
        """

    s.loadLines belt.linesForText(text)
    s.setMainCursor 0 0

    keys 'dw'
    txt """
        beta
        gamma delta
        """

    key 'u'
    txt text

    s.loadLines belt.linesForText("abc def")
    s.setMainCursor 4 0

    key 'd'
    m.handleKey 'left' {combo:'left'}
    txt "abcdef"

    s.loadLines belt.linesForText("abc def")
    s.setMainCursor 4 0

    key 'd'
    m.handleKey 'right' {combo:'right'}
    txt "abc ef"

    s.loadLines belt.linesForText("abc\ndef\nghi")
    s.setMainCursor 0 1

    key 'd'
    m.handleKey 'down' {combo:'down'}
    txt "abc"

    s.loadLines belt.linesForText("abc\ndef\nghi")
    s.setMainCursor 0 1

    key 'd'
    m.handleKey 'up' {combo:'up'}
    txt "ghi"

    s.loadLines belt.linesForText("alpha")
    s.setMainCursor 3 0

    keys 'dh'
    txt "alha"

    s.loadLines belt.linesForText("alpha")
    s.setMainCursor 0 0

    keys 'dl'
    txt "lpha"

    s.loadLines belt.linesForText("one two three")
    s.setMainCursor 5 0

    keys 'diw'
    txt "one  three"
    m.operator ▸ null

    s.loadLines belt.linesForText('say "hello there" ok')
    s.setMainCursor 7 0

    keys 'da"'
    txt "say ok"

    s.loadLines belt.linesForText("if seg not in ['', undefined, ' ', '}', ']', ')']")
    s.setMainCursor 21 0

    keys 'di['
    txt "if seg not in []"

    s.loadLines belt.linesForText("one two three")
    s.setMainCursor 0 0

    keys 'd2iw'
    txt " three"

    s.loadLines belt.linesForText("abc")

    keys 'di'
    m.handleKey 'esc' {combo:'esc'}
    txt "abc"
    m.area ▸ null

    s.loadLines belt.linesForText("abcdef")
    s.setMainCursor 0 0

    key 'x'
    txt "bcdef"

    key '.'
    txt "cdef"

    keys '2.'
    txt "ef"

    s.loadLines belt.linesForText("abcdef")
    s.setMainCursor 0 0

    keys 'xl.'
    txt "bdef"

    s.loadLines belt.linesForText("one two three")
    s.setMainCursor 0 0

    keys 'daw'
    txt "two three"

    key '.'
    txt "three"

    s.loadLines belt.linesForText("one\n  two\n  three")
    s.setMainCursor 0 0
    keys 'gg'   0 0

▸ search highlights

    s.loadLines belt.linesForText("foo\nbar\nfoo\nbar\nfoo")
    s.setMainCursor 0 0

    s.setHighlights [[0 0 3 0] [0 2 3 2] [0 4 3 4]]

    key 'n'
    cur 0 2

    key 'n'
    cur 0 4

    key 'n'
    cur 0 4

    s.setMainCursor 0 4
    key 'N'
    cur 0 2

    key 'N'
    cur 0 0

    s.setMainCursor 0 0

    key '2'
    key 'n'
    cur 0 4

    s.setMainCursor 0 0

    key 'N'
    cur 0 0

    s.setMainCursor 0 0

    key 'n'
    s.s.highlights ▸ [[0 0 3 0] [0 2 3 2] [0 4 3 4]]

    key 'N'
    s.s.highlights ▸ [[0 0 3 0] [0 2 3 2] [0 4 3 4]]

    key 'j'
    s.s.highlights ▸ []

    s.setMainCursor 0 0

    key 'n'
    cur 0 0

    key 'N'
    cur 0 0

    s.loadLines belt.linesForText("foo\nbar")
    s.setMainCursor 0 0

    key '/'
    txt "foo\nbar"

▸ brckts lets novim handle text keys

    stack = new state cells 'stack'

    mode.modes.novim  = novim
    mode.modes.brckts = brckts
    mode.start stack 'brckts'
    mode.start stack 'novim'

    press = c -> mode.handleKey stack c {combo:c, char:c}
    stxt  = t -> kseg.str(stack.s.lines) ▸ t

    onKeys = (text x y keys) ->
        stack.loadLines belt.linesForText(text)
        stack.setMainCursor x y
        mode.stop  stack 'novim'
        mode.start stack 'novim'
        for c in keys
            press c

    onKeys 'say "hello there" ok' 4 0 ['d' 'i' '"']
    stxt 'say "" ok'

    onKeys 'say "hello there" ok' 16 0 ['d' 'i' '"']
    stxt 'say "" ok'

    onKeys "a 'b c' d" 2 0 ['d' 'i' "'"]
    stxt "a '' d"

    onKeys "a 'b c' d" 6 0 ['d' 'i' "'"]
    stxt "a '' d"

    onKeys 'call(x)' 6 0 ['d' 'i' ')']
    stxt 'call()'

    onKeys 'a [b] c' 4 0 ['d' 'a' ']']
    stxt 'a  c'

    onKeys 'a {b} c' 4 0 ['d' 'a' '}']
    stxt 'a  c'

    mode.stop stack 'novim'
    mode.stop stack 'brckts'

▸ brckts still types without novim

    plain = new state cells 'plain'

    mode.modes.brckts = brckts
    mode.start plain 'brckts'

    pkey = c -> mode.handleKey plain c {combo:c, char:c}

    plain.loadLines belt.linesForText('say "hi" ok')
    plain.setMainCursor 4 0
    pkey '"'

    plain.mainCursor() ▸ [5 0]
    kseg.str(plain.s.lines) ▸ 'say "hi" ok'

    plain.loadLines belt.linesForText('x = ')
    plain.setMainCursor 4 0
    pkey '"'

    plain.mainCursor() ▸ [5 0]
    kseg.str(plain.s.lines) ▸ 'x = ""'

    mode.stop plain 'brckts'
