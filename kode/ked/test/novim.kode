▸ ex commands

    m = new novim s

    key   = c -> m.handleKey c {combo:c, char:c}
    keys  = t ->
        for c in t
            key c
    enter = -> m.handleKey 'return'    {combo:'return', char:'\n'}
    back  = -> m.handleKey 'backspace' {combo:'backspace'}
    esc   = -> m.handleKey 'esc'       {combo:'esc', char:''}

    quits  = 0
    saves  = []
    writes = []
    titles = []
    capture = true

    clean = -> s.clearHistory()
    dirty = ->
        s.clearHistory()
        s.pushState()

    post.on 'quit'                    -> quits += 1
    post.on 'file.saveAndQuit' (file) -> saves.push file ? null
    post.on 'file.save'        (file) -> writes.push file ? null
    post.on 'title.novim'      (t)    -> titles.push t if capture

    clean()

    # :q quits when there is nothing to lose

    keys ':q'

    m.ex        ▸ 'q'
    titles[-1]  ▸ ':q'

    enter()

    quits  ▸ 1
    writes ▸ []
    saves  ▸ []
    m.ex   ▸ null

    # :q refuses to throw away a changed buffer

    dirty()

    keys ':q'
    enter()

    quits      ▸ 1
    titles[-1] ▸ 'E37: No write since last change (add ! to override)'

    # :q! quits anyway

    keys ':q!'

    m.ex        ▸ 'q!'
    titles[-1]  ▸ ':q!'

    enter()

    quits  ▸ 2
    writes ▸ []
    saves  ▸ []

    # commands that take no argument reject one

    before = quits

    keys ':q now'
    enter()

    quits      ▸ before
    titles[-1] ▸ 'E488: Trailing characters: now'

    keys ':wa now'
    enter()

    titles[-1] ▸ 'E488: Trailing characters: now'

    # a pending count does not leak into the ex command

    keys '3:q'

    m.ex       ▸ 'q'
    titles[-1] ▸ ':q'

    esc()

    m.ex ▸ null

    # backspace edits the ex line

    keys ':wqq'
    back()

    m.ex ▸ 'wq'

    esc()

    m.ex ▸ null

    # :w writes without quitting

    clean()

    keys ':w'
    enter()

    writes ▸ [null]
    saves  ▸ []
    quits  ▸ 2
    m.ex   ▸ null

    # :w file writes to the given file

    keys ':w /tmp/ked-w.txt'
    enter()

    writes ▸ [null '/tmp/ked-w.txt']

    # :w! writes the same way

    keys ':w! /tmp/ked-w.txt'
    enter()

    writes ▸ [null '/tmp/ked-w.txt' '/tmp/ked-w.txt']

    # spaces around the argument are dropped

    keys ':w   /tmp/ked-space.txt   '
    enter()

    writes[-1] ▸ '/tmp/ked-space.txt'

    # a leading ! would be a shell command, which is not supported

    before = writes.length

    keys ':w !ls'
    enter()

    writes.length ▸ before
    titles[-1]    ▸ 'E492: shell commands are not supported'

    before = saves.length

    keys ':wq !ls'
    enter()

    saves.length ▸ before
    titles[-1]   ▸ 'E492: shell commands are not supported'

    # :wq writes and quits

    keys ':wq'
    enter()

    saves ▸ [null]

    keys ':wq /tmp/ked-wq.txt'
    enter()

    saves ▸ [null '/tmp/ked-wq.txt']

    keys ':wq! /tmp/ked-wq.txt'
    enter()

    saves ▸ [null '/tmp/ked-wq.txt' '/tmp/ked-wq.txt']

    # :x quits a clean buffer without writing

    clean()
    before = writes.length

    keys ':x'
    enter()

    quits         ▸ 3
    writes.length ▸ before

    # :x writes a changed buffer and quits

    dirty()

    keys ':x'
    enter()

    saves[-1] ▸ null

    # :x file writes the changed buffer to the file

    dirty()

    keys ':x /tmp/ked-x.txt'
    enter()

    saves[-1] ▸ '/tmp/ked-x.txt'

    # :x! writes the same way

    dirty()

    keys ':x! /tmp/ked-x.txt'
    enter()

    saves[-1] ▸ '/tmp/ked-x.txt'

    # :wa writes nothing when nothing changed

    clean()
    before = writes.length

    keys ':wa'
    enter()

    writes.length ▸ before

    # :wa writes the changed buffer

    dirty()

    keys ':wa'
    enter()

    writes[-1] ▸ null

    clean()

    # an empty ex line does nothing

    keys ':'
    enter()

    m.ex ▸ null

    # unknown commands are reported

    keys ':nope'
    enter()

    titles[-1] ▸ 'E492: nope'
    m.ex      ▸ null

    # a pending operator keeps ':' from starting an ex command

    key 'd'
    key ':'

    m.operator ▸ null
    m.ex       ▸ null

    capture = false

▸ brckts lets novim handle text keys

    stack = new state cells 'stack'

    mode.modes.novim  = novim
    mode.modes.brckts = brckts
    mode.start stack 'brckts'
    mode.start stack 'novim'

    press = c -> mode.handleKey stack c {combo:c, char:c}
    stxt  = t -> kseg.str(stack.s.lines) ▸ t

    onKeys = (text x y keys) ->
        stack.loadLines belt.linesForText(text)
        stack.setMainCursor x y
        mode.stop  stack 'novim'
        mode.start stack 'novim'
        for c in keys
            press c

    onKeys 'say "hello there" ok' 4 0 ['d' 'i' '"']
    stxt 'say "" ok'

    onKeys 'say "hello there" ok' 16 0 ['d' 'i' '"']
    stxt 'say "" ok'

    onKeys "a 'b c' d" 2 0 ['d' 'i' "'"]
    stxt "a '' d"

    onKeys "a 'b c' d" 6 0 ['d' 'i' "'"]
    stxt "a '' d"

    onKeys 'call(x)' 6 0 ['d' 'i' ')']
    stxt 'call()'

    onKeys 'a [b] c' 4 0 ['d' 'a' ']']
    stxt 'a  c'

    onKeys 'a {b} c' 4 0 ['d' 'a' '}']
    stxt 'a  c'

    mode.stop stack 'novim'
    mode.stop stack 'brckts'

▸ brckts still types without novim

    plain = new state cells 'plain'

    mode.modes.brckts = brckts
    mode.start plain 'brckts'

    pkey = c -> mode.handleKey plain c {combo:c, char:c}

    plain.loadLines belt.linesForText('say "hi" ok')
    plain.setMainCursor 4 0
    pkey '"'

    plain.mainCursor() ▸ [5 0]
    kseg.str(plain.s.lines) ▸ 'say "hi" ok'

    plain.loadLines belt.linesForText('x = ')
    plain.setMainCursor 4 0
    pkey '"'

    plain.mainCursor() ▸ [5 0]
    kseg.str(plain.s.lines) ▸ 'x = ""'

    mode.stop plain 'brckts'
