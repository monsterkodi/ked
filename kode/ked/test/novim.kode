    ▸ yank motions
        
            loadText "one two three\nfour five"
        
            enc {operator:'yank', motion:{kind:'word', count:1}} ▸ [0 0]
            s.novim.register.value.lines ▸ ['one ']
            s.novim.register.value.linewise ▸ false
        
            s.setMainCursor 8 0
            enc {operator:'yank', motion:{kind:'drow', count:1}} ▸ [4 0]
            s.novim.register.value.lines ▸ ['two ']
        
            loadText "alpha\nbeta\ngamma" 3 1
        
            enc {operator:'yank', motion:{kind:'line', count:1}} ▸ [3 1]
            s.novim.register.value.lines ▸ ['beta']
            s.novim.register.value.linewise ▸ true
        
            s.executeNovim {operator:'yank', motion:{kind:'lineDown', count:1}}
            s.novim.register.value.lines ▸ ['beta' 'gamma']
        
            history = s.h.length
            ent {operator:'yank', motion:{kind:'word', count:1}} ▸ "alpha\nbeta\ngamma"
            s.h.length ▸ history
        
    ▸ yank flash
        
            loadText "one two three\nfour five"
        
