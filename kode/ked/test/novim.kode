        loadTextOn b "one\ntwo"

        b.executeNovim {operator:'yank', motion:{kind:'line', count:1}}
        b.executeNovim {operator:'delete', motion:{kind:'line', count:1}, register:'_'}

        kseg.str(b.s.lines)          ▸ 'two'
        b.novim.register.value.lines        ▸ ['one']
        b.novim.register.read('1')   ▸ undefined

  ▸ macros

        oldConfig = config.data
        config.data = { novim: { autoEnableOnEscape: true } }

        h = new harness cols:55 rows:66
        e = new editor h.screen 'macro_keys_editor' []

        mac = e.state
        e.grabFocus()

        mac.allowedModes.novim = true
        startNovim mac

        feed = chars -> for c in chars ➜ e.onKey c {combo:c, char: (c == 'esc' ? null : c)}
        mtxt = -> kseg.str mac.s.lines

        loadTextOn mac "one\ntwo"

        feed ['q' 'a' 'x' 'q']

        mac.novim.register.read('a').keys.length ▸ 1
        mtxt() ▸ "ne\ntwo"

        feed ['@' 'a']

        mtxt() ▸ "e\ntwo"

        feed ['@' '@']

        mtxt() ▸ "\ntwo"

        loadTextOn mac "abcdef"

        feed ['3' '@' 'a']

        mtxt() ▸ "def"

        loadTextOn mac "one\ntwo"

        feed ['q' 'b' 'A' '!' 'esc' 'j' 'q']

        mtxt() ▸ "one!\ntwo"

        feed ['@' 'b']

        mtxt() ▸ "one!\ntwo!"

        loadTextOn mac "abc"

        feed ['"' 'b' 'p']

        mtxt() ▸ "A!<Esc>jabc"

        loadTextOn mac "abc"

        feed ['q' 'c' 'x' 'q']
        feed ['q' 'C' 'l' 'q']

        mac.novim.register.read('c').keys.length ▸ 2

        feed ['q' 'd' '@' 'a' 'q']

        mac.novim.register.read('d').keys.length ▸ 2

        loadTextOn mac "a\nb\nc"

        mode.get(mac, 'novim').runEx 'd'

        feed ['@' ':']

        mtxt() ▸ "c"

        loadTextOn mac "abc"

        mac.novim.register.write 'e' { lines: ['x'], linewise: false } 'yank'

        feed ['@' 'e']

        mtxt() ▸ "bc"

        macroErrors = []
        post.on 'novim.error' (err) -> macroErrors.push err

        feed ['@' 'z']
        
        macroErrors[-1]    ▸ 'register z is empty'

        feed ['q' ':']

        macroErrors[-1]    ▸ 'command-line window not implemented'
        valid mac.macroRecording ▸ false

        stopNovim mac
        config.data = oldConfig

  ▸ clipboard registers
    
        copies = []
        savedCopy  = clip.copy
        savedPaste = clip.paste
        savedTool  = clip.tool
        pasted     = ''
    
        clip.tool  = 'wl'
        clip.copy  = (text) -> copies.push text
        clip.paste = -> pasted
    
        novim.clipboardSync = null
    
        global.ked_screen = {}
        novim.isHeadless() ▸ false
        novim.clipboardEnabled() ▸ true
        global.ked_screen = undefined
    
        novim.isHeadless() ▸ true
        novim.clipboardEnabled() ▸ false
    
        loadText "one\ntwo"
    
        s.executeNovim {operator:'yank', motion:{kind:'line', count:1}}
        copies ▸ []
    
        ent {operator:'put', after:true} ▸ "one\none\ntwo"
    
        novim.toggleClipboard() ▸ true
        novim.clipboardEnabled() ▸ true
    
        loadText "one\ntwo"
        s.executeNovim {operator:'yank', motion:{kind:'line', count:1}}
        copies ▸ ['one\n']
    
        pasted = "shared\n"
        ent {operator:'put', after:true} ▸ "one\nshared\ntwo"
    
        pasted = "XYZ"
        loadText "abc" 1 0
        ent {operator:'put', after:true} ▸ "aXYZbc"
    
        loadText "gone\nkept"
        s.executeNovim {operator:'delete', motion:{kind:'line', count:1}}
        copies[-1] ▸ 'gone\n'
    
        novim.clipboardSync = false
        novim.clipboardEnabled() ▸ false
    
        loadText "alpha\nbeta"
    
        s.executeNovim {operator:'yank', motion:{kind:'line', count:1}, register:'clipboard'}
        copies[-1] ▸ 'alpha\n'
        s.novim.register.value.linewise ▸ true
    
        pasted = "plus\n"
        s.executeNovim {operator:'put', after:true, register:'clipboard'}
        txt "alpha\nplus\nbeta"
    
        pasted = "star"
        loadText "ab"
        s.executeNovim {operator:'put', after:true, register:'clipboard'}
        txt "starab"
    
        loadText "abc"
        s.executeNovim {operator:'delete', motion:{kind:'char', count:1}}
        s.novim.register.value.lines ▸ ['a']
    
        [m key keys] = novimKeysFor s
    
        loadText "one\ntwo"
    
        keys '"+yy'
        copies[-1] ▸ 'one\n'
        s.novim.register.value.lines ▸ ['one']
    
        keys '"*yy'
        copies[-1] ▸ 'one\n'
    
        before = copies.length
        keys '""yy'
        copies.length ▸ before
    
        loadText "one\ntwo"
        key '"'
        m.handleKey 'esc' {combo:'esc'}
        key 'x'
        txt "ne\ntwo"
    
        clip.tool = 'none'
        clip.text = ''
    
        loadText "fall\nback"
        s.executeNovim {operator:'yank', motion:{kind:'line', count:1}, register:'clipboard'}
        clip.text ▸ 'fall\n'
    
        loadText "fall\nback"
        ent {operator:'put', after:true, register:'clipboard'} ▸ "fall\nfall\nback"
    
        clip.tool  = 'wl'
        novim.clipboardSync = null
        clip.copy  = savedCopy
        clip.paste = savedPaste
        clip.tool  = savedTool
    
