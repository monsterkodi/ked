        starts[-1]     ▸ {state:'test.state' text:'foo'}
        novim.lastVind ▸ 'foo'
        s.s.highlights ▸ [[0 0 3] [8 0 11] [0 1 3] [7 1 10]]

        sm.searchChanged 'bar'
        novim.lastVind ▸ 'bar'
        s.novim.register.read('/').lines ▸ ['bar']
        s.s.highlights ▸ [[4 0 7] [3 1 6]]

        sm.searchChanged ''
        novim.lastVind ▸ ''
        s.s.highlights ▸ []

        sm.searchChanged 'foo'
        sm.cancelSearch()
        s.s.highlights ▸ []

        novim.lastVind = ''

        loadText "foo bar" 1 0

        sm.startSearch()

        cur 0 0
        novim.lastVind ▸ 'foo'

        s.setMainCursor 6 0

        sm.startSearch()

        cur 4 0
        novim.lastVind ▸ 'bar'

        s.setSelections [[4 0 7 0]]
        s.setMainCursor 5 0

        sm.startSearch()

        cur 4 0
        novim.lastVind ▸ 'bar'

        s.setSelections []

        loadText "foo bar foo" 2 0

        sm.searchChanged 'foo'
        sm.commitSearch()

        cur 8 0

        s.setMainCursor 8 0
        sm.commitSearch()

        cur 8 0

        s.setMainCursor 11 0
        sm.commitSearch()

        cur 0 0

        novim.lastVind = ''

  ▸ search highlights survive navigation

        nav = new state cells 'searchnav'

        mode.modes.brckts = brckts
        mode.start nav 'brckts'
        startNovim nav

        loadTextOn nav "foo bar foo\nfoobar"

        nmv = mode.get nav 'novim'
        nmv.startSearch()
        nmv.searchChanged 'bar'

        nav.s.highlights ▸ [[4 0 7] [3 1 6]]

        press = pressFor nav

        press 'n'

        nav.mainCursor()   ▸ [4 0]
        nav.s.highlights   ▸ [[4 0 7] [3 1 6]]

        press 'n'

        nav.mainCursor()   ▸ [3 1]
        nav.s.highlights   ▸ [[4 0 7] [3 1 6]]

        nav.setMainCursor 0 0
        press 'j'

        nav.s.highlights   ▸ []

        press 'n'

        nav.s.highlights   ▸ [[4 0 7] [3 1 6]]

        stopNovim nav
        mode.stop nav 'brckts'

  ▸ brckts lets novim handle text keys
    
        stack = new state cells 'stack'
    
        mode.modes.brckts = brckts
        mode.start stack 'brckts'
        startNovim stack
    
        press = pressFor stack
        stxt  = t -> kseg.str(stack.s.lines) ▸ t
    
        onKeys = (text x y keys) ->
            loadTextOn stack text x y
            stopNovim stack
            startNovim stack
            for c in keys
                press c
    
        onKeys 'say "hello there" ok' 4 0 ['d' 'i' '"']
        stxt 'say "" ok'
    
        onKeys 'say "hello there" ok' 16 0 ['d' 'i' '"']
        stxt 'say "" ok'
    
        onKeys "a 'b c' d" 2 0 ['d' 'i' "'"]
        stxt "a '' d"
    
        onKeys "a 'b c' d" 6 0 ['d' 'i' "'"]
        stxt "a '' d"
    
        onKeys 'call(x)' 6 0 ['d' 'i' ')']
        stxt 'call()'
    
        onKeys 'a [b] c' 4 0 ['d' 'a' ']']
        stxt 'a  c'
    
        onKeys 'a {b} c' 4 0 ['d' 'a' '}']
        stxt 'a  c'
    
        stopNovim stack
        mode.stop stack 'brckts'
    
  ▸ brckts still types without novim
    
        plain = new state cells 'plain'
    
        mode.modes.brckts = brckts
        mode.start plain 'brckts'
    
        pkey = pressFor plain
    
        loadTextOn plain 'say "hi" ok' 4 0
        pkey '"'
    
        plain.mainCursor() ▸ [5 0]
        kseg.str(plain.s.lines) ▸ 'say "hi" ok'
    
        loadTextOn plain 'x = ' 4 0
        pkey '"'
    
        plain.mainCursor() ▸ [5 0]
        kseg.str(plain.s.lines) ▸ 'x = ""'
    
        mode.stop plain 'brckts'
    
▸ novim window motions

  ▸ H M L

        s = windowSetup 'novimwindow_hml'

        top    = s.lineAtRow 0
        mid    = s.lineAtRow int((s.cells.rows-1)/2)
        bottom = s.lineAtRow s.cells.rows-1

        windowPress s 'H'
        s.mainCursor() ▸ [2 top]

        windowReset s

        windowPress s 'M'
        s.mainCursor() ▸ [2 mid]

        windowReset s

        windowPress s 'L'
        s.mainCursor() ▸ [2 bottom]

        windowReset s

        windowPress s '3'
        windowPress s 'H'
        s.mainCursor() ▸ [2 top+2]

        windowReset s

        windowPress s '3'
        windowPress s 'L'
        s.mainCursor() ▸ [2 bottom-2]

        windowReset s

        windowPress s '2'
        windowPress s 'M'
        s.mainCursor() ▸ [2 mid]

        windowReset s

        windowPress s 'L'
        windowPress s 'ctrl+o'
        s.mainCursor() ▸ [0 8]

        done s

  ▸ dH dL

        s = windowSetup 'novimwindow_dh'

        windowPress s 'd'
        windowPress s 'H'

        s.s.lines.length ▸ 21
        kseg.str(s.s.lines[0]) ▸ '  9'

        done s

        s = windowSetup 'novimwindow_dl'

        windowPress s 'd'
        windowPress s 'L'

        s.s.lines.length ▸ 18
        kseg.str(s.s.lines[8]) ▸ '  20'

        done s
