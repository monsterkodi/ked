
use ../edit        ◆ editor
use ../view/screen ◆ ttio
use ../util        ◆ harness

▸ ttio

  ▸ a headless ttio has no cells

        t = new ttio headless:true input:false
        t.cellsz ▸ []

  ▸ a synchronized update can bracket a frame

        t = new ttio headless:true input:false

        t.syncStart()
        t.syncEnd()

        t.written() ▸ '\x1b[?2026h\x1b[?2026l'

  ▸ a csi sequence ends with its final byte

        t = new ttio headless:true input:false

        seqs = t.parseData Buffer.from('\x1b[B\r')

        seqs.length ▸ 2
        seqs[0].csi ▸ 'B'
        seqs[1].raw ▸ '\r'

  ▸ a sequence that is not a csi one ends where the next escape is

        seqs = t.parseData Buffer.from('\x1bOP\x1b[B')

        seqs.length ▸ 2
        seqs[0].esc ▸ 'OP'
        seqs[1].csi ▸ 'B'

  ▸ an image placement is sent only once per frame

        t = new ttio headless:true input:false
        t.cellsz = [10 20]
        img = {id:42}

        t.placeImg img 1 2 null null null null 1000
        t.placeImg img 1 2 null null null null 1000

        (t.written().split('a=p').length - 1) ▸ 1

  ▸ a hidden image placement can be shown again

        t = new ttio headless:true input:false
        t.cellsz = [10 20]
        img = {id:42}

        t.placeImg img 1 2 null null null null 1000
        t.hideImg img.id img.pid
        t.showImg img.id img.pid

        (t.written().split('a=p').length - 1) ▸ 2
        t.written().includes("a=p,i=42,p=1,X=0,Y=0,w=10,h=20,z=1000,C=1") ▸ true

  ▸ a hidden image stays hidden when placed again

        t = new ttio headless:true input:false
        t.cellsz = [10 20]
        img = {id:42}

        t.placeImg img 1 2 null null null null 1000
        t.hideImg img.id img.pid

        t.removeImgs()
        t.placeImg img 1 2 null null null null 1000

        (t.written().split('a=p').length - 1) ▸ 1

  ▸ a hidden image stays hidden when placed again in the same frame

        t = new ttio headless:true input:false
        t.cellsz = [10 20]
        img = {id:42}

        t.placeImg img 1 2 null null null null 1000
        t.hideImg img.id img.pid
        t.placeImg img 1 2 null null null null 1000

        (t.written().split('a=p').length - 1) ▸ 1

  ▸ an image removed while hidden is not shown again

        t = new ttio headless:true input:false
        t.cellsz = [10 20]
        img = {id:42}

        t.placeImg img 1 2 null null null null 1000
        t.hideImg img.id img.pid

        t.removeImgs()
        t.removeImgs()

        t.out = []
        t.showImg img.id img.pid

        t.written().includes('a=p') ▸ false

  ▸ a cursor hidden under an erasure is shown when the erasure is gone

        h = new harness cols:40 rows:12
        h.t.cellsz = [10 20]

        e = new editor h.screen 'test_show_cursors' []
        e.layout 0 0 40 12
        e.state.loadLines ['abc']
        e.state.setCursors [[0 0]]

        img = {id:42}
        h.t.placeImg img 0 0 null null null null 666
        h.t.hideImg img.id img.pid

        e.cursorIds = {}
        e.cursorIds[0] = [img.id img.pid]

        h.t.out = []
        e.showCursorsOutsideRects []

        (h.t.written().split('a=p').length - 1) ▸ 1

  ▸ a cursor hidden under an erasure stays hidden while it exists

        h = new harness cols:40 rows:12
        h.t.cellsz = [10 20]

        e = new editor h.screen 'test_show_cursors' []
        e.layout 0 0 40 12
        e.state.loadLines ['abc']
        e.state.setCursors [[0 0]]

        img = {id:42}
        h.t.placeImg img 0 0 null null null null 666
        h.t.hideImg img.id img.pid

        e.cursorIds = {}
        e.cursorIds[0] = [img.id img.pid]

        h.t.out = []
        e.showCursorsOutsideRects [[0 0 39 11]]

        h.t.written().includes('a=p') ▸ false

  ▸ the keys of a chunk are keys of their own

        keys = []

        t.on 'key' (combo) -> keys.push combo

        t.onData Buffer.from('\x1b[B\x1b[B\r')

        keys ▸ ['down' 'down' 'return']

  ▸ a mouse press in a chunk is a mouse event

        t = new ttio headless:true input:false
        t.cellsz = [10 20]
        clicks = []

        t.on 'mouse' (event) -> clicks.push event

        t.onData Buffer.from('\x1b[<0;100;80M')

        clicks.length     ▸ 1
        clicks[0].type    ▸ 'press'
        clicks[0].button  ▸ 'left'
        clicks[0].cell    ▸ [10 4]

  ▸ a bracketed paste in one chunk is pasted

        t = new ttio headless:true input:false
        pasted = []
        keys = []

        t.on 'paste' (text) -> pasted.push text
        t.on 'key'   (combo) -> keys.push combo

        t.onData Buffer.from('\x1b[200~■\x1b[201~' 'utf8')

        pasted ▸ ['■']
        keys   ▸ []

  ▸ a bracketed paste with unicode and text is pasted as text

        t = new ttio headless:true input:false
        pasted = []
        keys = []

        t.on 'paste' (text) -> pasted.push text
        t.on 'key'   (combo) -> keys.push combo

        t.onData Buffer.from('\x1b[200~a■b\x1b[201~' 'utf8')

        pasted ▸ ['a■b']
        keys   ▸ []

  ▸ a bracketed paste arriving in parts is pasted when it ends

        t = new ttio headless:true input:false
        pasted = []

        t.on 'paste' (text) -> pasted.push text

        t.onData Buffer.from('\x1b[200~a' 'utf8')
        t.onData Buffer.from('■b\x1b[20' 'utf8')

        pasted ▸ []

        t.onData Buffer.from('1~' 'utf8')

        pasted ▸ ['a■b']

  ▸ input after a bracketed paste is still handled

        t = new ttio headless:true input:false
        pasted = []
        keys = []

        t.on 'paste' (text) -> pasted.push text
        t.on 'key'   (combo) -> keys.push combo

        t.onData Buffer.from('\x1b[200~■\x1b[201~\x1b[B' 'utf8')

        pasted ▸ ['■']
        keys   ▸ ['down']

  ▸ an escape before a printable character is alt and that character

        t = new ttio headless:true input:false

        event = t.parseEsc 'c'

        event.combo ▸ 'alt+c'
        event.key   ▸ 'c'
        event.char  ▸ 'c'

  ▸ an escape before punctuation is alt and the punctuation

        t = new ttio headless:true input:false

        t.parseEsc(',').combo ▸ 'alt+,'

  ▸ an escape before an uppercase character is alt shift and that character

        t = new ttio headless:true input:false

        event = t.parseEsc 'C'

        event.combo ▸ 'alt+shift+c'
        event.char  ▸ 'C'

  ▸ an escape before the end of a graphics message is still no key

        t = new ttio headless:true input:false

        t.parseEsc('\\') ▸ undefined
