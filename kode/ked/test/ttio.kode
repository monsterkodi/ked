
use ../edit        ◆ editor
use ../view/screen ◆ ttio
use ../util        ◆ harness keyscript

pasteKeys = (chunks) ->

    t = new ttio headless:true input:false
    pastes = 0
    keys = []

    t.on 'paste' -> pastes += 1
    t.on 'key' (combo event) -> keys.push [combo event.char]

    for chunk in chunks
        t.onData Buffer.from(chunk 'utf8')

    ⮐ { pastes: pastes  keys: keys }

▸ ttio

  ▸ headless

        t = new ttio headless:true input:false
        t.cellsz ▸ []
        t.syncStart()
        t.syncEnd()
        t.written() ▸ '\x1b[?2026h\x1b[?2026l'

        seqs = t.parseData Buffer.from('\x1b[B\r')
        seqs.length ▸ 2
        seqs[0].csi ▸ 'B'
        seqs[1].raw ▸ '\r'

        seqs = t.parseData Buffer.from('\x1bOP\x1b[B')
        seqs.length ▸ 2
        seqs[0].esc ▸ 'OP'
        seqs[1].csi ▸ 'B'

  ▸ hide and show images

        t = new ttio headless:true input:false
        t.cellsz = [10 20]

        img = {id:41}

        t.placeImg img 1 2 null null null null 1000
        t.placeImg img 1 2 null null null null 1000

        (t.written().split('a=p').length - 1) ▸ 1

        img = {id:42}

        t.placeImg img 1 2 null null null null 1000
        t.hideImg img.id img.pid
        t.showImg img.id img.pid

        (t.written().split('a=p').length - 1) ▸ 3
        t.written().includes("a=p,i=42,p=1,X=0,Y=0,w=10,h=20,z=1000,C=1") ▸ true

        img = {id:43}

        t.placeImg img 1 2 null null null null 1000
        t.hideImg img.id img.pid

        t.removeImgs()
        t.placeImg img 1 2 null null null null 1000

        (t.written().split('a=p').length - 1) ▸ 4

        img = {id:44}

        t.placeImg img 1 2 null null null null 1000
        t.hideImg img.id img.pid
        t.placeImg img 1 2 null null null null 1000

        (t.written().split('a=p').length - 1) ▸ 5

        img = {id:45}

        t.placeImg img 1 2 null null null null 1000
        t.hideImg img.id img.pid

        t.removeImgs()
        t.removeImgs()

        t.out = []
        t.showImg img.id img.pid

        t.written().includes('a=p') ▸ false

  ▸ cursor images

        h = new harness cols:40 rows:12
        h.t.cellsz = [10 20]

        e = new editor h.screen 'test_show_cursors' []
        e.layout 0 0 40 12
        e.state.loadLines ['abc']
        e.state.setCursors [[0 0]]

        img = {id:42}
        h.t.placeImg img 0 0 null null null null 666
        h.t.hideImg img.id img.pid

        e.cursorIds = {}
        e.cursorIds[0] = [img.id img.pid]

        h.t.out = []
        e.showCursorsOutsideRects []

        (h.t.written().split('a=p').length - 1) ▸ 1

        img = {id:42}
        h.t.placeImg img 0 0 null null null null 666
        h.t.hideImg img.id img.pid

        e.cursorIds = {}
        e.cursorIds[0] = [img.id img.pid]

        h.t.out = []
        e.showCursorsOutsideRects [[0 0 39 11]]

        h.t.written().includes('a=p') ▸ false

        h.t.removeImgs()
        h.t.headless = false

        live = 0
        maxLive = 0

        h.t.write = (str) ->
            h.t.out.push str
            live = 0
            for idpl,args of h.t.plargs
                live += 1 if args[6] == 666
            maxLive = max maxLive live

        e.state.loadLines ['abcdefghijabcdefghijabcdefghijabcdefghij']
        e.state.setCursors [[0 0]]

        frame = ->
            erases = h.screen.eraseRects
            e.draw()
            h.screen.render()
            h.t.removeImgs()
            e.showCursorsOutsideRects erases

        frame()

        maxLive ▸ 1

        e.state.setCursors [[1 0]]

        frame()

        maxLive ▸ 1

  ▸ overlay colors

        t = new ttio headless:true input:false
        t.cellsz = [10 20]

        t.placeImageOverlay 1 0 0 0 10 20
        t.placeCellRectOverlay 2 0 0 0 10 20

        (t.overlayID != t.cellRectOverlayID) ▸ true

        written = t.written()

        written.includes("a=p,i=#{t.overlayID},p=1") ▸ true
        written.includes("a=p,i=#{t.cellRectOverlayID},p=2") ▸ true

  ▸ keys

        t = new ttio headless:true input:false
        keys = []

        t.on 'key' (combo event) -> keys.push [combo event.char]

        for ch in ['a' 'b' ' ' '!']
            t.onData Buffer.from(ch)

        keys ▸ [['a' 'a'] ['b' 'b'] [' ' ' '] ['!' '!']]

        keys = []
        t.onData Buffer.from('\x1b[B\x1b[B\r')

        keys ▸ [['down' ''] ['down' ''] ['return' '\n']]

        keys = []
        for ch in ['A' 'b']
            t.onData Buffer.from(ch)

        keys ▸ [['shift+a' 'A'] ['b' 'b']]

        keys = []
        t.onData Buffer.from('\x1b[104;1u')
        t.onData Buffer.from('\x1b[105u')

        keys ▸ [['h' 'h'] ['i' 'i']]

  ▸ mouse event

        t = new ttio headless:true input:false
        t.cellsz = [10 20]
        clicks = []

        t.on 'mouse' (event) -> clicks.push event

        t.onData Buffer.from('\x1b[<0;100;80M')

        clicks.length     ▸ 1
        clicks[0].type    ▸ 'press'
        clicks[0].button  ▸ 'left'
        clicks[0].cell    ▸ [10 4]

  ▸ terminal paste

        pasteKeys ['\x1b[200~■\x1b[201~']                    ▸ pastes:1 keys:[]
        pasteKeys ['\x1b[200~a■b\x1b[201~']                  ▸ pastes:1 keys:[]
        pasteKeys ['\x1b[200~a' '■b\x1b[20' '1~']            ▸ pastes:1 keys:[]
        pasteKeys ['\x1b[200~■\x1b[201~\x1b[B']              ▸ pastes:1 keys:[['down' '']]
        pasteKeys ['\x1b[200~a\x1b[201~\x1b[200~b\x1b[201~'] ▸ pastes:2 keys:[]
        pasteKeys ['\x1b[200~a\x1b[Bb\x1b[201~']             ▸ pastes:1 keys:[]
        pasteKeys ['ab\r']                                   ▸ pastes:0 keys:[['a' 'a'] ['b' 'b'] ['return' '\n']]

  ▸ escape

        t = new ttio headless:true input:false

        t.parseEsc 'c'   ▸ key:'c' type:'press' combo:'alt+c' char:'c' 
        t.parseEsc ','   ▸ key:',' type:'press' combo:'alt+,' char:',' 
        t.parseEsc 'C'   ▸ key:'c' type:'press' combo:'alt+shift+c' char:'C'
        t.parseEsc '\\'  ▸ undefined

▸ keyscript

        keyscript.bytes 'down'          ▸ '\x1b[B'
        keyscript.bytes 'up'            ▸ '\x1b[A'
        keyscript.bytes 'left'          ▸ '\x1b[D'
        keyscript.bytes 'right'         ▸ '\x1b[C'
        keyscript.bytes 'return'        ▸ '\r'
        keyscript.bytes 'space'         ▸ ' '
        keyscript.bytes 'esc'           ▸ '\x1b[27u'
        keyscript.bytes 'ab'            ▸ 'ab'
        keyscript.bytes 'a'             ▸ 'a'
        keyscript.bytes 'cmd+o'         ▸ '\x1b[111;9u'
        keyscript.bytes 'ctrl+s'        ▸ '\x1b[115;5u'
        keyscript.bytes 'alt+r'         ▸ '\x1b[114;3u'
        keyscript.bytes 'shift+cmd+s'   ▸ '\x1b[115;10u'
        keyscript.bytes 'cmd+down'      ▸ '\x1b[1;9B'
        keyscript.bytes 'cmd+tab'       ▸ '\x1b[9;9u'
        keyscript.bytes 'cmd+foo'       ▸ 'cmd+foo'
        keyscript.bytes 'o+'            ▸ 'o+'
        keyscript.bytes '\x1b[B'        ▸ '\x1b[B'
        keyscript.script 'cmd+o down'   ▸ '\x1b[111;9u\x1b[B'
        keyscript.script 'a b'          ▸ 'ab'
        keyscript.script '  '           ▸ ''
        keyscript.steps 'cmd+o down'    ▸ [['cmd+o' '\x1b[111;9u'] ['down' '\x1b[B']]
        keyscript.steps 'ab'            ▸ [['a' 'a'] ['b' 'b']]
        keyscript.steps ''              ▸ []
