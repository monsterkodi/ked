use ../../kxk    ▪ post
use ../edit      ◆ state mode
use ../edit/tool ◆ belt changelist
use ../edit/mode ◆ novim

cells = cols:55 rows:66

fakeGet = (key def) -> clone(store[key] ? def)
fakeSet = (key value) -> store[key] = clone value

▸ novim changes

  ▸ g; and g, walk change positions

        store = {'editor▸file':'/tmp/novimchange'}
        global.ked_session = get:fakeGet set:fakeSet

        s = new state cells 'novimchange_walk'
        mode.modes.novim = novim
        mode.start s 'novim'

        press = (c) -> mode.handleKey s c {combo:c, char:c}

        s.loadLines belt.linesForText("one\ntwo\nthree")
        s.setMainCursor 0 0

        press 'x'
        s.mainCursor() ▸ [0 0]

        press 'j'
        press 'x'
        s.mainCursor() ▸ [0 1]

        press 'g'
        press ';'
        s.mainCursor() ▸ [0 1]

        press 'g'
        press ';'
        s.mainCursor() ▸ [0 0]

        press 'g'
        press ','
        s.mainCursor() ▸ [0 1]

        mode.stop s 'novim'
        delete global.ked_session

  ▸ a count walks several changes

        store = {'editor▸file':'/tmp/novimchange'}
        global.ked_session = get:fakeGet set:fakeSet

        s = new state cells 'novimchange_count'
        mode.modes.novim = novim
        mode.start s 'novim'

        press = (c) -> mode.handleKey s c {combo:c, char:c}

        s.loadLines belt.linesForText("1\n2\n3\n4\n5")
        s.setMainCursor 0 0

        press 'x'
        press 'j'
        press 'x'
        press 'j'
        press 'x'

        press '2'
        press 'g'
        press ';'
        s.mainCursor() ▸ [0 1]

        press '2'
        press 'g'
        press ','
        s.mainCursor() ▸ [0 2]

        mode.stop s 'novim'
        delete global.ked_session

  ▸ typing on one line is one change

        store = {'editor▸file':'/tmp/novimchange'}
        global.ked_session = get:fakeGet set:fakeSet

        s = new state cells 'novimchange_typing'

        s.loadLines ['abc']
        s.setMainCursor 0 0

        s.insert 'x'
        s.insert 'y'

        s.changes.entries.length ▸ 1
        s.changes.entries[0]     ▸ [1 0]

        delete global.ked_session

  ▸ motion does not add a change

        store = {'editor▸file':'/tmp/novimchange'}
        global.ked_session = get:fakeGet set:fakeSet

        s = new state cells 'novimchange_motion'
        mode.modes.novim = novim
        mode.start s 'novim'

        press = (c) -> mode.handleKey s c {combo:c, char:c}

        s.loadLines belt.linesForText("one two")
        s.setMainCursor 0 0

        press 'w'
        press 'l'

        s.changes.entries.length ▸ 0

        mode.stop s 'novim'
        delete global.ked_session

  ▸ undo keeps the change position

        store = {'editor▸file':'/tmp/novimchange'}
        global.ked_session = get:fakeGet set:fakeSet

        s = new state cells 'novimchange_undo'

        s.loadLines ['abc']
        s.setMainCursor 0 0

        s.insert 'x'

        s.changes.entries.length ▸ 1

        s.undo()

        s.changes.entries.length ▸ 1
        s.changes.older()        ▸ [0 0]

        delete global.ked_session

  ▸ substitute adds a change

        store = {'editor▸file':'/tmp/novimchange'}
        global.ked_session = get:fakeGet set:fakeSet

        s = new state cells 'novimchange_substitute'
        mode.modes.novim = novim
        mode.start s 'novim'

        s.loadLines belt.linesForText("one\ntwo")
        s.setMainCursor 0 0

        nmv = mode.get s 'novim'
        nmv.runEx 's/one/x/'

        s.changes.entries.length ▸ 1
        s.changes.entries[0]     ▸ [0 0]

        mode.stop s 'novim'
        delete global.ked_session

  ▸ loading a file forgets the changes

        store = {'editor▸file':'/tmp/novimchange'}
        global.ked_session = get:fakeGet set:fakeSet

        s = new state cells 'novimchange_load'

        s.loadLines ['abc']
        s.setMainCursor 0 0

        s.insert 'x'

        s.changes.entries.length ▸ 1

        s.loadLines ['new']

        s.changes.entries.length ▸ 0

        delete global.ked_session

▸ novim jumps

  ▸ G and gg make jump positions navigable

        store = {'editor▸file':'/tmp/novimjump'}
        global.ked_session = get:fakeGet set:fakeSet

        s = new state cells 'novimjump_gg'
        mode.modes.novim = novim
        mode.start s 'novim'

        press = (c) -> mode.handleKey s c {combo:c, char:c}
        tab   = -> mode.handleKey s 'tab' {combo:'tab', char:'\t'}

        s.loadLines belt.linesForText("one\ntwo\nthree")
        s.setMainCursor 0 0

        press 'G'
        s.mainCursor() ▸ [3 2]

        press 'g'
        press 'g'
        s.mainCursor() ▸ [0 0]

        press 'ctrl+o'
        s.mainCursor() ▸ [3 2]

        tab()
        s.mainCursor() ▸ [0 0]

        mode.stop s 'novim'
        delete global.ked_session

  ▸ a count walks several jumps

        store = {'editor▸file':'/tmp/novimjump'}
        global.ked_session = get:fakeGet set:fakeSet

        s = new state cells 'novimjump_count'
        mode.modes.novim = novim
        mode.start s 'novim'

        press = (c) -> mode.handleKey s c {combo:c, char:c}

        s.loadLines belt.linesForText("a\n\nb\n\nc")
        s.setMainCursor 0 0

        press '}'
        s.mainCursor() ▸ [0 1]

        press '}'
        s.mainCursor() ▸ [0 3]

        press '2'
        press 'ctrl+o'
        s.mainCursor() ▸ [0 0]

        press '2'
        press 'ctrl+i'
        s.mainCursor() ▸ [0 3]

        mode.stop s 'novim'
        delete global.ked_session

  ▸ a committed search is a jump

        store = {'editor▸file':'/tmp/novimjump'}
        global.ked_session = get:fakeGet set:fakeSet

        s = new state cells 'novimjump_search'
        mode.modes.novim = novim
        mode.start s 'novim'

        press = (c) -> mode.handleKey s c {combo:c, char:c}

        s.loadLines belt.linesForText("foo\nbar\nfoo")
        s.setMainCursor 0 1

        nmv = mode.get s 'novim'
        nmv.startSearch()
        nmv.searchChanged 'foo'
        nmv.commitSearch()

        s.mainCursor() ▸ [0 2]

        press 'ctrl+o'
        s.mainCursor() ▸ [0 1]

        mode.stop s 'novim'
        delete global.ked_session

  ▸ percent is a jump

        store = {'editor▸file':'/tmp/novimjump'}
        global.ked_session = get:fakeGet set:fakeSet

        s = new state cells 'novimjump_percent'
        mode.modes.novim = novim
        mode.start s 'novim'

        press = (c) -> mode.handleKey s c {combo:c, char:c}

        s.loadLines belt.linesForText("call(\n  x\n)")
        s.setMainCursor 4 0

        press '%'

        s.mainCursor() ▸ [0 2]

        press 'ctrl+o'
        s.mainCursor() ▸ [4 0]

        mode.stop s 'novim'
        delete global.ked_session

  ▸ a jump to another file opens it

        store = {'editor▸file':'/tmp/novimjump-a'}
        global.ked_session = get:fakeGet set:fakeSet

        s = new state cells 'novimjump_files'
        mode.modes.novim = novim
        mode.start s 'novim'

        press = (c) -> mode.handleKey s c {combo:c, char:c}

        opens = []
        post.on 'file.open' (file row col) -> opens.push [file row col]

        s.loadLines belt.linesForText("one\ntwo\nthree")
        s.setMainCursor 2 0

        press 'G'

        store['editor▸file'] = '/tmp/novimjump-b'
        s.setMainCursor 0 0

        press 'ctrl+o'

        opens[-1] ▸ ['/tmp/novimjump-a' 2 0]

        mode.stop s 'novim'
        delete global.ked_session

  ▸ a global command does not add jumps

        store = {'editor▸file':'/tmp/novimjump'}
        global.ked_session = get:fakeGet set:fakeSet

        s = new state cells 'novimjump_global'
        mode.modes.novim = novim
        mode.start s 'novim'

        s.loadLines belt.linesForText("a\nb\nc")

        nmv = mode.get s 'novim'
        nmv.runEx 'g/./normal G'

        s.jumps.entries.length ▸ 0

        mode.stop s 'novim'
        delete global.ked_session

  ▸ substitute and edit add jumps

        store = {'editor▸file':'/tmp/novimjump'}
        global.ked_session = get:fakeGet set:fakeSet

        s = new state cells 'novimjump_ex'
        mode.modes.novim = novim
        mode.start s 'novim'

        s.loadLines belt.linesForText("one\ntwo")
        s.setMainCursor 0 1

        nmv = mode.get s 'novim'

        nmv.runEx 'e'

        s.jumps.entries.length ▸ 1
        s.jumps.entries[0].y   ▸ 1

        s.setMainCursor 0 0

        nmv.runEx 's/one/x/'

        s.jumps.entries.length ▸ 2
        s.jumps.entries[1].y   ▸ 0

        mode.stop s 'novim'
        delete global.ked_session

▸ changelist

  ▸ an empty change list has no older or newer position

        c = new changelist

        c.older() ▸ null
        c.newer() ▸ null

  ▸ g; starts at the newest change

        c = new changelist

        c.record [0 0]

        c.older() ▸ [0 0]
        c.older() ▸ null

  ▸ changes are walked backwards and forwards

        c = new changelist

        c.record [0 0]
        c.record [0 1]
        c.record [0 2]

        c.older() ▸ [0 2]
        c.older() ▸ [0 1]
        c.older() ▸ [0 0]
        c.older() ▸ null

        c.newer() ▸ [0 1]
        c.newer() ▸ [0 2]
        c.newer() ▸ null

  ▸ close changes on the same line keep only the last position

        c = new changelist

        c.record [10 0]
        c.record [20 0]

        c.entries.length ▸ 1
        c.entries[0]     ▸ [20 0]

  ▸ changes far apart on the same line are kept

        c = new changelist

        c.record [10 0]
        c.record [95 0]

        c.entries.length ▸ 2

  ▸ only the newest 100 changes are kept

        c = new changelist

        for y in 1..105
            c.record [0 y]

        c.entries.length ▸ 100
        c.entries[0][1]  ▸ 6
        c.entries[-1][1] ▸ 105

  ▸ reset forgets the changes

        c = new changelist

        c.record [0 0]

        c.reset()

        c.entries.length ▸ 0
        c.older()        ▸ null
