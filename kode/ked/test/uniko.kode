###
    uniko

    a unicode character picker
###

use ../../kxk       ▪ kseg
use ../../kxk       ◆ clip
use ../util         ◆ harness
use ../edit         ◆ editor specs
use ../view/colmns  ◆ uniko

▸ uniko

    ▸ the default list starts with the characters of the trigger list

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []
        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 16
        u.show()

        triggers = specs.trigger['~']

        u.matrix.numItems() > triggers.length ▸ true

        for i in 0...triggers.length
            u.matrix.items[i].char.trim() ▸ triggers[i].trim()

    ▸ the default list has no double width characters

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []
        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 16
        u.show()

        u.allItems.every((item) -> kseg.segWidth(item.char) < 2) ▸ true

    ▸ a key filters the characters

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []
        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 16
        u.show()

        u.filter 'sqrt'

        u.matrix.numItems() > 0 ▸ true
        u.matrix.selectedText() ▸ '√'

    ▸ an alias finds the same character

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []
        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 16
        u.show()

        u.filter 'surd'

        u.matrix.selectedText() ▸ '√'

    ▸ comments are searchable and the match is case insensitive

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []
        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 16
        u.show()

        u.filter 'GREEK'

        u.matrix.numItems() > 0 ▸ true

    ▸ an empty search shows the whole list again

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []
        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 16
        u.show()

        all = u.matrix.numItems()

        u.filter 'sqrt'
        u.filter ''

        u.matrix.numItems() ▸ all

    ▸ the matrix starts focused and typing moves the focus to the input

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []
        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 16
        u.show()

        u.focus ▸ 'matrix'
        u.matrix.selectedIndex ▸ 0

        h.key u 's' 's'

        u.focus ▸ 'input'
        u.input.current() ▸ 's'

    ▸ return inserts the selected character at the cursors but keeps the picker open

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['abc']
        e.state.setMainCursor 1 0

        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 16
        u.show()

        u.filter 'sqrt'
        h.key u 'return' ''

        kseg.str(e.state.s.lines[0]) ▸ 'a√bc'
        u.hidden() ▸ false
        u.focus ▸ 'matrix'
        e.hasFocus() ▸ false

    ▸ space inserts the selected character and keeps the matrix focused

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['abc']
        e.state.setMainCursor 1 0

        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 16
        u.show()

        u.filter 'sqrt'
        h.key u 'space' ' '

        kseg.str(e.state.s.lines[0]) ▸ 'a√bc'
        u.hidden() ▸ false
        u.focus ▸ 'matrix'
        e.hasFocus() ▸ false

    ▸ space inserts while the input is focused too

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['abc']
        e.state.setMainCursor 1 0

        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 14
        u.show()

        h.type u 'sqrt'

        u.focus ▸ 'input'

        h.key u 'space' ' '

        kseg.str(e.state.s.lines[0]) ▸ 'a√bc'
        u.hidden() ▸ false
        u.focus ▸ 'input'
        e.hasFocus() ▸ false

    ▸ a mouse click inserts the clicked character and keeps the matrix focused

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['abc']
        e.state.setMainCursor 1 0

        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 14
        u.show()

        u.filter 'sqrt'

        u.onMouse
            type: 'press'
            cell: [2 3]
            button: 'left'
            count: 1

        kseg.str(e.state.s.lines[0]) ▸ 'a√bc'
        u.hidden() ▸ false
        u.focus ▸ 'matrix'
        e.hasFocus() ▸ false

    ▸ copy writes the selected character to the clipboard

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []

        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 16
        u.show()

        copied = []
        before = clip.copy
        clip.copy = (text) -> copied.push text

        u.filter 'sqrt'
        h.key u 'cmd+c' ''

        copied ▸ ['√']
        u.hidden() ▸ false

        clip.copy = before

    ▸ escape closes without a change and gives the focus back

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['abc']
        e.state.setMainCursor 1 0

        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 16
        u.show()

        h.key u 'esc' ''

        kseg.str(e.state.s.lines[0]) ▸ 'abc'
        u.hidden() ▸ true
        e.hasFocus() ▸ true

    ▸ cmd+down increases the scale and cmd+up decreases it

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []
        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 16
        u.show()

        u.height ▸ 16
        u.matrix.scale ▸ 1

        h.key u 'cmd+down' ''

        u.height ▸ 16
        u.matrix.scale ▸ 2

        h.key u 'cmd+down' ''
        h.key u 'cmd+down' ''

        u.matrix.scale ▸ 4

        h.key u 'cmd+down' ''

        u.matrix.scale ▸ 4

        h.key u 'cmd+up' ''

        u.matrix.scale ▸ 3

        h.key u 'cmd+up' ''
        h.key u 'cmd+up' ''

        u.matrix.scale ▸ 1
