
use ../../kxk       ▪ kseg post
use ../../kxk       ◆ clip
use ../util         ◆ harness
use ../edit         ◆ editor specs
use ../view/base    ◆ matrix
use ../view/colmns  ◆ uniko

▸ uniko

  ▸ comments are searchable and the match is case insensitive

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []
        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 16
        u.show()

        u.filter 'GREEK'

        u.matrix.numItems() > 0 ▸ true

  ▸ an empty search shows the whole list again

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []
        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 16
        u.show()

        all = u.matrix.numItems()

        u.filter 'sqrt'
        u.filter ''

        u.matrix.numItems() ▸ all

  ▸ the matrix starts focused and typing moves the focus to the input

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []
        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 16
        u.show()

        u.focus ▸ 'matrix'
        u.matrix.selectedIndex ▸ 0

        h.key u 's' 's'

        u.focus ▸ 'input'
        u.input.current() ▸ 's'

  ▸ return inserts the selected character at the cursors but keeps the picker open

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['abc']
        e.state.setMainCursor 1 0

        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 16
        u.show()

        u.filter 'sqrt'
        h.key u 'return' ''

        kseg.str(e.state.s.lines[0]) ▸ 'a√bc'
        u.hidden() ▸ false
        u.focus ▸ 'matrix'
        e.hasFocus() ▸ false

  ▸ space inserts the selected character and keeps the matrix focused

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['abc']
        e.state.setMainCursor 1 0

        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 16
        u.show()

        u.filter 'sqrt'
        h.key u 'space' ' '

        kseg.str(e.state.s.lines[0]) ▸ 'a√bc'
        u.hidden() ▸ false
        u.focus ▸ 'matrix'
        e.hasFocus() ▸ false

  ▸ a mouse click inserts the clicked character and keeps the matrix focused

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['abc']
        e.state.setMainCursor 1 0

        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 14
        u.show()

        u.filter 'sqrt'

        u.onMouse
            type: 'press'
            cell: [2 3]
            button: 'left'
            count: 1

        kseg.str(e.state.s.lines[0]) ▸ 'a√bc'
        u.hidden() ▸ false
        u.focus ▸ 'matrix'
        e.hasFocus() ▸ false

  ▸ copy writes the selected character to the clipboard

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []

        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 16
        u.show()

        copied = []
        before = clip.copy
        clip.copy = (text) -> copied.push text

        u.filter 'sqrt'
        h.key u 'cmd+c' ''

        copied ▸ ['√']
        u.hidden() ▸ false

        clip.copy = before

  ▸ escape closes without a change and gives the focus back

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['abc']
        e.state.setMainCursor 1 0

        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 16
        u.show()

        h.key u 'esc' ''

        kseg.str(e.state.s.lines[0]) ▸ 'abc'
        u.hidden() ▸ true
        e.hasFocus() ▸ true

  ▸ scale change

        h = new harness cols:60 rows:30
        e = new editor h.screen 'test_editor' []
        u = new uniko h.screen e 'test_uniko'
        u.layout 0 0 60 16
        u.show()

        u.matrix.scale ▸ 2

        h.key u 'cmd+up' ''

        u.matrix.scale ▸ 3

        h.key u 'cmd+up' ''
        h.key u 'cmd+up' ''

        u.matrix.scale ▸ 3

        h.key u 'cmd+down' ''

        u.matrix.scale ▸ 2

        h.key u 'cmd+down' ''
        h.key u 'cmd+down' ''

        u.matrix.scale ▸ 1

▸ matrix

  ▸ selection moves through the items in reading order

        h = new harness cols:10 rows:5
        m = new matrix h.screen 'test_matrix'
        m.layout 0 0 10 5
        m.setItems ['a' 'b' 'c' 'd' 'e' 'f' 'g' 'h' 'i' 'j' 'k' 'l']

        m.selectedText() ▸ 'a'

        m.moveSelection 'right' ▸ true
        m.selectedText() ▸ 'b'

        cols = m.columns()

        m.setItems ['a' 'b' 'c' 'd' 'e' 'f' 'g' 'h' 'i' 'j' 'k' 'l']
        m.selectedIndex ▸ 0

        m.moveSelection 'down' ▸ true
        m.selectedIndex ▸ cols

  ▸ left at the first item stays put

        h = new harness cols:10 rows:5
        m = new matrix h.screen 'test_matrix'
        m.layout 0 0 10 5
        m.setItems ['a' 'b' 'c']

        m.moveSelection 'left' ▸ false
        m.selectedIndex ▸ 0

  ▸ up in the first row stays put

        h = new harness cols:10 rows:5
        m = new matrix h.screen 'test_matrix'
        m.layout 0 0 10 5
        m.setItems ['a' 'b' 'c']

        m.moveSelection 'up' ▸ false
        m.selectedIndex ▸ 0

  ▸ the matrix knows whether it has the focus

        h = new harness cols:10 rows:5
        m = new matrix h.screen 'test_matrix'
        m.layout 0 0 10 5

        not m.hasFocus() ▸ true

        h.focus m

        m.hasFocus() ▸ true

        post.emit 'focus' 'somewhere_else'

        not m.hasFocus() ▸ true

  ▸ a larger scale uses more cell rows per logical row

        h = new harness cols:20 rows:20
        m = new matrix h.screen 'test_matrix'
        m.layout 0 0 20 20

        m.scale ▸ 2
        m.viewportRows() ▸ 10

        m.incScale 1

        m.scale ▸ 3
        m.viewportRows() ▸ 6
        m.cellAtPos(3 4) ▸ [0 1]

        m.incScale 1

        m.scale ▸ 3
        m.viewportRows() ▸ 6
        m.cellAtPos(3 3) ▸ [0 1]

        m.incScale -1
        m.incScale -1

        m.scale ▸ 1
        m.viewportRows() ▸ 20

  ▸ scaled cells and the selection line up at every scale

        for s in [2 3]

            h = new harness cols:24 rows:20
            m = new matrix h.screen 'test_matrix'
            m.layout 0 0 24 20

            while m.scale < s
                m.incScale 1

            m.setItems ['a']
            m.draw()

            x = s

            h.screen.get_char(x-s 0) ▸ ''
            h.screen.get_char(x   0) ▸ 'a'
            h.screen.get_char(x+s 0) ▸ ''
