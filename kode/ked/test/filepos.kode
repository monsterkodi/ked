
use ../edit/tool ◆ belt
use ../edit      ◆ state
use ../edit/mode ◆ filepos

▸ filepos

    ▸ a reload keeps the saved view

        store = {}

        fakeGet = (key def) -> clone(store[key] ? def)
        fakeSet = (key value) -> store[key] = clone value
        global.ked_session = get:fakeGet set:fakeSet

        cells = cols:40 rows:20

        s = new state cells 'test_filepos'

        lines = []
        for i in 0...100
            lines.push "line #{i}"

        text = lines.join '\n'

        s.loadSegls belt.seglsForText(text)

        file = '/tmp/ked-test-filepos'

        fp = new filepos s

        s.on 'cursorsSet' (-> fp.cursorsSet())

        ked_session.set 'editor▸file' file

        #  the main cursor is the 11th visible line of a view showing 20 lines
        ked_session.set "editor▸filepos▸#{file}" [5 60 0 50]

        reload = ->
            s.loadSegls belt.seglsForText(text)
            fp.fileLoaded file

        reload()
        s.s.view ▸ [0 50]
        s.mainCursor() ▸ [5 60]

        reload()
        s.s.view ▸ [0 50]

        ked_session.get("editor▸filepos▸#{file}") ▸ [5 60 0 50]

        delete global.ked_session

    ▸ added files go before the current file

        store = {}
        fakeGet = (key def) -> clone(store[key] ? def)
        fakeSet = (key value) -> store[key] = clone value
        global.ked_session = get:fakeGet set:fakeSet

        filepos.fileposl = [['/tmp/current' [1 2 3 4]]]
        filepos.offset = 0

        ked_session.set 'editor▸file' '/tmp/current'
        ked_session.set 'editor▸filepos▸/tmp/next' [5 6 7 8]

        filepos.addFiles ['/tmp/next' '/tmp/last']

        filepos.fileposl ▸ [['/tmp/last' [0 0 0 0]] ['/tmp/next' [5 6 7 8]] ['/tmp/current' [1 2 3 4]]]

        delete global.ked_session
