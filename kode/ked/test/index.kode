use fs
use ../../kxk ▪ slash sleep post
use ../index ◆ index_kode index_hpp index_noon index_json index_utils indexer

waitFor = (cond) ◯->

    n = 0
    while n < 100
        ⮐ true if cond()
        ◯ sleep 10
        n += 1
    false

▸ index

  ▸ class names in line

        index_utils.classNameInLine('class Foo')        ▸ 'Foo'
        index_utils.classNameInLine('function foo')     ▸ 'foo'
        index_utils.classNameInLine('Foo = class Bar')  ▸ 'Bar'
        index_utils.classNameInLine('classFoo')         ▸ undefined
        index_utils.classNameInLine('■')                ▸ undefined
        index_utils.classNameInLine('■Class')           ▸ 'Class'
        index_utils.classNameInLine('■ Class')          ▸ 'Class'
        index_utils.classNameInLine('Foo = ■Bar')       ▸ 'Bar'

  ▸ shortcut classes are indexed

        idx = new index_kode
        result = idx.parse """
            ■Foo
                method: -> 1
            ■ Bar
                other: -> 2
            """

        result.classes.length ▸ 2
        result.classes[0].name ▸ 'Foo'
        result.classes[0].line ▸ 0
        result.classes[1].name ▸ 'Bar'
        result.classes[1].line ▸ 2

  ▸ noon top level objects are indexed

        idx = new index_noon
        result = idx.parse """
            name      ked
            scripts
                      build     pnpm run build
            # comment
            version   ^0.1.2
            """

        result.funcs.length ▸ 3
        result.funcs[0].name ▸ 'name'
        result.funcs[0].line ▸ 0
        result.funcs[1].name ▸ 'scripts'
        result.funcs[1].line ▸ 1
        result.funcs[2].name ▸ 'version'
        result.funcs[2].line ▸ 4

  ▸ json top level objects are indexed

        idx = new index_json
        result = idx.parse """
            {
                "name": "ked",
                "scripts": {
                    "build": "pnpm run build",
                    "test":  "node js/test.js"
                },
                "url": "http://example.com",
                "version": "0.1.2"
            }
            """

        result.funcs.length ▸ 4
        result.funcs[0].name ▸ 'name'
        result.funcs[0].line ▸ 1
        result.funcs[1].name ▸ 'scripts'
        result.funcs[1].line ▸ 2
        result.funcs[2].name ▸ 'url'
        result.funcs[2].line ▸ 6
        result.funcs[3].name ▸ 'version'
        result.funcs[3].line ▸ 7

  ▸ json objects on one line are indexed

        idx = new index_json
        result = idx.parse '{"a": 1, "b": {"c": 2}, "d": [3]}'

        result.funcs.length ▸ 3
        result.funcs[0].name ▸ 'a'
        result.funcs[1].name ▸ 'b'
        result.funcs[2].name ▸ 'd'
        result.funcs[0].line ▸ 0

  ▸ strings do not define classes or words

        idx = new index_kode

        text = [
            '■Before'
            '    method: -> 1'
            "taken = 'class InsideSingle'"
            'other = "■InsideDouble"'
            'quoted = """'
            '    class InsideTriple'
            '    ■ ShortcutInsideTriple'
            '    """'
            '■After'
            '    other: -> 2'
            ].join '\n'

        result = idx.parse text

        result.classes.length ▸ 2
        result.classes[0].name ▸ 'Before'
        result.classes[0].line ▸ 0
        result.classes[1].name ▸ 'After'
        result.classes[1].line ▸ 8

        result.words.includes('InsideSingle') ▸ false
        result.words.includes('InsideDouble') ▸ false
        result.words.includes('InsideTriple') ▸ false
        result.words.includes('ShortcutInsideTriple') ▸ false
        result.words.includes('After') ▸ true

  ▸ post handlers keep their string event name

        idx = new index_kode
        result = idx.parse "post.on 'quit' -> 1"

        result.funcs.length ▸ 1
        result.funcs[0].name ▸ 'quit'
        result.funcs[0].post ▸ true

  ▸ a compare between strings is not a test marker

        idx = new index_kode

        text = [
            '▸ bad'
            '    ke  """'
            '        hello'
            '        """ ▸ """'
            '        world'
            '        """'
            ].join '\n'

        result = idx.parse text

        result.funcs.length ▸ 1
        result.funcs[0].name ▸ '▸ bad'

  ▸ noon files list top level objects

        root = '/tmp/opencode/ked-index-noon'
        file = slash.path root 'top.noon'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        fs.writeFileSync file 'alpha\n    beta  1\ngamma  2\n'

        idx = new indexer
        ◯ idx.index file

        info = idx.files[file]
        fs.rmSync root recursive:true force:true

        info.funcs.length ▸ 2
        info.funcs[0].name ▸ 'alpha'
        info.funcs[0].line ▸ 1
        info.funcs[1].name ▸ 'gamma'
        info.funcs[1].line ▸ 3

  ▸ json files list top level objects

        root = '/tmp/opencode/ked-index-json'
        file = slash.path root 'top.json'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        fs.writeFileSync file '{\n  "alpha": 1,\n  "beta": {"gamma": 2}\n}\n'

        idx = new indexer
        ◯ idx.index file

        info = idx.files[file]
        fs.rmSync root recursive:true force:true

        info.funcs.length ▸ 2
        info.funcs[0].name ▸ 'alpha'
        info.funcs[0].line ▸ 2
        info.funcs[1].name ▸ 'beta'
        info.funcs[1].line ▸ 3

  ▸ index waits for the file to be read and parsed

        root = '/tmp/opencode/ked-index-waits'
        file = slash.path root 'waits.kode'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        fs.writeFileSync file 'x = 1'

        idx = new indexer
        ◯ idx.index file

        fs.rmSync root recursive:true force:true

        (valid idx.files[file]) ▸ true

  ▸ classes expose their base and methods

        root = '/tmp/opencode/ked-index-base'
        file = slash.path root 'base.kode'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        fs.writeFileSync file """
            ■Root
                gamma: -> 3
            ■Base□Root
                alpha: -> 1
                beta: => 2
            ■Child□Base
            """

        idx = new indexer
        ◯ idx.index file

        fs.rmSync root recursive:true force:true

        idx.classInfo('Base').file ▸ file
        idx.classInfo('Base').line ▸ 3
        idx.classInfo('Base').base ▸ 'Root'
        idx.classInfo('Child').base ▸ 'Base'

        idx.methodsOfClass('Base').map((f) -> f.name) ▸ ['alpha' 'beta']
        idx.methodsOfClass('Child').length ▸ 0
        idx.methodsOfClass('Nope').length ▸ 0

        idx.baseClassesOf('Child').map((c) -> c.name) ▸ ['Child' 'Base' 'Root']

  ▸ cpp structs and their methods are indexed

        idx = new index_hpp
        result = idx.parse """
            struct Win
            {
                void show (int x);
                int width () const;
            };
            """

        result.classes.map((c) -> c.name) ▸ ['Win']
        result.funcs.map((f) -> f.method) ▸ ['show' 'width']
        result.funcs.map((f) -> f.class) ▸ ['Win' 'Win']

  ▸ cpp free functions are indexed without unnamed entries

        idx = new index_hpp
        result = idx.parse """
            static JsonNode* route_info (const fs::path& path)
            {
                struct stat st;
                if (::stat(path.c_str(), &st) != 0)
                {
                    return node_null();
                }
            }

            int main (int argc, char** argv)
            {
                return 0;
            }
            """

        result.classes.length ▸ 0
        result.funcs.map((f) -> f?.name) ▸ ['route_info' 'main']

  ▸ cpp files index without undefined entries

        root = '/tmp/opencode/ked-index-cpp'
        file = slash.path root 'main.cpp'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        fs.writeFileSync file """
            struct Win
            {
                void show (int x);
            };

            static JsonNode* route_info (const fs::path& path)
            {
                struct stat st;
                if (::stat(path.c_str(), &st) != 0)
                {
                    return node_null();
                }
            }
            """

        idx = new indexer
        ◯ idx.index file

        info = idx.files[file]
        fs.rmSync root recursive:true force:true

        info.classes.map((c) -> c.name) ▸ ['Win']
        info.funcs.filter((f) -> not f?.name).length ▸ 0
        info.funcs.map((f) -> f.name) ▸ ['show' 'route_info']
        info.funcs[0].class ▸ 'Win'
        info.funcs[0].async ▸ false
        info.funcs[0].bound ▸ false
###
  ▸ deleted files leave the index

        root = '/tmp/opencode/ked-index-delete'
        file = slash.path root 'gone.kode'
        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        fs.writeFileSync file '■Gone\n    zebraword: -> 1\n'

        idx = new indexer
        ◯ idx.index file

        hadword = idx.words['zebraword']?.has(file)

        fs.rmSync file
        post.emit 'file.change' path:file change:'delete'
        ◯ waitFor -> not idx.files[file]?

        fs.rmSync root recursive:true force:true

        hadword ▸ true
        (idx.files[file]?) ▸ false
        (idx.funcs['zebraword']?) ▸ false
        (idx.classes['Gone']?) ▸ false
        (idx.words['zebraword']?) ▸ false

  ▸ renamed files move their index entries

        root = '/tmp/opencode/ked-index-rename'
        oldFile = slash.path root 'old.kode'
        newFile = slash.path root 'new.kode'
        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        fs.writeFileSync oldFile '■Old\n    zebraword: -> 1\n'

        idx = new indexer
        ◯ idx.index oldFile

        fs.renameSync oldFile newFile
        post.emit 'file.change' path:newFile oldPath:oldFile change:'rename'
        ◯ waitFor -> idx.files[newFile]? and not idx.files[oldFile]?

        fs.rmSync root recursive:true force:true

        (idx.files[oldFile]?) ▸ false
        (idx.files[newFile]?) ▸ true
        (idx.funcs['zebraword']?) ▸ true
        idx.funcs['zebraword'][0].file ▸ newFile
        (idx.words['zebraword']?.has(newFile)) ▸ true
        (idx.words['zebraword']?.has(oldFile)) ▸ false

  ▸ deleted folders remove their indexed files

        root = '/tmp/opencode/ked-index-folder-delete'
        dir = slash.path root 'folder'
        one = slash.path dir 'one.kode'
        two = slash.path dir 'two.kode'
        fs.rmSync root recursive:true force:true
        fs.mkdirSync dir recursive:true
        fs.writeFileSync one 'oneword = 1\n'
        fs.writeFileSync two 'twoword = 2\n'

        idx = new indexer
        ◯ idx.index one
        ◯ idx.index two

        fs.rmSync dir recursive:true force:true
        post.emit 'file.change' path:dir change:'delete'
        ◯ waitFor -> not idx.files[one]? and not idx.files[two]?

        fs.rmSync root recursive:true force:true

        (idx.files[one]?) ▸ false
        (idx.files[two]?) ▸ false

  ▸ renamed folders move their indexed files

        root = '/tmp/opencode/ked-index-folder-rename'
        oldDir = slash.path root 'old'
        newDir = slash.path root 'new'
        oldFile = slash.path oldDir 'one.kode'
        newFile = slash.path newDir 'one.kode'
        fs.rmSync root recursive:true force:true
        fs.mkdirSync oldDir recursive:true
        fs.writeFileSync oldFile 'oneword = 1\n'

        idx = new indexer
        ◯ idx.index oldFile

        fs.renameSync oldDir newDir
        post.emit 'file.change' path:newDir oldPath:oldDir change:'rename'
        ◯ waitFor -> idx.files[newFile]? and not idx.files[oldFile]?

        fs.rmSync root recursive:true force:true

        (idx.files[oldFile]?) ▸ false
        (idx.files[newFile]?) ▸ true

  ▸ created files enter the index

        root = '/tmp/opencode/ked-index-create'
        file = slash.path root 'new.kode'
        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true

        idx = new indexer
        fs.writeFileSync file 'newword = 1\n'
        post.emit 'file.change' path:file change:'create'
        ◯ waitFor -> idx.files[file]?

        fs.rmSync root recursive:true force:true

        (idx.files[file]?) ▸ true
