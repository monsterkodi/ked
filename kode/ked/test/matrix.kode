###
    matrix

    a grid of characters
###

use ../util      ◆ harness
use ../view/base ◆ matrix
use ../../kxk    ▪ post

▸ matrix

    ▸ selection moves through the items in reading order

        h = new harness cols:10 rows:5
        m = new matrix h.screen 'test_matrix'
        m.layout 0 0 10 5
        m.setItems ['a' 'b' 'c' 'd' 'e' 'f' 'g' 'h' 'i' 'j' 'k' 'l']

        m.selectedText() ▸ 'a'

        m.moveSelection 'right' ▸ true
        m.selectedText() ▸ 'b'

        cols = m.columns()

        m.setItems ['a' 'b' 'c' 'd' 'e' 'f' 'g' 'h' 'i' 'j' 'k' 'l']
        m.selectedIndex ▸ 0

        m.moveSelection 'down' ▸ true
        m.selectedIndex ▸ cols

    ▸ left at the first item stays put

        h = new harness cols:10 rows:5
        m = new matrix h.screen 'test_matrix'
        m.layout 0 0 10 5
        m.setItems ['a' 'b' 'c']

        m.moveSelection 'left' ▸ false
        m.selectedIndex ▸ 0

    ▸ up in the first row stays put

        h = new harness cols:10 rows:5
        m = new matrix h.screen 'test_matrix'
        m.layout 0 0 10 5
        m.setItems ['a' 'b' 'c']

        m.moveSelection 'up' ▸ false
        m.selectedIndex ▸ 0

    ▸ the selection scrolls into a one row view

        h = new harness cols:10 rows:1
        m = new matrix h.screen 'test_matrix'
        m.layout 0 0 10 1
        m.setItems ['a' 'b' 'c' 'd' 'e' 'f' 'g' 'h' 'i' 'j' 'k' 'l']

        m.offset ▸ 0

        m.moveSelection 'down'

        m.selectedIndex ▸ m.columns()
        m.offset ▸ 1

    ▸ a scroll bar appears when the grid overflows

        h = new harness cols:10 rows:2
        m = new matrix h.screen 'test_matrix'
        m.layout 0 0 10 2
        m.setItems ['a' 'b' 'c' 'd' 'e' 'f' 'g' 'h' 'i' 'j' 'k' 'l']

        m.scrollBarVisible() ▸ true

        m.setItems ['a' 'b' 'c']

        m.scrollBarVisible() ▸ false

    ▸ the matrix knows whether it has the focus

        h = new harness cols:10 rows:5
        m = new matrix h.screen 'test_matrix'
        m.layout 0 0 10 5

        m.hasFocus() ▸ false

        h.focus m

        m.hasFocus() ▸ true

        post.emit 'focus' 'somewhere_else'

        m.hasFocus() ▸ false

    ▸ a larger scale uses more cell rows per logical row

        h = new harness cols:20 rows:20
        m = new matrix h.screen 'test_matrix'
        m.layout 0 0 20 20

        m.scale ▸ 1
        m.viewportRows() ▸ 20

        m.incScale 1

        m.scale ▸ 2
        m.viewportRows() ▸ 10
        m.cellAtPos(3 4) ▸ [0 2]

        m.incScale 1

        m.scale ▸ 3
        m.viewportRows() ▸ 6
        m.cellAtPos(3 3) ▸ [0 1]

        m.incScale -1
        m.incScale -1

        m.scale ▸ 1
        m.viewportRows() ▸ 20

    ▸ scaled cells and the selection line up at every scale

        for s in [2 3 4]

            h = new harness cols:24 rows:20
            m = new matrix h.screen 'test_matrix'
            m.layout 0 0 24 20

            while m.scale < s
                m.incScale 1

            m.setItems ['a']
            m.draw()

            x = s

            h.screen.get_char(x-s 0) ▸ ''
            h.screen.get_char(x   0) ▸ 'a'
            h.screen.get_char(x+s 0) ▸ ''

            m.skipText() ▸ "\x1b[#{s}C"
