  ▸ included and excluded markers use theme colors

        root = slash.path(tmp 'ked-replacer-theme')
        main = slash.path root 'main.kode'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true

        fs.writeFileSync slash.path(root 'package.json') '{}'
        fs.writeFileSync main 'if a\nif b\n'

        delete prjcts.projects[root]
        delete prjcts.allFiles[main]

        global.ked_session =
            get: (key) -> main
            set: (key value) -> null

        savedConfig = config.data
        config.data =
            project: maxDepth:12 ignore:[]
            sourceFileExtensions: ['kode']

        ◯ prjcts.index main

        h = new harness cols:80 rows:16
        e = new editor h.screen 'test_editor' ['gutter']
        e.cells.layout 1 0 79 16
        r = new replacer h.screen e

        ◯ r.show 'if'

        r.draw()

        markerX = r.choices.gutter.cells.x + r.choices.gutter.cells.cols - 2
        headerY = r.sfils[0].cells.y

        h.screen.get_fg(markerX headerY) ▸ theme.replacer.included

        lineItem = null

        for item in r.sfils[0].resultItems
            if item.row is num
                lineItem = item
                break

        (lineItem != null) ▸ true

        lineIndex = r.choices.items.indexOf lineItem
        lineY     = r.choices.cells.y - r.choices.state.s.view[1] + lineIndex

        r.choices.select lineIndex

        ◯ r.onChoicesAction 'space' lineItem

        r.draw()

        markerX = r.choices.gutter.cells.x + r.choices.gutter.cells.cols - 2

        h.screen.get_fg(markerX lineY) ▸ theme.replacer.excluded

        ◯ r.onChoicesAction 'space' r.sfils[0].headerItem

        r.draw()

        markerX = r.choices.gutter.cells.x + r.choices.gutter.cells.cols - 2
        headerY = r.sfils[0].cells.y

        h.screen.get_fg(markerX headerY) ▸ theme.replacer.excluded

        config.data = savedConfig
        delete global.ked_session
        fs.rmSync root recursive:true force:true

  ▸ clicking toggles exclusion and keeps the replacer open

        root = slash.path(tmp 'ked-replacer-click')
        main = slash.path root 'main.kode'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true

        fs.writeFileSync slash.path(root 'package.json') '{}'
        fs.writeFileSync main 'if a\nif b\n'

        delete prjcts.projects[root]
        delete prjcts.allFiles[main]

        global.ked_session =
            get: (key) -> main
            set: (key value) -> null

        savedConfig = config.data
        config.data =
            project: maxDepth:12 ignore:[]
            sourceFileExtensions: ['kode']

        ◯ prjcts.index main

        h = new harness cols:80 rows:16
        e = new editor h.screen 'test_editor' ['gutter']
        e.cells.layout 1 0 79 16
        r = new replacer h.screen e

        ◯ r.show 'if'

        ◯ r.onChoicesAction 'click' r.sfils[0].headerItem

        r.sfils[0].excluded ▸ true
        r.visible() ▸ true

        ◯ r.onChoicesAction 'click' r.sfils[0].headerItem

        r.sfils[0].excluded ▸ false
        r.visible() ▸ true

        lineItem = null

        for item in r.sfils[0].resultItems
            if item.row is num
                lineItem = item
                break

        (lineItem != null) ▸ true

        ◯ r.onChoicesAction 'click' lineItem

        lineItem.excluded ▸ true
        r.visible() ▸ true

        config.data = savedConfig
        delete global.ked_session
        fs.rmSync root recursive:true force:true


  ▸ the selected file separator is blue

        root = slash.path(tmp 'ked-replacer-selected')
        main = slash.path root 'main.kode'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true

        fs.writeFileSync slash.path(root 'package.json') '{}'
        fs.writeFileSync main 'if a\n'

        delete prjcts.projects[root]
        delete prjcts.allFiles[main]

        global.ked_session =
            get: (key) -> main
            set: (key value) -> null

        savedConfig = config.data
        config.data =
            project: maxDepth:12 ignore:[]
            sourceFileExtensions: ['kode']

        ◯ prjcts.index main

        h = new harness cols:80 rows:30
        e = new editor h.screen 'test_editor' ['gutter']
        e.cells.layout 1 0 79 30
        r = new replacer h.screen e

        ◯ r.show 'if'

        r.choices.select 0
        r.draw()

        sfil  = r.sfils[0]
        lineX = sfil.cells.x + 2
        lineY = sfil.cells.y

        h.screen.get_fg(lineX lineY) ▸ theme.finder.frame

        r.choices.select sfil.lineIndex
        r.draw()

        h.screen.get_fg(lineX lineY) ▸ theme.selection.span

        config.data = savedConfig
        delete global.ked_session
        fs.rmSync root recursive:true force:true

▸ kacher

  ▸ caches the text of a file

        root = slash.path(tmp 'ked-kacher-cache')
        file = slash.path root 'a.kode'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        fs.writeFileSync file 'alpha'

        text =◯ kacher.getText file
        text ▸ 'alpha'

        fs.writeFileSync file 'beta'

        text =◯ kacher.getText file
        text ▸ 'alpha'

        fs.rmSync root recursive:true force:true

  ▸ invalidates cached text on file change

        root = slash.path(tmp 'ked-kacher-change')
        file = slash.path root 'a.kode'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        fs.writeFileSync file 'alpha'

        text =◯ kacher.getText file
        text ▸ 'alpha'

        fs.writeFileSync file 'beta'
        post.emit 'file.change' path:file change:'modify'

        text =◯ kacher.getText file
        text ▸ 'beta'

        fs.rmSync root recursive:true force:true

  ▸ renames invalidate the old path

        root = slash.path(tmp 'ked-kacher-rename')
        oldFile = slash.path root 'old.kode'
        newFile = slash.path root 'new.kode'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        fs.writeFileSync oldFile 'alpha'

        text =◯ kacher.getText oldFile
        text ▸ 'alpha'

        fs.renameSync oldFile newFile
        post.emit 'file.change' path:newFile oldPath:oldFile change:'rename'

        fs.writeFileSync oldFile 'beta'
        text =◯ kacher.getText oldFile

        fs.rmSync root recursive:true force:true

        text ▸ 'beta'

  ▸ deletes invalidate the old path

        root = slash.path(tmp 'ked-kacher-delete')
        file = slash.path root 'a.kode'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        fs.writeFileSync file 'alpha'

        text =◯ kacher.getText file
        text ▸ 'alpha'

        fs.rmSync file
        post.emit 'file.change' path:file change:'delete'

        fs.writeFileSync file 'beta'
        text =◯ kacher.getText file

        fs.rmSync root recursive:true force:true

        text ▸ 'beta'

  ▸ folder renames invalidate cached paths below the folder

        root = slash.path(tmp 'ked-kacher-folder-rename')
        oldDir = slash.path root 'old'
        newDir = slash.path root 'new'
        oldFile = slash.path oldDir 'a.kode'
        newFile = slash.path newDir 'a.kode'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync oldDir recursive:true
        fs.writeFileSync oldFile 'alpha'

        text =◯ kacher.getText oldFile
        text ▸ 'alpha'

        fs.renameSync oldDir newDir
        post.emit 'file.change' path:newDir oldPath:oldDir change:'rename'

        fs.mkdirSync oldDir recursive:true
        fs.writeFileSync oldFile 'beta'
        text =◯ kacher.getText oldFile

        fs.rmSync root recursive:true force:true

        text ▸ 'beta'
