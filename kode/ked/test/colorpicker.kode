
use ../util        ◆ harness
use ../view/colmns ◆ colorpicker

▸ colorpicker

    ▸ hovering a slider focuses it

        h = new harness cols:16 rows:9
        p = new colorpicker h.screen 'test_cp'
        p.layout 0 0 16 9
        p.show()

        p.focusIndex ▸ 0

        e =
            type: 'move'
            cell: [8 4]
        p.onMouse e

        p.focusIndex ▸ 1

    ▸ hovering an rgb input focuses it

        h = new harness cols:16 rows:9
        p = new colorpicker h.screen 'test_cp'
        p.layout 0 0 16 9
        p.show()

        e =
            type: 'move'
            cell: [6 7]
        p.onMouse e

        p.focusIndex ▸ 4
        p.green.hasFocus() ▸ true

    ▸ pressing a slider sets the value from the column

        h = new harness cols:16 rows:9
        p = new colorpicker h.screen 'test_cp'
        p.layout 0 0 16 9
        p.show()

        e =
            type: 'press'
            cell: [11 3]
            button: 'left'
            count: 1
        p.onMouse e

        p.hue.getValue() ▸ 277
        p.focusIndex ▸ 0

    ▸ dragging a slider keeps tracking outside of it

        h = new harness cols:16 rows:9
        p = new colorpicker h.screen 'test_cp'
        p.layout 0 0 16 9
        p.show()

        e =
            type: 'press'
            cell: [5 3]
            button: 'left'
            count: 1
        p.onMouse e

        p.hue.getValue() ▸ 111

        e =
            type: 'drag'
            cell: [15 5]
            button: 'left'
            count: 1
        p.onMouse e

        p.hue.getValue() ▸ 360

        e =
            type: 'release'
            cell: [15 5]
            button: 'left'
            count: 1
        p.onMouse e

    ▸ dragging over another slider does not focus it

        h = new harness cols:16 rows:9
        p = new colorpicker h.screen 'test_cp'
        p.layout 0 0 16 9
        p.show()

        e =
            type: 'press'
            cell: [5 5]
            button: 'left'
            count: 1
        p.onMouse e

        p.focusIndex ▸ 2

        e =
            type: 'drag'
            cell: [5 4]
            button: 'left'
            count: 1
        p.onMouse e

        p.focusIndex ▸ 2

        e =
            type: 'drag'
            cell: [5 3]
            button: 'left'
            count: 1
        p.onMouse e

        p.focusIndex ▸ 2

        e =
            type: 'release'
            cell: [5 3]
            button: 'left'
            count: 1
        p.onMouse e

    ▸ the wheel steps a slider and focuses it

        h = new harness cols:16 rows:9
        p = new colorpicker h.screen 'test_cp'
        p.layout 0 0 16 9
        p.show()

        p.sat.setValue 50

        e =
            type: 'wheel'
            cell: [8 5]
            dir: 'up'
        p.onWheel e

        p.sat.getValue() ▸ 51
        p.focusIndex ▸ 2

    ▸ the wheel steps an rgb input and focuses it

        h = new harness cols:16 rows:9
        p = new colorpicker h.screen 'test_cp'
        p.layout 0 0 16 9
        p.show()

        p.red.setValue 100

        e =
            type: 'wheel'
            cell: [2 7]
            dir: 'down'
        p.onWheel e

        p.red.getValue() ▸ 99
        p.focusIndex ▸ 3

    ▸ a selection keeps two colors and adds the radio to the ring

        h = new harness cols:30 rows:9
        p = new colorpicker h.screen 'test_cp'
        p.layout 0 0 30 9

        p.showSelection '#ff0000' '#00ff00'

        p.selectionMode() ▸ true
        p.radio.options.length ▸ 2
        p.radio.focusable ▸ true

        p.focusTo 5
        h.key p 'tab' ''
        p.focusIndex ▸ 6

        h.key p 'tab' ''
        p.focusIndex ▸ 0

    ▸ left and right switch the active color

        h = new harness cols:30 rows:9
        p = new colorpicker h.screen 'test_cp'
        p.layout 0 0 30 9

        p.showSelection '#ff0000' '#00ff00'
        p.focusTo 6

        p.activeColor ▸ 0
        p.hex() ▸ '#ff0000'

        h.key p 'right' ''
        p.activeColor ▸ 1
        p.hex() ▸ '#00ff00'

        h.key p 'left' ''
        p.activeColor ▸ 0
        p.hex() ▸ '#ff0000'

    ▸ the radio is out of the ring in single color mode

        h = new harness cols:30 rows:9
        p = new colorpicker h.screen 'test_cp'
        p.layout 0 0 30 9

        p.show '#ff0000'

        p.selectionMode() ▸ false
        p.radio.options.length ▸ 1
        p.radio.focusable ▸ false

        p.focusTo 5
        h.key p 'tab' ''
        p.focusIndex ▸ 0

        p.onMouse
            type: 'move'
            cell: [5 1]

        p.focusIndex ▸ 0

    ▸ the radio shows the active color at the top

        h = new harness cols:30 rows:9
        p = new colorpicker h.screen 'test_cp'
        p.layout 0 0 30 9

        p.showSelection '#ff0000' '#00ff00'
        p.draw()

        h.row(1).includes('#ff0000') ▸ true
        h.row(1).includes('#00ff00') ▸ false

        p.setActiveColor 1
        p.draw()

        h.row(1).includes('#ff0000') ▸ false
        h.row(1).includes('#00ff00') ▸ true

    ▸ a focused radio shows markers around the active color

        h = new harness cols:30 rows:9
        p = new colorpicker h.screen 'test_cp'
        p.layout 0 0 30 9

        p.showSelection '#ff0000' '#00ff00'
        p.focusTo 6
        p.draw()

        h.row(1).includes('● #ff0000 ●') ▸ true

    ▸ changing the background marks it as changed

        h = new harness cols:30 rows:9
        p = new colorpicker h.screen 'test_cp'
        p.layout 0 0 30 9

        p.showSelection '#ff0000' '#0000ff'

        p.backgroundChanged() ▸ false
        p.setActiveColor 1
        p.setHex '#00ff00'

        p.backgroundChanged() ▸ true
        p.foregroundHex() ▸ '#ff0000'
        p.backgroundHex() ▸ '#00ff00'

    ▸ hovering the radio focuses it

        h = new harness cols:30 rows:9
        p = new colorpicker h.screen 'test_cp'
        p.layout 0 0 30 9

        p.showSelection '#ff0000' '#00ff00'

        p.onMouse
            type: 'move'
            cell: [5 1]

        p.focusIndex ▸ 6

    ▸ typing rgb while the background is active marks it changed

        h = new harness cols:30 rows:9
        p = new colorpicker h.screen 'test_cp'
        p.layout 0 0 30 9

        p.showSelection '#ff0000' '#00ff00'
        p.setActiveColor 1
        p.focusTo 4

        p.backgroundChanged() ▸ false

        h.type p '12'

        p.backgroundChanged() ▸ true

    ▸ up from hue goes to the two color radio

        h = new harness cols:30 rows:9
        p = new colorpicker h.screen 'test_cp'
        p.layout 0 0 30 9

        p.showSelection '#ff0000' '#00ff00'
        p.focusTo 0

        h.key p 'up' ''
        p.focusIndex ▸ 6

    ▸ up from hue stays in single color mode

        h = new harness cols:30 rows:9
        p = new colorpicker h.screen 'test_cp'
        p.layout 0 0 30 9

        p.show '#ff0000'
        p.focusTo 0

        h.key p 'up' ''
        p.focusIndex ▸ 0

    ▸ delete voids the active color

        h = new harness cols:30 rows:9
        p = new colorpicker h.screen 'test_cp'
        p.layout 0 0 30 9

        p.showSelection '#ff0000' '#00ff00'
        p.focusTo 0

        h.key p 'delete' ''
        p.colorVoided(0) ▸ true

        p.draw()
        h.row(1).includes('none') ▸ true

        h.key p 'right' ''
        p.colorVoided(0) ▸ false

    ▸ backspace voids the background

        h = new harness cols:30 rows:9
        p = new colorpicker h.screen 'test_cp'
        p.layout 0 0 30 9

        p.showSelection '#ff0000' '#00ff00'
        p.setActiveColor 1
        p.focusTo 1

        h.key p 'backspace' ''
        p.colorVoided(1) ▸ true
        p.colorVoided(0) ▸ false

    ▸ a missing background starts black

        h = new harness cols:30 rows:9
        p = new colorpicker h.screen 'test_cp'
        p.layout 0 0 30 9

        p.showSelection '#ff0000' null

        p.backgroundHex() ▸ '#000000'
        p.backgroundChanged() ▸ false
