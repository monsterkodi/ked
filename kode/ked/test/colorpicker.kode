
use ../util        ◆ harness
use ../edit        ◆ state editor
use ../view/colmns ◆ colorpicker

pickr = ->
    h = new harness cols:30 rows:9
    e = new editor h.screen 'test_editor_colorpicker' []
    p = new colorpicker h.screen e 'test_colorpicker'
    p.layout 0 0 30 9
    p.show()
    p

▸ colorpicker

    ▸ pressing a slider sets the value from the column

        p = pickr()

        e =
            type: 'press'
            cell: [11 3]
            button: 'left'
            count: 1
        p.onMouse e

        p.hue.getValue() ▸ 133

    ▸ dragging a slider keeps tracking outside of it

        p = pickr()

        e =
            type: 'press'
            cell: [5 3]
            button: 'left'
            count: 1
        p.onMouse e

        p.hue.getValue() ▸ 53

        e =
            type: 'drag'
            cell: [15 5]
            button: 'left'
            count: 1
        p.onMouse e

        p.hue.getValue() ▸ 187

        e =
            type: 'release'
            cell: [15 5]
            button: 'left'
            count: 1
        p.onMouse e

    ▸ the wheel steps an rgb input and focuses it

        p = pickr()
        p.red.setValue 100

        e =
            type: 'wheel'
            cell: [2 7]
            dir: 'down'
        p.onWheel e

        p.red.getValue() ▸ 99

    ▸ the radio is out of the ring in single color mode

        p = pickr()
        p.show '#ff0000'

        p.radio.options.length ▸ 1
        p.radio.focusable ▸ false

