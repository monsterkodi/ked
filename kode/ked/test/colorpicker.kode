
use ../../kxk    ▪ kseg sds
use ../util        ◆ harness
use ../edit        ◆ state editor
use ../edit/tool   ◆ belt colorspans
use ../theme       ◆ color theme
use ../view/base   ◆ palette radio
use ../view/editor ◆ mapview
use ../view/colmns ◆ colorpicker

pickr = ->
    h = new harness cols:30 rows:9
    e = new editor h.screen 'test_editor_colorpicker' []
    p = new colorpicker h.screen e 'test_colorpicker'
    p.layout 0 0 30 9
    p.show()
    p

sheetPickr = ->

    h = new harness cols:16 rows:9
    e = new editor h.screen 'test_editor_colorpicker_sheet' ['susan']
    e.layout 0 0 16 4

    e.state.loadLines ['                ' '                ' '                ' '                ']

    tree = {children:[{ text:'hi' x:1 y:1 w:2 h:1 fg:'#ff0000' bg:'#0000ff' }]}

    e.state.setSheetTree tree 16 4
    e.state.renderSheet tree {cols:16 rows:4} [1 1] history:false silent:true
    e.state.clearHistory()

    p = new colorpicker h.screen e 'test_colorpicker_sheet'
    p.layout 0 0 16 9
    p.show()

    [h e p]

pal = (cols colors) ->

    h = new harness cols:cols rows:2
    p = new palette h.screen 'test_palette'

    p.layout 0 0 cols 1
    p.setColors colors
    p.draw()

    [h p]

▸ colorpicker

  ▸ pressing a slider sets the value from the column

        p = pickr()

        e =
            type: 'press'
            cell: [11 3]
            button: 'left'
            count: 1
        p.onMouse e

        p.hue.getValue() ▸ 133

  ▸ dragging a slider keeps tracking outside of it

        p = pickr()

        e =
            type: 'press'
            cell: [5 3]
            button: 'left'
            count: 1
        p.onMouse e

        p.hue.getValue() ▸ 53

        e =
            type: 'drag'
            cell: [15 5]
            button: 'left'
            count: 1
        p.onMouse e

        p.hue.getValue() ▸ 187

        e =
            type: 'release'
            cell: [15 5]
            button: 'left'
            count: 1
        p.onMouse e

  ▸ a syntax color at the cursor seeds the picker

        h = new harness cols:30 rows:9
        e = new editor h.screen 'test_editor_colorpicker_syntax' []
        e.state.syntax.ext = 'kode'
        e.state.loadLines ['class Foo']
        e.state.setMainCursor 5 0

        p = new colorpicker h.screen e 'test_colorpicker_syntax'
        p.layout 0 0 30 9
        p.show()

        p.foregroundHex() ▸ (color.hex(theme.syntax.keyword))

  ▸ an rgb input change updates the color

        p = pickr()

        p.setHex '#000000'
        p.syncAll()

        p.red.changeValue 255

        p.foregroundHex() ▸ '#ff0000'

  ▸ a sheet node at the cursor seeds the picker

        [h e p] = sheetPickr()

        p.foregroundHex() ▸ '#ff0000'
        p.backgroundHex() ▸ '#0000ff'

  ▸ a sheet node with only a background selects it

        h = new harness cols:16 rows:9
        e = new editor h.screen 'test_editor_colorpicker_sheet_bg' []
        e.layout 0 0 16 4

        e.state.loadLines ['                ' '                ' '                ' '                ']
        e.state.rectree = {children:[{ text:'hi' x:1 y:1 w:2 h:1 bg:'#0000ff' }]}
        e.state.rectreeCols = 16
        e.state.rectreeRows = 4
        e.state.setCursors [[1 1]]

        p = new colorpicker h.screen e 'test_colorpicker_sheet_bg'
        p.layout 0 0 16 9
        p.show()

        p.activeIndex() ▸ 1
        p.colorVoided 0 ▸ true
        p.backgroundHex() ▸ '#0000ff'
        p.radio.options[0].label ▸ 'none'
        p.radio.options[1].label ▸ '#0000ff'

  ▸ a sheet node passed in is updated live

        h = new harness cols:16 rows:9
        e = new editor h.screen 'test_editor_colorpicker_sheet_node' []
        e.layout 0 0 16 4

        e.state.loadLines ['                ' '                ' '                ' '                ']
        e.state.rectree = {bg:'#0000ff'}
        e.state.rectreeCols = 16
        e.state.rectreeRows = 4
        e.state.setCursors [[1 1]]

        p = new colorpicker h.screen e 'test_colorpicker_sheet_node'
        p.layout 0 0 16 9
        p.show [null '#0000ff'] node:e.state.rectree

        p.setHex '#ff0000' 1
        p.emitChanged()

        sds.get(e.state.rectree 'bg') ▸ '#ff0000'
        noFg = not e.state.rectree.fg?
        noFg ▸ true

  ▸ return sets the colors on the sheet node

        [h e p] = sheetPickr()

        p.setHex '#00ff00' 0
        p.setHex '#000000' 1
        p.submit()

        sds.get(e.state.rectree 'children.0.fg') ▸ '#00ff00'
        sds.get(e.state.rectree 'children.0.bg') ▸ '#000000'

  ▸ changing a color updates the sheet live

        [h e p] = sheetPickr()

        p.setHex '#123456' 0
        p.emitChanged()

        sds.get(e.state.rectree 'children.0.fg') ▸ '#123456'

        e.draw()

        h.screen.get_fg(2 1) ▸ [18 52 86]

  ▸ a sheet color change can be undone

        [h e p] = sheetPickr()

        p.setHex '#123456' 0
        p.emitChanged()

        sds.get(e.state.rectree 'children.0.fg') ▸ '#123456'

        e.state.undo()

        sds.get(e.state.rectree 'children.0.fg') ▸ '#ff0000'

  ▸ a color drag is one undo step

        [h e p] = sheetPickr()

        p.setHex '#123456' 0
        p.emitChanged()
        p.setHex '#654321' 0
        p.emitChanged()
        p.hide()

        e.state.undo()

        sds.get(e.state.rectree 'children.0.fg') ▸ '#ff0000'

  ▸ a voided channel is removed from the sheet node

        [h e p] = sheetPickr()

        p.voidActiveColor()
        p.submit()

        noFg = not sds.get(e.state.rectree 'children.0.fg')?
        noFg ▸ true

▸ colorpicker palette

  ▸ the palette starts empty

        p = pickr()

        p.palette ▸ []
        p.pickerHeight() ▸ 9

  ▸ the palette holds eight colors by default

        p = pickr()

        p.paletteMax ▸ 8

  ▸ the current color is added to the palette

        p = pickr()
        p.setHex '#ff0000'
        p.addCurrentColor()

        p.palette ▸ ['#ff0000']

  ▸ a color is not added twice

        p = pickr()
        p.setHex '#ff0000'
        p.addCurrentColor()
        p.addCurrentColor()

        p.palette.length ▸ 1

  ▸ the leftmost color is dropped when the palette is full

        p = pickr()
        p.paletteMax = 3

        for hex in ['#ff0000' '#00ff00' '#0000ff']
            p.setHex hex
            p.addCurrentColor()

        p.setHex '#ffffff'
        p.addCurrentColor()

        p.palette ▸ ['#00ff00' '#0000ff' '#ffffff']

  ▸ the picker grows by two rows when the palette is not empty

        p = pickr()
        p.setHex '#ff0000'
        p.addCurrentColor()

        p.pickerHeight() ▸ 11

  ▸ enter on a palette cell sets the current color

        p = pickr()
        p.setHex '#ff0000'
        p.addCurrentColor()

        p.setHex '#00ff00'

        p.paletteView.setActive 0
        p.paletteView.grabFocus()

        e =
            type: 'press'
            combo: 'return'
            char: ''
        p.onKey 'return' e

        p.hex() ▸ '#ff0000'

  ▸ the palette is not in the focus ring when it is empty

        p = pickr()

        p.focusRing.includes(p.paletteView) ▸ false

        p.setHex '#ff0000'
        p.addCurrentColor()

        p.layout 0 0 30 11
        p.draw()

        p.focusRing.includes(p.paletteView) ▸ true

▸ colorspans

  ▸ overlay adds a span

        lines = [['a' 'b' 'c' 'd' 'e']]

        spans = colorspans.overlay [] [[1 0 4 0]] '#f00' lines

        spans ▸ [[1 0 4 '#f00']]

  ▸ overlay splits an existing span

        lines = [['a' 'b' 'c' 'd' 'e']]

        spans = colorspans.overlay [[0 0 5 '#00f']] [[2 0 3 0]] '#f00' lines

        spans ▸ [[0 0 2 '#00f'] [2 0 3 '#f00'] [3 0 5 '#00f']]

  ▸ overlay turns a multiline range into lines

        lines = [['a' 'b' 'c' 'd' 'e'] ['a' 'b' 'c' 'd' 'e'] ['a' 'b' 'c' 'd' 'e']]

        spans = colorspans.overlay [] [[2 0 3 2]] '#f00' lines

        spans ▸ [[2 0 5 '#f00'] [0 1 5 '#f00'] [0 2 3 '#f00']]

  ▸ normalize merges touching spans of the same color

        spans = colorspans.normalize [[0 0 2 '#f00'] [2 0 4 '#f00'] [5 0 6 '#0f0']]

        spans ▸ [[0 0 4 '#f00'] [5 0 6 '#0f0']]

  ▸ clear removes and splits

        spans = colorspans.clear [[0 0 5 '#00f'] [6 0 9 '#00f']] [[2 0 7 0]]

        spans ▸ [[0 0 2 '#00f'] [7 0 9 '#00f']]

  ▸ an insertion inside a span stretches it

        oldLines = [['a' 'b' 'c' 'd']]
        newLines = [['a' 'b' 'X' 'c' 'd']]

        spans = colorspans.adjust [[0 0 4 '#f00']] oldLines newLines

        spans ▸ [[0 0 5 '#f00']]

  ▸ an insertion before a span moves it

        oldLines = [['a' 'b' 'c' 'd']]
        newLines = [['a' 'b' 'X' 'c' 'd']]

        spans = colorspans.adjust [[2 0 4 '#f00']] oldLines newLines

        spans ▸ [[3 0 5 '#f00']]

  ▸ a deletion inside a span shrinks it

        oldLines = [['a' 'b' 'c' 'd' 'e']]
        newLines = [['a' 'b' 'e']]

        spans = colorspans.adjust [[0 0 5 '#f00']] oldLines newLines

        spans ▸ [[0 0 3 '#f00']]

  ▸ inserting a line moves spans below

        oldLines = [['a'] ['b'] ['c']]
        newLines = [['a'] ['x'] ['b'] ['c']]

        spans = colorspans.adjust [[0 1 1 '#f00'] [0 2 1 '#0f0']] oldLines newLines

        spans ▸ [[0 2 1 '#f00'] [0 3 1 '#0f0']]

  ▸ deleting a line moves spans below

        oldLines = [['a'] ['x'] ['b'] ['c']]
        newLines = [['a'] ['b'] ['c']]

        spans = colorspans.adjust [[0 2 1 '#f00'] [0 3 1 '#0f0']] oldLines newLines

        spans ▸ [[0 1 1 '#f00'] [0 2 1 '#0f0']]

  ▸ colorAtPos finds the span at a position

        spans = [[1 2 4 '#f00'] [6 2 9 '#0f0']]

        colorspans.colorAtPos spans [2 2] ▸ '#f00'
        colorspans.colorAtPos spans [5 2] ▸ null
        colorspans.colorAtPos spans [6 2] ▸ '#0f0'

▸ colorstate

  ▸ the map can use colors passed in for a preview

        h = new harness cols:20 rows:5
        e = new editor h.screen 'test_color_map' []

        e.layout 0 0 20 5
        e.state.loadLines ['abcdef']

        m = new mapview h.screen e.state
        m.setSyntaxSegls 'txt' e.state.s.lines
        m.setColors
            fg: [[1 0 2 '#00ff00']]
            bg: []

        data = Buffer.alloc 120
        m.imageForLine data e.state.s.lines[0] 0

        data[6]  ▸ 0
        data[7]  ▸ 255
        data[8]  ▸ 0

▸ palette

  ▸ a cell shows its color

        [h p] = pal 20 ['#ff0000' '#00ff00']

        h.screen.get_bg(5 0) ▸ [255 0 0]
        h.screen.get_bg(15 0) ▸ [0 255 0]

  ▸ one narrow cell keeps all the cells from showing their hex value

        [h p] = pal 20 ['#ff0000' '#00ff00' '#0000ff']

        h.row(0).includes('#ff0000') ▸ false
        h.row(0).includes('#00ff00') ▸ false
        h.row(0).includes('#0000ff') ▸ false

  ▸ a narrow cell shows no hex value

        [h p] = pal 10 ['#ff0000' '#00ff00']

        h.row(0).includes('#ff0000') ▸ false
        h.row(0).includes('#00ff00') ▸ false

  ▸ the palette has rounded edges

        [h p] = pal 20 ['#ff0000']

        h.screen.get_char(0 0) ▸ '◖'
        h.screen.get_char(19 0) ▸ '◗'

  ▸ an empty palette has no cells

        [h p] = pal 20 []

        p.options.length ▸ 0
        h.screen.get_bg(0 0) ▸ []

▸ radio

  ▸ a single option fills the row and shows its label

        h = new harness cols:20 rows:2
        r = new radio h.screen 'test_radio'

        r.layout 0 0 20 1
        r.setOptions [{color: [255 255 255] label: '#ffffff'}]
        r.draw()

        h.row(0).includes('#ffffff') ▸ true
        h.screen.get_char(0 0) ▸ '◖'
        h.screen.get_char(19 0) ▸ '◗'
        h.screen.get_bg(10 0) ▸ [255 255 255]

  ▸ only the active option shows a label

        h = new harness cols:20 rows:2
        r = new radio h.screen 'test_radio'

        r.layout 0 0 20 1
        r.setOptions [{color: [255 255 255] label: '#ffffff'} {color: [0 0 255] label: '#0000ff'}]

        r.draw()

        h.row(0).includes('#ffffff') ▸ true
        h.row(0).includes('#0000ff') ▸ false
        h.screen.get_bg(2 0) ▸ [255 255 255]
        h.screen.get_bg(17 0) ▸ [0 0 255]

        r.setActive 1
        r.draw()

        h.row(0).includes('#ffffff') ▸ false
        h.row(0).includes('#0000ff') ▸ true

  ▸ the active label gets focus markers when they fit

        h = new harness cols:20 rows:2
        r = new radio h.screen 'test_radio'

        r.layout 0 0 20 1
        r.setOptions [{color: [255 255 255] label: '#ffffff'} {color: [0 0 255] label: '#0000ff'}]
        r.setActive 1
        r.grabFocus()
        r.draw()

        h.row(0).includes('●#0000ff●') ▸ true

▸ color

  ▸ hex
    
        color.hex [0 0 0]     ▸ '#000000'
        color.hex [0 255 0]   ▸ '#00ff00'
        color.hex [255 255 0] ▸ '#ffff00'
        
        color.hex '#ffff00'   ▸ '#ffff00'
        
  ▸ darken
    
        color.darken color.values('ffff00') 1    ▸ color.values '#ffff00'
        color.darken color.values('ffff00') 0.9  ▸ color.values '#e5e500'
        color.darken color.values('ffff00') 0.8  ▸ color.values '#cccc00'
        color.darken color.values('ffff00') 0.7  ▸ color.values '#b2b200'
        color.darken color.values('ffff00') 0.6  ▸ color.values '#999900'
        color.darken color.values('ffff00')      ▸ color.values '#7f7f00'
        color.darken color.values('ffff00') 0.4  ▸ color.values '#666600'
        color.darken color.values('ffff00') 0.3  ▸ color.values '#4c4c00'
        color.darken color.values('ffff00') 0.2  ▸ color.values '#333300'
        color.darken color.values('ffff00') 0.1  ▸ color.values '#191900'
        color.darken color.values('ffff00') 0    ▸ color.values '#000000'
        
  ▸ colorSeglsForText
    
        belt.colorSeglsForText "hello\nworld" ▸ [[] kseg.segls("hello\nworld")]
        belt.colorSeglsForText r5("red") ▸ [[[x:0 fg:[255 0 0] w:3]] kseg.segls("red")]
        belt.colorSeglsForText r5("red") + g5("green") ▸ [[[{x:0 fg:[255 0 0] w:3} {x:3 fg:[0 255 0] w:5}]] kseg.segls("redgreen")]
        belt.colorSeglsForText G5(r5("redOnGreen")) ▸ [[[{x:0 bg:[0 255 0] w:10}{x:0 fg:[255 0 0] w:10}]] kseg.segls("redOnGreen")]

        belt.colorSeglsForText color.bg_rgb([12 123 234])+("bgrgb") ▸ [[[{x:0 bg:[12 123 234]}]] kseg.segls("bgrgb")]
        belt.colorSeglsForText color.fg_rgb([12 123 234])+("fgrgb") ▸ [[[{x:0 fg:[12 123 234]}]] kseg.segls("fgrgb")]
        belt.colorSeglsForText color.bg_rgb([12 123 234])+color.fg_rgb([12 123 234])+("rgb") ▸ [[[{x:0 bg:[12 123 234]} {x:0 fg:[12 123 234]}]] kseg.segls("rgb")]

        belt.colorSeglsForText "▸ #{color.fg_rgb([255 255 00])}#{color.fg_rgb()} ms" ▸ [[[{x:2 fg:[255 255 0] w:1}]] kseg.segls("▸  ms")]
        
  ▸ adjustForBackground
    
        color.adjustForBackground [255 255 0] [0 0 0]         ▸ [255 255 0]
        color.adjustForBackground [255 255 0] [200 200 0]     ▸ [76 77 0]
        color.adjustForBackground [255 255 255] [170 170 170] ▸ [51 51 51]
