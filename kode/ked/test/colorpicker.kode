
use ../../kxk    ▪ kseg sds
use ../util        ◆ harness
use ../edit        ◆ state editor
use ../edit/tool   ◆ belt colorspans
use ../theme       ◆ color theme
use ../view/base   ◆ palette radio
use ../view/editor ◆ mapview
use ../view/colmns ◆ colorpicker

pickr = ->
    h = new harness cols:30 rows:9
    e = new editor h.screen 'test_editor_colorpicker' []
    p = new colorpicker h.screen e 'test_colorpicker'
    p.layout 0 0 30 9
    p.show()
    p

sheetPickr = (colors=true) ->
    h = new harness cols:16 rows:9
    e = new editor h.screen 'test_editor_colorpicker_sheet' ['susan']
    e.layout 0 0 16 4
    e.state.loadLines ['                ' '                ' '                ' '                ']
    tree = {children:[{ text:'hi' x:1 y:1 w:2 h:1 bg:'#0000ff' }]}
    tree.children[0].fg = '#ff0000' if colors
    e.state.setSheetTree tree 16 4
    e.state.renderSheet tree {cols:16 rows:4} [1 1] history:false silent:true
    e.state.clearHistory()
    p = new colorpicker h.screen e 'test_colorpicker_sheet'
    p.layout 0 0 16 9
    p.show()
    [h e p]

pal = (cols colors) ->
    h = new harness cols:cols rows:2
    p = new palette h.screen 'test_palette'
    p.layout 0 0 cols 1
    p.setColors colors
    p.draw()
    [h p]

rad = ->
    h = new harness cols:20 rows:2
    r = new radio h.screen 'test_radio'
    r.layout 0 0 20 1
    [h r]

▸ colorpicker

  ▸ slider

        p = pickr()

        e =
            type:   'press'
            cell:   [11 3]
            button: 'left'
            count:  1
        p.onMouse e

        p.hue.getValue() ▸ 133

        p = pickr()

        e =
            type:   'press'
            cell:   [5 3]
            button: 'left'
            count:  1
        p.onMouse e

        p.hue.getValue() ▸ 53

        e =
            type:   'drag'
            cell:   [15 5]
            button: 'left'
            count:  1
        p.onMouse e

        p.hue.getValue() ▸ 187

        e =
            type:   'release'
            cell:   [15 5]
            button: 'left'
            count:  1
        p.onMouse e

  ▸ seeds

        h = new harness cols:30 rows:9
        e = new editor h.screen 'test_editor_colorpicker_syntax' []
        e.state.syntax.ext = 'kode'
        e.state.loadLines ['class Foo']
        e.state.setMainCursor 5 0

        p = new colorpicker h.screen e 'test_colorpicker_syntax'
        p.layout 0 0 30 9
        p.show()

        p.foregroundHex() ▸ (color.hex(theme.syntax.keyword))

        [h e p] = sheetPickr()

        p.foregroundHex() ▸ '#ff0000'
        p.backgroundHex() ▸ '#0000ff'

        [h e p] = sheetPickr false

        p.activeIndex() ▸ 1
        p.colorVoided 0 ▸ true
        p.backgroundHex() ▸ '#0000ff'
        p.radio.options[0].label ▸ 'none'
        p.radio.options[1].label ▸ '#0000ff'

  ▸ live

        p = pickr()

        p.setHex '#000000'
        p.syncAll()
        p.red.changeValue 255

        p.foregroundHex() ▸ '#ff0000'

        [h e p] = sheetPickr()

        p.setHex '#00ff00' 0
        p.setHex '#000000' 1
        p.submit()

        sds.get(e.state.rectree 'children.0.fg') ▸ '#00ff00'
        sds.get(e.state.rectree 'children.0.bg') ▸ '#000000'

        [h e p] = sheetPickr()

        p.setHex '#123456' 0
        p.emitChanged()

        sds.get(e.state.rectree 'children.0.fg') ▸ '#123456'

        e.draw()

        h.screen.get_fg(2 1) ▸ [18 52 86]

        h = new harness cols:16 rows:9
        e = new editor h.screen 'test_editor_colorpicker_sheet_node' []
        e.layout 0 0 16 4
        e.state.loadLines ['                ' '                ' '                ' '                ']
        e.state.rectree = {bg:'#0000ff'}
        e.state.setCursors [[1 1]]

        p = new colorpicker h.screen e 'test_colorpicker_sheet_node'
        p.layout 0 0 16 9
        p.show [null '#0000ff'] node:e.state.rectree

        p.setHex '#ff0000' 1
        p.emitChanged()

        sds.get(e.state.rectree 'bg') ▸ '#ff0000'
        noFg = not e.state.rectree.fg?
        noFg ▸ true

  ▸ undo

        [h e p] = sheetPickr()

        p.setHex '#123456' 0
        p.emitChanged()

        sds.get(e.state.rectree 'children.0.fg') ▸ '#123456'

        e.state.undo()

        sds.get(e.state.rectree 'children.0.fg') ▸ '#ff0000'

        [h e p] = sheetPickr()

        p.setHex '#123456' 0
        p.emitChanged()
        p.setHex '#654321' 0
        p.emitChanged()
        p.hide()

        e.state.undo()

        sds.get(e.state.rectree 'children.0.fg') ▸ '#ff0000'

  ▸ void

        [h e p] = sheetPickr()

        p.voidActiveColor()
        p.submit()

        noFg = not sds.get(e.state.rectree 'children.0.fg')?
        noFg ▸ true

▸ colorpicker palette

  ▸ palette

        p = pickr()

        p.palette ▸ []
        p.pickerHeight() ▸ 9
        p.paletteMax ▸ 8

        p.setHex '#ff0000'
        p.addCurrentColor()
        p.addCurrentColor()

        p.palette ▸ ['#ff0000']

        p.paletteMax = 3

        for hex in ['#ff0000' '#00ff00' '#0000ff']
            p.setHex hex
            p.addCurrentColor()

        p.setHex '#ffffff'
        p.addCurrentColor()

        p.palette ▸ ['#00ff00' '#0000ff' '#ffffff']

  ▸ height

        p = pickr()

        p.pickerHeight() ▸ 9

        p.setHex '#ff0000'
        p.addCurrentColor()

        p.pickerHeight() ▸ 11

  ▸ enter

        p = pickr()

        p.setHex '#ff0000'
        p.addCurrentColor()

        p.setHex '#00ff00'

        p.paletteView.setActive 0
        p.paletteView.grabFocus()

        e =
            type:  'press'
            combo: 'return'
            char:  ''
        p.onKey 'return' e

        p.hex() ▸ '#ff0000'

  ▸ focus ring

        p = pickr()

        p.focusRing.includes(p.paletteView) ▸ false

        p.setHex '#ff0000'
        p.addCurrentColor()

        p.layout 0 0 30 11
        p.draw()

        p.focusRing.includes(p.paletteView) ▸ true

▸ colorspans

  ▸ overlay

        lines = [['a' 'b' 'c' 'd' 'e']]

        colorspans.overlay [] [[1 0 4 0]] '#f00' lines ▸ [[1 0 4 '#f00']]

        spans = [[0 0 5 '#00f']]
        colorspans.overlay spans [[2 0 3 0]] '#f00' lines ▸ [[0 0 2 '#00f'] [2 0 3 '#f00'] [3 0 5 '#00f']]

        lines = [['a' 'b' 'c' 'd' 'e'] ['a' 'b' 'c' 'd' 'e'] ['a' 'b' 'c' 'd' 'e']]

        colorspans.overlay [] [[2 0 3 2]] '#f00' lines ▸ [[2 0 5 '#f00'] [0 1 5 '#f00'] [0 2 3 '#f00']]

  ▸ adjust

        oldLines = [['a' 'b' 'c' 'd']]
        newLines = [['a' 'b' 'X' 'c' 'd']]

        colorspans.adjust [[0 0 4 '#f00']] oldLines newLines ▸ [[0 0 5 '#f00']]
        colorspans.adjust [[2 0 4 '#f00']] oldLines newLines ▸ [[3 0 5 '#f00']]

        oldLines = [['a' 'b' 'c' 'd' 'e']]
        newLines = [['a' 'b' 'e']]

        colorspans.adjust [[0 0 5 '#f00']] oldLines newLines ▸ [[0 0 3 '#f00']]

        oldLines = [['a'] ['b'] ['c']]
        newLines = [['a'] ['x'] ['b'] ['c']]

        colorspans.adjust [[0 1 1 '#f00'] [0 2 1 '#0f0']] oldLines newLines ▸ [[0 2 1 '#f00'] [0 3 1 '#0f0']]

        oldLines = [['a'] ['x'] ['b'] ['c']]
        newLines = [['a'] ['b'] ['c']]

        colorspans.adjust [[0 2 1 '#f00'] [0 3 1 '#0f0']] oldLines newLines ▸ [[0 1 1 '#f00'] [0 2 1 '#0f0']]

  ▸ normalize

        colorspans.normalize [[0 0 2 '#f00'] [2 0 4 '#f00'] [5 0 6 '#0f0']] ▸ [[0 0 4 '#f00'] [5 0 6 '#0f0']]

  ▸ clear

        colorspans.clear [[0 0 5 '#00f'] [6 0 9 '#00f']] [[2 0 7 0]] ▸ [[0 0 2 '#00f'] [7 0 9 '#00f']]

  ▸ colorAtPos

        spans = [[1 2 4 '#f00'] [6 2 9 '#0f0']]

        colorspans.colorAtPos spans [2 2] ▸ '#f00'
        colorspans.colorAtPos spans [5 2] ▸ null
        colorspans.colorAtPos spans [6 2] ▸ '#0f0'

▸ colorstate

  ▸ map preview

        h = new harness cols:20 rows:5
