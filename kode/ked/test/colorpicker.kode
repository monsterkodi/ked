
use ../util        ◆ harness
use ../edit        ◆ state editor
use ../theme       ◆ color theme
use ../view/colmns ◆ colorpicker

pickr = ->
    h = new harness cols:30 rows:9
    e = new editor h.screen 'test_editor_colorpicker' []
    p = new colorpicker h.screen e 'test_colorpicker'
    p.layout 0 0 30 9
    p.show()
    p

▸ colorpicker

  ▸ pressing a slider sets the value from the column

        p = pickr()

        e =
            type: 'press'
            cell: [11 3]
            button: 'left'
            count: 1
        p.onMouse e

        p.hue.getValue() ▸ 133

  ▸ dragging a slider keeps tracking outside of it

        p = pickr()

        e =
            type: 'press'
            cell: [5 3]
            button: 'left'
            count: 1
        p.onMouse e

        p.hue.getValue() ▸ 53

        e =
            type: 'drag'
            cell: [15 5]
            button: 'left'
            count: 1
        p.onMouse e

        p.hue.getValue() ▸ 187

        e =
            type: 'release'
            cell: [15 5]
            button: 'left'
            count: 1
        p.onMouse e

  ▸ the wheel steps an rgb input and focuses it

        p = pickr()
        p.red.setValue 100

        e =
            type: 'wheel'
            cell: [2 7]
            dir: 'down'
        p.onWheel e

        p.red.getValue() ▸ 99

  ▸ the radio is out of the ring in single color mode

        p = pickr()
        p.show '#ff0000'

        p.radio.options.length ▸ 1
        p.radio.focusable ▸ false

  ▸ a syntax color at the cursor seeds the picker

        h = new harness cols:30 rows:9
        e = new editor h.screen 'test_editor_colorpicker_syntax' []
        e.state.syntax.ext = 'kode'
        e.state.loadLines ['class Foo']
        e.state.setMainCursor 5 0

        p = new colorpicker h.screen e 'test_colorpicker_syntax'
        p.layout 0 0 30 9
        p.show()

        p.foregroundHex() ▸ (color.hex(theme.syntax.keyword))

▸ colorpicker palette

  ▸ the palette starts empty

        p = pickr()

        p.palette ▸ []
        p.pickerHeight() ▸ 9

  ▸ the palette holds eight colors by default

        p = pickr()

        p.paletteMax ▸ 8

  ▸ the current color is added to the palette

        p = pickr()
        p.setHex '#ff0000'
        p.addCurrentColor()

        p.palette ▸ ['#ff0000']

  ▸ a color is not added twice

        p = pickr()
        p.setHex '#ff0000'
        p.addCurrentColor()
        p.addCurrentColor()

        p.palette.length ▸ 1

  ▸ the leftmost color is dropped when the palette is full

        p = pickr()
        p.paletteMax = 3

        for hex in ['#ff0000' '#00ff00' '#0000ff']
            p.setHex hex
            p.addCurrentColor()

        p.setHex '#ffffff'
        p.addCurrentColor()

        p.palette ▸ ['#00ff00' '#0000ff' '#ffffff']

  ▸ the picker grows by two rows when the palette is not empty

        p = pickr()
        p.setHex '#ff0000'
        p.addCurrentColor()

        p.pickerHeight() ▸ 11

  ▸ enter on a palette cell sets the current color

        p = pickr()
        p.setHex '#ff0000'
        p.addCurrentColor()

        p.setHex '#00ff00'

        p.paletteView.setActive 0
        p.paletteView.grabFocus()

        e =
            type: 'press'
            combo: 'return'
            char: ''
        p.onKey 'return' e

        p.hex() ▸ '#ff0000'

  ▸ backspace on a focused palette cell removes it

        p = pickr()
        p.setHex '#ff0000'
        p.addCurrentColor()
        p.setHex '#00ff00'
        p.addCurrentColor()

        p.paletteView.setActive 1
        p.paletteView.grabFocus()

        e =
            type: 'press'
            combo: 'backspace'
            char: ''
        p.onKey 'backspace' e

        p.palette ▸ ['#ff0000']

  ▸ the palette is not in the focus ring when it is empty

        p = pickr()

        p.focusRing.includes(p.paletteView) ▸ false

        p.setHex '#ff0000'
        p.addCurrentColor()

        p.layout 0 0 30 11
        p.draw()

        p.focusRing.includes(p.paletteView) ▸ true

