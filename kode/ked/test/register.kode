use ../edit/register

▸ registers

  ▸ named and unnamed registers

        r = new register

        r.write '"' { lines: ['one'] linewise: false } 'yank'

        r.read('"').lines  ▸ ['one']
        r.read('0').lines  ▸ ['one']

        r.write 'a' { lines: ['aye'] linewise: false } 'yank'

        r.read('a').lines  ▸ ['aye']
        r.read('"').lines  ▸ ['aye']
        r.read('0').lines  ▸ ['one']

        r.write 'A' { lines: ['two'] linewise: true } 'yank'

        r.read('a').lines  ▸ ['aye' 'two']

  ▸ numbered registers

        r = new register

        r.write 'a' { lines: ['first'] linewise: true } 'delete'

        r.read('"').lines  ▸ ['first']
        r.read('1').lines  ▸ ['first']

        r.write 'b' { lines: ['second'] linewise: true } 'delete'

        r.read('1').lines  ▸ ['second']
        r.read('2').lines  ▸ ['first']

        r.write 'x' { lines: ['small'] linewise: false } 'delete'

        r.read('-').lines  ▸ ['small']
        r.read('1').lines  ▸ ['second']

  ▸ black hole

        r = new register

        r.write 'a' { lines: ['keep'] linewise: true } 'delete'
        r.write '_' { lines: ['gone'] linewise: true } 'delete'

        r.read('"').lines  ▸ ['keep']
        r.read('a').lines  ▸ ['keep']
        r.read('1').lines  ▸ ['keep']

  ▸ macro registers

        r = new register

        keys =
            [{ key: 'x' combo: 'x' char: 'x' }
             { key: 'return' combo: 'return' char: '\n' }]

        r.setMacro 'a' keys

        r.read('a').keys.length        ▸ 2
        register.textForValue(r.read('a'))    ▸ "x\n"

        r.setMacro 'A' [{ key: 'j' combo: 'j' char: 'j' }]

        r.read('a').keys.length        ▸ 3
        register.textForValue(r.read('a'))    ▸ "x\nj"

        parsed = register.keysForText "x<Esc>y"

        parsed.length                  ▸ 3
        parsed[1].key                  ▸ 'esc'
