
use fs
use ../../kxk ▪ slash sleep post watcher
use ../util   ◆ config
###
▸ config

  ▸ reloads when the config file changes

        dir  = '/tmp/opencode/ked-config-reload'
        file = slash.path dir 'config'

        fs.rmSync dir recursive:true force:true
        fs.mkdirSync dir recursive:true
        fs.writeFileSync file 'value\n    number  111'

        savedData = config.data
        savedFile = config.file

        config.file = file
        ○ config.load()
        ○ config.loaded

        config.data.value.number ▸ 111

        reloads = 0
        post.on 'config.loaded' -> reloads += 1

        fs.writeFileSync file 'value\n    number  2222'
        ○ sleep 300

        reloads ▸ 1
        config.data.value.number ▸ 2222

        fs.writeFileSync slash.path(dir 'other') 'unrelated'
        ○ sleep 200

        reloads ▸ 1

        watcher.close()

        config.data = savedData
        config.file = savedFile

        fs.rmSync dir recursive:true force:true
###