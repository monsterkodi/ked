use child_process ▪ spawn
use ../../kxk    ▪ slash

▸ file arguments

    ▸ existing extra files go to the filepos history

        first  = slash.path(process.cwd() 'kode/ked/ked.kode')
        second = slash.path(process.cwd() 'kode/ked/ked.md')
        third  = slash.path(process.cwd() 'kode/ked/help.md')
        gone   = slash.path(process.cwd() 'doesntexist')

        output =○ new Promise (resolve) ->
            
            proc = spawn slash.path(process.cwd() 'bin' 'ked') ['-H' '--fresh' first, gone, second, third]
            
            out = ''
            
            proc.stdout.on 'data' (data) -> out += data
            proc.stderr.on 'data' (data) -> out += data
            
            proc.on 'close' (code) -> resolve out
            
            proc.stdin.write '\x1b[49;3u' # alt+1 goes backward in the filepos history
            proc.stdin.end()
            
        output.includes("[file: #{first}]")  ▸ true
        output.includes("[file: #{second}]") ▸ true
        output.includes("[file: #{gone}]")   ▸ false

    ▸ a missing first argument stays the current history entry

        first  = slash.path(process.cwd() 'doesntexist')
        second = slash.path(process.cwd() 'kode/ked/ked.md')

        output =○ new Promise (resolve) ->
            
            proc = spawn slash.path(process.cwd() 'bin' 'ked') ['-H' '--fresh' first, second]
            
            out = ''
            
            proc.stdout.on 'data' (data) -> out += data
            proc.stderr.on 'data' (data) -> out += data
            
            proc.on 'close' (code) -> resolve out
            
            proc.stdin.write '\x1b[49;3u' # alt+1 goes backward in the filepos history
            proc.stdin.end()
            
        output.includes("[file: #{first}]")  ▸ true
        output.includes("[file: #{second}]") ▸ true
