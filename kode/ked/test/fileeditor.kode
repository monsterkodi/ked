
use ../../kxk       ▪ sleep
use ../util        ◆ harness
use ../view/editor ◆ fileeditor

setup = ->

    store = {}

    global.ked_session =
        get: (key def) -> store[key] ? def
        set: (key value) -> store[key] = value

    h = new harness cols:40 rows:12
    h.t.cellsz = [10 20]

    e = new fileeditor h.screen 'test_fileeditor'
    e.layout 0 0 40 12

    h.t.out = []

    [h e]

▸ fileeditor

  ▸ a cell rect is covered by a transparent overlay

        [h e] = setup()

        e.onCellsRect {x:2 y:1 w:3 h:4}

        h.t.written().includes "\x1b[2;8H" ▸ true

        ◯ sleep 10
        delete global.ked_session

  ▸ an empty rect places no overlay

        [h e] = setup()

        e.onCellsRect {x:2 y:1 w:0 h:4}

        h.t.written().includes 'a=p' ▸ false

        ◯ sleep 10
        delete global.ked_session
