use fs
use ../../kxk      ▪ kseg post slash sleep watcher
use ../edit        ◆ editor
use ../util        ◆ harness git
use ../index       ◆ indexer
use ../view/colmns ◆ dircol dirtree funcol funtree

ked_sess = ->
    store = {}
    fakeGet = (key def) -> store[key] ? def
    fakeSet = (key value) -> store[key] = value
    global.ked_session = get:fakeGet set:fakeSet

dircolAt = (root) ◯->
    ked_sess()
    h = new harness cols:100 rows:30
    e = new editor h.screen 'test_editor' []
    d = new dircol h.screen e []
    d.layout 0 0 100 30
    d.setRoot root
    ◯ sleep 10
    d

funcolAt = (lines col) ->
    ked_sess()
    h = new harness cols:100 rows:30
    e = new editor h.screen 'test_editor' []
    e.state.loadLines lines
    e.state.setMainCursor col 0
    f = new funcol h.screen e []
    [h e f]

capture = ->
    sent = []
    orig = post.emit
    post.emit = (event args...) -> sent.push [event].concat(args)
    [sent orig]

tree = (name base child) ◯->
    ked_sess()
    root = "/tmp/opencode/ked-funtree-#{name}"
    baseFile = slash.path root 'base.kode'
    childFile = slash.path root 'child.kode'
    fs.rmSync root recursive:true force:true
    fs.mkdirSync root recursive:true
    fs.writeFileSync baseFile base
    fs.writeFileSync childFile child
    idx = new indexer
    ◯ idx.index baseFile
    ◯ idx.index childFile
    h = new harness cols:100 rows:30
    e = new editor h.screen 'test_funtree_editor' []
    e.currentFile = childFile
    f = new funtree e 'test_funtree' []
    f.onFileIndexed childFile idx.files[childFile]
    fs.rmSync root recursive:true force:true
    [f e baseFile childFile]

cppTree = (name source) ◯->
    ked_sess()
    root = "/tmp/opencode/ked-funtree-#{name}"
    file = slash.path root 'main.cpp'
    fs.rmSync root recursive:true force:true
    fs.mkdirSync root recursive:true
    fs.writeFileSync file source
    idx = new indexer
    ◯ idx.index file
    h = new harness cols:100 rows:30
    e = new editor h.screen 'test_funtree_cpp_editor' []
    e.currentFile = file
    f = new funtree e 'test_funtree_cpp' []
    f.onFileIndexed file idx.files[file]
    fs.rmSync root recursive:true force:true
    f

▸ dircol

  ▸ roots

        d = ◯ dircolAt 'kode'

        d.crumbs.path ▸ slash.tilde(slash.path(process.cwd() 'kode'))
        d.crumbs.split[0] ▸ '~'

        d = ◯ dircolAt './kode'

        d.crumbs.path ▸ slash.tilde(slash.path(process.cwd() 'kode'))
        d.crumbs.split[0] ▸ '~'

        d = ◯ dircolAt '~/s/ked'

        d.crumbs.path ▸ '~/s/ked'
        d.crumbs.split[0] ▸ '~'

        delete global.ked_session
