use fs
use ../../kxk      ▪ kseg post slash sleep
use ../edit        ◆ editor
use ../util        ◆ harness
use ../index       ◆ indexer
use ../view/colmns ◆ dircol funcol funtree

ked_sess = ->
    store = {}
    fakeGet = (key def) -> store[key] ? def
    fakeSet = (key value) -> store[key] = value
    global.ked_session = get:fakeGet set:fakeSet

▸ dircol crumbs

  ▸ a relative root shows the absolute folder path

        ked_sess()
        
        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        d = new dircol h.screen e []
        d.layout 0 0 100 30

        d.setRoot 'kode'

        d.crumbs.path ▸ slash.tilde(slash.path(process.cwd() 'kode'))
        d.crumbs.split[0] ▸ '~'

        ◯ sleep 10
        delete global.ked_session

  ▸ a dot relative root shows the absolute folder path

        ked_sess()
        
        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        d = new dircol h.screen e []
        d.layout 0 0 100 30

        d.setRoot './kode'

        d.crumbs.path ▸ slash.tilde(slash.path(process.cwd() 'kode'))
        d.crumbs.split[0] ▸ '~'

        ◯ sleep 10
        delete global.ked_session

  ▸ a tilde root stays where it is

        ked_sess()
        
        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        d = new dircol h.screen e []
        d.layout 0 0 100 30

        d.setRoot '~/s/ked'

        d.crumbs.path ▸ '~/s/ked'
        d.crumbs.split[0] ▸ '~'

        ◯ sleep 10
        delete global.ked_session
        
▸ funcol

  ▸ a cursor on the hash picks the color

        ked_sess()

        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['x = #ff8000;']
        e.state.setMainCursor 4 0

        f = new funcol h.screen e []

        f.onColorPickerShow ''

        f.colorpicker.hex() ▸ '#ff8000'

        delete global.ked_session

  ▸ a word that is not a color keeps the default and no replace mode

        ked_sess()
        
        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['x = hello;']
        e.state.setMainCursor 6 0

        f = new funcol h.screen e []

        f.onColorPickerShow ''

        f.colorReplace ▸ null

        delete global.ked_session

  ▸ submitting without changes keeps the original color string

        ked_sess()

        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['c = #abc;']
        e.state.setMainCursor 6 0

        f = new funcol h.screen e []

        f.onColorPickerShow ''

        f.colorpicker.submit f.colorpicker.hex()

        kseg.str(e.state.s.lines[0]) ▸ 'c = #abc;'
        f.colorReplace ▸ null

        delete global.ked_session

  ▸ an explicit show does not replace anything

        ked_sess()

        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['x = #ff8000;']
        e.state.setMainCursor 6 0

        f = new funcol h.screen e []

        f.onColorPickerShow '#123456'

        f.colorReplace ▸ null

        f.colorpicker.submit '#abcdef'

        kseg.str(e.state.s.lines[0]) ▸ 'x = #ff8000;'

        delete global.ked_session

  ▸ a selection color seeds the picker

        ked_sess()
        
        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['hello world']
        e.state.setSelections [[0 0 5 0]]
        e.state.setMainCursor 2 0
        e.state.setColorsForRanges [[0 0 5 0]] '#00ff00' null
        e.state.colorMethod = 'trailer'

        f = new funcol h.screen e []

        f.onColorPickerShow ''

        f.colorpicker.hex() ▸ '#00ff00'

        delete global.ked_session

  ▸ a selection keeps its existing background when only the foreground changes

        ked_sess()
        
        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['hello world']
        e.state.setSelections [[0 0 5 0]]
        e.state.setMainCursor 2 0
        e.state.setColorsForRanges [[0 0 5 0]] '#00ff00' '#0000ff'
        e.state.colorMethod = 'trailer'

        f = new funcol h.screen e []

        f.onColorPickerShow ''

        f.colorpicker.foregroundHex() ▸ '#00ff00'
        f.colorpicker.backgroundHex() ▸ '#0000ff'

        f.colorpicker.submit '#00ff00'

        e.state.s.colors.fg ▸ [[0 0 5 '#00ff00']]
        e.state.s.colors.bg ▸ [[0 0 5 '#0000ff']]

        delete global.ked_session

  ▸ a changed background is applied on submit

        ked_sess()
        
        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['hello world']
        e.state.setSelections [[0 0 5 0]]
        e.state.setMainCursor 2 0
        e.state.colorMethod = 'trailer'

        f = new funcol h.screen e []

        f.onColorPickerShow ''

        f.colorpicker.radio.changeActive 1
        f.colorpicker.setHex '#0000ff'

        f.colorpicker.backgroundChanged() ▸ true

        f.colorpicker.submit f.colorpicker.foregroundHex()

        e.state.s.colors.fg ▸ [[0 0 5 '#ff0000']]
        e.state.s.colors.bg ▸ [[0 0 5 '#0000ff']]

        delete global.ked_session

  ▸ an explicit 󠀡󠀰󠀰󠀲󠀸󠁛󠀳󠀳󠀬󠀵󠀬󠀱󠀬󠀢󠀣󠁥󠁥󠁦󠁦󠀰󠀰󠀢󠀬󠀢󠀣󠁦󠀵󠀱󠀱󠀱󠀱󠀢󠁝color picker gets a width in a narrow terminal

        ked_sess()
        
        h = new harness cols:80 rows:24
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['']

        f = new funcol h.screen e []

        f.onColorPickerShow ''

        f.colorpicker.visible() ▸ true
        f.cells.cols ▸ 16

        f.layout 64 1 16 23
        f.colorpicker.cells.cols ▸ 16

        delete global.ked_session

  ▸ the 󠀡󠀰󠀰󠀲󠀸󠁛󠀳󠀳󠀬󠀵󠀬󠀱󠀬󠀢󠀣󠀰󠀰󠁦󠁦󠀳󠁣󠀢󠀬󠀢󠀣󠀸󠀰󠀰󠀰󠀰󠀰󠀢󠁝color picker grows when the palette is not empty

        ked_sess()
        
        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['']

        f = new funcol h.screen e []

        f.onColorPickerShow ''

        f.layout 0 0 16 29
        f.colorpicker.cells.rows ▸ 9

        f.colorpicker.setHex '#ff0000'
        f.colorpicker.addCurrentColor()

        f.layout 0 0 16 29
        f.colorpicker.cells.rows ▸ 11

        delete global.ked_session

▸ funtree

  ▸ base class chain

        ked_sess()

        root = '/tmp/opencode/ked-funtree-base'
        baseFile = slash.path root 'base.kode'
        childFile = slash.path root 'child.kode'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        fs.writeFileSync baseFile """
            ■Base□Root
                alpha: -> 1
                beta: => 2
            ■Root
                gamma: -> 3
            """
        fs.writeFileSync childFile "■Child□Base\n"

        idx = new indexer
        ◯ idx.index baseFile
        ◯ idx.index childFile

        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_funtree_editor' []
        e.currentFile = childFile

        f = new funtree e 'test_funtree' []

        f.onFileIndexed childFile idx.files[childFile]

        fs.rmSync root recursive:true force:true

        f.showBases ▸ true
        f.items.map((i) -> i.name) ▸ [' ■ Child' ' □' ' ■ Base' '   -> alpha' '   => beta' ' ■ Root' '   -> gamma']

        f.items[1].divider ▸ true

        f.items[2].inherited ▸ true
        f.items[2].file ▸ baseFile
        f.items[2].line ▸ 1

        f.items[3].inherited ▸ true
        f.items[3].file ▸ baseFile
        f.items[3].line ▸ 2
        f.items[3].class ▸ 'Base'

        f.selectItemForLineIndex 3
        f.currentIndex() ▸ 0
        f.lineIndexOfNextFunc() ▸ undefined

        f.emitAction 'space' f.items[1]

        f.showBases ▸ false
        f.items.map((i) -> i.name) ▸ [' ■ Child' ' □ 2']

        f.emitAction 'return' f.items[1]

        f.showBases ▸ true
        f.items.map((i) -> i.name) ▸ [' ■ Child' ' □' ' ■ Base' '   -> alpha' '   => beta' ' ■ Root' '   -> gamma']

        emitted = []
        originalEmit = post.emit
        post.emit = (event args...) -> emitted.push [event].concat(args)

        f.emitAction 'right' f.items[1]
        f.emitAction 'drag' f.items[1]

        post.emit = originalEmit

        emitted.length ▸ 0

        supr = clss:true name:' ■ Child' line:1
        f.itemsForBaseClass(supr).length ▸ 0

  ▸ jump to inherited items

        ked_sess()

        root = '/tmp/opencode/ked-funtree-jump'
        baseFile = slash.path root 'base.kode'
        childFile = slash.path root 'child.kode'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        fs.writeFileSync baseFile """
            ■Base
                alpha: -> 1
            """
        fs.writeFileSync childFile "■Child□Base\n"

        idx = new indexer
        ◯ idx.index baseFile
        ◯ idx.index childFile

        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_funtree_jump_editor' []
        e.currentFile = childFile

        f = new funtree e 'test_funtree_jump' []
        f.onFileIndexed childFile idx.files[childFile]

        fs.rmSync root recursive:true force:true

        emitted = []
        originalEmit = post.emit
        post.emit = (event args...) -> emitted.push [event].concat(args)

        f.emitAction 'return' f.items[0]
        f.emitAction 'return' f.items[3]

        post.emit = originalEmit

        emitted[0] ▸ ['goto.line' 0 'ind' 'topDelta']
        emitted[1] ▸ ['focus' 'editor']
        emitted[2] ▸ ['file.open' baseFile 1 'ind' 'topDelta']
        emitted[3] ▸ ['focus' 'editor']

  ▸ cpp with unnamed index

        ked_sess()

        root = '/tmp/opencode/ked-funtree-cpp'
        file = slash.path root 'main.cpp'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        fs.writeFileSync file """
            static JsonNode* route_info (const fs::path& path)
            {
                struct stat st;
                if (::stat(path.c_str(), &st) != 0)
                {
                    return node_null();
                }
            }
            """

        idx = new indexer
        ◯ idx.index file

        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_funtree_cpp_editor' []
        e.currentFile = file

        f = new funtree e 'test_funtree_cpp' []
        f.onFileIndexed file idx.files[file]

        fs.rmSync root recursive:true force:true

        f.items.length ▸ 1
        f.items[0].name ▸ ' -> @route_info'
