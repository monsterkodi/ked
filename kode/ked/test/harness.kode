
use ../util      ◆ harness
use ../view/base ◆ input crumbs
use ../view/menu ◆ choices greet

▸ harness

    ▸ the terminal is left alone

        h = new harness

        h.t.written() ▸ ''

        h.t.write 'hello'

        h.t.written() ▸ 'hello'

    ▸ the screen is text

        h = new harness

        c = new crumbs h.screen 'test_crumbs'
        c.layout 0 0 30 1
        c.set '/home/kodi/s'
        c.draw()

        row = h.row 0

        row.includes 'kodi' ▸ true
        row.includes 's' ▸ true

        h.row 1 ▸ ''

    ▸ a key goes to the view

        h = new harness

        c = new choices h.screen 'test_choices'
        c.layout 0 0 20 3
        c.set ['one' 'two' 'three']
        c.select 0

        c.currentIndex() ▸ 0

        h.key c 'down'

        c.currentIndex() ▸ 1

    ▸ the focus goes to a view

        h = new harness

        i = new input h.screen 'test_input'
        i.layout 0 0 20 1

        h.focus i

        i.hasFocus() ▸ true

    ▸ a text goes into a view

        h = new harness

        i = new input h.screen 'test_input'
        i.layout 0 0 20 1

        h.focus i

        h.type i 'xyz'

        i.current() ▸ 'xyz'

    ▸ the cursor is marked

        h = new harness

        i = new input h.screen 'test_input'
        i.layout 0 0 20 1
        i.state.loadLines ['abc']

        h.focus i
        i.state.setMainCursor 1 0
        i.draw()

        h.row 0 ▸ 'abc'
        h.rowMarked 0 ▸ 'a\x1b[7;4:3mb\x1b[0mc'

    ▸ the greeter blacks out the window

        h = new harness

        g = new greet h.screen
        g.show()
        g.layout 0 0
        g.draw()

        h.screen.get_bg 0  23 ▸ [0 0 0]
        h.screen.get_bg 79 0  ▸ [0 0 0]

    ▸ the colored screen has the colors of the cells

        h = new harness

        h.screen.set 0 0 'a' [10 20 30] [1 2 3]

        line = h.screen.textColored()[0]

        line.includes '\x1b[48;2;1;2;3m'     ▸ true
        line.includes '\x1b[38;2;10;20;30m'  ▸ true
        line.includes 'a'                    ▸ true
        line.endsWith '\x1b[0m'              ▸ true

    ▸ the colored screen marks the cursor

        h = new harness

        h.screen.set 0 0 'a' [10 20 30] [1 2 3]
        h.screen.set_mark 0 0 'main'

        line = h.screen.textColored()[0]

        line.includes '\x1b[7;4:3ma\x1b[0m' ▸ true
