
use ../util        ◆ harness
use ../view/base   ◆ input crumbs
use ../view/menu   ◆ choices greet
use ../view/screen ◆ screen

▸ harness

  ▸ write and written

        h = new harness

        h.t.written() ▸ ''

        h.t.write 'hello'

        h.t.written() ▸ 'hello'

  ▸ crumbs are shown

        h = new harness

        c = new crumbs h.screen 'test_crumbs'
        c.layout 0 0 30 1
        c.set '/home/kodi/s'
        c.draw()

        row = h.row 0

        row.includes 'kodi' ▸ true
        row.includes 's' ▸ true

        h.row 1 ▸ ''

  ▸ key presses

        h = new harness

        c = new choices h.screen 'test_choices'
        c.layout 0 0 20 3
        c.set ['one' 'two' 'three']
        c.select 0

        c.currentIndex() ▸ 0

        h.key c 'down'

        c.currentIndex() ▸ 1

  ▸ view focus

        h = new harness

        i = new input h.screen 'test_input'
        i.layout 0 0 20 1

        h.focus i

        i.hasFocus() ▸ true

  ▸ view typing

        h = new harness

        i = new input h.screen 'test_input'
        i.layout 0 0 20 1

        h.focus i

        h.type i 'xyz'

        i.current() ▸ 'xyz'

  ▸ the cursor is marked

        h = new harness

        i = new input h.screen 'test_input'
        i.layout 0 0 20 1
        i.state.loadLines ['abc']

        h.focus i
        i.state.setMainCursor 1 0
        i.draw()

        h.row 0 ▸ 'abc'
        h.rowMarked 0 ▸ "a#{screen.MAIN_MARK}b#{screen.END_MARK}c"

  ▸ selection is marked

        h = new harness

        h.screen.set 0 0 'a'
        h.screen.set_mark 0 0 'selection'

        h.rowMarked 0 ▸ "#{screen.SELECT_MARK}a#{screen.END_MARK}"

  ▸ highlight is marked

        h = new harness

        h.screen.set 0 0 'a'
        h.screen.set_mark 0 0 'highlight'

        h.rowMarked 0 ▸ "#{screen.HILGHT_MARK}a#{screen.END_MARK}"

  ▸ greeter blacks out the window

        h = new harness

        g = new greet h.screen
        g.show()
        g.layout 0 0
        g.draw()

        h.screen.get_bg 0  23 ▸ [0 0 0]
        h.screen.get_bg 79 0  ▸ [0 0 0]

  ▸ colored screen 
    
    ▸ draws colors

            h = new harness
    
            h.screen.set 0 0 'a' [10 20 30] [1 2 3]
    
            line = h.screen.textColored()[0]
    
            line.includes '\x1b[48;2;1;2;3m'   ▸ true
            line.includes '\x1b[38;2;10;20;30m'  ▸ true
            line.includes 'a'                  ▸ true
            line.endsWith '\x1b[0m'            ▸ true
    
    ▸ marks the cursor
    
            h = new harness
    
            h.screen.set 0 0 'a' [10 20 30] [1 2 3]
            h.screen.set_mark 0 0 'main'
    
            line = h.screen.textColored()[0]
    
            line.includes "#{screen.MAIN_MARK}a#{screen.END_MARK}" ▸ true
    
    ▸ marks the selection
    
            h = new harness
    
            h.screen.set 0 0 'a' [10 20 30] [1 2 3]
            h.screen.set_mark 0 0 'selection'
    
            line = h.screen.textColored()[0]
    
            line.includes "#{screen.SELECT_MARK}a#{screen.END_MARK}" ▸ true
    
    ▸ marks the highlight
    
            h = new harness
    
            h.screen.set 0 0 'a' [10 20 30] [1 2 3]
            h.screen.set_mark 0 0 'highlight'
    
            line = h.screen.textColored()[0]
    
            line.includes "#{screen.HILGHT_MARK}a#{screen.END_MARK}" ▸ true
