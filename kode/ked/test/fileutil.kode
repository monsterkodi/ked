use ../../kxk ▪ nfs slash
use ../util   ◆ fileutil

▸ fileutil

  ▸ existing files are absolute, resolved and unique

        first  = slash.tmpfile 'txt'
        second = slash.tmpfile 'txt'
        gone   = slash.tmpfile 'txt'

        ◯ nfs.write first,  'first'
        ◯ nfs.write second, 'second'

        names = [slash.file(first), slash.file(second), slash.file(gone), slash.file(first)]

        files =◯ fileutil.existingFiles names slash.dir(first)

        files ▸ [first, second]

        ◯ nfs.remove first
        ◯ nfs.remove second

  ▸ the language of a snippet is detected

        fileutil.detectExt('') ▸ 'kode'
        fileutil.detectExt('ordinary words only') ▸ 'kode'
        fileutil.detectExt('{\n  "name": "kodi",\n  "ok": true\n}') ▸ 'json'
        fileutil.detectExt("log 'hello'") ▸ 'kode'
        fileutil.detectExt("use ../../kxk ▪ post\nlog 'hi'") ▸ 'kode'

        fileutil.detectExt('function foo() { const x = 1; return x; }') ▸ 'js'
        fileutil.detectExt('async function load() { await fetch(url) }') ▸ 'js'
        fileutil.detectExt('const greet = (name) => console.log(name)') ▸ 'js'
        fileutil.detectExt('function f() {\n  return 1;\n}') ▸ 'js'
        fileutil.detectExt('console.log("hi")') ▸ 'js'
        fileutil.detectExt('interface Foo { readonly name: string }') ▸ 'ts'
        fileutil.detectExt('const x: number = 1') ▸ 'ts'

        fileutil.detectExt('def greet(name):\n    print(name)') ▸ 'py'
        fileutil.detectExt('class Foo:\n    def __init__(self):\n        self.x = 1') ▸ 'py'
        fileutil.detectExt('for f in *.txt; do cat "$f"; done') ▸ 'sh'
        fileutil.detectExt('#!/bin/bash\necho "$HOME" | grep home') ▸ 'sh'
        fileutil.detectExt('#!/usr/bin/fish\nset x 1') ▸ 'fish'
        fileutil.detectExt('pub fn main() void { var x: u32 = 1; }') ▸ 'zig'
        fileutil.detectExt('const std = @import("std");') ▸ 'zig'
        fileutil.detectExt('#include <stdio.h>\nint main(void) { return 0; }') ▸ 'c'
        fileutil.detectExt('template <typename T>\nclass Foo { public: T x; };') ▸ 'cpp'
        fileutil.detectExt('@interface Foo : NSObject\n@end') ▸ 'mm'
        fileutil.detectExt('proc greet(name: string): string =\n  echo name') ▸ 'nim'
        fileutil.detectExt('func greet(name: String) -> String { return name }') ▸ 'swift'
        fileutil.detectExt('using System;\nclass Program { static void Main() { Console.WriteLine("hi"); } }') ▸ 'cs'
        fileutil.detectExt('local x = 1\nprint(x)') ▸ 'lua'
        fileutil.detectExt('function foo()\n  return 1\nend') ▸ 'lua'
        fileutil.detectExt('unless x then y else z') ▸ 'coffee'
        fileutil.detectExt('x = -> 42') ▸ 'coffee'
        fileutil.detectExt('<div class="foo">hello</div>') ▸ 'html'
        fileutil.detectExt('<!DOCTYPE html>\n<html><body><p>hi</p></body></html>') ▸ 'html'
        fileutil.detectExt('body { color: #fff; margin: 0; }') ▸ 'css'
        fileutil.detectExt('body\n  color #fff\n  margin 0') ▸ 'styl'
        fileutil.detectExt('$color: red;\n.foo { color: $color; }') ▸ 'scss'
        fileutil.detectExt('<svg viewBox="0 0 10 10"><circle r="4"/></svg>') ▸ 'svg'
        fileutil.detectExt('# heading\nsome **bold** text') ▸ 'md'
        fileutil.detectExt('name: foo\nitems:\n  - a\n  - b') ▸ 'yml'
        fileutil.detectExt('[user]\n\tname = Foo\n\temail = a@b.c') ▸ 'ini'
        fileutil.detectExt('key = value') ▸ 'ini'
        fileutil.detectExt('<?xml version="1.0"?><plist><dict><key>a</key></dict></plist>') ▸ 'plist'
