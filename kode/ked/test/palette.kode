
use ../util      ◆ harness
use ../view/base ◆ palette

pal = (cols colors) ->

    h = new harness cols:cols rows:2
    p = new palette h.screen 'test_palette'

    p.layout 0 0 cols 1
    p.setColors colors
    p.draw()

    [h p]

▸ palette

  ▸ a cell shows its color

        [h p] = pal 20 ['#ff0000' '#00ff00']

        h.screen.get_bg(5 0) ▸ [255 0 0]
        h.screen.get_bg(15 0) ▸ [0 255 0]

  ▸ one narrow cell keeps all the cells from showing their hex value

        [h p] = pal 20 ['#ff0000' '#00ff00' '#0000ff']

        h.row(0).includes('#ff0000') ▸ false
        h.row(0).includes('#00ff00') ▸ false
        h.row(0).includes('#0000ff') ▸ false

  ▸ a narrow cell shows no hex value

        [h p] = pal 10 ['#ff0000' '#00ff00']

        h.row(0).includes('#ff0000') ▸ false
        h.row(0).includes('#00ff00') ▸ false

  ▸ the palette has rounded edges

        [h p] = pal 20 ['#ff0000']

        h.screen.get_char(0 0) ▸ '◖'
        h.screen.get_char(19 0) ▸ '◗'

  ▸ an empty palette has no cells

        [h p] = pal 20 []

        p.options.length ▸ 0
        h.screen.get_bg(0 0) ▸ []
