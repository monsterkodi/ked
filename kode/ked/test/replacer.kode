        e.cells.layout 0 0 80 30
        r = new replacer h.screen e

        ○ r.show 'if'

        r.replaceInput.hasFocus() ▸ true

        h.key r 'tab'
        r.input.hasFocus()        ▸ true
        r.replaceInput.hasFocus() ▸ false

        h.key r 'tab'
        r.input.hasFocus()        ▸ false
        r.replaceInput.hasFocus() ▸ true

        h.key r 'shift+tab'
        r.input.hasFocus()        ▸ true
        r.replaceInput.hasFocus() ▸ false

        h.key r 'shift+tab'
        r.input.hasFocus()        ▸ false
        r.replaceInput.hasFocus() ▸ true

        config.data = savedConfig
        delete global.ked_session
        fs.rmSync root recursive:true force:true

