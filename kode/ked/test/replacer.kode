  ▸ file separators are laid out and drawn with the results

        root = '/tmp/opencode/ked-replacer-separators'
        main = slash.path root 'main.kode'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true

        fs.writeFileSync slash.path(root 'package.json') '{}'
        fs.writeFileSync main 'if a\n'

        delete prjcts.projects[root]
        delete prjcts.allFiles[main]

        global.ked_session =
            get: (key) -> main
            set: (key value) -> null

        savedConfig = config.data
        config.data =
            project: maxDepth:12 ignore:[]
            sourceFileExtensions: ['kode']

        ○ prjcts.index main

        h = new harness cols:80 rows:30
        e = new editor h.screen 'test_editor' ['gutter']
        e.cells.layout 1 0 79 30
        r = new replacer h.screen e

        ○ r.show 'if'

        r.arrange()

        r.sfils.length ▸ 1

        for sfil in r.sfils
            sfil.cells.cols ▸ r.choices.cells.cols
            sfil.cells.rows ▸ 1

        r.draw()

        row = h.row r.sfils[0].cells.y
        row.includes 'main.kode' ▸ true

        config.data = savedConfig
        delete global.ked_session
        fs.rmSync root recursive:true force:true

  ▸ file headers show checkmarks and space toggles exclusion

        root = '/tmp/opencode/ked-replacer-exclude'
        main = slash.path root 'main.kode'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true

        fs.writeFileSync slash.path(root 'package.json') '{}'
        fs.writeFileSync main 'if a\nif b\n'

        delete prjcts.projects[root]
        delete prjcts.allFiles[main]

        global.ked_session =
            get: (key) -> main
            set: (key value) -> null

        savedConfig = config.data
        config.data =
            project: maxDepth:12 ignore:[]
            sourceFileExtensions: ['kode']

        ○ prjcts.index main

        h = new harness cols:80 rows:30
        e = new editor h.screen 'test_editor' ['gutter']
        e.cells.layout 1 0 79 30
        r = new replacer h.screen e

        ○ r.show 'if'

        r.sfils.length ▸ 1
        r.sfils[0].marker ▸ '✔'
        r.choices.items[r.sfils[0].lineIndex].line ▸ '✔'
        r.choices.items.length ▸ 5

        r.draw()

        row = h.row r.sfils[0].cells.y
        row.includes '✔' ▸ true

        choice = r.choices.items[r.sfils[0].lineIndex]

        ○ r.onChoicesAction 'space' choice

        r.sfils.length ▸ 1
        r.sfils[0].excluded ▸ true
        r.sfils[0].marker ▸ '✘'
        r.choices.items[r.sfils[0].lineIndex].line ▸ '✘'
        r.choices.items.length ▸ 2

        r.draw()

        row = h.row r.sfils[0].cells.y
        row.includes '✘' ▸ true

        choice = r.choices.items[r.sfils[0].lineIndex]

        ○ r.onChoicesAction 'space' choice

        r.sfils[0].excluded ▸ false
        r.sfils[0].marker ▸ '✔'
        r.choices.items.length ▸ 5

        config.data = savedConfig
        delete global.ked_session
        fs.rmSync root recursive:true force:true

  ▸ replacing changes included lines and skips excluded files and lines

        root  = '/tmp/opencode/ked-replacer-submit'
        main  = slash.path root 'main.kode'
        other = slash.path root 'other.kode'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true

        fs.writeFileSync slash.path(root 'package.json') '{}'
        fs.writeFileSync main 'if if\nif b\nif c\n'
        fs.writeFileSync other 'if d\n'

        delete prjcts.projects[root]
        for file in [main other] ➜ delete prjcts.allFiles[file]

        global.ked_session =
            get: (key) -> main
            set: (key value) -> null

        savedConfig = config.data
        config.data =
            project: maxDepth:12 ignore:[]
            sourceFileExtensions: ['kode']

        ○ prjcts.index main

        h = new harness cols:80 rows:30
        e = new editor h.screen 'test_editor' ['gutter']
        e.cells.layout 1 0 79 30
        r = new replacer h.screen e

        ○ r.show 'if'

        mainHandler  = null
        otherHandler = null

        for sfil in r.sfils
            if sfil.path == main ➜ mainHandler  = sfil
            if sfil.path == other ➜ otherHandler = sfil

        (mainHandler != null)  ▸ true
        (otherHandler != null) ▸ true

        lineItem = null

        for item in mainHandler.resultItems
            if item.row == 1
                lineItem = item
                break

        (lineItem != null) ▸ true

        r.choices.select r.choices.items.indexOf lineItem

        ○ r.onChoicesAction 'space' lineItem

        ○ r.onChoicesAction 'space' otherHandler.headerItem

        ○ r.onReplaceInputAction 'submit' 'X'

        fs.readFileSync(main 'utf8')  ▸ 'X X\nif b\nX c\n'
        fs.readFileSync(other 'utf8') ▸ 'if d\n'
        r.visible() ▸ false

        config.data = savedConfig
        delete global.ked_session
        fs.rmSync root recursive:true force:true

  ▸ showing the replacer again resets previous exclusions

        root = '/tmp/opencode/ked-replacer-reset'
        main = slash.path root 'main.kode'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true

        fs.writeFileSync slash.path(root 'package.json') '{}'
        fs.writeFileSync main 'if a\nif b\n'

        delete prjcts.projects[root]
        delete prjcts.allFiles[main]

        global.ked_session =
            get: (key) -> main
            set: (key value) -> null

        savedConfig = config.data
        config.data =
            project: maxDepth:12 ignore:[]
            sourceFileExtensions: ['kode']

        ○ prjcts.index main

        h = new harness cols:80 rows:16
        e = new editor h.screen 'test_editor' ['gutter']
        e.cells.layout 1 0 79 16
        r = new replacer h.screen e

        ○ r.show 'if'

        oldHandler = r.sfils[0]
        choice    = r.choices.items[oldHandler.lineIndex]

        ○ r.onChoicesAction 'space' choice

        r.sfils[0].excluded ▸ true
        r.excludedPaths[main] ▸ true

        ○ r.show 'if'

        r.sfils.length ▸ 1
        (r.sfils[0] != oldHandler) ▸ true
        r.sfils[0].excluded ▸ false
        r.sfils[0].marker ▸ '✔'
        r.isExcluded(main) ▸ false
        r.choices.items.length ▸ 5

        config.data = savedConfig
        delete global.ked_session
        fs.rmSync root recursive:true force:true

  ▸ toggling a file keeps the file order and the view

        root = '/tmp/opencode/ked-replacer-order'
        files = []

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true

        fs.writeFileSync slash.path(root 'package.json') '{}'

        for i in 0...5
            file = slash.path root "file#{i}.kode"
            fs.writeFileSync file "if #{i}a\nif #{i}b\n"
            files.push file

        for file in files ➜ delete prjcts.allFiles[file]
        delete prjcts.projects[root]

        global.ked_session =
            get: (key) -> files[0]
            set: (key value) -> null

        savedConfig = config.data
        config.data =
            project: maxDepth:12 ignore:[]
            sourceFileExtensions: ['kode']

        ○ prjcts.index files[0]

        h = new harness cols:80 rows:16
        e = new editor h.screen 'test_editor' ['gutter']
        e.cells.layout 1 0 79 16
        r = new replacer h.screen e

        ○ r.show 'if'

        order = r.sfils.map (sfil) -> sfil.path

        r.choices.state.setView [0 8]
        r.choices.select r.sfils[2].lineIndex
        r.choices.grabFocus()

        view   = r.choices.state.s.view.slice()
        scroll = r.choices.state.s.scrollOffset

        ○ r.onChoicesAction 'space' r.choices.current()

        r.sfils.map((sfil) -> sfil.path) ▸ order
        r.choices.state.s.view ▸ view
        r.choices.state.s.scrollOffset ▸ scroll
        r.choices.current().line ▸ '✘'
        r.choices.current().path ▸ files[2]

        config.data = savedConfig
        delete global.ked_session
        fs.rmSync root recursive:true force:true

  ▸ space on a result line excludes it from the replacement

        root = '/tmp/opencode/ked-replacer-line-exclude'
        main = slash.path root 'main.kode'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true

        fs.writeFileSync slash.path(root 'package.json') '{}'
        fs.writeFileSync main 'if a\nif b\nif c\n'

        delete prjcts.projects[root]
        delete prjcts.allFiles[main]

        global.ked_session =
            get: (key) -> main
            set: (key value) -> null

        savedConfig = config.data
        config.data =
            project: maxDepth:12 ignore:[]
            sourceFileExtensions: ['kode']

        ○ prjcts.index main

        h = new harness cols:80 rows:30
        e = new editor h.screen 'test_editor' ['gutter']
        e.cells.layout 1 0 79 30
        r = new replacer h.screen e

        ○ r.show 'if'

        lineIndex = null
        lineItem  = null

        for item,idx in r.choices.items
            if item.row is num and item.type != 'file'
                lineIndex = idx
                lineItem  = item
                break

        (lineItem != null) ▸ true

        r.choices.select lineIndex

        ○ r.onChoicesAction 'space' lineItem

        lineItem.excluded ▸ true
        r.visible() ▸ true
        r.lineno(lineIndex).includes('✘') ▸ true

        ○ r.onChoicesAction 'space' lineItem

        lineItem.excluded ▸ false
        r.lineno(lineIndex).includes('✘') ▸ false

        config.data = savedConfig
        delete global.ked_session
        fs.rmSync root recursive:true force:true

  ▸ excluding a line moves focus to the next result line

        root = '/tmp/opencode/ked-replacer-line-repeat'
        main = slash.path root 'main.kode'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true

        fs.writeFileSync slash.path(root 'package.json') '{}'
        fs.writeFileSync main 'if a\nif b\nif c\n'

        delete prjcts.projects[root]
        delete prjcts.allFiles[main]

        global.ked_session =
            get: (key) -> main
            set: (key value) -> null

        savedConfig = config.data
        config.data =
            project: maxDepth:12 ignore:[]
            sourceFileExtensions: ['kode']

        ○ prjcts.index main

        h = new harness cols:80 rows:30
        e = new editor h.screen 'test_editor' ['gutter']
        e.cells.layout 1 0 79 30
        r = new replacer h.screen e

        ○ r.show 'if'

        lineIndices = []

        for item,idx in r.choices.items
            if item.row is num and item.type != 'file'
                lineIndices.push idx

        lineIndices.length ▸ 3

        r.choices.select lineIndices[0]

        first = r.choices.current()

        ○ r.onChoicesAction 'space' first

        first.excluded ▸ true
        r.choices.currentIndex() ▸ lineIndices[1]

        second = r.choices.current()

        ○ r.onChoicesAction 'space' second

        second.excluded ▸ true
        r.choices.currentIndex() ▸ lineIndices[2]

        third = r.choices.current()

        ○ r.onChoicesAction 'space' third

        third.excluded ▸ true
        r.choices.currentIndex() ▸ lineIndices[2]

        config.data = savedConfig
        delete global.ked_session
        fs.rmSync root recursive:true force:true
