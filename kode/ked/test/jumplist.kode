use ../edit/tool ◆ jumplist

▸ jumplist

  ▸ an empty jump list has no older or newer position

        j = new jumplist

        j.older {file:'a' x:0 y:0} ▸ null
        j.newer()                  ▸ null

  ▸ ctrl o goes to the position before the last jump

        j = new jumplist

        j.record {file:'a' x:1 y:1}

        j.older({file:'a' x:2 y:2}) ▸ {file:'a' x:1 y:1}
        j.newer()                   ▸ {file:'a' x:2 y:2}

  ▸ jumps are walked backwards and forwards

        j = new jumplist

        j.record {file:'a' x:0 y:1}
        j.record {file:'a' x:0 y:2}
        j.record {file:'a' x:0 y:3}

        j.older({file:'a' x:0 y:4}) ▸ {file:'a' x:0 y:3}
        j.older({file:'a' x:0 y:3}) ▸ {file:'a' x:0 y:2}
        j.older({file:'a' x:0 y:2}) ▸ {file:'a' x:0 y:1}
        j.older({file:'a' x:0 y:1}) ▸ null

        j.newer() ▸ {file:'a' x:0 y:2}
        j.newer() ▸ {file:'a' x:0 y:3}
        j.newer() ▸ {file:'a' x:0 y:4}
        j.newer() ▸ null

  ▸ a jump from a newer position drops the positions after it

        j = new jumplist

        j.record {file:'a' x:0 y:1}
        j.record {file:'a' x:0 y:2}
        j.record {file:'a' x:0 y:3}

        j.older({file:'a' x:0 y:4}) ▸ {file:'a' x:0 y:3}
        j.older({file:'a' x:0 y:3}) ▸ {file:'a' x:0 y:2}

        j.record {file:'a' x:0 y:2}

        j.older({file:'a' x:0 y:5}) ▸ {file:'a' x:0 y:2}
        j.newer()                   ▸ {file:'a' x:0 y:5}
        j.newer()                   ▸ null

  ▸ positions on the same line are not repeated

        j = new jumplist

        j.record {file:'a' x:0 y:1}
        j.record {file:'a' x:3 y:1}

        j.entries.length ▸ 1
        j.entries[0].x   ▸ 3

  ▸ different files on the same line are kept

        j = new jumplist

        j.record {file:'a' x:0 y:1}
        j.record {file:'b' x:0 y:1}

        j.entries.length ▸ 2

  ▸ only the newest 100 positions are kept

        j = new jumplist

        for y in 1..105
            j.record {file:'a' x:0 y:y}

        j.entries.length ▸ 100
        j.entries[0].y   ▸ 6
        j.entries[-1].y  ▸ 105
