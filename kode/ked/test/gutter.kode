use ../../kxk ▪ kseg
use ../edit   ◆ editor
use ../util   ◆ harness gitblock

setup = ->

    h = new harness cols:40 rows:10
    e = new editor h.screen 'test_gutter' ['gutter']
    e.layout 0 0 40 10
    e

press = (e line) ->

    e.onMouse
        type:   'press'
        cell:   [1 line]
        button: 'left'
        count:  1
        cmd:    true

move = (e line) ->

    e.onMouse
        type: 'move'
        cell: [1 line]
        cmd:  true

key = (e combo) ->

    e.grabFocus()

    event =
        type:  'press'
        combo: combo
        char:  ''

    e.onKey combo event

text = (e) -> kseg.str(e.state.segls)

▸ gutter

  ▸ a modifier click reverts and restores a modified line

        e = setup()

        e.state.loadLines ['aa' 'B' 'cc']
        e.gutter.onGitDiff
            file:    'test.txt'
            changes: [{line:2 old:['b'] new:['B']}]

        press e 1

        text(e) ▸ 'aa\nb\ncc'
        e.gutter.entries.length ▸ 1

        press e 1

        text(e) ▸ 'aa\nB\ncc'
        e.gutter.entries.length ▸ 0

  ▸ a click without a modifier changes nothing

        e = setup()

        e.state.loadLines ['aa' 'B' 'cc']
        e.gutter.onGitDiff
            file:    'test.txt'
            changes: [{line:2 old:['b'] new:['B']}]

        e.onMouse
            type:   'press'
            cell:   [1 1]
            button: 'left'
            count:  1

        text(e) ▸ 'aa\nB\ncc'
        e.gutter.entries.length ▸ 0

  ▸ a click puts the cursor on the first line of the resulting block

        e = setup()

        e.state.loadLines ['aa' 'B1' 'B2' 'cc']
        e.gutter.onGitDiff
            file:    'test.txt'
            changes: [{line:2 old:['b'] new:['B1' 'B2']}]

        press e 2

        text(e) ▸ 'aa\nb\ncc'
        e.state.mainCursor() ▸ [0 1]

        press e 1

        text(e) ▸ 'aa\nB1\nB2\ncc'
        e.state.mainCursor() ▸ [0 1]

  ▸ a click on a reverted addition puts the cursor above the gap

        e = setup()

        e.state.loadLines ['aa' 'X' 'cc']
        e.gutter.onGitDiff
            file:    'test.txt'
            changes: [{line:2 new:['X']}]

        press e 1

        text(e) ▸ 'aa\ncc'
        e.state.mainCursor() ▸ [0 0]

  ▸ alt+g toggles the block at the main cursor

        e = setup()

        e.state.loadLines ['aa' 'B' 'cc']
        e.gutter.onGitDiff
            file:    'test.txt'
            changes: [{line:2 old:['b'] new:['B']}]

        e.state.setMainCursor 0 1

        key e 'alt+g'

        text(e) ▸ 'aa\nb\ncc'
        e.state.mainCursor() ▸ [0 1]
        e.gutter.entries.length ▸ 1

        key e 'alt+g'

        text(e) ▸ 'aa\nB\ncc'
        e.gutter.entries.length ▸ 0

  ▸ repeated alt+g keeps toggling the same block

        e = setup()

        e.state.loadLines ['aa' 'B' 'cc']
        e.gutter.onGitDiff
            file:    'test.txt'
            changes: [{line:2 old:['b'] new:['B']}]

        e.state.setMainCursor 0 1

        key e 'alt+g'
        key e 'alt+g'
        key e 'alt+g'

        text(e) ▸ 'aa\nb\ncc'
        e.state.mainCursor() ▸ [0 1]
        e.gutter.entries.length ▸ 1

  ▸ a click on the line above a deletion reverts the deletion

        e = setup()

        e.state.loadLines ['aa' 'cc']
        e.gutter.onGitDiff
            file:    'test.txt'
            changes: [{line:1 old:['bb']}]

        press e 0

        text(e) ▸ 'aa\nbb\ncc'

        press e 0

        text(e) ▸ 'aa\ncc'

  ▸ a click reverts all changes of a visual block at once

        e = setup()

        e.state.loadLines ['aa' 'B' 'cc' 'dd']
        e.gutter.onGitDiff
            file:    'test.txt'
            changes: [
                {line:2 old:['b'] new:['B']}
                {line:2 old:['x']}
                ]

        e.gutter.blocks.length ▸ 1

        press e 1

        text(e) ▸ 'aa\nb\nx\ncc\ndd'

        press e 1

        text(e) ▸ 'aa\nB\ncc\ndd'

  ▸ modifier hover marks the block under the mouse

        e = setup()

        e.state.loadLines ['aa' 'B' 'cc']
        e.gutter.onGitDiff
            file:    'test.txt'
            changes: [{line:2 old:['b'] new:['B']}]

        move e 1

        e.gutter.hoverBlock ▸ e.gutter.blocks[0]

        e.onMouse
            type: 'move'
            cell: [1 1]

        e.gutter.hoverBlock ▸ null

  ▸ a reverted block survives an edit above it

        e = setup()

        e.state.loadLines ['aa' 'B' 'cc']
        e.gutter.onGitDiff
            file:    'test.txt'
            changes: [{line:2 old:['b'] new:['B']}]

        press e 1

        e.state.setLines ['new' 'aa' 'b' 'cc']

        press e 2

        text(e) ▸ 'new\naa\nB\ncc'

  ▸ undoing a revert makes the block clickable again

        e = setup()

        e.state.loadLines ['aa' 'B' 'cc']
        e.gutter.onGitDiff
            file:    'test.txt'
            changes: [{line:2 old:['b'] new:['B']}]

        press e 1
        e.state.undo()

        e.gutter.entries.length ▸ 0
        e.gutter.blocks.length ▸ 1

        press e 1

        text(e) ▸ 'aa\nb\ncc'

  ▸ redoing a revert shows the reverted block again

        e = setup()

        e.state.loadLines ['aa' 'B' 'cc']
        e.gutter.onGitDiff
            file:    'test.txt'
            changes: [{line:2 old:['b'] new:['B']}]

        press e 1
        e.state.undo()
        e.state.redo()

        e.gutter.entries.length ▸ 1
        e.gutter.blocks.length ▸ 0
        text(e) ▸ 'aa\nb\ncc'

        press e 1

        text(e) ▸ 'aa\nB\ncc'

  ▸ redoing a revert of an addition shows the reverted block again

        e = setup()

        e.state.loadLines ['aa' 'X' 'cc']
        e.gutter.onGitDiff
            file:    'test.txt'
            changes: [{line:2 new:['X']}]

        press e 1
        e.state.undo()
        e.state.redo()

        e.gutter.entries.length ▸ 1
        e.gutter.blocks.length ▸ 0
        text(e) ▸ 'aa\ncc'

        press e 0

        text(e) ▸ 'aa\nX\ncc'

  ▸ a new file has no revertable blocks

        e = setup()

        e.state.loadLines ['aa' 'B']
        e.gutter.onGitDiff
            file:    'test.txt'
            newFile: true
            changes: [{line:2 old:['b'] new:['B']}]

        press e 1

        text(e) ▸ 'aa\nB'
        e.gutter.entries.length ▸ 0

  ▸ a diff refresh keeps a reverted block shadowed

        e = setup()

        e.state.loadLines ['aa' 'B' 'cc' 'dd']
        diff =
            file:    'test.txt'
            changes: [{line:2 old:['b'] new:['B']}]

        e.gutter.onGitDiff diff
        press e 1

        e.gutter.onGitDiff diff

        e.gutter.blocks.length ▸ 0
        e.gutter.entries.length ▸ 1

        press e 1

        e.gutter.entries.length ▸ 0
        e.gutter.blocks.length ▸ 1
        text(e) ▸ 'aa\nB\ncc\ndd'

▸ gitblock

  ▸ a modified line becomes one block

        blocks = gitblock.fromDiff changes:[{line:2 old:['b'] new:['B']}]

        blocks.length ▸ 1
        blocks[0].start ▸ 1
        blocks[0].end ▸ 2
        blocks[0].marks ▸ {'1':'mod'}

  ▸ an added line becomes one block

        blocks = gitblock.fromDiff changes:[{line:2 new:['X']}]

        blocks.length ▸ 1
        blocks[0].start ▸ 1
        blocks[0].end ▸ 2
        blocks[0].marks ▸ {'1':'add'}

  ▸ a deleted line is marked on the line above the gap

        blocks = gitblock.fromDiff changes:[{line:2 old:['X']}]

        blocks.length ▸ 1
        blocks[0].start ▸ 2
        blocks[0].end ▸ 2
        blocks[0].marks ▸ {'1':'del'}

  ▸ modified lines followed by deletions are one block

        blocks = gitblock.fromDiff changes:[{line:2 old:['b' 'x' 'y'] new:['B']}]

        blocks.length ▸ 1
        blocks[0].end ▸ 2
        blocks[0].marks ▸ {'1':'mod'}

  ▸ adjacent changes are one block

        blocks = gitblock.fromDiff changes:[
            {line:2 old:['b'] new:['B']}
            {line:3 old:['c'] new:['C']}
            ]

        blocks.length ▸ 1
        blocks[0].marks ▸ {'1':'mod' '2':'mod'}

  ▸ one unchanged line separates blocks

        blocks = gitblock.fromDiff changes:[
            {line:2 old:['b'] new:['B']}
            {line:4 old:['d'] new:['D']}
            ]

        blocks.length ▸ 2
        blocks[0].marks ▸ {'1':'mod'}
        blocks[1].marks ▸ {'3':'mod'}

  ▸ a deletion directly after a change joins its block

        blocks = gitblock.fromDiff changes:[
            {line:2 old:['b'] new:['B']}
            {line:2 old:['x']}
            ]

        blocks.length ▸ 1
        blocks[0].end ▸ 2

  ▸ deletions around one unchanged line join their block

        blocks = gitblock.fromDiff changes:[
            {line:1 old:['b']}
            {line:2 old:['c']}
            ]

        blocks.length ▸ 1
        blocks[0].start ▸ 1
        blocks[0].end ▸ 2

  ▸ reverting a modification restores the committed line

        lines = ['a' 'B' 'c']
        block = gitblock.fromDiff(changes:[{line:2 old:['b'] new:['B']}])[0]
        entry = gitblock.revert block lines

        gitblock.applyRevert entry lines ▸ ['a' 'b' 'c']
        gitblock.applyRestore entry (gitblock.applyRevert(entry lines)) ▸ ['a' 'B' 'c']

  ▸ reverting an addition removes its lines and restoring re-adds them

        lines = ['a' 'X' 'b']
        block = gitblock.fromDiff(changes:[{line:2 new:['X']}])[0]
        entry = gitblock.revert block lines

        gitblock.applyRevert entry lines ▸ ['a' 'b']
        gitblock.applyRestore entry (gitblock.applyRevert(entry lines)) ▸ ['a' 'X' 'b']

  ▸ reverting a deletion inserts its lines and restoring removes them

        lines = ['a' 'b']
        block = gitblock.fromDiff(changes:[{line:1 old:['X']}])[0]
        entry = gitblock.revert block lines

        gitblock.applyRevert entry lines ▸ ['a' 'X' 'b']
        gitblock.applyRestore entry (gitblock.applyRevert(entry lines)) ▸ ['a' 'b']

  ▸ reverting a block with a gap keeps the line between the hunks

        lines = ['a' 'X' 'd']
        blocks = gitblock.fromDiff changes:[
            {line:1 old:['b']}
            {line:2 old:['c']}
            ]
        entry = gitblock.revert blocks[0] lines

        gitblock.applyRevert entry lines ▸ ['a' 'b' 'X' 'c' 'd']
        gitblock.applyRestore entry (gitblock.applyRevert(entry lines)) ▸ ['a' 'X' 'd']

  ▸ a stale block cannot be reverted

        block = gitblock.fromDiff(changes:[{line:2 old:['b'] new:['B']}])[0]

        gitblock.revert block ['a' 'Z' 'c'] ▸ undefined

  ▸ the first line of a block is its first displayed line

        mod = gitblock.fromDiff(changes:[{line:2 old:['b'] new:['B']}])[0]
        add = gitblock.fromDiff(changes:[{line:2 new:['X']}])[0]
        del = gitblock.fromDiff(changes:[{line:2 old:['X']}])[0]

        gitblock.firstLine(mod) ▸ 1
        gitblock.firstLine(add) ▸ 1
        gitblock.firstLine(del) ▸ 1

  ▸ the first line of a reverted addition is the line above the gap

        block = gitblock.fromDiff(changes:[{line:2 new:['X']}])[0]
        entry = gitblock.revert block ['a' 'X' 'b']

        gitblock.firstLine(entry) ▸ 0

  ▸ an entry moves with lines inserted above it

        lines = ['a' 'B' 'c']
        block = gitblock.fromDiff(changes:[{line:2 old:['b'] new:['B']}])[0]
        entry = gitblock.revert block lines

        reverted = gitblock.applyRevert entry lines
        withNew  = ['new'].concat reverted
        moved = gitblock.reanchorEntry entry withNew

        moved.start ▸ 2
        moved.ops[0].oldStart ▸ 2

  ▸ a reverted entry becomes a block again when its revert is undone

        lines = ['a' 'B' 'c']
        block = gitblock.fromDiff(changes:[{line:2 old:['b'] new:['B']}])[0]
        entry = gitblock.revert block lines

        reverted = gitblock.applyRevert entry lines
        back = gitblock.applyRestore entry reverted
        again = gitblock.undoneBlock entry back

        again.start ▸ 1
        again.marks ▸ {'1':'mod'}

  ▸ a reverted deletion becomes a block again when its revert is undone

        lines = ['a' 'b']
        block = gitblock.fromDiff(changes:[{line:1 old:['X']}])[0]
        entry = gitblock.revert block lines

        reverted = gitblock.applyRevert entry lines
        back = gitblock.applyRestore entry reverted
        again = gitblock.undoneBlock entry back

        again.start ▸ 1
        again.marks ▸ {'0':'del'}
