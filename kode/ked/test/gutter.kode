use ../../kxk ▪ kseg
use ../edit   ◆ editor
use ../util   ◆ harness gitblock

setup = ->

    h = new harness cols:40 rows:10
    e = new editor h.screen 'test_gutter' ['gutter']
    e.layout 0 0 40 10
    e

diffed = (lines changes) ->

    e = setup()
    e.state.loadLines lines
    e.gutter.onGitDiff
        file:    'test.txt'
        changes: changes
    e

press = (e line) ->

    e.onMouse
        type:   'press'
        cell:   [1 line]
        button: 'left'
        count:  1
        cmd:    true

move = (e line) ->

    e.onMouse
        type: 'move'
        cell: [1 line]
        cmd:  true

key = (e combo) ->

    e.grabFocus()

    event =
        type:  'press'
        combo: combo
        char:  ''

    e.onKey combo event

text = (e) -> kseg.str(e.state.segls)

▸ gutter

  ▸ revert click

        e = diffed ['aa' 'B' 'cc'] [{line:2 old:['b'] new:['B']}]

        e.onMouse
            type:   'press'
            cell:   [1 1]
            button: 'left'
            count:  1

        text(e) ▸ 'aa\nB\ncc'
        e.gutter.entries.length ▸ 0

        press e 1

        text(e) ▸ 'aa\nb\ncc'
        e.gutter.entries.length ▸ 1

        press e 1

        text(e) ▸ 'aa\nB\ncc'
        e.gutter.entries.length ▸ 0

        e = diffed ['aa' 'cc'] [{line:1 old:['bb']}]

        press e 0

        text(e) ▸ 'aa\nbb\ncc'

        press e 0

        text(e) ▸ 'aa\ncc'

  ▸ block click

        e = diffed ['aa' 'B' 'cc' 'dd'] [
            {line:2 old:['b'] new:['B']}
            {line:2 old:['x']}
            ]

        e.gutter.blocks.length ▸ 1

        press e 1

        text(e) ▸ 'aa\nb\nx\ncc\ndd'

        press e 1

        text(e) ▸ 'aa\nB\ncc\ndd'

  ▸ cursor after revert

        e = diffed ['aa' 'B1' 'B2' 'cc'] [{line:2 old:['b'] new:['B1' 'B2']}]

        press e 2

        text(e) ▸ 'aa\nb\ncc'
        e.state.mainCursor() ▸ [0 1]

        press e 1

        text(e) ▸ 'aa\nB1\nB2\ncc'
        e.state.mainCursor() ▸ [0 1]

        e = diffed ['aa' 'X' 'cc'] [{line:2 new:['X']}]

        press e 1

        text(e) ▸ 'aa\ncc'
        e.state.mainCursor() ▸ [0 0]

  ▸ alt+g

        e = diffed ['aa' 'B' 'cc'] [{line:2 old:['b'] new:['B']}]
        e.state.setMainCursor 0 1

        key e 'alt+g'

        text(e) ▸ 'aa\nb\ncc'
        e.state.mainCursor() ▸ [0 1]
        e.gutter.entries.length ▸ 1

        key e 'alt+g'

        text(e) ▸ 'aa\nB\ncc'
        e.gutter.entries.length ▸ 0

        key e 'alt+g'
        key e 'alt+g'
        key e 'alt+g'

        text(e) ▸ 'aa\nb\ncc'
        e.state.mainCursor() ▸ [0 1]
        e.gutter.entries.length ▸ 1

  ▸ hover

        e = diffed ['aa' 'B' 'cc'] [{line:2 old:['b'] new:['B']}]

        move e 1

        e.gutter.hoverBlock ▸ e.gutter.blocks[0]

        e.onMouse
            type: 'move'
            cell: [1 1]

        e.gutter.hoverBlock ▸ null

  ▸ survives edits

        e = diffed ['aa' 'B' 'cc'] [{line:2 old:['b'] new:['B']}]

        press e 1
        e.state.setLines ['new' 'aa' 'b' 'cc']
        press e 2

        text(e) ▸ 'new\naa\nB\ncc'

  ▸ undo and redo

        e = diffed ['aa' 'B' 'cc'] [{line:2 old:['b'] new:['B']}]

        press e 1
        e.state.undo()

        e.gutter.entries.length ▸ 0
        e.gutter.blocks.length ▸ 1

        press e 1

        text(e) ▸ 'aa\nb\ncc'

        e = diffed ['aa' 'B' 'cc'] [{line:2 old:['b'] new:['B']}]

        press e 1
        e.state.undo()
        e.state.redo()

        e.gutter.entries.length ▸ 1
        e.gutter.blocks.length ▸ 0
        text(e) ▸ 'aa\nb\ncc'

        press e 1

        text(e) ▸ 'aa\nB\ncc'

        e = diffed ['aa' 'X' 'cc'] [{line:2 new:['X']}]

        press e 1
        e.state.undo()
        e.state.redo()

        e.gutter.entries.length ▸ 1
        e.gutter.blocks.length ▸ 0
        text(e) ▸ 'aa\ncc'

        press e 0

        text(e) ▸ 'aa\nX\ncc'

  ▸ new file

        e = setup()
        e.state.loadLines ['aa' 'B']
        e.gutter.onGitDiff
            file:    'test.txt'
            newFile: true
            changes: [{line:2 old:['b'] new:['B']}]

        press e 1

        text(e) ▸ 'aa\nB'
        e.gutter.entries.length ▸ 0

  ▸ diff refresh

        e = setup()
        e.state.loadLines ['aa' 'B' 'cc' 'dd']

        diff =
            file:    'test.txt'
            changes: [{line:2 old:['b'] new:['B']}]

        e.gutter.onGitDiff diff
        press e 1
        e.gutter.onGitDiff diff

        e.gutter.blocks.length ▸ 0
        e.gutter.entries.length ▸ 1

        press e 1

        e.gutter.entries.length ▸ 0
        e.gutter.blocks.length ▸ 1
        text(e) ▸ 'aa\nB\ncc\ndd'

▸ gitblock

  ▸ fromDiff

        mod = gitblock.fromDiff changes:[{line:2 old:['b'] new:['B']}]
        add = gitblock.fromDiff changes:[{line:2 new:['X']}]
        del = gitblock.fromDiff changes:[{line:2 old:['X']}]

        mod.length ▸ 1
        add.length ▸ 1
        del.length ▸ 1

        mod[0].start ▸ 1
        mod[0].end   ▸ 2
        mod[0].marks ▸ {'1':'mod'}

        add[0].start ▸ 1
        add[0].end   ▸ 2
        add[0].marks ▸ {'1':'add'}

        del[0].start ▸ 2
        del[0].end   ▸ 2
        del[0].marks ▸ {'1':'del'}

  ▸ merging

        from = (changes) -> gitblock.fromDiff changes:changes

        b = from [{line:2 old:['b' 'x' 'y'] new:['B']}]

        b.length ▸ 1
        b[0].end ▸ 2
        b[0].marks ▸ {'1':'mod'}

        b = from [
            {line:2 old:['b'] new:['B']}
            {line:3 old:['c'] new:['C']}
            ]

        b.length ▸ 1
        b[0].marks ▸ {'1':'mod' '2':'mod'}

        b = from [
            {line:2 old:['b'] new:['B']}
            {line:4 old:['d'] new:['D']}
            ]

        b.length ▸ 2
        b[0].marks ▸ {'1':'mod'}
        b[1].marks ▸ {'3':'mod'}

        b = from [
            {line:2 old:['b'] new:['B']}
            {line:2 old:['x']}
            ]

        b.length ▸ 1
        b[0].end ▸ 2

        b = from [
            {line:1 old:['b']}
            {line:2 old:['c']}
            ]

        b.length ▸ 1
        b[0].start ▸ 1
        b[0].end ▸ 2

  ▸ revert

        rv = (lines changes) ->
            block = gitblock.fromDiff(changes:changes)[0]
            entry = gitblock.revert block lines
            reverted = gitblock.applyRevert entry lines
            restored = gitblock.applyRestore entry reverted
            [reverted restored]

        [reverted restored] = rv ['a' 'B' 'c'] [{line:2 old:['b'] new:['B']}]

        reverted ▸ ['a' 'b' 'c']
        restored ▸ ['a' 'B' 'c']

        [reverted restored] = rv ['a' 'X' 'b'] [{line:2 new:['X']}]

        reverted ▸ ['a' 'b']
        restored ▸ ['a' 'X' 'b']

        [reverted restored] = rv ['a' 'b'] [{line:1 old:['X']}]

        reverted ▸ ['a' 'X' 'b']
        restored ▸ ['a' 'b']

        [reverted restored] = rv ['a' 'X' 'd'] [
            {line:1 old:['b']}
            {line:2 old:['c']}
            ]

        reverted ▸ ['a' 'b' 'X' 'c' 'd']
        restored ▸ ['a' 'X' 'd']

  ▸ stale

        block = gitblock.fromDiff(changes:[{line:2 old:['b'] new:['B']}])[0]

        gitblock.revert block ['a' 'Z' 'c'] ▸ undefined

  ▸ firstLine

        mod = gitblock.fromDiff(changes:[{line:2 old:['b'] new:['B']}])[0]
        add = gitblock.fromDiff(changes:[{line:2 new:['X']}])[0]
        del = gitblock.fromDiff(changes:[{line:2 old:['X']}])[0]

        gitblock.firstLine(mod) ▸ 1
        gitblock.firstLine(add) ▸ 1
        gitblock.firstLine(del) ▸ 1

        block = gitblock.fromDiff(changes:[{line:2 new:['X']}])[0]
        entry = gitblock.revert block ['a' 'X' 'b']

        gitblock.firstLine(entry) ▸ 0

  ▸ reanchor

        lines = ['a' 'B' 'c']
        block = gitblock.fromDiff(changes:[{line:2 old:['b'] new:['B']}])[0]
        entry = gitblock.revert block lines

        reverted = gitblock.applyRevert entry lines
        moved = gitblock.reanchorEntry entry ['new'].concat(reverted)

        moved.start ▸ 2
        moved.ops[0].oldStart ▸ 2

  ▸ undone block

        undone = (lines changes) ->
            block = gitblock.fromDiff(changes:changes)[0]
            entry = gitblock.revert block lines
            reverted = gitblock.applyRevert entry lines
            back = gitblock.applyRestore entry reverted
            gitblock.undoneBlock entry back

        again = undone ['a' 'B' 'c'] [{line:2 old:['b'] new:['B']}]

        again.start ▸ 1
        again.marks ▸ {'1':'mod'}

        again = undone ['a' 'b'] [{line:1 old:['X']}]

        again.start ▸ 1
        again.marks ▸ {'0':'del'}
