
use ../util ◆ leak logfile syntax harness config session

use ../view/base   ◆ input crumbs
use ../view/menu   ◆ choices greet
use ../view/screen ◆ screen
use ../../kxk      ▪ kseg
use ../../kxk      ◆ nfs slash watcher testdir
use ../edit        ◆ mode

sample = (opt) ->
    lines = []
    keep = console.log
    console.log = (args...) -> lines.push args
    leak.start opt
    clearInterval leak.timer if leak.timer
    leak.timer = null
    console.log = keep
    lines.length

#!startup
▸ startup

  ▸ loaded

        (mode.loaded instanceof Promise) ▸ true

        ◯ mode.loaded

        mode.names().includes('novim') ▸ true
        mode.pending.length ▸ 0

        loading = config.load()

        (config.loaded instanceof Promise) ▸ true

        ◯ loading
        ◯ config.loaded

        (config.data != null) ▸ true

        watcher.close()

        s = new session fresh:true

        (s.loaded instanceof Promise) ▸ true

        ◯ s.loaded

▸ session

  ▸ directories

        s = new session fresh:true

        s.headless ▸ false
        s.dir ▸ slash.absolute("~/.config/ked/sessions/")
        s.file ▸ slash.path(s.dir "#{s.name}.noon")

        s = new session fresh:true headless:true

        s.headless ▸ true
        s.dir ▸ slash.absolute("~/.config/ked/headless-sessions/")
        s.file ▸ slash.path(s.dir "#{s.name}.noon")

        s = new session fresh:true headless_colors:true

        s.headless ▸ true
        s.dir ▸ slash.absolute("~/.config/ked/headless-sessions/")

  ▸ history

        dir = testdir 'ked-session-history-test'

        ◯ nfs.remove dir

        s = new session fresh:true

        s.dir  = dir
        s.file = slash.path dir 'history.noon'

        s.set 'novim▸history▸ex', ['w' 'foo']
        s.set 'novim▸history▸search', ['bar']

        ◯ s.save()

        s2 = new session fresh:true

        s2.dir  = dir
        s2.file = slash.path dir 'other.noon'

        ◯ s2.loadAndMerge()

        s2.get('novim▸history▸ex')     ▸ ['w' 'foo']
        s2.get('novim▸history▸search') ▸ ['bar']

        s2.clear()

        ◯ nfs.remove dir

#!harness
▸ harness

  ▸ write

        h = new harness

        h.t.written() ▸ ''

        h.t.write 'hello'

        h.t.written() ▸ 'hello'

  ▸ views

        h = new harness

        c = new crumbs h.screen 'test_crumbs'
        c.layout 0 0 30 1
        c.set '/home/kodi/s'
        c.draw()

        row = h.row 0

        row.includes 'kodi' ▸ true
        row.includes 's' ▸ true
        h.row 1 ▸ ''

        h = new harness

        c = new choices h.screen 'test_choices'
        c.layout 0 0 20 3
        c.set ['one' 'two' 'three']
        c.select 0

        c.currentIndex() ▸ 0

        h.key c 'down'

        c.currentIndex() ▸ 1

        h = new harness

        i = new input h.screen 'test_input'
        i.layout 0 0 20 1

        h.focus i

        i.hasFocus() ▸ true

        h.type i 'xyz'

        i.current() ▸ 'xyz'

  ▸ marks

        h = new harness

        i = new input h.screen 'test_input'
        i.layout 0 0 20 1
        i.state.loadLines ['abc']

        h.focus i
        i.state.setMainCursor 1 0
        i.draw()

        h.row 0 ▸ 'abc'
        h.rowMarked 0 ▸ "a#{screen.MAIN_MARK}b#{screen.END_MARK}c"

        h = new harness

        h.screen.set 0 0 'a'
        h.screen.set_mark 0 0 'selection'

        h.rowMarked 0 ▸ "#{screen.SELECT_MARK}a#{screen.END_MARK}"

        h = new harness

        h.screen.set 0 0 'a'
        h.screen.set_mark 0 0 'highlight'

        h.rowMarked 0 ▸ "#{screen.HILGHT_MARK}a#{screen.END_MARK}"

  ▸ colors

        h = new harness

        h.screen.set 0 0 'a' [10 20 30] [1 2 3]

        line = h.screen.textColored()[0]

        line.includes '\x1b[48;2;1;2;3m'   ▸ true
        line.includes '\x1b[38;2;10;20;30m' ▸ true
        line.includes 'a'                   ▸ true
        line.endsWith '\x1b[0m'             ▸ true

        h = new harness

        h.screen.set 0 0 'a' [10 20 30] [1 2 3]
        h.screen.set_mark 0 0 'main'

        line = h.screen.textColored()[0]

        line.includes "#{screen.MAIN_MARK}a#{screen.END_MARK}" ▸ true

        h = new harness

        h.screen.set 0 0 'a' [10 20 30] [1 2 3]
        h.screen.set_mark 0 0 'selection'

        line = h.screen.textColored()[0]

        line.includes "#{screen.SELECT_MARK}a#{screen.END_MARK}" ▸ true

        h = new harness

        h.screen.set 0 0 'a' [10 20 30] [1 2 3]
        h.screen.set_mark 0 0 'highlight'

        line = h.screen.textColored()[0]

        line.includes "#{screen.HILGHT_MARK}a#{screen.END_MARK}" ▸ true

  ▸ greeter

        h = new harness

        g = new greet h.screen
        g.show()
        g.layout 0 0
        g.draw()

        h.screen.get_bg 0  23 ▸ [0 0 0]
        h.screen.get_bg 79 0  ▸ [0 0 0]

#!logfile
▸ logfile

  ▸ headless

        before = [console.log console.warn console.error]
        log = new logfile 'test' true

        log.stream ▸ undefined
        (console.log == before[0]) ▸ true
        (console.warn == before[1]) ▸ true
        (console.error == before[2]) ▸ true

        log = new logfile 'test' true

        log.write 'nothing happens'

        log = new logfile 'test' true
        closed = false

        log.close -> closed = true

        closed ▸ true

  ▸ capture

        before = [console.log console.warn console.error]
        lf = new logfile 'test' true true
        console.log 'a' {b:1}
        console.error "#{r5 'red'}\nnext"
        console.log   = before[0]
        console.warn  = before[1]
        console.error = before[2]

        lf.take() ▸ ['a b   1' 'red' 'next']
        lf.take() ▸ []

▸ leak

  ▸ headless

        sample(headless:true)        ▸ 0
        sample(headless_colors:true) ▸ 0

#!syntax
▸ syntax

  ▸ argument

        s = new syntax 'test'
        s.setExt 'kode'
        s.setLines ['class Foo']

        x = 0
        y = 0
        clss = s.getClass x y
        ch   = 'F'

        s.getColor(x y clss) ▸ s.getColor(x y)
        s.getChar(x y ch clss) ▸ s.getChar(x y ch)

        origGetClass = s.getClass
        calls = 0
        s.getClass = (cx cy) ->
            calls += 1
            origGetClass cx cy

        s.getColor x y clss
        s.getChar x y ch clss
        calls ▸ 0

        s.getColor x y
        s.getChar x y ch
        calls ▸ 2

  ▸ getClasses

        s = new syntax 'test'
        s.setExt 'kode'
        lines = ['# header' 'f = (a) -> a + 1' '   indented' "u = '🌈'" '']
        s.setLines lines

        lim = 40

        for y in 0...lines.length
            classes = s.getClasses y
            for x in 0...lim
                clss = classes[x]
                clss ?= 'text'
                exp = s.getClass x y
                clss ▸ exp

        s.getClasses(4).length ▸ 0

        s.diss[0] = [start:0 length:1 clss:'']

        blank = s.getClasses(0)[0]
        blank ▸ ''

        hole = s.getClasses(0)[1]
        hole ?= 'text'
        hole ▸ 'text'

  ▸ setSegls

        same = (edited next) ->
            fresh = new syntax 'test'
            fresh.setExt 'kode'
            fresh.setLines next
            for y in 0...next.length
                for x in 0...8
                    edited.getClass(x y) ▸ fresh.getClass(x y)

        s = new syntax 'test'
        s.setExt 'kode'

        lines = kseg.segls ['a = 1' 'b = 2' 'c = 3']
        s.setSegls lines

        keep = s.diss[0]

        next = [lines[0] kseg('bee = 22') kseg('c = 333')]
        s.setSegls next lines

        s.diss[0] == keep ▸ true

        same s next

        s = new syntax 'test'
        s.setExt 'kode'

        lines = ['a = 1' 'b = 2']
        s.setLines lines

        next = [lines[0] lines[1] kseg('c = 3')]
        s.setSegls next lines

        s.diss.length ▸ 3

        same s next

▸ number inputs

  ▸ numbers

        h = new harness

        i = new input h.screen 'test_number_input' number:true min:0 max:5
        i.layout 0 0 20 1

        i.changeValue 10
        i.getValue() ▸ '5'

        i.changeValue -3
        i.getValue() ▸ '0'

        i.changeValue 3
        i.getValue() ▸ '3'

        i.onWheel {dir:'down' cell:[1 0]}
        i.getValue() ▸ '2'

        i.changeValue 0
        i.onWheel {dir:'down' cell:[1 0]}
        i.getValue() ▸ '0'

        h = new harness

        i = new input h.screen 'test_number_input_string' number:true min:0 max:5
        i.layout 0 0 20 1

        i.changeValue 3

        i.getValue() ▸ '3'
        i.int() ▸ 3

  ▸ percent

        h = new harness

        i = new input h.screen 'test_number_input_percent' number:true min:0 max:999 percent:true
        i.layout 0 0 20 1

        i.changeValue '50%'

        i.current() ▸ '50%'
        i.getValue() ▸ '50%'
        i.int() ▸ 50

        i.changeValue '150%'
        i.current() ▸ '100%'

        i.changeValue '200'
        i.current() ▸ '200'

        h = new harness

        i = new input h.screen 'test_number_input_percent_wheel' number:true min:0 max:999 percent:true
        i.layout 0 0 20 1

        i.changeValue '50%'
        i.onWheel {dir:'up' cell:[1 0]}

        i.current() ▸ '51%'

        h = new harness

        i = new input h.screen 'test_number_input_percent_typing' number:true min:0 max:999 percent:true
        i.layout 0 0 20 1

        h.focus i
        h.type i '50%'

        i.current() ▸ '50%'
