
use fs
use ../../kxk    ▪ slash
use ../edit      ◆ editor
use ../util      ◆ harness config
use ../index     ◆ prjcts
use ../view/menu ◆ searcher

▸ searcher

  ▸ a multi file search appends its results once

        root  = '/tmp/opencode/ked-searcher-append'
        main  = slash.path root 'main.kode'
        other = slash.path root 'other.kode'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true

        fs.writeFileSync slash.path(root 'package.json') '{}'
        fs.writeFileSync main  'if a\n'
        fs.writeFileSync other 'if b\n'

        delete prjcts.projects[root]
        delete prjcts.allFiles[main]
        delete prjcts.allFiles[other]

        global.ked_session =
            get: (key) -> main
            set: (key value) -> null

        savedConfig = config.data
        config.data =
            project: maxDepth:12 ignore:[]
            sourceFileExtensions: ['kode']

        ○ prjcts.index main

        h = new harness cols:80 rows:30
        e = new editor h.screen 'test_editor' ['gutter']
        e.cells.layout 0 0 80 30
        s = new searcher h.screen e

        appendCount = 0
        append = s.choices.append.bind s.choices
        s.choices.append = (items ext) ->
            appendCount += 1
            append items ext

        ○ s.show 'if'

        appendCount ▸ 1
        s.sfils.length ▸ 2
        s.sfils.map((f) -> f.lineIndex).sort((a b) -> a-b) ▸ [1 5]
        s.choices.items.length ▸ 8

        config.data = savedConfig
        delete global.ked_session
        fs.rmSync root recursive:true force:true

  ▸ results are appended as soon as the visible rows are filled

        root = '/tmp/opencode/ked-searcher-threshold'
        files = []

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true

        fs.writeFileSync slash.path(root 'package.json') '{}'

        for i in 0...5
            file = slash.path root "file#{i}.kode"
            fs.writeFileSync file 'if a\n'
            files.push file

        main = files[0]

        delete prjcts.projects[root]
        for file in files ➜ delete prjcts.allFiles[file]

        global.ked_session =
            get: (key) -> main
            set: (key value) -> null

        savedConfig = config.data
        config.data =
            project: maxDepth:12 ignore:[]
            sourceFileExtensions: ['kode']

        ○ prjcts.index main

        h = new harness cols:80 rows:30
        e = new editor h.screen 'test_editor' ['gutter']
        e.cells.layout 0 0 80 10
        s = new searcher h.screen e

        appends = []
        append = s.choices.append.bind s.choices
        s.choices.append = (items ext) ->
            appends.push items.length
            append items ext

        ○ s.show 'if'

        appends ▸ [12 8]
        s.sfils.length ▸ 5
        s.sfils.map((f) -> f.lineIndex).sort((a b) -> a-b) ▸ [1 5 9 13 17]
        s.choices.items.length ▸ 20

        config.data = savedConfig
        delete global.ked_session
        fs.rmSync root recursive:true force:true

  ▸ the gutter width follows the displayed line numbers

        root = '/tmp/opencode/ked-searcher-gutter'
        files = []

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true

        fs.writeFileSync slash.path(root 'package.json') '{}'

        for i in 0...5
            file  = slash.path root "file#{i}.kode"
            lines = []
            for j in 0...99 ➜ lines.push 'x'
            lines.push 'if a'
            fs.writeFileSync file lines.join('\n')
            files.push file

        main = files[0]

        delete prjcts.projects[root]
        for file in files ➜ delete prjcts.allFiles[file]

        global.ked_session =
            get: (key) -> main
            set: (key value) -> null

        savedConfig = config.data
        config.data =
            project: maxDepth:12 ignore:[]
            sourceFileExtensions: ['kode']

        ○ prjcts.index main

        h = new harness cols:80 rows:30
        e = new editor h.screen 'test_editor' ['gutter']
        e.cells.layout 0 0 80 10
        s = new searcher h.screen e

        widths = []
        highlight = s.highlightTextAndEmitRedraw.bind s
        s.highlightTextAndEmitRedraw = (text) ->
            highlight text
            s.arrange()
            widths.push s.choices.gutter.cells.cols

        ○ s.show 'if'

        widths ▸ [5 5]
        s.choices.gutter.cells.cols ▸ 5

        config.data = savedConfig
        delete global.ked_session
        fs.rmSync root recursive:true force:true

  ▸ next and previous file headers jump and scroll to the top

        root = '/tmp/opencode/ked-searcher-headers'
        files = []

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true

        fs.writeFileSync slash.path(root 'package.json') '{}'

        for i in 0...4
            file = slash.path root "file#{i}.kode"
            fs.writeFileSync file 'if a\n'
            files.push file

        main = files[0]

        delete prjcts.projects[root]
        for file in files ➜ delete prjcts.allFiles[file]

        global.ked_session =
            get: (key) -> main
            set: (key value) -> null

        savedConfig = config.data
        config.data =
            project: maxDepth:12 ignore:[]
            sourceFileExtensions: ['kode']

        ○ prjcts.index main

        h = new harness cols:80 rows:30
        e = new editor h.screen 'test_editor' ['gutter']
        e.cells.layout 0 0 80 30
        s = new searcher h.screen e

        ○ s.show 'if'

        s.choices.currentIndex() ▸ 0

        s.selectNextFileHeader() ▸ true
        s.choices.currentIndex() ▸ 1
        s.choices.state.s.view[1] ▸ 1

        s.selectNextFileHeader() ▸ true
        s.choices.currentIndex() ▸ 5
        s.choices.state.s.view[1] ▸ 5

        s.selectPrevFileHeader() ▸ true
        s.choices.currentIndex() ▸ 1
        s.choices.state.s.view[1] ▸ 1

        s.selectPrevFileHeader() ▸ false
        s.choices.currentIndex() ▸ 1
        s.choices.state.s.view[1] ▸ 1

        config.data = savedConfig
        delete global.ked_session
        fs.rmSync root recursive:true force:true
