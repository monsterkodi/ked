
use fs
use ../../kxk ▪ slash sleep post
use ../edit     ◆ editor
use ../util     ◆ harness
use ../theme    ◆ icons
use ../view/colmns ◆ dircol

makeCol = ○->

    store = {}
    fakeGet = (key def) ->
        ⮐ def if not key?.split?
        prefix = key + '▸'
        result = {}
        found = false
        for k,v of store
            continue if not k.startsWith prefix
            rest = k[prefix.length..]
            parts = rest.split '▸'
            if parts.length == 1
                result[parts[0]] = v
            else
                result[parts[0]] ?= {}
                result[parts[0]][parts[1..].join('▸')] = v
            found = true
        ⮐ result if found
        store[key] ? def
    fakeSet = (key value) -> store[key] = value
    fakeDel = (key) -> delete store[key]
    global.ked_session = get:fakeGet set:fakeSet del:fakeDel

    h = new harness cols:100 rows:30
    e = new editor h.screen 'test_editor' []
    d = new dircol h.screen e []
    d.layout 0 0 100 30

    ○ waitForRoot d process.cwd()
    d

waitForRoot = (d root) ○->
    parent = slash.dir root
    n = 0
    while n < 100
        items = d.dirtree.items
        ⮐ if not empty items and items[0].path == parent
        ○ sleep 10
        n += 1
###
▸ dirtree

  ▸ create events add entries

        root = '/tmp/opencode/ked-dirtree-create'
        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true

        d =○ makeCol()
        d.setRoot root
        ○ waitForRoot d root

        file = slash.path root 'a.txt'
        fs.writeFileSync file 'hello'
        post.emit 'file.change' path:file change:'create'
        ○ sleep 120

        names = d.dirtree.items.map (i) -> i.path

        fs.rmSync root recursive:true force:true

        (file in names) ▸ true

  ▸ delete events remove entries even when the root becomes empty

        root = '/tmp/opencode/ked-dirtree-delete'
        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        file = slash.path root 'a.txt'
        fs.writeFileSync file 'hello'

        d =○ makeCol()
        d.setRoot root
        ○ waitForRoot d root

        fs.rmSync file
        post.emit 'file.change' path:file change:'delete'
        ○ sleep 120

        names = d.dirtree.items.map (i) -> i.path

        fs.rmSync root recursive:true force:true

        (file in names) ▸ false

  ▸ rename events move entries

        root = '/tmp/opencode/ked-dirtree-rename'
        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        oldFile = slash.path root 'a.txt'
        newFile = slash.path root 'b.txt'
        fs.writeFileSync oldFile 'hello'

        d =○ makeCol()
        d.setRoot root
        ○ waitForRoot d root

        fs.renameSync oldFile newFile
        post.emit 'file.change' path:newFile oldPath:oldFile change:'rename'
        ○ sleep 120

        names = d.dirtree.items.map (i) -> i.path

        fs.rmSync root recursive:true force:true

        (newFile in names) ▸ true
        (oldFile in names) ▸ false

  ▸ create events update open directories

        root = '/tmp/opencode/ked-dirtree-open'
        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        sub = slash.path root 'sub'
        fs.mkdirSync sub
        fs.writeFileSync slash.path(sub 'keep.txt') 'hello'

        d =○ makeCol()
        d.setRoot root
        ○ waitForRoot d root

        ○ d.dirtree.openDir d.dirtree.itemForPath(sub) redraw:true

        file = slash.path sub 'new.txt'
        fs.writeFileSync file 'hello'
        post.emit 'file.change' path:file change:'create'
        ○ sleep 120

        names = d.dirtree.items.map (i) -> i.path
        open  = d.dirtree.itemForPath(sub)?.open

        fs.rmSync root recursive:true force:true

        (file in names) ▸ true
        open ▸ true

  ▸ modify events leave the tree alone

        root = '/tmp/opencode/ked-dirtree-modify'
        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        file = slash.path root 'a.txt'
        fs.writeFileSync file 'hello'

        d =○ makeCol()
        d.setRoot root
        ○ waitForRoot d root

        count = d.dirtree.items.length

        fs.writeFileSync file 'changed'
        post.emit 'file.change' path:file change:'modify'
        ○ sleep 120

        after = d.dirtree.items.length

        fs.rmSync root recursive:true force:true

        after ▸ count
###

▸ context menu

  ▸ is safe

        root = '/tmp/opencode/ked-dirtree-context'
        parent = {path:'/tmp/opencode' type:'dir' tilde:'  ..'}
        sub = {path:slash.path(root,'sub') type:'dir'}
        outside = {path:'/opt/elsewhere' type:'dir'}
        allow = [root]
        create = icons.dir_open + ' '

        dircol.isAllowedPath('~/s/x', ['~/s']) ▸ true
        dircol.isAllowedPath('~/s/x', ['~']) ▸ true
        dircol.isAllowedPath(outside.path allow) ▸ false

        dircol.isParentItem(parent) ▸ true
        dircol.contextItems(parent root allow) ▸ []
        dircol.contextItems(outside root allow) ▸ []
        dircol.contextItems({path:'/tmp' type:'dir'} root ['/tmp']) ▸ []
        dircol.contextItems({path:'/' type:'dir'} root ['/']) ▸ [create]
        dircol.contextItems({path:root type:'dir'} root allow) ▸ [create]
        dircol.contextItems(sub root allow) ▸ ['\uF044 ' '\uF0C5 ' create '\uF014 ']

        dircol.contextActionAllowed(parent root create allow) ▸ false
        dircol.contextActionAllowed(outside root create allow) ▸ false
        dircol.contextActionAllowed({path:root type:'dir'} root icons.dir_open allow) ▸ true
        dircol.contextActionAllowed({path:root type:'dir'} root 'rename' allow) ▸ false
        dircol.contextActionAllowed(sub root create allow) ▸ true

        event = {pos:[3 5]}
        dirtree =
            currentRoot: root
            cells:
                inside: (x y) -> true
            eventPos: (e) -> e.pos
            state: s: view:[0 0]
            choiceAtRow: (index) -> null
        dircol.itemAtEvent(event dirtree) ▸ null
        dirtree.choiceAtRow = (index) -> sub
        dircol.itemAtEvent(event dirtree) ▸ sub
