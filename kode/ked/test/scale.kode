        scr.get_fg(3 0) ▸ [255 0 0]
        scr.get_fg(6 0) ▸ [255 0 0]
        scr.get_fg(9 0) ▸ [255 0 0]

  ▸ a colour reaches the blocks of a run

        t = new ttio headless:true input:false textSizing:true cols:40 rows:10
