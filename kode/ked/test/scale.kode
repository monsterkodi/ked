  ▸ the gutter numbers a scaled line only on its first row

        [h e] = hed 30 10 'md' ['gutter']
        e.state.loadLines ['# One' 'a' 'b']

        e.draw()

        h.row(0).startsWith('  1 ') ▸ true
        h.row(1) ▸ ''
        h.row(2) ▸ ''
        h.row(3).startsWith('  2 ') ▸ true
        h.row(4).startsWith('  3 ') ▸ true

  ▸ the buffer height is measured in display rows

        s = tstt()
        s.loadLines ['# a' 'b' '## c' 'd']

        s.totalRows() ▸ 7

        s.rowsBeforeLine 0 ▸ 0
        s.rowsBeforeLine 1 ▸ 3
        s.rowsBeforeLine 2 ▸ 4
        s.rowsBeforeLine 3 ▸ 6
        s.rowsBeforeLine 4 ▸ 7

        s.lineAtAbsoluteRow 0 ▸ 0
        s.lineAtAbsoluteRow 2 ▸ 0
        s.lineAtAbsoluteRow 3 ▸ 1
        s.lineAtAbsoluteRow 4 ▸ 2
        s.lineAtAbsoluteRow 5 ▸ 2
        s.lineAtAbsoluteRow 6 ▸ 3
        s.lineAtAbsoluteRow 99 ▸ 3

        s.setView [0 2]

        s.viewTopRow() ▸ 4
        s.rowOfLine 3 ▸ 2
        s.rowOfLine 0 ▸ -4

        s.syntax.setExt 'txt'
        s.totalRows() ▸ 4

        s.syntax.setExt 'md'
        s.totalRows() ▸ 7

  ▸ the map shows scaled lines with their real height

        [h e] = hed  cols:40 rows:10
        e.state.loadLines ['a' 'b' 'c' 'd' 'e' '# h1' 'f' 'g' 'h' 'i' 'j']

        m = new mapscr e
        m.cells.layout 30 0 12 10
        m.csz = [10 20]

        e.state.setView [0 0]
        m.calcView()

        m.topLine ▸ 0
        m.botLine ▸ 10
        m.lineOffset(5) ▸ 20
        m.lineOffset(6) ▸ 32
        (m.lineOffset(6) - m.lineOffset(5)) ▸ 12

  ▸ the map reloads lines restored by undo

        [h e] = hed  cols:40 rows:10
        e.state.loadLines ['aaa' 'bbb' 'ccc']
        e.state.setLines ['aaa' 'XXX' 'bbb' 'ccc']
        e.state.undo()

        m = new mapscr e
        m.cells.layout 30 0 12 10
        m.show()
        h.screen.t.pixels = [400 200]
        h.screen.t.cellsz = [10 20]

        m.createImages()
        m.reload()
        m.calcView()
        m.drawImages()

        m.imageCache.size ▸ 3
        kseg.str(m.getSegls()[1]) ▸ 'bbb'

  ▸ the map follows inserted and removed lines

        [h e] = hed  cols:40 rows:10
        e.state.loadLines ['aaa' 'bbb' 'ccc']

        m = new mapscr e
        m.cells.layout 30 0 12 10
        m.show()
        h.screen.t.pixels = [400 200]
        h.screen.t.cellsz = [10 20]
        m.createImages()

        m.calcView()
        m.drawImages()

        m.imageCache.size ▸ 3

        e.state.setLines ['aaa' 'bbb' 'foo' 'bar' 'ccc']

        m.calcView()
        m.drawImages()

        m.imageCache.size ▸ 5
        kseg.str(m.getSegls()[4]) ▸ 'ccc'

        e.state.loadLines ['aaa' 'bbb' 'ccc']

        m.calcView()
        m.drawImages()

        m.imageCache.size ▸ 3

  ▸ a suspended map waits for the restored view

        [h e] = hed cols:40 rows:20
        m = new mapscr e
        m.cells.layout 30 0 12 20
        m.show()
        h.screen.t.pixels = [400 400]
        h.screen.t.cellsz = [10 20]

        e.state.loadLines [("old #{i}") for i in 0...1000]
        m.reload()

        h.screen.t.out = []

        m.suspend()

        e.state.loadSegls kseg.segls([("new #{i}") for i in 0...2000])
        e.state.setView [0 1200]

        m.resume()

        h.screen.t.written() ▸ ''
        m.redraw ▸ true

        m.layout 30 0 12 20

        out = h.screen.t.written()

        (m.topLine > 0) ▸ true
        (m.imageCache.size <= 100) ▸ true
        out.includes('a=p,') ▸ true

  ▸ the map only renders the lines it can show

        [h e] = hed cols:40 rows:10
        e.state.loadLines [("line #{i}") for i in 0...2000]

        m = new mapscr e
        m.cells.layout 30 0 12 10
        m.show()
        h.screen.t.pixels = [400 200]
        h.screen.t.cellsz = [10 20]
        m.createImages()

        e.state.setView [0 0]
        m.calcView()
        m.drawImages()

        (m.imageCache.size < 60) ▸ true

  ▸ inserting and undoing a line does not blank or re-upload the map

        [h e] = hed cols:40 rows:10
        e.state.loadLines [("line #{i}") for i in 0...20]

        m = new mapscr e
        m.cells.layout 30 0 12 10
        m.show()
        h.screen.t.pixels = [400 200]
        h.screen.t.cellsz = [10 20]
        m.createImages()
        m.calcView()
        m.drawImages()

        m.imageCache.size ▸ 20

        uploads   = 0
        removals  = 0
        send      = h.screen.t.sendImageData
        remove    = h.screen.t.deleteImagesInRange

        h.screen.t.sendImageData = (args...) ->
            uploads += 1
            send.apply h.screen.t args

        h.screen.t.deleteImagesInRange = (args...) ->
            removals += 1
            remove.apply h.screen.t args

        e.state.setMainCursor 0 10
        e.state.insert '\n'

        m.calcView()
        m.drawImages()

        removals ▸ 0
        (uploads < 5) ▸ true
        (m.imageCache.size <= 22) ▸ true

        uploads  = 0
        e.state.undo()

        m.calcView()
        m.drawImages()

        removals ▸ 0
        (uploads < 4) ▸ true
        m.imageCache.size ▸ 20

  ▸ a scaled line gets a taller stripe in the map

        [h e] = hed 40 10
        e.state.loadLines ['a' 'b' '# h1' 'c' 'd']

        m = new mapscr e
        m.cells.layout 30 0 12 10
        h.screen.t.pixels = [400 200]
        h.screen.t.cellsz = [10 20]
        m.createImages()

        id0 = m.ensureImage 0
        id2 = m.ensureImage 2

        h.screen.t.out = []

        e.state.setView [0 0]
        m.drawImages()

        out = h.screen.t.written()

        (out.split("i=#{id0},").length - 1) ▸ 4
        (out.split("i=#{id2},").length - 1) ▸ 12

  ▸ a scaled line is also wider in the map

        [h e] = hed  cols:40 rows:10
        e.state.loadLines ['#']
        e.state.applyScales {enable:true md:{h1:7}}

        m = new mapscr e
        m.cells.layout 30 0 12 10
        m.csz = [10 20]

        bg = m.color.bg
        data = Buffer.alloc (m.cells.cols*m.csz[0]*m.imageHeight(0)*3)

        m.imageForLine data e.state.s.lines[0] 0

        ink = false
        for y in 0...m.imageHeight(0)
            for x in 0...14
                i = (y*m.cells.cols*m.csz[0]+x)*3
                if data[i] != bg[0] or data[i+1] != bg[1] or data[i+2] != bg[2]
                    ink = true
        ink ▸ true

        m.calcView()
        (m.pixelPos([1 0])[0] - m.mapX) ▸ 14
        m.pixelPos([1 0])[1] ▸ m.mapY

        e.state.syntax.setExt 'txt'
        data = Buffer.alloc (m.cells.cols*m.csz[0]*3)
        m.imageForLine data e.state.s.lines[0] 0

        data[18] ▸ bg[0]
        data[19] ▸ bg[1]
        data[20] ▸ bg[2]

  ▸ the quicky map shows scaled lines with their real height

        [h e] = hed  cols:40 rows:10
        e.state.loadLines ['a' 'b' 'c' 'd' 'e' '# h1' 'f' 'g']

        m = new mapview h.screen e.state
        m.setSyntaxSegls 'md' e.state.s.lines
        m.setScales {enable:true md:{h1:3}}

        m.cells.layout 30 0 12 10
        m.csz = [10 20]

        m.lineRows(5) ▸ 3
        m.lineOffsetPixels(5) ▸ 20
        m.lineOffsetPixels(6) ▸ 32
        m.lineOffsetPixels(7) ▸ 36

        m.setScales {enable:false md:{h1:3}}

        m.lineRows(5) ▸ 1
