▸ map

  ▸ the map follows the mapScroll setting

        [h e] = hed cols:40 rows:10
        old = config.data

        m = new mapscr e

        config.data = {mapScroll: {enable: true}}
        post.emit 'config.loaded' config.data
        m.visible() ▸ true

        config.data = {mapScroll: {enable: false}}
        post.emit 'config.loaded' config.data
        m.hidden() ▸ true

        post.emit 'popup.hide' 'macro'
        m.hidden() ▸ true

        post.emit 'popup.show' 'finder'
        m.hidden() ▸ true

        post.emit 'greet.hide'
        m.hidden() ▸ true

        config.data = {mapScroll: {enable: true}}
        post.emit 'config.loaded' config.data
        m.visible() ▸ true

        post.emit 'popup.show' 'differ'
        m.hidden() ▸ true

        post.emit 'popup.hide' 'differ'
        m.visible() ▸ true

        config.data = old

▸ squares

  ▸ tilesInRect

        squares.csz = [10 20] 
        squares.tilesInRect  0  0 10 10 ▸ [[0 0 0  0 10 10]]
        squares.tilesInRect  5  5  5  5 ▸ [[0 0 5  5  5  5]]
        squares.tilesInRect 15 15  5 10 ▸ [[1 0 5 15  5  5] [1 1 5 0  5  5]]
        squares.tilesInRect 10 15 10 30 ▸ [[1 0 0 15 10  5] [1 1 0 0 10 20] [1 2 0 0 10 5]]

        squares.tilesInRect 5   0 15 10 ▸ [[0 0 5 0 5 10]  [1 0 0 0 10 10]]
        squares.tilesInRect 15  0 15 10 ▸ [[1 0 5 0 5 10]  [2 0 0 0 10 10]]
        squares.tilesInRect 5   5 25 15 ▸ [[0 0 5 5 5 15]  [1 0 0 5 10 15] [2 0 0 5 10 15]]
        squares.tilesInRect 15 25 15 15 ▸ [[1 1 5 5 5 15]  [2 1 0 5 10 15]]
        squares.tilesInRect 0   0 25 25 ▸ [[0 0 0 0 10 20] [1 0 0 0 10 20] [2 0 0 0 5 20] [0 1 0 0 10 5] [1 1 0 0 10 5] [2 1 0 0 5 5]]
