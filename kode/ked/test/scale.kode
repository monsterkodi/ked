    ▸ the buffer height is measured in display rows

        s = new state cells 'test_scale_rows'
        s.syntax.setExt 'md'
        s.loadLines ['# a' 'b' '## c' 'd']

        s.totalRows() ▸ 7

        s.rowsBeforeLine 0 ▸ 0
        s.rowsBeforeLine 1 ▸ 3
        s.rowsBeforeLine 2 ▸ 4
        s.rowsBeforeLine 3 ▸ 6
        s.rowsBeforeLine 4 ▸ 7

        s.lineAtAbsoluteRow 0 ▸ 0
        s.lineAtAbsoluteRow 2 ▸ 0
        s.lineAtAbsoluteRow 3 ▸ 1
        s.lineAtAbsoluteRow 4 ▸ 2
        s.lineAtAbsoluteRow 5 ▸ 2
        s.lineAtAbsoluteRow 6 ▸ 3
        s.lineAtAbsoluteRow 99 ▸ 3

        s.setView [0 2]

        s.viewTopRow() ▸ 4
        s.rowOfLine 3 ▸ 2
        s.rowOfLine 0 ▸ -4

        s.syntax.setExt 'txt'
        s.totalRows() ▸ 4

        s.syntax.setExt 'md'
        s.totalRows() ▸ 7

    ▸ the map shows scaled lines with their real height

        h = new harness cols:40 rows:10
        e = new editor h.screen 'test_scale_map_rows' []

        e.layout 0 0 40 10
        e.state.syntax.setExt 'md'
        e.state.loadLines ['a' 'b' 'c' 'd' 'e' '# h1' 'f' 'g' 'h' 'i' 'j']

        m = new mapscr e
        m.cells.layout 30 0 12 10
        m.csz = [10 20]

        e.state.setView [0 0]
        m.calcView()

        m.topLine ▸ 0
        m.botLine ▸ 10
        m.lineOffset(5) ▸ 20
        m.lineOffset(6) ▸ 32
        (m.lineOffset(6) - m.lineOffset(5)) ▸ 12

        m.scrollToPixel [0 (m.mapY + m.lineOffset(5) + 4)]

        e.state.mainCursor()[1] ▸ 10

    ▸ a scaled line gets a taller stripe in the map

        h = new harness cols:40 rows:10
        e = new editor h.screen 'test_scale_map_stripe' []

        e.layout 0 0 40 10
        e.state.syntax.setExt 'md'
        e.state.loadLines ['a' 'b' '# h1' 'c' 'd']

        m = new mapscr e
        m.cells.layout 30 0 12 10
        m.csz = [10 20]
        m.images = [100 101 102 103 104]

        h.screen.t.pixels = [400 200]
        h.screen.t.cellsz = [10 20]
        h.screen.t.out = []

        e.state.setView [0 0]
        m.drawImages()

        out = h.screen.t.written()

        (out.split('i=100,').length - 1) ▸ 4
        (out.split('i=102,').length - 1) ▸ 12

    ▸ the map follows the display rows near the end of a long file

        h = new harness cols:40 rows:10
        e = new editor h.screen 'test_scale_map_deep' []

        e.layout 0 0 40 10
        e.state.syntax.setExt 'md'

        lines = []
        for i in 0...200
            lines.push (i % 10 == 0) ? '# h1' : 'text'
        e.state.loadLines lines

        m = new mapscr e
        m.cells.layout 30 0 12 10
        m.csz = [10 20]

        e.state.setView [0 100]
        m.calcView()

        m.topLine ▸ 81
        m.lineOffset(100) ▸ 84
        (m.lineOffset(100) < m.cells.rows*20) ▸ true

    ▸ the scrollbar reflects the display rows

        h = new harness cols:40 rows:10
        e = new editor h.screen 'test_scale_scrollbar' []

        e.layout 0 0 40 10
        e.state.syntax.setExt 'md'

        lines = []
        for i in 0...20
            lines.push 'text'
        lines[5] = '# h1'
        e.state.loadLines lines

        sc = new scroll h.screen e.state 'left'
        sc.layout 0 0 1 10

        csz = [10 20]

        sc.isActive() ▸ true
        sc.knobHeight(csz) ▸ 90
        sc.knobOffset(csz) ▸ 0

        e.state.setView [0 e.state.maxViewLine()]

        sc.knobOffset(csz) ▸ 110
        (sc.knobOffset(csz) + sc.knobHeight(csz)) ▸ 200

        e.state.loadLines ['a' 'b' 'c']

        sc.isActive() ▸ false
        sc.knobHeight(csz) ▸ 0
        sc.knobOffset(csz) ▸ 0

    ▸ clicking the scrollbar reaches the last display rows

        h = new harness cols:40 rows:10
        e = new editor h.screen 'test_scale_scrollbar_click' []

        e.layout 0 0 40 10
        e.state.syntax.setExt 'md'

        lines = []
        for i in 0...20
            lines.push 'text'
        lines.push '# h1'
        e.state.loadLines lines

        sc = new scroll h.screen e.state 'left'
        sc.layout 0 0 1 10

        h.screen.t.cellsz = [10 20]

        e.state.setView [0 0]
        sc.scrollToPixel [0 180]

        e.state.s.view[1] ▸ e.state.maxViewLine()
        e.state.s.view[1] ▸ 13
