    ▸ a heading is drawn in a block of cells

        h = new harness cols:40 rows:10
        e = new editor h.screen 'test_scale_draw' []

        e.layout 0 0 40 10
        e.state.syntax.setExt 'md'
        e.state.loadLines ['# One' 'a' '## Two' 'b']

        e.draw()

        h.screen.get_char(0  0) ▸ '#'
        h.screen.get_char(3  0) ▸ ' '
        h.screen.get_char(6  0) ▸ 'O'
        h.screen.get_char(12 0) ▸ 'e'

        h.screen.get_char(0  3) ▸ 'a'

        h.screen.get_char(0  4) ▸ '#'
        h.screen.get_char(2  4) ▸ '#'
        h.screen.get_char(6  4) ▸ 'T'

        h.screen.get_char(0  6) ▸ 'b'

    ▸ a scaled character that ends exactly at the right edge is drawn

        h = new harness cols:15 rows:6
        e = new editor h.screen 'test_scale_clip' []

        e.layout 0 0 15 6
        e.state.syntax.setExt 'md'
        e.state.loadLines ['# abc']

        e.draw()

        h.screen.get_char(12 0) ▸ 'c'

        h = new harness cols:14 rows:6
        e = new editor h.screen 'test_scale_clip_none' []

        e.layout 0 0 14 6
        e.state.syntax.setExt 'md'
        e.state.loadLines ['# abc']

        e.draw()

        h.screen.get_char(12 0) ▸ ' '

    ▸ a scaled character carries the text sizing escape

        h = new harness cols:10 rows:5

        h.screen.scaled_char 'x' 2 1 ▸ '\x1b]66;s=2:w=1;x\x07'
        h.screen.scaled_char '🌈' 3 2 ▸ '\x1b]66;s=3:w=2;🌈\x07'

    ▸ a scaled block fills its cells with placeholders

        h = new harness cols:20 rows:5

        h.t.textSizing = true

        h.screen.add_scaled 0 0 'x' null null 2 ▸ 2

        h.screen.get_char(0 0) ▸ '\x1b]66;s=2:w=1;x\x07'
        h.screen.get_char(1 0) ▸ null
        h.screen.get_char(0 1) ▸ '\x1b[2C'
        h.screen.get_char(1 1) ▸ null

        h.screen.add_scaled 5 0 '🌈' null null 2 ▸ 4

        h.screen.get_char(5 0) ▸ '\x1b]66;s=2:w=2;🌈\x07'
        h.screen.get_char(6 0) ▸ null
        h.screen.get_char(5 1) ▸ '\x1b[4C'
        h.screen.get_char(8 1) ▸ null

    ▸ the cursor sits on the scaled line

        h = new harness cols:40 rows:10
        e = new editor h.screen 'test_scale_cursor' []

        e.layout 0 0 40 10
        e.state.syntax.setExt 'md'
        e.state.loadLines ['# One' '## Two' 'text']

        e.state.setMainCursor 0 1
        e.draw()

        h.screen.c[3][0].mark ▸ 'main'

    ▸ the block rectangle of the previous frame is erased

        h = new harness cols:20 rows:8
        h.t.textSizing = true

        e = new editor h.screen 'test_scale_erase' []

        e.layout 0 0 20 8
        e.state.syntax.setExt 'md'
        e.state.loadLines ['# big' 'a' 'b' 'c' 'd' 'e' 'f' 'g' 'h']

        h.screen.init()
        e.draw()

        first = h.screen.renderString()

        first.startsWith('\x1b[H') ▸ true

        e.state.scrollView 'down'

        h.screen.init()
        e.draw()

        second = h.screen.renderString()

        second.startsWith("\x1b[1;1H\x1b[15X\x1b[2;1H\x1b[15X\x1b[3;1H\x1b[15X\x1b[H") ▸ true

    ▸ completion is placed and highlighted on normal lines

        h = new harness cols:40 rows:12
        e = new editor h.screen 'test_scale_complete' ['complete']

        e.layout 0 0 40 12
        e.state.syntax.setExt 'kode'
        e.state.loadLines ['funky1 = 1' 'funky2 = 2' 'fun']

        e.complete.posForCursor [3 2] ▸ [3 2]

        e.state.setMainCursor 3 2
        e.complete.complete()

        h.screen.init()
        e.draw()

        h.row(2) ▸ 'funky1'
        h.row(4).includes('funky1') ▸ true
        h.row(5).includes('funky2') ▸ true

        h.screen.get_bg(4 2) ▸ theme.selection.span
        h.screen.get_bg(5 2) ▸ theme.selection.span

    ▸ the completion frame fits at the edges of the editor

        h = new harness cols:30 rows:12
        e = new editor h.screen 'test_complete_left' ['complete']

        e.layout 0 0 30 12
        e.state.syntax.setExt 'kode'
        e.state.loadLines ['funky1 = 1' 'funky2 = 2' 'f']

        e.state.setMainCursor 1 2
        e.complete.complete()

        h.screen.init()
        e.draw()

        h.row(3).startsWith('╭') ▸ true
        h.row(6).startsWith('╰') ▸ true

        h = new harness cols:20 rows:12
        e = new editor h.screen 'test_complete_right' ['complete']

        e.layout 0 0 20 12
        e.state.syntax.setExt 'kode'
        e.state.loadLines ['funky1 = 1' 'funky2 = 2' '...........funky']

        e.state.setMainCursor 16 2
        e.complete.complete()

        h.screen.init()
        e.draw()

        h.row(3).startsWith('         ╭') ▸ true
        h.row(3).endsWith('╮') ▸ true
        h.row(3).length ▸ 20

    ▸ the completion frame moves below a scaled line

        h = new harness cols:40 rows:14
        e = new editor h.screen 'test_complete_scale' ['complete']

        e.layout 0 0 40 14
        e.state.syntax.setExt 'md'
        e.state.loadLines ['# fu' '' 'funky1 = 1' 'funky2 = 2']

        e.state.setMainCursor 4 0
        e.complete.complete()

        h.screen.init()
        e.draw()

        e.state.scaleOfLine(0) ▸ 3

        h.row(1) ▸ ''
        h.row(2) ▸ ''
        h.row(3).startsWith('        ╭') ▸ true
        h.row(6).startsWith('        ╰') ▸ true

    ▸ an erased area is cleared in the cells and on the screen

        h = new harness cols:20 rows:8

        h.screen.set 2 3 'X' null null
        h.screen.set_bg 2 3 [7 8 9]
        h.screen.erase_scaled 2 3 5 3

        h.screen.get_char(2 3) ▸ ' '
        h.screen.get_bg(2 3) ▸ [7 8 9]
        h.screen.renderString().startsWith("\x1b[4;3H\x1b[4X") ▸ true

    ▸ a popup over a scaled line erases the block under it

        h = new harness cols:40 rows:12
        h.t.textSizing = true
        e = new editor h.screen 'test_erase_popup' ['complete']

        e.layout 0 0 40 12
        e.state.syntax.setExt 'md'
        e.state.loadLines ['fu' '# funky1' '# funky2']

        e.state.setMainCursor 2 0
        e.complete.complete()

        h.screen.init()
        e.draw()

        h.screen.renderString().startsWith("\x1b[2;1H\x1b[11X") ▸ true
        h.screen.get_char(11 1) ▸ ' '

    ▸ a context menu erases the block under it

        h = new harness cols:40 rows:12
        c = new context h.screen

        c.show [5 2] (()->) ['one' 'two']

        h.screen.init()
        c.draw()

        h.screen.renderString().startsWith("\x1b[2;6H\x1b[7X") ▸ true

    ▸ the cleared rectangle never leaves a block half drawn

        h = new harness cols:40 rows:12
        h.t.textSizing = true
        e = new editor h.screen 'test_erase_loop' ['complete']

        e.layout 0 0 40 12
        e.state.syntax.setExt 'md'
        e.state.loadLines ['fu  fu  fu  fu  fu' '# funky1' '# funky2']

        for cx in [2 6 10 14 18]

            e.state.setMainCursor cx 0
            e.complete.complete()
            h.screen.init()
            e.draw()

            rect = h.screen.eraseRects[0]

            for [bx by scale w] in h.screen.frameBlocks

                continue if bx > rect[2]
                continue if bx + scale*w - 1 < rect[0]
                continue if by > rect[3]
                continue if by + scale   - 1 < rect[1]

                for xx in bx..bx+scale*w-1
                    for yy in by..by+scale-1
                        (valid h.screen.get_char(xx yy)) ▸ true

