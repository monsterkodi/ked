    ▸ the gutter numbers a scaled line only on its first row

        h = new harness cols:30 rows:10
        e = new editor h.screen 'test_scale_gutter' ['gutter']

        e.layout 0 0 30 10
        e.state.syntax.setExt 'md'
        e.state.loadLines ['# One' 'a' 'b']

        e.draw()

        h.row(0).startsWith('  1 ') ▸ true
        h.row(1) ▸ ''
        h.row(2) ▸ ''
        h.row(3).startsWith('  2 ') ▸ true
        h.row(4).startsWith('  3 ') ▸ true

