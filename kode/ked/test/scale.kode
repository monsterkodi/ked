use ../../kxk      ▪ kseg
use ../edit        ◆ state editor
use ../theme       ◆ theme
use ../util        ◆ harness config
use ../view/menu   ◆ choices context
use ../view/editor ◆ mapscr mapview
use ../view/base   ◆ scroll

cells = cols:40 rows:20
tstt = ext='md' -> 
    s = new state cells 'test_scale'
    s.syntax.setExt ext
    s.applyScales {enabled:true md:{h1:3 h2:2}}
    s

hed = cols rows ext='md' feats=[]->     
        h = new harness 
        e = new editor h.screen 'test_scale' feats
        e.layout 0 0 cols rows
        e.state.syntax.setExt ext
        e.state.applyScales {enabled:true md:{h1:3 h2:2}}
        [h e]

▸ scale

  ▸ markdown headings scale by level

        s = tstt()
        s.loadLines ['# One' '## Two' '### Three' '#### Four' 'text']

        s.lineHeight 0 ▸ 3
        s.lineHeight 1 ▸ 2
        s.lineHeight 2 ▸ 1
        s.lineHeight 3 ▸ 1
        s.lineHeight 4 ▸ 1

  ▸ headings in other files keep their size

        s = tstt 'kode'
        s.loadLines ['# One' '## Two']

        s.lineHeight 0 ▸ 1
        s.lineHeight 1 ▸ 1

  ▸ the configured scales change or disable the scaling

        s = tstt()
        s.loadLines ['# one' '## two' '### three' '#### four' '##### five']

        s.applyScales {enabled:true md:{h1:6 h2:5 h3:4 h4:3 h5:2}}

        s.lineHeight 0 ▸ 6
        s.lineHeight 1 ▸ 5
        s.lineHeight 2 ▸ 4
        s.lineHeight 3 ▸ 3
        s.lineHeight 4 ▸ 2

        s.applyScales {enabled:false}

        s.lineHeight 0 ▸ 1
        s.lineHeight 1 ▸ 1

        s.applyScales {}

        s.lineHeight 0 ▸ 1
        s.lineHeight 1 ▸ 1

        s.applyScales {enabled:true md:{h1:9}}

        s.lineHeight 0 ▸ 7

  ▸ the row map counts the scaled row of every line

        s = tstt()
        s.loadLines ['# One' 'a' '## Two' 'b']

        s.rowOfLine 0 ▸ 0
        s.rowOfLine 1 ▸ 3
        s.rowOfLine 2 ▸ 4
        s.rowOfLine 3 ▸ 6

  ▸ the row map finds the line at a row

        s = tstt()
        s.loadLines ['# One' 'a' '## Two' 'b']

        s.lineAtRow 0 ▸ 0
        s.lineAtRow 2 ▸ 0
        s.lineAtRow 3 ▸ 1
        s.lineAtRow 4 ▸ 2
        s.lineAtRow 5 ▸ 2
        s.lineAtRow 6 ▸ 3
        s.lineAtRow 7 ▸ 3

  ▸ lines above the view have negative rows

        s = tstt()
        s.loadLines ['a' 'b' 'c' 'd' 'e' 'f']
        s.setView [0 4]

        s.rowOfLine 4 ▸ 0
        s.rowOfLine 3 ▸ -1
        s.rowOfLine 1 ▸ -3

  ▸ highlights and cursors above the view are not drawn

        [h e] = hed 40 10
        e.state.loadLines [("line #{i}") for i in 0...20]

        e.state.setView [0 8]
        e.state.setHighlights [[0 4 4 4] [0 10 4 10]]

        h.screen.init()
        e.draw()

        h.screen.get_bg(0 2) ▸ theme.highlight.bg
        h.screen.get_bg(0 4) ▸ theme.editor.bg

        e.state.setCursors [[0 10] [0 4]]
        e.state.setView [0 8]

        e.isCursorVisible [0 4] ▸ false
        e.isCursorVisible [0 10] ▸ true

        h.screen.init()
        e.draw()

        (valid h.screen.c[4][0].mark) ▸ false
        h.screen.c[2][0].mark ▸ 'multi'

  ▸ a cell position maps to a logical position

        s = tstt()
        s.loadLines ['# One' 'a' '## Two']

        s.posForCell 0 0 ▸ [0 0]
        s.posForCell 2 0 ▸ [0 0]
        s.posForCell 3 0 ▸ [1 0]
        s.posForCell 5 0 ▸ [1 0]
        s.posForCell 6 0 ▸ [2 0]

        s.posForCell 0 3 ▸ [0 1]
        s.posForCell 3 3 ▸ [3 1]

        s.posForCell 0 4 ▸ [0 2]
        s.posForCell 1 4 ▸ [0 2]
        s.posForCell 3 4 ▸ [1 2]
        s.posForCell 6 4 ▸ [3 2]

  ▸ a heading is drawn in a block of cells
        
        [h e] = hed 40 10        
        e.state.loadLines ['# One' 'a' '## Two' 'b']

        e.draw()

        h.screen.get_char(0  0) ▸ '#'
        h.screen.get_char(3  0) ▸ ' '
        h.screen.get_char(6  0) ▸ 'O'
        h.screen.get_char(12 0) ▸ 'e'

        h.screen.get_char(0  3) ▸ 'a'

        h.screen.get_char(0  4) ▸ '#'
        h.screen.get_char(2  4) ▸ '#'
        h.screen.get_char(6  4) ▸ 'T'

        h.screen.get_char(0  6) ▸ 'b'

  ▸ a scaled character that ends exactly at the right edge is drawn

        [h e] = hed 15 6
        e.state.loadLines ['# abc']

        e.draw()
        
        h.screen.get_char(12 0) ▸ 'c'

        [h e] = hed 14 6
        e.state.loadLines ['# abc']

        e.draw()

        h.screen.get_char(12 0) ▸ ' '

  ▸ a scaled character carries the text sizing escape

        h = new harness cols:10 rows:5

        h.screen.scaled_char 'x' 2 1 ▸ '\x1b]66;s=2:w=1;x\x07'
        h.screen.scaled_char '🌈' 3 2 ▸ '\x1b]66;s=3:w=2;🌈\x07'

  ▸ a scaled block fills its cells with placeholders

        h = new harness cols:20 rows:5

        h.t.textSizing = true

        h.screen.add_scaled 0 0 'x' null null 2 ▸ 2

        h.screen.get_char(0 0) ▸ '\x1b]66;s=2:w=1;x\x07'
        h.screen.get_char(1 0) ▸ null
        h.screen.get_char(0 1) ▸ '\x1b[2C'
        h.screen.get_char(1 1) ▸ null

        h.screen.add_scaled 5 0 '🌈' null null 2 ▸ 4

        h.screen.get_char(5 0) ▸ '\x1b]66;s=2:w=2;🌈\x07'
        h.screen.get_char(6 0) ▸ null
        h.screen.get_char(5 1) ▸ '\x1b[4C'
        h.screen.get_char(8 1) ▸ null

  ▸ the cursor sits on the scaled line

        [h e] = hed 40 10
        e.state.loadLines ['# One' '## Two' 'text']

        e.state.setMainCursor 0 1
        e.draw()

        h.screen.c[3][0].mark ▸ 'main'

  ▸ horizontal scrolling moves scaled and normal lines together

        [h e] = hed 20 8
        e.state.loadLines ['# abc' 'abc']

        e.state.setView [0 0]
        e.draw()

        h.screen.get_char(6 0) ▸ 'a'
        h.screen.get_char(1 3) ▸ 'b'

        h.screen.init()
        e.state.setView [1 0]
        e.draw()

        h.screen.get_char(5 0) ▸ 'a'
        h.screen.get_char(0 3) ▸ 'b'

  ▸ horizontal positions use display columns

        [h e] = hed 20 8
        e.state.loadLines ['# abc' 'abc']

        e.state.setView [1 0]

        e.state.posForCell 0 0 ▸ [0 0]
        e.state.posForCell 5 0 ▸ [2 0]

        e.state.setCursors [[2 0]] main:0 adjust:false
        e.state.setView [1 0]

        h.screen.init()
        e.draw()

        h.screen.c[0][5].mark ▸ 'main'
        e.isCursorVisible [2 0] ▸ true

        e.state.setView [0 0]
        e.state.setMainCursor 10 0
        e.state.adjustViewForMainCursor()

        e.state.s.view[0] ▸ 14

  ▸ the block rectangle of the previous frame is erased

        [h e] = hed 20 8
        h.t.textSizing = true
        e.state.loadLines ['# big' 'a' 'b' 'c' 'd' 'e' 'f' 'g' 'h']

        h.screen.init()
        e.draw()

        first = h.screen.renderString()

        first.startsWith('\x1b[H') ▸ true

        e.state.scrollView 'down'

        h.screen.init()
        e.draw()

        second = h.screen.renderString()

        second.startsWith("\x1b[1;1H\x1b[15X\x1b[2;1H\x1b[15X\x1b[3;1H\x1b[15X\x1b[H") ▸ true

  ▸ completion is placed and highlighted on normal lines

        [h e] = hed 40 12 'kode' ['complete']
        e.state.loadLines ['funky1 = 1' 'funky2 = 2' 'fun']

        e.complete.posForCursor [3 2] ▸ [3 2]

        e.state.setMainCursor 3 2
        e.complete.complete()

        h.screen.init()
        e.draw()

        h.row(2) ▸ 'funky1'
        h.row(4).includes('funky1') ▸ true
        h.row(5).includes('funky2') ▸ true

        h.screen.get_bg(4 2) ▸ theme.selection.span
        h.screen.get_bg(5 2) ▸ theme.selection.span

  ▸ the completion frame fits at the edges of the editor

        [h e] = hed 30 12 'kode' ['complete']
        e.state.loadLines ['funky1 = 1' 'funky2 = 2' 'f']

        e.state.setMainCursor 1 2
        e.complete.complete()

        h.screen.init()
        e.draw()

        h.row(3).startsWith('╭') ▸ true
        h.row(6).startsWith('╰') ▸ true

        [h e] = hed 20 12 'kode' ['complete']
        e.state.loadLines ['funky1 = 1' 'funky2 = 2' '...........funky']

        e.state.setMainCursor 16 2
        e.complete.complete()

        h.screen.init()
        e.draw()

        h.row(3).startsWith('         ╭') ▸ true
        h.row(3).endsWith('╮') ▸ true
        h.row(3).length ▸ 20

  ▸ the completion frame moves below a scaled line

        [h e] = hed 40 14 'md' ['complete']
        e.state.loadLines ['# fu' '' 'funky1 = 1' 'funky2 = 2']

        e.state.setMainCursor 4 0
        e.complete.complete()

        h.screen.init()
        e.draw()

        e.state.lineHeight(0) ▸ 3

        h.row(1) ▸ ''
        h.row(2) ▸ ''
        h.row(3).startsWith('        ╭') ▸ true
        h.row(6).startsWith('        ╰') ▸ true

  ▸ an erased area is cleared in the cells and on the screen

        h = new harness cols:20 rows:8

        h.screen.set 2 3 'X' null null
        h.screen.set_bg 2 3 [7 8 9]
        h.screen.erase_scaled 2 3 5 3

        h.screen.get_char(2 3) ▸ ' '
        h.screen.get_bg(2 3) ▸ [7 8 9]
        h.screen.renderString().startsWith("\x1b[4;3H\x1b[4X") ▸ true

  ▸ a popup over a scaled line erases the block under it

        [h e] = hed 40 12 'md' ['complete']
        h.t.textSizing = true
        e.state.loadLines ['fu' '# funky1' '# funky2']

        e.state.setMainCursor 2 0
        e.complete.complete()

        h.screen.init()
        e.draw()

        h.screen.renderString().startsWith("\x1b[2;1H\x1b[11X") ▸ true
        h.screen.get_char(11 1) ▸ ' '

  ▸ a context menu erases the block under it

        [h e] = hed 40 12
        c = new context h.screen

        c.show [5 2] (()->) ['one' 'two']

        h.screen.init()
        c.draw()

        h.screen.renderString().startsWith("\x1b[2;6H\x1b[7X") ▸ true

  ▸ a context menu near the bottom moves up to stay on screen

        h = new harness rows:12 cols:40
        c = new context h.screen

        c.show [5 10] (()->) ['one' 'two']

        h.screen.init()
        c.draw()

        c.cells.y ▸ 8
        c.cells.y + c.cells.rows ▸ 12

  ▸ the cleared rectangle never leaves a block half drawn

        [h e] = hed 40 12 'md' ['complete']
        h.t.textSizing = true
        e.state.loadLines ['fu  fu  fu  fu  fu' '# funky1' '# funky2']

        for cx in [2 6 10 14 18]

            e.state.setMainCursor cx 0
            e.complete.complete()
            h.screen.init()
            e.draw()

            rect = h.screen.eraseRects[0]

            for [bx by scale w] in h.screen.frameBlocks

                continue if bx > rect[2]
                continue if bx + scale*w - 1 < rect[0]
                continue if by > rect[3]
                continue if by + scale   - 1 < rect[1]

                for xx in bx..bx+scale*w-1
                    for yy in by..by+scale-1
                        (valid h.screen.get_char(xx yy)) ▸ true

  ▸ the view scrolls so a tall line fits above the bottom

        [h e] = hed 20 6
        e.state.loadLines ['a' 'b' 'c' 'd' 'e' 'f' '# h1']

        e.state.setMainCursor 0 6

        e.state.s.view[1] ▸ 3

  ▸ a scaled line needs a larger horizontal offset

        [h e] = hed 20 8
        e.state.loadLines ['# a long heading line']

        e.state.setMainCursor 20 0

        e.state.s.view[0] ▸ 44

  ▸ a short file with a tall line can scroll to its last line

        [h e] = hed 20 6
        e.state.loadLines ['# h1' 'a' 'b' 'c' 'd']

        e.state.maxViewLine() ▸ 1

        e.state.scrollView 'down' 3

        e.state.s.view[1] ▸ 1

  ▸ the last line stays reachable at the end of a tall file

        [h e] = hed 20 6
        e.state.loadLines ['# h1' 'a' 'b' 'c' 'd' 'e' 'f']

        e.state.maxViewLine() ▸ 1

        e.state.setMainCursor 0 6

        e.state.s.view[1] ▸ 1

  ▸ the gutter numbers a scaled line only on its first row

        [h e] = hed 30 10 'md' ['gutter']
        e.state.loadLines ['# One' 'a' 'b']

        e.draw()

        h.row(0).startsWith('  1 ') ▸ true
        h.row(1) ▸ ''
        h.row(2) ▸ ''
        h.row(3).startsWith('  2 ') ▸ true
        h.row(4).startsWith('  3 ') ▸ true

  ▸ the buffer height is measured in display rows

        s = tstt()
        s.loadLines ['# a' 'b' '## c' 'd']

        s.totalRows() ▸ 7

        s.rowsBeforeLine 0 ▸ 0
        s.rowsBeforeLine 1 ▸ 3
        s.rowsBeforeLine 2 ▸ 4
        s.rowsBeforeLine 3 ▸ 6
        s.rowsBeforeLine 4 ▸ 7

        s.lineAtAbsoluteRow 0 ▸ 0
        s.lineAtAbsoluteRow 2 ▸ 0
        s.lineAtAbsoluteRow 3 ▸ 1
        s.lineAtAbsoluteRow 4 ▸ 2
        s.lineAtAbsoluteRow 5 ▸ 2
        s.lineAtAbsoluteRow 6 ▸ 3
        s.lineAtAbsoluteRow 99 ▸ 3

        s.setView [0 2]

        s.viewTopRow() ▸ 4
        s.rowOfLine 3 ▸ 2
        s.rowOfLine 0 ▸ -4

        s.syntax.setExt 'txt'
        s.totalRows() ▸ 4

        s.syntax.setExt 'md'
        s.totalRows() ▸ 7

  ▸ the map shows scaled lines with their real height

        [h e] = hed  cols:40 rows:10
        e.state.loadLines ['a' 'b' 'c' 'd' 'e' '# h1' 'f' 'g' 'h' 'i' 'j']

        m = new mapscr e
        m.cells.layout 30 0 12 10
        m.csz = [10 20]

        e.state.setView [0 0]
        m.calcView()

        m.topLine ▸ 0
        m.botLine ▸ 10
        m.lineOffset(5) ▸ 20
        m.lineOffset(6) ▸ 32
        (m.lineOffset(6) - m.lineOffset(5)) ▸ 12

  ▸ the map reloads lines restored by undo

        [h e] = hed  cols:40 rows:10
        e.state.loadLines ['aaa' 'bbb' 'ccc']
        e.state.setLines ['aaa' 'XXX' 'bbb' 'ccc']
        e.state.undo()

        m = new mapscr e
        m.cells.layout 30 0 12 10
        h.screen.t.pixels = [400 200]
        h.screen.t.cellsz = [10 20]

        m.reload()

        m.images.length ▸ 3
        kseg.str(m.getSegls()[1]) ▸ 'bbb'

  ▸ a reload after inserting lines clears the old map images

        [h e] = hed  cols:40 rows:10
        e.state.loadLines ['aaa' 'bbb' 'ccc']

        m = new mapscr e
        m.cells.layout 30 0 12 10
        h.screen.t.pixels = [400 200]
        h.screen.t.cellsz = [10 20]
        m.reload()

        e.state.setLines ['aaa' 'bbb' 'foo' 'bar' 'ccc']

        m.images.length ▸ 5

        h.screen.t.out = []
        e.state.loadLines ['aaa' 'bbb' 'ccc']

        out = h.screen.t.written()

        m.images.length ▸ 3
        out.includes("a=d,d=R,x=#{m.imgId},y=#{m.imgId+4}") ▸ true

        e.state.setLines ['aaa' 'bbb' 'NEW' 'NEW' 'ccc']

        m.images.length ▸ 5

  ▸ a scaled line gets a taller stripe in the map

        [h e] = hed 40 10
        e.state.loadLines ['a' 'b' '# h1' 'c' 'd']

        m = new mapscr e
        m.cells.layout 30 0 12 10
        m.csz = [10 20]
        m.images = [100 101 102 103 104]

        h.screen.t.pixels = [400 200]
        h.screen.t.cellsz = [10 20]
        h.screen.t.out = []

        e.state.setView [0 0]
        m.drawImages()

        out = h.screen.t.written()

        (out.split('i=100,').length - 1) ▸ 4

  ▸ a scaled line is also wider in the map

        [h e] = hed  cols:40 rows:10
        e.state.loadLines ['#']
        e.state.applyScales {enabled:true md:{h1:7}}

        m = new mapscr e
        m.cells.layout 30 0 12 10
        m.csz = [10 20]

        bg = m.color.bg
        data = Buffer.alloc (m.cells.cols*m.csz[0]*m.imageHeight(0)*3)

        m.imageForLine data e.state.s.lines[0] 0

        ink = false
        for y in 0...m.imageHeight(0)
            for x in 0...14
                i = (y*m.cells.cols*m.csz[0]+x)*3
                if data[i] != bg[0] or data[i+1] != bg[1] or data[i+2] != bg[2]
                    ink = true
        ink ▸ true

        m.calcView()
        (m.pixelPos([1 0])[0] - m.mapX) ▸ 14
        m.pixelPos([1 0])[1] ▸ m.mapY

        e.state.syntax.setExt 'txt'
        data = Buffer.alloc (m.cells.cols*m.csz[0]*3)
        m.imageForLine data e.state.s.lines[0] 0

        data[18] ▸ bg[0]
        data[19] ▸ bg[1]
        data[20] ▸ bg[2]

  ▸ the quicky map shows scaled lines with their real height

        [h e] = hed  cols:40 rows:10
        e.state.loadLines ['a' 'b' 'c' 'd' 'e' '# h1' 'f' 'g']

        m = new mapview h.screen e.state
        m.setSyntaxSegls 'md' e.state.s.lines
        m.setScales {enabled:true md:{h1:3}}

        m.cells.layout 30 0 12 10
        m.csz = [10 20]

        m.lineRows(5) ▸ 3
        m.lineOffsetPixels(5) ▸ 20
        m.lineOffsetPixels(6) ▸ 32
        m.lineOffsetPixels(7) ▸ 36

        m.setScales {enabled:false md:{h1:3}}

        m.lineRows(5) ▸ 1
        m.lineOffsetPixels(6) ▸ 24

  ▸ the quicky map draws a scaled line with the font map

        [h e] = hed  cols:40 rows:10
        e.state.loadLines ['# h1' 'text']

        m = new mapview h.screen e.state
        m.setSyntaxSegls 'md' e.state.s.lines
        m.setScales {enabled:true md:{h1:7}}

        m.cells.layout 30 0 12 10
        m.csz = [10 20]
        m.images = [100 101]

        h.screen.t.pixels = [400 200]
        h.screen.t.cellsz = [10 20]
        h.screen.t.out = []

        m.drawImages()

        out = h.screen.t.written()

        (out.split('i=100,').length - 1) ▸ 1
        out.includes('w=120,h=28') ▸ true

  ▸ clicking a cut line in the map keeps the row offset

        [h e] = hed 40 10

        lines = []
        for i in 0...20
            lines.push '# h1'
            for j in 0...9
                lines.push 'text'
        e.state.loadLines lines
        e.state.applyScales {enabled:true md:{h1:7}}

        m = new mapscr e
        m.cells.layout 30 0 8 10
        m.csz = [10 20]

        e.state.setView [0 0]
        m.calcView()
        m.scrollToPixel [0 (m.mapY + m.lineOffset(0) + 12)]

        e.state.s.view[1] ▸ 0
        e.state.s.scrollOffset ▸ 3

        h.screen.init()
        e.draw()

        h.screen.get_char(0 0) ▸ ' '
        h.screen.get_char(0 3) ▸ ' '
        h.screen.get_char(0 4) ▸ 't'

  ▸ the map cuts a line at its top edge

        [h e] = hed 40 10
        lines = []
        for i in 0...20
            lines.push '# h1'
        e.state.loadLines lines
        e.state.applyScales {enabled:true md:{h1:7}}

        m = new mapscr e
        m.cells.layout 30 0 12 10
        m.csz = [10 20]
        m.images = []
        for i in 0...20
            m.images.push 100+i

        e.state.setView [0 10]
        m.calcView()

        m.topRow ▸ 48
        m.topLine ▸ 6
        m.lineOffset(6) ▸ -24

        h.screen.t.pixels = [400 200]
        h.screen.t.cellsz = [10 20]
        h.screen.t.out = []

        m.drawImages()

        out = h.screen.t.written()

        (out.split('i=106,').length - 1) ▸ 1
        out.includes('y=24,w=120,h=4') ▸ true

  ▸ the map cuts a line at its bottom edge

        [h e] = hed 40 10
        lines = []
        for i in 0...20
            lines.push '# h1'
        e.state.loadLines lines
        e.state.applyScales {enabled:true md:{h1:7}}

        m = new mapscr e
        m.cells.layout 30 0 12 10
        m.csz = [10 20]
        m.images = []
        for i in 0...20
            m.images.push 100+i

        e.state.setView [0 0]
        m.calcView()
        m.lineOffset(7) ▸ 196

        h.screen.t.pixels = [400 200]
        h.screen.t.cellsz = [10 20]
        h.screen.t.out = []

        m.drawImages()

        out = h.screen.t.written()

        (out.split('i=107,').length - 1) ▸ 1
        out.includes('y=0,w=120,h=4') ▸ true

  ▸ the map follows the display rows near the end of a long file

        [h e] = hed 40 10

        lines = []
        for i in 0...200
            lines.push (i % 10 == 0) ? '# h1' : 'text'
        e.state.loadLines lines

        m = new mapscr e
        m.cells.layout 30 0 12 10
        m.csz = [10 20]

        e.state.setView [0 100]
        m.calcView()

        m.topLine ▸ 81
        m.lineOffset(100) ▸ 84
        (m.lineOffset(100) < m.cells.rows*20) ▸ true

  ▸ the scrollbar reflects the display rows

        [h e] = hed 40 10
        lines = []
        for i in 0...20
            lines.push 'text'
        lines[5] = '# h1'
        e.state.loadLines lines

        sc = new scroll h.screen e.state 'left'
        sc.layout 0 0 1 10

        csz = [10 20]

        sc.isActive() ▸ true
        sc.knobHeight(csz) ▸ 90
        sc.knobOffset(csz) ▸ 0

        e.state.setView [0 e.state.maxViewLine()]

        sc.knobOffset(csz) ▸ 110
        (sc.knobOffset(csz) + sc.knobHeight(csz)) ▸ 200

        e.state.loadLines ['a' 'b' 'c']

        sc.isActive() ▸ false
        sc.knobHeight(csz) ▸ 0
        sc.knobOffset(csz) ▸ 0

  ▸ clicking the scrollbar reaches the last display rows

        [h e] = hed 40 10
        lines = []
        for i in 0...20
            lines.push 'text'
        lines.push '# h1'
        e.state.loadLines lines

        sc = new scroll h.screen e.state 'left'
        sc.layout 0 0 1 10

        h.screen.t.cellsz = [10 20]

        e.state.setView [0 0]
        sc.scrollToPixel [0 180]

        e.state.s.view[1] ▸ e.state.maxViewLine()
        e.state.s.view[1] ▸ 13

  ▸ the scroll offset moves the top of the view inside a line

        small = cols:20 rows:3
        s = new state small 'test_scale_scroll_offset'
        s.syntax.setExt 'md'
        s.applyScales {enabled:true md:{h1:3 h2:2}}
        s.loadLines ['# a' 'b' '## c' 'd']

        s.setScrollTop 2

        s.viewTopRow() ▸ 2
        s.rowOfLine 0 ▸ -2
        s.rowOfLine 1 ▸ 1
        s.rowOfLine 2 ▸ 2

        s.setScrollTop 4

        s.s.view[1] ▸ 2
        s.s.scrollOffset ▸ 0

  ▸ the wheel scrolls a scaled line one row at a time

        small = cols:20 rows:3
        s = new state small 'test_scale_wheel_rows'
        s.syntax.setExt 'md'
        s.applyScales {enabled:true md:{h1:3 h2:2}}
        s.loadLines ['# abc' 'a' 'b' 'c']

        s.scrollView 'down'
        s.viewTopRow() ▸ 1
        s.s.view[1] ▸ 0
        s.rowOfLine 1 ▸ 2

        s.scrollView 'down'
        s.viewTopRow() ▸ 2
        s.rowOfLine 1 ▸ 1

        s.scrollView 'down'
        s.viewTopRow() ▸ 3
        s.s.view[1] ▸ 1
        s.rowOfLine 1 ▸ 0

  ▸ a cut top line is blanked while the rest moves row by row

        [h e] = hed 20 8
        e.state.loadLines ['# abc' 'a' 'b' 'c' 'd' 'e' 'f' 'g' 'h' 'i' 'j']

        e.draw()

        h.screen.get_char(0 0) ▸ '#'
        h.screen.get_char(0 3) ▸ 'a'

        h.screen.init()
        e.state.setScrollTop 1
        e.draw()

        h.screen.get_char(0 0) ▸ ' '
        h.screen.get_char(0 1) ▸ ' '
        h.screen.get_char(0 2) ▸ 'a'
        h.screen.get_char(0 3) ▸ 'b'

        h.screen.init()
        e.state.setScrollTop 2
        e.draw()

        h.screen.get_char(0 0) ▸ ' '
        h.screen.get_char(0 1) ▸ 'a'
        h.screen.get_char(0 2) ▸ 'b'

        h.screen.init()
        e.state.setScrollTop 3
        e.draw()

        h.screen.get_char(0 0) ▸ 'a'
        h.screen.get_char(0 1) ▸ 'b'

  ▸ layout keeps the row offset

        [h e] = hed 20 8
        e.state.loadLines ['# abc' 'a' 'b' 'c' 'd' 'e' 'f' 'g' 'h' 'i' 'j']

        e.state.setScrollTop 1

        e.layout 0 0 20 8

        e.state.viewTopRow() ▸ 1
        e.state.s.scrollOffset ▸ 1

  ▸ moving the cursor into view clears the scroll offset

        [h e] = hed 20 8
        e.state.loadLines ['# abc' 'a' 'b' 'c' 'd' 'e' 'f' 'g' 'h' 'i' 'j']

        e.state.setScrollTop 1
        e.state.setMainCursor 0 0

        e.state.viewTopRow() ▸ 0
        e.isCursorVisible [0 0] ▸ true

  ▸ cursor margins take rows or screen percentages

        s = tstt()
        s.marginValue 7 3 ▸ 7
        s.marginValue 0 3 ▸ 0
        s.marginValue '25%' 3 ▸ 5
        s.marginValue '50%' 3 ▸ 10
        s.marginValue null 3 ▸ 3

        saved = config.data
        config.data = cursor:{topOffset:3 bottomOffset:'25%'}

        s.viewMargin 'topOffset' 7 ▸ 3
        s.viewMargin 'bottomOffset' 7 ▸ 5

        config.data = saved

  ▸ entering a scaled line at the margin scrolls one row

        saved = config.data
        config.data = cursor:{topOffset:2 bottomOffset:10}

        [h e] = hed 20 20
        lines = []
        for i in 0...9
            lines.push 'text'
        lines.push '# h'
        for i in 0...10
            lines.push 'text'
        e.state.loadLines lines
        e.state.applyScales {enabled:true md:{h1:7}}

        e.state.setView [0 0]
        e.state.setCursors [[0 9]] main:0 adjust:'topBotDeltaGrow' mc:[0 8]

        e.state.viewTopRow() ▸ 1
        e.state.s.view[1] ▸ 1
        e.state.s.scrollOffset ▸ 0
        e.state.rowOfLine(9) ▸ 8
        e.isCursorVisible [0 9] ▸ true

        config.data = saved

  ▸ a cursor scroll uses the row offset instead of jumping a line

        saved = config.data
        config.data = cursor:{topOffset:2 bottomOffset:2}

        [h e] = hed 20 10
        e.state.loadLines ['# h' 'a' 'b' 'c' 'd' 'e' 'f' 'g' 'h' 'i' 'j']

        e.state.setView [0 0]
        e.state.setCursors [[0 7]] main:0 adjust:'topBotDeltaGrow' mc:[0 6]

        e.state.s.view[1] ▸ 0
        e.state.s.scrollOffset ▸ 1
        e.state.viewTopRow() ▸ 1

        h.screen.init()
        e.draw()

        h.screen.get_char(0 0) ▸ ' '
        h.screen.get_char(0 1) ▸ ' '
        h.screen.get_char(0 2) ▸ 'a'

        config.data = saved
