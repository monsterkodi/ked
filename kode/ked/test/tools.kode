
use ../../kxk       ◆ clip kseg post
use ../util         ◆ detector harness
use ../edit         ◆ editor specs
use ../view/base    ◆ matrix bubbles
use ../view/colmns  ◆ uniko
use ../view/menu    ◆ clippo
use ../theme        ◆ theme

mk = (history current) ->
    h = new harness cols:80 rows:20
    e = new editor h.screen 'editor' []
    e.cells.layout 0 0 80 20
    e.state.loadLines ['start']
    e.state.setMainCursor 0 0
    opt = watch:false readClipboard:(-> current)
    c = new clippo h.screen e 'clippo' opt
    c.history = history
    [h e c]

uni = (rows=16) ->
    h = new harness cols:60 rows:30
    e = new editor h.screen 'test_editor' []
    e.state.loadLines ['abc']
    e.state.setMainCursor 1 0
    u = new uniko h.screen e 'test_uniko'
    u.layout 0 0 60 rows
    u.show()
    [h e u]

mat = (cols rows) ->
    h = new harness cols:cols rows:rows
    m = new matrix h.screen 'test_matrix'
    m.layout 0 0 cols rows
    [h m]

#!clippo
▸ clippo

  ▸ entries

        [h e c] = mk ['older' 'current' 'oldest'] 'current'

        c.show()

        c.history ▸ ['current' 'older' 'oldest']
        c.choices.currentIndex() ▸ 0
        c.choices.hasFocus() ▸ true
        c.choices.state.s.selections ▸ []

        [h e c] = mk ['one\ntwo' 'old'] 'new'

        c.show()

        c.choices.state.s.lines.map((line) -> kseg.str(line)) ▸ ['' 'new' '' 'one' 'two' '' 'old']
        c.dividerRows ▸ [0 2 5]
        c.entryStart  ▸ [0 2 5]

        [h e c] = mk ['const greet = (name) => name' "use ../../kxk ▪ post"] 'current'

        c.show()

        c.choices.state.syntax.getClasses(3)[0] ▸ 'keyword'

  ▸ divider color

        [h e c] = mk ['new' 'old'] 'new'

        c.show()
        c.draw()

        y0 = c.choices.cells.y - c.choices.state.s.view[1] + c.entryStart[0]
        y1 = c.choices.cells.y - c.choices.state.s.view[1] + c.entryStart[1]
        x  = c.choices.cells.x

        h.screen.get_fg(x y0)     ▸ theme.cursor.main
        h.screen.get_fg(x+2 y0)   ▸ theme.selection.span
        h.screen.get_fg(x+2 y1)   ▸ theme.finder.frame

        h.key c 'down'
        c.draw()

        h.screen.get_fg(x y0)     ▸ theme.finder.frame
        h.screen.get_fg(x+2 y0)   ▸ theme.finder.frame
        h.screen.get_fg(x y1)     ▸ theme.cursor.main
        h.screen.get_fg(x+2 y1)   ▸ theme.selection.span

  ▸ navigation

        [h e c] = mk ['new' 'middle' 'old'] 'new'

        c.show()

        h.key c 'down'
        c.choices.currentIndex() ▸ c.entryStart[1]

        h.key c 'up'
        c.choices.currentIndex() ▸ c.entryStart[0]

        h.key c 'alt+.'
        c.choices.currentIndex() ▸ c.entryStart[1]

        h.key c 'alt+.'
        c.choices.currentIndex() ▸ c.entryStart[2]

        h.key c 'alt+,'
        c.choices.currentIndex() ▸ c.entryStart[1]

  ▸ search

        [h e c] = mk ['one'] 'one'

        c.show()

        c.choices.hasFocus() ▸ true

        h.key c 'tab'
        c.input.hasFocus() ▸ true

        h.key c 'tab'
        c.choices.hasFocus() ▸ true

        [h e c] = mk ['alpha' 'beta' 'alphabet'] 'gamma'

        c.show()

        h.key c 'tab'
        h.type c 'alpha'

        c.matchEntries ▸ [1 3]
        c.choices.currentIndex() ▸ c.entryStart[1]

        h.key c 'down'
        c.choices.currentIndex() ▸ c.entryStart[3]

        h.key c 'up'
        c.choices.currentIndex() ▸ c.entryStart[1]

  ▸ insert

        [h e c] = mk ['hello'] 'hello'

        c.show()

        h.key c 'return'

        c.hidden() ▸ true
        kseg.str(e.state.s.lines) ▸ 'hellostart'
        e.hasFocus() ▸ true

        [h e c] = mk ['hello'] 'hello'

        c.show()

        h.key c 'space'

        c.hidden() ▸ false
        kseg.str(e.state.s.lines) ▸ 'hellostart'

        [h e c] = mk ['alpha' 'beta' 'alphabet'] 'gamma'

        c.show()

        h.key c 'tab'
        h.type c 'alpha'

        h.key c 'down'
        h.key c 'return'

        c.hidden() ▸ true
        kseg.str(e.state.s.lines) ▸ 'alphabetstart'

#!detector
▸ detector

  ▸ languages

        detector.detectExt('') ▸ 'kode'
        detector.detectExt('ordinary words only') ▸ 'kode'
        detector.detectExt('{\n  "name": "kodi",\n  "ok": true\n}') ▸ 'json'
        detector.detectExt("log 'hello'") ▸ 'kode'
        detector.detectExt("use ../../kxk ▪ post\nlog 'hi'") ▸ 'kode'

        detector.detectExt('function foo() { const x = 1; return x; }') ▸ 'js'
        detector.detectExt('async function load() { await fetch(url) }') ▸ 'js'
        detector.detectExt('const greet = (name) => console.log(name)') ▸ 'js'
        detector.detectExt('function f() {\n  return 1;\n}') ▸ 'js'
        detector.detectExt('console.log("hi")') ▸ 'js'
        detector.detectExt('interface Foo { readonly name: string }') ▸ 'ts'
        detector.detectExt('const x: number = 1') ▸ 'ts'

        detector.detectExt('def greet(name):\n    print(name)') ▸ 'py'
        detector.detectExt('class Foo:\n    def __init__(self):\n        self.x = 1') ▸ 'py'
        detector.detectExt('for f in *.txt; do cat "$f"; done') ▸ 'sh'
        detector.detectExt('#!/bin/bash\necho "$HOME" | grep home') ▸ 'sh'
        detector.detectExt('#!/usr/bin/fish\nset x 1') ▸ 'fish'
        detector.detectExt('pub fn main() void { var x: u32 = 1; }') ▸ 'zig'
        detector.detectExt('const std = @import("std");') ▸ 'zig'
        detector.detectExt('#include <stdio.h>\nint main(void) { return 0; }') ▸ 'c'
        detector.detectExt('template <typename T>\nclass Foo { public: T x; };') ▸ 'cpp'
        detector.detectExt('@interface Foo : NSObject\n@end') ▸ 'mm'
        detector.detectExt('proc greet(name: string): string =\n  echo name') ▸ 'nim'
        detector.detectExt('func greet(name: String) -> String { return name }') ▸ 'swift'
        detector.detectExt('using System;\nclass Program { static void Main() { Console.WriteLine("hi"); } }') ▸ 'cs'
        detector.detectExt('local x = 1\nprint(x)') ▸ 'lua'
        detector.detectExt('function foo()\n  return 1\nend') ▸ 'lua'
        detector.detectExt('unless x then y else z') ▸ 'coffee'
        detector.detectExt('x = -> 42') ▸ 'coffee'
        detector.detectExt('<div class="foo">hello</div>') ▸ 'html'
        detector.detectExt('<!DOCTYPE html>\n<html><body><p>hi</p></body></html>') ▸ 'html'
        detector.detectExt('body { color: #fff; margin: 0; }') ▸ 'css'
        detector.detectExt('body\n  color #fff\n  margin 0') ▸ 'styl'
        detector.detectExt('$color: red;\n.foo { color: $color; }') ▸ 'scss'
        detector.detectExt('<svg viewBox="0 0 10 10"><circle r="4"/></svg>') ▸ 'svg'
        detector.detectExt('# heading\nsome **bold** text') ▸ 'md'
        detector.detectExt('name: foo\nitems:\n  - a\n  - b') ▸ 'yml'
        detector.detectExt('[user]\n\tname = Foo\n\temail = a@b.c') ▸ 'ini'
        detector.detectExt('key = value') ▸ 'ini'
        detector.detectExt('<?xml version="1.0"?><plist><dict><key>a</key></dict></plist>') ▸ 'plist'

        detector.detectExt('file     = dirent.name') ▸ 'kode'
        detector.detectExt('this["onFileChange"] = this["onFileChange"].bind(this)') ▸ 'js'
        detector.detectExt('let slash = kxk.slash') ▸ 'js'
        detector.detectExt('let kstr = kxk.kstr') ▸ 'js'
        detector.detectExt('GtkWidget* window = nullptr;') ▸ 'cpp'
        detector.detectExt('static JsonNode* node_null ()\n{\n    return json_node_new(JSON_NODE_NULL);\n}') ▸ 'cpp'
        detector.detectExt('return json_node_new(JSON_NODE_NULL);') ▸ 'cpp'
        detector.detectExt('return foo();') ▸ 'kode'
        detector.detectExt('{') ▸ 'kode'

#!uniko
▸ uniko

  ▸ filter

        [h e u] = uni()

        all = u.matrix.numItems()

        u.filter 'GREEK'

        u.matrix.numItems() > 0 ▸ true

        u.filter 'sqrt'
        u.filter ''

        u.matrix.numItems() ▸ all

  ▸ focus

        [h e u] = uni()

        u.matrix.hasFocus()
        u.matrix.selectedIndex ▸ 0

        h.key u 's' 's'

        u.input.hasFocus() ▸ true
        u.input.current() ▸ 's'

  ▸ insert

        check = (e u) ->
            kseg.str(e.state.s.lines[0]) ▸ 'a√bc'
            u.hidden() ▸ false
            u.matrix.hasFocus() ▸ true
            e.hasFocus() ▸ false

        [h e u] = uni()

        u.filter 'sqrt'
        h.key u 'return' ''

        check e u

        [h e u] = uni()

        u.filter 'sqrt'
        h.key u 'space' ' '

        check e u

        [h e u] = uni 14

        u.filter 'sqrt'

        u.onMouse
            type:   'press'
            cell:   [2 3]
            button: 'left'
            count:  1

        check e u

  ▸ copy

        [h e u] = uni()

        copied = []
        before = clip.copy
        clip.copy = (text) -> copied.push text

        u.filter 'sqrt'
        h.key u 'cmd+c' ''

        copied ▸ ['√']
        u.hidden() ▸ false

        clip.copy = before

  ▸ escape

        [h e u] = uni()

        h.key u 'esc' ''

        kseg.str(e.state.s.lines[0]) ▸ 'abc'
        u.hidden() ▸ true
        e.hasFocus() ▸ true

  ▸ scale

        [h e u] = uni()

        u.matrix.scale ▸ 2

        h.key u 'cmd+up' ''

        u.matrix.scale ▸ 3

        h.key u 'cmd+up' ''
        h.key u 'cmd+up' ''

        u.matrix.scale ▸ 3

        h.key u 'cmd+down' ''

        u.matrix.scale ▸ 2

        h.key u 'cmd+down' ''
        h.key u 'cmd+down' ''

        u.matrix.scale ▸ 1

  ▸ info bubbles                           # right-aligned in the input row, never over its text

        L = ''
        R = ''
        full = "#{L}ldots #{R}ellipsis #{R}dot #{R}0x2026#{R}"  # hex last, so it rarely moves

        info = (text) ->
            [h e u] = uni()
            u.matrix.setItems [char:'…' search:'ldots ellipsis dot']
            u.input.set text
            u.draw()
            [h u h.row(1)]

        [h u row] = info ''

        row.slice(59-full.length, 59) ▸ full
        row.length                    ▸ 59                      # ends with the input

        s     = 59-full.length
        n1bg  = h.screen.get_bg s+1  1
        n2bg  = h.screen.get_bg s+8  1
        n3bg  = h.screen.get_bg s+18 1
        hexbg = h.screen.get_bg s+23 1
        (hexbg[2] > hexbg[0]) ▸ true                            # blue
        (n1bg[0] == n1bg[1] == n1bg[2]) ▸ true                  # gray
        (n2bg[0] == n2bg[1] == n2bg[2]) ▸ true
        (n1bg[0] != n2bg[0]) ▸ true                             # stacked shades
        h.screen.get_bg(s+6 1) ▸ n1bg                           # a space after each name
        h.screen.get_fg(s+7 1) ▸ n1bg                           # a name's cap overlaps its right neighbor
        h.screen.get_bg(s+7 1) ▸ n2bg
        h.screen.get_fg(s+22 1) ▸ n3bg                          # the last name overlaps the hex
        h.screen.get_bg(s+22 1) ▸ hexbg

        row = info('x'.repeat(30))[2]
        row.slice(1 31) ▸ 'x'.repeat(30)
        row.trimEnd().endsWith "#{L}ldots #{R}ellipsis #{R}0x2026#{R}" ▸ true

        row = info('x'.repeat(40))[2]
        row.slice(1 41) ▸ 'x'.repeat(40)
        row.trimEnd().endsWith "#{L}ldots #{R}0x2026#{R}" ▸ true

        row = info('x'.repeat(45))[2]
        row.trimEnd().endsWith "#{L}0x2026#{R}" ▸ true

        row = info('x'.repeat(50))[2]
        row.trimEnd() ▸ ' ' + 'x'.repeat(50)

        [h e u] = uni()
        u.filter 'nothing matches this'
        u.draw()
        h.row(1).includes(L) ▸ false

#!bubbles
▸ bubbles

  ▸ caps                                   # half-circles between the bubbles point left or right

        L = ''
        R = ''
        a = [1 1 1]
        b = [2 2 2]
        c = [3 3 3]
        w = [9 9 9]

        draw = (pointRight padLast=false) ->
            h = new harness cols:20 rows:2
            bs = new bubbles h.screen 'test_bubbles'
            bs.setColor 'empty' c
            bs.pointRight = pointRight
            bs.padLast    = padLast
            bs.set [{text:'ab' fg:w bg:a} {text:'中' fg:w bg:b}]
            bs.layout 2 0 (padLast ? 12 : bs.width()) 1
            bs.draw()
            h

        bubbles.width([{text:'ab'} {text:'中'}]) ▸ 8   # caps, texts and a space after all but the last
        bubbles.width([])                        ▸ 0

        h = draw false
        h.row(0) ▸ "  #{L}ab #{L}中 #{R}"             # the row dump fills the wide char's second column
        h.screen.get_fg(2 0) ▸ a                # the left cap
        h.screen.get_bg(2 0) ▸ c
        h.screen.get_fg(3 0) ▸ w
        h.screen.get_bg(3 0) ▸ a
        h.screen.get_bg(5 0) ▸ a                # the space after the first text
        h.screen.get_fg(6 0) ▸ b                # the second bubble overlaps the first
        h.screen.get_bg(6 0) ▸ a
        h.screen.get_bg(7 0) ▸ b
        h.screen.get_fg(9 0) ▸ b                # the right cap
        h.screen.get_bg(9 0) ▸ c

        h = draw true
        h.row(0) ▸ "  #{L}ab #{R}中 #{R}"
        h.screen.get_fg(6 0) ▸ a                # the first bubble overlaps the second
        h.screen.get_bg(6 0) ▸ b

        h = draw false true                     # padLast fills the view's width with the last bubble
        h.row(0) ▸ "  #{L}ab #{L}中     #{R}"
        h.screen.get_bg(12 0) ▸ b
        h.screen.get_fg(13 0) ▸ b
        h.screen.get_bg(13 0) ▸ c

        h = new harness cols:20 rows:2
        bs = new bubbles h.screen 'test_bubbles'
        bs.layout 0 0 10 1
        bs.draw()
        h.row(0) ▸ ''

#!matrix
▸ matrix

  ▸ selection

        [h m] = mat 10 5
        m.setItems ['a' 'b' 'c' 'd' 'e' 'f' 'g' 'h' 'i' 'j' 'k' 'l']

        m.selectedText() ▸ 'a'

        m.moveSelection 'right' ▸ true
        m.selectedText() ▸ 'b'

        cols = m.columns()

        m.setItems ['a' 'b' 'c' 'd' 'e' 'f' 'g' 'h' 'i' 'j' 'k' 'l']
        m.selectedIndex ▸ 0

        m.moveSelection 'down' ▸ true
        m.selectedIndex ▸ cols

        m.setItems ['a' 'b' 'c']

        m.moveSelection 'left' ▸ false
        m.selectedIndex ▸ 0

        m.moveSelection 'up' ▸ false
        m.selectedIndex ▸ 0

  ▸ focus

        [h m] = mat 10 5

        not m.hasFocus() ▸ true

        h.focus m

        m.hasFocus() ▸ true

        post.emit 'focus' 'somewhere_else'

        not m.hasFocus() ▸ true

  ▸ scale

        [h m] = mat 20 20

        m.scale ▸ 2
        m.viewportRows() ▸ 10

        m.incScale 1

        m.scale ▸ 3
        m.viewportRows() ▸ 6
        m.cellAtPos(3 4) ▸ [0 1]

        m.incScale 1

        m.scale ▸ 3
        m.viewportRows() ▸ 6
        m.cellAtPos(3 3) ▸ [0 1]

        m.incScale -1
        m.incScale -1

        m.scale ▸ 1
        m.viewportRows() ▸ 20

        for s in [2 3]

            [h m] = mat 24 20

            while m.scale < s
                m.incScale 1

            m.setItems ['a']
            m.draw()

            x = s

            h.screen.get_char(x-s 0) ▸ ''
            h.screen.get_char(x   0) ▸ 'a'
            h.screen.get_char(x+s 0) ▸ ''
