            tree.title ▸ '  bg'
            tree.rect.abs ▸ {x:2 y:2 w:20 h:10}
    
            container = sds.get(tree 'children.0')
            container.title ▸ '    box'
    
            text = sds.get(tree 'children.0.children.0')
            text.title ▸ '      text'
            text.rect.abs ▸ {x:6 y:5 w:3 h:1}
    
            layout.typeOf(tree) ▸ 'bg'
            layout.argOf(tree) ▸ '#000'
            layout.typeOf(container) ▸ null
            layout.typeOf(text) ▸ 'text'
            layout.argOf(text) ▸ 'hi'
            layout.typeOf({text:'md' erase:'bg'}) ▸ 'text'

            tree = { bg:'#000' children:[{ x:2 y:1 w:10 h:5 children:[{ text:'hi' x:1 y:1 r:1 b:1 }] }] }
    
            layout.titlify {cols:30 rows:20} tree
    
            sds.get(tree 'children.0.children.0.rect.abs') ▸ {x:3 y:2 w:8 h:3}

            page = { children:[{ x:1 y:1 w:4 h:2 } { x:6 y:1 w:4 h:2 children:[{ x:0 y:0 w:1 h:1 }] }] }

            layout.titlify {cols:30 rows:20} page

            page.title? ▸ false
            sds.get(page 'children.0.title') ▸ '  rect'
            sds.get(page 'children.1.title') ▸ '  box'
            sds.get(page 'children.1.children.0.title') ▸ '    rect'

    ▸ sourceOf

            tree = lined { bg:'#333' children:[{ text:'hi' x:1 y:1 w:3 h:1 }] }

            layout.titlify {cols:10 rows:5} tree
            layout.sueify {cols:10 rows:5} tree

            noon.parse(layout.sourceOf(tree)) ▸ {bg:'#333' children:[{text:'md' lines:['hi'] x:1 y:1 w:3 h:1}]}

            tree = { bg:'#333' }

            layout.addTextNode {cols:10 rows:5} tree [2 1] 'a'

            noon.parse(layout.sourceOf(tree)) ▸ {bg:'#333' children:[{text:'md' lines:['a'] x:2 y:1 w:2 h:1}]}

            tree = { children:[{ text:'kode' lines:['a' '    b' '' 'c'] x:0 y:0 w:9 h:4 }] }
            layout.sueify {cols:10 rows:5} tree
            tree.children[0].state.syntax.ext ▸ 'kode'
            noon.parse(layout.sourceOf(tree)).children[0] ▸ {text:'kode' lines:['a' '    b' '' 'c'] x:0 y:0 w:9 h:4}

  ▸ pageOf

            layout.pageOf({bg:'#333' children:[{text:'a'}]}) ▸ {children:[{bg:'#333' children:[{text:'a'}]}]}
            layout.pageOf({x:1}) ▸ {children:[{x:1}]}
            page = {children:[{text:'a'}]}
            layout.pageOf(page) == page ▸ true
            layout.pageOf({}) ▸ {}

