use ../../kxk    ◆ sds noon
use ../edit/tool ◆ sue
use ../popo      ◆ layout fill
use ../edit      ◆ editor
use ../util      ◆ harness

absrect = cells tree -> layout.absolutize cells tree; tree.rect
rgns    = cells tree path -> sds.get layout.regionize(cells tree) path
dmp     = cells tree -> layout.dumpRegions layout.regionize(cells tree)
desue   = cells tree -> sue.desue layout.sueify(cells tree)
areas   = data type -> data.sue.filter((area) -> area.value[0] == type)

h = e = null

sheet = name features=[] ->
    h = new harness cols:16 rows:4
    e = new editor h.screen name features
    e.layout 0 0 16 4
    e.state.loadLines ['                ' '                ' '                ' '                ']

rt = path -> sds.get e.state.rectree path

loadSheet = tree cursor ->
    e.state.setSheetTree tree 16 4
    e.state.renderSheet tree {cols:16 rows:4} cursor history:false silent:true
    e.state.clearHistory()

showSue = data ->
    e.state.loadLines data.text.split('\n')
    e.state.loadSue data.sue
    e.draw()

▸ popo
  
  ▸ layout

    ▸ absolutize
    
      ▸ percentages
    
                absrect {cols:100 rows:50} { x:'20%' y:'10%' r:'20%' b:'10%' } ▸ {abs:{x:20 y:5 w:60 h:40} rel:{x:20 y:5 w:60 h:40}}
                absrect {cols:10 rows:5}   { x:'20%' y:'20%' r:'20%' b:'20%' } ▸ {abs:{x:2 y:1 w:6 h:3} rel:{x:2 y:1 w:6 h:3}}
                absrect {cols:10 rows:5}   { x:'20%' y:'20%' w:'60%' h:'60%' } ▸ {abs:{x:2 y:1 w:6 h:3} rel:{x:2 y:1 w:6 h:3}}
            
                tree = { x:10 y:10 w:'100%' h:'100%' children:[{x:'50%' y:'50%' w:'50%' h:'25%'}]}
                absrect {cols:100 rows:100} tree ▸ {abs:{x:10 y:10 w:90 h:90} rel:{x:10 y:10 w:90 h:90}}
                sds.get(tree 'children.0.rect') ▸ {abs:{x:55 y:55 w:45 h:22} rel:{x:45 y:45 w:45 h:22}}
            
