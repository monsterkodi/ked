                layout.moveNode cells tree tree.children[0] 'left'  ; tree.children[0].x ▸ 0
                layout.moveNode cells tree tree.children[0] 'left'  ; tree.children[0].x ▸ 0
                layout.moveNode cells tree tree.children[0] 'right' ; tree.children[0].x ▸ 1

