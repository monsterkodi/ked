                node = tree.children[0]
                layout.resizeNode cells tree node 'more cols' ; node.w ▸ 9
                layout.resizeNode cells tree node 'less cols' ; node.w ▸ 6
                tree = absol cells { children:[{ text:'ab' x:0 y:0 w:7 h:3 scale:3 }] }
                node = tree.children[0]
