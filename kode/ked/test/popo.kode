use ../../kxk    ◆ sds noon clip
use ../../kxk    ▪ kseg post
use ../edit/tool ◆ sue
use ../popo      ◆ layout fill projector
use ../edit      ◆ editor mode
use ../edit/mode ◆ brckts novim
use ../view/editor ◆ fileeditor
use ../view/colmns ◆ sheeditor
use ../util      ◆ harness dumpstate config

absol   = cells tree -> layout.absolutize cells tree
absrect = cells tree -> absol(cells tree).rect
rgns    = cells tree path -> sds.get layout.regionize(cells tree) path
dmp     = cells tree -> layout.dumpRegions layout.regionize(cells lined(tree))
desue   = cells tree -> sue.desue layout.sueify(cells lined(tree))
areas   = data type -> data.sue.filter((area) -> area.value[0] == type)
textnode = cells node -> projector.attach(layout.regionize(cells {children:[lined(node)]})).children[0]
strs    = node -> node.state.s.lines.map (l) -> kseg.str l
glyphs  = node -> projector.glyphs(node).map (g) -> g[0...3]
content = node -> projector.textOf node
txt     = path -> content rt(path)

lined = node ->
    ⮐ node if not node? or typeof(node) != 'object'
    out = {}
    for k,v of node
        if k == 'children'
            out.children = v.map lined
        else if k == 'text' and v is str and not node.lines?
            out.text  = 'md'
            out.lines = v.split '\n'
        else
            out[k] = v
    out

h = e = null

sheet = name features=[] rows=4 cls=editor ->
    global.ked_session ?= get:(-> null) set:(->)
    h = new harness cols:32 rows:rows
    e = new cls h.screen name features
    e.layout 0 0 16 rows
    e.layout 0 0 32-e.cells.cols rows
    e.state.loadLines Array(rows).fill(' '.repeat(16))

rt  = path -> sds.get e.state.rectree path
mc  = -> e.state.mainCursor()
key = combo -> h.key e combo

click = x y -> e.onMouse type:'press' cell:[x+e.cells.x y+e.cells.y] button:'left' count:1
altclick = x y -> e.onMouse type:'press' cell:[x+e.cells.x y+e.cells.y] button:'left' count:1 alt:true
type = text -> h.type e text
nvon = -> mode.isActive e.state 'novim'

novimOn = ->
    mode.modes.novim = novim
    e.state.allowedModes.novim = true
    e.state.startMode 'novim'

novimTree = -> {children:[{ text:'foo bar\nbaz' x:1 y:1 w:8 h:3 } { text:'qux' x:1 y:5 w:4 h:1 }]}

loadSheet = tree cursor=[0 0] ->
    e.state.setSheetTree lined(tree)
    e.state.renderSheet e.state.rectree e.state.sheetSize() cursor history:false silent:true
    e.state.clearHistory()

bands = -> {children:[{ text:'abcdef' x:2 y:1 w:8 h:4 scale:2 } { text:'xy' x:2 y:6 w:4 h:1 }]}

showSue = data ->
    e.state.loadLines data.text.split('\n')
    e.state.loadSue data.sue
    e.draw()

