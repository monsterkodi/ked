    ▸ titlify

            tree = { bg:'#000' x:2 y:2 w:20 h:10 children:[{ x:3 y:2 w:10 h:5 children:[{ text:'hi' x:1 y:1 w:3 h:1 }] }] }
    
            layout.titlify {cols:30 rows:20} tree
    
            tree.title ▸ '  bg'
            tree.rect.abs ▸ {x:2 y:2 w:20 h:10}
    
            container = sds.get(tree 'children.0')
            container.title? ▸ false
    
            text = sds.get(tree 'children.0.children.0')
            text.title ▸ '      text'
            text.rect.abs ▸ {x:6 y:5 w:3 h:1}
    
            layout.typeOf(tree) ▸ 'bg'
            layout.argOf(tree) ▸ '#000'
            layout.typeOf(container) ▸ null
            layout.typeOf(text) ▸ 'text'
            layout.argOf(text) ▸ 'hi'
    
            tree = { bg:'#000' children:[{ x:2 y:1 w:10 h:5 children:[{ text:'hi' x:1 y:1 r:1 b:1 }] }] }
    
            layout.titlify {cols:30 rows:20} tree
    
            sds.get(tree 'children.0.children.0.rect.abs') ▸ {x:3 y:2 w:8 h:3}

    ▸ sourceOf

            tree = { bg:'#333' children:[{ text:'hi' x:1 y:1 w:3 h:1 }] }
    
            layout.titlify {cols:10 rows:5} tree
            layout.regionize {cols:10 rows:5} tree
    
            noon.parse(layout.sourceOf(tree)) ▸ {bg:'#333' children:[{text:'hi' x:1 y:1 w:3 h:1}]}
    
            tree = { bg:'#333' }
    
            layout.insertTextAt {cols:10 rows:5} tree [2 1] 'a'
    
            noon.parse(layout.sourceOf(tree)) ▸ {bg:'#333' children:[{text:'a' x:2 y:1 w:2 h:1}]}

