use ../../kxk    ◆ sds noon
use ../../kxk    ▪ kseg post
use ../edit/tool ◆ sue
use ../popo      ◆ layout fill
use ../edit      ◆ editor
use ../view/editor ◆ fileeditor
use ../util      ◆ harness

absol   = cells tree -> layout.absolutize cells tree
absrect = cells tree -> absol(cells tree).rect
rgns    = cells tree path -> sds.get layout.regionize(cells tree) path
dmp     = cells tree -> layout.dumpRegions layout.regionize(cells tree)
desue   = cells tree -> sue.desue layout.sueify(cells tree)
areas   = data type -> data.sue.filter((area) -> area.value[0] == type)

h = e = null

sheet = name features=[] rows=4 cls=editor ->
    global.ked_session ?= get:(-> null) set:(->)
    h = new harness cols:16 rows:rows
    e = new cls h.screen name features
    e.layout 0 0 16 rows
    e.state.loadLines Array(rows).fill(' '.repeat(16))

rt  = path -> sds.get e.state.rectree path
mc  = -> e.state.mainCursor()
key = combo -> h.key e combo

click = x y -> e.onMouse type:'press' cell:[x+e.cells.x y+e.cells.y] button:'left' count:1

loadSheet = tree cursor=[0 0] ->
    e.state.setSheetTree tree h.cols h.rows
    e.state.renderSheet tree {cols:h.cols rows:h.rows} cursor history:false silent:true
    e.state.clearHistory()

bands = -> {children:[{ text:'abcdef' x:2 y:1 w:8 h:4 scale:2 } { text:'xy' x:2 y:6 w:4 h:1 }]}

showSue = data ->
    e.state.loadLines data.text.split('\n')
    e.state.loadSue data.sue
    e.draw()

▸ popo
  
  ▸ layout

    ▸ absolutize
    
      ▸ percentages
    
                absrect {cols:100 rows:50} { x:'20%' y:'10%' r:'20%' b:'10%' } ▸ {abs:{x:20 y:5 w:60 h:40} rel:{x:20 y:5 w:60 h:40}}
                absrect {cols:10 rows:5}   { x:'20%' y:'20%' r:'20%' b:'20%' } ▸ {abs:{x:2 y:1 w:6 h:3} rel:{x:2 y:1 w:6 h:3}}
                absrect {cols:10 rows:5}   { x:'20%' y:'20%' w:'60%' h:'60%' } ▸ {abs:{x:2 y:1 w:6 h:3} rel:{x:2 y:1 w:6 h:3}}
            
                tree = { x:10 y:10 w:'100%' h:'100%' children:[{x:'50%' y:'50%' w:'50%' h:'25%'}]}
                absrect {cols:100 rows:100} tree ▸ {abs:{x:10 y:10 w:90 h:90} rel:{x:10 y:10 w:90 h:90}}
                sds.get(tree 'children.0.rect') ▸ {abs:{x:55 y:55 w:45 h:22} rel:{x:45 y:45 w:45 h:22}}
            
      ▸ cells
    
                absrect {cols:100 rows:50} { x:3 y:4 w:20 h:10 }         ▸ {abs:{x:3 y:4 w:20 h:10} rel:{x:3 y:4 w:20 h:10}}
                absrect {cols:100 rows:50} { x:3 y:4 r:7 b:6 }           ▸ {abs:{x:3 y:4 w:90 h:40} rel:{x:3 y:4 w:90 h:40}}
                absrect {cols:100 rows:50} { x:'3' y:'4' w:'20' h:'10' } ▸ {abs:{x:3 y:4 w:20 h:10} rel:{x:3 y:4 w:20 h:10}}
                absrect {cols:100 rows:50} { x:3 y:'10%' w:20 h:'20%' }  ▸ {abs:{x:3 y:5 w:20 h:10} rel:{x:3 y:5 w:20 h:10}}
            
      ▸ nesting
    
                tree = absol {cols:20 rows:20} { x:1 y:1 w:10 h:10 children:[{x:1 y:1 w:'50%' h:'50%'} {x:0 y:'60%' w:4 h:2}]}
                tree.rect ▸ {abs:{x:1 y:1 w:10 h:10} rel:{x:1 y:1 w:10 h:10}}
                sds.get(tree 'children.0.rect') ▸ {abs:{x:2 y:2 w:5 h:5} rel:{x:1 y:1 w:5 h:5}}
                sds.get(tree 'children.1.rect') ▸ {abs:{x:1 y:7 w:4 h:2} rel:{x:0 y:6 w:4 h:2}}
                
                tree = absol {cols:100 rows:100} { x:0 y:0 w:'50%' h:'50%' children:[{x:'50%' y:'50%' w:'50%' h:'50%' children:[{x:0 y:0 w:'50%' h:'50%'}]}]}
                tree.rect ▸ {abs:{x:0 y:0 w:50 h:50} rel:{x:0 y:0 w:50 h:50}}
                sds.get(tree 'children.0.rect') ▸ {abs:{x:25 y:25 w:25 h:25} rel:{x:25 y:25 w:25 h:25}}
                sds.get(tree 'children.0.children.0.rect') ▸ {abs:{x:25 y:25 w:12 h:12} rel:{x:0 y:0 w:12 h:12}}
                
                tree = absol {cols:10 rows:10} { x:8 y:0 w:'100%' h:10 children:[{x:'50%' y:0 w:'50%' h:2}]}
                tree.rect ▸ {abs:{x:8 y:0 w:2 h:10} rel:{x:8 y:0 w:2 h:10}}
                sds.get(tree 'children.0.rect') ▸ {abs:{x:9 y:0 w:1 h:2} rel:{x:1 y:0 w:1 h:2}}
                
                tree = absol {cols:20 rows:20} { x:1 y:1 w:18 h:8 children:[{x:0 y:0 w:'50%' h:3 children:[{x:1 y:1 w:'50%' h:2}]} {x:'50%' y:0 w:'50%' h:3}]}
                tree.rect ▸ {abs:{x:1 y:1 w:18 h:8} rel:{x:1 y:1 w:18 h:8}}
                sds.get(tree 'children.0.rect') ▸ {abs:{x:1 y:1 w:9 h:3} rel:{x:0 y:0 w:9 h:3}}
                sds.get(tree 'children.0.children.0.rect') ▸ {abs:{x:2 y:2 w:4 h:2} rel:{x:1 y:1 w:4 h:2}}
                sds.get(tree 'children.1.rect') ▸ {abs:{x:10 y:1 w:9 h:3} rel:{x:9 y:0 w:9 h:3}}
            
      ▸ no space
    
                tree = absol {cols:10 rows:5} { x:0 y:0 w:10 h:5 children:[{x:20 y:20 w:5 h:5}]}
                tree.rect ▸ {abs:{x:0 y:0 w:10 h:5} rel:{x:0 y:0 w:10 h:5}}
