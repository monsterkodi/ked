            """
        
    ▸ blocks
        
            tree = { w:10 h:2 children:[{ text:'abcdefghij' x:0 y:0 w:10 h:2 } { blocks:true x:3 y:0 w:2 h:2 }] }
            rgns {rows:2 cols:10} tree 'children.0.regions' ▸ [[0 0 3] [5 0 10] [0 1 3] [5 1 10]]
            
            tree = { blocks:true x:0 y:0 w:8 h:2 children:[{ text:'ab' x:0 y:0 w:8 h:2 }] }
            rgns {rows:2 cols:8} tree 'children.0.regions' ▸ [[0 0 8] [0 1 8]]
            
            tree = { text:'ab' x:0 y:0 w:8 h:1 flows:false children:[{ blocks:true x:2 y:0 w:2 h:1 }] }
            rgns {rows:1 cols:8} tree 'regions' ▸ [[0 0 8]]
            
            tree = { pattern:'x' x:0 y:0 w:6 h:1 children:[{ blocks:true x:2 y:0 w:2 h:1 }] }
            rgns {rows:1 cols:6} tree 'regions' ▸ [[0 0 2] [4 0 6]]
            
  ▸ dump
    
        dmp {rows:2 cols:10} { text:'abcdefghij' x:0 y:0 w:10 h:2 children:[{ blocks:true x:3 y:0 w:2 h:2 }] } ▸ 'abc  defgh\nij        '
        dmp {rows:2 cols:6}  { pattern:'abc' x:0 y:0 w:6 h:2 children:[{ erase:'char' x:1 y:0 w:2 h:1 }] }   ▸ 'a  abc\nabcabc'
        dmp {rows:2 cols:8}  { text:'abc' scale:2 x:0 y:0 w:8 h:2 }                                          ▸ 'a b c   \n        '
        dmp {rows:1 cols:4}  { w:4 h:1 children:[{ pattern:'#.' x:0 y:0 w:4 h:1 } { text:'xy' x:1 y:0 w:2 h:1 }] } ▸ '#xy.'
        
  ▸ sueify
    
        data = desue {cols:8 rows:3} { bg:'#00f' children:[{ text:'hi' x:1 y:1 w:3 h:1 fg:'#ff0' }] }
        
        data.text ▸ '        \n hi     \n        '
        data.sue.length ▸ 4
        areas(data sue.FG_COLOR).length ▸ 1
        areas(data sue.FG_COLOR)[0].value ▸ [31 3 1 '#ff0']

        data = desue {cols:6 rows:5} { children:[{ text:'A' x:1 y:1 w:3 h:3 scale:3 fg:'#ff0' }] }
        
        data.text ▸ '      \n      \n      \n A  \n      '
        
        runs = areas data sue.SCALE
        
        runs.length ▸ 1
        runs[0].x ▸ 1
        runs[0].y ▸ 3
        runs[0].value[3] ▸ 3
        
        data = desue {cols:6 rows:3} { children:[{ text:'A' x:1 y:1 w:3 h:1 scale:3 }] }

        data.text ▸ '      \n      \n      '
        areas(data sue.SCALE).length ▸ 0

        data = desue {cols:12 rows:2} { children:[{ text:'ab cd' x:0 y:0 w:12 h:2 scale:2 }] }

        data.text ▸ '            \nab cd '
        runs = areas data sue.SCALE
        runs.length ▸ 1
        runs[0].x ▸ 0
        areas(data sue.CLOSE)[0].x ▸ 6

        data = desue {cols:6 rows:4} { children:[{ text:'abcdef' x:0 y:0 w:6 h:4 scale:2 }] }

        data.text ▸ '      \nabc\n      \ndef'
        areas(data sue.SCALE).map((a) -> [a.x a.y]) ▸ [[0 1] [0 3]]

        data = desue {cols:8 rows:4} { children:[{ text:'ab' x:0 y:0 w:8 h:4 scale:2 }] }

        data.text ▸ '        \nab  \n        \n    '
        areas(data sue.SCALE).map((a) -> [a.x a.y]) ▸ [[0 1] [0 3]]
        areas(data sue.CLOSE).map((a) -> [a.x a.y]) ▸ [[4 1] [4 3]]

        data = desue {cols:8 rows:2} { children:[{ text:'ab' x:0 y:0 w:4 h:2 scale:2 } { text:'cd' x:4 y:0 w:4 h:2 scale:2 }] }

        data.text ▸ '        \nabcd'
        areas(data sue.SCALE).map((a) -> a.x) ▸ [0 2]
        areas(data sue.CLOSE).map((a) -> a.x) ▸ [2 4]

  ▸ heights

        absrect({cols:10 rows:10} { text:'a' h:2 scale:3 }).abs.h ▸ 3
        absrect({cols:10 rows:10} { text:'a' h:7 scale:3 }).abs.h ▸ 6
        absrect({cols:10 rows:10} { text:'a' y:1 b:1 scale:3 }).abs.h ▸ 6
        absrect({cols:10 rows:2}  { text:'a' h:3 scale:3 }).abs.h ▸ 0
        absrect({cols:10 rows:10} { pattern:'a' h:2 scale:3 }).abs.h ▸ 2

  ▸ blocks are never cut

        dmp {cols:6 rows:2} { children:[{ text:'ab' x:0 y:0 w:6 h:2 scale:2 } { text:'z' x:1 y:1 w:1 h:1 }] } ▸ '  b   \n z    '
        
  ▸ editor
        
        sheet 'popo_test_editor' ['susan']
        
        showSue desue({cols:16 rows:4} { bg:'#00f' children:[{ text:'hi' x:1 y:1 w:2 h:1 fg:'#ff0' }] })
        
        h.at(1 1) ▸ 'h'
        h.at(2 1) ▸ 'i'
        h.screen.get_fg(1 1) ▸ [255 255 0]
        h.screen.get_bg(5 0) ▸ [0 0 255]

        h.t.textSizing = true
        h.screen.init()
        
        showSue desue({cols:16 rows:6} { children:[{ text:'A' x:1 y:1 w:3 h:3 scale:3 fg:'#ff0' }] })
        
        h.at(1 1).includes(']66;s=3') ▸ true
        h.screen.blockAt(1 1) ▸ [1 1 3 1 3]

  ▸ sheet typing

        sheet 'popo_sheet_typing'

        e.state.rectree = {bg:'#000'}
        e.state.setCursors [[2 1]]
        e.state.insert 'a'
        e.draw()

        e.state.mainCursor() ▸ [3 1]
        h.at(2 1) ▸ 'a'
        rt('children.0.text') ▸ 'a'
        rt('children.0.rect.abs') ▸ {x:2 y:1 w:2 h:1}

        e.state.insert 'b'
        e.draw()

        e.state.mainCursor() ▸ [4 1]
        h.at(3 1) ▸ 'b'
        rt('children.0.text') ▸ 'ab'
        rt('children.0.w') ▸ 3

        e.state.rectree = {x:2 y:1 w:6 h:2}
        e.state.setCursors [[10 3]]
        e.state.insert 'c'

        rt('children.0.text') ▸ 'c'
        rt('children.0.x') ▸ 8
        rt('children.0.y') ▸ 2

  ▸ sheet move keys

        sheet 'popo_sheet_move'
        e.grabFocus()

        e.state.rectree = {children:[{ text:'a' x:2 y:1 w:3 h:2 }]}
        e.state.rectreeCols = 16
        e.state.rectreeRows = 4
        e.state.setCursors [[3 1]]

        h.key e 'shift+alt+l' ; rt('children.0.rect.abs') ▸ {x:3 y:1 w:3 h:2}
        e.state.mainCursor() ▸ [4 1]
        h.key e 'shift+alt+j' ; rt('children.0.rect.abs') ▸ {x:3 y:2 w:3 h:2}
        h.key e 'shift+alt+k' ; rt('children.0.rect.abs') ▸ {x:3 y:1 w:3 h:2}
        h.key e 'shift+alt+h' ; rt('children.0.rect.abs') ▸ {x:2 y:1 w:3 h:2}

  ▸ sheet undo

        sheet 'popo_sheet_undo'
        e.grabFocus()
        loadSheet {children:[{ text:'a' x:2 y:1 w:3 h:2 }]} [3 1]

        e.state.moveSheetNode 'right'
        rt('children.0.x') ▸ 3
        e.draw()
        h.at(3 1) ▸ 'a'

        e.state.undo()
        rt('children.0.x') ▸ 2
        e.state.mainCursor() ▸ [3 1]
        e.draw()
        h.at(2 1) ▸ 'a'

        e.state.redo()
        rt('children.0.x') ▸ 3

  ▸ sheet text undo

        sheet 'popo_sheet_text_undo'
        e.grabFocus()
        loadSheet {bg:'#000'} [2 1]
        e.state.setCursors [[2 1]]

        e.state.insert 'a' ; rt('children.0.text') ▸ 'a'
        e.state.undo()     ; rt('children')? ▸ false
        e.state.redo()     ; rt('children.0.text') ▸ 'a'

  ▸ resize is not an undo step

        sheet 'popo_sheet_resize_history'
        e.grabFocus()
        
        tree = {children:[{ text:'a' x:2 y:1 w:3 h:2 }]}
        loadSheet tree [3 1]

        before = e.state.h.length
        e.state.renderSheet tree {cols:10 rows:4} [3 1] history:false silent:true
        e.state.h.length ▸ before

  ▸ sheet render size

        sheet 'popo_sheet_render_size'

        e.state.rectree = {children:[{pattern:'x' x:'50%' y:0 w:'50%' h:2}]}
        e.state.rectreeCols = 10
        e.state.rectreeRows = 4
        e.state.setCursors [[6 0]]
        e.state.insert 'a'

        rt('children.0.rect.abs') ▸ {x:5 y:0 w:5 h:2}
        rt('children.0.children.0.rect.abs') ▸ {x:6 y:0 w:2 h:1}

  ▸ sheet cells and cursors

        sheet 'popo_sheet_cells'
        e.grabFocus()

        loadSheet {children:[{ text:'AB' x:1 y:0 w:6 h:2 scale:2 } { text:'z' x:9 y:1 w:2 h:1 }]} [0 0]

        kseg.str(e.state.s.lines[1]) ▸ ' AB   z      '

        e.state.sheetCellForPos([6 1]) ▸ [9 1]
        e.state.sheetCellForPos([2 1]) ▸ [3 1]
        e.state.sheetCellForPos([8 1]) ▸ [11 1]
        e.state.sheetPosForCell([9 1]) ▸ [6 1]
        e.state.sheetPosForCell([4 1]) ▸ [2 1]
        e.state.sheetPosForCell([11 1]) ▸ [8 1]

        e.state.sheetPosForCell([3 0]) ▸ [2 1]
        e.state.sheetPosForCell([8 0]) ▸ [8 0]

        e.state.setCursors [[7 1]]
        e.state.insert 'y'

        rt('children.1.text') ▸ 'zy'
        rt('children')?.length ▸ 2
        e.state.mainCursor() ▸ [8 1]

        e.state.setCursors [[3 1]]
        e.state.insert 'C'

        rt('children.0.text') ▸ 'ABC'
        e.state.mainCursor() ▸ [4 1]

        e.state.setCursors [[1 1]]
        h.key e 'shift+alt+l'

        rt('children.0.x') ▸ 2
        e.state.mainCursor() ▸ [2 1]

  ▸ sheet scale keys

        sheet 'popo_sheet_scale_keys' ['susan']
        e.grabFocus()

        loadSheet {children:[{ text:'abc' x:1 y:0 w:12 h:1 }]} [0 0]

        e.state.setCursors [[2 0]]

        h.key e 'shift+alt+='

        rt('children.0.scale') ▸ 2
        rt('children.0.h') ▸ 2
        rt('children.0.w') ▸ 24
        e.state.mainCursor() ▸ [2 1]
        e.state.s.sue.filter((a) -> a.value[0] == sue.LINE_SCALE).length ▸ 0
        e.state.s.sue.filter((a) -> a.value[0] == sue.SCALE).length ▸ 1

        h.key e 'shift+alt+='

        rt('children.0.scale') ▸ 3
        rt('children.0.h') ▸ 3
        rt('children.0.w') ▸ 36
        e.state.mainCursor() ▸ [2 2]

        h.key e 'shift+alt+-'

        rt('children.0.scale') ▸ 2
        rt('children.0.h') ▸ 2
        rt('children.0.w') ▸ 24

        h.key e 'shift+alt+0'

        rt('children.0.scale')? ▸ false
        rt('children.0.h') ▸ 1
        rt('children.0.w') ▸ 12
        e.state.mainCursor() ▸ [2 0]

        e.state.undo()
        rt('children.0.scale') ▸ 2
        rt('children.0.w') ▸ 24

        loadSheet {children:[{ text:'abcdef' x:1 y:0 w:3 h:2 } { text:'p' x:'50%' w:'25%' y:2 h:1 }]}

        e.state.setCursors [[1 0]] ; key 'shift+alt+=' ; rt('children.0.w') ▸ 6 ; rt('children.0.h') ▸ 4
        key 'shift+alt+-' ; rt('children.0.w') ▸ 3 ; rt('children.0.h') ▸ 2

        e.state.setCursors [[9 2]] ; key 'shift+alt+=' ; rt('children.1.w') ▸ '25%' ; rt('children.1.scale') ▸ 2

        before = e.state.s.sue
        h.key e 'shift+alt+b'
        e.state.s.sue ▸ before

  ▸ sheet cursor

        sheet 'popo_sheet_updown' [] 8
        e.grabFocus()
        loadSheet bands()

        kseg.str(e.state.s.lines[2]).trimEnd() ▸ '  abcd'
        kseg.str(e.state.s.lines[4]).trimEnd() ▸ '  ef'

        e.state.setCursors [[2 0]]
        key 'down' ; mc() ▸ [2 2]
        key 'down' ; mc() ▸ [2 4]
        key 'down' ; mc() ▸ [2 5]
        key 'down' ; mc() ▸ [2 6]
        key 'up'   ; mc() ▸ [2 5]
        key 'up'   ; mc() ▸ [2 4]
        key 'up'   ; mc() ▸ [2 2]
        key 'up'   ; mc() ▸ [2 0]

        e.state.setCursors [[3 0]] ; key 'down' ; mc() ▸ [2 2]

        e.state.setCursors [[7 3]] ; key 'down' ; mc() ▸ [7 5]
        e.state.setCursors [[7 3]] ; key 'up'   ; mc() ▸ [4 2]
        e.state.setCursors [[5 4]] ; key 'up'   ; mc() ▸ [5 2]
        e.state.setCursors [[4 4]] ; key 'right' ; e.state.sheetCellForPos(mc()) ▸ [8 4]

        e.state.setCursors [[2 0]] ; e.state.moveCursors 'down' count:2 ; mc() ▸ [2 4]

        e.state.setCursors [[0 2]]
        key 'right' ; mc() ▸ [1 2]
        key 'right' ; mc() ▸ [2 2]
        key 'right' ; mc() ▸ [3 2]
        key 'left'  ; mc() ▸ [2 2]
        key 'left'  ; mc() ▸ [1 2]
        key 'left'  ; mc() ▸ [0 2]
        key 'left'  ; mc() ▸ [0 2]

        e.state.setCursors [[5 2]] ; key 'right' ; mc() ▸ [6 2]
        key 'left' ; mc() ▸ [5 2]

        e.state.setCursors [[1 3]] ; key 'right' ; mc() ▸ [2 4]
        key 'left' ; mc() ▸ [1 4]

        e.state.setCursors [[15 0]] ; key 'right' ; mc() ▸ [16 0]
        key 'right' ; mc() ▸ [16 0]

        e.state.setCursors [[0 2]] ; key 'alt+right' ; mc() ▸ [2 2]

  ▸ sheet editing

        sheet 'popo_sheet_editing'
        e.grabFocus()
        loadSheet {children:[{ text:'abcdef' x:2 y:1 w:3 h:3 }]}

        e.state.setCursors [[2 1]] ; key 'delete' ; rt('children.0.text') ▸ 'abcdef' ; mc() ▸ [2 1]
        e.state.setCursors [[3 1]] ; key 'delete' ; rt('children.0.text') ▸ 'bcdef'  ; mc() ▸ [2 1]

        e.state.setCursors [[2 2]] ; key 'delete' ; rt('children.0.text') ▸ 'bcef' ; mc() ▸ [4 1]

        e.state.setCursors [[3 2]] ; key 'delete' ; rt('children.0.text') ▸ 'bce' ; mc() ▸ [2 2]
        key 'delete' ; rt('children.0.text') ▸ 'bc' ; mc() ▸ [4 1]

        e.state.setCursors [[10 3]] ; key 'delete' ; rt('children.0.text') ▸ 'bc' ; mc() ▸ [10 3]

        e.state.undo() ; rt('children.0.text') ▸ 'bce'

        loadSheet {children:[{ text:'ab\ncd' x:2 y:1 w:4 h:2 }]}

        e.state.setCursors [[2 2]] ; key 'delete' ; rt('children.0.text') ▸ 'abcd' ; mc() ▸ [4 1]

        loadSheet {children:[{ text:'abcd' x:2 y:0 w:4 h:4 scale:2 }]}

        e.state.setCursors [[2 3]] ; key 'delete' ; rt('children.0.text') ▸ 'acd' ; mc() ▸ [3 1]

        loadSheet {children:[{ text:'ab' x:2 y:1 w:3 h:2 }]}

        e.state.setCursors [[4 1]] ; e.state.insert 'c' ; rt('children.0.text') ▸ 'abc'   ; mc() ▸ [2 2]
        e.state.insert 'd'                             ; rt('children.0.text') ▸ 'abcd'  ; mc() ▸ [3 2]
        e.state.setCursors [[3 1]] ; e.state.insert 'X' ; rt('children.0.text') ▸ 'aXbcd' ; mc() ▸ [4 1]
        e.state.insert 'Y'                             ; rt('children.0.text') ▸ 'aXYbcd' ; mc() ▸ [2 2]

        loadSheet {children:[{ text:'ab' x:2 y:1 w:2 h:1 }]}

        e.state.setCursors [[4 1]] ; e.state.insert 'c' ; rt('children.0.text') ▸ 'abc' ; rt('children').length ▸ 1

        loadSheet {children:[{ text:'ab' x:2 y:0 w:6 h:4 scale:2 }]}

        e.state.setCursors [[4 1]] ; e.state.insert 'c' ; rt('children.0.text') ▸ 'abc' ; mc() ▸ [2 3]

  ▸ sheet clicks

        sheet 'popo_sheet_click' [] 8 fileeditor
        loadSheet bands()

        click 5 2 ; mc() ▸ [3 2]
        click 5 1 ; mc() ▸ [3 2]
        click 8 3 ; mc() ▸ [5 4]
        click 3 6 ; mc() ▸ [3 6]
        click 3 5 ; mc() ▸ [3 5]

        post.emit 'cells.rect' {x:2 y:1 w:8 h:4}
        click 4 2
        e.cells.cellRect ▸ {x:2 y:1 w:8 h:4}
