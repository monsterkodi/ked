  ▸ repaint

        cells = {cols:12 rows:8}
        tree  = lined { bg:'#111' children:[
            { pattern:'.' x:0 y:0 w:12 h:8 children:[{ erase:'char' x:0 y:6 w:3 h:1 }] }
            { text:'abc def' x:1 y:1 w:4 h:3 fg:'#f00' }
            { text:'XY' x:3 y:2 w:6 h:4 scale:2 }
            { text:'z' x:9 y:6 w:3 h:2 } ] }
        full  = -> layout.sheetData cells layout.liveNode(layout.plainNode(tree))
        layout.sheetData cells tree
        node = tree.children[1]
        node.state.setCursors [[3 0]] ; node.state.insert 'QQ'
        top = tree.rows[0] ; low = tree.rows[7]
        layout.sheetData(cells tree [1 2 3]) ▸ full()
        tree.rows[0] == top ▸ true ; tree.rows[7] == low ▸ true
        node = tree.children[3]
        node.state.setCursors [[1 0]] ; node.state.insert 'w\nv\nu'
        projector.scrollToCursor node
        layout.sheetData(cells tree [6 7]) ▸ full()
        node.state.setCursors [[0 0]] ; projector.scrollToCursor node
        layout.sheetData(cells tree [6 7]) ▸ full()
        tree.children[2].state.setCursors [[0 0]] ; tree.children[2].state.insert 'a b'
        layout.sheetData(cells tree [3]) ▸ full()
        tree.rows.length ▸ 8

  ▸ projector

        node = textnode {cols:8 rows:6} { text:'abcdef\nxy' x:1 y:1 w:4 h:4 }
        strs(node) ▸ ['abcdef' 'xy']
        node.state.wrapStarts 0 ▸ [0 4]
        glyphs(node) ▸ [[1 1 'a'] [2 1 'b'] [3 1 'c'] [4 1 'd'] [1 2 'e'] [2 2 'f'] [1 3 'x'] [2 3 'y']]
        projector.cellOf(node [5 0]) ▸ [2 2]
        projector.cellOf(node [4 0]) ▸ [1 2]
        projector.cellOf(node [1 1]) ▸ [2 3]
        projector.posAt(node [3 2]) ▸ [6 0]
        projector.posAt(node [2 3]) ▸ [1 1]
        projector.posAt(node [1 4])? ▸ false
        node.state.syntax.ext ▸ 'md'
        node.lines? ▸ false
        layout.plainNode(node).state? ▸ false
        layout.plainNode(node).s == node.state.s ▸ true
        layout.dataNode(node) ▸ {text:'md' lines:['abcdef' 'xy'] x:1 y:1 w:4 h:4}

        node = textnode {cols:4 rows:2} { text:'ab cd' x:0 y:0 w:4 h:2 }
        node.state.wrapStarts 0 ▸ [0 3]

        node = textnode {cols:4 rows:2} { text:'abcdefghij' x:0 y:0 w:4 h:2 }
        node.state.setCursors [[10 0]]
        projector.scrollToCursor node
        glyphs(node) ▸ [[0 0 'e'] [1 0 'f'] [2 0 'g'] [3 0 'h'] [0 1 'i'] [1 1 'j']]
        projector.cellOf(node [10 0]) ▸ [2 1]
        projector.cellOf(node [0 0])? ▸ false
        projector.posAt(node [0 0]) ▸ [4 0]
        node.state.setCursors [[1 0]]
        projector.scrollToCursor node
        projector.cellOf(node [1 0]) ▸ [1 0]

        node = textnode {cols:4 rows:4} { text:'abc' x:0 y:0 w:4 h:4 scale:2 }
        glyphs(node) ▸ [[0 0 'a'] [2 0 'b'] [0 2 'c']]
        projector.cellOf(node [1 0]) ▸ [2 1]
        projector.cellOf(node [2 0]) ▸ [0 3]
        projector.posAt(node [2 1]) ▸ [1 0]
        projector.posAt(node [1 3]) ▸ [2 0]

        node = textnode {cols:6 rows:2} { text:'abcdefg' x:0 y:0 w:6 h:2 children:[{ x:2 y:0 w:2 h:1 blocks:true }] }
        glyphs(node) ▸ [[0 0 'a'] [1 0 'b'] [4 0 'c'] [5 0 'd'] [0 1 'e'] [1 1 'f'] [2 1 'g']]
        projector.cellOf(node [2 0]) ▸ [4 0]

