        h.screen.textMarked()[1] ▸ ' A··'

  ▸ sheet typing

        sheet 'popo_sheet_typing'
        loadSheet {}

        e.state.setCursors [[2 1]] ; e.state.insert 'a' ; e.draw()
        mc() ▸ [3 1] ; h.at(2 1) ▸ 'a'
        txt('children.0') ▸ 'a'
        rt('children.0.rect.abs') ▸ {x:2 y:1 w:2 h:1}

        e.state.insert 'b' ; e.draw()
        mc() ▸ [4 1] ; h.at(3 1) ▸ 'b'
        txt('children.0') ▸ 'ab'
        rt('children.0.w') ▸ 3

        loadSheet {children:[{ x:2 y:1 w:6 h:2 }]}

        e.state.setCursors [[5 2]] ; e.state.insert 'c'
        layout.dataNode(rt('children.0.children.0')) ▸ {text:'md' lines:['c'] x:3 y:1 w:2 h:1}

  ▸ sheet move keys

        sheet 'popo_sheet_move'
        e.grabFocus()

        loadSheet {children:[{ text:'a' x:2 y:1 w:3 h:2 }]} [3 1]

        h.key e 'shift+alt+l' ; rt('children.0.rect.abs') ▸ {x:3 y:1 w:3 h:2}
        e.state.mainCursor() ▸ [4 1]
        h.key e 'shift+alt+j' ; rt('children.0.rect.abs') ▸ {x:3 y:2 w:3 h:2}
        h.key e 'shift+alt+k' ; rt('children.0.rect.abs') ▸ {x:3 y:1 w:3 h:2}
        h.key e 'shift+alt+h' ; rt('children.0.rect.abs') ▸ {x:2 y:1 w:3 h:2}

        key "ctrl+alt+'" ; rt('children.0.rect.abs') ▸ {x:2 y:1 w:3 h:3}
        key 'ctrl+alt+/' ; rt('children.0.rect.abs') ▸ {x:2 y:1 w:3 h:2}
        key 'ctrl+alt+/' ; rt('children.0.rect.abs') ▸ {x:2 y:1 w:3 h:1}
        key 'ctrl+alt+/' ; rt('children.0.rect.abs') ▸ {x:2 y:1 w:3 h:1}
        key 'ctrl+alt+,' ; key 'ctrl+alt+,' ; key 'ctrl+alt+,' ; rt('children.0.rect.abs') ▸ {x:2 y:1 w:1 h:1}
        key 'ctrl+alt+.' ; rt('children.0.rect.abs') ▸ {x:2 y:1 w:2 h:1}

        loadSheet {children:[{ text:'ab' x:2 y:0 w:4 h:2 scale:2 }]}

        e.state.setCursors [[2 1]]
        key "ctrl+alt+'" ; rt('children.0.h') ▸ 4 ; rt('children.0.rect.abs.h') ▸ 4
        key 'ctrl+alt+/' ; rt('children.0.h') ▸ 2
        key 'ctrl+alt+/' ; rt('children.0.h') ▸ 2

        loadSheet {children:[{ text:'a' x:2 y:1 w:3 h:2 children:[{ text:'b' x:1 y:0 w:1 h:1 }] } { text:'c' x:8 y:0 w:2 h:1 }]}

        e.state.setCursors [[3 1]]
        key 'ctrl+alt+delete' ; rt('children.0.children')? ▸ false ; txt('children.0') ▸ 'a'
        key 'ctrl+alt+entf'   ; txt('children.0') ▸ 'c' ; rt('children').length ▸ 1

        e.state.setCursors [[12 3]]
        key 'ctrl+alt+delete' ; rt('children').length ▸ 1

        e.state.deleteSheetNode rt('children.0') ; rt('children')? ▸ false
        e.state.undo() ; txt('children.0') ▸ 'c'

        se = new sheeditor h.screen e 'popo_sheeditor'
        se.show()
        se.layout 0 0 16 4
        se.sheetree.reloadTree()
        se.sheetree.select 0
        content(se.sheetree.current()) ▸ 'c'
        se.onKey 'ctrl+alt+entf' h.event('ctrl+alt+entf') ; rt('children')? ▸ false

  ▸ sheet undo

        sheet 'popo_sheet_undo'
        e.grabFocus()
        loadSheet {children:[{ text:'a' x:2 y:1 w:3 h:2 }]} [3 1]

        e.state.moveSheetNode 'right'
        rt('children.0.x') ▸ 3
        e.draw()
        h.at(3 1) ▸ 'a'

        e.state.undo()
        rt('children.0.x') ▸ 2
        e.state.mainCursor() ▸ [3 1]
        e.draw()
        h.at(2 1) ▸ 'a'

        e.state.redo()
        rt('children.0.x') ▸ 3

        rt('children.0').w = 5 ; e.state.commitSheet() ; rt('children.0.rect.abs.w') ▸ 5
        e.state.undo() ; rt('children.0.w') ▸ 3 ; rt('children.0.rect.abs.w') ▸ 3

  ▸ sheet text undo

        sheet 'popo_sheet_text_undo'
        e.grabFocus()
        loadSheet {bg:'#000'} [2 1]
        e.state.setCursors [[2 1]]

        e.state.insert 'a' ; txt('children.0.children.0') ▸ 'a'
        e.state.undo()     ; rt('children.0.children')? ▸ false
        e.state.redo()     ; txt('children.0.children.0') ▸ 'a'

  ▸ sheet syntax

        sheet 'popo_sheet_syntax' ['susan'] 6
        e.grabFocus()
        cls  = x y -> e.state.syntax.getClass x y
        nodeCls = (path x y) -> rt(path).state.syntax.getClass x y

        loadSheet {children:[{ text:'kode' lines:['x = 1 # c'] x:1 y:1 w:12 h:1 } { text:'md' lines:['x = 1 # c'] x:1 y:3 w:12 h:1 }]}
        nodeCls('children.0' 4 0) != 'text' ▸ true
        cls(5 1) ▸ nodeCls('children.0' 4 0) ; cls(9 1) ▸ nodeCls('children.0' 8 0)
        cls(5 3) ▸ nodeCls('children.1' 4 0) ; cls(9 3) ▸ nodeCls('children.1' 8 0)
        cls(9 1) == cls(9 3) ▸ false
        e.state.syntax.getClasses(1)[5] ▸ nodeCls('children.0' 4 0)
        e.draw() ; h.screen.get_fg(5+e.cells.x 1+e.cells.y) ▸ e.state.syntax.getColor(5 1)

        e.state.setCursors [[6 1]] ; e.state.insert '2'
        txt('children.0') ▸ 'x = 12 # c' ; cls(6 1) ▸ nodeCls('children.0' 5 0) ; cls(10 1) ▸ nodeCls('children.0' 9 0)

        loadSheet {children:[{ text:'kode' lines:['1 a'] x:0 y:0 w:6 h:2 scale:2 }]}
        pos = e.state.sheetPosForCell [0 1] ; cls(pos[0] pos[1]) ▸ nodeCls('children.0' 0 0)
        pos = e.state.sheetPosForCell [4 1] ; cls(pos[0] pos[1]) ▸ nodeCls('children.0' 2 0)

        loadSheet {children:[{ text:'kode' lines:['1'] x:1 y:1 w:4 h:1 fg:'#ff0000' }]}
        e.draw() ; h.screen.get_fg(1+e.cells.x 1+e.cells.y) == e.state.syntax.getColor(1 1) ▸ false

        e.state.clearSheet()
        tree = lined {children:[{ text:'kode' lines:['x = 1 # c'] x:1 y:1 w:12 h:1 }]}
        e.state.setSheetTree layout.pageOf(tree)
        data = sue.desue e.state.sheetText()
        e.state.loadSegls kseg.segls(data.text.split('\n'))
        e.state.loadSue data.sue
        cls(9 1) ▸ nodeCls('children.0' 8 0) ; cls(9 1) != 'text' ▸ true

        e.state.clearSheet() ; e.state.loadLines ['x = 1']
        e.state.syntax.overlay? ▸ false

  ▸ sheet views

        sheet 'popo_sheet_views' ['susan']
        e.grabFocus()
        loadSheet {children:[{ text:'abcdefghij' x:0 y:0 w:4 h:2 }]}
        node = -> rt('children.0')

        e.state.setCursors [[3 1]] ; key 'shift+down'
        node().state.s.scrollOffset ▸ 1 ; e.draw() ; h.at(0 0) ▸ 'e'
        mc() ▸ [3 1]
        key "ctrl+alt+'" ; rt('children.0.h') ▸ 3
        node().state.s.scrollOffset ▸ 0 ; e.draw() ; h.at(0 0) ▸ 'a' ; mc() ▸ [3 1]
        key 'ctrl+alt+/' ; key 'ctrl+alt+/' ; rt('children.0.h') ▸ 1 ; mc() ▸ [3 0]

        e.state.setCursors [[1 0]] ; key 'shift+down'
        node().state.s.scrollOffset ▸ 1 ; e.draw() ; h.at(0 0) ▸ 'e'
        key 'shift+alt+=' ; rt('children.0.scale') ▸ 2
        node().state.s.scrollOffset ▸ 0 ; node().state.s.view ▸ [0 0]

  ▸ sheet layout undo

        sheet 'popo_sheet_layout_undo' ['susan']
        e.grabFocus()
        loadSheet {children:[{ text:'abc def' x:1 y:0 w:4 h:2 }]}
        kseg.str(e.state.s.lines[0]).trimEnd() ▸ ' abc'

        e.state.setCursors [[2 0]] ; e.state.insert 'X' ; txt('children.0') ▸ 'aXbc def'
        key 'ctrl+alt+.' ; rt('children.0.w') ▸ 5
        key 'shift+alt+l' ; rt('children.0.x') ▸ 2
        key 'shift+alt+=' ; rt('children.0.scale') ▸ 2
        e.state.setCursors [[0 3]] ; e.state.insert 'n' ; rt('children').length ▸ 2
        e.state.deleteSheetNode rt('children.0') ; rt('children').length ▸ 1 ; txt('children.0') ▸ 'n'

        e.state.undo() ; rt('children').length ▸ 2 ; txt('children.0') ▸ 'aXbc def' ; txt('children.1') ▸ 'n'
        e.state.undo() ; rt('children').length ▸ 1
        e.state.undo() ; rt('children.0.scale')? ▸ false ; rt('children.0.x') ▸ 2
        e.state.undo() ; rt('children.0.x') ▸ 1 ; rt('children.0.w') ▸ 5
        e.state.undo() ; rt('children.0.w') ▸ 4 ; txt('children.0') ▸ 'aXbc def'
        e.state.undo() ; txt('children.0') ▸ 'abc def'
        kseg.str(e.state.s.lines[0]).trimEnd() ▸ ' abc'

        e.state.redo() ; txt('children.0') ▸ 'aXbc def'
        e.state.redo() ; e.state.redo() ; e.state.redo() ; rt('children.0.scale') ▸ 2 ; rt('children.0.x') ▸ 2
        e.state.redo() ; rt('children').length ▸ 2
        e.state.redo() ; rt('children').length ▸ 1 ; txt('children.0') ▸ 'n'

        e.state.undo() ; e.state.setCursors [[2 1]] ; e.state.insert 'Y'
        txt('children.0') ▸ 'YaXbc def' ; e.state.hasRedo() ▸ false

  ▸ sheet resize

        sheet 'popo_sheet_resize'
        loadSheet {children:[{ pattern:'x' x:'50%' y:0 w:'50%' h:2 }]} [9 0]

        rt('children.0.rect.abs') ▸ {x:8 y:0 w:8 h:2}

        before = e.state.h.length
        e.layout 0 0 10 4
        rt('children.0.rect.abs') ▸ {x:5 y:0 w:5 h:2}
