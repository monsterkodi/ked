    ▸ titlify

            tree = { bg:'#000' x:2 y:2 w:20 h:10 children:[{ x:3 y:2 w:10 h:5 children:[{ text:'hi' x:1 y:1 w:3 h:1 }] }] }
    
            layout.titlify {cols:30 rows:20} tree
    
            tree.title ▸ '  bg'
            tree.rect.abs ▸ {x:2 y:2 w:20 h:10}
    
            container = sds.get(tree 'children.0')
            container.title? ▸ false
    
            text = sds.get(tree 'children.0.children.0')
            text.title ▸ '      text'
            text.rect.abs ▸ {x:6 y:5 w:3 h:1}
    
            layout.typeOf(tree) ▸ 'bg'
            layout.argOf(tree) ▸ '#000'
            layout.typeOf(container) ▸ null
            layout.typeOf(text) ▸ 'text'
            layout.argOf(text) ▸ 'hi'
    
            tree = { bg:'#000' children:[{ x:2 y:1 w:10 h:5 children:[{ text:'hi' x:1 y:1 r:1 b:1 }] }] }
    
            layout.titlify {cols:30 rows:20} tree
    
            sds.get(tree 'children.0.children.0.rect.abs') ▸ {x:3 y:2 w:8 h:3}

    ▸ sourceOf

            tree = { bg:'#333' children:[{ text:'hi' x:1 y:1 w:3 h:1 }] }
    
            layout.titlify {cols:10 rows:5} tree
            layout.regionize {cols:10 rows:5} tree
    
            noon.parse(layout.sourceOf(tree)) ▸ {bg:'#333' children:[{text:'hi' x:1 y:1 w:3 h:1}]}
    
            tree = { bg:'#333' }
    
            layout.insertTextAt {cols:10 rows:5} tree [2 1] 'a'
    
            noon.parse(layout.sourceOf(tree)) ▸ {bg:'#333' children:[{text:'a' x:2 y:1 w:2 h:1}]}

  ▸ insertTextAt

    ▸ creates a text node

            tree = {}

            layout.insertTextAt({cols:10 rows:5} tree [3 2] 'a').offset ▸ 1

            sds.get(tree 'children.0') ▸ {text:'a' x:3 y:2 w:2 h:1}

            tree = { pattern:'x' x:1 y:1 w:6 h:3 }

            layout.insertTextAt({cols:10 rows:5} tree [3 2] 'a').offset ▸ 1

            sds.get(tree 'children.0') ▸ {text:'a' x:2 y:1 w:2 h:1}

            tree = { x:2 y:2 w:4 h:2 }

            layout.insertTextAt({cols:10 rows:10} tree [8 8] 'a').node.text ▸ 'a'

            sds.get(tree 'children.0') ▸ {text:'a' x:6 y:6 w:2 h:1}

    ▸ inserts into a text node

            tree = { children:[{ text:'ab' x:1 y:1 w:6 h:2 }] }

            layout.insertTextAt({cols:10 rows:5} tree [2 1] 'X').offset ▸ 2

            sds.get(tree 'children.0.text') ▸ 'aXb'

            tree = { children:[{ text:'ab' x:1 y:1 w:6 h:2 }] }

            layout.insertTextAt({cols:10 rows:5} tree [6 1] 'Z').offset ▸ 3

            sds.get(tree 'children.0.text') ▸ 'abZ'

            tree = { children:[{ text:'ab' scale:2 x:0 y:0 w:8 h:2 }] }

            layout.insertTextAt({cols:8 rows:2} tree [4 0] 'X').offset ▸ 3

            sds.get(tree 'children.0.text') ▸ 'abX'

            layout.insertTextAt({cols:8 rows:2} null [0 0] 'X')? ▸ false

  ▸ fill

    ▸ pattern
    
            fill.pattern {pattern:'0123456789' type:'repeat'} [[10 2 20]] ▸ ['0123456789']
            fill.pattern {pattern:'0123456789' type:'repeat'} [[5 2 20] [5 3 15] [0 4 15]] ▸ ['567890123456789' '5678901234' '012345678901234']
            fill.pattern {pattern:'ab' type:'repeat'} [[0 0 3] [1 0 2]] ▸ ['aba' 'b']
            fill.pattern {pattern:'ab' type:'repeat'} [] ▸ []
            fill.pattern {pattern:'ab' type:'repeat'} [[5 0 5]] ▸ ['']
            
    ▸ text
    
            fill.text {text:'some text'} [[5 200 10] [5 201 10]] ▸ ['some ' 'text ']
            fill.text {text:'abcdefgh'} [[0 0 3] [0 1 3] [0 2 3]] ▸ ['abc' 'def' 'gh ']
            fill.text {text:'a\nb'} [[0 0 4] [0 1 4]] ▸ ['a   ' 'b   ']
            fill.text {text:''} [[0 0 3]] ▸ ['   ']

    ▸ scaled

            fill.scaled {text:'abc' scale:2} [[0 0 8] [0 1 8]] {x:0 y:0 w:8 h:2} ▸ [[0 0 'a'] [2 0 'b'] [4 0 'c']]
            fill.scaled {text:'abcdef' scale:2} [[0 0 5] [0 1 5]] {x:0 y:0 w:5 h:2} ▸ [[0 0 'a'] [2 0 'b']]
            fill.scaled {text:'a cd' scale:2} [[0 0 4] [0 1 4] [0 2 4] [0 3 4]] {x:0 y:0 w:4 h:4} ▸ [[0 0 'a'] [2 0 ' '] [0 2 'c'] [2 2 'd']]
            fill.scaled {text:'a\nb' scale:2} [[0 0 6] [0 1 6] [0 2 6] [0 3 6]] {x:0 y:0 w:6 h:4} ▸ [[0 0 'a'] [0 2 'b']]

            fill.scaled {text:'abcd' scale:2} [[0 0 6] [0 1 2] [4 1 6]] {x:0 y:0 w:6 h:2} ▸ [[0 0 'a'] [4 0 'b']]

            fill.scaled {text:'abcd' scale:2} [[0 0 4] [0 1 4] [0 2 4]] {x:0 y:0 w:4 h:3} ▸ [[0 0 'a'] [2 0 'b']]
            
