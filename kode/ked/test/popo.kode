      ▸ limits

                cells = {cols:20 rows:10}
                node  = (tree) -> tree.children[0]
                size  = (tree dir) -> layout.resizeNode cells tree node(tree) dir ; node(tree).rect.abs

                tree = absol cells { children:[{ text:'a' x:2 y:2 w:1 h:1 }] }
                layout.resizeNode(cells tree node(tree) 'less cols')? ▸ false
                layout.resizeNode(cells tree node(tree) 'less rows')? ▸ false
                node(tree).rect.abs ▸ {x:2 y:2 w:1 h:1}

                tree = absol cells { children:[{ text:'a' x:2 y:2 r:2 h:1 }] }
                size(tree 'more cols').w ▸ 17 ; node(tree).r ▸ 1
                size(tree 'less cols').w ▸ 16 ; node(tree).r ▸ 2

                tree = absol cells { children:[{ text:'a' x:2 y:2 r:2 b:2 }] }
                size(tree 'more rows').h ▸ 7 ; node(tree).b ▸ 1

                tree = absol cells { x:4 y:2 w:10 h:6 children:[{ x:2 y:1 w:3 h:2 }] }
                for i in 0...9 ➜ size tree 'more cols'
                node(tree).w ▸ 8
                for i in 0...9 ➜ size tree 'more rows'
                node(tree).h ▸ 5

