                tree.rect ▸ {abs:{x:2 y:2 w:6 h:4} rel:{x:2 y:2 w:6 h:4}}
                sds.get(tree 'children.0.rect') ▸ {abs:{x:2 y:2 w:6 h:4} rel:{x:0 y:0 w:6 h:4}}
                
