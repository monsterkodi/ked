        data = desue {cols:8 rows:3} { bg:'#00f' children:[{ text:'hi' x:1 y:1 w:3 h:1 fg:'#ff0' }] }
        
        data.text ▸ '        \n hi     \n        '
        data.sue.length ▸ 4
        areas(data sue.FG_COLOR).length ▸ 1
        areas(data sue.FG_COLOR)[0].value ▸ [31 3 1 '#ff0']

        data = desue {cols:8 rows:3} { bg:'#00f' children:[{ text:'hi' erase:'bg' x:1 y:1 w:3 h:1 }] }

        data.text ▸ '        \n hi     \n        '
        areas(data sue.BG_COLOR).filter((a) -> a.y == 1).map((a) -> [a.x a.value[1]]) ▸ [[0 1] [4 4]]

        data = desue {cols:6 rows:5} { children:[{ text:'A' x:1 y:1 w:3 h:3 scale:3 fg:'#ff0' }] }
        
        data.text ▸ '      \n      \n      \n A  \n      '
        
        runs = areas data sue.SCALE
        
        runs.length ▸ 1
        runs[0].x ▸ 1
        runs[0].y ▸ 3
        runs[0].value[3] ▸ 3
        
        data = desue {cols:6 rows:3} { children:[{ text:'A' x:1 y:1 w:3 h:1 scale:3 }] }

        data.text ▸ '      \n      \n      '
        areas(data sue.SCALE).length ▸ 0

        data = desue {cols:12 rows:2} { children:[{ text:'ab cd' x:0 y:0 w:12 h:2 scale:2 }] }

        data.text ▸ '            \nab cd '
        runs = areas data sue.SCALE
