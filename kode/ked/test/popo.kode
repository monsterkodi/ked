        data = desue {cols:8 rows:4} { children:[{ text:'ab' x:0 y:0 w:8 h:4 scale:2 }] }

        data.text ▸ '        \nab  \n        \n    '
        areas(data sue.SCALE).map((a) -> [a.x a.y]) ▸ [[0 1] [0 3]]
        areas(data sue.CLOSE).map((a) -> [a.x a.y]) ▸ [[4 1] [4 3]]

