                res = layout.nodeForPos {cols:4 rows:4} { index:1 text:'i' x:1 y:1 w:2 h:2 } [2 2]
                res.index ▸ 1
                res.text ▸ 'i'
                res.rect.abs ▸ {x:1 y:1 w:2 h:2}
                
