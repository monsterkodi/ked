  ▸ sheet editing

        sheet 'popo_sheet_editing'
        e.grabFocus()
        loadSheet {children:[{ text:'abcdef' x:2 y:1 w:3 h:3 }]}

        e.state.setCursors [[2 1]] ; key 'delete' ; txt('children.0') ▸ 'abcdef' ; mc() ▸ [2 1]
        e.state.setCursors [[3 1]] ; key 'delete' ; txt('children.0') ▸ 'bcdef'  ; mc() ▸ [2 1]

        e.state.setCursors [[2 2]] ; key 'delete' ; txt('children.0') ▸ 'bcef' ; mc() ▸ [4 1]

        e.state.setCursors [[3 2]] ; key 'delete' ; txt('children.0') ▸ 'bce' ; mc() ▸ [4 1]
        key 'delete' ; txt('children.0') ▸ 'bc' ; mc() ▸ [4 1]

        e.state.setCursors [[10 3]] ; key 'delete' ; txt('children.0') ▸ 'bc' ; mc() ▸ [10 3]

        e.state.undo() ; txt('children.0') ▸ 'bce'

        loadSheet {children:[{ text:'ab\ncd' x:2 y:1 w:4 h:2 }]}

        e.state.setCursors [[2 2]] ; key 'delete' ; txt('children.0') ▸ 'abcd' ; mc() ▸ [4 1]

        loadSheet {children:[{ text:'abcd' x:2 y:0 w:4 h:4 scale:2 }]}

        e.state.setCursors [[2 3]] ; key 'delete' ; txt('children.0') ▸ 'acd' ; mc() ▸ [3 1]

        loadSheet {children:[{ text:'ab' x:2 y:1 w:3 h:2 }]}

        e.state.setCursors [[4 1]] ; e.state.insert 'c' ; txt('children.0') ▸ 'abc'   ; mc() ▸ [4 1]
        e.state.insert 'd'                             ; txt('children.0') ▸ 'abcd'  ; mc() ▸ [3 2]
        e.state.setCursors [[3 1]] ; e.state.insert 'X' ; txt('children.0') ▸ 'aXbcd' ; mc() ▸ [4 1]
        e.state.insert 'Y'                             ; txt('children.0') ▸ 'aXYbcd' ; mc() ▸ [2 2]
        h.key e 'return' '\n' ; strs(rt('children.0')) ▸ ['aXY' 'bcd'] ; mc() ▸ [2 2]

        loadSheet {children:[{ text:'ab' x:2 y:1 w:2 h:1 }]}

        e.state.setCursors [[4 1]] ; e.state.insert 'c' ; txt('children.0') ▸ 'abc' ; rt('children').length ▸ 1
        mc() ▸ [3 1] ; e.draw() ; h.at(2 1) ▸ 'c'
        e.state.setCursors [[2 1]] ; e.draw() ; h.at(2 1) ▸ 'c'
        key 'up' ; rt('children.0').state.s.scrollOffset ▸ 0 ; e.draw() ; h.at(2 1) ▸ 'a'
        e.state.setCursors [[3 1]] ; key 'right' ; mc() ▸ [4 1] ; h.at(2 1) ▸ 'a'

        loadSheet {children:[{ text:'ab' x:2 y:0 w:6 h:4 scale:2 }]}

        e.state.setCursors [[4 1]] ; e.state.insert 'c' ; txt('children.0') ▸ 'abc' ; mc() ▸ [4 1]

  ▸ sheet selection

        sheet 'popo_sheet_select'
        e.grabFocus()
        sel = -> rt('children.0').state.textOfSelection()

        loadSheet {children:[{ text:'abcdef' x:2 y:1 w:3 h:3 } { pattern:'.' x:8 y:0 w:2 h:2 }]}

        e.state.setCursors [[3 1]]
        key 'cmd+a' ; sel() ▸ 'abcdef' ; e.state.s.selections ▸ [[2 1 5 1] [2 2 5 2]]
        key 'cmd+a' ; e.state.s.selections ▸ []

        key 'cmd+a' ; e.state.insert 'X'
        txt('children.0') ▸ 'X' ; e.state.s.selections ▸ [] ; mc() ▸ [3 1]
        e.state.undo() ; txt('children.0') ▸ 'abcdef'

        key 'esc' ; e.state.setCursors [[3 1]]
        key 'shift+right' ; key 'shift+right' ; sel() ▸ 'b'
        key 'shift+left' ; sel() ▸ ''
        key 'shift+down' ; sel() ▸ 'bcd' ; e.state.s.selections ▸ [[3 1 5 1] [2 2 3 2]]
        e.state.insert 'Y' ; txt('children.0') ▸ 'aYef' ; mc() ▸ [4 1]

        loadSheet {children:[{ text:'abcdef' x:2 y:1 w:3 h:3 }]}

        e.state.setCursors [[5 2]]
        key 'shift+left' ; key 'shift+up' ; sel() ▸ 'cdef'
        key 'delete' ; txt('children.0') ▸ 'ab' ; e.state.s.selections ▸ []
        e.state.undo() ; txt('children.0') ▸ 'abcdef' ; sel() ▸ 'cdef'
        key 'esc'

        e.state.setCursors [[3 1]] ; key 'entf' ; txt('children.0') ▸ 'acdef' ; mc() ▸ [3 1]
        e.state.setCursors [[2 2]] ; key 'shift+right' ; key 'entf' ; txt('children.0') ▸ 'acdf'

        e.state.setCursors [[12 3]] ; key 'cmd+a' ; e.state.s.selections ▸ []
        key 'shift+right' ; e.state.s.selections ▸ []

        board = ''
        savedCopy  = clip.copy
        savedPaste = clip.paste
        clip.copy  = (text) -> board = text
        clip.paste = -> board

        e.state.setCursors [[2 1]] ; key 'shift+right' ; key 'shift+right'
        e.state.copy() ; board ▸ 'ac'
        e.state.setCursors [[4 1]] ; key 'shift+left' ; key 'shift+left'
        e.state.cut()  ; board ▸ 'ac' ; txt('children.0') ▸ 'df'
        e.state.setCursors [[3 1]] ; e.state.paste() ; txt('children.0') ▸ 'dacf'
        e.state.setCursors [[12 3]] ; e.state.cut() ; txt('children.0') ▸ 'dacf'

        clip.copy  = savedCopy
        clip.paste = savedPaste

  ▸ sheet multi

        sheet 'popo_sheet_multi' [] 8
        e.grabFocus()

        loadSheet {children:[{ text:'foo bar' x:0 y:0 w:8 h:2 } { text:'bar foo' x:0 y:3 w:8 h:2 }]}
        e.state.setCursors [[1 0]]
        key 'alt+cmd+d'
        e.state.s.highlights ▸ [[0 0 3] [4 3 7]]
        e.state.s.cursors.length ▸ 1
        key 'alt+cmd+d'
        e.state.s.cursors ▸ [[3 0] [7 3]]
        e.state.s.selections ▸ [[0 0 3 0] [4 3 7 3]]
        h.key e 'X' 'X'
        txt('children.0') ▸ 'X bar' ; txt('children.1') ▸ 'bar X'
        e.state.s.cursors ▸ [[1 0] [5 3]]
        key 'esc' ; e.state.s.cursors ▸ [[1 0]]
        h.key e 'Y' 'Y' ; txt('children.0') ▸ 'XY bar' ; txt('children.1') ▸ 'bar X'
        e.state.undo() ; e.state.undo()
        txt('children.0') ▸ 'foo bar' ; txt('children.1') ▸ 'bar foo'

        loadSheet {children:[{ text:'abc\ndef\nghi' x:1 y:0 w:4 h:3 }]}
        e.state.setCursors [[1 0]]
        key 'cmd+down' ; key 'cmd+down'
        e.state.s.cursors ▸ [[1 0] [1 1] [1 2]]
        lines = e.state.s.lines ; undos = e.state.h.length
        key 'shift+right' ; key 'shift+right'
        e.state.s.selections ▸ [[1 0 3 0] [1 1 3 1] [1 2 3 2]]
        e.state.s.lines == lines ▸ true ; e.state.h.length ▸ undos
        row = e.state.s.lines[6] ; painted = e.state.rectree.rows[6]
        h.key e 'X' 'X'
        e.state.s.lines[6] == row ▸ true ; e.state.s.lines == lines ▸ false
        e.state.rectree.rows[6] == painted ▸ true
        strs(rt('children.0')) ▸ ['Xc' 'Xf' 'Xi']
        e.state.s.cursors ▸ [[2 0] [2 1] [2 2]]

        loadSheet {children:[{ text:'abcdefgh' x:0 y:0 w:3 h:3 }]}
        e.state.setCursors [[1 0]]
        key 'cmd+down' ; e.state.s.cursors ▸ [[1 0] [1 1]]
        key 'down'     ; e.state.s.cursors ▸ [[1 1] [1 2]]
        key 'right'    ; e.state.s.cursors ▸ [[2 1] [2 2]]
        key 'right'    ; e.state.s.cursors ▸ [[2 1] [2 2]]
        key 'up'       ; e.state.s.cursors ▸ [[2 0] [2 1]]
        key 'left' ; key 'left' ; key 'left' ; e.state.s.cursors ▸ [[0 0] [0 1]]
        key 'esc'      ; e.state.s.cursors.length ▸ 1
        key 'down'     ; e.state.s.cursors.length ▸ 1

        loadSheet {children:[{ text:'abcd' x:2 y:0 w:4 h:4 scale:2 }]}
        e.state.setCursors [[2 1]]
        key 'cmd+down' ; e.state.s.cursors ▸ [[2 1] [2 3]]
        e.state.scaleRunsForLine(3) ▸ [[2 4 2]]

        loadSheet {children:[{ text:'ab\ncd' x:0 y:0 w:4 h:2 }]}
        e.state.setCursors [[0 0]]
        key 'cmd+down' ; e.state.s.cursors.length ▸ 2
        e.state.setCursors [[3 1]] ; key 'right' ; e.state.s.cursors ▸ [[4 1]]

  ▸ sheet clicks

        sheet 'popo_sheet_click' [] 8 fileeditor
        loadSheet bands()

        click 5 2 ; mc() ▸ [3 2]
        click 5 1 ; mc() ▸ [3 2]
        click 8 3 ; mc() ▸ [5 4]
        click 3 6 ; mc() ▸ [3 6]
        click 3 5 ; mc() ▸ [3 5]

        post.emit 'cells.rect' {x:2 y:1 w:8 h:4}
        click 4 2
        e.cells.cellRect ▸ {x:2 y:1 w:8 h:4}

        se = new sheeditor h.screen e 'popo_sheeditor_jump'
        se.show()
        se.layout 0 0 16 8

        loadSheet {children:[{ text:'abc' x:2 y:1 w:6 h:2 } { text:'z' x:10 y:0 w:2 h:1 }]}
        se.sheetree.reloadTree()

        e.state.setCursors [[4 2]]
        se.sheetree.select 0 ; se.sheetree.jumpTo se.sheetree.current() ; mc() ▸ [4 2]
        se.sheetree.select 1 ; se.sheetree.jumpTo se.sheetree.current() ; mc() ▸ [10 0]
        se.sheetree.select 0 ; se.sheetree.jumpTo se.sheetree.current() ; mc() ▸ [2 1]

        e.grabFocus()
        e.state.setCursors [[11 0]] ; content(se.sheetree.current()) ▸ 'z'
        e.state.insert 'x' ; se.sheetree.current() == rt('children.1') ▸ true ; txt('children.1') ▸ 'zx'
        key 'delete' ; se.sheetree.current() == rt('children.1') ▸ true
        e.state.undo() ; se.sheetree.current() == rt('children.1') ▸ true

        loadSheet {children:[{ text:'abc' x:2 y:1 w:6 h:2 } { text:'z' x:10 y:0 w:2 h:1 } { text:'q' x:10 y:4 w:2 h:1 }]}
        se.sheetree.reloadTree()

        se.sheetree.grabFocus()
        se.sheetree.select 0
        se.onKey 'down' h.event('down') ; mc() ▸ [10 0]
        se.onKey 'delete' h.event('delete') ; rt('children').length ▸ 2 ; content(se.sheetree.current()) ▸ 'q'   ; mc() ▸ [10 4]
        se.onKey 'entf'   h.event('entf')   ; rt('children').length ▸ 1 ; content(se.sheetree.current()) ▸ 'abc' ; mc() ▸ [2 1]
        se.onKey 'ctrl+alt+delete' h.event('ctrl+alt+delete') ; rt('children')? ▸ false

        se.sheetree.grabFocus()
        se.onKey 'cmd+z'       h.event('cmd+z')       ; txt('children.0') ▸ 'abc'
        se.onKey 'ctrl+z'      h.event('ctrl+z')      ; rt('children').length ▸ 2
        se.onKey 'shift+cmd+z' h.event('shift+cmd+z') ; rt('children').length ▸ 1
        se.onKey 'ctrl+y'      h.event('ctrl+y')      ; rt('children')? ▸ false

        undo = -> se.onKey 'cmd+z' h.event('cmd+z')

        loadSheet {children:[{ text:'abc' x:2 y:1 w:6 h:2 } { text:'z' x:10 y:0 w:2 h:1 } { text:'q' x:10 y:4 w:2 h:1 }]}
        se.sheetree.reloadTree()
        se.sheetree.grabFocus()
        se.sheetree.select 1
        se.onKey 'delete' h.event('delete') ; content(se.sheetree.current()) ▸ 'q'
        undo() ; rt('children').length ▸ 3 ; content(se.sheetree.current()) ▸ 'q' ; se.sheetree.currentIndex() ▸ 2

        loadSheet {children:[{ pattern:'.' x:0 y:0 w:8 h:3 }]}
        se.sheetree.reloadTree()
        e.state.setCursors [[2 1]] ; e.state.insert 'x'
        se.sheetree.select 1 ; content(se.sheetree.current()) ▸ 'x'
        undo() ; rt('children.0.children')? ▸ false ; se.sheetree.current().pattern ▸ '.'

        board = ''
        savedCopy  = clip.copy
        savedPaste = clip.paste
        clip.copy  = (text) -> board = text
        clip.paste = -> board
        cmd = (combo) -> se.onKey combo h.event(combo)

        loadSheet {children:[{ text:'abc' x:2 y:1 w:6 h:2 } { text:'z' x:10 y:0 w:2 h:1 children:[{ bg:'#f00' x:0 y:0 w:1 h:1 }] }]}
        se.sheetree.reloadTree()
        se.sheetree.grabFocus()

        se.sheetree.select 1 ; cmd 'ctrl+c' ; JSON.parse(board) ▸ {text:'md' lines:['z'] x:10 y:0 w:2 h:1 children:[{bg:'#f00' x:0 y:0 w:1 h:1}]}

        se.sheetree.select 0 ; cmd 'cmd+v'
        rt('children').length ▸ 2 ; txt('children.0.children.0') ▸ 'z' ; rt('children.0.children.0.children.0.bg') ▸ '#f00'
        se.sheetree.current() == rt('children.0.children.0') ▸ true

        se.sheetree.select 0 ; cmd 'cmd+x'
        rt('children').length ▸ 1 ; JSON.parse(board).lines ▸ ['abc'] ; content(se.sheetree.current()) ▸ 'z'

        cmd 'ctrl+v' ; rt('children').length ▸ 1 ; txt('children.0.children.1') ▸ 'abc' ; txt('children.0.children.1.children.0') ▸ 'z'

        for text in ['hello' '{"foo":1}' '[1]' '{}' '{"children":[{"x":"1","nope":2}]}']
            board = text ; cmd 'cmd+v' ; rt('children.0.children').length ▸ 2

        undo() ; rt('children.0.children').length ▸ 1

        clip.copy  = savedCopy
        clip.paste = savedPaste

        order = -> se.sheetree.fuzzied.map (n) -> content n
        rect  = (text) -> se.sheetree.fuzzied.find((n) -> content(n) == text).rect.abs

        loadSheet {children:[{ text:'a' x:0 y:0 w:2 h:1 } { text:'b' x:4 y:1 w:8 h:4 children:[{ text:'c' x:1 y:1 w:2 h:1 } { text:'e' x:'50%' y:2 r:1 b:1 }] } { text:'d' x:14 y:0 w:2 h:1 }]}
        se.sheetree.reloadTree()
        se.sheetree.grabFocus()
        se.sheetree.select 0

        cmd 'alt+down' ; order() ▸ ['b' 'a' 'c' 'e' 'd'] ; txt('children.0.children.0') ▸ 'a' ; rt('children.0.children.0.x') ▸ -4
        cmd 'alt+down' ; order() ▸ ['b' 'c' 'a' 'e' 'd']
        cmd 'alt+down' ; order() ▸ ['b' 'c' 'e' 'a' 'd']
        cmd 'alt+down' ; order() ▸ ['b' 'c' 'e' 'a' 'd'] ; txt('children.1') ▸ 'a' ; rect('a') ▸ {x:0 y:0 w:2 h:1}
        cmd 'alt+down' ; order() ▸ ['b' 'c' 'e' 'd' 'a']
        cmd 'alt+down' ; order() ▸ ['b' 'c' 'e' 'd' 'a']
        cmd 'alt+up'   ; order() ▸ ['b' 'c' 'e' 'a' 'd']
        cmd 'alt+up'   ; order() ▸ ['b' 'c' 'e' 'a' 'd'] ; txt('children.0.children.2') ▸ 'a'
        cmd 'alt+up'   ; order() ▸ ['b' 'c' 'a' 'e' 'd'] ; content(se.sheetree.current()) ▸ 'a'

        se.sheetree.select 1 ; rect('c') ▸ {x:5 y:2 w:2 h:1}
        cmd 'alt+up'   ; order() ▸ ['c' 'b' 'a' 'e' 'd'] ; rect('c') ▸ {x:5 y:2 w:2 h:1}

        se.sheetree.select 3 ; rect('e') ▸ {x:8 y:3 w:3 h:1}
        cmd 'alt+down' ; order() ▸ ['c' 'b' 'a' 'e' 'd'] ; txt('children.2') ▸ 'e' ; rect('e') ▸ {x:8 y:3 w:3 h:1}

        undo() ; txt('children.1.children.1') ▸ 'e'

        loadSheet {bg:'#333' children:[{ text:'c' x:1 y:1 w:2 h:1 }]}
        se.sheetree.reloadTree()
        se.sheetree.grabFocus()

        layouts = -> se.sheetree.fuzzied.map (n) -> n.text? ? content(n) : n.bg
        layouts() ▸ ['#333' 'c']

        se.sheetree.select 1
        cmd 'alt+up' ; layouts() ▸ ['c' '#333'] ; txt('children.0') ▸ 'c' ; rt('children.1.children')? ▸ false
        cmd 'alt+up' ; layouts() ▸ ['c' '#333']

        se.sheetree.select 1 ; cmd 'delete' ; layouts() ▸ ['c']

        noon.parse(layout.sourceOf(e.state.rectree)) ▸ {children:[{text:'md' lines:['c'] x:1 y:1 w:2 h:1}]}

        loadSheet {children:[{ x:1 y:1 w:6 h:3 children:[{ text:'t' x:2 y:1 w:2 h:1 }] } { text:'z' x:10 y:0 w:2 h:1 }]}
        se.sheetree.reloadTree()

        titles = -> se.sheetree.fuzzied.map (n) -> n.title.trim()
        titles() ▸ ['box' 'text' 'text']

        e.state.setCursors [[1 1]]  ; se.sheetree.currentIndex() ▸ 0
        e.state.setCursors [[3 2]]  ; se.sheetree.currentIndex() ▸ 1
        e.state.setCursors [[10 0]] ; se.sheetree.currentIndex() ▸ 2
        e.state.setCursors [[14 3]] ; se.sheetree.currentIndex() ▸ 2

        se.sheetree.grabFocus()
        se.sheetree.select 0
        cmd 'delete' ; titles() ▸ ['text'] ; txt('children.0') ▸ 'z'

  ▸ sheet mouse

        sheet 'popo_sheet_mouse' [] 8 fileeditor
        mouse = (type x y opt={}) -> e.onMouse Object.assign({type:type cell:[x+e.cells.x y+e.cells.y] button:'left' count:1} opt)
        sel   = -> rt('children.0').state.textOfSelection()

        loadSheet {children:[{ text:'foo bar\nbaz' x:1 y:1 w:8 h:3 } { text:'qux' x:1 y:5 w:4 h:1 }]}

        mouse 'press' 1 1 ; mouse 'drag' 4 1 ; mouse 'release' 4 1
        sel() ▸ 'foo' ; e.state.s.selections ▸ [[1 1 4 1]] ; mc() ▸ [4 1]
        mouse 'press' 5 1 ; mouse 'drag' 3 2 ; mouse 'release' 3 2
        sel() ▸ 'bar\nba' ; mc() ▸ [3 2]
        mouse 'press' 6 6
        sel() ▸ '' ; e.state.s.selections ▸ [] ; mc() ▸ [6 6]

        mouse 'press' 1 1 ; mouse 'press' 4 1 {shift:true}
        sel() ▸ 'foo' ; mc() ▸ [4 1]
        mouse 'press' 6 1 {count:2}
        sel() ▸ 'bar' ; e.state.s.highlights ▸ [[5 1 8]]
        mouse 'press' 2 2 {count:3}
        sel() ▸ 'baz'

        mouse 'press' 2 1 ; mouse 'press' 2 2 {alt:true}
        e.state.s.cursors ▸ [[2 1] [2 2]]
        mouse 'press' 2 5 {alt:true}
        e.state.s.cursors ▸ [[2 1] [2 2] [2 5]]
        h.key e 'X' 'X'
        strs(rt('children.0')) ▸ ['fXoo bar' 'bXaz'] ; txt('children.1') ▸ 'qXux'
        dumpstate.textCursors(e.state) ▸ 'text 1 · 1 cursor · 2:0'
        mouse 'press' 6 6 ; e.state.s.cursors.length ▸ 1
        h.key e 'Y' 'Y' ; txt('children.1') ▸ 'qXux'

        mouse 'press' 1 1 ; mouse 'press' 1 2 {alt:true}
        dumpstate.textCursors(e.state) ▸ 'text 0 · 2 cursors · 0:0 0:1'

        mode.modes.brckts = brckts
        e.state.allowedModes.brckts = true
        e.state.startMode 'brckts'
        mouse 'press' 2 1 ; mouse 'drag' 5 1 ; mouse 'release' 5 1
        h.key e '(' '('
        strs(rt('children.0')) ▸ ['f(Xoo) bar' 'bXaz']
        e.state.stopMode 'brckts'
        mouse 'press' 2 3 ; mouse 'drag' 4 3 ; mouse 'release' 4 3
        h.key e '(' '('
        strs(rt('children.0')) ▸ ['f(Xoo) bar' 'b(z']

  ▸ sheet novim

        sheet 'popo_sheet_novim' [] 8 fileeditor
        e.grabFocus()
        oldConfig = config.data
        config.data = { novim: { autoEnableOnEscape: true } }

        try
            novimOn()
            loadSheet novimTree()

            e.state.setCursors [[2 1]] ; e.state.feedSheetKey('x' h.event('x' 'x')) ▸ 'handled'
            strs(rt('children.0')) ▸ ['fo bar' 'baz'] ; nvon() ▸ true
            e.state.setCursors [[1 1]] ; type 'dw'
            strs(rt('children.0')) ▸ ['bar' 'baz']
            e.state.setCursors [[1 1]] ; type 'd' ; key 'down'
            strs(rt('children.0')) ▸ ['']

            loadSheet novimTree()
            e.state.setCursors [[1 2]] ; type 'jj' ; mc() ▸ [1 4]
            type 'k' ; mc() ▸ [1 3]
            e.state.setCursors [[1 1]] ; type '2j' ; mc() ▸ [1 3]

            e.state.setCursors [[6 6]]
            lines = e.state.s.lines ; undos = e.state.h.length
            type 'x' ; type 'dd' ; type 'p' ; type 'J' ; type '~' ; type 'R'
            e.state.s.lines == lines ▸ true ; e.state.h.length ▸ undos
            type 'l' ; mc() ▸ [7 6]

            e.state.setCursors [[1 5]] ; type 'i' ; nvon() ▸ false
            type 'AB ' ; key 'esc'
            txt('children.1') ▸ 'AB qux' ; nvon() ▸ true
            mode.isActive(rt('children.1').state 'novim') ▸ false
            type '0x' ; txt('children.1') ▸ 'B qux'

            e.state.setCursors [[6 6]] ; type 'i' ; type 'z' ; key 'esc'
            nvon() ▸ true ; rt('children').length ▸ 3 ; txt('children.2') ▸ 'z'
            e.state.novim.insert ▸ null

            e.state.setCursors [[10 2]] ; type 'o' ; mc() ▸ [10 3]
            type 'w' ; key 'esc' ; txt('children.3') ▸ 'w' ; rt('children.3.rect.abs.y') ▸ 3
            e.state.setCursors [[10 2]] ; type 'O' ; mc() ▸ [10 1]
            type 'v' ; key 'esc' ; txt('children.4') ▸ 'v' ; rt('children.4.rect.abs.y') ▸ 1

            loadSheet novimTree()
            click 2 1 ; altclick 2 5 ; e.state.s.cursors.length ▸ 2
            undos = e.state.h.length
            type 'dw'
            strs(rt('children.0')) ▸ ['fbar' 'baz'] ; txt('children.1') ▸ 'q'
            e.state.h.length ▸ undos+1
            key 'esc' ; e.state.s.cursors.length ▸ 1

            loadSheet novimTree()
            e.state.setCursors [[2 1]] ; type 'yw'
            e.state.setCursors [[2 5]] ; type 'p' ; txt('children.1') ▸ 'qoo ux'

            loadSheet novimTree()
            e.state.setCursors [[1 1]] ; type 'G'
            e.state.setCursors [[3 5]] ; type 'G'
            key 'ctrl+o' ; mc() ▸ [1 1]
            key 'ctrl+i' ; mc() ▸ [4 5]

            loadSheet novimTree()
            name = rt('children.0').state.name
            e.state.setCursors [[2 1]] ; type 'x'
            e.state.setCursors [[2 5]] ; type 'x'
            e.state.undo() ; e.state.undo() ; e.state.redo() ; e.state.redo()
            rt('children.0').state.name ▸ name
            e.state.setCursors [[10 6]] ; type 'g;' ; mc() ▸ [2 5]
            type 'g;' ; mc() ▸ [2 1]
            type 'g,' ; mc() ▸ [2 5]
            e.state.deleteSheetNode rt('children.1')
            e.state.setCursors [[10 6]] ; type 'g;' ; mc() ▸ [2 1]

            loadSheet novimTree()
            e.state.setCursors [[1 1]] ; type 'qaxq'
            strs(rt('children.0')) ▸ ['oo bar' 'baz']
            e.state.novim.register.read('a').keys.length ▸ 1
            undos = e.state.h.length
            e.state.setCursors [[1 5]] ; type '@a' ; txt('children.1') ▸ 'ux'
            e.state.h.length ▸ undos+1
            e.state.setCursors [[1 2]] ; type 'qbA!' ; key 'esc' ; type 'q'
            strs(rt('children.0')) ▸ ['oo bar' 'baz!']
            e.state.setCursors [[1 5]] ; type '@b' ; txt('children.1') ▸ 'ux!'

            loadSheet novimTree()
            undos = e.state.h.length
            e.state.setCursors [[1 5]] ; type 'iab ' ; key 'esc'
            txt('children.1') ▸ 'ab qux' ; e.state.h.length ▸ undos+1
            type 'u' ; txt('children.1') ▸ 'qux'
            e.state.setCursors [[2 1]] ; type 'xu' ; strs(rt('children.0')) ▸ ['foo bar' 'baz']
            e.state.setCursors [[6 6]] ; type 'iab ' ; key 'esc'
            rt('children').length ▸ 3 ; e.state.h.length ▸ undos+1
            type 'u' ; rt('children').length ▸ 2

            click 2 1 ; altclick 2 5
            type 'iX ' ; key 'esc' ; nvon() ▸ false
            strs(rt('children.0')) ▸ ['fX oo bar' 'baz'] ; txt('children.1') ▸ 'qX ux'
            e.state.h.length ▸ undos+1
            key 'esc' ; nvon() ▸ true
            type 'u' ; txt('children.0') ▸ 'foo bar\nbaz' ; txt('children.1') ▸ 'qux'

            loadSheet novimTree()
            nm = mode.get e.state 'novim'
            errors = []
            onError = (err) -> errors.push err
            post.on 'novim.error' onError
            e.state.setCursors [[1 1]]
            nm.runEx 's/o/0/g' ; strs(rt('children.0')) ▸ ['f00 bar' 'baz'] ; txt('children.1') ▸ 'qux'
            nm.runEx '%s/a/A/g' ; strs(rt('children.0')) ▸ ['f00 bAr' 'bAz']
            nm.runEx '2d' ; strs(rt('children.0')) ▸ ['f00 bAr']
            e.state.setCursors [[6 6]]
            lines = e.state.s.lines
            nm.runEx 's/q/Q/' ; errors[-1] ▸ 'not in a text node'
            txt('children.1') ▸ 'qux' ; e.state.s.lines == lines ▸ true
            post.removeListener 'novim.error' onError

            loadSheet novimTree()
            undos = e.state.h.length
            e.state.setCursors [[1 2]]
            nm.runEx '%s/a/X/gc' ; type 'y' ; type 'y'
            strs(rt('children.0')) ▸ ['foo bXr' 'bXz'] ; e.state.h.length ▸ undos+1

            loadSheet novimTree()
            e.state.setCursors [[1 2]] ; type '/'
            nm.searchChanged 'a'
            rt('children.0').state.s.highlights.length ▸ 2 ; rt('children.1').state.s.highlights ▸ []
            nm.commitSearch() ; mc() ▸ [2 2]
            type 'N' ; mc() ▸ [6 1]
            e.state.setCursors [[6 6]] ; type '/'
            nm.searchChanged 'q' ; nm.commitSearch()
            rt('children.1').state.s.highlights ▸ [] ; mc() ▸ [6 6]

            loadSheet novimTree()
            e.state.setCursors [[1 1]] ; type 'vjjd'
            txt('children.1') ▸ 'qux' ; strs(rt('children.0')).length ▸ 1
            e.state.setCursors [[6 6]] ; type 'v'
            e.state.novim.visual ▸ null ; type 'l' ; mc() ▸ [7 6]
            starts = []
            onStart = (ev) -> starts.push ev.state if ev.state.startsWith 'popo_'
            post.on 'novim.ex.start' onStart
            post.on 'novim.search.start' onStart
            e.state.setCursors [[1 5]] ; type 'V:'
            nm.runEx "'<,'>s/u/U/" ; txt('children.1') ▸ 'qUx'
            type '/' ; nm.cancelSearch()
            starts ▸ [e.state.name e.state.name]
            post.removeListener 'novim.ex.start' onStart
            post.removeListener 'novim.search.start' onStart
        finally
            e.state.stopMode 'novim' if nvon()
            config.data = oldConfig
