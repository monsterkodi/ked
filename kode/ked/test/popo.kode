                node = tree.children[0]
                layout.resizeNode cells tree node 'more cols' ; node.w ▸ 18 ; node.rect.abs.w ▸ 16
                layout.resizeNode(cells tree node 'more cols')? ▸ false
                layout.resizeNode cells tree node 'less cols' ; node.w ▸ 15 ; node.rect.abs.w ▸ 15

    ▸ titlify

