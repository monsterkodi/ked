                layout.resizeNode cells tree node 'more rows' ; node.rect.abs.h ▸ 6
                layout.resizeNode cells tree node 'less rows' ; node.rect.abs.h ▸ 4
                layout.resizeNode cells tree node 'less rows' ; node.rect.abs.h ▸ 2
                layout.resizeNode(cells tree node 'less rows')? ▸ false
                node.rect.abs.h ▸ 2
                layout.resizeNode cells tree node 'more cols' ; node.rect.abs.w ▸ 6
                layout.resizeNode cells tree node 'less cols' ; node.rect.abs.w ▸ 4
                layout.resizeNode cells tree node 'less cols' ; node.rect.abs.w ▸ 2
                layout.resizeNode(cells tree node 'less cols')? ▸ false

