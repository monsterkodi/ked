                lines
                    |# kode: a tiny counter|
                    ||
                    use ../kxk ▪ post
                    ||
                    class counter
                    ||
                    |    @: @name start=0 ->|
                    |        @count = start|
                    |        @steps = []|
                    ||
                    |    incr: n=1 ->|
                    |        @count += n|
                    |        @steps.push n|
                    |        post.emit 'counter' @name @count|
                    |        @count|
                    ||
                    |    reset: -> @count = 0 ; @steps = []|
                    ||
                    c = new counter 'clicks' 3
                    for i in 0...5 ➜ c.incr i
                    log "count #{c.count}"
