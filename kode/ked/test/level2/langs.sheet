                text    py
                lines
                    |# python: a sheet of cells|
                    ||
                    from dataclasses import dataclass, field
                    ||
                    @dataclass
                    class Cell:
                    |    x: int|
                    |    y: int|
                    |    text: str = ''|
                    |    tags: list = field(default_factory=list)|
                    ||
                    def grid(cols, rows):
                    |    """all cells of a cols x rows grid"""|
                    |    return [Cell(x, y) for y in range(rows) for x in range(cols)]|
                    ||
                    if __name__ == '__main__':
                    |    cells = grid(4, 3)|
                    |    for c in cells[:5]:|
                    |        print(f'{c.x}:{c.y}', c.text or None)|
                    |    print(len(cells), True, 3.5e2)|
                erase   bg
                x       2
                y       1
                r       2
