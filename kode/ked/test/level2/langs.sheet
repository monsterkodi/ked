                    // javascript: debounce
                    ||
                    export function debounce(fn, ms = 200) {
                    |    let timer = null;|
                    |    return function (...args) {|
                    |        clearTimeout(timer);|
                    |        timer = setTimeout(() => {|
                    |            fn.apply(this, args);|
                    |        }, ms);|
                    |    };|
                    }
                    ||
                    const log = debounce((e) => {
                    |    console.log('resize', e.target.innerWidth);|
                    }, 100);
                    ||
                    window.addEventListener('resize', log);
                    ||
                    const nums = [1, 2, 3].map(n => n * 2);
                    console.log(nums, typeof nums, null ?? 'x');
                erase   bg
                x       2
                y       1
                r       2
                b       1
