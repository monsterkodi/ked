                    // swift: shapes
                    ||
                    import Foundation
                    ||
                    protocol Shape {
                    |    var area: Double { get }|
                    }
                    ||
                    struct Circle: Shape {
                    |    let radius: Double|
                    |    var area: Double { .pi * radius * radius }|
                    }
                    ||
                    struct Square: Shape {
                    |    let side: Double|
                    |    var area: Double { side * side }|
                    }
                    ||
                    let shapes: [Shape] = [Circle(radius: 2), Square(side: 3)]
                    for s in shapes {
                    |    print(String(format: "%.2f", s.area))|
                    }
