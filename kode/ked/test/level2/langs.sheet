                    // typescript: a typed store
                    ||
                    interface Item {
                    |    id: number;|
                    |    name: string;|
                    |    tags?: string[];|
                    }
                    ||
                    type Filter = (item: Item) => boolean;
                    ||
                    class Store<T extends Item> {
                    |    private items: Map<number, T> = new Map();|
                    ||
                    |    add(item: T): void {|
                    |        this.items.set(item.id, item);|
                    |    }|
                    ||
                    |    find(f: Filter): T[] {|
                    |        return [...this.items.values()].filter(f);|
                    |    }|
                    }
                erase   bg
