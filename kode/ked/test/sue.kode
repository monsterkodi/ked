use ../edit/tool ◆ sue

sym = (ascii) -> Array.from(ascii).map((c) -> String.fromCodePoint(0xE0000 + c.codePointAt(0))).join ''

▸ sue

  ▸ a payload is magic, four decimal length digits and a json body

        sue.sueAscii(sue.sueEncode({a: 1})) ▸ '!0007{"a":1}'

  ▸ the length reads as the number of body symbols

        sue.sueAscii(sue.sueEncode('x')) ▸ '!0003"x"'

  ▸ sueAscii leaves ordinary text alone

        sue.sueAscii 'plain text' ▸ 'plain text'

  ▸ encode and decode round trip a nested value

        value = {a: [1 2 [3 4]] b: {c: 'x'}}

        sue.sueDecode(sue.sueEncode(value)) ▸ value

  ▸ values keep their keys and their types

        value = {s: 2 fg: 16711680 t: ['a' 'b'] n: null}

        back = sue.sueDecode(sue.sueEncode(value))

        back.s ▸ 2
        back.fg ▸ 16711680
        back.t ▸ ['a' 'b']
        back.n ▸ null

  ▸ the symbols stay inside the alphabet

        value = {t: 'a b🐈'}

        symbols = sue.sueEncode value

        ok = true

        for c in Array.from(symbols)
            cp = c.codePointAt(0)
            if cp < 0xE0021 or cp > 0xE007E
                ok = false

        ok ▸ true
        sue.sueDecode(symbols) ▸ value

  ▸ decode rejects a broken or a truncated payload

        sue.sueDecode ''             ▸ undefined
        sue.sueDecode(sym('!'))      ▸ undefined
        sue.sueDecode(sym('!0001x')) ▸ undefined

        trunc = sym '!0007{"a":'
        sue.sueDecode trunc ▸ undefined

  ▸ text without payloads is left alone

        back = sue.desue 'hello world'

        back.text ▸ 'hello world'
        back.sue  ▸ []

  ▸ a payload is stripped and anchored where the text follows

        text = 'ab' + sue.sueEncode({s: 2}) + 'cd'

        back = sue.desue text

        back.text ▸ 'abcd'
        back.sue.length ▸ 1
        back.sue[0].x ▸ 2
        back.sue[0].y ▸ 0
        back.sue[0].value ▸ {s: 2}

  ▸ a payload at the start of a line anchors at zero

        text = sue.sueEncode(1) + 'abc'

        back = sue.desue text

        back.text ▸ 'abc'
        back.sue[0].x ▸ 0

  ▸ a payload at the end of a line anchors at the line length

        text = 'abc' + sue.sueEncode(1)

        back = sue.desue text

        back.text ▸ 'abc'
        back.sue[0].x ▸ 3

  ▸ payloads on several lines carry their line

        text = 'a' + sue.sueEncode(1) + '\nb' + sue.sueEncode(2)

        back = sue.desue text

        back.text ▸ 'a\nb'
        back.sue.length ▸ 2
        back.sue[0].y ▸ 0
        back.sue[0].x ▸ 1
        back.sue[1].y ▸ 1
        back.sue[1].x ▸ 1

  ▸ adjacent payloads keep their order and share an anchor

        text = 'a' + sue.sueEncode(1) + sue.sueEncode(2) + 'b'

        back = sue.desue text

        back.text ▸ 'ab'
        back.sue.length ▸ 2
        back.sue[0].x ▸ 1
        back.sue[1].x ▸ 1
        back.sue[0].value ▸ 1
        back.sue[1].value ▸ 2

  ▸ a payload between graphemes does not split them

        text = 'café' + sue.sueEncode(1) + '漢字'

        back = sue.desue text

        back.text ▸ 'café漢字'
        back.sue[0].x ▸ 4

  ▸ a broken payload is dropped and its symbols are removed

        text = 'a' + sym('!0001x') + 'b'

        back = sue.desue text

        back.text ▸ 'ab'
        back.sue ▸ []

  ▸ no payloads means no change

        sue.ensue 'abc' [] ▸ 'abc'

  ▸ desue and ensue round trip

        text = 'ab' + sue.sueEncode({s: 2}) + 'cd'

        back = sue.desue text

        sue.ensue(back.text back.sue) ▸ text

  ▸ two payloads at the same anchor keep their order

        rects = [{x: 1 y: 0 value: 1} {x: 1 y: 0 value: 2}]

        sue.ensue 'ab' rects ▸ 'a' + sue.sueEncode(1) + sue.sueEncode(2) + 'b'

  ▸ a payload at the end of a line

        rects = [{x: 2 y: 0 value: 1}]

        sue.ensue 'ab' rects ▸ 'ab' + sue.sueEncode(1)

  ▸ a payload on a later line

        rects = [{x: 1 y: 1 value: 1}]

        sue.ensue 'a\nb' rects ▸ 'a\nb' + sue.sueEncode(1)

  ▸ non ascii text keeps its graphemes

        text = 'café' + sue.sueEncode(1) + '漢字'

        back = sue.desue text

        sue.ensue(back.text back.sue) ▸ text

  ▸ several lines with several payloads round trip

        text = sue.sueEncode(1) + 'one' + sue.sueEncode(2) + '\ntwo' + sue.sueEncode(3) + '\n' + sue.sueEncode(4)

        back = sue.desue text

        back.text ▸ 'one\ntwo\n'
        back.sue.length ▸ 4

        sue.ensue(back.text back.sue) ▸ text

  ▸ an empty text with a payload at zero

        rects = [{x: 0 y: 0 value: 1}]

        sue.ensue '' rects ▸ sue.sueEncode(1)

  ▸ a value is code, width, height and data

        sue.sueDecode(sue.sueEncode([31 8 1 '#f00'])) ▸ [31 8 1 '#f00']

  ▸ a box reads its geometry from the value

        lines = [['a' 'b' 'c' 'd' 'e']]

        sue.boxForAreaAndLines({x: 1 y: 0 value: [31 2 1 '#f00']} lines) ▸ {x: 1 y: 0 w: 2 h: 1 values: ['#f00'] open: false}

  ▸ a negative width reaches to the end of the line

        lines = [['a' 'b' 'c' 'd' 'e']]

        box = sue.boxForAreaAndLines({x: 1 y: 0 value: [31 -1 1 '#f00']} lines)

        box.w ▸ 4
        box.h ▸ 1
        box.open ▸ true

  ▸ a mark has no box

        lines = [['a' 'b' 'c' 'd' 'e']]

        sue.boxForAreaAndLines({x: 1 y: 0 value: [41 -1 1 3]} lines) ▸ undefined

  ▸ a value without geometry has no box

        lines = [['a' 'b' 'c' 'd' 'e']]

        sue.boxForAreaAndLines({x: 1 y: 0 value: [31 ['#f00' 8 1]]} lines) ▸ undefined

  ▸ a range cuts an area in two

        lines = [['a' 'b' 'c' 'd' 'e' 'f' 'g' 'h']]
        areas = [{x: 0 y: 0 value: [31 8 1 '#f00']}]
        ranges = [[3 0 6 0]]

        cut = sue.rangesCutFromAreasInLines ranges areas lines

        cut.length ▸ 2
        cut[0] ▸ {x: 0 y: 0 value: [31 3 1 '#f00']}
        cut[1] ▸ {x: 6 y: 0 value: [31 2 1 '#f00']}

  ▸ a range removes an area it covers

        lines = [['a' 'b' 'c']]
        areas = [{x: 0 y: 0 value: [31 3 1 '#f00']}]
        ranges = [[0 0 3 0]]

        sue.rangesCutFromAreasInLines(ranges areas lines) ▸ []

  ▸ a cut keeps the end of line of an open area

        lines = [['a' 'b' 'c' 'd' 'e' 'f']]
        areas = [{x: 2 y: 0 value: [32 -1 1 '#00f']}]
        ranges = [[0 0 4 0]]

        cut = sue.rangesCutFromAreasInLines ranges areas lines

        cut ▸ [{x: 4 y: 0 value: [32 -1 1 '#00f']}]

  ▸ a mark is never cut

        lines = [['a' 'b' 'c' 'd' 'e' 'f' 'g' 'h' 'i' 'j']]
        areas = [{x: 0 y: 0 value: [41 -1 1 7]}]
        ranges = [[0 0 10 0]]

        sue.rangesCutFromAreasInLines ranges areas lines ▸ areas

  ▸ a scale run needs its markers

        lines = [['a' 'b' 'c' 'd' 'e' 'f']]
        areas = [{x: 1 y: 0 value: [41 -1 1 3]} {x: 4 y: 0 value: [99 -1 1 41]}]

        sue.runsForLine(areas lines 0) ▸ [[1 4 3]]

  ▸ a run without a close reaches the end of the line

        lines = [['a' 'b' 'c' 'd' 'e' 'f']]
        areas = [{x: 1 y: 0 value: [41 -1 1 2]}]

        sue.runsForLine(areas lines 0) ▸ [[1 6 2]]

  ▸ a close without an open is ignored

        lines = [['a' 'b' 'c']]
        areas = [{x: 2 y: 0 value: [99 -1 1 41]}]

        sue.runsForLine(areas lines 0) ▸ []

  ▸ an open inside an open is ignored

        lines = [['a' 'b' 'c' 'd' 'e']]
        areas = [{x: 1 y: 0 value: [41 -1 1 2]} {x: 2 y: 0 value: [41 -1 1 3]} {x: 4 y: 0 value: [99 -1 1 41]}]

        sue.runsForLine(areas lines 0) ▸ [[1 4 2]]

  ▸ cell positions follow the runs

        lines = [['a' 'a' ' ' 'b' 'b']]

        sue.cellPositionsForLine(lines 0 []) ▸ [0 1 2 3 4 5]
        sue.cellPositionsForLine(lines 0 [[0 2 3]]) ▸ [0 3 6 7 8 9]
        sue.cellPositionsForLine(lines 0 [[2 4 2]]) ▸ [0 1 2 4 6 7]

  ▸ cell positions count the width of wide graphemes

        lines = [['漢' 'a' 'b']]

        sue.cellPositionsForLine(lines 0 []) ▸ [0 2 3 4]

  ▸ style values keep the flags and the underline colour apart

        sue.styleOfValues(['u'])         ▸ ['u' null]
        sue.styleOfValues(['#ff0' 'u'])  ▸ ['u' '#ff0']

  ▸ stacked style areas join their flags and keep the underline colour

        lines = [['a' 'b' 'c' 'd']]

        areas = [{x: 0 y: 0 value: [34 2 1 'b']} {x: 2 y: 0 value: [34 2 1 '#ff0' 'u']} {x: 0 y: 0 value: [34 4 1 's']}]

        sue.styleFlagsAt(areas lines 0 0) ▸ ['bs' null]
        sue.styleFlagsAt(areas lines 3 0) ▸ ['us' '#ff0']

  ▸ toggling a flag keeps the underline colour

        lines = [['a' 'b' 'c']]
        areas = [{x: 0 y: 0 value: [34 3 1 '#ff0' 'u']}]
        ranges = [[0 0 3 0]]

        sue.rangesWithToggledFlag(ranges areas lines 'b') ▸ [{x: 0 y: 0 value: [34 3 1 '#ff0' 'ub']}]
