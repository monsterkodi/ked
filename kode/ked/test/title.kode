use ../../kxk      ▪ kseg
use ../edit       ◆ editor mode
use ../edit/mode  ◆ novim
use ../edit/tool  ◆ belt
use ../util       ◆ harness
use ../view/title ◆ title
use ../view/base  ◆ crumbs

▸ title

  ▸ the crumbs keep their colors                 # each segment darker and its text dimmer, the last one brighter

        dump = (setup) ->
            h = new harness cols:40 rows:2
            c = new crumbs h.screen 'c'
            c.layout 0 0 24 1
            setup c
            c.set '~/s/ked/kode'
            c.draw()
            chars = ''
            cols  = []
            for x in 0...c.rounded.length
                chars += h.screen.get_char x 0
                cols.push "[#{h.screen.get_fg(x 0).join(' ')}] [#{h.screen.get_bg(x 0).join(' ')}]"
            [chars cols.join(' ')]

        L = ''
        R = ''

        [chars cols] = dump (c) ->
        chars ▸ "#{L}~ #{L}s #{L}ked #{L}kode#{R}"
        cols  ▸ '[18 18 18] [0 0 0] [102 102 191] [18 18 18] [102 102 191] [18 18 18] [23 23 23] [18 18 18] [136 136 255] [23 23 23] [136 136 255] [23 23 23] [28 28 28] [23 23 23] [136 136 255] [28 28 28] [136 136 255] [28 28 28] [136 136 255] [28 28 28] [136 136 255] [28 28 28] [34 34 34] [28 28 28] [204 204 255] [34 34 34] [204 204 255] [34 34 34] [204 204 255] [34 34 34] [204 204 255] [34 34 34] [34 34 34] [0 0 0]'

        [chars cols] = dump (c) -> c.hoverIndex = 1
        cols  ▸ '[18 18 18] [0 0 0] [102 102 191] [18 18 18] [102 102 191] [18 18 18] [68 68 170] [18 18 18] [212 212 255] [68 68 170] [212 212 255] [68 68 170] [28 28 28] [68 68 170] [136 136 255] [28 28 28] [136 136 255] [28 28 28] [136 136 255] [28 28 28] [136 136 255] [28 28 28] [34 34 34] [28 28 28] [204 204 255] [34 34 34] [204 204 255] [34 34 34] [204 204 255] [34 34 34] [204 204 255] [34 34 34] [34 34 34] [0 0 0]'

        [chars cols] = dump (c) -> c.padLast = true
        chars ▸ "#{L}~ #{L}s #{L}ked #{L}kode       #{R}"
        cols  ▸ '[18 18 18] [0 0 0] [102 102 191] [18 18 18] [102 102 191] [18 18 18] [23 23 23] [18 18 18] [136 136 255] [23 23 23] [136 136 255] [23 23 23] [28 28 28] [23 23 23] [136 136 255] [28 28 28] [136 136 255] [28 28 28] [136 136 255] [28 28 28] [136 136 255] [28 28 28] [34 34 34] [28 28 28] [204 204 255] [34 34 34] [204 204 255] [34 34 34] [204 204 255] [34 34 34] [204 204 255] [34 34 34] [204 204 255] [34 34 34] [204 204 255] [34 34 34] [204 204 255] [34 34 34] [204 204 255] [34 34 34] [204 204 255] [34 34 34] [204 204 255] [34 34 34] [204 204 255] [34 34 34] [34 34 34] [0 0 0]'

  ▸ the crumbs show the folder of a file

        h = new harness cols:100 rows:5
        e = new editor h.screen 'test_editor' []
        t = new title h.screen e

        t.setFile '~/s/ked/kode/doesntexist'
        t.layout 0 0 100 1
        t.draw()

        row = h.row 0

        row.includes '~'           ▸ true
        row.includes 'kode'        ▸ true
        row.includes 'doesntexist' ▸ true

  ▸ the novim command line is a text input

        ◯ mode.loaded

        h = new harness cols:80 rows:5
        e = new editor h.screen 'title_novim_editor' []
        t = new title h.screen e

        t.layout 0 0 80 1

        mode.modes.novim = novim
        mode.start e.state 'novim'

        press = (c) ->
            ⮐ true if t.onKey c {combo:c, char:c}
            e.onKey c {combo:c, char:c}

        e.state.loadLines belt.linesForText('one two')
        e.state.setMainCursor 0 0
        e.grabFocus()

        press ':'

        t.titlenovim.input.visible()  ▸ true
        t.titlenovim.input.hasFocus() ▸ true

        for c in 's/one'
            press c

        e.state.s.highlights ▸ [[0 0 3]]

        press '/'

        e.state.s.highlights ▸ [[0 0 3]]

        for c in '1/'
            press c

        press 'return'

        kseg.str(e.state.s.lines)     ▸ '1 two'
        t.titlenovim.input.visible()  ▸ false
        e.state.hasFocus              ▸ true
        e.state.s.highlights          ▸ []

        press ':'
        press 's'
        press 'x'
        press 'delete'

        t.titlenovim.input.current()  ▸ 's'

        press 'esc'

        t.titlenovim.input.visible()  ▸ false
        kseg.str(e.state.s.lines)     ▸ '1 two'

        e.state.loadLines belt.linesForText("a\nb\nc")
        e.state.setMainCursor 0 0
        e.grabFocus()

        press 'V'
        press 'j'
        press ':'

        t.titlenovim.input.current()  ▸ "'<,'>"

        press 'esc'

        t.titlenovim.input.visible()  ▸ false
        e.state.novim.visual          ▸ 'line'

        e.state.stopVisual()
        e.state.loadLines belt.linesForText('aa aa')
        e.state.setMainCursor 0 0
        e.grabFocus()

        press ':'
        for c in '%s/aa/b/gc'
            press c
        press 'return'

        e.state.s.highlights ▸ [[0 0 2] [3 0 5]]
        e.state.s.selections ▸ [[0 0 2 0]]

        press 'n'

        e.state.s.selections ▸ [[3 0 5 0]]

        press 'y'

        kseg.str(e.state.s.lines)     ▸ 'aa b'
        e.state.s.highlights          ▸ []

        e.state.loadLines belt.linesForText("foo bar foo")
        e.state.setMainCursor 0 0
        e.grabFocus()

        press '/'

        t.titlenovim.vinder.visible()  ▸ true
        t.titlenovim.vinder.hasFocus() ▸ true
        t.titlenovim.vinder.current()  ▸ 'foo'
        e.state.s.highlights          ▸ [[0 0 3] [8 0 11]]

        for i in 0...4
            press 'delete'

        t.titlenovim.vinder.current() ▸ ''
        e.state.s.highlights          ▸ []

        press 'b'

        t.titlenovim.vinder.current() ▸ 'b'
        e.state.s.highlights          ▸ [[4 0 5]]

        press 'esc'

        t.titlenovim.vinder.visible() ▸ false
        e.state.s.highlights          ▸ []
        e.state.hasFocus              ▸ true

        e.state.loadLines belt.linesForText("foo\nfoo")
        e.state.setMainCursor 0 0
        e.grabFocus()

        press '/'
        press 'return'

        t.titlenovim.vinder.visible() ▸ false
        e.state.s.highlights          ▸ [[0 0 3] [0 1 3]]
        e.state.hasFocus              ▸ true

        e.state.loadLines belt.linesForText("foo bar foo")
        e.state.setMainCursor 2 0
        e.grabFocus()

        press '/'

        e.state.mainCursor()          ▸ [0 0]

        press 'return'

        e.state.mainCursor()          ▸ [0 0]

        e.state.setMainCursor 0 0
        e.grabFocus()

        press '/'
        press 'return'

        e.state.mainCursor()          ▸ [0 0]

        e.state.loadLines belt.linesForText("alpha beta alpha")
        e.state.setMainCursor 7 0
        e.grabFocus()

        press '/'

        e.state.mainCursor()          ▸ [6 0]

        for c in 'alpha'
            press c
        press 'return'

        e.state.mainCursor()          ▸ [11 0]

        e.state.loadLines belt.linesForText("foo bar foo")
        e.state.setMainCursor 8 0
        e.grabFocus()

        press '/'
        for c in 'bar'
            press c
        press 'return'

        e.state.mainCursor()          ▸ [4 0]

        mode.stop e.state 'novim'

  ▸ reverse search and the match position

        ◯ mode.loaded

        h = new harness cols:80 rows:5
        e = new editor h.screen 'title_reverse_editor' []
        t = new title h.screen e

        t.layout 0 0 80 1

        mode.modes.novim = novim
        mode.start e.state 'novim'

        press = (c) ->
            ⮐ true if t.onKey c {combo:c, char:c}
            e.onKey c {combo:c, char:c}

        e.state.loadLines belt.linesForText("foo\nbar\nfoo\nbar\nfoo")
        e.state.setMainCursor 0 4
        e.grabFocus()

        press '?'

        t.titlenovim.vinder.visible()  ▸ true
        t.titlenovim.vinder.current()  ▸ 'foo'
        e.state.s.highlights          ▸ [[0 0 3] [0 2 3] [0 4 3]]

        press 'return'

        t.titlenovim.vinder.visible()  ▸ false
        e.state.mainCursor()           ▸ [0 4]
        t.titlenovim.novimText         ▸ '3/3'

        press 'n'

        e.state.mainCursor()           ▸ [0 2]
        t.titlenovim.novimText         ▸ '2/3'

        press 'N'

        e.state.mainCursor()           ▸ [0 4]
        t.titlenovim.novimText         ▸ '3/3'

        press 'n'
        press 'n'

        e.state.mainCursor()           ▸ [0 0]
        t.titlenovim.novimText         ▸ '1/3'

        mode.stop e.state 'novim'

  ▸ macro recording indicator

        ◯ mode.loaded

        h = new harness cols:80 rows:5
        e = new editor h.screen 'title_macro_editor' []
        t = new title h.screen e

        t.layout 0 0 80 1

        mode.modes.novim = novim
        mode.start e.state 'novim'

        press = (c) ->
            ⮐ true if t.onKey c {combo:c, char:c}
            e.onKey c {combo:c, char:c}

        e.state.loadLines belt.linesForText("one\ntwo")
        e.state.setMainCursor 0 0
        e.grabFocus()

        press 'q'
        press 'a'

        t.titlenovim.novimText         ▸ 'recording @a'

        press 'q'

        t.titlenovim.novimText         ▸ 'recorded @a'

        mode.stop e.state 'novim'

  ▸ novim history is navigated with up and down

        ◯ mode.loaded

        store = {}
        fakeGet = (key def) -> clone(store[key] ? def)
        fakeSet = (key value) -> store[key] = clone value
        global.ked_session = get:fakeGet set:fakeSet

        h = new harness cols:80 rows:5
        e = new editor h.screen 'title_history_editor' []
        t = new title h.screen e

        t.layout 0 0 80 1

        mode.modes.novim = novim
        mode.start e.state 'novim'

        press = (c) ->
            ⮐ true if t.onKey c {combo:c, char:c}
            e.onKey c {combo:c, char:c}

        e.state.loadLines belt.linesForText('alpha beta alpha')
        e.state.setMainCursor 0 0
        e.grabFocus()

        press '/'
        for c in 'beta'
            press c
        press 'return'

        e.state.setMainCursor 0 0
        e.grabFocus()

        press '/'

        t.titlenovim.vinder.current() ▸ 'alpha'

        press 'up'

        t.titlenovim.vinder.current() ▸ 'beta'

        press 'down'

        t.titlenovim.vinder.current() ▸ 'alpha'

        press 'esc'

        press ':'
        for c in 'foo'
            press c
        press 'return'

        press ':'

        t.titlenovim.input.current() ▸ ''

        press 'up'

        t.titlenovim.input.current() ▸ 'foo'

        press 'down'

        t.titlenovim.input.current() ▸ ''

        press 'esc'

        delete global.ked_session

        mode.stop e.state 'novim'
