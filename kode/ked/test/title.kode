use ../../kxk      ▪ kseg
use ../edit       ◆ editor mode
use ../edit/mode  ◆ novim
use ../edit/tool  ◆ belt
use ../util       ◆ harness
use ../view/title ◆ title

▸ title

  ▸ the crumbs show the folder of a file

        h = new harness cols:100 rows:5
        e = new editor h.screen 'test_editor' []
        t = new title h.screen e

        t.setFile '~/s/ked/kode/doesntexist'
        t.layout 0 0 100 1
        t.draw()

        row = h.row 0

        row.includes '~'           ▸ true
        row.includes 'kode'        ▸ true
        row.includes 'doesntexist' ▸ true

  ▸ the novim command line is a text input

        ◯ mode.loaded

        h = new harness cols:80 rows:5
        e = new editor h.screen 'title_novim_editor' []
        t = new title h.screen e

        t.layout 0 0 80 1

        mode.modes.novim = novim
        mode.start e.state 'novim'

        press = (c) ->
            ⮐ true if t.onKey c {combo:c, char:c}
            e.onKey c {combo:c, char:c}

        e.state.loadLines belt.linesForText('one two')
        e.state.setMainCursor 0 0
        e.grabFocus()

        press ':'

        t.titlenovim.input.visible()  ▸ true
        t.titlenovim.input.hasFocus() ▸ true

        for c in 's/one/1/'
            press c

        press 'return'

        kseg.str(e.state.s.lines)     ▸ '1 two'
        t.titlenovim.input.visible()  ▸ false
        e.state.hasFocus              ▸ true

        press ':'
        press 's'
        press 'x'
        press 'delete'

        t.titlenovim.input.current()  ▸ 's'

        press 'esc'

        t.titlenovim.input.visible()  ▸ false
        kseg.str(e.state.s.lines)     ▸ '1 two'

        e.state.loadLines belt.linesForText("a\nb\nc")
        e.state.setMainCursor 0 0
        e.grabFocus()

        press 'V'
        press 'j'
        press ':'

        t.titlenovim.input.current()  ▸ "'<,'>"

        press 'esc'

        t.titlenovim.input.visible()  ▸ false
        e.state.visual                ▸ 'line'

        e.state.stopVisual()
        e.state.loadLines belt.linesForText('aa aa')
        e.state.setMainCursor 0 0
        e.grabFocus()

        press ':'
        for c in '%s/aa/b/gc'
            press c
        press 'return'

        press 'n'
        press 'y'

        kseg.str(e.state.s.lines)     ▸ 'aa b'

        mode.stop e.state 'novim'
