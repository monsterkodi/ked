use ../../kolor ◆ kulur
use ../theme    ◆ theme
use ../util     ◆ syntax

missing = lines ext filter ->
    clsss = []
    for line in kulur.dissect lines, ext
        for chunk in line
            if filter(chunk.clss) and not syntax.themeColor(chunk.clss)
                clsss.push chunk.clss if chunk.clss not in clsss
    clsss

▸ theme

    ▸ md punct

        lines = [
            "A `code` span, `f(a, b)` and **bold**."
            "- **bold, item** and `code; item` and **`bold code`**"
            "```sh"
            "out=$(mktemp -d)"
            "```"
            ]
        missing(lines, 'md', (c) -> c.startsWith 'punct') ▸ []

    ▸ md files and urls

        lines = [
            '<img src="./img/kode.svg" />'
            'see https://sub.example.com/a/b'
            '<a href="https://example.com/x">'
            ]
        missing(lines, 'md', (c) -> true) ▸ []

    ▸ md headings

        lines = []
        for h in ['#' '##' '###' '####' '#####']
            lines.push h + ' a, (b) `c-d` e'
        lines.push '**a → b**'
        missing(lines, 'md', (c) -> true) ▸ []

    ▸ md unicode

        lines = []
        for h in ['#' '##' '###' '####' '#####']
            lines.push h + ' a ▸ © ↔ α'
        lines.push '`▸ © ↔ α` *▸ ↔ it* **`▸ ↔`** ▸ ✔'
        missing(lines, 'md', (c) -> true) ▸ []

    ▸ unicode fallback

        own = c -> theme.syntax[c]                    # a key's own color wins once the theme has one

        syntax.themeColor('text unicode arrow bold')  ▸ own('text unicode arrow bold') ? own('text unicode bold')
        syntax.themeColor('text unicode box')         ▸ own('text unicode box') ? own('text unicode')
        syntax.themeColor('text unicode greek')       ▸ own('text unicode greek') ? own('text unicode')
        syntax.themeColor('text unicode bold')        ▸ own('text unicode bold')
        syntax.themeColor('text unicode h9')          ▸ undefined
        syntax.themeColor('no such class')            ▸ undefined

        s = new syntax 'test'
        s.getColor('text unicode math code')          ▸ own('text unicode math code') ? own('text unicode code') ? [255 0 0]
        s.getColor('no such class')                   ▸ [255 0 0]
