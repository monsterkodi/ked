use ../../kolor ◆ kulur
use ../theme    ◆ theme

missing = lines ext filter ->
    clsss = []
    for line in kulur.dissect lines, ext
        for chunk in line
            if filter(chunk.clss) and not theme.syntax[chunk.clss]
                clsss.push chunk.clss if chunk.clss not in clsss
    clsss

▸ theme

    ▸ md punct

        lines = [
            "A `code` span, `f(a, b)` and **bold**."
            "- **bold, item** and `code; item` and **`bold code`**"
            "```sh"
            "out=$(mktemp -d)"
            "```"
            ]
        missing(lines, 'md', (c) -> c.startsWith 'punct') ▸ []

    ▸ md files and urls

        lines = [
            '<img src="./img/kode.svg" />'
            'see https://sub.example.com/a/b'
            '<a href="https://example.com/x">'
            ]
        missing(lines, 'md', (c) -> true) ▸ []
