use ../../kxk    ▪ kseg
use ../edit/tool ◆ sue
use ../edit      ◆ editor
use ../util      ◆ harness dumpstate

h = e = null

wed = lines cols=10 rows=6 feats=['susan'] ->
    h = new harness cols:cols rows:rows
    e = new editor h.screen 'test_wrap' feats
    e.layout 0 0 cols rows
    e.state.loadLines lines
    e.grabFocus()

key   = combo -> h.key e combo
mc    = -> e.state.mainCursor()
rows  = -> h.screen.init() ; e.draw() ; h.text().map((r) -> r.trimEnd())
cell  = x y -> e.posCell x y
pos   = x row -> e.state.posForCell x row
wrap  = (s c w i) -> sue.wrapStarts kseg(s) c w i
indent = (s c) -> sue.wrapIndent kseg(s) c

cellsWhere = test ->
    h.screen.init() ; e.draw()
    out = []
    for y in 0...h.rows
        line = ''
        for x in 0...h.cols
            line += test(x y) ? h.at(x y).replace(/\x1b\[[^m]*m/g '') : ' '
        out.push line.trimEnd()
    out

marked = kind -> cellsWhere (x y) -> h.screen.c[y][x].mark == kind
withBg = bg   -> cellsWhere (x y) -> h.screen.get_bg(x y) eql bg

▸ wrap

  ▸ starts

        wrap 'abcdefgh' 3 false   ▸ [0 3 6]
        wrap 'abcdef' 3 false     ▸ [0 3]
        wrap '' 3 false           ▸ [0]
        wrap 'ab漢x' 3 false      ▸ [0 2]
        wrap 'ab cd ef' 4 false   ▸ [0 4]
        wrap 'ab cd ef' 4 true    ▸ [0 3 6]
        wrap 'abcdefgh ij' 4 true ▸ [0 4 8]
        wrap 'a bcdefgh' 4 true   ▸ [0 2 6]
        wrap 'abcdefgh' 4 false 2 ▸ [0 4 6]
        wrap '  ab cd ef' 6 true 2 ▸ [0 5 8]

  ▸ indent

        indent 'abc' 10         ▸ 0
        indent '    abc' 10     ▸ 4
        indent '\t\tabc' 10     ▸ 2
        indent '        abc' 10 ▸ 5
        indent '    ' 10        ▸ 4

  ▸ height

        wed ['0123456789abcdefghijk' 'next']
        e.state.lineHeight 0 ▸ 1
        key 'ctrl+w'
        e.state.lineHeight 0 ▸ 3
        e.state.lineHeight 1 ▸ 1
        e.state.rowOfLine 1 ▸ 3
        e.state.totalRows() ▸ 4
        e.layout 0 0 7 6
        e.state.lineHeight 0 ▸ 3
        e.layout 0 0 5 6
        e.state.lineHeight 0 ▸ 5
        e.layout 0 0 10 6
        e.state.setSue 0 0 [sue.LINE_SCALE -1 1 2]
        e.state.lineScale 0 ▸ 2
        e.state.lineHeight 0 ▸ 10

  ▸ toggle

        wed ['aaaaaaaaaaaa' 'bbbbbbbbbbbb' 'cccccccccccc']
        key 'ctrl+w'
        dumpstate.tags(e.state) ▸ '[dirty] [undo 1] [wrap: 0]'
        e.state.setCursors [[0 0] [0 1]]
        key 'ctrl+w'
        dumpstate.tags(e.state) ▸ '[dirty] [undo 2]'
        key 'ctrl+w'
        dumpstate.tags(e.state).endsWith('[wrap: 0 1]') ▸ true
        e.state.setCursors [[0 2] [0 1]] main:0
        key 'ctrl+w'
        dumpstate.tags(e.state).endsWith('[wrap: 0 1 2]') ▸ true
        e.state.undo()
        dumpstate.tags(e.state).endsWith('[wrap: 0 1]') ▸ true
        key 'alt+w'
        dumpstate.tags(e.state).endsWith('[wrap: all]') ▸ true
        key 'ctrl+w'
        key 'alt+w'
        dumpstate.tags(e.state).endsWith('[wrap: 0 1]') ▸ true
        key 'ctrl+alt+w'
        dumpstate.tags(e.state).endsWith('[wrap: 0 1 word]') ▸ true

  ▸ draw

        wed ['0123456789abcdefghijk' 'next']
        key 'ctrl+w'
        rows() ▸ ['0123456789' 'abcdefghij' 'k' 'next' '' '']
        key 'ctrl+w'
        rows() ▸ ['0123456789' 'next' '' '' '' '']
        wed ['aaa bbb ccc ddd' 'next']
        key 'alt+w'
        rows() ▸ ['aaa bbb cc' 'c ddd' 'next' '' '' '']
        key 'ctrl+alt+w'
        rows() ▸ ['aaa bbb' 'ccc ddd' 'next' '' '' '']

  ▸ scroll

        wed ['0123456789abcdef' 'short']
        e.state.setMainCursor 14 1
        e.state.s.view[0] ▸ 6
        rows() ▸ ['6789abcdef' '' '' '' '' '']
        e.state.setMainCursor 14 0
        key 'ctrl+w'
        e.state.s.view[0] ▸ 0
        rows() ▸ ['0123456789' 'abcdef' 'short' '' '' '']

  ▸ cell

        wed ['0123456789abcdefghijk' 'next']
        key 'ctrl+w'
        cell 0 0  ▸ [0 0]
        cell 9 0  ▸ [9 0]
        cell 10 0 ▸ [0 1]
        cell 20 0 ▸ [0 2]
        cell 21 0 ▸ [1 2]
        cell 30 0 ▸ [9 2]
        cell 2 1  ▸ [2 3]
        pos 0 1   ▸ [10 0]
        pos 4 2   ▸ [24 0]
        pos 0 2   ▸ [20 0]
        pos 1 2   ▸ [21 0]
        pos 3 2   ▸ [23 0]
        pos 9 1   ▸ [19 0]
        pos 2 3   ▸ [2 1]

  ▸ cursor

        wed ['0123456789abcdefghijk' 'next']
        key 'ctrl+w'
        e.state.setMainCursor 12 0
        rows()
        h.placedAt(1 1) ▸ true
        e.state.setMainCursor 2 1
        rows()
        h.placedAt(1 3) ▸ true
        e.isCursorVisible() ▸ true

  ▸ scaled

        wed ['abcdefgh' 'next'] 10 12
        e.state.setSue 0 0 [sue.LINE_SCALE -1 1 2]
        key 'ctrl+w'
        e.state.wrapStarts 0 ▸ [0 5]
        e.state.lineHeight 0 ▸ 4
        cell 6 0 ▸ [2 2]
        pos 3 3 ▸ [6 0]
        e.state.rowOfLine 1 ▸ 4

  ▸ gutter

        wed ['0123456789abcdefghijk' 'next'] 14 6 ['susan' 'gutter']
        e.cells.cols ▸ 10
        key 'ctrl+w'
        rows().map((r) -> r.trim()) ▸ ['1 0123456789' '⮐ abcdefghij' '⮐ k' '2 next' '' '']
        e.layout 0 0 14 2
        e.state.setMainCursor 20 0
        rows().map((r) -> r.trim())[0...2] ▸ ['⮐ abcdefghij' '⮐ k']

  ▸ indented

        wed ['  aaaaaaaaaaaaa' 'next']
        key 'ctrl+w'
        e.state.wrapStarts 0 ▸ [0 10]
        rows() ▸ ['  aaaaaaaa' '  aaaaa' 'next' '' '' '']
        cell 9 0  ▸ [9 0]
        cell 10 0 ▸ [2 1]
        cell 14 0 ▸ [6 1]
        pos 0 1   ▸ [10 0]
        pos 2 1   ▸ [10 0]
        pos 6 1   ▸ [14 0]
        pos 9 1   ▸ [17 0]
        e.state.setSelections [[8 0 12 0]]
        marked('selection')[0...2] ▸ ['        aa' '  aa']
        wed ['  aaa bbb ccc ddd' 'next']
        key 'alt+w'
        key 'ctrl+alt+w'
        rows() ▸ ['  aaa bbb' '  ccc ddd' 'next' '' '' '']

  ▸ tall

        wed ['0123456789abcdefghijABCDEFGHIJklmnopqrstKLMNO' 'next'] 10 3
        key 'ctrl+w'
        e.state.lineHeight 0 ▸ 5
        rows() ▸ ['0123456789' 'abcdefghij' 'ABCDEFGHIJ']
        e.state.setMainCursor 32 0
        rows() ▸ ['abcdefghij' 'ABCDEFGHIJ' 'klmnopqrst']
        e.state.setMainCursor 2 1
        rows() ▸ ['klmnopqrst' 'KLMNO' 'next']
        e.state.setSelections [[25 0 42 0]]
        marked('selection') ▸ ['klmnopqrst' 'KL' '']
        e.state.setMainCursor 0 0
        rows() ▸ ['0123456789' 'abcdefghij' 'ABCDEFGHIJ']

  ▸ selection

        wed ['0123456789abcdefghijk' 'next']
        key 'ctrl+w'
        e.state.setMainCursor 0 1
        e.state.setSelections [[8 0 12 0]]
        marked('selection') ▸ ['        89' 'ab' '' '' '' '']
        e.state.setSelections [[19 0 2 1]]
        marked('selection') ▸ ['' '         j' 'k' ' e' '' '']
        e.state.setSelections [[0 0 4 1]]
        marked('selection')[0...3] ▸ ['0123456789' 'abcdefghij' 'k']

  ▸ highlight

        wed ['0123456789abcdefghijk' 'next']
        key 'ctrl+w'
        e.state.setMainCursor 0 1
        e.state.setHighlights [[9 0 11 0]]
        marked('highlight')[0...2] ▸ ['         9' 'a']

  ▸ yank

        wed ['0123456789abcdefghijk' 'next']
        key 'ctrl+w'
        e.state.setMainCursor 0 1
        e.state.novim.yankFlash = [[18 0 21 0]]
        withBg(e.color.yank)[0...3] ▸ ['' '        ij' 'k']

  ▸ sue

        wed ['0123456789abcdefghijk' 'next'] 10 6 ['susan']
        e.state.setSue 8 0 [sue.BG_COLOR 4 1 '#ff0000']
        key 'ctrl+w'
        e.state.setMainCursor 0 1
        withBg([255 0 0])[0...2] ▸ ['        89' 'ab']

  ▸ edits

        wraps = -> dumpstate.tags(e.state).split('[wrap: ')[1]?.split(']')[0]
        wed ['aaaa bbbb cccc' 'dddd' 'eeee']
        key 'ctrl+w'
        e.state.setMainCursor 4 0
        e.state.insert '\n'
        e.state.s.lines.length ▸ 4
        wraps() ▸ '0'
        e.state.delete 'back'
        e.state.s.lines.length ▸ 3
        wraps() ▸ '0'
        e.state.setMainCursor 0 0
        e.state.insert 'x'
        wraps() ▸ '0'
        e.state.setMainCursor 0 1
        key 'ctrl+w'
        wraps() ▸ '0 1'
        e.state.delete 'back'
        wraps() ▸ '0'
        e.state.setMainCursor 0 1
        key 'ctrl+w'
        e.state.setMainCursor 0 0
        key 'ctrl+w'
        wraps() ▸ '1'
        e.state.setMainCursor 0 1
        e.state.delete 'back'
        wraps() ▸ undefined
        e.state.undo()
        wraps() ▸ '1'
        e.state.setMainCursor 2 1
        e.state.insert 'one\ntwo\nthree'
        e.state.s.lines.length ▸ 4
        wraps() ▸ '1'
        e.state.setMainCursor 0 1
        e.state.insert '\n'
        wraps() ▸ '2'
        e.state.setMainCursor 2 2
        e.state.joinLines()
        wraps() ▸ '2'
