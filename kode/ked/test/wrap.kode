use ../../kxk    ▪ kseg
use ../edit/tool ◆ sue
use ../edit      ◆ editor
use ../util      ◆ harness dumpstate

h = e = null

wed = lines cols=10 rows=6 feats=['susan'] ->
    h = new harness cols:cols rows:rows
    e = new editor h.screen 'test_wrap' feats
    e.layout 0 0 cols rows
    e.state.loadLines lines
    e.grabFocus()

key   = combo -> h.key e combo
mc    = -> e.state.mainCursor()
rows  = -> h.screen.init() ; e.draw() ; h.text().map((r) -> r.trimEnd())
cell  = x y -> e.posCell x y
pos   = x row -> e.state.posForCell x row
wrap  = (s c w) -> sue.wrapStarts kseg(s) c w

▸ wrap

  ▸ starts

        wrap 'abcdefgh' 3 false   ▸ [0 3 6]
        wrap 'abcdef' 3 false     ▸ [0 3]
        wrap '' 3 false           ▸ [0]
        wrap 'ab漢x' 3 false      ▸ [0 2]
        wrap 'ab cd ef' 4 false   ▸ [0 4]
        wrap 'ab cd ef' 4 true    ▸ [0 3 6]
        wrap 'abcdefgh ij' 4 true ▸ [0 4 8]
        wrap 'a bcdefgh' 4 true   ▸ [0 2 6]

  ▸ height

        wed ['0123456789abcdefghijk' 'next']
        e.state.lineHeight 0 ▸ 1
        key 'ctrl+w'
        e.state.lineHeight 0 ▸ 3
        e.state.lineHeight 1 ▸ 1
        e.state.rowOfLine 1 ▸ 3
        e.state.totalRows() ▸ 4
        e.layout 0 0 7 6
        e.state.lineHeight 0 ▸ 3
        e.layout 0 0 5 6
        e.state.lineHeight 0 ▸ 5
        e.layout 0 0 10 6
        e.state.setSue 0 0 [sue.LINE_SCALE -1 1 2]
        e.state.lineScale 0 ▸ 2
        e.state.lineHeight 0 ▸ 10

  ▸ toggle

        wed ['aaaaaaaaaaaa' 'bbbbbbbbbbbb' 'cccccccccccc']
        key 'ctrl+w'
        dumpstate.tags(e.state) ▸ '[dirty] [undo 1] [wrap: 0]'
        e.state.setCursors [[0 0] [0 1]]
        key 'ctrl+w'
        dumpstate.tags(e.state) ▸ '[dirty] [undo 2]'
        key 'ctrl+w'
        dumpstate.tags(e.state).endsWith('[wrap: 0 1]') ▸ true
        e.state.setCursors [[0 2] [0 1]] main:0
        key 'ctrl+w'
        dumpstate.tags(e.state).endsWith('[wrap: 0 1 2]') ▸ true
        e.state.undo()
        dumpstate.tags(e.state).endsWith('[wrap: 0 1]') ▸ true
        key 'alt+w'
        dumpstate.tags(e.state).endsWith('[wrap: all]') ▸ true
        key 'ctrl+w'
        key 'alt+w'
        dumpstate.tags(e.state).endsWith('[wrap: 0 1]') ▸ true
        key 'ctrl+alt+w'
        dumpstate.tags(e.state).endsWith('[wrap: 0 1 word]') ▸ true

  ▸ draw

        wed ['0123456789abcdefghijk' 'next']
        key 'ctrl+w'
        rows() ▸ ['0123456789' 'abcdefghij' 'k' 'next' '' '']
        key 'ctrl+w'
        rows() ▸ ['0123456789' 'next' '' '' '' '']
        wed ['aaa bbb ccc ddd' 'next']
        key 'alt+w'
        rows() ▸ ['aaa bbb cc' 'c ddd' 'next' '' '' '']
        key 'ctrl+alt+w'
        rows() ▸ ['aaa bbb' 'ccc ddd' 'next' '' '' '']

  ▸ scroll

        wed ['0123456789abcdef' 'short']
        e.state.setMainCursor 14 1
        e.state.s.view[0] ▸ 6
        rows() ▸ ['6789abcdef' '' '' '' '' '']
        e.state.setMainCursor 14 0
        key 'ctrl+w'
        e.state.s.view[0] ▸ 0
        rows() ▸ ['0123456789' 'abcdef' 'short' '' '' '']

  ▸ cell

        wed ['0123456789abcdefghijk' 'next']
        key 'ctrl+w'
        cell 0 0  ▸ [0 0]
        cell 9 0  ▸ [9 0]
        cell 10 0 ▸ [0 1]
        cell 20 0 ▸ [0 2]
        cell 21 0 ▸ [1 2]
        cell 30 0 ▸ [9 2]
        cell 2 1  ▸ [2 3]
        pos 0 1   ▸ [10 0]
        pos 4 2   ▸ [24 0]
        pos 0 2   ▸ [20 0]
        pos 1 2   ▸ [21 0]
        pos 3 2   ▸ [23 0]
        pos 9 1   ▸ [19 0]
        pos 2 3   ▸ [2 1]

  ▸ cursor

        wed ['0123456789abcdefghijk' 'next']
        key 'ctrl+w'
        e.state.setMainCursor 12 0
        rows()
        h.placedAt(1 1) ▸ true
        e.state.setMainCursor 2 1
        rows()
        h.placedAt(1 3) ▸ true
        e.isCursorVisible() ▸ true

  ▸ scaled

        wed ['abcdefgh' 'next'] 10 12
        e.state.setSue 0 0 [sue.LINE_SCALE -1 1 2]
        key 'ctrl+w'
        e.state.wrapStarts 0 ▸ [0 5]
        e.state.lineHeight 0 ▸ 4
        cell 6 0 ▸ [2 2]
        pos 3 3 ▸ [6 0]
        e.state.rowOfLine 1 ▸ 4

  ▸ gutter

        wed ['0123456789abcdefghijk' 'next'] 14 6 ['susan' 'gutter']
        e.cells.cols ▸ 10
        key 'ctrl+w'
        rows().map((r) -> r.trim()) ▸ ['1 0123456789' 'abcdefghij' 'k' '2 next' '' '']
