        wrapped '> - aaaaaaaaaa' 'md'               ▸ ['> - aaaaaa' '    aaaa']
        wrapped '- [ ] aaaaaaaaaaaa' 'md' 12        ▸ ['- [ ] aaaaaa' '      aaaaaa']
        wrapped 'aaaa aaaaaaaa' 'md'                ▸ ['aaaa' 'aaaaaaaa']
        wrapped '# aaaaaaaaaaa' 'kode'              ▸ ['# aaaaaaaa' '  aaa']
