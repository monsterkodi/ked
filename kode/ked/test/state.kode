    # ███████    ████████  ███████        ███   ███  ███   ███  ███   ███   ███████   ████████  ███████   
    
    ▸ deleteRanges
    
        text = """
            line 1
            line 2
            line 3
            """
            
        s.loadLines belt.linesForText(text)
        s.deleteRanges [[0 0 2 0]] 
        
        txt """
            ne 1
            line 2
            line 3
            """
            
        s.deleteRanges [[2 0 2 1]]

        txt """
            nene 2
            line 3
            """
            
        s.deleteRanges [[6 0 0 1]]

        txt """
            nene 2line 3
            """
        
