###
    funcol

    the color picker reads a color from the editor and
    replaces it when the picker is submitted
###

use ../../kxk       ▪ kseg
use ../edit         ◆ editor
use ../util         ◆ harness
use ../view/colmns  ◆ funcol

▸ funcol color picker

    ▸ an empty show picks the color under the cursor

        store = {}
        fakeGet = (key def) -> store[key] ? def
        fakeSet = (key value) -> store[key] = value
        global.ked_session = get:fakeGet set:fakeSet

        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['x = #ff8000;']
        e.state.setMainCursor 6 0

        f = new funcol h.screen e []

        f.onColorPickerShow ''

        f.colorpicker.hex() ▸ '#ff8000'
        f.colorReplace.text ▸ '#ff8000'
        f.colorReplace.range ▸ [4 0 11 0]

        delete global.ked_session

    ▸ a cursor on the hash picks the color

        store = {}
        fakeGet = (key def) -> store[key] ? def
        fakeSet = (key value) -> store[key] = value
        global.ked_session = get:fakeGet set:fakeSet

        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['x = #ff8000;']
        e.state.setMainCursor 4 0

        f = new funcol h.screen e []

        f.onColorPickerShow ''

        f.colorpicker.hex() ▸ '#ff8000'

        delete global.ked_session

    ▸ a word that is not a color keeps the default and no replace mode

        store = {}
        fakeGet = (key def) -> store[key] ? def
        fakeSet = (key value) -> store[key] = value
        global.ked_session = get:fakeGet set:fakeSet

        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['x = hello;']
        e.state.setMainCursor 6 0

        f = new funcol h.screen e []

        f.onColorPickerShow ''

        f.colorpicker.hex() ▸ '#ff0000'
        f.colorReplace ▸ null

        delete global.ked_session

    ▸ submitting replaces the original color

        store = {}
        fakeGet = (key def) -> store[key] ? def
        fakeSet = (key value) -> store[key] = value
        global.ked_session = get:fakeGet set:fakeSet

        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['x = #ff8000;']
        e.state.setMainCursor 6 0

        f = new funcol h.screen e []

        f.onColorPickerShow ''
        f.onColorPickerSubmit '#00ff00'

        kseg.str(e.state.s.lines[0]) ▸ 'x = #00ff00;'
        f.colorReplace ▸ null

        delete global.ked_session

    ▸ a short color is replaced with the full hex

        store = {}
        fakeGet = (key def) -> store[key] ? def
        fakeSet = (key value) -> store[key] = value
        global.ked_session = get:fakeGet set:fakeSet

        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['c = #abc;']
        e.state.setMainCursor 6 0

        f = new funcol h.screen e []

        f.onColorPickerShow ''

        f.colorReplace.text ▸ '#abc'

        f.onColorPickerSubmit '#ff0000'

        kseg.str(e.state.s.lines[0]) ▸ 'c = #ff0000;'

        delete global.ked_session

    ▸ submitting without changes keeps the original color string

        store = {}
        fakeGet = (key def) -> store[key] ? def
        fakeSet = (key value) -> store[key] = value
        global.ked_session = get:fakeGet set:fakeSet

        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['c = #abc;']
        e.state.setMainCursor 6 0

        f = new funcol h.screen e []

        f.onColorPickerShow ''

        f.onColorPickerSubmit f.colorpicker.hex()

        kseg.str(e.state.s.lines[0]) ▸ 'c = #abc;'
        f.colorReplace ▸ null

        delete global.ked_session

    ▸ an explicit show does not replace anything

        store = {}
        fakeGet = (key def) -> store[key] ? def
        fakeSet = (key value) -> store[key] = value
        global.ked_session = get:fakeGet set:fakeSet

        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['x = #ff8000;']
        e.state.setMainCursor 6 0

        f = new funcol h.screen e []

        f.onColorPickerShow '#123456'

        f.colorReplace ▸ null

        f.onColorPickerSubmit '#abcdef'

        kseg.str(e.state.s.lines[0]) ▸ 'x = #ff8000;'

        delete global.ked_session

    ▸ a selection without a color literal becomes a color selection

        store = {}
        fakeGet = (key def) -> store[key] ? def
        fakeSet = (key value) -> store[key] = value
        global.ked_session = get:fakeGet set:fakeSet

        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['hello world']
        e.state.setSelections [[0 0 5 0]]
        e.state.setMainCursor 2 0

        f = new funcol h.screen e []

        f.onColorPickerShow ''

        f.colorReplace ▸ null
        f.colorDecorate.ranges ▸ [[0 0 5 0]]

        f.onColorPickerSubmit '#ff0000'

        e.state.s.colors.fg ▸ [[0 0 5 '#ff0000']]
        f.colorDecorate ▸ null

        delete global.ked_session

    ▸ a color literal wins over a selection

        store = {}
        fakeGet = (key def) -> store[key] ? def
        fakeSet = (key value) -> store[key] = value
        global.ked_session = get:fakeGet set:fakeSet

        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['x = #ff8000;']
        e.state.setSelections [[4 0 11 0]]
        e.state.setMainCursor 6 0

        f = new funcol h.screen e []

        f.onColorPickerShow ''

        f.colorDecorate ▸ null
        f.colorReplace.text ▸ '#ff8000'

        f.onColorPickerSubmit '#00ff00'

        kseg.str(e.state.s.lines[0]) ▸ 'x = #00ff00;'
        e.state.s.colors.fg ▸ []

        delete global.ked_session

    ▸ a selection color seeds the picker

        store = {}
        fakeGet = (key def) -> store[key] ? def
        fakeSet = (key value) -> store[key] = value
        global.ked_session = get:fakeGet set:fakeSet

        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['hello world']
        e.state.setSelections [[0 0 5 0]]
        e.state.setMainCursor 2 0
        e.state.setColorsForRanges [[0 0 5 0]] '#00ff00' null

        f = new funcol h.screen e []

        f.onColorPickerShow ''

        f.colorpicker.hex() ▸ '#00ff00'

        delete global.ked_session

    ▸ a selection keeps its existing background when only the foreground changes

        store = {}
        fakeGet = (key def) -> store[key] ? def
        fakeSet = (key value) -> store[key] = value
        global.ked_session = get:fakeGet set:fakeSet

        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['hello world']
        e.state.setSelections [[0 0 5 0]]
        e.state.setMainCursor 2 0
        e.state.setColorsForRanges [[0 0 5 0]] '#00ff00' '#0000ff'

        f = new funcol h.screen e []

        f.onColorPickerShow ''

        f.colorpicker.foregroundHex() ▸ '#00ff00'
        f.colorpicker.backgroundHex() ▸ '#0000ff'
        f.colorpicker.backgroundChanged() ▸ false

        f.onColorPickerSubmit '#00ff00'

        e.state.s.colors.fg ▸ [[0 0 5 '#00ff00']]
        e.state.s.colors.bg ▸ [[0 0 5 '#0000ff']]

        delete global.ked_session

    ▸ a changed background is applied on submit

        store = {}
        fakeGet = (key def) -> store[key] ? def
        fakeSet = (key value) -> store[key] = value
        global.ked_session = get:fakeGet set:fakeSet

        h = new harness cols:100 rows:30
        e = new editor h.screen 'test_editor' []
        e.state.loadLines ['hello world']
        e.state.setSelections [[0 0 5 0]]
        e.state.setMainCursor 2 0

        f = new funcol h.screen e []

        f.onColorPickerShow ''

        f.colorpicker.setActiveColor 1
        f.colorpicker.setHex '#0000ff'

        f.colorpicker.backgroundChanged() ▸ true

        f.onColorPickerSubmit f.colorpicker.foregroundHex()

        e.state.s.colors.fg ▸ [[0 0 5 '#ff0000']]
        e.state.s.colors.bg ▸ [[0 0 5 '#0000ff']]

        delete global.ked_session
