###
███      ████████  ███   ███  ████████  ████████
███      ███        ███ ███   ███       ███   ███
███      ███████     █████    ███████   ███████
███      ███        ███ ███   ███       ███   ███
███████  ████████  ███   ███  ████████  ███   ███
###

use ../kxk ◆ noon kstr slash
use ../kxk/util ▪ pullIf 

Patterns = 
    ws: "[ \\t]+"
    nl: "[ \\t]*\\r?\\n"
    comment: "\\#\\#\\#(?:.|\\n)*?\\#\\#\\#|\\#.*"
    num: "0x[a-fA-F\\d]+|0o[0-7]+|0b[0-1]+|[0-9]+n|[0-9]+\\.[0-9]+|[0-9]+e[-\\+]?[0-9]+|[1-9][0-9]*|0|\\-?Infinity"
    triple: "\"\"\"(?:.|\\n)*?\"\"\""
    double: "\"(?:\\\\.|\\#\\{[^\\}]*}|[^\\n\\\\\"])*\""
    single: "'(?:\\\\['\\\\]|[^\\n'])*'"
    regex: "(?<!\\d\\s*)\\/(?:\\\\[\\/]|\\([^\\n\\s]*\\)|[^\\n\\s\\)])*\\/[gimsuy]*(?!\\s*\\d)"
    dots: "(?<!\\.)\\.\\.\\.?(?!\\.)"
    paren: "[\\(\\)\\[\\]\\{\\}]"
    func: "(○->|○=>|->|=>)"
    then: "➜"
    this: "@"
    test: "(?<!●)▸[\\s\\n]+"
    profile: "●▸"
    profilend: "●▪"
    prof: "●"
    await: "○"
    assert: "▴"
    down: "▾"
    left: "◂"
    right: "▸"
    use: "▪"
    square: "■"
    diamond: "◆"
    return: "⮐"
    op: "(\\band\\b|\\bor\\b|\\bnot\\b|\\*\\*|\\+\\+|--|==|!=|>=|<=|\\+=|-=|\\*=|\\/=|\\|=|\\^=|\\?=|\\&=|%=|<<|>>>|>>|=|\\*|\\/|\\+|-|%|\\^|~|\\&|\\||<|>|\\beql\\b|\\bnew\\b|\\bis\\b|\\binstanceof\\b|\\bdelete\\b|\\bnoon\\b|\\bcopy\\b|\\bclone\\b)"
    punct: "[,:;!&~\\|\\.\\?\\\\]"
    bool: "(\\byes\\b|\\bno\\b|\\btrue\\b|\\bfalse\\b)"
    keyword: [
        "if"
        "then"
        "else"
        "for"
        "each"
        "break"
        "await"
        "return"
        "continue"
        "switch"
        "while"
        "when"
        "is"
        "in"
        "of"
        "class"
        "super"
        "extends"
        "try"
        "catch"
        "throw"
        "finally"
        "function"
        "require"
        "import"
        "export"
        "from"
        "typeof"
        "empty"
        "valid"
        "dbg"
        "log"
        "warn"
        "error"
        "clamp"
        "int"
        "float"
        "floor"
        "ceil"
        "round"
        "first"
        "last"
        "lpad"
        "rpad"
        "trim"
        "ltrim"
        "rtrim"
        "use"
        "min"
        "max"
        "abs"
    ]
    "var": "[▸a-zA-Z_$][a-zA-Z0-9_$]*"

# operators that are javascript's and not kode's. none of them is in
# Patterns.op, so the lexer makes two or three tokens out of each and the
# renderer puts them back together with a space in the wrong place -
# 'a === b' came out as 'a === =\nb' and node stopped there.
#
# twelve of them are the javascript spelling of an operator kode has under
# another name, and the renderer already emits the javascript one: 'a == b'
# renders as 'a === b' and 'a and b' renders as 'a && b'. so these are not
# broken kode that needs fixing - they are a second spelling for something
# that already works, and the message says so and names the spelling to use.
#
# the value is what to write instead, and empty where there is none: '<<=' is
# '<<' and '=' that javascript joins and kode does not, and there is nothing
# to write instead of it.
#
# '&^' is not a javascript operator at all - it is go's 'and not' - so it
# gets its own wording. 'a &^ b' was rendering as 'a & ^ b', which node
# reads as 'a & (~b)': valid, and not what anyone meant.
#
# this is a module-level name and not a property because a bare assignment
# inside the class body does not become one - jsOnlyError below came back
# undefined that way.

jsOnly =
    '===':  '=='
    '!==':  '!='
    '&&':   'and'
    '||':   'or'
    '<<=':  ''
    '>>=':  ''
    '>>>=': ''
    '&&=':  ''
    '||=':  ''
    '**=':  ''
    '&^':   ''

class Lexer

    @: @kode ->

        @debug    = @kode.args.debug
        @verbose  = @kode.args.verbose
        @raw      = @kode.args.raw
        @regs     = []
        
        for key,pat of Patterns
            
            if 
                pat is 'string'
                    @regs.push [key new RegExp(pat)]
                    
                pat is Array
                    
                    pat = pat.map (p) -> kstr.escapeRegexp "#{p}"
                    reg = '\\b(' + pat.join('|') + ')\\b'
                    @regs.push [key new RegExp(reg)]
                    
    onError: msg info -> 
    
        @kode.onError msg info

    # the message for an op match that is really the start of a longer one.
    # text is the whole rest of the source, still including what matched, so
    # '===' is caught on the '==' that Patterns.op did match.

    jsOnlyError: matched text ->

        for op, alt of jsOnly
            if text.startsWith(op) and matched != op
                if op == '&^'
                    ⮐ '&^ is not a javascript operator'
                if alt
                    ⮐ "#{op} is not a kode operator - #{alt} is"
                ⮐ "#{op} is not a kode operator"

        ''
        
    # █████████   ███████   ███   ███  ████████  ███   ███  ███  ███████  ████████
    #    ███     ███   ███  ███  ███   ███       ████  ███  ███     ███   ███
    #    ███     ███   ███  ███████    ███████   ███ █ ███  ███    ███    ███████
    #    ███     ███   ███  ███  ███   ███       ███  ████  ███   ███     ███
    #    ███      ███████   ███   ███  ████████  ███   ███  ███  ███████  ████████

    ###
        converts text into a list of token objects
        token object:
            type: string        # any of the keys in Patterns
            text: string        # text of match
            line: number        # line number
            col:  number        # start index in line
    ###

    tokenize: text ->

        linetokens = []
        tokens = []
        line = 1
        col = 0
        while text.length
            before = text.length
            for [key,reg] in @regs
                match = text.match reg
                if match?.index == 0

                    value = if key == 'nl' then '' else match[0]
                    
                    # simple substitution ➜ then ⮐ return. the text is
                    # rewritten, but the source is not: a column counts the
                    # characters that were there, not the ones left over
                    
                    if key == 'then'   ➜ value = 'then';   key = 'keyword'
                    if key == 'return' ➜ value = 'return'; key = 'keyword'

                    # an op that is really the front of a longer one kode does
                    # not have. caught here because this is the only place
                    # that still knows what was written next to what

                    if key == 'op'
                        if m = @jsOnlyError match[0], text
                            @onError m tok:{ type:key text:value line:line col:col }
                        
                    if value == 'then' and tokens[-2]?.text == 'else' 
                        # skip then after else
                    else
                        token = type:key text:value line:line col:col
                        tokens.push token
                        linetokens.push token

                    if  
                        key == 'nl'
                            
                            col = 0
                            linetokens = []
                            line++
                            
                        key in ['comment''triple']
                            
                            lines = value.split '\n'
                            line += lines.length-1
                            if lines.length > 1 ➜ col = lines[-1].length
                                                ➜ col += value.length

                        key == 'test'
                            if not tokens[-2]? or tokens[-2].type == 'nl' or tokens[-2].type == 'ws' and tokens[-3]?.type == 'nl'
                                end = text.indexOf '\n'
                                end = text.length if end < 0
                                txt = trim text[1...end]
                                tokens[-1].type = 'section'
                                tokens[-1].text = txt
                                if end >= text.length then text = '' else text = text[end..]
                                break
                            else
                                tokens[-1].type = 'op'
                                tokens[-1].text = trim tokens[-1].text ' \n'
                                
                                # the ▸ took the space behind it with it,
                                # and sometimes the newline as well
                                
                                lines = match[0].split '\n'
                                line += lines.length-1
                                if lines.length > 1 ➜ col = lines[-1].length
                                                    ➜ col += match[0].length
                                
                        key.startsWith('prof') and empty pullIf(linetokens, (t) -> t.text != 'use')
                        
                            ni  = text.indexOf '\n'
                            si  = text.indexOf ';'
                            if  
                                ni >= 0 and si >= 0 ➜ end = min ni, si 
                                ni >= 0             ➜ end = ni
                                si >= 0             ➜ end = si
                                                    ➜ end = text.length
                                                    
                            txt = trim text[tokens[-1].text.length...end]
                            tokens[-1].id = txt
                            if end >= text.length then text = '' else text = text[end..]
                            break
                        ➜  
                            col += match[0].length

                    text = text[match[0].length..-1]
                    break

            after = text.length
            if before == after
                @onError "stray character #{text[0]} at column #{col}" tok:last(tokens)
                ⮐ 
        tokens
        
    # █████████  ████████   ███  ████████   ███████    ████████  ███   ███  █████████  
    #    ███     ███   ███  ███  ███   ███  ███   ███  ███       ████  ███     ███     
    #    ███     ███████    ███  ████████   ███   ███  ███████   ███ █ ███     ███     
    #    ███     ███   ███  ███  ███        ███   ███  ███       ███  ████     ███     
    #    ███     ███   ███  ███  ███        ███████    ████████  ███   ███     ███     
    
    # left trims triple strings
    
    tripdent: tokens ->
        
        for tok in tokens
            
            if tok.type != 'triple' then continue
            
            splt = tok.text[3...-3].split '\n'
            
            if splt.length < 2 then continue
            
            # where each line of the body stands in the source. what comes
            # out of here is re-indented, and anything that reads positions
            # back out of it - a source map - has to know by how much: the
            # entry holds the line, and the column the line starts at, so a
            # line that loses n characters of indent gains n on the column.
            
            org = [[tok.line, tok.col+3]]
            
            for i in 1...splt.length ➜ org.push [tok.line+i, 0]
            
            if splt.length == 2
                
                if empty trim splt[1]
                    org.pop()
                    tok.text = '"""' + splt[0] + '"""'
                else
                    org[1][1] += kstr.lcnt splt[1], ' '
                    tok.text = '"""' + splt[0] + '\n' + kstr.lstrip(splt[1]) + '"""'
                    
            else
                
                if trim(splt[0]) == '' and splt.length > 2
                    splt.shift()
                    org.shift()
                
                if trim(splt[-1]) == ''
                    splt.pop()
                    org.pop()
                
                if splt.length == 1
                    org[0][1] += kstr.lcnt splt[0], ' '
                    tok.text = '"""' + kstr.lstrip(splt[0]) + '"""'
                else
                    minind = Math.min.apply 0 splt.map((s) -> if empty(trim(s)) then Infinity else kstr.lcnt(s ' '))
                    
                    if Infinity > minind > 0
                        splt = splt.map (s) -> s[minind..]
                        org  = org.map ([l,c]) -> [l, c+minind]
                    
                    tok.text = '"""' + splt.join('\n') + '"""'
            
            tok.org = org
        
        tokens

    # ███   ███  ███   ███   ███████  ███       ███████    ███████  ███   ███
    # ███   ███  ████  ███  ███       ███      ███   ███  ███       ███   ███
    # ███   ███  ███ █ ███  ███████   ███      █████████  ███████   █████████
    # ███   ███  ███  ████       ███  ███      ███   ███       ███  ███   ███
    #  ███████   ███   ███  ███████   ███████  ███   ███  ███████   ███   ███

    # joins lines that end with '\'

    unslash: tokens ->

        newTokens = []

        idx = 0
        while idx < tokens.length
            tok = tokens[idx]
            if tok.text == '\\'
                idx += 1
                while tokens[idx] and tokens[idx].type in ['nl' 'ws']
                    idx += 1
            else
                newTokens.push tok
                idx += 1

        newTokens
        
    # ██     ██  ████████  ████████    ███████   ████████   ███████   ████████   
    # ███   ███  ███       ███   ███  ███        ███       ███   ███  ███   ███  
    # █████████  ███████   ███████    ███  ████  ███████   ███   ███  ████████   
    # ███ █ ███  ███       ███   ███  ███   ███  ███       ███   ███  ███        
    # ███   ███  ████████  ███   ███   ███████   ████████   ███████   ███        
    
    # joins lines that end with operators that operate on a left hand side
    
    mergeop: tokens ->

        newTokens = []

        idx = 0
        while idx < tokens.length
            tok = tokens[idx]
            if tok.type == 'op' and tok.text not in ['--''++''=''clone''copy''delete''new''is''instanceof''noon''last''first']
                newTokens.push tok
                idx += 1
                while tokens[idx]?.type in ['nl' 'ws']
                    idx += 1
            else
                newTokens.push tok
                idx += 1

        newTokens
        
    # ███   ███  ███   ███   ███████   ███████   ██     ██  ██     ██  ████████  ███   ███  █████████  
    # ███   ███  ████  ███  ███       ███   ███  ███   ███  ███   ███  ███       ████  ███     ███     
    # ███   ███  ███ █ ███  ███       ███   ███  █████████  █████████  ███████   ███ █ ███     ███     
    # ███   ███  ███  ████  ███       ███   ███  ███ █ ███  ███ █ ███  ███       ███  ████     ███     
    #  ███████   ███   ███   ███████   ███████   ███   ███  ███   ███  ████████  ███   ███     ███     
    
    # TODO: keep the swallowed tokens and reinsert them after parsing
    
    uncomment: tokens ->
        
        newTokens = []

        idx = 0
        while idx < tokens.length
            tok = tokens[idx]
            if tok.type == 'comment'
                # if not (tokens[idx-1]?.type == 'nl' or tokens[idx-2]?.type == 'nl' and tokens[idx-1]?.type == 'ws')
                idx += 1
                continue

            newTokens.push tok
            idx += 1

        newTokens
        
    # ███████    ███       ███████    ███████  ███   ███  ███  ████████  ███   ███
    # ███   ███  ███      ███   ███  ███       ███  ███   ███  ███        ███ ███
    # ███████    ███      ███   ███  ███       ███████    ███  ██████      █████
    # ███   ███  ███      ███   ███  ███       ███  ███   ███  ███          ███
    # ███████    ███████   ███████    ███████  ███   ███  ███  ███          ███

    ###
        converts list of tokens into tree of blocks
        block:
            type:  'block'
            tokens: array           # tokens of the block
            indent: string          # indentation string
            line:   number          # first line number
            col:    number

        ws tokens and empty lines are pruned from the tree
        nl tokens are only kept between lines of the same block
    ###

    blockify: tokens ->

        tokens = @tripdent  tokens
        tokens = @unslash   tokens
        tokens = @uncomment tokens
        tokens = @mergeop   tokens

        blocks = []

        block = type:'block' tokens:[] indent:'' line:1 col:0
        blocks.push block

        outdentTo = depth line ->
            
            while depth < block.indent.length
                blocks.pop()
                block = blocks[-1]

        for idx in 0...tokens.length
            
            tok = tokens[idx]
            
            if 
                tok.type == 'nl'

                    nxt = tokens[idx+1]
                    
                    if nxt?.type in ['nl'] ➜ continue
    
                    if  
                        nxt?.type == 'ws'
    
                            if tokens[idx+2]?.type == 'nl' or idx+1 >= tokens.length-1 ➜ continue
        
                            if 
                                nxt.text.length > block.indent.length
        
                                    block = type:'block' tokens:[] line:nxt.line indent:nxt.text col:nxt.text.length
                                    blocks[-1].tokens.push block
                                    blocks.push block
                                    continue
        
                                nxt.text.length < block.indent.length
                                    
                                    outdentTo nxt.text.length nxt.line
                            
                        nxt
                            if block.indent.length ➜ outdentTo 0 nxt.line

                tok.type == 'ws'
                    continue

            block.tokens.push tok

        blocks[0]

# Patterns rides along on the class so a test can build its corpus out of
# the same token set the lexer knows about, instead of a copy that goes
# stale when a keyword is added. Attaching it here rather than exporting it
# as a second name keeps the default export the class itself.

Lexer.Patterns = Patterns

export Lexer
