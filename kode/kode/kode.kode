###
███   ███   ███████   ███████    ████████
███  ███   ███   ███  ███   ███  ███
███████    ███   ███  ███   ███  ███████
███  ███   ███   ███  ███   ███  ███
███   ███   ███████   ███████    ████████
###

use ../kxk ◆ slash karg ansi nfs
use ◆ lexer print parser scoper stripol returner operator renderer
use ../kolor ◆ kolor

class Kode

    @: @args ->
        
        @args ?= {}
        @args.header ?= true
        @version  = '0.2.0'
        @literals = ['bool''num''regex''single''double''triple']
        @atoms    = @literals.concat ['var']

        @lexer    = new lexer    @
        @parser   = new parser   @
        @scoper   = new scoper   @
        @stripol  = new stripol  @
        @returner = new returner @
        @operator = new operator @
        @renderer = new renderer @
        
    # ████████  ████████   ████████    ███████   ████████   
    # ███       ███   ███  ███   ███  ███   ███  ███   ███  
    # ███████   ███████    ███████    ███   ███  ███████    
    # ███       ███   ███  ███   ███  ███   ███  ███   ███  
    # ████████  ███   ███  ███   ███   ███████   ███   ███  
    
    # the error report, in the shape a compiler should hand one back:
    #
    #     ~/s/ked/kode/x.kode:14
    #     a = foo(
    #                ^
    #     explicit call is missing closing bracket )
    #
    # the file line is a terminal hyperlink, the source line is syntax
    # highlighted and linked to the same place, and the ^ sits under the
    # column the parser actually choked on. no line number on the source
    # line: the file:line above already carries it, and repeating it only
    # lets the two drift apart when one of them is wrong.
    #
    # info is whatever the call site had to hand - a token, {tok:..},
    # {tokens:[..]} or {line:..} - which is all of them, across the lexer,
    # the parser and the renderer.

    onError: msg info =>

        # dig a token out of whatever shape info arrived in. when there is
        # none - end of input, most of the time - fall back to the end of
        # the last line, so an unclosed paren points at the paren instead
        # of printing a bare filename with nothing under it.

        tok = null

        if valid info?.tokens and info.tokens.length
            tok = info.tokens[0]
        else if valid info?.tok
            tok = info.tok
        else if valid info?.line or valid info?.col
            tok = info

        lines = @text.split /\r?\n/

        li = null
        ci = null

        if valid tok?.line and tok.line > 0 and tok.line <= lines.length
            li = tok.line
            ci = tok.col

        if not valid li
            li = lines.length
            ci = lines[-1].length

        afile = slash.absolute slash.path(@file), process.cwd()

        # the url keeps the full path, since ~ would not resolve, and it
        # carries the line so the click lands where the error is
        url = "file://#{afile}:#{li}"

        message = bold(m5(slash.tilde(afile))) + m5(':') + m5(li)
        message += '\n' + ansi.link(url, @caret(lines[li-1], ci))
        message += '\n' + R2(y6(msg))

        throw message

    # the source line and the ^ under it, as one string, so that a single
    # hyperlink can cover both without splitting the escape sequence in two

    caret: text col ->

        hi = if text then kolor.kolorizeChunks kolor.ranges(text) else ''

        # col is a character offset, but ^ has to land under the same
        # character on screen, so tabs ahead of it count for what they
        # print as. characters the terminal draws double width are not
        # accounted for - the line is left long and uncropped on purpose,
        # so the marker stays next to the source it belongs to.

        if valid col

            pad = ''
            for ch in (text ? '')[0...col]
                pad += if ch == '\t' then ' '.repeat 8 - pad.length % 8
                      else ' '

            hi += "\n#{pad}^"

        hi

    # ████████  ███   ███   ███████   ███
    # ███       ███   ███  ███   ███  ███
    # ███████    ███ ███   █████████  ███
    # ███          ███     ███   ███  ███
    # ████████      █      ███   ███  ███████

    eval: text file glob ->

        ⮐ if empty text
        
        js = @compile text file
        eval js
        
    ###
     ███████   ███████   ██     ██  ████████   ███  ███      ████████
    ███       ███   ███  ███   ███  ███   ███  ███  ███      ███
    ███       ███   ███  █████████  ████████   ███  ███      ███████
    ███       ███   ███  ███ █ ███  ███        ███  ███      ███
     ███████   ███████   ███   ███  ███        ███  ███████  ████████
     
    converts a string of kode into a string of javascript
    
    throws on syntax errors and internal lexer, parser or renderer errors
    ###

    @compile: text opt={} -> (new Kode(opt)).compile text
    
    compile: @text @file @target ->

        ⮐  '' if empty trim @text
        
        log @text if @args.verbose

        try
            ast = @ast @text
            @renderer.render ast, @file, @target
        catch err
            msg = ""
            if err is str
                # msg += "[syntax error]\n"
                msg += err
            else
                msg += "[internal kode compiler error]\n"
                if valid err.stack
                    msg += err.stack
                else
                    msg += err.message
                msg += "\n"
            throw msg
        
    #  ███████    ███████  █████████  
    # ███   ███  ███          ███     
    # █████████  ███████      ███     
    # ███   ███       ███     ███     
    # ███   ███  ███████      ███     
    
    # converts a string of kode into an abstract syntax tree
    
    ast: text ->
        
        tokens = @lexer.tokenize text
        blocks = @lexer.blockify tokens

        ast = @parser.parse  blocks # convert blocked token tree to abstract syntax tree
        ast = @stripol.collect  ast # handle string interpolation content
        ast = @scoper.collect   ast # collect variables in scopes
        ast = @returner.collect ast # insert return statements for last expressions in blocks
        ast = @operator.collect ast # sort operation chains by precedence

    astr: text scopes -> print.astr @ast(text) scopes

    # ████████   ███   ███  ███   ███  
    # ███   ███  ███   ███  ████  ███  
    # ███████    ███   ███  ███ █ ███  
    # ███   ███  ███   ███  ███  ████  
    # ███   ███   ███████   ███   ███  

    @run: args ○-> 
                                   
        log 'Kode.run args' args if args.verbose
        kode = new Kode args
        
        args = kode.args
    
        if args.compile
            log kode.compile(args.compile)
            process.exit 0
            
        if args.eval
            log kode.eval(args.eval 'eval' global)
            process.exit 0
    
        for file in args.files
    
            # the source path is what a source map names, so it has to be the
            # file and not however it was typed on the command line
            
            file = slash.absolute slash.path(file), process.cwd()
            log gray(file) if args.verbose
    
            text =○ nfs.read file
    
            if empty text then error Y4(r2("can't read #{R3(y5(file))}")); continue
    
            try
                if
                    args.outdir
                                    out = slash.absolute(slash.swapExt(slash.path(args.outdir slash.file(file)) 'js'), process.cwd())
                                    log out if args.verbose
                                    js  = kode.compile text, file, out
                                    res =○ nfs.write out js
                                    if res?.error then error R2(y3("can't write #{R3(y6(out))}"))
                    args.run   ➜    log kode.eval(text file global)
                               ➜    log kode.compile(text file)
            catch err
                log err
export Kode

◆main # node js/kode/kode.js 

    args = karg """
        kode
            files       **
            eval        evaluate a string and print the result
            compile     transpile a string and print the result
            outdir      transpile files into output directory
            run         execute files                               = true
            js          print transpiled js code                    = false
            map         generate inline source maps                 = true
            header      prepend output with version header          = false -H
            verbose     log more                                    = false
            debug       debug output                                = false
        """

    Kode.run args
       
