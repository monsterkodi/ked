###
███   ███   ███████   ███████    ████████
███  ███   ███   ███  ███   ███  ███
███████    ███   ███  ███   ███  ███████
███  ███   ███   ███  ███   ███  ███
███   ███   ███████   ███████    ████████
###

use ../kxk ◆ slash karg ansi nfs
use ◆ lexer print parser scoper stripol returner operator renderer
use ../kolor ◆ kulur

class Kode

    @: @args ->
        
        @args ?= {}
        @args.header ?= true
        @version  = '0.2.0'
        @literals = ['bool''num''regex''single''double''triple']
        @atoms    = @literals.concat ['var']

        @lexer    = new lexer    @
        @parser   = new parser   @
        @scoper   = new scoper   @
        @stripol  = new stripol  @
        @returner = new returner @
        @operator = new operator @
        @renderer = new renderer @
        
    # ████████  ████████   ████████    ███████   ████████   
    # ███       ███   ███  ███   ███  ███   ███  ███   ███  
    # ███████   ███████    ███████    ███   ███  ███████    
    # ███       ███   ███  ███   ███  ███   ███  ███   ███  
    # ████████  ███   ███  ███   ███   ███████   ███   ███  
    
    onError: msg info =>

        tok = null

        if valid info?.tokens and info.tokens.length
            tok = info.tokens[0]
        else if valid info?.tok
            tok = info.tok
        else if valid info?.line or valid info?.col
            tok = info

        lines = @text.split /\r?\n/

        li = null
        ci = null

        if valid tok?.line and tok.line > 0 and tok.line <= lines.length
            li = tok.line
            ci = tok.col

        if not valid li
            li = lines.length
            ci = lines[-1].length

        afile = slash.absolute slash.path(@file), process.cwd()

        url = "file://#{afile}:#{li}"

        message = bold(m5(slash.tilde(afile))) + m5(':') + m5(li)
        message += '\n' + ansi.link(url, @caret(lines[li-1], ci))
        message += '\n' + R2(y6(msg))

        throw message

    caret: text col ->

        hi = if text then kulur.kolorizeChunks kulur.ranges(text) else ''

        if valid col

            pad = ''
            for ch in (text ? '')[0...col]
                pad += if ch == '\t' then ' '.repeat 8 - pad.length % 8
                      else ' '

            hi += "\n#{pad}^"

        hi

    # ████████  ███   ███   ███████   ███
    # ███       ███   ███  ███   ███  ███
    # ███████    ███ ███   █████████  ███
    # ███          ███     ███   ███  ███
    # ████████      █      ███   ███  ███████

    eval: text file glob ->

        ⮐ if empty text
        
        js = @compile text file
        eval js
        
    ###
     ███████   ███████   ██     ██  ████████   ███  ███      ████████
    ███       ███   ███  ███   ███  ███   ███  ███  ███      ███
    ███       ███   ███  █████████  ████████   ███  ███      ███████
    ███       ███   ███  ███ █ ███  ███        ███  ███      ███
     ███████   ███████   ███   ███  ███        ███  ███████  ████████
     
    converts a string of kode into a string of javascript
    
    throws on syntax errors and internal lexer, parser or renderer errors
    ###

    @compile: text opt={} -> (new Kode(opt)).compile text
    
    compile: @text @file @target ->

        ⮐  '' if empty trim @text
        
        log @text if @args.verbose

        try
            ast = @ast @text
            @renderer.render ast, @file, @target
        catch err
            msg = ""
            if err is str
                # msg += "[syntax error]\n"
                msg += err
            else
                msg += "[internal kode compiler error]\n"
                if valid err.stack
                    msg += err.stack
                else
                    msg += err.message
                msg += "\n"
            throw msg
        
    #  ███████    ███████  █████████  
    # ███   ███  ███          ███     
    # █████████  ███████      ███     
    # ███   ███       ███     ███     
    # ███   ███  ███████      ███     
    
    # converts a string of kode into an abstract syntax tree
    
    ast: text ->
        
        tokens = @lexer.tokenize text
        blocks = @lexer.blockify tokens

        ast = @parser.parse  blocks # convert blocked token tree to abstract syntax tree
        ast = @stripol.collect  ast # handle string interpolation content
        ast = @scoper.collect   ast # collect variables in scopes
        ast = @returner.collect ast # insert return statements for last expressions in blocks
        ast = @operator.collect ast # sort operation chains by precedence

    astr: text scopes -> print.astr @ast(text) scopes

    # ████████   ███   ███  ███   ███  
    # ███   ███  ███   ███  ████  ███  
    # ███████    ███   ███  ███ █ ███  
    # ███   ███  ███   ███  ███  ████  
    # ███   ███   ███████   ███   ███  

    @commonDir: files =>

        dirs = []

        for f in files

            dir = slash.dir f
            dirs.push dir

        ⮐ '/' if empty dirs

        parts = dirs[0].split '/'

        for d in dirs

            p = d.split '/'

            n = 0
            while n < parts.length and n < p.length and parts[n] == p[n]
                n++

            parts = parts.slice 0, n

        parts.join('/') or '/'

    @outPath: (file, outdir, root) =>

        rel = slash.name file

        if file.startsWith root + '/'
            rel = file.slice root.length + 1

        slash.absolute slash.path(outdir slash.swapExt(rel 'js')) process.cwd()

    @run: args ○-> 
                                   
        log 'Kode.run args' args if args.verbose
        kode = new Kode args
        
        args = kode.args
    
        if args.compile
            log kode.compile(args.compile)
            process.exit 0
            
        if args.eval
            log kode.eval(args.eval 'eval' global)
            process.exit 0
    
        absFiles = []

        for f in args.files

            abs = slash.absolute slash.path(f), process.cwd()
            absFiles.push abs

        root = Kode.commonDir absFiles

        for file in args.files
    
            file = slash.absolute slash.path(file), process.cwd()
            log gray(file) if args.verbose
    
            text =○ nfs.read file
    
            if empty text then error Y4(r2("can't read #{R3(y5(file))}")); continue
    
            try
                if
                    args.outdir
                                    out = Kode.outPath file, args.outdir, root
                                    log out if args.verbose
                                    js  = kode.compile text, file, out
                                    res =○ nfs.write out js
                                    if res?.error then error R2(y3("can't write #{R3(y6(out))}"))
                    args.run   ➜    log kode.eval(text file global)
                               ➜    log kode.compile(text file)
            catch err
                log err
export Kode

◆main # node js/kode/kode.js 

    args = karg """
        kode
            files       **
            eval        evaluate a string and print the result
            compile     transpile a string and print the result
            outdir      transpile files into output directory
            run         execute files                               = true
            js          print transpiled js code                    = false
            map         generate inline source maps                 = true
            header      prepend output with version header          = false -H
            verbose     log more                                    = false
            debug       debug output                                = false
        """

    Kode.run args
       
