###
    ████████    ███████   ████████    ███████  ████████  ████████
    ███   ███  ███   ███  ███   ███  ███       ███       ███   ███
    ████████   █████████  ███████    ███████   ███████   ███████
    ███        ███   ███  ███   ███       ███  ███       ███   ███
    ███        ███   ███  ███   ███  ███████   ████████  ███   ███

    the equivalent of a grammar for kode.
       
    instead of converting an essentially dynamic problem to a static 
    representation and then converting it back to dynamic code again,
    it goes the direct route: less formal, but faster and easier to 
    customize and debug.
    
    handles the main features of kode, the nasty details
    and corner cases are handled in the base class 'parse'.
        
    each method here consumes and converts raw lexer tokens into an
    expression object to simplify the renderer kode.
###

use         ◆ print parse
use ./utils ▪ firstLineCol lastLineCol

function Parser extends parse

    scope: exps ->
        
        vars: []
        exps: exps
    
    # ███  ████████
    # ███  ███
    # ███  ██████
    # ███  ███
    # ███  ███

    if: tok tokens ->

        if tokens[0]?.type == 'block'
            ⮐ @ifBlock tok tokens

        @push 'if'
        @lockBlock = true
        cond = @exp tokens
        @lockBlock = false
        
        if not cond
            @onError "if is missing a condition" tok:tok
            
        thn = @then 'if' tokens

        e = if:
                cond:   cond
                then:   thn
                
        @shiftNewlineTok 'if after then' tokens tok tokens[1]?.text == 'else'
        
        if tokens[0]?.type == 'block'
            @verb 'block after if then -> switch to block mode' 
            @pop 'if'
            ⮐ @ifBlock tok tokens e
        
        while tokens[0]?.text == 'else' and tokens[1]?.text == 'if'

            tokens.shift()
            tokens.shift()

            e.if.elifs ?= []

            cond = @exp tokens

            thn = @then 'elif' tokens

            @shiftNewlineTok 'if after elif then' tokens tok tokens[1]?.text == 'else'
            
            e.if.elifs.push
                elif:
                    cond: cond
                    then: thn

        if tokens[0]?.text == 'else'

            tokens.shift()

            e.if.else = @block 'else' tokens
            
        @pop 'if'
        e
        
    # ███  ████████  ███████    ███       ███████    ███████  ███   ███  
    # ███  ███       ███   ███  ███      ███   ███  ███       ███  ███   
    # ███  ██████    ███████    ███      ███   ███  ███       ███████    
    # ███  ███       ███   ███  ███      ███   ███  ███       ███  ███   
    # ███  ███       ███████    ███████   ███████    ███████  ███   ███  
    
    ifBlock: tok tokens e ->
        
        @push 'if'

        subbs = @subBlocks tokens.shift().tokens
        
        if not e
            tokens = subbs.shift()
            e = if:
                    cond: @exp(tokens)
                    then: @then('if' tokens)
        
        while subbs.length
            tokens = subbs.shift()
            if tokens[0]?.text == 'else'
                tokens.shift()
                e.if.else = @block 'else' tokens
                break
                
            cond = @exp tokens
            thn  = @then 'elif' tokens

            e.if.elifs ?= []
            e.if.elifs.push
                elif:
                    cond: cond
                    then: thn
                    
        @pop 'if'
        e
        
    # ███  ████████  █████████   ███████   ███  ███      
    # ███  ███          ███     ███   ███  ███  ███      
    # ███  ██████       ███     █████████  ███  ███      
    # ███  ███          ███     ███   ███  ███  ███      
    # ███  ███          ███     ███   ███  ███  ███████  
    
    ifTail: e tok tokens ->
        
        if:
            cond: @exp(tokens)
            then: [e]
            
    # ████████   ███████   ████████   
    # ███       ███   ███  ███   ███  
    # ██████    ███   ███  ███████    
    # ███       ███   ███  ███   ███  
    # ███        ███████   ███   ███  
    
    for: tok tokens ->
        
        @push 'for'

        vals = @exps 'for vals' tokens
        
        if not vals?.length
            @onError "for is missing the variable to iterate" tok:tok
            
        vals = vals[0] if vals.length == 1

        inof = tokens.shift()
        
        if not inof
            @onError "for is missing 'in' or 'of'" tok:tok
            
        list = @exp tokens

        if not list
            @onError "for is missing the list to iterate" tok:tok

        thn  = @then 'for' tokens
        
        @pop 'for' 

        for:
            vals:   vals
            inof:   inof
            list:   list
            then:   thn
            
    # ████████   ███████    ███████  ███   ███  
    # ███       ███   ███  ███       ███   ███  
    # ███████   █████████  ███       █████████  
    # ███       ███   ███  ███       ███   ███  
    # ████████  ███   ███   ███████  ███   ███  
    
    each: e tokens ->
                
        ech = tokens.shift()
        
        each:
            lhs:    e
            each:   ech
            fnc:    @exp(tokens)
            
    # ████████   ███████   ████████   █████████   ███████   ███  ███      
    # ███       ███   ███  ███   ███     ███     ███   ███  ███  ███      
    # ██████    ███   ███  ███████       ███     █████████  ███  ███      
    # ███       ███   ███  ███   ███     ███     ███   ███  ███  ███      
    # ███        ███████   ███   ███     ███     ███   ███  ███  ███████  
    
    forTail: e tok tokens ->
        
        @push 'for'
        
        vals = @exps 'for vals' tokens

        if not vals?.length
            @onError "for is missing the variable to iterate" tok:tok
            
        vals = vals[0] if vals.length == 1

        inof = tokens.shift()
        
        if not inof
            @onError "for is missing 'in' or 'of'" tok:tok
            
        list = @exp tokens

        if not list
            @onError "for is missing the list to iterate" tok:tok

        @pop 'for' 
        
        for:
            vals:  vals
            inof:  inof
            list:  list
            then: [e]
            
    # ███   ███  ███   ███  ███  ███      ████████  
    # ███ █ ███  ███   ███  ███  ███      ███       
    # █████████  █████████  ███  ███      ███████   
    # ███   ███  ███   ███  ███  ███      ███       
    # ██     ██  ███   ███  ███  ███████  ████████  
    
    while: tok tokens ->
        
        @push 'while'
        
        cond = @exp tokens

        # 'while' is a javascript reserved word and says so much better
        # elsewhere, but a while with nothing to test has nothing to say for
        # itself either - it was rendering as 'while ()'

        if not cond
            @onError 'while is missing a condition' tok:tok

        thn = @then 'while' tokens
        
        @pop 'while'
        
        while:
            cond: cond
            then: thn

    # ███   ███  ███   ███  ███  ███      ████████  █████████   ███████   ███  ███      
    # ███ █ ███  ███   ███  ███  ███      ███          ███     ███   ███  ███  ███      
    # █████████  █████████  ███  ███      ███████      ███     █████████  ███  ███      
    # ███   ███  ███   ███  ███  ███      ███          ███     ███   ███  ███  ███      
    # ██     ██  ███   ███  ███  ███████  ████████     ███     ███   ███  ███  ███████  
    
    whileTail: e tok tokens ->
        
        # @push 'while'
        
        cond = @exp tokens

        # @pop 'while'
        
        while:
            cond: cond
            then: [e]
            
    #  ███████  ███   ███  ███  █████████   ███████  ███   ███
    # ███       ███ █ ███  ███     ███     ███       ███   ███
    # ███████   █████████  ███     ███     ███       █████████
    #      ███  ███   ███  ███     ███     ███       ███   ███
    # ███████   ██     ██  ███     ███      ███████  ███   ███

    switch: tok tokens ->
        
        @push 'switch'
        
        match = @exp tokens
        
        if tokens[0]?.type == 'block'
            tokens = tokens.shift().tokens
        else
            return @error pop:'switch' msg:'block expected!' tokens
        
        whens = []
        e = switch:
                match:  match
                whens:  whens
            
        if tokens[0]?.text != 'when'

            subbs = @subBlocks tokens
            
            while subbs.length
                
                tokens = subbs.shift()
                
                if tokens[0]?.text == 'else'
                    tokens.shift()
                    e.switch.else = @block 'else' tokens
                    break
                    
                whens.push @when(null, tokens)
                    
                if whens[-2]? and empty whens[-2].when.then 
                    whens[-1].when.vals = whens[-2].when.vals.concat whens[-1].when.vals
                    whens.splice -2 1
        else
            
            while tokens[0]?.text == 'when'
                
                lastWhen = tokens[0]
                whens.push @exp(tokens)
                @shiftNewlineTok 'switch after when' tokens, lastWhen, tokens[1]?.text in ['when' 'else']
                        
            if tokens[0]?.text == 'else'
    
                tokens.shift()
    
                e.switch.else = @block 'else' tokens
            
        @pop 'switch'
        
        e
                        
    # ███   ███  ███   ███  ████████  ███   ███  
    # ███ █ ███  ███   ███  ███       ████  ███  
    # █████████  █████████  ███████   ███ █ ███  
    # ███   ███  ███   ███  ███       ███  ████  
    # ██     ██  ███   ███  ████████  ███   ███  
    
    when: tok tokens ->
        
        @push 'when'
        
        vals = []
        
        while (tokens[0]? and (tokens[0].type not in ['block''nl']) and tokens[0].text != 'then')
            
            vals.push @exp(tokens)
        
        thn = @then 'when' tokens
        
        @shiftNewlineTok 'when with empty then' tokens, tok, empty thn
        
        @pop 'when'
        
        when:
            vals: vals
            then: thn

    # █████████  ████████   ███   ███  
    #    ███     ███   ███   ███ ███   
    #    ███     ███████      █████    
    #    ███     ███   ███     ███     
    #    ███     ███   ███     ███     
    
    try: tok tokens ->
        
        @push 'try'
        
        exps = @block 'body' tokens
        
        @shiftNewlineTok 'try body end' tokens tok tokens[1]?.text in ['catch' 'finally']
        
        if tokens[0]?.text == 'catch'
            
            @push 'catch'

            tokens.shift()
            
            if tokens[0]?.type != 'block'
                errr = @exp tokens
        
            ctch = 
                errr: errr
                exps: @block('body' tokens)
        
            @pop  'catch'

            @shiftNewlineTok 'try catch end' tokens tok tokens[1]?.text == 'finally'
            
        if tokens[0]?.text == 'finally'
            tokens.shift()
            fnlly = @block 'body' tokens

        # a try with neither half compiles to a try node with two holes in
        # it, and node reads that as a try around an empty block. the block
        # is optional - '@try' takes what it can get and stops at the end of
        # the tokens - so the check cannot be 'is there a body'

        if not ctch and not fnlly
            @onError "try is missing catch or finally" tok:tok

        @pop 'try'

        try:
            exps:    exps
            catch:   ctch
            finally: fnlly
            
    # ███  ██     ██  ████████    ███████   ████████   █████████  
    # ███  ███   ███  ███   ███  ███   ███  ███   ███     ███     
    # ███  █████████  ████████   ███   ███  ███████       ███     
    # ███  ███ █ ███  ███        ███   ███  ███   ███     ███     
    # ███  ███   ███  ███         ███████   ███   ███     ███     
    
    import: obj tokens ->

        toImport = []
            
        while token = tokens.shift()

            if token.type == 'nl'
                break
            toImport.push token
                
        if not toImport.length
            @onError "import is missing what to import" tok:obj

        import:
            args: toImport
            
    # ███   ███   ███████  ████████  
    # ███   ███  ███       ███       
    # ███   ███  ███████   ███████   
    # ███   ███       ███  ███       
    #  ███████   ███████   ████████  
    
    use: obj tokens ->
        
        toUse = []
        
        token = tokens.shift()
                        
        if not token or token.type == 'nl'
            @onError 'use is missing what to use' tok:obj
            
        while token
            
            module = token.text
            
            if module == '◆'
                module = '.'
                # log 'unshift diamond'
                tokens.unshift token
                break
            
            while tokens.length and tokens[0].type != 'nl' and tokens[0].col == token.col + token.text.length
                token = tokens.shift()
                module += token.text
            
            toUse.push
                type: 'var'
                text:  module
                
            break if tokens.length and (tokens[0].type == 'nl' or tokens[0].text in '▪●◆')
            
            token = tokens.shift()
            
        items = []
        
        if tokens.length and tokens[0].text == '▪'
            
            tokens.shift()
            token = tokens.shift()

            # a '▪' list is names, so a '.' in one is not a name. the type is the
            # test rather than a list of words, so a list of keywords or of
            # kode's own operator words is still a list of names

            while token and token.type != 'nl' and token.type in ['var' 'keyword' 'bool' 'op']
                
                item = token.text
                
                while tokens.length and tokens[0].type != 'nl' and tokens[0].col == token.col + token.text.length
                    token = tokens.shift()
                    item += token.text
                
                items.push item
                    
                break if tokens.length and (tokens[0].type == 'nl' or tokens[0].text in '▪●◆')

                # before taking it, not after. a token left behind is one the
                # dangling check at the foot of this method can speak about;
                # one taken and dropped is one nobody says anything about

                if tokens[0]?.type not in ['var' 'keyword' 'bool' 'op']
                    break
                    
                token = tokens.shift()

        # a use names its bindings with '▪' or '◆', not both. the two are
        # alternatives, so if the list has already collected something the
        # diamond branch is the dangling half - which is what 'use a ▪ b ◆ c'
        # is, and it used to go through as an import and a let

        if tokens.length and tokens[0].text == '◆' and not items.length
            
            # log 'use diamond'
            toUse = []
            
            tokens.shift()
            token = tokens.shift()

            while token and token.type != 'nl'
                
                item = module + '/' + token.text
                
                while tokens.length and tokens[0].type != 'nl' and tokens[0].col == token.col + token.text.length
                    token = tokens.shift()
                    item += token.text
                
                toUse.push
                    type: 'var'
                    text:  item
                    
                break if tokens.length and (tokens[0].type == 'nl' or tokens[0].text in '▪●◆')
                
                token = tokens.shift()
                
        if tokens.length and tokens[0].text == '●'
            
            tokens.shift()
            token = tokens.shift()

            name = token?.text
            
            while tokens.length and tokens[0].type != 'nl' and tokens[0].col == token.col + token.text.length
                token = tokens.shift()
                name += token.text
                
        if tokens.length and tokens[0].type != 'nl'
            @onError 'use has a dangling token' tok:tokens[0]
                
        use:   
            toUse:toUse
            items:items
            name: name
        
    # ████████  ███   ███  ████████    ███████   ████████   █████████  
    # ███        ███ ███   ███   ███  ███   ███  ███   ███     ███     
    # ███████     █████    ████████   ███   ███  ███████       ███     
    # ███        ███ ███   ███        ███   ███  ███   ███     ███     
    # ████████  ███   ███  ███         ███████   ███   ███     ███     
    
    export: obj tokens ->
        
        toExport = []
        start = tokens.shift()
        
        if not start
            @onError "export is missing what to export" tok:obj
            
        if start.text == '{'
            toExport = @object 'export' start.tokens
            # while token = tokens.shift()
            #     if token.text == '}'
            #         tokens.shift()
            #         break
            #     toExport.push token
        else if start.type == 'block'
            toExport = @block 'export' start.tokens
        else
            tokens.unshift start
            toExport = @exp tokens

        export:
            args: toExport
            
    # ███████    ███  ████████   ████████  ███  ███      ████████  
    # ███   ███  ███  ███   ███  ███       ███  ███      ███       
    # ███   ███  ███  ███████    ██████    ███  ███      ███████   
    # ███   ███  ███  ███   ███  ███       ███  ███      ███       
    # ███████    ███  ███   ███  ███       ███  ███████  ████████  
    
    dirFile: tok tokens ->
        
        dirFile: tokens.shift().text
        
    # ██     ██   ███████   ███  ███   ███  
    # ███   ███  ███   ███  ███  ████  ███  
    # █████████  █████████  ███  ███ █ ███  
    # ███ █ ███  ███   ███  ███  ███  ████  
    # ███   ███  ███   ███  ███  ███   ███  
    
    main: tok tokens ->
        
        tokens.shift()
        
        main: @block('main' tokens)
            
    #  ███████  ███       ███████    ███████   ███████
    # ███       ███      ███   ███  ███       ███
    # ███       ███      █████████  ███████   ███████
    # ███       ███      ███   ███       ███       ███
    #  ███████  ███████  ███   ███  ███████   ███████

    class: tok tokens type='class' ->

        @push 'class'

        name = tokens.shift()

        # a newline is not a name. 'class' with nothing after it was caught,
        # but 'class\n' took the line ending as the name and rendered an
        # empty class, which node reads as one missing a body

        if not name or name.type == 'nl'
            @onError "#{type} is missing a name" tok:tok

        e = {}
        e[type] = name:name

        if tokens[0]?.text == 'extends'
            tokens.shift()
            e[type].extends = @exps 'class extends' tokens, 'nl'

        if tokens[0]?.type == 'block'
            tokens = tokens.shift().tokens

            e[type].body = @exps 'class body' tokens
            @nameMethods e[type].body
                
        @pop 'class'

        e

    function: tok tokens ->

        @class tok tokens 'function'
        
    # ████████  ███   ███  ███   ███   ███████
    # ███       ███   ███  ████  ███  ███
    # ██████    ███   ███  ███ █ ███  ███
    # ███       ███   ███  ███  ████  ███
    # ███        ███████   ███   ███   ███████

    func: args arrow tokens ->

        @push 'func'
        
        body = @scope @block('body' tokens)
        
        @pop 'func'
        
        e = func:{}
        e.func.args  = args if args
        e.func.arrow = arrow
        e.func.body  = body
        e

    # ████████   ████████  █████████  ███   ███  ████████   ███   ███  
    # ███   ███  ███          ███     ███   ███  ███   ███  ████  ███  
    # ███████    ███████      ███     ███   ███  ███████    ███ █ ███  
    # ███   ███  ███          ███     ███   ███  ███   ███  ███  ████  
    # ███   ███  ████████     ███      ███████   ███   ███  ███   ███  
    
    return: tok tokens ->
        
        if tokens[0]?.type != 'nl'        
            val = @block 'return' tokens
            if val?.length > 1
                # log 'unreachable code after return statement?' tok tokens noon(val)
                @onError 'unreachable code after return statement?' tok:tok tokens:tokens
            val = val?[0]
            
        e = return: ret: tok
        e.return.val = val if val
        e

    #  ███████   ███   ███   ███████   ███  █████████  
    # ███   ███  ███ █ ███  ███   ███  ███     ███     
    # █████████  █████████  █████████  ███     ███     
    # ███   ███  ███   ███  ███   ███  ███     ███     
    # ███   ███  ██     ██  ███   ███  ███     ███     
    
    await: tok tokens ->
        
        e = await: exp: @exp(tokens)
        e
        
    #  ███████   ███████   ███      ███
    # ███       ███   ███  ███      ███
    # ███       █████████  ███      ███
    # ███       ███   ███  ███      ███
    #  ███████  ███   ███  ███████  ███████

    call: tok tokens qmrk ->

        @push 'call'
        
        tok = tok.token if tok.token
                        
        last = lastLineCol tok
        if tokens[0].text == '(' and tokens[0].line == last.line and tokens[0].col == last.col
            open = tokens.shift()
            if tokens[0]?.text == ')'
                args = []
            else
                @push 'args('
                args = @exps '(' tokens ')'
                @pop 'args('
        else
            if tok.text in ['typeof' 'new']
                @push '▸arg'
                args = [@exp(tokens)]
                @pop  '▸arg'
            else
                args = @block 'args' tokens

        if open 
            if tokens[0]?.text == ')'
                close = tokens.shift()
            else if tokens[0]?.type == 'nl' and tokens[1].text == ')'
                @shiftNewline 'implicit call ends' tokens
                close = tokens.shift()

        if open and not close
            @onError "explicit call is missing closing bracket )" tok:tok tokens:tokens

        @pop 'call'
        
        args[0] = @prepareCallAssign(args[0]) if valid args
                
        e = call: callee: tok
        e.call.open  = open  if open
        e.call.qmrk  = qmrk  if qmrk
        e.call.args  = args
        e.call.close = close if close
        e
            
    #  ███████   ████████   ████████  ████████    ███████   █████████  ███   ███████   ███   ███
    # ███   ███  ███   ███  ███       ███   ███  ███   ███     ███     ███  ███   ███  ████  ███
    # ███   ███  ████████   ███████   ███████    █████████     ███     ███  ███   ███  ███ █ ███
    # ███   ███  ███        ███       ███   ███  ███   ███     ███     ███  ███   ███  ███  ████
    #  ███████   ███        ████████  ███   ███  ███   ███     ███     ███   ███████   ███   ███

    operation: lhs op tokens ->
        
        if op.text == '='
            
            if empty tokens
                @onError "assignment without operand" tok:lhs
                ⮐ operation: lhs:lhs operator:op
            
            if tokens[0].type == 'block'
                @blockAssign = true
                tokens = tokens.shift().tokens
        
        @push "op#{op.text}"

        # @exp looks at a bare token it finds at the head of an expression
        # and asks what to make of it, and whether it is the right side of
        # this operation is the whole of the answer. a prefix operation has
        # no lhs, and the check below already covers that case and names the
        # operator that came up short - 'a/-^' is a minus with nothing after
        # it, not a caret. a binary one has a lhs, so nothing else is going
        # to say anything about what its right side looks like and @exp has
        # to - 'x = in' is an 'in' with nothing to iterate.

        wasPrefix = @prefixOperand
        @prefixOperand = not lhs

        rhs = @exp tokens

        @prefixOperand = wasPrefix

        # an operator needs a right operand. a postfix ++ or -- is the one
        # exception: having nothing after it is what postfix means.
        #
        # a prefix + or - is an operation with no lhs at all, and it needs
        # one just the same - in '-+' the minus swallowed the plus and left
        # the expression standing on nothing. a bare op token further right
        # of a real lhs is left alone, since that is how 'a & ~0xffff'
        # reaches the renderer as a & ~
        #
        # 'is' names what it was looking for, so it says so

        if not (op.text in ['++' '--'] and lhs)
            if not rhs or (not lhs and rhs.type == 'op')
                if op.text == 'is'
                    @onError "'is' is missing what to test against" tok:op
                else
                    @onError "#{op.text} is missing a right operand" tok:op

        delete @blockAssign
        
        @pop "op#{op.text}"
        
        rhs = @prepareCallAssign rhs
                                            
        if op.text == '?='
            
            op.text = '='
            
            rhs = 
                qmrkop:
                    lhs: lhs # should lhs be cloned here?
                    qmrk: 
                        type:'op' 
                        text:'?'
                        line: op.line
                        col:  op.col
                    rhs: rhs
            
        e = operation: {}
        e.operation.lhs      = lhs if lhs
        e.operation.operator = op
        e.operation.rhs      = rhs if rhs
        e
            
    # ███  ███   ███   ███████   ███████   ███   ███  ███████    
    # ███  ████  ███  ███       ███   ███  ████  ███  ███   ███  
    # ███  ███ █ ███  ███       ███   ███  ███ █ ███  ███   ███  
    # ███  ███  ████  ███       ███   ███  ███  ████  ███   ███  
    # ███  ███   ███   ███████   ███████   ███   ███  ███████    
    
    incond: lhs tokens ->
        
        intok = tokens.shift()
        
        @push 'in?'
        rhs = @exp tokens
        @pop  'in?'

        # 'in' is the operator, so whatever is on the right of it has to be
        # something to test for membership of. 'log in' has nothing, and was
        # rendering as '_k_.in(log,)' - the helper called with one argument,
        # which node is perfectly happy with and which means nothing.

        if not rhs
            @onError 'in is missing a right operand' tok:intok

        incond:
            lhs: lhs
            in:  intok
            rhs: rhs
            
    #  ███████   ████████   ████████    ███████   ███   ███
    # ███   ███  ███   ███  ███   ███  ███   ███   ███ ███
    # █████████  ███████    ███████    █████████    █████
    # ███   ███  ███   ███  ███   ███  ███   ███     ███
    # ███   ███  ███   ███  ███   ███  ███   ███     ███

    array: open tokens ->

        if tokens[0]?.text == ']'
            return array:
                open:  open
                items: []
                close: tokens.shift()

        @push '['

        items = @exps '[' tokens ']'

        close = @shiftClose 'array' ']' tokens

        @pop '['
        
        if comp = @lcomp(items)
            return comp
        
        array:
            open:  open
            items: items
            close: close

    #  ███████  ███      ███   ███████  ████████  
    # ███       ███      ███  ███       ███       
    # ███████   ███      ███  ███       ███████   
    #      ███  ███      ███  ███       ███       
    # ███████   ███████  ███   ███████  ████████  
    
    slice: from tokens ->

        dots = tokens.shift()

        if tokens[0]?.text == ']'
            upto = null
        else
            upto = @exp tokens

            # 'x[1..]' and 'x[1...]' both end at a bracket and are open
            # ended slices. anything else that runs out of tokens is a
            # slice with no end at all, and renders as 'for (i = a; i < ;)'

            if not upto
                @onError "slice is missing the end" tok:dots

        slice:
            from: from
            dots: dots
            upto: upto

    # ███  ███   ███  ███████    ████████  ███   ███
    # ███  ████  ███  ███   ███  ███        ███ ███
    # ███  ███ █ ███  ███   ███  ███████     █████
    # ███  ███  ████  ███   ███  ███        ███ ███
    # ███  ███   ███  ███████    ████████  ███   ███

    index: tok tokens ->

        @push 'idx'

        open = tokens.shift()
        
        if tokens[0]?.type == 'dots'
            slice = @slice null tokens
        else
            slice = @exp tokens

        close = @shiftClose 'index' ']' tokens
        
        @pop 'idx'

        index:
            idxee: tok
            open:  open
            slidx: slice
            close: close

    # ████████    ███████   ████████   ████████  ███   ███   ███████
    # ███   ███  ███   ███  ███   ███  ███       ████  ███  ███
    # ████████   █████████  ███████    ███████   ███ █ ███  ███████
    # ███        ███   ███  ███   ███  ███       ███  ████       ███
    # ███        ███   ███  ███   ███  ████████  ███   ███  ███████

    parens: open tokens ->

        if tokens[0]?.text == ')'
            ⮐  parens:
                open:  open
                exps:  []
                close: tokens.shift()
        
        @push '('

        exps = @exps '(' tokens ')'

        close = @shiftClose 'parens' ')' tokens
        
        @pop '('

        if comp = @lcomp(exps)
            ⮐  comp 
        
        parens:
            open:  open
            exps:  exps
            close: close
            
    # ███   ███   ███████         ████████    ███████   ████████   ████████  ███   ███   ███████  
    # ████  ███  ███   ███        ███   ███  ███   ███  ███   ███  ███       ████  ███  ███       
    # ███ █ ███  ███   ███        ████████   █████████  ███████    ███████   ███ █ ███  ███████   
    # ███  ████  ███   ███        ███        ███   ███  ███   ███  ███       ███  ████       ███  
    # ███   ███   ███████         ███        ███   ███  ███   ███  ████████  ███   ███  ███████   
    
    argsWithoutParens: firstArg tokens ->
        
        @push '○rgs'
        tokens.unshift firstArg
        exps = @exps '○rgs' tokens
        @pop '○rgs'
        
        # log '○rgs exps' noon exps
        
        parens:
            open:  type: 'paren' text:'('
            exps:  exps
            close: type: 'paren' text:')'

    # ███       ███████   ███████   ██     ██  ████████   
    # ███      ███       ███   ███  ███   ███  ███   ███  
    # ███      ███       ███   ███  █████████  ████████   
    # ███      ███       ███   ███  ███ █ ███  ███        
    # ███████   ███████   ███████   ███   ███  ███        
    
    lcomp: exps ->
        
        ⮐ if empty exps
        ⮐ if not exps[0]['for']
        
        lcomp: exps[0]
            
    #  ███████  ███   ███  ████████   ███      ███   ███
    # ███       ███   ███  ███   ███  ███       ███ ███
    # ███       ███   ███  ███████    ███        █████
    # ███       ███   ███  ███   ███  ███         ███
    #  ███████   ███████   ███   ███  ███████     ███

    curly: open tokens ->

        if tokens[0]?.text == '}'
            ⮐  object:
                open:    open
                keyvals: []
                close:   tokens.shift()

        @push '{'

        exps = @exps '{' tokens '}'

        close = @shiftClose 'curly' '}' tokens
        # if not close 
            # warn 'no close?' exps
            # warn 'no close?' tokens

        @pop '{'

        object:
            open:    open
            keyvals: exps
            close:   close

    #  ███████   ███████          ███  ████████   ███████  █████████
    # ███   ███  ███   ███        ███  ███       ███          ███
    # ███   ███  ███████          ███  ███████   ███          ███
    # ███   ███  ███   ███  ███   ███  ███       ███          ███
    #  ███████   ███████     ███████   ████████   ███████     ███

    object: key tokens ->

        @push '{'

        first = firstLineCol key
        
        exps = [@keyval(key tokens)]
        
        literals = @kode.atoms.concat ['keyword''op']
        
        while tokens.length
            
            if tokens[0]?.type == 'nl'
                break if tokens[1]?.type not in literals
                break if tokens[2]?.text not in ': ' # ◂ the space checks for newline!
                
                if tokens[1]?.col >= first.col and tokens[1].text not in '])'
                    @shiftNewline 'continue implicit object on nl...' tokens
                    exps.push @exp(tokens)
                    continue
                break
            else if tokens[0]?.type == 'block'
                if tokens[0].col >= first.col or @stack[-1] == '{' and 'section' in @stack
                    block = tokens.shift()
                    tokens = block.tokens
                    exps = exps.concat @exps('object' block.tokens)
                break
            else if tokens[0]?.line == first.line and tokens[0].text not in '])};'
                exps = exps.concat @exps('object' tokens, ';')
                break
            else
                break if tokens[0].text in '])};'
                break if tokens[0].type not in literals
                
                log 'object ... exps?' key tokens if @debug
                break
                
        @pop '{'

        object:
            keyvals: exps

    # ███   ███  ████████  ███   ███  ███   ███   ███████   ███
    # ███  ███   ███        ███ ███   ███   ███  ███   ███  ███
    # ███████    ███████     █████     ███ ███   █████████  ███
    # ███  ███   ███          ███        ███     ███   ███  ███
    # ███   ███  ████████     ███         █      ███   ███  ███████

    keyval: key tokens ->
    
        if empty tokens
            @onError "keyval is missing tokens in:\n#{noon key}"
            ⮐  

        colon = tokens.shift()

        @push ':'

        if tokens[0]?.type == 'block'
            block = tokens.shift()
            value = @exp block.tokens
        else 
            value = @exp tokens

        @pop ':'

        # a key with a colon and nothing after it - 'a:' - is an object
        # with a hole in it, and renders as '{a:}'

        if not value
            @onError "key is missing a value" tok:key

        k = type:'key'
        
        if key.type 
                        
            k.text = key.text
            k.line = key.line
            k.col  = key.col
            
        else if key.prop
            
            {line, col} = firstLineCol key
            
            # this key is read back off the rendered text and put into the
            # ast, so it has to be the text as it reads without a source
            # map - a tag in there would be part of the name from here on
            
            text = @kode.renderer.plain @kode.renderer.node(key)
            if text?.startsWith('this')
                if text == 'this' then text = '@'
                else if text.startsWith('this.') then text = '@' + text[5..]

            k.text = text
            k.line = line
            k.col  = col
            
        else
            @onError "keyval is missing type or prop in:\n#{noon key}" tokens:tokens
            
        keyval:
            key:   k
            colon: colon
            val:   value
            
    # █████████  ███   ███  ███   ███████  
    #    ███     ███   ███  ███  ███       
    #    ███     █████████  ███  ███████   
    #    ███     ███   ███  ███       ███  
    #    ███     ███   ███  ███  ███████   
    
    this: obj tokens ->

        prop:
            obj:  obj
            dot:  type:'punct' text:'.' line:obj.line, col:obj.col
            prop: tokens.shift()

    # ████████   ████████    ███████   ████████
    # ███   ███  ███   ███  ███   ███  ███   ███
    # ████████   ███████    ███   ███  ████████
    # ███        ███   ███  ███   ███  ███
    # ███        ███   ███   ███████   ███

    prop: obj tokens ->

        dot  = tokens.shift()
        prop = tokens.shift()
        
        # a dot wants a name after it, and not everything that follows one
        # is a name. an opening bracket is the start of something else -
        # 'f.(' is a call that lost its callee - and '@' is this, which is
        # this at the head of an expression and nowhere else.
        #
        # the type is the test rather than a list of words, and an op counts
        # as a name: print.noon and a.clone spell a property the way kode
        # spells the operators, and they are the same thing once the dot is
        # there

        if not prop or prop.type not in ['var' 'keyword' 'bool' 'op']
            @onError "property access is missing property name" tok:dot
            
        prop.type = 'var'
        
        prop:
            obj:  obj
            dot:  dot
            prop: prop
            
    #  ███████    ███████   ███████  ████████  ████████   █████████  
    # ███   ███  ███       ███       ███       ███   ███     ███     
    # █████████  ███████   ███████   ███████   ███████       ███     
    # ███   ███       ███       ███  ███       ███   ███     ███     
    # ███   ███  ███████   ███████   ████████  ███   ███     ███     
    
    assert: obj tokens ->
        
        assert:
            obj:    obj
            qmrk:   tokens.shift()
            
    #  ███████   ██     ██  ████████   ███   ███   ███████   ████████   
    # ███   ███  ███   ███  ███   ███  ███  ███   ███   ███  ███   ███  
    # ███ ██ ██  █████████  ███████    ███████    ███   ███  ████████   
    # ███ ████   ███ █ ███  ███   ███  ███  ███   ███   ███  ███        
    #  █████ ██  ███   ███  ███   ███  ███   ███   ███████   ███        
    
    qmrkop: lhs tokens ->
     
        @push '?'
        
        qmrk = tokens.shift()
        rhs  = @exp tokens

        # '?' turns what is in front of it into a conditional and needs
        # something to put on the other side. 'a ?' was rendering as
        # '(a != null ? a : )'

        if not rhs
            @onError "#{qmrk.text} is missing a right operand" tok:qmrk

        @pop  '?'
        
        qmrkop:
            lhs:    lhs
            qmrk:   qmrk
            rhs:    rhs
            
    #  ███████   ██     ██  ████████   ███   ███   ███████   ███████   ███       ███████   ███   ███  
    # ███   ███  ███   ███  ███   ███  ███  ███   ███       ███   ███  ███      ███   ███  ████  ███  
    # ███ ██ ██  █████████  ███████    ███████    ███       ███   ███  ███      ███   ███  ███ █ ███  
    # ███ ████   ███ █ ███  ███   ███  ███  ███   ███       ███   ███  ███      ███   ███  ███  ████  
    #  █████ ██  ███   ███  ███   ███  ███   ███   ███████   ███████   ███████   ███████   ███   ███  
    
    qmrkcolon: qmrkop tokens ->
        
        @push ':'
        
        colon = tokens.shift()
        rhs = @exp tokens

        # same as the '?' above, one step further along: 'a ? b :' was
        # rendering as '(a ? b : )'

        if not rhs
            @onError "#{colon.text} is missing a right operand" tok:colon

        @pop  ':'
        
        qmrkcolon:
            lhs:    qmrkop.lhs
            qmrk:   qmrkop.qmrk
            mid:    qmrkop.rhs
            colon:  colon
            rhs:    rhs
                        
            
    #  ███████  ████████   ███████  █████████  ███   ███████   ███   ███  
    # ███       ███       ███          ███     ███  ███   ███  ████  ███  
    # ███████   ███████   ███          ███     ███  ███   ███  ███ █ ███  
    #      ███  ███       ███          ███     ███  ███   ███  ███  ████  
    # ███████   ████████   ███████     ███     ███   ███████   ███   ███  
    
    section: tok tokens ->
        
        title = type:'double' text:'"'+tok.text+'"' line:tok.line, col:tok.col
        
        if 'section' in @stack
            @push 'subsect'
            exps = @block 'subsect' tokens
            @pop 'subsect'
            subsect:
                title:  title
                exps:   exps
        else
            @push 'section'
            exps = @block 'section' tokens
            @pop 'section'
            section:
                title:  title
                exps:   exps
        
    #  ███████   ███████   ██     ██  ████████    ███████   ████████   ████████  
    # ███       ███   ███  ███   ███  ███   ███  ███   ███  ███   ███  ███       
    # ███       ███   ███  █████████  ████████   █████████  ███████    ███████   
    # ███       ███   ███  ███ █ ███  ███        ███   ███  ███   ███  ███       
    #  ███████   ███████   ███   ███  ███        ███   ███  ███   ███  ████████  
    
    compare: lhs tokens ->
        
        tokens.shift()
        
        compare:
            lhs: lhs
            rhs: @exp(tokens)

    # for a construct that cannot be parsed at all. this has to raise the
    # same located error @onError does. it used to print and hand back null,
    # which put a null node into the ast and then blew up two passes later
    # in returner or renderer, a long way from what actually went wrong
    
    error: o tokens ->
        
        @pop o.pop if o.pop
        @onError o.msg tokens:tokens
        
export Parser
