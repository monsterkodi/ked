
use ../kxk ◆ klor kstr slash nfs
use ./print

klor.globalize()

comps    = 0
succs    = 0
fails    = []
stack    = []
allfails = []
allsuccs = 0
columns  = 60

■Tester

    @: ->

        @plain  = false
        @filter = []

    #  filter terms match the section names level by level: ['popo' 'sheet cursor']

    setFilter: text =>

        @filter = text.toLowerCase().split('/').filter (t) -> t.length

    skips: depth name =>

        term = @filter[depth-1]
        term? and not name.toLowerCase().includes term

    #  the first stack frame outside the tester, mapped to the kode source

    location: err =>

        for line in (err ? new Error()).stack.split('\n')[1..]
            continue if /tester\.(js|kode)/.test line
            continue if line.includes 'node:'
            if m = /\(?([^\s(]+):(\d+):\d+\)?$/.exec line
                file = m[1].replace 'file://' ''
                ⮐ "#{slash.relative(file process.cwd())}:#{m[2]}"
        ''

    section: t f ◯=>

        ⮐ if @skips stack.length+1 t

        stack.push t
        comps = 0
        depth = stack.length
        if @logSections != false
            log W1(lpad(depth*3-1) + ' ' + global["g#{max(1, 8-2*depth)}"](kstr.crop(t, columns+1-depth*3) + ' '))
        try
            ◯ f()
        catch err
            fails.push
                stack: stack.concat([comps])
                comps: comps
                lhs:   "#{err}"
                rhs:   ''
                where: @location(err)

        stack.pop()
        
    sameObjects: a b keystack ->
        
        if 
            Object.is a, b # simple types
                
                ⮐ true
                
            typeof a != typeof b # types differ
                
                ⮐ false
            
            a is arr and b is arr
                
                if a.length != b.length 
                    ⮐ false
                for i in 0...a.length
                    if not @sameObjects a[i], b[i]
                        ⮐ false
                ⮐ true
            
            a is str and b is str

                if a != b
                    if not @plain
                        log r5(@showSpace(a))
                        log g3(@showSpace(b))
                    ⮐ false
                ⮐ true
            
            a is obj and b is obj
                
                sameKeys = @sameObjects Object.keys(a), Object.keys(b)
                sameVals = @sameObjects Object.values(a), Object.values(b)
                # log 'sameKeys sameVals' sameKeys and sameVals
                ⮐ sameKeys and sameVals
        
        a == b
    
    compare: a b =>
        
        comps++
                        
        if typeof b == 'function'
            if b(a)
                succs++
                return
        
        if @sameObjects a, b
            succs++
            return

        if not @plain
            ind = lpad (stack.length+1)*3
            log R1(black(ind + comps + ' ')) + ' ' + r5(@short(a)) + ' ' + R1(r4(' ▸ ')) + ' ' + g1(@short(b))

        fails.push
            stack: stack.concat([comps])
            comps: comps
            lhs:   a
            rhs:   b
            where: @location()
            
    test: testModule ◯=>
        
        # return if not /\n\s*▸\s\w+/gm.test text
        ⮐ if testModule?._test_ != true
        
        comps = 0
        succs = 0
        fails = []
        stack = []
                
        global.compare = @compare
        global.section = @section
        
        logModules = @logModules
            
        keys = Object.keys testModule
        
        for k in keys
            
            v = testModule[k]
            
            if v._section_
                continue if @skips 1 k
                stack.push k
                if logModules != false
                    log G1(y8(' ' + kstr.crop(k, columns) + ' '))
                try
                    ◯ v()
                catch err
                    fails.push
                        stack: stack.concat([comps])
                        comps: comps
                        lhs:   "#{err}"
                        rhs:   ''
                        where: @location(err)
                stack.pop()
                                        
        allsuccs += succs
        allfails = allfails.concat fails
        
        empty fails
        
    showSpace: s ->
        
        if not s is str
            ⮐ noon s
        s.split('\n').map((l) -> l+w2('◂')).join '\n'
    
    timesText: times ->
        
        s = ''
        for time in times
            s += ' ' + b5(time.name) + ' ' + b2(time.ms) + '  '
        s
    
    #  one line per value: strings quoted with escapes, everything else as json

    oneLine: v ->

        ⮐ '<predicate>' if typeof v == 'function'
        ⮐ String(v)     if v == undefined
        try
            JSON.stringify(v) ? String(v)
        catch err
            String(v)

    summarize: (times) ->

        if @plain
            for fail in allfails
                log "✘ #{fail.stack.join ' ▸ '}  #{fail.where ? ''}"
                log "  actual:   #{@oneLine fail.lhs}"
                log "  expected: #{@oneLine fail.rhs}" if fail.rhs != ''
            if valid allfails
                log "#{allfails.length} failed, #{allsuccs} passed"
            else
                log "#{allsuccs} passed"
            allfails = []
            allsuccs = 0
            ⮐

        for fail in allfails
            log R2(y5(' ' + fail.stack[0] + ' ')) + R1(y5(' ')) + fail.stack[1..].join(r3(' ▸ ')) + ' ' + w3(fail.where ? '')
            log r5(@showSpace(fail.lhs))
            log R1(r3(' ▸ '))
            log g3(@showSpace(fail.rhs))

        if allsuccs or fails.length
            summary  = '\n '
            if valid allfails
                summary += R2 y2(' ✘ ') + y6(allfails.length) + y3(' failure' + (allfails.length > 1 ? 's ' : ' ')) 
            else if allsuccs
                summary += g1(allsuccs) + g3(" ✔ ") + ' ' 
                summary += @timesText(times) if valid times
            log summary

        allfails = []
        allsuccs = 0

    short: s ->
        
        ⮐ s if empty s
        
        split = (''+s).split '\n'
        
        l = 0
        split = split each (v) ->
            if valid v
                v = ''+v
         
        split = split.filter (s) -> s.length
            
        ss = split.join w2('➜ ')
        ss
        
export new Tester

◆main
    
    files =◯ nfs.list slash.path(◆dir, 'test')
    fail = false
    for file in files
        continue if slash.name(file.path) == 'utils'
        test =◯ import(file.path)
        tester = new Tester
        tester.logSections = false
        tester.logModules = false
        ok =◯ tester.test test.default
        fail = true if ok == false # undefined: not a test module
    tester.summarize()
    if fail
        process.exit 1
    
