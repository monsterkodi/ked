###
    ████████    ███████   ████████    ███████  ████████
    ███   ███  ███   ███  ███   ███  ███       ███     
    ████████   █████████  ███████    ███████   ███████ 
    ███        ███   ███  ███   ███       ███  ███     
    ███        ███   ███  ███   ███  ███████   ████████
    
    the base class of Parser
        
    converts token blocks to an abstract syntax tree:
        
        exps: [top level expressions ...]
        
    expressions are build recursively
    
      ┌─▶ @exps ──────────┐
      ├─▶ ┌─▶─┐ @exp ─────┤
      │   ▲   ▼ ┌▶╷ @rhs ─┼─▶ Parser methods ▶─┐
      │   └─◀─┘ ╵◀┘ @lhs ─┘                    │
      └────────────────────────────────────────┘
###

use ./utils ▪ firstLineCol lastLineCol
use         ◆ print parseutils

# a word that means nothing standing on its own. each one is a javascript
# reserved word or a kode keyword that renders as one: 'else' after an if,
# 'catch' after a try, 'in' after whatever is being iterated, 'extends'
# inside a class, 'when' inside a switch. the parser for the construct that
# goes with them is what normally eats them.
#
# at the head of an expression is the one place they can have neither a left
# operand nor a right one, and the renderer hands node the bare word, which
# node cannot parse. further along they are an operation or a keyword the
# loop in @exp attaches to what came before, and all of that is fine - which
# is why the test below is about what is left of the token list and not
# about the token alone.
#
# three groups are deliberately not here. 'new' and 'delete' want an
# operand too, but kode uses both as plain names - {new: new} and {delete:
# delete} are what object.kode says they should compile to - and a word that
# renders as an ordinary identifier is a name, so the compiler cannot tell a
# forgotten call from a variable. 'break' and 'continue' want a loop around
# them rather than an operand, and they say so by compiling to javascript
# node refuses; what is missing there is a loop, not an operand, and
# kode.kode:278 leans on a bare 'continue'. and every function-like keyword
# - 'abs', 'clamp', 'empty', 'first', 'int', 'last', 'max', 'min', 'noon',
# 'of', 'trim' and the rest - is in that same first group.

wantsOperand = ['else' 'catch' 'finally' 'throw' 'super' 'extends' 'when'
                'in' 'await' 'typeof']

# javascript's reserved words, and the check on them is one list rather than
# two. kode emits a module, a module is always strict, and in a module 'let'
# is exactly as unavailable as 'var'. there is no line in the language to
# draw at, so a compiler that rejected one and not the other would only be
# right by accident.
#
# 'null', 'true', 'false' and 'this' are left out. they are values rather
# than names - 'x = null' is exactly right and 'this.x' is ordinary
# javascript - and 'NaN' and 'eval' are not reserved at all, they are
# globals a module is free to shadow.
#
# only words the lexer hands on as plain names, or as keywords kode does not
# dispatch, reach the test. 'new' and 'delete' are in the list and are not
# tested: they are kode operators, and object.kode says {new: new} and
# {delete: delete} are what they should compile to, so the compiler cannot
# tell one from a forgotten call. 'class' and 'while' are dispatched before
# the test is reached and have better things to say.

# the brackets are not decoration. a bare sequence of strings after an '=' is
# a call, and 'reserved' came out as the one word 'await' - which then made
# the test below a substring search, so 'a' matched. the same thing ate the
# snips in srcmap.kode. the '[' has to be on this line for the same reason

reserved = [
    'await'  'break'    'case'      'catch'     'class'      'const'
    'continue' 'debugger' 'default' 'delete'    'do'         'else'
    'enum'   'export'   'extends'   'finally'   'for'        'function'
    'if'     'implements' 'import'  'in'        'instanceof' 'interface'
    'let'    'new'      'package'   'private'   'protected'  'public'
    'return' 'static'   'super'     'switch'    'throw'      'try'
    'typeof' 'var'      'void'      'while'     'with'       'yield'
    ]

# the reserved words that javascript will still have as a property name.
# there are two kinds here and the difference matters: {static: s} is fine and
# {do: 1} is not, a.let is fine and let.a is not.
#
# this is what makes a method called 'if' work - 'if:', 'for:', 'while:',
# 'class:' and 'function:' are all methods in parser.kode - and a method is a
# property under the class, so a keyword in key position needs no exemption
# of its own.

nameable = ['await' 'enum' 'implements' 'interface' 'let' 'package' 'private' 'protected' 'public' 'static' 'yield']

# operators that can go in front of a value. what is missing is the value and
# not whatever would have been to their left

wantsRight = ['+' '-' '~' '!']

# operators that only ever sit between two values. at the head of an
# expression there is nothing to their left, and that is what they are
# missing - what is on the right, if anything, is of no use to them

wantsLeft = ['*' '/' '%' '^' '&' '|' '<' '>' '=' '==']

# the two ends of a slice and of a range. they belong to the value on their
# left, and there is none.
#
# '...' is left out on purpose: the renderer reads a '...' straight after a
# name in an argument list as a rest parameter - '(args...)' is '(...args)' -
# so a '...' there is not a slice with nothing in front of it.

wantsSlice = ['..']

# tokens that say which of a pair something is, and so want both halves. one
# bracket alone is unclosed rather than pairless, so it gets the message the
# unclosed case already has
#
# '▴' is a callee and never a value, so what is missing is its argument

needsPair =
    '(':  'parens is missing closing )'
    '[':  'array is missing closing ]'
    '{':  'curly is missing closing }'
    ',':  "missing expression after ','"
    '.':  'property access is missing property name'
    ':':  ': is missing a key and a value'
    '▴':  'assert is missing what to assert'

# what closes each opener. [] is an empty array and () is an empty call, so
# an opener followed by its own closer is not an unclosed one

closers = '(':')' '[':']' '{':'}'

function Parse extends parseutils

    @: @kode ->

        @debug    = @kode.args.debug
        @verbose  = @kode.args.verbose
        
    onError: msg info -> @kode.onError msg info

    # ████████    ███████   ████████    ███████  ████████
    # ███   ███  ███   ███  ███   ███  ███       ███
    # ████████   █████████  ███████    ███████   ███████
    # ███        ███   ███  ███   ███       ███  ███
    # ███        ███   ███  ███   ███  ███████   ████████

    parse: block -> # convert block tree to abstract syntax tree

        @stack = []
        @sheap = []

        vars: [] 
        exps: @exps('tl' block.tokens)

    # ████████  ███   ███  ████████    ███████
    # ███        ███ ███   ███   ███  ███
    # ███████     █████    ████████   ███████
    # ███        ███ ███   ███             ███
    # ████████  ███   ███  ███        ███████

    # consumes tokens and returns a list of expressions
    #
    # the entry point for ...
    #   - the top level scope
    #   - class and function bodies
    #   - argument lists
    #   - arrays and objects
    #   - parens
    #   - ...
    # essentially everything that represents a list of something

    exps: rule tokens stop ->
        
        ⮐ if empty tokens
        
        @sheapPush 'exps' rule
        
        es = []
                        
        while tokens.length
            
            numTokens = tokens.length

            tok = tokens[0]
            
            doBreak = switch @stack[-1]
            
                '▸arg'      ➜ es.length
                'switch'
                'if' 'then' 
                '▸else'     ➜ tok.text == 'else'
                '['         ➜ tok.text == ']'  
                '{'         ➜ tok.text in ['}' '->' '=>' '○->' '○=>' '(' '▸' ':' ']']
                '('         ➜ tok.text == ')'
                '○rgs'      ➜ tok.type == 'func'
                '▸args'     ➜ tok.text in [']' ';' 'else' 'then']
                '▸return'   ➜ tok.text == 'if'
                'call'      ➜ tok.text in ';' # bail out for implicit calls
                rule        ➜ tok.text == stop and tok.type != 'var'
                            ➜ false

            if doBreak
                @verb "exps break for #{tok.text} and stack top" @stack 
                break 
                
            if stop and tok.text == stop and tok.type != 'var'
                @verb "exps break for #{tok.text} and stop" stop 
                break 
                    
            if tok.type == 'block'
    
                if stop in ['nl'';']
                    @verb "exps block start with stop #{stop} break!"
                    break
                
                block = tokens.shift()
    
                @verb "exps block start stop #{stop} block:" block

                blocked = true
                blockExps = @exps 'block' block.tokens
                
                es = es.concat blockExps

                if block.tokens.length
                    @verb 'exps block end remaining block tokens:' block.tokens.length
                    print.tokens 'before unshifting dangling block tokens' tokens if @debug
                    while block.tokens.length
                        tokens.unshift block.tokens.pop()
                    print.tokens 'exps after unshifting dangling block tokens' tokens if @debug
                    
                if tokens[0]?.text == ','
                    @verb "exps block end shift comma , and continue..."
                    tokens.shift()
                    continue
                    
                else if tokens[0]?.type == 'nl' and tokens[1]?.text == ','
                    @shiftNewline "exps block end nl comma , and continue..." tokens
                    tokens.shift()
                    continue
                    
                @verb 'exps block end, break!'
                break
                
            # a closing bracket with nothing open. ')' breaks out of whatever
            # paren is on the stack; the other two have no such escape,
            # so they are unmatched here - which is how a stray ] or }
            # used to sail through and render as itself
            
            if tok.text in [')' ']' '}']
                if '(' in @stack or 'args(' in @stack
                    @verb "exps break on #{tok.text}"
                    break
                @onError 'unmatched closing bracket' tok:tok
            if tok.text in ['in''of'] and rule == 'for vals' ➜ @verb 'exps break on in|of' ; break
            if tok.type == 'nl' 
                
                @verb 'exps nl stop:' stop tok @stack
                    
                if @stack[-1] == '[' and tokens[1]?.text == ']'
                    @shiftNewline 'exps nl ] in array' tokens
                    break
                    
                if stop
                    @verb 'exps nl with stop' stop
                    if @stack[-1] in ['▸args' '▸body' '▸return' 'then' '▸else'] or stop != 'nl'
                        @verb "exps nl with stop '#{stop}' in #{@stack[-1]} (break, but don't shift nl)"
                    else
                        @shiftNewline "exps nl with stop '#{stop}'" tokens 
                    break 

                nl = @shiftNewline "exps nl (no stop) ..." tokens
                
                if tokens[0]?.text == '.' and tokens[1]?.type == 'var'
                    log 'exps nl next line starts with .var!' @stack if @debug
                    es.push @prop(es.pop() tokens)
                    
                @verb 'exps nl continue...'
                continue
                
            if tok.text == ',' 
                if @stack[-1] in ['▸args']
                    @verb 'exps comma continues args ...'
                    tokens.shift()
                    if tokens[0]?.type == 'block'
                        @verb 'exps comma followed by block ...'
                        tokens = tokens.shift().tokens
                    continue
                    
            if tok.text == ';' and tokens[1]?.text != ':'
                @verb "exps shift semicolon ; and continue..."
                tokens.shift()
                continue
                
            e = @exp tokens

            last = lastLineCol e
            
            while ( tokens[0]?.text in ['if' 'for' 'while'] and 
                    @noThenAhead(tokens) and
                    @stack[-1] not in ['▸args' '▸return'] and
                    last.line == tokens[0].line )

                @verb "exps #{tokens[0].text }Tail" e @stack
                switch tokens[0].text
                    'if'    ➜ e = @ifTail    e tokens.shift() tokens
                    'for'   ➜ e = @forTail   e tokens.shift() tokens
                    'while' ➜ e = @whileTail e tokens.shift() tokens
                    
            
            if tokens[0]?.text == '▸'
                if @stack[-1] in ['▸args' '{']
                    es.push e
                    break
                else
                    e = @compare e tokens
                    
            es.push e
            
            if  (   tokens[0]?.text in ['if''then''for''while'] and 
                    tokens[0].col > last.col and
                    es.length and 
                    not blocked and
                    last.line == tokens[0].line)
                    
                @verb 'exps break on if|then|for|while' 
                break 
            
            if tokens[0]?.text == ';' 
                if @stack[-1] not in ['▸args' 'when' '{']
                    @verb 'exps shift colon' @stack
                    colon = tokens.shift()
                else
                    @verb 'exps break on colon' @stack
                    break
            
            if numTokens == tokens.length
                @verb 'exps no token consumed' tokens # happens for unbalanced closing ]
                break

        @sheapPop 'exps' rule
        
        es

    # ████████  ███   ███  ████████
    # ███        ███ ███   ███   ███
    # ███████     █████    ████████
    # ███        ███ ███   ███
    # ████████  ███   ███  ███

    # consumes tokens and returns a single expression
    #
    # expression can be anything, from single digits to whole classes 
    # but it is always a single object
    #
    # assumes that the handling of newlines is done somewhere else
    # skips over leading semicolons

    exp: tokens ->

        ⮐ if empty tokens

        tok = tokens.shift()

        log Y5(w1(tok?.text)) if @debug

        # this one sits above the dispatch below on purpose. 'await' and
        # 'when' are keywords the parser does claim, and it is their own
        # methods that hand an empty token list to @exp and get nothing back
        # - so the token has to be judged before the dispatch hands it over.
        #
        # it asks not 'is anything left' but 'is there anything here this
        # token could work with'. an expression that ends here - at the end
        # of the tokens, at a newline, or at one of the tokens that close a
        # bracket or separate two things - has nothing to offer.
        #
        # it steps aside when it is looking at the right side of a prefix
        # operation. @operation sets @prefixOperand around its own call to
        # @exp and has a check of its own for that case, which names the
        # operator that came up short rather than the one it swallowed.
        #
        # the types are part of the test. a string that reads 'throw' is a
        # string, and a comment that reads '*' is a comment.

        if tok.type in ['keyword' 'op' 'punct' 'paren' 'dots' 'assert'] and not @prefixOperand

            nxt = tokens[0]

            alone = not nxt or nxt.type == 'nl' or nxt.text in [')' ']' '}' ';' ',']

            if nxt and nxt.text == closers[tok.text]
                alone = false

            if alone
                if m = needsPair[tok.text]
                    @onError m tok:tok
                # a bare '++' or '--' has nothing to increment. it cannot be
                # read as a prefix here - there is no operand in front of it -
                # so it is the postfix with the variable left out, and it says
                # so in the same words as '1++'
                if tok.text in ['++' '--']
                    @onError "#{tok.text} is missing a variable to increment" tok:tok
                if tok.text in wantsRight
                    @onError "#{tok.text} is missing a right operand" tok:tok
                if tok.text in wantsLeft or tok.text in wantsSlice or tok.text in wantsOperand
                    @onError "#{tok.text} is missing an operand" tok:tok

        switch tok.type
            
            # an `error` call renders as console.error and does not raise, so these
            # used to print on stdout and carry on parsing. @onError is the
            # one that throws, with a location
            
            'block'     ➜   ⮐ @onError "unexpected block token in exp!" tok:tok
            'nl'        ➜   ⮐ @onError "unexpected nl token in exp!" tok:tok
            ';'         ➜   ⮐ @onError "unexpected ; token in exp!" tok:tok
            'section'   ➜   ⮐ @section tok, tokens                
            'keyword'       # dispatch to block rules identified by keyword
                            if tokens[0]?.text not in ':' # allow keywords as dictionary keys
                                
                                if tok.text == 'import'
                                    if tokens[0]?.text == '(' # this is really ugly! implement dynamic inline use
                                        tok.type = 'call'
                                        ⮐ @call tok, tokens
                                    else if tokens[0]?.text in '.'
                                        break
                                
                                switch tok.text
                                    'return'   ➜ ⮐ @return   tok tokens
                                    'switch'   ➜ ⮐ @switch   tok tokens
                                    'class'    ➜ ⮐ @class    tok tokens
                                    'function' ➜ ⮐ @function tok tokens                        
                                    'await'    ➜ ⮐ @await    tok tokens
                                    'import'   ➜ ⮐ @import   tok tokens
                                    'export'   ➜ ⮐ @export   tok tokens
                                    'while'    ➜ ⮐ @while    tok tokens
                                    'when'     ➜ ⮐ @when     tok tokens
                                    'use'      ➜ ⮐ @use      tok tokens
                                    'try'      ➜ ⮐ @try      tok tokens
                                    'for'      ➜ ⮐ @for      tok tokens
                                    'if' 
                                        if @stack[-1] not in ['▸return']
                                            @verb 'if' @stack if @stack.length
                                            ⮐ @if tok tokens
                        ➜   switch tok.text
                                '○' ➜ ⮐ @await tok tokens
                                '->' '=>' '○->' '○=>'
                                    if @stack[-1] not in ['{']
                                        ⮐ @func null tok tokens

        # a reserved word standing where javascript wants a value. the lexer
        # has no opinion about most of these and hands them on as names, so
        # this is the last place that can tell - by here it is
        # indistinguishable from a variable called 'var'.
        #
        # it sits below the dispatch above rather than beside the other tests
        # above it, because a dispatched keyword has a kode meaning to be
        # given first. 'class' is a class with no name and 'while' is a while
        # with no condition; neither is better described as a reserved word.
        #
        # 'in' is the one keyword worth testing. it only ever appears between
        # two values and never at the head of one, so nothing that works
        # today can reach here carrying it - while 'super' is reached every
        # day, as 'super screen name'.

        if (tok.type == 'var' or tok.text == 'in') and tok.text in reserved
            key = tokens[0]?.text == ':' and (tok.type == 'keyword' or tok.text in nameable)
            if not key
                @onError "#{tok.text} is a javascript reserved word" tok:tok

        # '?' is a postfix. it turns what is in front of it into a
        # conditional, so there is nothing it can be at the head of - a '?'
        # here is a conditional with nothing in front of it, and it was being
        # rendered as itself. '?=' is a different token and is not caught.
        #
        # a '.' or an operator behind it is not something a conditional could
        # use, and both are handled further down where they say something
        # better: '?.' is a property access with no property name, and
        # '? ===' is an '=' with nothing to assign.

        nxt = tokens[0]

        if tok.text == '?' and not (nxt and (nxt.text == '.' or nxt.type == 'op'))
            @onError '? is missing a left operand' tok:tok

        @sheapPush 'exp' tok.text ? tok.type
        
        if tok.type != 'paren' and '○rgs' not in @stack # treat methods and funcs with minimal args
            
            if @stack[-1] == ':' and @stack[-2] == 'class' or # class/function  m: a b -> 
               @stack[-1] == 'op=' and not @blockAssign or  # f = a b ->
               @stack[-1] == ':' and @stack[-2] == '{' and not '▸args' in @stack # object m: a b -> 
                
                if @funcAhead tokens
                    
                    paren = @argsWithoutParens tok, tokens
                    @sheapPop 'exp' tok.text ? tok.type
                    ⮐ @lhs paren, tokens
                    
        e = tok
        while tokens.length                 # repeatedly call rhs and lhs until all tokens are swallowed
            
            numTokens = tokens.length
            
            e = @rhs e tokens               # first, try to eat as many tokens as possible to the right
            
            print.ast "rhs" e if @debug

            e = @lhs e tokens               # see if we can use the result as the left hand side of something
            
            print.ast "lhs" e if @debug

            if tokens[0]?.text in ';'
                @verb 'exp break on ;' tokens[0]?.text
                break
            
            if numTokens == tokens.length    # simple expansion to the left and right didn't succeed
                
                if tokens[0]?.text in ','               # next token is comma
                    if @stack[-1] in ['▸args']          # and we are in arguments
                        @verb 'comma in args, break without shifting'
                        break                               # those are parsed with @exps ➜ give back one arg
                        
                    if @stack[-1]?.startsWith 'op'
                        @verb 'comma in operation, break without shifting'
                        break
                        
                    # a comma with nothing after it, at the end of a
                    # statement. inside a literal a trailing comma is fine
                    # - js allows '[1,2,]' and '{a:b,}' - and those have a
                    # closing bracket or a stack entry behind them
                    
                    if empty @stack and empty tokens[1]
                        @onError "missing expression after ','" tok:tok
                        
                    @verb 'exp shift comma'
                    tokens.shift()                      # probably in a list or something similar ➜ ignore comma
                    
                if tokens[0]?.type == 'block'           # next line is indented
                    if tokens[0].tokens[0]?.text == '.' # and starts with property access ...
                        @verb 'exp prop chain block! shift block and continue ...'
                        @push 'propchain' + tokens[0].tokens[0].col
                        block = tokens.shift()
                        e = @prop e block.tokens
                        if block.tokens.length
                            @verb 'dangling prop chain tokens' block.tokens @stack[-1]
                            tokens = block.tokens
                            continue
                        break
                        
                if tokens[0]?.type == 'nl'              # next line is not indendented
                    if tokens[1]?.text == '.'           # and starts with property access ...
                        if "propchain#{tokens[1]?.col}" in @stack[..-2]
                            @verb 'exp higher level prop chain active! break!'
                            break
                        @verb 'exp prop chain block continues on next line! shift nl and continue ...'
                        @shiftNewline 'exp prop chain block continues' tokens
                        continue
                    
                @verb 'exp no token consumed: break!' @stack[-1]
                break # bail out because no token was consumed to prevent endless recursion
            
        print.ast "exp #{if empty(@stack) then 'DONE' else ''}" e if @debug
        
        if @stack[-1]?.startsWith 'propchain'
            @verb "exp cleanup #{@stack[-1]}"
            @pop @stack[-1]
        
        @sheapPop 'exp' tok.text ? tok.type
        e        

    # ████████   ███   ███   ███████  
    # ███   ███  ███   ███  ███       
    # ███████    █████████  ███████   
    # ███   ███  ███   ███       ███  
    # ███   ███  ███   ███  ███████   
    
    # recursively build up stuff that can be identified by looking at the next token only:
    #
    # anything that opens and closes
    #   - objects
    #   - arrays
    #   - parens
    #
    # but also 
    #   - single operand operations
    
    rhs: e tokens ->
        
        @sheapPush 'rhs' 'rhs'
        
        while nxt = tokens[0]
            
            numTokens = tokens.length
            
            if not e
                @onError 'missing expression on the left' tok:nxt
            
            unspaced = (llc = lastLineCol(e)).col == nxt.col and llc.line == nxt.line
            spaced = not unspaced

            if nxt.text in '({' and e.type in @kode.literals
                break
                
            if nxt.text == '▸' then @verb 'rhs break for ▸'; break
            
            if @stack[-1] == '▸arg' and nxt.type == 'op' then @verb 'rhs break for ▸arg'; break
           
            if 
                nxt.text == ':' and @stack[-1] in ['class']
                
                    print.tokens 'rhs is class method' tokens[..20] if @debug
                    e = @keyval e tokens
                    break
                
                nxt.text == ':' and (unspaced or ('?' not in @stack))
                    
                    if @stack[-1] != '{'
                        @verb 'rhs is first key of implicit object' e
                        print.tokens 'rhs is first key of implicit object ...' tokens[..20] if @debug
                        e = @object e tokens
                    else
                        @verb 'rhs is key of (implicit) object' e
                        e = @keyval e tokens
                    
                nxt.text == 'in' and @stack[-1] != 'for'
                
                    @verb 'incond' e tokens
                    e = @incond e tokens
                
                e.text?
                
                    if      
                        e.text == '['   ➜ e = @array  e tokens
                        e.text == '('   ➜ e = @parens e tokens
                        e.text == '{'   ➜ e = @curly  e tokens
                        e.text in ['not'] and (nxt.type not in ['op'] or nxt.text in ['++' '--' '+' '-' ]) ➜ e = @operation(null, e, tokens)
                        e.text in ['delete''new''empty''valid''noon''copy''clone'] and (nxt.type not in ['op''nl'] and nxt.text not in ',.}])') ➜ e = @operation(null, e, tokens)
                        # nxt can be a block, and a block token has no text
                        e.text in ['first''last'] and (nxt.type not in ['op''nl'] and nxt.text?[0] not in ',.}])') ➜ e = @operation(null, e, tokens)
                        e.text in ['++''--'] and unspaced
                            @verb 'rhs increment'
                            e = @operation null e tokens
                        e.text in ['+''-'] and unspaced
                            if nxt.type == 'num'
                                @verb 'rhs +- num'
                                if e.text == '-'
                                    nxt.text = '-' + nxt.text
                                    nxt.col -= 1
                                e = tokens.shift()
                            else
                                @verb 'rhs +- operation'
                                e = @operation null e tokens
                        nxt.text in ['++''--'] and unspaced
                            if e.type not in ['var']
                                @onError "#{nxt.text} is missing a variable to increment" tok:nxt
                            e = @operation e tokens.shift()
                        ➜
                            print.tokens "rhs no nxt match? break! stack:#{@stack} nxt:" [nxt] if @debug
                            break                    
                    
                ➜ # e is not a token anymore
                
                    if
                        # '[a]++' and '{a:1}++' come through here rather than
                        # through the check above, which only ever sees a token.
                        # a postfix ++ or -- needs something node can assign to
                        nxt.text in ['++''--']  and unspaced        ➜ @checkPostfix e nxt; e = @operation e tokens.shift();  break
                        @stack[-1] == 'call'    and nxt.text == ']' ➜ @verb 'rhs call array end';       break
                        @stack[-1] == '{'       and nxt.text == '}' ➜ @verb 'rhs curly end';            break                    
                        @stack[-1] == '['       and nxt.text == ']' ➜ @verb 'rhs array end';            break
                        ➜
                            print.ast "rhs no nxt match?? stack:#{@stack} e:" e if @debug
                            print.tokens "rhs no nxt match?? nxt:" nxt if @debug
                            # log noon e
                            break
                    
            if numTokens == tokens.length
                @verb 'rhs no token consumed, break!'
                break
                            
        @sheapPop 'rhs' 'rhs'
        e
        
    # ███      ███   ███   ███████  
    # ███      ███   ███  ███       
    # ███      █████████  ███████   
    # ███      ███   ███       ███  
    # ███████  ███   ███  ███████   
    
    # recursively build up stuff that can be identified by looking at the next token *and* what was just parsed
    #
    # anything that can be chained
    #   - operations
    #   - properties
    #   - calls
    
    lhs: e tokens ->
        
        @sheapPush 'lhs' 'lhs'
        
        while nxt = tokens[0]
            
            numTokens = tokens.length
            
            if not e
                @onError 'missing expression on the right' tok:nxt
            
            last  = lastLineCol  e
            first = firstLineCol e
            unspaced = last.col == nxt.col and last.line == nxt.line
            spaced = not unspaced

            b = switch @stack[-1]
                '[' ➜ nxt.text == ']'
                '{' ➜ nxt.text == '}'
                
            break if b
            
            if e.text == '@' and unspaced and tokens[0].type in ['var''keyword''op']
                e = @this e tokens
                break
                
            if e.text == '◆' and nxt.text in ['file' 'dir'] 
                e = @dirFile e tokens
                break

            if e.text == '◆' and nxt.text == 'main'
                e = @main e tokens
                break
                
            if      
                nxt.text == '.'    ➜ e = @prop(e tokens)
                nxt.type == 'dots' and not @stack[-1]?.startsWith('op') and @stack[-1] != '(' and '○rgs' not in @stack ➜ e = @slice(e tokens)
                nxt.text == 'each' ➜ e = @each(e tokens)
                nxt.text == '?' 
                
                    if unspaced
    
                        e = @assert e tokens
                        
                    else
                        
                        e = @qmrkop e tokens
                    
                nxt.text == ':' and e.qmrkop
                
                    e = @qmrkcolon e.qmrkop tokens
                
                (   nxt.type == 'op' and 
                    nxt.text not in ['++' '--' '+' '-' 'not' 'noon' 'new' 'empty' 'valid'] and 
                    e.text not in ['[' '('] and                     
                    '▸arg' not in @stack)
                    
                    if 
                        @stack[-1]?.startsWith 'op' and @stack[-1] != 'op='
                            @verb 'lhs stop on operation' e nxt
                            break
                        @stack[-1] in ['in?' 'opempty' 'opvalid']
                            @verb "lhs stop on #{@stack[-1]}" e nxt
                            break
                        nxt.text == '▸'
                            @verb "lhs break on ▸"
                            break
                        ➜
                            @verb 'lhs is lhs of op' e nxt
                            e = @operation e tokens.shift() tokens
                
                (   nxt.text in ['+' '-'] and 
                    e.text not in ['[' '('] and
                    spaced and tokens[1]?.col > nxt.col+nxt.text.length)
                    
                    @verb 'lhs is lhs of +-\s' e, nxt
                    e = @operation e tokens.shift() tokens
            
                nxt.type == 'func' and e.parens
                    @verb 'lhs is args for func' e
                    e = @func e tokens.shift() tokens
                
                nxt.text == '(' and unspaced
                    @verb 'lhs is lhs of call'
                    e = @call e tokens
                    
                nxt.text == '[' and unspaced and tokens[1]?.text != ']'
                    @verb 'lhs is lhs of index' e
                    e = @index e tokens
                
                nxt.text == 'not' and tokens[1]?.text == 'in'

                    e = operation:
                        operator:tokens.shift()
                        rhs:@incond(e tokens)

                # Probably the most critical point of the whole parsing shenanigans:
                # Trying to figure out if the current left hand side is a function which is 
                # called with the upcoming stuff as arguments.
                # Since we have no syntax available, we need to figure it out from the context alone,
                # which is the reason this is uglier than one would normally expect:
                        
                (   spaced and 
                    (nxt.line == last.line or (nxt.col > first.col and @stack[-1] not in ['if''when'])) and
                    '○rgs' not in @stack and
                    '[' not in @stack and
                    @stack[-1] not in ['(' 'call' 'args(' 'op|' 'op&' 'op/' 'op*' 'op+' 'op-'] and
                    (@stack[-1] not in ['▸args' ':'] or (nxt.line > last.line and nxt.col > first.col)) and
                    nxt.text not in ['then' 'when' 'else' 'break' 'continue' 'in' 'of' 'for' 'while'] and
                    (nxt.text not in ['if'] or not @noThenAhead(tokens)) and
                    nxt.text not in ',.;:)}]' and
                    nxt.type not in ['nl'] and
                    (nxt.type != 'op' or nxt.text in ['++''--''noon''new''not'] or nxt.text in ['+''-'] and tokens[1]?.col == nxt.col+1) and
                    @isSuitableForImplicitCall(e) )

                    @verb 'lhs is lhs of implicit call! e' e, @stack[-1]
                    @verb '    is lhs of implicit call! nxt' nxt
                    @verb '    is lhs first' first 
                    e = @call e tokens
                    break

                nxt.text in ['+' '-'] and e.text not in ['[' '(']
                    if spaced and tokens[1]?.col == nxt.col+nxt.text.length
                        @verb 'lhs op is unbalanced +- break...' e nxt @stack
                        break
                    @verb 'lhs is lhs of +- op' e nxt
                    e = @operation e tokens.shift() tokens
                                
                ➜             
                    print.tokens "lhs no nxt match? break! stack:#{@stack} nxt:" [nxt] if @debug
                    print.ast "lhs no nxt match? break! stack:#{@stack}" e if @debug
                    if nxt.type == 'block' 
                        if  @isSuitableForImplicitCall(e) and 
                            @stackAllowsBlockArg() and
                            nxt.tokens[0]?.text not in ['then' 'when'] and
                            @stack[-1] not in ['if' 'then' 'for' 'while' 'switch' 'when' 'catch' 'in?' '▸args' 'class' 'function' 'op+' 'op-' 'opis' 'opor' 'opand' 'op==' 'opnot' 'op<' 'op>']
                                @verb 'blocked call arg' @stack e nxt
                                e = @call e tokens
                        # else
                            # log 'suitable?' @isSuitableForImplicitCall(e)
                            # log 'allowblock?' @stackAllowsBlockArg()
                            # log 'stack[-1]?' @stack[-1] not in ['if' 'then' 'for' 'while' 'switch' 'when' 'catch' 'in?' '▸args' 'class' 'function' 'op+' 'op-' 'opis' 'opor' 'opand' 'op==' 'opnot' 'op<' 'op>']
                    break                    
            
            if numTokens == tokens.length
                # error 'lhs no token consumed?'
                break
                
        @sheapPop 'lhs' 'lhs'     
        e
        
export Parse
