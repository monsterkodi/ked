
use ../kxk ◆ kstr slash nfs
use module

# node's own source map reader carries this file's class name too, so it
# comes off the module object under one of its own

NodeSourceMap = module.SourceMap

■SourceMap
    
    @: (@source, @name) ->
        
        @toks     = [] # [js, tok] per tag, in the order they were marked
        @lines    = [] # LineMap per generated line
        @stripped = 0  # tags read back out of the finished js
        @verbose  = false

    verb: -> if @verbose then console.log.apply console.log, arguments

    # tag a token's rendered text with its own number
    
    mark: (s, tok) ->
        
        @toks.push [s, tok]
        i = @toks.length-1
        s + '\u0001' + i + '\u0001'

    # the same text with the tags taken out again. the renderer matches and
    # slices its own output in places, and that has to go on text looking
    # the way it would look without a map
    
    plain: (s) -> s.replaceAll /\u0001\d+\u0001/g, ''
    
    # take every tag out of the finished js, remembering where each one
    # stood: that is where its token landed in the generated file
    
    strip: (code) ->
        
        ⮐ code if empty code
        
        out  = ''
        li   = 0 # line in the generated js, 0-based
        col  = 0 # column just past the last character taken over
        sli  = 0 # the same, as of the last tag read
        scol = 0
        pos  = 0 # everything before this has been read and copied
        rg   = /\u0001(\d+)\u0001/g
        
        while (m = rg.exec code)
            
            chunk = code[pos...m.index]
            nl    = chunk.lastIndexOf '\n'
            
            if nl >= 0
                li  += chunk.split('\n').length - 1
                col  = chunk.length - nl - 1
            else
                col += chunk.length
            
            out += chunk
            
            # a tag stands directly behind the text of its token, so the
            # token ends where the tag begins - and a token is never touched
            # between there and where it began, or a tag would have gone
            # with it. that puts the token inside this piece of text, ending
            # on it: measure back from there, and not from the tag, so that
            # a token over several lines keeps its first column too.
            
            tk = @toks[Number m[1]]
            
            if tk
                
                [js, tok] = tk
                at  = chunk.length - js.length
                
                if at >= 0
                    
                    head = if at then chunk[0...at] else ''
                    nl   = head.lastIndexOf '\n'
                    tl   = sli + head.split('\n').length - 1
                    tc   = if nl >= 0 then head.length - nl - 1 else scol + head.length
                    
                    @add [tok.line-1, tok.col], [tl, tc], js
                    @stripped++
                    
                    @verb b5(li), b3(col), r2(tok.line), b2(tok.col), js
                else
                    @verb r4("token #{tok.text} does not fit what was written")
            else
                @verb r4("no token for tag #{m[1]}")
            
            pos  = m.index + m[0].length
            sli  = li
            scol = col
        
        @verb b7('t'), @stripped, 'of', @toks.length
        
        out + code[pos..]
    
    done: (s) ->
        
        ls = s.split '\n'
        
        @verb b5('d'), @stripped, 'of', @toks.length, 'tags in', ls.length, 'lines,', @lines.length, 'mapped'
        @verb ls
                
        for li in 0...ls.length
            
            ln = ls[li]
            
            @verb "#{b3 kstr.lstrip li, 4} #{ln}#{r2 '◂'}" 
            
            if lm = @lines[li]
                for c in lm.columns
                    continue if not c
                    @verb "#{r4 c.jsstr} #{c.sourceLine} #{c.sourceColumn}"

    add: (source, target, jsstr) -> # source and target: [line, column]
        
        [line, column] = target
        @lines[line] ?= new LineMap line
        @lines[line].verbose = @verbose
        @lines[line].add column, source, jsstr

    generate: ->
        
        writingline      = 0
        lastColumn       = 0
        lastSourceLine   = 0
        lastSourceColumn = 0
        needComma        = no
        buffer           = ''

        for lineMap in @lines
            continue if not lineMap
            for mapping in lineMap.columns 
                continue if not mapping
                while writingline < mapping.line
                    lastColumn = 0
                    needComma = no
                    buffer += ";"
                    writingline++

                if needComma
                    buffer += ","
                    needComma = no

                buffer += @encodeVlq mapping.column - lastColumn
                lastColumn = mapping.column

                buffer += @encodeVlq 0

                buffer += @encodeVlq mapping.sourceLine - lastSourceLine
                lastSourceLine = mapping.sourceLine

                buffer += @encodeVlq mapping.sourceColumn - lastSourceColumn
                lastSourceColumn = mapping.sourceColumn
                needComma = yes

        file = slash.file slash.swapExt(@source, 'js')
                
        version:        3
        file:           file
        sources:        [@name or @source]
        mappings:       buffer

    jscode: (v3Map) ->
        
        encoded = @base64encode JSON.stringify(v3Map)
        dataURL = "//# sourceMappingURL=data:application/json;base64,#{encoded}"
        
        sourceURL = "//# sourceURL=file://#{@source}"
        "\n\n#{dataURL}\n#{sourceURL}\n"
        
    decodejs: (encoded) ->
        
        JSON.parse @base64decode(encoded)
            
    sourcePosition: file line col=0 ○-> # returns file:srcfile line:srcline col:srccol or undefined
        
        text = ○ nfs.read file
        ⮐ if not text
                
        mark = 'sourceMappingURL=data:application/json;base64,'
        at   = text.lastIndexOf mark
        ⮐ if at < 0
        
        rg = /^[A-Za-z0-9+\/=]*/.exec text[(at + mark.length)..]
        ⮐ if not rg[0]
        
        try
            map   = @decodejs rg[0]
            sm    = new NodeSourceMap(map)
            entry = sm.findEntry line-1, col
        catch err
            error err
            ⮐
        
        if not entry.originalSource
            # warn 'NO ORIGINAL SOURCE' entry
            ⮐ 
                
        src = slash.absolute entry.originalSource, slash.dir(file)
        
        {
            file: src
            line: entry.originalLine+1
            col:  entry.originalColumn
        }
        
    encodeVlq: (value) ->
        
        VLQ_SHIFT            = 5
        VLQ_CONTINUATION_BIT = 1 << VLQ_SHIFT            # 0010 0000
        VLQ_VALUE_MASK       = VLQ_CONTINUATION_BIT - 1  # 0001 1111
        
        signBit = if value < 0 then 1 else 0 # Least significant bit represents the sign.

        valueToEncode = (Math.abs(value) << 1) + signBit # The next bits are the actual value.

        answer = ''
        while valueToEncode or not answer
            nextChunk = valueToEncode & VLQ_VALUE_MASK
            valueToEncode = valueToEncode >> VLQ_SHIFT
            nextChunk |= VLQ_CONTINUATION_BIT if valueToEncode
            answer += @encodeBase64 nextChunk
        answer

    base64decode: (src) -> Buffer.from(src, 'base64').toString()
        
    base64encode: (src) ->
        
        Buffer.from(src).toString('base64')
        
    encodeBase64: (value) -> 
    
        BASE64_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
        BASE64_CHARS[value]
■LineMap
# keeps track of source positions for a single line of js code
    
    @: (@line) ->
        @columns = []
        @verbose = false

    verb: -> if @verbose then console.log.apply console.log, arguments
    
    add: (column, srcloc, jsstr) ->
        [sourceLine, sourceColumn] = srcloc
        if @columns[column] 
            @verb "LineMap has column #{column}", sourceLine, sourceColumn
            return
        @columns[column] = {line: @line, column, sourceLine, sourceColumn, jsstr}

export SourceMap

