###
     ███████  ████████    ███████  ██     ██   ███████   ████████ 
    ███       ███   ███  ███       ███   ███  ███   ███  ███   ███
    ███████   ███████    ███       █████████  █████████  ████████ 
         ███  ███   ███  ███       ███ █ ███  ███   ███  ███      
    ███████   ███   ███   ███████  ███   ███  ███   ███  ███      

    maps locations in a single generated js file back to locations in the original source file
    the renderer hands every token it renders to mark, which tags the token's
    text with a number of its own. the tag rides along with the text through
    whatever the renderer does to the string it is building, and strip reads
    the tags back out of the finished js - so strip is the only place that has
    to know where anything ended up, and the rest of the rendering does not
    have to keep track of a position at all.
    a tag goes behind the text of its token, not in front of it: the renderer
    still sees what it rendered at the head of a string, which is most of what
    it looks at. where it does look at the middle - the two places that slice
    or match what they rendered - it goes through plain first.
      
    a private use codepoint, so a tag can never be confused with anything the
    renderer wrote itself, whatever the source held. plain and strip look for
    tags with a regular expression, and it has to be this shape.
###

use ../kxk ◆ kstr slash

TAG = '\u0001'

class SourceMap
    
    @: (@source, @name) ->
        
        @toks     = [] # [js, tok] per tag, in the order they were marked
        @lines    = [] # LineMap per generated line
        @stripped = 0  # tags read back out of the finished js
        @verbose  = false

    # sourcemap tracing: silent unless --verbose or a tree dumping
    # flag was given, so a normal compile prints only its result

    verb: -> if @verbose then console.log.apply console.log, arguments

    # tag a token's rendered text with its own number
    
    mark: (s, tok) ->
        
        @toks.push [s, tok]
        i = @toks.length-1
        s + TAG + i + TAG

    # the same text with the tags taken out again. the renderer matches and
    # slices its own output in places, and that has to go on text looking
    # the way it would look without a map - a tag would be characters the
    # comparisons and offsets never saw.
    
    plain: (s) -> s.replaceAll /\u0001\d+\u0001/g, ''
    

    # take every tag out of the finished js, remembering where each one
    # stood: that is where its token landed in the generated file
    
    strip: (code) ->
        
        ⮐ code if empty code
        
        out  = ''
        li   = 0 # line in the generated js, 0-based
        col  = 0 # column just past the last character taken over
        sli  = 0 # the same, as of the last tag read
        scol = 0
        pos  = 0 # everything before this has been read and copied
        rg   = /\u0001(\d+)\u0001/g
        
        while (m = rg.exec code)
            
            chunk = code[pos...m.index]
            nl    = chunk.lastIndexOf '\n'
            
            if nl >= 0
                li  += chunk.split('\n').length - 1
                col  = chunk.length - nl - 1
            else
                col += chunk.length
            
            out += chunk
            
            # a tag stands directly behind the text of its token, so the
            # token ends where the tag begins - and a token is never touched
            # between there and where it began, or a tag would have gone
            # with it. that puts the token inside this piece of text, ending
            # on it: measure back from there, and not from the tag, so that
            # a token over several lines keeps its first column too.
            
            tk = @toks[Number m[1]]
            
            if tk
                
                [js, tok] = tk
                at  = chunk.length - js.length
                
                if at >= 0
                    
                    head = if at then chunk[0...at] else ''
                    nl   = head.lastIndexOf '\n'
                    tl   = sli + head.split('\n').length - 1
                    tc   = if nl >= 0 then head.length - nl - 1 else scol + head.length
                    
                    @add [tok.line-1, tok.col], [tl, tc], js
                    @stripped++
                    
                    @verb b5(li), b3(col), r2(tok.line), b2(tok.col), js
                else
                    @verb r4("token #{tok.text} does not fit what was written")
            else
                @verb r4("no token for tag #{m[1]}")
            
            pos  = m.index + m[0].length
            sli  = li
            scol = col
        
        @verb b7('t'), @stripped, 'of', @toks.length
        
        out + code[pos..]
    
    # print the finished js, with the positions that were found on it
    # behind every mapped token
    
    done: (s) ->
        
        ls = s.split '\n'
        
        @verb b5('d'), @stripped, 'of', @toks.length, 'tags in', ls.length, 'lines,', @lines.length, 'mapped'
        @verb ls
                
        for li in 0...ls.length
            
            ln = ls[li]
            
            @verb "#{b3 kstr.lstrip li, 4} #{ln}#{r2 '◂'}" 
            
            if lm = @lines[li]
                for c in lm.columns
                    continue if not c
                    @verb "#{r4 c.jsstr} #{c.sourceLine} #{c.sourceColumn}"

    add: (source, target, jsstr) -> # source and target: [line, column]
        
        [line, column] = target
        @lines[line] ?= new LineMap line
        @lines[line].verbose = @verbose
        @lines[line].add column, source, jsstr

    # the map itself. a source map is one line of segments per line of the
    # generated file, each segment a run of vlq values: generated column,
    # source, source line, source column - all but the first relative to
    # whatever came before.
    
    generate: ->
        
        writingline      = 0
        lastColumn       = 0
        lastSourceLine   = 0
        lastSourceColumn = 0
        needComma        = no
        buffer           = ''

        for lineMap in @lines
            continue if not lineMap
            for mapping in lineMap.columns 
                continue if not mapping
                while writingline < mapping.line
                    lastColumn = 0
                    needComma = no
                    buffer += ";"
                    writingline++

                # Write a comma if we've already written a segment on this line.

                if needComma
                    buffer += ","
                    needComma = no

                # Write the next segment. Segments can be 1, 4, or 5 values.    
                # If just one, then it is a generated column which doesn't match anything in the source code.
                
                # the fields of ONE segment are concatenated without
                # separators; the VLQ continuation bit is what tells a
                # decoder where each value ends. The comma above only
                # separates one segment from the next.
                
                # The starting column in the generated source, relative to any previous recorded
                # column for the current line:

                buffer += @encodeVlq mapping.column - lastColumn
                lastColumn = mapping.column

                # The index into the list of sources:

                buffer += @encodeVlq 0

                # The starting line in the original source, relative to the previous source line.

                buffer += @encodeVlq mapping.sourceLine - lastSourceLine
                lastSourceLine = mapping.sourceLine

                # The starting column in the original source, relative to the previous column.

                buffer += @encodeVlq mapping.sourceColumn - lastSourceColumn
                lastSourceColumn = mapping.sourceColumn
                needComma = yes

        # the generated file, and the one source it was made from, named the
        # way a runtime reading this map out of the js will look for it
        
        file = slash.file slash.swapExt(@source, 'js')
                
        version:        3
        file:           file
        sources:        [@name or @source]
        mappings:       buffer

    jscode: (v3Map) ->
        
        encoded = @base64encode JSON.stringify(v3Map)
        dataURL = "//# sourceMappingURL=data:application/json;base64,#{encoded}"
        sourceURL = "//# sourceURL=#{@source}"
        "\n\n#{dataURL}\n#{sourceURL}\n"
        
        
    decodejs: (encoded) ->
        
        JSON.parse @base64decode encoded
        
    # Note that SourceMap VLQ encoding is "backwards".  MIDI-style VLQ encoding puts
    # the most-significant-bit (MSB) from the original value into the MSB of the VLQ
    # encoded value (see [Wikipedia](https://en.wikipedia.org/wiki/File:Uintvar_coding.svg)).
    # SourceMap VLQ does things the other way around, with the least significat four
    # bits of the original value encoded into the first byte of the VLQ encoded value.
    
    encodeVlq: (value) ->
        
        VLQ_SHIFT            = 5
        VLQ_CONTINUATION_BIT = 1 << VLQ_SHIFT            # 0010 0000
        VLQ_VALUE_MASK       = VLQ_CONTINUATION_BIT - 1  # 0001 1111
        
        signBit = if value < 0 then 1 else 0 # Least significant bit represents the sign.

        valueToEncode = (Math.abs(value) << 1) + signBit # The next bits are the actual value.

        # Make sure we encode at least one character, even if valueToEncode is 0.
        answer = ''
        while valueToEncode or not answer
            nextChunk = valueToEncode & VLQ_VALUE_MASK
            valueToEncode = valueToEncode >> VLQ_SHIFT
            nextChunk |= VLQ_CONTINUATION_BIT if valueToEncode
            answer += @encodeBase64 nextChunk
        answer

    base64decode: (src) -> Buffer.from(src, 'base64').toString()
        
    base64encode: (src) ->
        
        Buffer.from(src).toString('base64')
        
    encodeBase64: (value) -> 
    
        BASE64_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
        BASE64_CHARS[value]

# 000      000  000   000  00000000  00     00   0000000   00000000   
# 000      000  0000  000  000       000   000  000   000  000   000  
# 000      000  000 0 000  0000000   000000000  000000000  00000000   
# 000      000  000  0000  000       000 0 000  000   000  000        
# 0000000  000  000   000  00000000  000   000  000   000  000        

# keeps track of source positions for a single line of js code

class LineMap
    
    @: (@line) ->
        @columns = []
        @verbose = false

    # sourcemap tracing, see SourceMap.verb
    verb: -> if @verbose then console.log.apply console.log, arguments
    
    add: (column, srcloc, jsstr) ->
        [sourceLine, sourceColumn] = srcloc
        if @columns[column] 
            @verb "LineMap has column #{column}", sourceLine, sourceColumn
            return
        @columns[column] = {line: @line, column, sourceLine, sourceColumn, jsstr}

export SourceMap

