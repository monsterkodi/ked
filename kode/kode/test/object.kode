
use ./utils ▪ kc ke

▸ object
        
    ▸ object

        kc  'a:1'               ▸   '{a:1}'
        kc  '{a:1}'             ▸   '{a:1}'
        kc  'a:1 b:2'           ▸   '{a:1,b:2}'
        kc  '{a:3 b:4}'         ▸   '{a:3,b:4}'
        kc  'a:b:c'             ▸   '{a:{b:c}}'
        kc  'a:b:c,d:e:f'       ▸   '{a:{b:c,d:{e:f}}}'
        kc  'a:b(c)'            ▸   '{a:b(c)}'
        kc  'a:b:c d:e:f'       ▸   '{a:{b:c,d:{e:f}}}'
        kc  'a:b:c(d:e:f)'       ▸   '{a:{b:c({d:{e:f}})}}'

        kc  'o = { a:1 b:2 c: d:4 e:5 }' ▸ 'o = {a:1,b:2,c:{d:4,e:5}}'

        kc  'o = noon:1'        ▸   'o = {noon:1}'
        kc  """
            o = 
                a:[1 2 3]
                noon:1
            """ ▸ 'o = {a:[1,2,3],noon:1}'
            
        kc  """
            o = 
                try: 
                    catch:1
                noon: 
                    new:2
                switch:
                    when:3
                delete:
                    typeof:4
                instanceof:
                    is:5
            """ ▸
            """
            o = {try:{catch:1},noon:{new:2},switch:{when:3},delete:{typeof:4},instanceof:{is:5}}
            """
        
        kc  """
            a
                {
                    a:1
                }
            """ ▸
            """
            a({a:1})
            """

        kc  """
            a =
                {
                    a:1
                }
            """ ▸
            """
            a = {a:1}
            """

        kc  """
            {a:1}
            log 3
            """ ▸
            """
            {a:1}
            console.log(3)
            """

        kc  """
            o={a:1}
            log o
            """ ▸
            """
            o = {a:1}
            console.log(o)
            """

        kc  """
            i = y:1
            log i
            """ ▸
            """
            i = {y:1}
            console.log(i)
            """

        kc  """
            i = y:1 z:2
            log i
            """ ▸
            """
            i = {y:1,z:2}
            console.log(i)
            """

        kc  """
            u = v:0 w:1; x=y:2
            """ ▸
            """
            u = {v:0,w:1}
            x = {y:2}
            """
            
        kc  """
            i = y:1 z:2; z=a:1
            log i
            """ ▸
            """
            i = {y:1,z:2}
            z = {a:1}
            console.log(i)
            """
            
        kc  """
            d = 
                a: b:1
                c: d:2
            """ ▸
            """
            d = {a:{b:1},c:{d:2}}
            """
            
        kc  """
            d = 
                a: b:1
                   d:2
            """ ▸
            """
            d = {a:{b:1,d:2}}
            """

        kc  """
            d = a: b:11
                c: d:22
            """ ▸
            """
            d = {a:{b:11},c:{d:22}}
            """
            
        kc  """
            d = a: b:11
                   d:222
            """ ▸
            """
            d = {a:{b:11,d:222}}
            """
            
        kc  """
            d = a: b:c:d:1
                   d:2
            """ ▸
            """
            d = {a:{b:{c:{d:1}},d:2}}
            """

        kc  """
            d = a: b:c:d:1
                     d:2
            """ ▸
            """
            d = {a:{b:{c:{d:1},d:2}}}
            """

        kc  """
            d = a: b:c:d:1
                       e:2
            """ ▸
            """
            d = {a:{b:{c:{d:1,e:2}}}}
            """
            
        kc  """
            h =
                j: p:1 w:2
                t: q:3 r:4
            """ ▸
            """
            h = {j:{p:1,w:2},t:{q:3,r:4}}
            """
            
        kc  """
            h = j: p:1 w:2
                t: q:3 r:4
            """ ▸
            """
            h = {j:{p:1,w:2},t:{q:3,r:4}}
            """
            
        kc  """
            d =
                delete:delete
                empty:empty
                valid:valid
                noon:noon
                new:new
                is:is
            """ ▸
            """
            d = {delete:delete,empty:empty,valid:valid,noon:noon,new:new,is:is}
            """
            
    ▸ stringify
        
        kc  "a.b:1"     ▸   "{'a.b':1}"
        kc  "|:1"       ▸   "{'|':1}"
        kc  "==:1"      ▸   "{'==':1}"
        kc  ">=:1"      ▸   "{'>=':1}"
        kc  "<=:1"      ▸   "{'<=':1}"
        kc  "!=:1"      ▸   "{'!=':1}"
        kc  ".:1"       ▸   "{'.':1}"
        kc  ",:1"       ▸   "{',':1}"
        kc  ";:1"       ▸   "{';':1}"
        kc  "*:1"       ▸   "{'*':1}"
        kc  "+:1"       ▸   "{'+':1}"
        kc  "-:1"       ▸   "{'-':1}"
        kc  "/:1"       ▸   "{'/':1}"
        
    ▸ assign
        
        kc  "{x} = o"                   ▸   ";({x} = o)"
        kc  "{x,y} = o"                 ▸   ";({x, y} = o)"
        kc  "{x,y} = require 'sthg'"    ▸   ";({x, y} = require('sthg'))"
        kc  "{a b} = o"                 ▸   ";({a, b} = o)"
        kc  "{a, b} = o"                ▸   ";({a, b} = o)"
        kc  "{a:x b} = o"               ▸   ";({a: x, b} = o)"
        kc  "{from to} = r"             ▸   ";({from, to} = r)"
        kc  "x = 1\n{a b} = o"          ▸   "x = 1\n;({a, b} = o)"

        ke  "o = a:1 b:2\ng = ->\n    {a b} = o\n    a+b\ng()"         ▸ 3
        kc  "{empty noon} = kxk"        ▸   ";({empty, noon} = kxk)"

        ke  "n = 0\nf = -> n++; {a:1 b:2}\n{a b:c} = f()\n[a c n]"   ▸ [1 2 1]

        kc  "x = {a:1}"                 ▸   "x = {a:1}"
        kc  "x = {a:1}['a']"            ▸   "x = {a:1}['a']"
        