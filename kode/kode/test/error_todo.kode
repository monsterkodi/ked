    ▸ an operator the lexer does not have

        # none of these are in lexer.Patterns.op, so they lex as two or
        # three separate tokens and the renderer puts them back together
        # with the wrong spacing: 'a === b' comes out as 'a === =\nb'.
        # operator.kode lists <<= >>= >>>= &&= ||= in its precedence table
        # and the renderer knows how to emit them - the lexer just cannot
        # make them.

        codemsg 'a === b' '???'
        codemsg 'a !== b' '???'
        codemsg 'a && b' '???'
        codemsg 'a || b' '???'
        codemsg 'a <<= b' '???'
        codemsg 'a >>= b' '???'
        codemsg 'a >>>= b' '???'
        codemsg 'a &&= b' '???'
        codemsg 'a ||= b' '???'
        codemsg 'a **= b' '???'
        codemsg 'a &^ b' '???'
        codemsg 'x = a && b' '???'
        codemsg 'a === 1' '???'

        codemsg '===' '???'
        codemsg '!==' '???'
        codemsg '&&' '???'
        codemsg '||' '???'
        codemsg '<<=' '???'
        codemsg '>>=' '???'
        codemsg '>>>=' '???'
        codemsg '&&=' '???'
        codemsg '||=' '???'
        codemsg '**=' '???'
        codemsg '&^' '???'
        codemsg '??' '???'
        codemsg '?.' '???'

