            """ ▸
            [1,5,4]

        ke  """
            a = b:1
            c = d:2
            [a.b c.d] = [c.d a.b]
            [a.b c.d]
            """ ▸
            [2,1]

        ke  """
            c = [0 0]
            [c[0] c[1]] = [3 4]
            c
            """ ▸
            [3,4]

        ke  """
            [[a b] c] = [[1 2] 3]
            [c b a]
            """ ▸
            [3,2,1]

