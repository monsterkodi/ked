use ./utils ▪ kc
use ..      ◆ kode lexer

▸ lexer

    ▸ anchored

        lx = new lexer new kode header:false

        for pair in lx.regs

            pair[1].sticky ▸ true

    ▸ lookarounds

        kc '7/7'          ▸ '7 / 7'           # nothing to close it
        kc 'n/2/7'        ▸ 'n / 2 / 7'       # the lookahead turns /2/ away
        kc 'a = /re/ b'   ▸ 'a = /re/\nb'     # and here it does not

        kc '[1..2]'       ▸ ';[1,2]'
        kc '[1...2]'      ▸ ';[1]'

        kc '●▸ foo\nbar'  ▸ "_k_.profile('foo')\nbar"