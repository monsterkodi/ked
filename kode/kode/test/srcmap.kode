###
     ███████  ████████    ███████  ██     ██   ███████   ████████   
    ███       ███   ███  ███       ███   ███  ███   ███  ███   ███  
    ███████   ███████    ███       █████████  █████████  ████████   
         ███  ███   ███  ███       ███ █ ███  ███   ███  ███        
    ███████   ███   ███   ███████  ███   ███  ███   ███  ███        
###

# the transpiler writes an inline source map at the foot of every file it
# compiles with a map on: locations in the js, back to locations in the
# kode it was made from.
#
# these tests read the map back out of the compiled js and ask whether it
# says anything true - that the js is the same js, that a token sits where
# the map says it does, and that a decoder can make sense of the segments.

use ../kode
use ../srcmap
use ../../kxk ◆ slash nfs
use buffer
use fs

# 'buffer' resolves to the module object, whose Buffer constructor is the
# entry point; a bare 'Buffer' name would collide with kode's own register
# capture operator

B64 = buffer.Buffer

JS_FILE = '/tmp/probe.js'
SRCFILE = '/tmp/probe.kode'

smap = new srcmap

kmap   = (c s=SRCFILE) -> (new kode header:false, map:true).compile c, s
kplain = (c) -> (new kode header:false).compile c, SRCFILE

# the js on its own, without the map or the sourceURL at the foot of it. a
# map counts lines as they are written, so the tests here work on the whole
# file.

body = (code) ->

    # both go on as newlines and comments. the sourceURL is written whether
    # or not there is a map, so this cannot look for one by name - and
    # taking the first of the pair leaves whatever blank line came before it,
    # which is why the tail is trimmed too.

    i = code.indexOf '\n//# source'
    if i >= 0 then code = code[...i]

    code.trimEnd()

linesOf = (code) -> body(code).split '\n'

# a segment is a run of base64 chars, and the continuation bit (32) says
# whether a value carries on into the next char, so one segment decodes to
# a LIST of values and not to a single value

VLQ = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'

decodeSegment = (s) ->

    vals = []
    v = 0
    sh = 0

    for c in s
        d = VLQ.indexOf c
        v += (d & 31) << sh
        sh += 5
        if not (d & 32)
            n = v & 1
            v = Math.floor v / 2
            vals.push if n then -v else v
            v = 0
            sh = 0

    vals

# the map of a compiled snippet, decoded into [genLine, genCol, srcLine,
# srcCol] tuples. mappings separate generated lines with ';', and every
# value in a segment is relative to the one before it.

decode = (code) ->

    mark = 'sourceMappingURL=data:application/json;base64,'
    at = code.lastIndexOf mark
    ⮐ null if at < 0

    b64 = ''
    i = at + mark.length

    while i < code.length
        c = code[i]
        break if c not in 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/='
        b64 += c
        i++

    sm = JSON.parse B64.from(b64, 'base64').toString()
    out = []
    sl = 0
    sc = 0

    for line, li in sm.mappings.split ';'
        gc = 0
        for seg in line.split ','
            continue if not seg
            f = decodeSegment seg
            gc += f[0]
            if f.length >= 4
                sl += f[2]
                sc += f[3]
                out.push [li+1, gc, sl+1, sc]

    [sm, out]

mapsOf = (code) ->

    r = decode code
    r ? r[1] : []

jsonOf = (code) ->

    r = decode code
    r ? r[0] : {}

# the text of the token a mapping points at, on the source side

tokAt = (lines, line, col) ->

    l = lines[line-1]
    ⮐ '' if not l?

    m = /^[\w$]+/.exec l[col..]
    m ? m[0] : l[col]

# kode rewrites some tokens on the way out, so a mapping is not always text
# landing on text: log becomes console.log, yes becomes true, and so on.
# these are the ones the snippets below run into.

rewrites =

    log:     'console.'
    warn:    'console.'
    error:   'console.'
    yes:     'true'
    no:      'false'
    '@':     'this'
    '"':     '`'
    '●':     '_k_.profile'
    '●▸':    '_k_.profile'
    '●▪':    '_k_.profilend'
    in:      '_k_.in'
    valid:   '!_k_.empty'
    empty:   '_k_.empty'
    eql:     '_k_.eql'

same = (st, gt) ->

    ⮐ true if gt.startsWith st
    ⮐ false if not rewrites[st]?
    gt.startsWith rewrites[st]

# every mapping of a snippet, as [tuple, sourceText, generatedText] - the
# two ends a decoder would meet when it walked to that mapping

pairs = (c) ->

    code = kmap c
    gl = linesOf code
    sl = c.split '\n'
    out = []

    for t in mapsOf code
        st = tokAt sl, t[2], t[3]
        gt = gl[t[0]-1]?[t[1]..] or ''
        out.push [t, st, gt]

    out

# every kode file under dir

kodfiles = (dir, out=[]) ->

    for name in fs.readdirSync dir
        p = slash.path dir, name
        if fs.statSync(p).isDirectory() ➜ kodfiles p, out
        else if p.endsWith '.kode'        ➜ out.push p

    out

writeJs = c file=JS_FILE ○->

    s = slash.swapExt file 'kode'
    js = kmap c, s
    # log "------------ #{s}"
    # log js
    # log "------------"
    
    ○ nfs.write file, js
    file
    
#  ███████  ████████    ███████  ██     ██   ███████   ████████ 
# ███       ███   ███  ███       ███   ███  ███   ███  ███   ███
# ███████   ███████    ███       █████████  █████████  ████████ 
#      ███  ███   ███  ███       ███ █ ███  ███   ███  ███      
# ███████   ███   ███   ███████  ███   ███  ███   ███  ███      

▸ srcmap

    ▸ the map is only written when asked for

        has = 'sourceMappingURL' in kmap 'a = 1'
        has ▸ true

        has = 'sourceMappingURL' in kplain 'a = 1'
        has ▸ false

    ▸ the sourceURL is written either way

        # -map is about stack traces. what a file in js/ is, and where it
        # came from, is a different question and is answered by the
        # sourceURL alone - konrad's reconcile can tell a generated file
        # from a hand written one by nothing else. it is 40-odd bytes
        # against a 6.7k sourcemap, so keeping it is not what -map is for.

        has = 'sourceURL' in kmap 'a = 1'
        has ▸ true

        has = 'sourceURL' in kplain 'a = 1'
        has ▸ true

    ▸ the sourceURL without a map still names the source

        url = kplain 'a = 1'
        lines = url.split '\n'
        url = lines.find (l) -> l.startsWith '//# sourceURL='
        url ▸ "//# sourceURL=file://#{SRCFILE}"

    ▸ and it names the file by its own path

        # a path relative to the working directory means something
        # different in every directory, and names a file that is not there
        # from any of the others. the sourceURL is what a terminal turns
        # into a link and what a reader opens in an editor, so it has to
        # say where the file is, and not where the build was run from.

        url = kplain 'a = 1'
        lines = url.split '\n'
        url = lines.find (l) -> l.startsWith '//# sourceURL='
        url = url.replace '//# sourceURL=file://', ''

        slash.isAbsolute url  ▸ true
        url ▸ SRCFILE

    ▸ and the js it wraps is untouched

        # `writes the same js either way` below is this for a spread of
        # snippets; this is the one-liner version, so a change that started
        # steering the renderer instead of annotating it would be obvious
        # here before it got interesting there

        mapped = kmap   'a = 1'
        plain  = kplain 'a = 1'
        mapped = body mapped
        plain  = body plain

        mapped ▸ plain

    ▸ names the file it was made from

        json = jsonOf kmap('a = 1')

        src = json.sources
        src.length ▸ 1

        names = src[0].endsWith 'probe.kode'
        names ▸ true

        version = json.version
        version ▸ 3

    ▸ names it as a file:// uri

        # the comment under the map is what node names a frame after when it
        # has no map of its own, and what a terminal turns into a link when
        # it sees a uri - so it is written as one

        code = kmap 'a = 1'
        mark = '//# sourceURL='
        at = code.lastIndexOf mark

        has = at >= 0
        has ▸ true

        url = code[(at + mark.length)..].split('\n')[0]

        url.startsWith 'file://' ▸ true

        # and it still points at the probe file, wherever it is read from

        src = url.replace 'file://', ''
        src.endsWith 'probe.kode' ▸ true

        back = slash.absolute src, process.cwd()
        back ▸ SRCFILE

    ▸ names its source from where it is written

        # a runtime reads the frames of a stack trace against the file the
        # map is written into, so the source is named from that file's
        # directory and not from the working directory

        dir = slash.path ◆dir, '..', '..'
        tgt = slash.path dir, 'probe.js'

        out = (new kode header:false, map:true).compile 'a = 1', SRCFILE, tgt

        name = jsonOf(out).sources[0]
        back = slash.absolute name, slash.dir(tgt)

        back ▸ SRCFILE

    ▸ writes the same js either way

        # a map is a comment at the foot of the file and nothing else. if
        # the tagging behind it leaked into the js, or steered the renderer
        # into rendering something else, this is where it shows.

        # the brackets have to be on this line. a '=' with the value starting
        # on the one below loses the value - this used to be a bare sequence
        # of strings with no brackets at all, which is a call to a variable
        # called snips, so snips was 'a = 1' and the loop below walked its
        # four characters instead of these thirteen snippets

        snips = [
            'a = 1'
            'a = 1\nb = a + 2\nlog b'
            'f = (a, b) -> a + b'
            'class Foo\n    @: (a) ->\n        @a ?= a\n    mthd: -> @a + 1\n'
            'x = if a ➜ 1 else 2'
            'for i in 0...10 ➜ log i'
            'x = "a #{b} c"'
            'try\n    f()\ncatch e\n    log e'
            'x = """\n    a #{b}\n    """'
            'l = [1 2 3]\nl.map (i) -> i * 2'
            'log b4 "hi" a'
            'switch a\n    when 1 ➜ log "one"\n    else ➜ log "other"'
            'x = int "42" + min 1 2 + trim " a "'
            ]
        
        for c in snips
            mapped = kmap   c
            unmap  = kplain c
            mapped = body mapped
            unmap  = body unmap

            eq = mapped == unmap
            eq ▸ true

    ▸ twice over

        # one kode instance can compile more than once, and the parser
        # renders a node or two while it parses - so a map left behind by
        # one run must not tag the next

        c = 'class Foo\n    @bar: 1\n    mthd: -> @bar\n'

        k = new kode header:false, map:true

        first = k.compile c, SRCFILE
        again = k.compile c, SRCFILE

        eq = body(first) == body(again)
        eq ▸ true

    ▸ points at the token it maps

        # the strong claim: whatever a mapping says a generated position
        # came from, the same token sits at both ends of it

        out = pairs 'a = 1\nb = a + 2\nc = b + 3\nlog c\n'

        wrong = out.filter (t) ->
            ok = same t[1], t[2]
            ok == no
        report = wrong.map((t) -> "#{t[0]} #{t[1]} #{t[2][0..12]}").join ' '

        report ▸ ''

    ▸ maps every line it can

        snips = [
            'a = 1\nb = a + 2\nc = b + 3\nlog c\n'
            'f = ->\n    a = 1\n    b = a + 2\n    log b\nf()\n'
            ]

        for c in snips

            sl = c.split('\n').map((l, i) -> if trim l then i+1 else 0).filter (l) -> l

            ms = mapsOf kmap(c)
            got = ms.map (t) -> t[2]

            missed = sl.filter (l) -> l not in got
            missed ▸ []

    ▸ maps every name

        # a map is for finding where a name came from again, so every name
        # in the source has to be the start of some mapping. not every
        # token: an operator or a delimiter is not a name, and a keyword
        # is often syntax the renderer writes out itself.
        #
        # the tests below name the class and function cases one by one.
        # this one is the net under them: a header the renderer builds by
        # hand is a header nobody tagged, and it shows up here as a name
        # with no position of its own.

        snips = [
            'a = 1\nb = a + 2\nlog b\n'
            'f = (a, b) -> a + b\nf 1 2\n'
            'g = (x) -> x * 2\n'
            'class Foo\n    @: (a) ->\n        @a = a\n    mthd: (b) -> @a + b\n'
            'function Bar\n    @: (x) ->\n        @x = x\n    mthd: (y) -> @x + y\n'
            'for i in 0...10 ➜ log i\n'
            'l = [1 2 3]\nl.map (i) -> i * 2\n'
            'try\n    f()\ncatch e\n    log e\n'
            'switch a\n    when 1 ➜ log "one"\n    else ➜ log "other"\n'
            ]

        for c in snips

            # names are the tokens with a name in them: variables and the
            # @ of a this reference

            names = (new kode header:false).lexer.tokenize(c).filter (t) -> t.type in ['var' 'this']

            got = mapsOf(kmap(c)).map (t) -> "#{t[2]}:#{t[3]}"

            missed = names.filter (t) -> "#{t.line}:#{t.col}" not in got
            report = missed.map((t) -> "#{t.text} at #{t.line}:#{t.col}").join ' '

            report ▸ ''

    ▸ a class maps its head and its body

        # the name, the keyword and every method header are as much a part
        # of the class as the assignment in its constructor. this used to
        # be a gap here, with only the body mapping; it is pinned down now
        # so the head cannot quietly go back to being untagged.

        code = kmap 'class Foo\n    @: ->\n        @a = 1\n    mthd: -> @a\n'

        out = mapsOf code
        lines = out.map (t) -> t[2]

        lines ▸ [1 1 2 3 3 3 4 4 4]

    ▸ finds column zero

        out = mapsOf kmap('a = 1\nb = a + 2\nlog b\n')

        zero = out.filter((t) -> t[1] == 0).map((t) -> t[0])
        zero ▸ [3 4 5]

    ▸ maps a call

        # log is rewritten into console.log, so the mapping points at where
        # the call starts, not at where the name ends up

        out = mapsOf kmap('log b\n')

        out[0] ▸ [1 0 1 0]
        out[1] ▸ [1 12 1 4]

    ▸ maps a nested body

        # a body is rendered indented, so generated columns run ahead of the
        # source, and the source line a mapping gives is the line the token
        # was written on

        c = 'f = ->\n    a = 1\n    b = a + 2\nf()\n'

        out = mapsOf kmap(c)
        gl = linesOf kmap(c)

        gen = out.map (t) -> t[0]
        gen ▸ [4 8 8 9 9 9 11]

        src = out.map (t) -> t[2]
        src ▸ [1 2 2 3 3 3 4]

        # the three tokens of 'b = a + 2' are the body's return value, and
        # they land on the line the renderer put them on
        
        cols = out.filter((t) -> t[2] == 3).map (t) -> t[1]
        cols ▸ [11 15 19]

        text = gl[8][11..]
        text ▸ 'b = a + 2'

    ▸ maps a triple string

        # a triple string is rendered as a template literal and comes out
        # re-indented, but it starts where it started in the source

        out = mapsOf kmap('x = """\n    abc\n    def\n    """\n')

        out[0] ▸ [3 0 1 0]
        out[1] ▸ [3 4 1 4]

    ▸ maps an interpolation

        # the expression inside a string is parsed on its own, and put back
        # where the string had it

        out = mapsOf kmap('x = "a #{b + 1} c"\n')

        out[0] ▸ [3 0 1 0]
        out[1] ▸ [3 9 1 9]
        out[2] ▸ [3 13 1 13]

    ▸ ordered and monotonic

        # a decoder reads the segments of a line in order and adds them up,
        # so a column that goes backwards is a segment nobody can read

        snips = [
            'a = 1\nb = a + 2\nlog b\n'
            'class Foo\n    @: ->\n        @a = [1 2 3]\n        for i in @a ➜ log i\n'
            'f = (a, b) ->\n    g = -> a + b\n    g()\n'
            ]

        for c in snips

            sorted = true
            prev = [-1, -1]
            for t in mapsOf kmap(c)
                sorted = false if t[0] < prev[0] or (t[0] == prev[0] and t[1] <= prev[1])
                prev = [t[0], t[1]]
            sorted ▸ true

    ▸ no column twice

        # two tokens cannot start in the same place, and the segments of a
        # line are read in order, so a second one on a column would lie

        snips = [
            'a = 1\nb = a + 2\nlog b\n'
            'f = (a, b) -> if a then a + b else b - a\n'
            ]

        for c in snips

            ms = mapsOf kmap(c)
            keys = ms.map (t) -> "#{t[0]}:#{t[1]}"

            n = keys.filter((k, i) -> keys.indexOf(k) != i).length
            n ▸ 0

    ▸ the whole compiler

        # the renderer matches and slices its own output in a few places,
        # and a tag riding on a token would throw those off - quietly, and
        # only for the code that runs into them. so every file of kode/kode
        # has to compile to the same js with a map on as with it off.

        dir = slash.path ◆dir, '..', '..', '..', 'kode', 'kode'
        files = kodfiles dir

        files.length > 20 ▸ true

        wrong = []

        for file in files

            text = fs.readFileSync file, 'utf8'
            out = (new kode header:false, map:true).compile text, file

            continue if not out?

            # the probe sits next to the compiler and is not one of its own
            continue if file.endsWith 'srcmap-probe.kode'

            unmap = (new kode header:false).compile text, file
            eq = body(out) == body(unmap)

            wrong.push file if eq == no

        report = wrong.join ' '
        report ▸ ''

    ▸ sourcePosition finds where a position came from

        # the argument of the call sits at column 12 of the one line of
        # js, and at column 4 of the one line of kode it was written on

        file = ○ writeJs 'log b\n'
        pos  = ○ smap.sourcePosition file, 1, 12

        pos.file ▸ SRCFILE
        pos.line ▸ 1
        pos.col  ▸ 4

    ▸ sourcePosition takes columns from zero

        # the default column is the start of the line, so asking without
        # one asks about the start of the line

        file = ○ writeJs 'log b\n'
        pos  = ○ smap.sourcePosition file, 1

        pos.line ▸ 1
        pos.col  ▸ 0

    ▸ sourcePosition takes lines from one

        # the third line of the js is the one the assignment landed on,
        # and the map counts the source from one too

        file = ○ writeJs 'a = 1\n'
        pos  = ○ smap.sourcePosition file, 3, 0

        pos.file ▸ SRCFILE
        pos.line ▸ 1
        pos.col  ▸ 0

    ▸ sourcePosition says nothing before the first mapping

        # the var declaration is written by the renderer and not from a
        # token, so the map starts at the assignment below it and a lookup
        # above that has nothing to answer with

        file = ○ writeJs 'a = 1\n'
        pos  = ○ smap.sourcePosition file, 1, 0

        pos ▸ undefined

    ▸ sourcePosition says nothing for a file with no map

        # -plain writes a sourceURL but no map, and without a map there
        # is nothing to ask

        js = kplain 'a = 1\n'
        ○ nfs.write JS_FILE, js
        pos = ○ smap.sourcePosition JS_FILE, 1, 0

        pos ▸ undefined

    ▸ sourcePosition says nothing for a file that is not there

        pos = ○ smap.sourcePosition slash.path('/tmp', 'gone.js'), 1, 0

        pos ▸ undefined

    ▸ sourcePosition reads the map at the foot and not the marker in the code

        # the marker is what a file carrying one writes, so it stands in
        # the code of this very snippet: the map is the last one in the
        # text, and the one in the string is not a map at all

        c    = 'x = "//# sourceMappingURL=data:application/json;base64,"\nlog x\n'
        file = ○ writeJs c
        pos  = ○ smap.sourcePosition file, 4, 0

        pos.file ▸ SRCFILE
        pos.line ▸ 2
        pos.col  ▸ 0
        
    ▸ sourcePosition for function
    
        tmpjs = slash.tmpfile() + ".js"
        
        #var test
        #
        #
        #test = function ()
        #{
        #    console.log("hello")
        #}
             
        file = ○ writeJs """
            test = ->
                log "hello"
            """ tmpjs
            
        pos = ○ smap.sourcePosition file, 4, 0
        pos.line ▸ 1
        pos.col  ▸ 0
    
    ▸ sourcePosition for function method
    
        tmpjs = slash.tmpfile() + ".js"
         
        file = ○ writeJs """
            function Test
                @: ->
                method: -> log "hello"
            """ tmpjs
            
        # var Test
        # 
        # 
        # Test = (function ()
        # {
        #     function Test ()
        #     {}
        # 
        #     Test.prototype["method"] = function ()
        #     {
        #         console.log("hello")
        #     }
        # 
        #     return Test
        # })()
        #        
 
        pos = ○ smap.sourcePosition file, 9, 5
        # log "POS" pos
        valid pos ▸ true

    ▸ sourcePosition names the source from where the map was written

        # a runtime reads the map against the file it is written into, so
        # a source named relative to that file resolves the same way here

        out = (new kode header:false, map:true).compile 'a = 1\n', SRCFILE, JS_FILE
        ○ nfs.write JS_FILE, out

        pos = ○ smap.sourcePosition JS_FILE, 3, 0

        pos.file ▸ SRCFILE
        pos.line ▸ 1
        pos.col  ▸ 0
