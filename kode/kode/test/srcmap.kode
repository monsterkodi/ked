###
     ███████  ████████    ███████  ██     ██   ███████   ████████   
    ███       ███   ███  ███       ███   ███  ███   ███  ███   ███  
    ███████   ███████    ███       █████████  █████████  ████████   
         ███  ███   ███  ███       ███ █ ███  ███   ███  ███        
    ███████   ███   ███   ███████  ███   ███  ███   ███  ███        
###

# 'buffer' resolves to the module object, whose Buffer constructor is
# the entry point; a bare 'Buffer' name would collide with kode's own
# register capture operator

use ./utils ▪ kc
use buffer

B64 = buffer.Buffer

# kc() needs a filename for the renderer to derive @source, and the
# map option, since neither is set when Kode is constructed bare

kmap = (c) -> kc c, 'srcmap-probe.kode', {map:true}

# decodes the inline sourcemap of a compiled snippet and returns
# [generatedLine, generatedCol, sourceLine, sourceCol] tuples

VLQ = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'

# a segment is a run of base64 chars; the continuation bit (32)
# says whether the value continues into the next char, so one
# segment decodes to a LIST of values, not a single one
decodeSegment = (s) ->
    vals = []
    v = 0
    sh = 0
    for c in s
        d = VLQ.indexOf c
        v += (d & 31) << sh
        sh += 5
        if not (d & 32)
            n = v & 1
            v = Math.floor v / 2
            vals.push if n then -v else v
            v = 0
            sh = 0
    vals

mappingsOf = (code) ->

    mark = 'sourceMappingURL=data:application/json;base64,'
    at = code.indexOf mark
    return [] if at < 0
    b64 = ''
    i = at + mark.length
    while i < code.length
        c = code[i]
        break if c not in 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/='
        b64 += c
        i++
    sm = JSON.parse B64.from(b64, 'base64').toString()
    out = []
    sl = 0
    sc = 0
    # mappings separates generated lines with ';', not newline
    for line, li in sm.mappings.split ';'
        gc = 0
        for seg in line.split ','
            continue if not seg
            f = decodeSegment seg
            gc += f[0]
            if f.length >= 4
                sl += f[2]
                sc += f[3]
                out.push [li+1, gc, sl+1, sc]
    out

▸ srcmap

    ▸ on by default

        'sourceMappingURL' in kmap 'a = 1'        ▸ true
        'sourceURL'        in kmap 'a = 1'        ▸ true

    ▸ maps every line

        out = mappingsOf kmap 'a = 1\nb = a + 2\nlog b\n'

        # note: kode's list comprehension does not destructure,
        # so index the tuples instead
        # note: kc() strips the header and 'var' lines, so these are
        # line numbers within the stripped output, not the written file.
        # bind to a name first: an array on the right of ▸ is compared
        # element by element, which reads as many failures
        gen = out.map (t) -> t[0]
        gen ▸ [5 5 6 6 6 7 7]

        src = out.map (t) -> t[2]
        src ▸ [1 1 2 2 2 3 3]

    ▸ finds column zero

        # the earlier solve() skipped past a match at index 0, and
        # compared the search offset instead of the match itself
        out = mappingsOf kmap 'a = 1\nb = a + 2\n'

        zero = out.filter((t) -> t[1] == 0).map((t) -> t[0])
        zero ▸ [5 6]

    ▸ maps a nested body

        out = mappingsOf kmap 'f = ->\n    a = 1\n    b = a + 2\nf()\n'

        # the body renders indented, so generated columns differ from
        # source; source line 3 (b = a + 2) becomes the implicit return
        gen = out.map (t) -> t[0]
        gen ▸ [6 8 10 11 11 11 13]

        src = out.map (t) -> t[2]
        src ▸ [1 2 2 3 3 3 4]

    ▸ no duplicate columns

        out = mappingsOf kmap 'a = 1\nb = a + 2\nlog b\n'

        keys = out.map (t) -> "#{t[0]}:#{t[1]}"

        dupes = keys.filter (k,i) -> keys.indexOf(k) != i
        n = dupes.length
        n ▸ 0

    ▸ ordered and monotonic

        out = mappingsOf kmap 'a = 1\nb = a + 2\nc = b + 3\nlog c\n'

        sorted = true
        prev = [-1, -1]
        for t in out
            sorted = false if t[0] < prev[0] or (t[0] == prev[0] and t[1] <= prev[1])
            prev = [t[0], t[1]]
        sorted ▸ true