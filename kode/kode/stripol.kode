###
     ███████  █████████  ████████   ███  ████████    ███████   ███        
    ███          ███     ███   ███  ███  ███   ███  ███   ███  ███        
    ███████      ███     ███████    ███  ████████   ███   ███  ███        
         ███     ███     ███   ███  ███  ███        ███   ███  ███        
    ███████      ███     ███   ███  ███  ███         ███████   ███████    
    
    walks through an abstract syntax tree and parses string interpolations
###

use ./print

class Stripol

    @: @kode ->

        @verbose = @kode.args.verbose
        @debug   = @kode.args.debug
        @raw     = @kode.args.raw
        
    #  ███████   ███████   ███      ███      ████████   ███████  █████████  
    # ███       ███   ███  ███      ███      ███       ███          ███     
    # ███       ███   ███  ███      ███      ███████   ███          ███     
    # ███       ███   ███  ███      ███      ███       ███          ███     
    #  ███████   ███████   ███████  ███████  ████████   ███████     ███     
    
    collect: tl ->
        
        @scope tl
        tl

    #  ███████   ███████   ███████   ████████   ████████  
    # ███       ███       ███   ███  ███   ███  ███       
    # ███████   ███       ███   ███  ████████   ███████   
    #      ███  ███       ███   ███  ███        ███       
    # ███████    ███████   ███████   ███        ████████  
    
    scope: body ->

        @exp body.exps,k,e for e,k in body.exps
        
    # ████████  ███   ███  ████████   
    # ███        ███ ███   ███   ███  
    # ███████     █████    ████████   
    # ███        ███ ███   ███        
    # ████████  ███   ███  ███        
    
    exp: p k e ->

        ⮐ if not e
            
        if e.type
            if e.type in ['double' 'triple']
                p[k] = @string e
            return
            
        else if e is Array  ➜ @exp e, k, v for v,k in e if e.length
        else if e is Object
            
            for key,val of e
                if val
                    if val.type 
                        @exp e, key, val
                    else
                        @exp val,k,v for k,v of val
                        # if val is Array
                            # @exp val, k, v for v,k in val if val.length
                        # else
                            # @exp val, k, v for k,v of val
        
    #  ███████  █████████  ████████   ███  ███   ███   ███████   
    # ███          ███     ███   ███  ███  ████  ███  ███        
    # ███████      ███     ███████    ███  ███ █ ███  ███  ████  
    #      ███     ███     ███   ███  ███  ███  ████  ███   ███  
    # ███████      ███     ███   ███  ███  ███   ███   ███████   
    
    string: e ->
        
        # the body of the string starts one column in, three for a triple,
        # and the chunks are numbered from there
        
        s   = if e.type == 'triple' then e.text[3...-3] else e.text[1...-1]
        col = e.col + (if e.type == 'triple' then 3 else 1)
        
        chunks = @dissect s, e.line, col, e.org
        
        if chunks.length > 1
            if chunks[-1].type != 'close'
                chunks.push type:'close' text:'' line:e.line, col:col+s.length
                
            ⮐ stripol:chunks
        else
            e.text = e.text.replace '#{}' ''
        e
        
    # 00000000   000       0000000    0000000  00000000
    # 000   000  000      000   000  000       000     
    # 00000000   000      000000000  000       0000000 
    # 000        000      000   000  000       000     
    # 000        0000000  000   000  0000000  00000000
    
    # an interpolated expression is parsed on its own, so its tokens come
    # back numbered from the top of their own little string. move them onto
    # the line and column the expression starts at, so a source map built
    # from them points into the string and not into the head of the file.
    
    place: (ast, line, col) ->
        
        if ast is arr
            for a in ast ➜ @place a, line, col
            ⮐
        
        if not ast is obj then ⮐
        
        if valid ast.line and valid ast.type and valid ast.text
            l = ast.line
            ast.line = l + line - 1
            ast.col += col if l == 1
        
        for k,v of ast
            @place v, line, col if v is arr or v is obj
        
    # ███████    ███   ███████   ███████  ████████   ███████  █████████  
    # ███   ███  ███  ███       ███       ███       ███          ███     
    # ███   ███  ███  ███████   ███████   ███████   ███          ███     
    # ███   ███  ███       ███       ███  ███       ███          ███     
    # ███████    ███  ███████   ███████   ████████   ███████     ███     
    
    dissect: (s, line, col, org=[]) ->
        
        c = 0; chunks = []
            
        push = (type, text, at=0) => 
            if type == 'code'
                if valid text
                    ast = @kode.ast text
                    
                    # where the expression sits in the body of the string,
                    # in the body's own line and column
                    
                    pre = s[...at]
                    nl  = pre.split('\n').length - 1
                    bc  = if nl then pre.length - pre.lastIndexOf('\n') - 1 else at
                    
                    # and where that is in the source: a triple string comes
                    # out of the lexer re-indented, and it says by how much
                    
                    o = org[nl]
                    
                    if valid o
                        tl = o[0]
                        tc = o[1] + bc
                    else
                        tl = line + nl
                        tc = col + bc
                    
                    @place ast.exps, tl, tc
                    
                    chunks.push code: exps:ast.exps
            else
                chunks.push type:type, text:text, line:line, col:col+c
        
        while c < s.length
            
            t = s[c..]
            
            if not m = /(?<!\\)#{/.exec t
                push 'close' t
                break

            push empty(chunks) and 'open' or 'midl', t[...m.index]
            
            c += m.index+2
            ic = c

            while c < s.length
                
                t = s[c..]
                
                rgs = 
                    triple:  /"""(?:.|\n)*?"""/     
                    double:  /"(?:\\["\\]|[^\n"])*"/
                    single:  /'(?:\\['\\]|[^\n'])*'/
                    comment: /[\#]/                    
                    open:    /[\{]/                    
                    close:   /[\}]/                    
                
                matches = []
                for k,r of rgs
                    m = r.exec t
                    if m? then matches.push [k, m] 
                    
                matches.sort (a,b) -> a[1].index - b[1].index
                
                length = matches[0][1][0].length
                index  = matches[0][1].index
                
                b = switch matches[0][0]
                    when 'close'
                        push 'code' s[ic...c+index], ic
                        c += index+length
                        true
                    when 'triple' 'double' 'single'
                        c += index+length
                        false
                    else
                        log 'unhandled?' matches[0]
                        c += index+length
                        true
                break if b

        for i in 1...chunks.length
            break if empty chunks
            if chunks[i].type == 'close' and chunks[i-1].type == 'open'
                chunks.splice i-1 2
                i--
                
        chunks
                                
    verb: -> if @debug ➜ console.log.apply console.log arguments 

export Stripol
