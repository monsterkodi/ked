###
 ███████   ███████   ███      █████████   ████████  ████████   
███       ███   ███  ███         ███      ███       ███   ███  
███████   █████████  ███         ███      ███████   ███████    
     ███  ███   ███  ███         ███      ███       ███   ███  
███████   ███   ███  ███████     ███      ████████  ███   ███  
###

use ◆ util noon         
                        
salter = text opt ->    
                        
    opt ?= {}           
    opt.char    ?= '█'
    opt.prefix  ?= '' 
    opt.postfix ?= '' 
    opt.prepend ?= ''
    opt.append  ?= ''
    
    if text != ' '
        s = text.toLowerCase().trim() 
    else
        s = ' '
    
    cs = []
    for c in s
        if font[c]?
            cs.push font[c]
            
    zs = util.zip.apply null cs
    
    if opt.char != '█'
        zs = zs.map (j) -> j.map (k) -> k.replace /[0]/g opt.char
        
    if opt.prefix or opt.postfix
        zs = zs.map (j) -> j.map (k) -> opt.prefix + k + opt.postfix
        
    rs = zs.map (j) -> opt.prepend + j.join('  ') + opt.append
    
    rs.join '\n'

