███        ███   ███   ███████   ███       ███  ███████  ████████
###

function profile

    @hrtime: {}

    @start: id ○-> 
        
        profile.hrtime[id] = performance.now()
        
    @end: id threshold=0 ○->
        
        t = performance.now()
            
        b = t-profile.hrtime[id]
        f=0.001 
        for u in ['s' 'ms' 'μs']
            if u=='μs' or b*f>1
                v = b*f
                if v < 1 ➜ f = v.toFixed 2 else f = v.toFixed 0
                if b >= threshold ➜ log id+' '+f+' '+u
                return b
            f*=1000

export profile
