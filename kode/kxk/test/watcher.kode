
use fs
use .. ◆ slash post nfs watcher
use ../util ▪ sleep

events = []
post.on 'file.change' (info) =>
    events.push info if events

# tests do not need to wait for the production debounce
watcher.debounce = 10
watcher.maxDelay = 40

###
▸ watcher
  
  ▸ no read error logs

        root = '/tmp/opencode/ked-watcher-eacces'
        secret = slash.path root 'secret'

        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        fs.mkdirSync secret
        fs.chmodSync secret 0

        lines = []
        keepLog = console.log
        keepWarn = console.warn
        keepError = console.error

        console.log = (args...) -> lines.push args
        console.warn = (args...) -> lines.push args
        console.error = (args...) -> lines.push args

        thrown = null

        try
            ◯ watcher.watch root
            ◯ sleep 20
        catch err
            thrown = err

        parentWatched = watcher.watchers[root] != undefined
        secretWatched = watcher.watchers[secret] != undefined

        watcher.close()

        console.log = keepLog
        console.warn = keepWarn
        console.error = keepError

        fs.chmodSync secret 493
        fs.rmSync root recursive:true force:true

        (thrown == null) ▸ true
        lines.length ▸ 0
        parentWatched ▸ true
        secretWatched ▸ false

  ▸ creates emit one create event

        root = '/tmp/opencode/ked-watcher-create'
        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true

        events = []
        ◯ watcher.watch root
        ◯ sleep 20

        fs.writeFileSync slash.path(root 'a.txt') 'hello'
        ◯ sleep 80

        watcher.close()
        fs.rmSync root recursive:true force:true

        events.length ▸ 1
        events[0].change ▸ 'create'
        events[0].path ▸ slash.path root 'a.txt'

  ▸ modifications emit one modify event

        root = '/tmp/opencode/ked-watcher-modify'
        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        file = slash.path root 'a.txt'
        fs.writeFileSync file 'hello'

        events = []
        ◯ watcher.watch root
        ◯ sleep 20

        fs.writeFileSync file 'hello world'
        ◯ sleep 80

        watcher.close()
        fs.rmSync root recursive:true force:true

        events.length ▸ 1
        events[0].change ▸ 'modify'
        events[0].path ▸ file

  ▸ deletions emit one delete event

        root = '/tmp/opencode/ked-watcher-delete'
        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        file = slash.path root 'a.txt'
        fs.writeFileSync file 'hello'

        events = []
        ◯ watcher.watch root
        ◯ sleep 20

        fs.rmSync file
        ◯ sleep 80

        watcher.close()
        fs.rmSync root recursive:true force:true

        events.length ▸ 1
        events[0].change ▸ 'delete'
        events[0].path ▸ file

  ▸ renames emit one rename event

        root = '/tmp/opencode/ked-watcher-rename'
        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        oldFile = slash.path root 'a.txt'
        newFile = slash.path root 'b.txt'
        fs.writeFileSync oldFile 'hello'

        events = []
        ◯ watcher.watch root
        ◯ sleep 20

        fs.renameSync oldFile newFile
        ◯ sleep 80

        watcher.close()
        fs.rmSync root recursive:true force:true

        events.length ▸ 1
        events[0].change ▸ 'rename'
        events[0].path ▸ newFile
        events[0].oldPath ▸ oldFile

  ▸ copies emit one create event

        root = '/tmp/opencode/ked-watcher-copy'
        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        oldFile = slash.path root 'a.txt'
        newFile = slash.path root 'b.txt'
        fs.writeFileSync oldFile 'hello'

        events = []
        ◯ watcher.watch root
        ◯ sleep 20

        fs.copyFileSync oldFile newFile
        ◯ sleep 80

        watcher.close()
        fs.rmSync root recursive:true force:true

        events.length ▸ 1
        events[0].change ▸ 'create'
        events[0].path ▸ newFile

  ▸ atomic saves emit one modify event and no temp events

        root = '/tmp/opencode/ked-watcher-atomic'
        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        file = slash.path root 'a.txt'
        tmp  = slash.path root '.a.txt.tmp'
        fs.writeFileSync file 'old'

        events = []
        ◯ watcher.watch root
        ◯ sleep 20

        fs.writeFileSync tmp 'new'
        fs.renameSync tmp file
        ◯ sleep 80

        watcher.close()
        fs.rmSync root recursive:true force:true

        events.length ▸ 1
        events[0].change ▸ 'modify'
        events[0].path ▸ file

  ▸ nfs.write emits one modify event

        root = '/tmp/opencode/ked-watcher-nfswrite'
        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        file = slash.path root 'a.txt'
        fs.writeFileSync file 'old'

        events = []
        ◯ watcher.watch root
        ◯ sleep 20

        ◯ nfs.write file 'new'
        ◯ sleep 80

        watcher.close()
        fs.rmSync root recursive:true force:true

        events.length ▸ 1
        events[0].change ▸ 'modify'
        events[0].path ▸ file

  ▸ directories emit one create and one delete event

        root = '/tmp/opencode/ked-watcher-dirs'
        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        dir = slash.path root 'folder'

        events = []
        ◯ watcher.watch root
        ◯ sleep 20

        fs.mkdirSync dir
        fs.writeFileSync slash.path(dir 'inside.txt') 'hello'
        ◯ sleep 80

        created = events.length
        createdChange = events[0]?.change
        path = events[0]?.path

        events = []
        fs.rmSync dir recursive:true force:true
        ◯ sleep 80

        deleted = events.length
        deletedChange = events[0]?.change
        deletedPath = events[0]?.path

        watcher.close()
        fs.rmSync root recursive:true force:true

        created ▸ 1
        createdChange ▸ 'create'
        path ▸ dir
        deleted ▸ 1
        deletedChange ▸ 'delete'
        deletedPath ▸ dir

  ▸ directory renames emit one rename event

        root = '/tmp/opencode/ked-watcher-dirrename'
        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true
        oldDir = slash.path root 'old'
        newDir = slash.path root 'new'
        fs.mkdirSync oldDir
        fs.writeFileSync slash.path(oldDir 'inside.txt') 'hello'

        events = []
        ◯ watcher.watch root
        ◯ sleep 20

        fs.renameSync oldDir newDir
        ◯ sleep 80

        watcher.close()
        fs.rmSync root recursive:true force:true

        events.length ▸ 1
        events[0].change ▸ 'rename'
        events[0].path ▸ newDir
        events[0].oldPath ▸ oldDir

  ▸ directories created after watching are watched

        root = '/tmp/opencode/ked-watcher-newdir'
        fs.rmSync root recursive:true force:true
        fs.mkdirSync root recursive:true

        events = []
        ◯ watcher.watch root
        ◯ sleep 20

        dir = slash.path root 'folder'
        fs.mkdirSync dir
        ◯ sleep 80

        events = []
        fs.writeFileSync slash.path(dir 'inside.txt') 'hello'
        ◯ sleep 80

        watcher.close()
        fs.rmSync root recursive:true force:true

