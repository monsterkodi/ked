#!/usr/bin/env -S node ../js/kode/kode.js

###
 ███████   ███████   ███      █████████
███       ███   ███  ███         ███   
███████   █████████  ███         ███   
     ███  ███   ███  ███         ███   
███████   ███   ███  ███████     ███   
###

# this file is eval'd by js/kode/kode.js, not imported as a module, which
# rules out a few things that work everywhere else in this project:
#
#   - no `use`: a static import is a syntax error outside a module
#   - no top level ○: top level await is too
#   - no ◆dir or ◆file: the generated prelude needs import.meta.url
#   - import() takes braces, `import 'x'` emits a static import
#   - import() paths resolve relative to js/kode/kode.js, so
#     '../kxk/salter.js' means js/kxk/salter.js
#   - karg needs ignoreArgs:3, for node + kode.js + this file
#   - only flags kode.js does not claim are usable here: its -c is --compile,
#     -e --eval, -o --outdir, -r --run, -j --js, -H --header, -v -d, and -h is
#     karg's default for help. kode.js parses the same argv first and exits on
#     any of them, so salt uses -0 -f -i -p and no help flag
#   - no `⮐ if a then b else c`: it swallows the rest of the file.
#     a bare ⮐ is fine
#   - kode.js parses the same argv, so every word after this file is also
#     treated as a source file and reported as "can't read". that noise is
#     kode.js's, not ours
#
# the ../js/kode/kode.js in the shebang is resolved against the working
# directory, so run this from bin/:
#
#   cd bin && ./salt foo
#

main = ○->

    km = ○ import('../kxk/karg.js')
    sm = ○ import('../kxk/salter.js')

    karg = km.default
    salter = sm.default

    template = """
        salt
            words    the text to render          **
            zero     fill with 0 instead of █    = false -0
            fence    wrap the block in ###       = false -f
            indent   indent every row by n       = 0 -i
            prefix   prefix every row            -p
    """

    usage = """
        salt

        usage

            salt <text>          render <text>
            salt -0 <text>       fill with 0 instead of █
            salt -f <text>       wrap the block in ###
            salt -i 4 <text>     indent every row by 4
            salt -p '# ' <text>  prefix every row

    """

    args = karg(template, ignoreArgs:3)

    if empty args.words

        console.log(usage)
        ⮐

    text = args.words.join('')

    fill = if args.zero then '0' else '█'

    block = salter(text, {char:fill})

    if args.prefix
        block = block.split('\n').map((l) -> "#{args.prefix}#{l}").join('\n')

    if args.indent
        pad = ' '.repeat(parseInt(args.indent))
        block = block.split('\n').map((l) -> "#{pad}#{l}").join('\n')

    if args.fence
        block = ['###', block, '###'].join('\n')

    console.log block

# the trailing '' stops kode.js from logging the completion value
main()
''
