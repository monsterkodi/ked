#!/usr/bin/env node

/*
     ███████   ███████   ███      █████████  ████████  ████████
    ███       ███   ███  ███         ███     ███       ███   ███
    ███████   █████████  ███         ███     ███████   ███████
         ███  ███   ███  ███         ███     ███       ███   ███
    ███████   ███   ███  ███████     ███     ████████  ███   ███

    renders a five row ascii-art header for a string, using the same generator that ked uses.
*/

import karg from '../js/kxk/karg.js'
import salter from '../js/kxk/salter.js'

const CONFIG = `

    salter
        text        the text to render                           *
        fence       wrap the block in ### fences             -c  = false
        indent      indent every row by n spaces             -i  = 0
        prefix      prefix every row with                    -p
        rowappend   append to every row with                 -a
        prepend     prepend to the whole block with          -P
        append      append to the whole block with           -A

    `

const PRE = `

${salter('salter')}

    renders a five row ascii-art header for a string, using the same
    generator that ked uses.
`

const POST = `

notes

    unsupported characters are dropped,
    see salter.kode for the list of supported ones.
`

const opt = karg(CONFIG, { preHelp: PRE, postHelp: POST })

function usage () {
    console.log(karg(CONFIG, { returnLog: true, argv: ['-h'], preHelp: PRE, postHelp: POST }))
}

if (opt.__ignored?.length) {
    console.log(`ignoring unrecognised argument(s): ${opt.__ignored.join(' ')}`)
}

if (!opt.text) {
    usage()
    process.exit(1)
}

let block = salter(opt.text, { char: '█' })

if (opt.indent) {
    let pad = ' '.repeat(opt.indent)
    block = block.split('\n').map(l => pad + l).join('\n')
}

if (opt.fence) {
    block = ['###', block, '###'].join('\n')
}

if (opt.prepend) block = block.split('\n').map(l => opt.prepend + l).join('\n')
if (opt.append)  block = block.split('\n').map(l => l + opt.append).join('\n')

console.log(block)