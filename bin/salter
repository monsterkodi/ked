#!/usr/bin/env node

/*
     ███████   ███████   ███      █████████  ████████  ████████ 
    ███       ███   ███  ███         ███     ███       ███   ███
    ███████   █████████  ███         ███     ███████   ███████  
         ███  ███   ███  ███         ███     ███       ███   ███
    ███████   ███   ███  ███████     ███     ████████  ███   ███

    renders a five row ascii-art header for a string, using the same generator that ked uses.
*/

import salter from '../js/kxk/salter.js'

function usage () {
    console.log(`
${salter('salter')}

usage

    salter <text>            render <text>

options

    -c           wrap the block in ### fences
    -i <n>       indent every row by n spaces
    -p <str>     prefix every row with <str>
    -a <str>     append to every row
    -P <str>     prepend to the whole block
    -A <str>     append to the whole block

notes

    unsupported characters are dropped, 
    see salter.kode for the list of supported ones.
`)
}

let opt  = {}
let args = []

for (let i = 2; i < process.argv.length; i++) {

    let a = process.argv[i]

    if (a == '-c')              opt.fence   = true
    else if (a == '-h')         opt.help    = true
    else if (a == '-i')         opt.indent  = parseInt(process.argv[++i] ?? '0')
    else if (a == '-p')         opt.prefix  = process.argv[++i] ?? ''
    else if (a == '-a')         opt.postfix = process.argv[++i] ?? ''
    else if (a == '-P')         opt.prepend = process.argv[++i] ?? ''
    else if (a == '-A')         opt.append  = process.argv[++i] ?? ''
    else if (a.startsWith('-')) opt.help    = true
    else                        args.push(a)

}

if (opt.help) {
    usage()
    process.exit(0)
}

if (!args.length) {
    usage()
    process.exit(1)
}

let text = args[0]

let block = salter(text, {char:'█'})

if (opt.indent) {
    let pad = ' '.repeat(opt.indent)
    block = block.split('\n').map(l => pad + l).join('\n')
}

if (opt.fence) {
    block = ['###', block, '###'].join('\n')
}

if (opt.prepend) block = block.split('\n').map(l => opt.prepend + l).join('\n')
if (opt.append)  block = block.split('\n').map(l => l + opt.append).join('\n')

console.log(block)
