#!/usr/bin/env node

/*
███████  ████████  ████████    ███████   █████   ███████    ███       ███████    ███████  ███   ███   ███████
   ███   ███       ███   ███  ███   ███     ███  ███   ███  ███      ███   ███  ███       ███  ███   ███
  ███    ███████   ███████    ███   ███    ███   ███████    ███      ███   ███  ███       ███████    ███████
 ███     ███       ███   ███  ███   ███   ███    ███   ███  ███      ███   ███  ███       ███  ███        ███
███████  ████████  ███   ███   ███████   ██████  ███████    ███████   ███████    ███████  ███   ███  ███████

    converts 0 to █ in salter ascii-art headers.
*/

import { readFileSync, writeFileSync } from 'node:fs'
import { extname } from 'node:path'
import { readdirSync, statSync } from 'node:fs'
import { join } from 'node:path'

import karg from '../js/kxk/karg.js'
import kulur from '../js/kolor/kulur.js'
import salter from '../js/kxk/salter.js'
import extlang from '../js/kolor/extlang.js'

const CONFIG = `

    zero2blocks
        files        files to convert                                     **
        dry          dry run: report what would change, write nothing  -d  = true
        verbose      print (to-be-)converted headers                   -v  = true
        ext          syntax ext to assume instead of the filename      -x
        recursive    expect directories, walk tree for known exts     -r  = false

    `

const PRE = `

${salter('zero2blocks')}

    converts 0 to █ in salter ascii-art headers.
`

const POST = `

notes

    idempotent - a converted file has no 0 left in its headers, so running
    this twice changes nothing the second time.

    the ext of each file picks the syntax (kode, noon, js, md, ...).  a file
    whose ext the highlighter does not know is skipped with a warning, and can
    be forced with -x.

    with -r, arguments are directories.  the tool walks each tree and
    processes all files whose extension is in the known exts list
    (kode, noon, js, md, ts, json, yaml, py, ...).

    don't point this at js/ - it is build output, and a couple of test fixtures
    there hold 0-art inside string literals on purpose.
`

const args = karg(CONFIG, { preHelp: PRE, postHelp: POST })

function usage () {
    console.log(karg(CONFIG, { returnLog: true, argv: ['-h'], preHelp: PRE, postHelp: POST }))
}

if (args.__ignored?.length) {
    console.log(`ignoring unrecognised argument(s): ${args.__ignored.join(' ')}`)
}

if (!args.files.length) {
    usage()
    process.exit(1)
}

//  recursive: walk directories and collect files with known extensions
if (args.recursive) {
    const knownExts = new Set(extlang.exts)
    const collected = []

    function walk (dir) {
        for (const entry of readdirSync(dir)) {
            const full = join(dir, entry)
            const st = statSync(full)
            if (st.isDirectory()) {
                walk(full)
            } else {
                const ext = extname(entry).replace(/^\./, '')
                if (knownExts.has(ext)) {
                    collected.push(full)
                }
            }
        }
    }

    for (const dir of args.files) {
        walk(dir)
    }

    args.files = collected
}

//  replace 0 with █ in the header chunks of one line.  0 and █ are both
//  one character, so chunk offsets stay valid while we go.

function convert (line, chunks) {

    let res = ''
    let prev = 0

    for (let c of chunks) {

        if (!c.clss.includes('header')) continue

        res += line.slice(prev, c.start) +
               line.slice(c.start, c.start + c.length).replace(/0/g, '█')

        prev = c.start + c.length
    }

    return res + line.slice(prev)
}

let total = 0
let skipped = 0

for (let path of args.files) {

    let ext = args.ext || extname(path).replace(/^\./, '')

    //  karg takes the next word as the value, so "-nx -v f.kode" leaves -x
    //  holding "-v".  say so rather than reporting a nonsense ext.

    if (ext.startsWith('-')) {
        console.log(`error   -x wants a syntax ext, got '${ext}'`)
        process.exit(1)
    }

    if (!kulur.exts.includes(ext)) {
        console.log(`skip    ${path} (unknown ext '${ext}', use -x to force)`)
        skipped++
        continue
    }

    let lines  = readFileSync(path, 'utf8').split('\n')
    let chunks = kulur.dissect(lines, ext)

    //  chunk offsets index into the line they came from, so a highlighter
    //  returning a different number of lines would point at the wrong ones.
    //  bail rather than guess.

    if (chunks.length !== lines.length) {
        console.log(`skip    ${path} (highlighter gave ${chunks.length} lines for ${lines.length})`)
        skipped++
        continue
    }

    let out     = lines.slice()
    let changed = []

    for (let i = 0; i < chunks.length; i++) {

        let line = convert(lines[i], chunks[i])
        if (line !== lines[i]) {
            out[i] = line
            changed.push(i + 1)
        }
    }

    if (!changed.length) continue

    total += changed.length

    if (args.verbose) {
        console.log("")
        let count = 0
        for (let n of changed) {
            console.log(out[n-1])
            count += 1
            if (count % 5 == 0) console.log("")  
        }
    }

    if (args.dry) {
        console.log(`dry     ${path}  ${changed.length} line(s)`)
    } else {
        writeFileSync(path, out.join('\n'))
        console.log(`wrote   ${path}  ${changed.length} line(s)`)
    }
}

console.log(`${total} line(s) ${args.dry ? 'would change' : 'changed'}` +
            (skipped ? `, ${skipped} file(s) skipped` : ''))
            