#!/usr/bin/env node

// where did this line of js come from?
//
//   bin/where js/kode/lexer.js:222:18     a stack trace, pasted in whole
//   bin/where js/kode/lexer.js:222        column defaults to the line start
//   bin/where js/kode/lexer.js 222 18     the same, in three arguments
//
//   ->  ../../kode/kode/lexer.kode:265:58   if trim(splt[0]) == '' ...
//
// node resolves a position to the nearest segment at or before it, which
// is what an error reporter does, so this is the same answer a stack trace
// would give.  the _k_ block at the top of a generated file has no
// segments at all: it is the compiler's own boilerplate.

import {SourceMap} from 'node:module'
import fs from 'node:fs'
import path from 'node:path'

const [srcfile, ...rest] = process.argv.slice(2)

let line = rest[0]
let col = rest[1] ?? 0
let file = srcfile

// a trace hands over its position as one argument, so that spelling has to
// work: file:line:col, or file:line for the whole of it.  the lazy path
// stops at the first colon the numbers can follow, so one further down a
// path does not go looking for a line number.

if (line == null && srcfile.includes(':')) {
    const m = /^(.+?):(\d+)(?::(\d+))?$/.exec(srcfile)

    if (m) {
        file = m[1]
        line = m[2]
        col = m[3] ?? 0
    }
}

file = process.cwd() + "/" + file

const js = fs.readFileSync(file, 'utf8')
const mark = 'sourceMappingURL=data:application/json;base64,'
const at = js.lastIndexOf(mark)

if (at < 0) {
    console.log(`${file}: no inline map`)
    process.exit(0)
}

const b64 = js.slice(at + mark.length).split('\n')[0]
const payload = JSON.parse(Buffer.from(b64, 'base64').toString())

const sm = new SourceMap(payload, {
    url: path.resolve(file),
    lineLengths: js.split('\n').map(l => l.length)
})

const e = sm.findEntry(+line - 1, +col)

if (!e?.originalSource) {
    console.log(`${file}:${line}:${col}  ->  (nothing mapped here)`)
    process.exit(0)
}

const src = path.resolve(path.dirname(file), e.originalSource)
const text = fs.readFileSync(src, 'utf8').split('\n')[e.originalLine]

console.log(`${file}:${line}:${col}  ->  ${e.originalSource}:${e.originalLine + 1}:${e.originalColumn + 1}`)
console.log(`    ${text?.trimEnd()}`)
